###Pure
Class dg::P { k: String[1]; d: StrictDate[1]; doy: Integer[0..1]; }

###Relational
Database dg::DB ( Table T ( K VARCHAR(10) PRIMARY KEY, D DATE ) )

###Mapping
Mapping dg::M
(
   dg::P: Relational
   {
      ~primaryKey ( [dg::DB]T.K )
      ~mainTable [dg::DB]T
      k: [dg::DB]T.K,
      d: [dg::DB]T.D,
      doy: dayOfYear([dg::DB]T.D)
   }
)

###Connection
RelationalDatabaseConnection dg::Conn
{ store: dg::DB; type: DuckDB; specification: DuckDB { }; auth: Test; }

###Runtime
Runtime dg::RT { mappings: [ dg::M ]; connections: [ dg::DB: [ env: dg::Conn ] ]; }

###Data
Data dg::Seed { Relational #{ default.T: 'K,D\n' + 'R1,2024-06-03\n'; }# }

###Service
Service dg::S_relation
{
   pattern: '/dg/rel';
   documentation: 'dayOfYear through the RELATION projection form.';
   execution: Single
   { query: |dg::P.all()->project(~[doy:x|$x.doy]); mapping: dg::M; runtime: dg::RT; }
   testSuites:
   [ S_relation_suite:
     { data: [ connections: [ env: Reference #{ dg::Seed }# ] ]
       tests: [ t: { serializationFormat: PURE_TDSOBJECT;
         asserts: [ a: EqualToJson #{ expected: ExternalFormat #{
           contentType: 'application/json'; data: '[ { "doy" : 999 } ]'; }#; }# ] } ] } ]
}

Service dg::S_tds
{
   pattern: '/dg/tds';
   documentation: 'dayOfYear through the TDS projection form.';
   execution: Single
   { query: |dg::P.all()->project([x|$x.doy], ['doy']); mapping: dg::M; runtime: dg::RT; }
   testSuites:
   [ S_tds_suite:
     { data: [ connections: [ env: Reference #{ dg::Seed }# ] ]
       tests: [ t: { serializationFormat: PURE_TDSOBJECT;
         asserts: [ a: EqualToJson #{ expected: ExternalFormat #{
           contentType: 'application/json'; data: '[ { "doy" : 999 } ]'; }#; }# ] } ] } ]
}
