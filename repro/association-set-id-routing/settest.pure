###Pure
Class st::Parent { pid: String[1]; name: String[1]; kind: String[1]; }
Class st::Child  { cid: String[1]; pid: String[1]; label: String[1]; }
Class st::SpecialParent extends st::Parent { }
Association st::PC { parent: st::Parent[0..1]; children: st::Child[*]; }

###Relational
Database st::DB
(
   Table PARENT ( PID VARCHAR(10) PRIMARY KEY, NAME VARCHAR(20), KIND VARCHAR(10) )
   Table CHILD ( CID VARCHAR(10) PRIMARY KEY, PID VARCHAR(10), LABEL VARCHAR(20) )
   Join P_C ( PARENT.PID = CHILD.PID )
   Filter SpecialRows ( PARENT.KIND = 'SPECIAL' )
)

###Mapping
Mapping st::M
(
   *st::Parent[base]: Relational
   {
      ~primaryKey ( [st::DB]PARENT.PID )
      ~mainTable [st::DB]PARENT
      pid: [st::DB]PARENT.PID, name: [st::DB]PARENT.NAME, kind: [st::DB]PARENT.KIND
   }
   st::Child: Relational
   {
      ~primaryKey ( [st::DB]CHILD.CID )
      ~mainTable [st::DB]CHILD
      cid: [st::DB]CHILD.CID, pid: [st::DB]CHILD.PID, label: [st::DB]CHILD.LABEL
   }
   st::PC: Relational
   { AssociationMapping ( children[base, st_Child]: [st::DB]@P_C,
                       parent[st_Child, base]: [st::DB]@P_C ) }
)

###Connection
RelationalDatabaseConnection st::Conn
{ store: st::DB; type: DuckDB; specification: DuckDB { }; auth: Test; }
###Runtime
Runtime st::RT { mappings: [ st::M ]; connections: [ st::DB: [ env: st::Conn ] ]; }
###Data
Data st::Seed
{ Relational #{ default.PARENT: 'PID,NAME,KIND\n' + 'P1,Alpha,SPECIAL\n';
                default.CHILD: 'CID,PID,LABEL\n' + 'C1,P1,first\n'; }# }

###Service
Service st::S_Navigate
{
   pattern: '/st/nav';
   documentation: 'Navigate child -> parent across an association.';
   execution: Single
   { query: |st::Child.all()->project(~[cid:x|$x.cid, pname:x|$x.parent.name]);
     mapping: st::M; runtime: st::RT; }
   testSuites:
   [ S_Navigate_suite:
     { data: [ connections: [ env: Reference #{ st::Seed }# ] ]
       tests: [ t: { serializationFormat: PURE_TDSOBJECT;
         asserts: [ a: EqualToJson #{ expected: ExternalFormat #{
           contentType: 'application/json';
           data: '[ { "cid" : "C1", "pname" : "Alpha" } ]'; }#; }# ] } ] } ]
}
