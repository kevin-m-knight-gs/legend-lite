   }

   // Three key columns, because the grouping is three columns: a severity means something
   // different in each domain and adding them would say nothing.
   risk_dashboard::RdbSeverityTotal[rdbSeverityTotal]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_SEVERITY_TOTAL.COB_DATE,
         [risk_dashboard::Store]RDB_SEVERITY_TOTAL.DOMAIN_CODE,
         [risk_dashboard::Store]RDB_SEVERITY_TOTAL.SEVERITY
      )
