      limitCount: [risk_dashboard::Store]RDB_COUNTERPARTY_LIMIT_TOTAL.LIMIT_COUNT,
      totalUtilised: [risk_dashboard::Store]RDB_COUNTERPARTY_LIMIT_TOTAL.TOTAL_UTILISED,
      totalThreshold: [risk_dashboard::Store]RDB_COUNTERPARTY_LIMIT_TOTAL.TOTAL_THRESHOLD,
      totalHeadroom: [risk_dashboard::Store]RDB_COUNTERPARTY_LIMIT_TOTAL.TOTAL_HEADROOM,
      worstUtilisationPct: [risk_dashboard::Store]RDB_COUNTERPARTY_LIMIT_TOTAL.WORST_UTILISATION_PCT,
      largestUtilised: [risk_dashboard::Store]RDB_COUNTERPARTY_LIMIT_TOTAL.LARGEST_UTILISED,
      limitRows[rdbLimitPanel]: [risk_dashboard::Store]@Rdb_LimitPanelCounterpartyTotal,
      rollUp[rdbCounterpartyRollUp]: [risk_dashboard::Store]@Rdb_RollUpCounterpartyTotal
   }
)
