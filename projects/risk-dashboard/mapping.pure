      openedOn: [risk_dashboard::Store]RDB_WATCH_ITEM.OPENED_ON,
      reviewOn: [risk_dashboard::Store]RDB_WATCH_ITEM.REVIEW_ON,
      closedOn: [risk_dashboard::Store]RDB_WATCH_ITEM.CLOSED_ON,
