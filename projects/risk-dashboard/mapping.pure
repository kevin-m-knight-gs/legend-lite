      exception[rdbException]: [risk_dashboard::Store]@Rdb_WatchItemException,
      owner[rdbOwner]: [risk_dashboard::Store]@Rdb_WatchItemOwner
   }

   // ------------------------------------------------------------ the aggregate sets
   //
   // Rooted on views. In each one the ~primaryKey IS the ~groupBy, so an instance is a GROUP.

   risk_dashboard::RdbTileDayTotal[rdbTileDayTotal]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_TILE_DAY_TOTAL.DASHBOARD_ID,
         [risk_dashboard::Store]RDB_TILE_DAY_TOTAL.COB_DATE
      )
      ~mainTable [risk_dashboard::Store]RDB_TILE_DAY_TOTAL
