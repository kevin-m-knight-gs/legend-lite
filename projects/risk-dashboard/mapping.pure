      callDirection: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.CALL_DIRECTION,
      requiredMargin: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.REQUIRED_MARGIN,
      collateralValue: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.COLLATERAL_VALUE,
      threshold: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.THRESHOLD,
      minimumTransferAmount: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.MINIMUM_TRANSFER_AMOUNT,
      grossCallAmount: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.GROSS_CALL_AMOUNT,
      callAmount: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.CALL_AMOUNT,
      callCurrency: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.CALL_CURRENCY,
      isCallMade: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.IS_CALL_MADE,
      isSettled: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.IS_SETTLED,
      disputeCode: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.DISPUTE_CODE,
      ageHours: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.AGE_HOURS,
      deadlineHours: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.DEADLINE_HOURS,
      ownerId: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.OWNER_ID,
      rankPosition: [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.RANK_POSITION,
      call[mgnMarginCall]: [risk_dashboard::Store]@Rdb_MarginCallPanelCall,
