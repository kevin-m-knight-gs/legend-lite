      ownerId: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.OWNER_ID,
      rankPosition: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.RANK_POSITION,
      // CROSS-PROJECT: the GROUP, and the run above it.
      accountTotal[pnlAccountDayTotal]: [risk_dashboard::Store]@Rdb_ExplainAccountTotal,
      attributionRun[pnlRun]: [risk_dashboard::Store]@Rdb_ExplainAttributionRun
   }

   // `attributionBreak[pnlBreak]` -- the set id is SHORTER than the class name
   // (PnlAttributionBreak), which is exactly the sort of thing the dependency's MANIFEST is
   // for and guessing would fail on.
   risk_dashboard::RdbResidualRow[rdbResidual]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_RESIDUAL_PANEL.ATTRIBUTION_ID,
         [risk_dashboard::Store]RDB_RESIDUAL_PANEL.INSTITUTION_ID,
         [risk_dashboard::Store]RDB_RESIDUAL_PANEL.ACCOUNT_NO,
         [risk_dashboard::Store]RDB_RESIDUAL_PANEL.INSTRUMENT_ID,
         [risk_dashboard::Store]RDB_RESIDUAL_PANEL.COB_DATE
      )
      ~mainTable [risk_dashboard::Store]RDB_RESIDUAL_PANEL
      attributionId: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.ATTRIBUTION_ID,
      institutionId: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.INSTITUTION_ID,
      accountNo: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.ACCOUNT_NO,
      instrumentId: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.INSTRUMENT_ID,
      cobDate: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.COB_DATE,
      breakCode: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.BREAK_CODE,
      residualAmount: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.RESIDUAL_AMOUNT,
      residualPct: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.RESIDUAL_PCT,
      tolerancePct: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.TOLERANCE_PCT,
      toleranceAmount: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.TOLERANCE_AMOUNT,
      severity: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.SEVERITY,
      assignedTo: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.ASSIGNED_TO,
      resolvedOn: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.RESOLVED_ON,
      currencyCode: [risk_dashboard::Store]RDB_RESIDUAL_PANEL.CURRENCY_CODE,
      residual[pnlResidual]: [risk_dashboard::Store]@Rdb_ResidualSource,
      attributionBreak[pnlBreak]: [risk_dashboard::Store]@Rdb_ResidualBreak
   }

   // ------------------------------------------------------------ panels 4 and 5

   risk_dashboard::RdbMoverRow[rdbMover]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_MOVER.ATTRIBUTION_ID,
         [risk_dashboard::Store]RDB_MOVER.INSTRUMENT_ID,
         [risk_dashboard::Store]RDB_MOVER.COB_DATE
