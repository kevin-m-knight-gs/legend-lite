      totalAmount: [risk_dashboard::Store]RDB_OWNER_QUEUE_TOTAL.TOTAL_AMOUNT,
      largestAmount: [risk_dashboard::Store]RDB_OWNER_QUEUE_TOTAL.LARGEST_AMOUNT,
