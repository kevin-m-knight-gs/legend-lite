###Mapping
// The risk-dashboard mapping. It INCLUDES all three dependency mappings, so every set this
// project's joins land on already exists and none is redefined here:
//
//   from margin-calc      mgnMarginRun, mgnMarginCall, mgnAgreement, mgnInitialMargin,
//                         mgnConcentrationAddOn, mgnPortfolioMarginTotal
//   from credit-limits    clmDailyReport, clmCreditLimit, clmUtilisationLine, clmExcess,
//                         clmEscalationTicket
//   from pnl-attribution  pnlRun, pnlResidual, pnlBreak, pnlAccountDayTotal,
//                         pnlInstrumentDayTotal
//
// All three dependencies name every set id EXPLICITLY, which means the default ids
// (`margin_calc_MgnMarginCall`, `credit_limits_ClmExcess`, `pnl_attribution_PnlResidual`) do
// NOT exist to fall back on, and every cross-project property mapping below names the real
// one. Note the two that are shorter than their classes: `clmDailyReport` for
// ClmDailyLimitReport and `pnlBreak` for PnlAttributionBreak.
//
// THE OVERLAP. position_keeping::Mapping arrives twice -- once under margin_calc::Mapping and
// once under pnl_attribution::Mapping -- and with it core-account, core-instrument and
// core-price; core_party::Mapping arrives twice again inside credit_limits::Mapping's own
// diamond. Each must resolve to ONE set of sets. None of them is included here directly, and
// none of their set ids is named below.
//
// Three shapes are worth reading for:
//
//   FILTER-SUBTYPES  [rdbException] is the base set over RDB_EXCEPTION; the three sets after
//                    it `extends [rdbException]` and add nothing but a ~filter on DOMAIN_CODE
//                    and the columns that mean something for that one domain. The key, the
//                    main table and the shared column mappings all come from the set they
//                    extend -- and the subtype columns are mapped THERE and not on the
//                    parent, because a property declared on a subclass cannot be mapped on
//                    the parent's set.
//
//   AGGREGATE SETS   the last four are rooted on VIEWS. Their ~primaryKey IS the view's
//                    ~groupBy, so one instance of RdbOwnerQueueTotal is one owner-day GROUP
//                    and never an exception.
//
//   THE FAN-IN       [rdbMorningRun] has three cross-project property mappings, one into each
//                    dependency, and is the only set in this graph that does.
//
// What is NOT mapped: every derived property -- `netRiskAmount()`, `uncollateralisedByMta()`,
// `unexplainedFromSource()`, the two dated `...On(date)` families and the rest. A derived
// property needs no mapping, and several of these call margin-calc's exported functions or
// navigate into somebody else's GROUP BY, neither of which is a column.
Mapping risk_dashboard::Mapping
(
   include margin_calc::Mapping
   include credit_limits::Mapping
   include pnl_attribution::Mapping

   // ------------------------------------------------------------ the board

   risk_dashboard::RdbDashboard[rdbDashboard]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_DASHBOARD.DASHBOARD_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_DASHBOARD
      dashboardId: [risk_dashboard::Store]RDB_DASHBOARD.DASHBOARD_ID,
      dashboardName: [risk_dashboard::Store]RDB_DASHBOARD.DASHBOARD_NAME,
      audienceRole: [risk_dashboard::Store]RDB_DASHBOARD.AUDIENCE_ROLE,
      ownerId: [risk_dashboard::Store]RDB_DASHBOARD.OWNER_ID,
      refreshCron: [risk_dashboard::Store]RDB_DASHBOARD.REFRESH_CRON,
      reportingCurrency: [risk_dashboard::Store]RDB_DASHBOARD.REPORTING_CCY,
      tileCount: [risk_dashboard::Store]RDB_DASHBOARD.TILE_COUNT,
      isDefault: [risk_dashboard::Store]RDB_DASHBOARD.IS_DEFAULT,
      retiredOn: [risk_dashboard::Store]RDB_DASHBOARD.RETIRED_ON,
      owner[rdbOwner]: [risk_dashboard::Store]@Rdb_DashboardOwner,
      tiles[rdbTile]: [risk_dashboard::Store]@Rdb_DashboardTiles,
      dayTotals[rdbTileDayTotal]: [risk_dashboard::Store]@Rdb_DashboardDayTotals
   }

   // THE TILE. `policy`, `owner` and `bindings` are the threshold, the owner and the query --
   // the three property mappings that make the central claim of this project true in the
   // mapping and not only in the comments.
   risk_dashboard::RdbTile[rdbTile]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_TILE.TILE_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_TILE
      tileId: [risk_dashboard::Store]RDB_TILE.TILE_ID,
      dashboardId: [risk_dashboard::Store]RDB_TILE.DASHBOARD_ID,
      tileCode: [risk_dashboard::Store]RDB_TILE.TILE_CODE,
      title: [risk_dashboard::Store]RDB_TILE.TITLE,
      panelCode: [risk_dashboard::Store]RDB_TILE.PANEL_CODE,
      measureCode: [risk_dashboard::Store]RDB_TILE.MEASURE_CODE,
      unitCode: [risk_dashboard::Store]RDB_TILE.UNIT_CODE,
      policyCode: [risk_dashboard::Store]RDB_TILE.POLICY_CODE,
      ownerId: [risk_dashboard::Store]RDB_TILE.OWNER_ID,
      sortOrder: [risk_dashboard::Store]RDB_TILE.SORT_ORDER,
      maxAgeMinutes: [risk_dashboard::Store]RDB_TILE.MAX_AGE_MINUTES,
      isBlocking: [risk_dashboard::Store]RDB_TILE.IS_BLOCKING,
      retiredOn: [risk_dashboard::Store]RDB_TILE.RETIRED_ON,
      dashboard[rdbDashboard]: [risk_dashboard::Store]@Rdb_DashboardTiles,
      owner[rdbOwner]: [risk_dashboard::Store]@Rdb_TileOwner,
      policy[rdbThresholdPolicy]: [risk_dashboard::Store]@Rdb_TilePolicy,
      bindings[rdbSourceBinding]: [risk_dashboard::Store]@Rdb_TileBindings,
      snapshots[rdbTileSnapshot]: [risk_dashboard::Store]@Rdb_TileSnapshots,
      commentary[rdbCommentary]: [risk_dashboard::Store]@Rdb_TileCommentary,
      exceptions[rdbException]: [risk_dashboard::Store]@Rdb_TileExceptions
   }

   risk_dashboard::RdbThresholdPolicy[rdbThresholdPolicy]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_THRESHOLD_POLICY.POLICY_CODE
      )
      ~mainTable [risk_dashboard::Store]RDB_THRESHOLD_POLICY
      policyCode: [risk_dashboard::Store]RDB_THRESHOLD_POLICY.POLICY_CODE,
      policyName: [risk_dashboard::Store]RDB_THRESHOLD_POLICY.POLICY_NAME,
      direction: [risk_dashboard::Store]RDB_THRESHOLD_POLICY.DIRECTION,
      amberLevel: [risk_dashboard::Store]RDB_THRESHOLD_POLICY.AMBER_LEVEL,
      redLevel: [risk_dashboard::Store]RDB_THRESHOLD_POLICY.RED_LEVEL,
      absoluteFloor: [risk_dashboard::Store]RDB_THRESHOLD_POLICY.ABSOLUTE_FLOOR,
      escalationLevel: [risk_dashboard::Store]RDB_THRESHOLD_POLICY.ESCALATION_LEVEL,
      responseMinutes: [risk_dashboard::Store]RDB_THRESHOLD_POLICY.RESPONSE_MINUTES,
      isDefault: [risk_dashboard::Store]RDB_THRESHOLD_POLICY.IS_DEFAULT,
      tiles[rdbTile]: [risk_dashboard::Store]@Rdb_TilePolicy
   }

   risk_dashboard::RdbOwner[rdbOwner]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_OWNER.OWNER_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_OWNER
      ownerId: [risk_dashboard::Store]RDB_OWNER.OWNER_ID,
      ownerName: [risk_dashboard::Store]RDB_OWNER.OWNER_NAME,
      roleCode: [risk_dashboard::Store]RDB_OWNER.ROLE_CODE,
      deskCode: [risk_dashboard::Store]RDB_OWNER.DESK_CODE,
      escalatesToId: [risk_dashboard::Store]RDB_OWNER.ESCALATES_TO_ID,
      contactEmail: [risk_dashboard::Store]RDB_OWNER.CONTACT_EMAIL,
      isOnCall: [risk_dashboard::Store]RDB_OWNER.IS_ON_CALL,
      tiles[rdbTile]: [risk_dashboard::Store]@Rdb_TileOwner,
      dashboards[rdbDashboard]: [risk_dashboard::Store]@Rdb_DashboardOwner,
      exceptions[rdbException]: [risk_dashboard::Store]@Rdb_ExceptionOwner,
      queueTotals[rdbOwnerQueueTotal]: [risk_dashboard::Store]@Rdb_OwnerQueueTotals
   }

   risk_dashboard::RdbSourceBinding[rdbSourceBinding]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_SOURCE_BINDING.TILE_ID,
         [risk_dashboard::Store]RDB_SOURCE_BINDING.SOURCE_SEQ
      )
      ~mainTable [risk_dashboard::Store]RDB_SOURCE_BINDING
      tileId: [risk_dashboard::Store]RDB_SOURCE_BINDING.TILE_ID,
      sourceSeq: [risk_dashboard::Store]RDB_SOURCE_BINDING.SOURCE_SEQ,
      sourceProject: [risk_dashboard::Store]RDB_SOURCE_BINDING.SOURCE_PROJECT,
      sourceElement: [risk_dashboard::Store]RDB_SOURCE_BINDING.SOURCE_ELEMENT,
      sourceKind: [risk_dashboard::Store]RDB_SOURCE_BINDING.SOURCE_KIND,
      measureExpression: [risk_dashboard::Store]RDB_SOURCE_BINDING.MEASURE_EXPRESSION,
      isPrimary: [risk_dashboard::Store]RDB_SOURCE_BINDING.IS_PRIMARY,
      tile[rdbTile]: [risk_dashboard::Store]@Rdb_TileBindings
   }

   risk_dashboard::RdbTileSnapshot[rdbTileSnapshot]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_TILE_SNAPSHOT.TILE_ID,
         [risk_dashboard::Store]RDB_TILE_SNAPSHOT.COB_DATE
      )
      ~mainTable [risk_dashboard::Store]RDB_TILE_SNAPSHOT
      tileId: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.TILE_ID,
      cobDate: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.COB_DATE,
      dashboardId: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.DASHBOARD_ID,
      runSeq: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.RUN_SEQ,
      headlineValue: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.HEADLINE_VALUE,
      priorValue: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.PRIOR_VALUE,
      amberThreshold: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.AMBER_THRESHOLD,
      redThreshold: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.RED_THRESHOLD,
      breachRatio: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.BREACH_RATIO,
      amountAtRisk: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.AMOUNT_AT_RISK,
      exceptionCount: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.EXCEPTION_COUNT,
      statusCode: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.STATUS_CODE,
      refreshLagMinutes: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.REFRESH_LAG_MINUTES,
      sourceRowCount: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.SOURCE_ROW_COUNT,
      computedAt: [risk_dashboard::Store]RDB_TILE_SNAPSHOT.COMPUTED_AT,
      tile[rdbTile]: [risk_dashboard::Store]@Rdb_TileSnapshots,
      run[rdbMorningRun]: [risk_dashboard::Store]@Rdb_RunSnapshots,
      exceptions[rdbException]: [risk_dashboard::Store]@Rdb_SnapshotExceptions,
      dayTotal[rdbTileDayTotal]: [risk_dashboard::Store]@Rdb_SnapshotDayTotal
   }

   // ------------------------------------------------------------ THE FAN-IN
   //
   // Three cross-project property mappings on one set, into three projects that cannot see
   // each other. `creditReport[clmDailyReport]` is the shortened id credit-limits publishes
   // for ClmDailyLimitReport, which is exactly the kind of thing a downstream project has to
   // read a MANIFEST for rather than guess.
   risk_dashboard::RdbMorningRun[rdbMorningRun]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_MORNING_RUN.COB_DATE,
         [risk_dashboard::Store]RDB_MORNING_RUN.RUN_SEQ
      )
      ~mainTable [risk_dashboard::Store]RDB_MORNING_RUN
      cobDate: [risk_dashboard::Store]RDB_MORNING_RUN.COB_DATE,
      runSeq: [risk_dashboard::Store]RDB_MORNING_RUN.RUN_SEQ,
      marginRunSeq: [risk_dashboard::Store]RDB_MORNING_RUN.MARGIN_RUN_SEQ,
      creditReportId: [risk_dashboard::Store]RDB_MORNING_RUN.CREDIT_REPORT_ID,
      attributionId: [risk_dashboard::Store]RDB_MORNING_RUN.ATTRIBUTION_ID,
      runType: [risk_dashboard::Store]RDB_MORNING_RUN.RUN_TYPE,
      status: [risk_dashboard::Store]RDB_MORNING_RUN.STATUS,
      tileCount: [risk_dashboard::Store]RDB_MORNING_RUN.TILE_COUNT,
      greenCount: [risk_dashboard::Store]RDB_MORNING_RUN.GREEN_COUNT,
      amberCount: [risk_dashboard::Store]RDB_MORNING_RUN.AMBER_COUNT,
      redCount: [risk_dashboard::Store]RDB_MORNING_RUN.RED_COUNT,
      exceptionCount: [risk_dashboard::Store]RDB_MORNING_RUN.EXCEPTION_COUNT,
      totalAmountAtRisk: [risk_dashboard::Store]RDB_MORNING_RUN.TOTAL_AMOUNT_AT_RISK,
      startedAt: [risk_dashboard::Store]RDB_MORNING_RUN.STARTED_AT,
      completedAt: [risk_dashboard::Store]RDB_MORNING_RUN.COMPLETED_AT,
      // CROSS-PROJECT, ALL THREE. Upstream ids, because no default id exists for any of them.
      marginRun[mgnMarginRun]: [risk_dashboard::Store]@Rdb_RunMarginRun,
      creditReport[clmDailyReport]: [risk_dashboard::Store]@Rdb_RunCreditReport,
      attributionRun[pnlRun]: [risk_dashboard::Store]@Rdb_RunAttributionRun,
      snapshots[rdbTileSnapshot]: [risk_dashboard::Store]@Rdb_RunSnapshots
   }

   // ------------------------------------------------------------ panel 1: the limits
   //
   // Two cross-project property mappings, and the second one matters more than it looks:
   // `creditLimit[clmCreditLimit]` is the anchor BOTH of credit-limits' milestoned routes
   // hang off, so the dated `approvedThresholdOn(date)` and `ratingSymbolOn(date)` on this
   // class resolve through it -- one into credit-limits' own <<temporal.businesstemporal>>
   // class, one on through credit-core into core-ratings'. Neither temporal class is named
   // here and neither could be: core-ratings is transitive, not declared.
   risk_dashboard::RdbLimitPanelRow[rdbLimitPanel]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_LIMIT_PANEL.COB_DATE,
         [risk_dashboard::Store]RDB_LIMIT_PANEL.CREDIT_LIMIT_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_LIMIT_PANEL
      cobDate: [risk_dashboard::Store]RDB_LIMIT_PANEL.COB_DATE,
      creditLimitId: [risk_dashboard::Store]RDB_LIMIT_PANEL.CREDIT_LIMIT_ID,
      counterpartyId: [risk_dashboard::Store]RDB_LIMIT_PANEL.COUNTERPARTY_ID,
      obligorId: [risk_dashboard::Store]RDB_LIMIT_PANEL.OBLIGOR_ID,
      bookId: [risk_dashboard::Store]RDB_LIMIT_PANEL.BOOK_ID,
      measureCode: [risk_dashboard::Store]RDB_LIMIT_PANEL.MEASURE_CODE,
      utilisedAmount: [risk_dashboard::Store]RDB_LIMIT_PANEL.UTILISED_AMOUNT,
      appliedThreshold: [risk_dashboard::Store]RDB_LIMIT_PANEL.APPLIED_THRESHOLD,
      headroomAmount: [risk_dashboard::Store]RDB_LIMIT_PANEL.HEADROOM_AMOUNT,
      utilisationPct: [risk_dashboard::Store]RDB_LIMIT_PANEL.UTILISATION_PCT,
      ratingSymbol: [risk_dashboard::Store]RDB_LIMIT_PANEL.RATING_SYMBOL,
      currencyCode: [risk_dashboard::Store]RDB_LIMIT_PANEL.CURRENCY_CODE,
      contributorCount: [risk_dashboard::Store]RDB_LIMIT_PANEL.CONTRIBUTOR_COUNT,
      isBreached: [risk_dashboard::Store]RDB_LIMIT_PANEL.IS_BREACHED,
      rankPosition: [risk_dashboard::Store]RDB_LIMIT_PANEL.RANK_POSITION,
      tileId: [risk_dashboard::Store]RDB_LIMIT_PANEL.TILE_ID,
      // CROSS-PROJECT, both of them.
      utilisationLine[clmUtilisationLine]: [risk_dashboard::Store]@Rdb_LimitPanelUtilisation,
      creditLimit[clmCreditLimit]: [risk_dashboard::Store]@Rdb_LimitPanelCreditLimit,
      tile[rdbTile]: [risk_dashboard::Store]@Rdb_LimitPanelTile,
      counterpartyTotal[rdbCounterpartyLimitTotal]: [risk_dashboard::Store]@Rdb_LimitPanelCounterpartyTotal
   }

   risk_dashboard::RdbLimitBreachRow[rdbLimitBreach]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_LIMIT_BREACH.COB_DATE,
         [risk_dashboard::Store]RDB_LIMIT_BREACH.EXCESS_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_LIMIT_BREACH
      cobDate: [risk_dashboard::Store]RDB_LIMIT_BREACH.COB_DATE,
      excessId: [risk_dashboard::Store]RDB_LIMIT_BREACH.EXCESS_ID,
      creditLimitId: [risk_dashboard::Store]RDB_LIMIT_BREACH.CREDIT_LIMIT_ID,
      counterpartyId: [risk_dashboard::Store]RDB_LIMIT_BREACH.COUNTERPARTY_ID,
      breachedThreshold: [risk_dashboard::Store]RDB_LIMIT_BREACH.BREACHED_THRESHOLD,
      observedAmount: [risk_dashboard::Store]RDB_LIMIT_BREACH.OBSERVED_AMOUNT,
      excessAmount: [risk_dashboard::Store]RDB_LIMIT_BREACH.EXCESS_AMOUNT,
      approvedAmount: [risk_dashboard::Store]RDB_LIMIT_BREACH.APPROVED_AMOUNT,
      severity: [risk_dashboard::Store]RDB_LIMIT_BREACH.SEVERITY,
      severityCode: [risk_dashboard::Store]RDB_LIMIT_BREACH.SEVERITY_CODE,
      ticketId: [risk_dashboard::Store]RDB_LIMIT_BREACH.TICKET_ID,
      ageDays: [risk_dashboard::Store]RDB_LIMIT_BREACH.AGE_DAYS,
      currencyCode: [risk_dashboard::Store]RDB_LIMIT_BREACH.CURRENCY_CODE,
      ownerId: [risk_dashboard::Store]RDB_LIMIT_BREACH.OWNER_ID,
      detectedAt: [risk_dashboard::Store]RDB_LIMIT_BREACH.DETECTED_AT,
      clearedOn: [risk_dashboard::Store]RDB_LIMIT_BREACH.CLEARED_ON,
      excess[clmExcess]: [risk_dashboard::Store]@Rdb_BreachExcess,
      ticket[clmEscalationTicket]: [risk_dashboard::Store]@Rdb_BreachTicket
   }

   // ------------------------------------------------------------ panel 2: the margin

   risk_dashboard::RdbMarginCallRow[rdbMarginCall]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.COB_DATE,
         [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL.AGREEMENT_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_MARGIN_CALL_PANEL
