      domainCode: [risk_dashboard::Store]RDB_SEVERITY_TOTAL.DOMAIN_CODE,
      severity: [risk_dashboard::Store]RDB_SEVERITY_TOTAL.SEVERITY,
      exceptionCount: [risk_dashboard::Store]RDB_SEVERITY_TOTAL.EXCEPTION_COUNT,
      totalAmount: [risk_dashboard::Store]RDB_SEVERITY_TOTAL.TOTAL_AMOUNT,
      largestAmount: [risk_dashboard::Store]RDB_SEVERITY_TOTAL.LARGEST_AMOUNT,
      smallestAmount: [risk_dashboard::Store]RDB_SEVERITY_TOTAL.SMALLEST_AMOUNT,
      exceptions[rdbException]: [risk_dashboard::Store]@Rdb_ExceptionSeverityTotal
   }

   risk_dashboard::RdbCounterpartyLimitTotal[rdbCounterpartyLimitTotal]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_COUNTERPARTY_LIMIT_TOTAL.COB_DATE,
         [risk_dashboard::Store]RDB_COUNTERPARTY_LIMIT_TOTAL.COUNTERPARTY_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_COUNTERPARTY_LIMIT_TOTAL
