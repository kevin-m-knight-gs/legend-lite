      dashboard[rdbDashboard]: [risk_dashboard::Store]@Rdb_DashboardDayTotals,
      snapshots[rdbTileSnapshot]: [risk_dashboard::Store]@Rdb_SnapshotDayTotal
   }

   risk_dashboard::RdbOwnerQueueTotal[rdbOwnerQueueTotal]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_OWNER_QUEUE_TOTAL.COB_DATE,
         [risk_dashboard::Store]RDB_OWNER_QUEUE_TOTAL.OWNER_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_OWNER_QUEUE_TOTAL
