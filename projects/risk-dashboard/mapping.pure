   }

   // `portfolioTotal[mgnPortfolioMarginTotal]` is a set rooted on ANOTHER PROJECT'S STORE
   // VIEW. Navigating it crosses into margin-calc's GROUP BY and never reads a position.
   risk_dashboard::RdbMarginShortfallRow[rdbMarginShortfall]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.COB_DATE,
         [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.MARGIN_PORTFOLIO_ID,
         [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.METHOD_CODE
      )
      ~mainTable [risk_dashboard::Store]RDB_MARGIN_SHORTFALL
      cobDate: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.COB_DATE,
      marginPortfolioId: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.MARGIN_PORTFOLIO_ID,
      methodCode: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.METHOD_CODE,
      agreementId: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.AGREEMENT_ID,
      counterpartyId: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.COUNTERPARTY_ID,
      oneDayMargin: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.ONE_DAY_MARGIN,
      scaledMargin: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.SCALED_MARGIN,
      concentrationAddOn: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.CONCENTRATION_ADDON,
      liquidityAddOn: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.LIQUIDITY_ADDON,
      totalInitialMargin: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.TOTAL_INITIAL_MARGIN,
      closeOutPeriodDays: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.CLOSE_OUT_PERIOD_DAYS,
      collateralHeld: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.COLLATERAL_HELD,
      shortfallAmount: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.SHORTFALL_AMOUNT,
      imCurrency: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.IM_CURRENCY,
      rankPosition: [risk_dashboard::Store]RDB_MARGIN_SHORTFALL.RANK_POSITION,
      initialMargin[mgnInitialMargin]: [risk_dashboard::Store]@Rdb_ShortfallInitialMargin,
      // CROSS-PROJECT, INTO A GROUP.
      portfolioTotal[mgnPortfolioMarginTotal]: [risk_dashboard::Store]@Rdb_ShortfallPortfolioTotal
   }

   // ------------------------------------------------------------ panel 3: the explain

   // `accountTotal[pnlAccountDayTotal]` is another project's view set, matched on all four of
   // its grouping columns.
   risk_dashboard::RdbExplainRow[rdbExplain]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_EXPLAIN_PANEL.ATTRIBUTION_ID,
         [risk_dashboard::Store]RDB_EXPLAIN_PANEL.INSTITUTION_ID,
         [risk_dashboard::Store]RDB_EXPLAIN_PANEL.ACCOUNT_NO,
         [risk_dashboard::Store]RDB_EXPLAIN_PANEL.COB_DATE
      )
      ~mainTable [risk_dashboard::Store]RDB_EXPLAIN_PANEL
      attributionId: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.ATTRIBUTION_ID,
      institutionId: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.INSTITUTION_ID,
      accountNo: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.ACCOUNT_NO,
      cobDate: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.COB_DATE,
      deskCode: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.DESK_CODE,
      deskName: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.DESK_NAME,
      totalPnl: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.TOTAL_PNL,
      explainedPnl: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.EXPLAINED_PNL,
      unexplainedAmount: [risk_dashboard::Store]RDB_EXPLAIN_PANEL.UNEXPLAINED_AMOUNT,
