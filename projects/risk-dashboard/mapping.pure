         [risk_dashboard::Store]RDB_CONCENTRATION.FACTOR_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_CONCENTRATION
      cobDate: [risk_dashboard::Store]RDB_CONCENTRATION.COB_DATE,
      marginPortfolioId: [risk_dashboard::Store]RDB_CONCENTRATION.MARGIN_PORTFOLIO_ID,
      riskClass: [risk_dashboard::Store]RDB_CONCENTRATION.RISK_CLASS,
      factorId: [risk_dashboard::Store]RDB_CONCENTRATION.FACTOR_ID,
      counterpartyId: [risk_dashboard::Store]RDB_CONCENTRATION.COUNTERPARTY_ID,
      factorName: [risk_dashboard::Store]RDB_CONCENTRATION.FACTOR_NAME,
      netSensitivity: [risk_dashboard::Store]RDB_CONCENTRATION.NET_SENSITIVITY,
      concentrationThreshold: [risk_dashboard::Store]RDB_CONCENTRATION.CONCENTRATION_THRESHOLD,
