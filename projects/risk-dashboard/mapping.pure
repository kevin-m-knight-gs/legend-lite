      rankPosition: [risk_dashboard::Store]RDB_CONCENTRATION.RANK_POSITION,
      // CROSS-PROJECT. Through this one property the board reaches risk-core's own factor
      // GROUP, two projects away, without naming risk-core.
      addOn[mgnConcentrationAddOn]: [risk_dashboard::Store]@Rdb_ConcentrationAddOn
   }

   // ------------------------------------------------------------ the roll-ups

   // TWO CROSS-PROJECT COLLECTION PROPERTIES ON ONE SET, into two dependencies that cannot
   // reach each other. This is the fan-in at row level, as Rdb_RunMarginRun and its two
   // siblings are the fan-in at batch level.
   risk_dashboard::RdbCounterpartyRollUp[rdbCounterpartyRollUp]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.COB_DATE,
         [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.COUNTERPARTY_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP
      cobDate: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.COB_DATE,
      counterpartyId: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.COUNTERPARTY_ID,
      counterpartyName: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.COUNTERPARTY_NAME,
      obligorId: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.OBLIGOR_ID,
      limitCount: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.LIMIT_COUNT,
      totalUtilised: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.TOTAL_UTILISED,
      totalApprovedThreshold: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.TOTAL_APPROVED_THRESHOLD,
      openExcessCount: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.OPEN_EXCESS_COUNT,
      ratingSymbol: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.RATING_SYMBOL,
      marginAgreementCount: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.MARGIN_AGREEMENT_COUNT,
      outstandingCallAmount: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.OUTSTANDING_CALL_AMOUNT,
      initialMarginHeld: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.INITIAL_MARGIN_HELD,
      collateralHeld: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.COLLATERAL_HELD,
      pnlLineCount: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.PNL_LINE_COUNT,
      pnlAmount: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.PNL_AMOUNT,
      unexplainedAmount: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.UNEXPLAINED_AMOUNT,
      reportingCurrency: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.REPORTING_CCY,
      riskRank: [risk_dashboard::Store]RDB_COUNTERPARTY_ROLLUP.RISK_RANK,
      creditLimits[clmCreditLimit]: [risk_dashboard::Store]@Rdb_RollUpCreditLimits,
      marginAgreements[mgnAgreement]: [risk_dashboard::Store]@Rdb_RollUpMarginAgreements,
      limitTotal[rdbCounterpartyLimitTotal]: [risk_dashboard::Store]@Rdb_RollUpCounterpartyTotal
   }

   risk_dashboard::RdbDeskRollUp[rdbDeskRollUp]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_DESK_ROLLUP.COB_DATE,
         [risk_dashboard::Store]RDB_DESK_ROLLUP.INSTITUTION_ID,
         [risk_dashboard::Store]RDB_DESK_ROLLUP.ACCOUNT_NO
      )
      ~mainTable [risk_dashboard::Store]RDB_DESK_ROLLUP
      cobDate: [risk_dashboard::Store]RDB_DESK_ROLLUP.COB_DATE,
      institutionId: [risk_dashboard::Store]RDB_DESK_ROLLUP.INSTITUTION_ID,
      accountNo: [risk_dashboard::Store]RDB_DESK_ROLLUP.ACCOUNT_NO,
      attributionId: [risk_dashboard::Store]RDB_DESK_ROLLUP.ATTRIBUTION_ID,
      deskCode: [risk_dashboard::Store]RDB_DESK_ROLLUP.DESK_CODE,
      deskName: [risk_dashboard::Store]RDB_DESK_ROLLUP.DESK_NAME,
      totalPnl: [risk_dashboard::Store]RDB_DESK_ROLLUP.TOTAL_PNL,
      unexplainedAmount: [risk_dashboard::Store]RDB_DESK_ROLLUP.UNEXPLAINED_AMOUNT,
      marginCharged: [risk_dashboard::Store]RDB_DESK_ROLLUP.MARGIN_CHARGED,
      worstUtilisationPct: [risk_dashboard::Store]RDB_DESK_ROLLUP.WORST_UTILISATION_PCT,
      exceptionCount: [risk_dashboard::Store]RDB_DESK_ROLLUP.EXCEPTION_COUNT,
      ownerId: [risk_dashboard::Store]RDB_DESK_ROLLUP.OWNER_ID,
      reportingCurrency: [risk_dashboard::Store]RDB_DESK_ROLLUP.REPORTING_CCY,
      accountTotal[pnlAccountDayTotal]: [risk_dashboard::Store]@Rdb_DeskAccountTotal,
      owner[rdbOwner]: [risk_dashboard::Store]@Rdb_DeskOwner
   }

   // ------------------------------------------------------------ panel 6: the queue
   //
   // The BASE set. Everything shared by the four types is mapped here once: the key, the main
   // table, and every column the three subtypes have in common. Nothing subtype-specific
   // appears -- a property declared on a subclass cannot be mapped on the parent's set, and
   // the error would name the property rather than the set it was wrongly written in.
   risk_dashboard::RdbException[rdbException]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_EXCEPTION.COB_DATE,
         [risk_dashboard::Store]RDB_EXCEPTION.EXCEPTION_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_EXCEPTION
      cobDate: [risk_dashboard::Store]RDB_EXCEPTION.COB_DATE,
      exceptionId: [risk_dashboard::Store]RDB_EXCEPTION.EXCEPTION_ID,
      tileId: [risk_dashboard::Store]RDB_EXCEPTION.TILE_ID,
      domainCode: [risk_dashboard::Store]RDB_EXCEPTION.DOMAIN_CODE,
      exceptionCode: [risk_dashboard::Store]RDB_EXCEPTION.EXCEPTION_CODE,
      title: [risk_dashboard::Store]RDB_EXCEPTION.TITLE,
      severity: [risk_dashboard::Store]RDB_EXCEPTION.SEVERITY,
      ownerId: [risk_dashboard::Store]RDB_EXCEPTION.OWNER_ID,
      amount: [risk_dashboard::Store]RDB_EXCEPTION.AMOUNT,
      thresholdAmount: [risk_dashboard::Store]RDB_EXCEPTION.THRESHOLD_AMOUNT,
      currencyCode: [risk_dashboard::Store]RDB_EXCEPTION.CURRENCY_CODE,
      raisedAt: [risk_dashboard::Store]RDB_EXCEPTION.RAISED_AT,
      dueBy: [risk_dashboard::Store]RDB_EXCEPTION.DUE_BY,
      decidedOn: [risk_dashboard::Store]RDB_EXCEPTION.DECIDED_ON,
      carriedFromDate: [risk_dashboard::Store]RDB_EXCEPTION.CARRIED_FROM_DATE,
      statusCode: [risk_dashboard::Store]RDB_EXCEPTION.STATUS_CODE,
      tile[rdbTile]: [risk_dashboard::Store]@Rdb_TileExceptions,
      owner[rdbOwner]: [risk_dashboard::Store]@Rdb_ExceptionOwner,
      snapshot[rdbTileSnapshot]: [risk_dashboard::Store]@Rdb_SnapshotExceptions,
      escalations[rdbEscalation]: [risk_dashboard::Store]@Rdb_ExceptionEscalations,
      decisions[rdbDecision]: [risk_dashboard::Store]@Rdb_ExceptionDecisions,
      // INTO BOTH AGGREGATIONS this table is grouped into.
      ownerQueue[rdbOwnerQueueTotal]: [risk_dashboard::Store]@Rdb_ExceptionOwnerTotal,
      severityTotal[rdbSeverityTotal]: [risk_dashboard::Store]@Rdb_ExceptionSeverityTotal
   }

   // The three subtypes. Each adds nothing but a ~filter on DOMAIN_CODE and the two columns
   // that mean something for that one domain.
   risk_dashboard::RdbLimitException[rdbLimitException] extends [rdbException]: Relational
   {
      ~filter [risk_dashboard::Store]RdbLimitExceptionRows
      creditLimitId: [risk_dashboard::Store]RDB_EXCEPTION.CREDIT_LIMIT_ID,
      excessId: [risk_dashboard::Store]RDB_EXCEPTION.EXCESS_ID
   }

   risk_dashboard::RdbMarginException[rdbMarginException] extends [rdbException]: Relational
   {
      ~filter [risk_dashboard::Store]RdbMarginExceptionRows
      agreementId: [risk_dashboard::Store]RDB_EXCEPTION.AGREEMENT_ID,
      marginPortfolioId: [risk_dashboard::Store]RDB_EXCEPTION.MARGIN_PORTFOLIO_ID
   }

   risk_dashboard::RdbExplainException[rdbExplainException] extends [rdbException]: Relational
   {
      ~filter [risk_dashboard::Store]RdbExplainExceptionRows
      attributionId: [risk_dashboard::Store]RDB_EXCEPTION.ATTRIBUTION_ID,
      instrumentId: [risk_dashboard::Store]RDB_EXCEPTION.INSTRUMENT_ID
   }

   risk_dashboard::RdbEscalation[rdbEscalation]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_ESCALATION.EXCEPTION_ID,
         [risk_dashboard::Store]RDB_ESCALATION.ESCALATION_SEQ
      )
      ~mainTable [risk_dashboard::Store]RDB_ESCALATION
      exceptionId: [risk_dashboard::Store]RDB_ESCALATION.EXCEPTION_ID,
      escalationSeq: [risk_dashboard::Store]RDB_ESCALATION.ESCALATION_SEQ,
      toOwnerId: [risk_dashboard::Store]RDB_ESCALATION.TO_OWNER_ID,
      escalationLevel: [risk_dashboard::Store]RDB_ESCALATION.ESCALATION_LEVEL,
      channelCode: [risk_dashboard::Store]RDB_ESCALATION.CHANNEL_CODE,
      raisedAt: [risk_dashboard::Store]RDB_ESCALATION.RAISED_AT,
      acknowledgedAt: [risk_dashboard::Store]RDB_ESCALATION.ACKNOWLEDGED_AT,
      note: [risk_dashboard::Store]RDB_ESCALATION.NOTE,
      exception[rdbException]: [risk_dashboard::Store]@Rdb_ExceptionEscalations,
      toOwner[rdbOwner]: [risk_dashboard::Store]@Rdb_EscalationOwner
   }

   risk_dashboard::RdbDecision[rdbDecision]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_DECISION.EXCEPTION_ID,
         [risk_dashboard::Store]RDB_DECISION.DECISION_SEQ
      )
      ~mainTable [risk_dashboard::Store]RDB_DECISION
      exceptionId: [risk_dashboard::Store]RDB_DECISION.EXCEPTION_ID,
      decisionSeq: [risk_dashboard::Store]RDB_DECISION.DECISION_SEQ,
      decisionCode: [risk_dashboard::Store]RDB_DECISION.DECISION_CODE,
      decidedBy: [risk_dashboard::Store]RDB_DECISION.DECIDED_BY,
      decidedOn: [risk_dashboard::Store]RDB_DECISION.DECIDED_ON,
      amountApproved: [risk_dashboard::Store]RDB_DECISION.AMOUNT_APPROVED,
      validUntil: [risk_dashboard::Store]RDB_DECISION.VALID_UNTIL,
      rationale: [risk_dashboard::Store]RDB_DECISION.RATIONALE,
      exception[rdbException]: [risk_dashboard::Store]@Rdb_ExceptionDecisions
   }

   risk_dashboard::RdbCommentary[rdbCommentary]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_COMMENTARY.TILE_ID,
         [risk_dashboard::Store]RDB_COMMENTARY.COB_DATE,
         [risk_dashboard::Store]RDB_COMMENTARY.COMMENT_SEQ
      )
      ~mainTable [risk_dashboard::Store]RDB_COMMENTARY
      tileId: [risk_dashboard::Store]RDB_COMMENTARY.TILE_ID,
      cobDate: [risk_dashboard::Store]RDB_COMMENTARY.COB_DATE,
      commentSeq: [risk_dashboard::Store]RDB_COMMENTARY.COMMENT_SEQ,
      authorId: [risk_dashboard::Store]RDB_COMMENTARY.AUTHOR_ID,
      commentText: [risk_dashboard::Store]RDB_COMMENTARY.COMMENT_TEXT,
      isPublished: [risk_dashboard::Store]RDB_COMMENTARY.IS_PUBLISHED,
      postedAt: [risk_dashboard::Store]RDB_COMMENTARY.POSTED_AT,
      tile[rdbTile]: [risk_dashboard::Store]@Rdb_TileCommentary,
      author[rdbOwner]: [risk_dashboard::Store]@Rdb_CommentaryAuthor
   }

   risk_dashboard::RdbWatchItem[rdbWatchItem]: Relational
   {
      ~primaryKey
      (
         [risk_dashboard::Store]RDB_WATCH_ITEM.WATCH_ID
      )
      ~mainTable [risk_dashboard::Store]RDB_WATCH_ITEM
      watchId: [risk_dashboard::Store]RDB_WATCH_ITEM.WATCH_ID,
      exceptionId: [risk_dashboard::Store]RDB_WATCH_ITEM.EXCEPTION_ID,
      counterpartyId: [risk_dashboard::Store]RDB_WATCH_ITEM.COUNTERPARTY_ID,
