      currency: [core_book::Store] CB_COST_CENTRE.CURRENCY
   }

   *core_book::BookMandate[cbBookMandate]: Relational
   {
      ~mainTable [core_book::Store] CB_BOOK_MANDATE
      mandateId: [core_book::Store] CB_BOOK_MANDATE.MANDATE_ID,
      mandateType: [core_book::Store] CB_BOOK_MANDATE.MANDATE_TYPE,
      permittedAssetClasses: [core_book::Store] CB_BOOK_MANDATE.PERMITTED_ASSET_CLASSES,
      maxNotional: [core_book::Store] CB_BOOK_MANDATE.MAX_NOTIONAL,
      approvedDate: [core_book::Store] CB_BOOK_MANDATE.APPROVED_DATE,
      isActive: [core_book::Store] CB_BOOK_MANDATE.IS_ACTIVE
   }

   *core_book::BookApproval[cbBookApproval]: Relational
   {
      ~mainTable [core_book::Store] CB_BOOK_APPROVAL
      approvalId: [core_book::Store] CB_BOOK_APPROVAL.APPROVAL_ID,
      approvalType: [core_book::Store] CB_BOOK_APPROVAL.APPROVAL_TYPE,
      status: [core_book::Store] CB_BOOK_APPROVAL.STATUS,
      requestedBy: [core_book::Store] CB_BOOK_APPROVAL.REQUESTED_BY,
      approvedBy: [core_book::Store] CB_BOOK_APPROVAL.APPROVED_BY,
      requestDate: [core_book::Store] CB_BOOK_APPROVAL.REQUEST_DATE,
      decisionDate: [core_book::Store] CB_BOOK_APPROVAL.DECISION_DATE
   }

   *core_book::BookTransfer[cbBookTransfer]: Relational
   {
      ~mainTable [core_book::Store] CB_BOOK_TRANSFER
      transferId: [core_book::Store] CB_BOOK_TRANSFER.TRANSFER_ID,
      fromDeskId: [core_book::Store] CB_BOOK_TRANSFER.FROM_DESK_ID,
      toDeskId: [core_book::Store] CB_BOOK_TRANSFER.TO_DESK_ID,
      transferDate: [core_book::Store] CB_BOOK_TRANSFER.TRANSFER_DATE,
      reason: [core_book::Store] CB_BOOK_TRANSFER.REASON,
      isReversed: [core_book::Store] CB_BOOK_TRANSFER.IS_REVERSED
   }

   // ---- Association mappings ----
   // The self-join one. Both ends are cbBook to cbBook over the same Cb_ParentBook join;
   // the direction is what distinguishes parentBook from childBooks.
   core_book::BookParent: Relational
   {
      AssociationMapping
      (
         childBooks[cbBook, cbBook]: [core_book::Store]@Cb_ParentBook,
         parentBook[cbBook, cbBook]: [core_book::Store]@Cb_ParentBook
      )
   }

   core_book::BookDesk: Relational
   {
      AssociationMapping
      (
         desk[cbBook, cbDesk]: [core_book::Store]@Cb_BookDesk,
         books[cbDesk, cbBook]: [core_book::Store]@Cb_BookDesk
      )
   }

   core_book::DeskBusinessUnit: Relational
   {
      AssociationMapping
      (
         businessUnit[cbDesk, cbBusinessUnit]: [core_book::Store]@Cb_DeskBusinessUnit,
         desks[cbBusinessUnit, cbDesk]: [core_book::Store]@Cb_DeskBusinessUnit
      )
   }

   core_book::BusinessUnitDivision: Relational
   {
      AssociationMapping
      (
         division[cbBusinessUnit, cbDivision]: [core_book::Store]@Cb_BusinessUnitDivision,
         businessUnits[cbDivision, cbBusinessUnit]: [core_book::Store]@Cb_BusinessUnitDivision
      )
   }

   core_book::BookOwnership: Relational
   {
      AssociationMapping
      (
         owner[cbBook, cbBookOwner]: [core_book::Store]@Cb_BookOwner,
         ownedBooks[cbBookOwner, cbBook]: [core_book::Store]@Cb_BookOwner
      )
   }

   core_book::BookStrategyLink: Relational
   {
      AssociationMapping
      (
         strategy[cbBook, cbStrategy]: [core_book::Store]@Cb_BookStrategy,
         strategyBooks[cbStrategy, cbBook]: [core_book::Store]@Cb_BookStrategy
      )
   }

   core_book::BookClassificationLink: Relational
   {
      AssociationMapping
      (
         classification[cbBook, cbBookClassification]: [core_book::Store]@Cb_BookClassification,
         classifiedBooks[cbBookClassification, cbBook]: [core_book::Store]@Cb_BookClassification
      )
   }

   core_book::BookLimitLink: Relational
   {
      AssociationMapping
      (
         limits[cbBook, cbBookLimit]: [core_book::Store]@Cb_BookLimit,
         limitBook[cbBookLimit, cbBook]: [core_book::Store]@Cb_BookLimit
      )
   }

   core_book::DeskCostCentre: Relational
   {
      AssociationMapping
      (
         costCentre[cbDesk, cbCostCentre]: [core_book::Store]@Cb_DeskCostCentre,
         costCentreDesks[cbCostCentre, cbDesk]: [core_book::Store]@Cb_DeskCostCentre
      )
   }

   core_book::BookMandateLink: Relational
   {
      AssociationMapping
      (
         mandates[cbBook, cbBookMandate]: [core_book::Store]@Cb_BookMandate,
         mandateBook[cbBookMandate, cbBook]: [core_book::Store]@Cb_BookMandate
