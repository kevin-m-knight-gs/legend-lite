###Mapping
// One set per class, every set id cb-prefixed. The ids are not ceremony here: the
// BookParent association has core_book::Book on BOTH ends, so each end names its source
// and target set explicitly -- [cbBook, cbBook].
Mapping core_book::Mapping
(
   *core_book::Book[cbBook]: Relational
   {
      ~mainTable [core_book::Store] CB_BOOK
      bookId: [core_book::Store] CB_BOOK.BOOK_ID,
      code: [core_book::Store] CB_BOOK.CODE,
      name: [core_book::Store] CB_BOOK.NAME,
      parentBookId: [core_book::Store] CB_BOOK.PARENT_BOOK_ID,
      baseCurrency: [core_book::Store] CB_BOOK.BASE_CURRENCY,
      isActive: [core_book::Store] CB_BOOK.IS_ACTIVE,
      openDate: [core_book::Store] CB_BOOK.OPEN_DATE,
      closeDate: [core_book::Store] CB_BOOK.CLOSE_DATE,
      depth: [core_book::Store] CB_BOOK.DEPTH,
      description: [core_book::Store] CB_BOOK.DESCRIPTION
   }

   *core_book::Desk[cbDesk]: Relational
   {
      ~mainTable [core_book::Store] CB_DESK
      deskId: [core_book::Store] CB_DESK.DESK_ID,
      name: [core_book::Store] CB_DESK.NAME,
      assetClass: [core_book::Store] CB_DESK.ASSET_CLASS,
      regionCode: [core_book::Store] CB_DESK.REGION_CODE,
      headTrader: [core_book::Store] CB_DESK.HEAD_TRADER,
      isActive: [core_book::Store] CB_DESK.IS_ACTIVE
   }

   *core_book::BusinessUnit[cbBusinessUnit]: Relational
   {
      ~mainTable [core_book::Store] CB_BUSINESS_UNIT
      businessUnitId: [core_book::Store] CB_BUSINESS_UNIT.BUSINESS_UNIT_ID,
      name: [core_book::Store] CB_BUSINESS_UNIT.NAME,
      head: [core_book::Store] CB_BUSINESS_UNIT.HEAD,
      headcount: [core_book::Store] CB_BUSINESS_UNIT.HEADCOUNT,
      isActive: [core_book::Store] CB_BUSINESS_UNIT.IS_ACTIVE
   }

   *core_book::Division[cbDivision]: Relational
   {
      ~mainTable [core_book::Store] CB_DIVISION
      divisionId: [core_book::Store] CB_DIVISION.DIVISION_ID,
      name: [core_book::Store] CB_DIVISION.NAME,
      head: [core_book::Store] CB_DIVISION.HEAD,
      isActive: [core_book::Store] CB_DIVISION.IS_ACTIVE
   }

   *core_book::BookOwner[cbBookOwner]: Relational
   {
      ~mainTable [core_book::Store] CB_BOOK_OWNER
      ownerId: [core_book::Store] CB_BOOK_OWNER.OWNER_ID,
      firstName: [core_book::Store] CB_BOOK_OWNER.FIRST_NAME,
      lastName: [core_book::Store] CB_BOOK_OWNER.LAST_NAME,
      email: [core_book::Store] CB_BOOK_OWNER.EMAIL,
      badge: [core_book::Store] CB_BOOK_OWNER.BADGE,
      isActive: [core_book::Store] CB_BOOK_OWNER.IS_ACTIVE
   }

   *core_book::Strategy[cbStrategy]: Relational
   {
      ~mainTable [core_book::Store] CB_STRATEGY
      strategyId: [core_book::Store] CB_STRATEGY.STRATEGY_ID,
      name: [core_book::Store] CB_STRATEGY.NAME,
      style: [core_book::Store] CB_STRATEGY.STYLE,
      benchmark: [core_book::Store] CB_STRATEGY.BENCHMARK,
      isActive: [core_book::Store] CB_STRATEGY.IS_ACTIVE
   }

   *core_book::BookClassification[cbBookClassification]: Relational
   {
      ~mainTable [core_book::Store] CB_BOOK_CLASSIFICATION
      classificationId: [core_book::Store] CB_BOOK_CLASSIFICATION.CLASSIFICATION_ID,
      code: [core_book::Store] CB_BOOK_CLASSIFICATION.CODE,
      name: [core_book::Store] CB_BOOK_CLASSIFICATION.NAME,
      regulatoryBucket: [core_book::Store] CB_BOOK_CLASSIFICATION.REGULATORY_BUCKET,
      isTradingBook: [core_book::Store] CB_BOOK_CLASSIFICATION.IS_TRADING_BOOK
   }

   *core_book::BookLimit[cbBookLimit]: Relational
   {
      ~mainTable [core_book::Store] CB_BOOK_LIMIT
      limitId: [core_book::Store] CB_BOOK_LIMIT.LIMIT_ID,
      limitType: [core_book::Store] CB_BOOK_LIMIT.LIMIT_TYPE,
      limitAmount: [core_book::Store] CB_BOOK_LIMIT.LIMIT_AMOUNT,
      currency: [core_book::Store] CB_BOOK_LIMIT.CURRENCY,
      effectiveDate: [core_book::Store] CB_BOOK_LIMIT.EFFECTIVE_DATE,
      expiryDate: [core_book::Store] CB_BOOK_LIMIT.EXPIRY_DATE,
      isActive: [core_book::Store] CB_BOOK_LIMIT.IS_ACTIVE
   }

   *core_book::CostCentre[cbCostCentre]: Relational
   {
      ~mainTable [core_book::Store] CB_COST_CENTRE
      costCentreId: [core_book::Store] CB_COST_CENTRE.COST_CENTRE_ID,
