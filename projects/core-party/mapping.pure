   core_party::EntityClassification[cpEntityClassification]: Relational
   {
      ~primaryKey ( [core_party::Store]CP_ENTITY_CLASSIFICATION.ENTITY_ID, [core_party::Store]CP_ENTITY_CLASSIFICATION.TAXONOMY_CODE )
      ~mainTable [core_party::Store]CP_ENTITY_CLASSIFICATION
      entityId: [core_party::Store]CP_ENTITY_CLASSIFICATION.ENTITY_ID,
      taxonomyCode: [core_party::Store]CP_ENTITY_CLASSIFICATION.TAXONOMY_CODE,
