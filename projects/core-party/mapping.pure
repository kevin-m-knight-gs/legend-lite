         group[cpGroupMembership, cpEntityGroup]: [core_party::Store]@Cp_Group_Membership
      )
   }

   core_party::EntityMemberships: Relational
   {
      AssociationMapping
      (
         entityMemberships[cpLegalEntity, cpGroupMembership]: [core_party::Store]@Cp_Entity_Membership,
         memberEntity[cpGroupMembership, cpLegalEntity]: [core_party::Store]@Cp_Entity_Membership
