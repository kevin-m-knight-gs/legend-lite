      classificationLabel: [core_party::Store]CP_ENTITY_CLASSIFICATION.CLASSIFICATION_LABEL,
      isPrimary: [core_party::Store]CP_ENTITY_CLASSIFICATION.IS_PRIMARY,
      assignedDate: [core_party::Store]CP_ENTITY_CLASSIFICATION.ASSIGNED_DATE,
