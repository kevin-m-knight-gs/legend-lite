   }


   // ---------------------------------------------------------------- associations
   // One join per association, walked in both directions. The join is declared once in the
   // store and named twice here, which is what keeps the two directions consistent.

   core_party::EntityIdentifiers: Relational
   {
      AssociationMapping
      (
         identifiers[cpLegalEntity, cpEntityIdentifier]: [core_party::Store]@Cp_Entity_Identifier,
         identifiedEntity[cpEntityIdentifier, cpLegalEntity]: [core_party::Store]@Cp_Entity_Identifier
      )
   }

   core_party::SchemeIdentifiers: Relational
   {
      AssociationMapping
      (
         issuedIdentifiers[cpIdentifierScheme, cpEntityIdentifier]: [core_party::Store]@Cp_Scheme_Identifier,
         scheme[cpEntityIdentifier, cpIdentifierScheme]: [core_party::Store]@Cp_Scheme_Identifier
      )
   }

   core_party::EntityNames: Relational
   {
      AssociationMapping
      (
         names[cpLegalEntity, cpEntityName]: [core_party::Store]@Cp_Entity_Name,
         namedEntity[cpEntityName, cpLegalEntity]: [core_party::Store]@Cp_Entity_Name
      )
   }

   core_party::EntityAddresses: Relational
   {
      AssociationMapping
      (
         addresses[cpLegalEntity, cpEntityAddress]: [core_party::Store]@Cp_Entity_Address,
         addressedEntity[cpEntityAddress, cpLegalEntity]: [core_party::Store]@Cp_Entity_Address
      )
   }

   core_party::EntityClassifications: Relational
   {
      AssociationMapping
      (
         classifications[cpLegalEntity, cpEntityClassification]: [core_party::Store]@Cp_Entity_Classification,
         classifiedEntity[cpEntityClassification, cpLegalEntity]: [core_party::Store]@Cp_Entity_Classification
      )
   }

   core_party::EntityRegistrations: Relational
   {
      AssociationMapping
      (
         registrations[cpLegalEntity, cpEntityRegistration]: [core_party::Store]@Cp_Entity_Registration,
         registeredEntity[cpEntityRegistration, cpLegalEntity]: [core_party::Store]@Cp_Entity_Registration
      )
   }

   core_party::AuthorityRegistrations: Relational
   {
      AssociationMapping
      (
         authorityRegistrations[cpRegistrationAuthority, cpEntityRegistration]: [core_party::Store]@Cp_Authority_Registration,
         authority[cpEntityRegistration, cpRegistrationAuthority]: [core_party::Store]@Cp_Authority_Registration
      )
   }

   // Downward: the entity id matches PARENT_ENTITY_ID.
   core_party::ParentEdges: Relational
   {
      AssociationMapping
      (
         subsidiaryEdges[cpLegalEntity, cpEntityRelationship]: [core_party::Store]@Cp_Parent_Relationship,
         parentEntity[cpEntityRelationship, cpLegalEntity]: [core_party::Store]@Cp_Parent_Relationship
      )
   }

   // Upward: the same table, the same class pair, a DIFFERENT column. Two associations over
   // one table is the honest way to say that.
   core_party::ChildEdges: Relational
   {
      AssociationMapping
      (
         parentEdges[cpLegalEntity, cpEntityRelationship]: [core_party::Store]@Cp_Child_Relationship,
         childEntity[cpEntityRelationship, cpLegalEntity]: [core_party::Store]@Cp_Child_Relationship
      )
   }

   core_party::GroupMemberships: Relational
