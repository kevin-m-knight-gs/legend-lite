      )
   }

   // The two-column join. Reaching a legal form takes both key columns, and this is where
   // the composite key on CP_LEGAL_FORM is actually spent.
   core_party::EntityForm: Relational
   {
      AssociationMapping
      (
         legalForm[cpLegalEntity, cpLegalForm]: [core_party::Store]@Cp_Entity_LegalForm,
