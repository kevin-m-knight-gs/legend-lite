###Mapping
// ops_control::Mapping -- thirteen class sets and twenty-five association mappings.
//
// It INCLUDES both dependency mappings, and that is not optional: an association end typed
// custody_recon::ReconBreak can only be mapped if the set that maps it is in scope. Every
// one of those sets has an EXPLICIT id, so every end here names it -- `rcnBreak`,
// `sflReconciliationBreak` -- because the default ids (`custody_recon_ReconBreak`) do not
// exist at all.
//
// The same is true of this project's own sets: all thirteen are named `ops*`, so an
// AssociationMapping end must give BOTH ids, `[sourceSetId, targetSetId]`. The bare
// `prop: [db]@Join` form only resolves against default ids and would fail here naming the
// property rather than the id it could not find.
Mapping ops_control::Mapping
(
   include custody_recon::Mapping
   include settlement_flow::Mapping

   // ---------------------------------------------------------- the standing set-up

   *ops_control::OpsControl[opsControl]: Relational
   {
      ~primaryKey ( [ops_control::Store]OPS_CONTROL.CONTROL_CODE )
      ~mainTable [ops_control::Store]OPS_CONTROL
      controlCode: [ops_control::Store]OPS_CONTROL.CONTROL_CODE,
      controlName: [ops_control::Store]OPS_CONTROL.CONTROL_NAME,
      controlDomain: [ops_control::Store]OPS_CONTROL.CONTROL_DOMAIN,
      frequency: [ops_control::Store]OPS_CONTROL.FREQUENCY,
      frequencyDays: [ops_control::Store]OPS_CONTROL.FREQUENCY_DAYS,
      toleranceAmount: [ops_control::Store]OPS_CONTROL.TOLERANCE_AMOUNT,
      tolerancePercent: [ops_control::Store]OPS_CONTROL.TOLERANCE_PERCENT,
      toleranceCurrency: [ops_control::Store]OPS_CONTROL.TOLERANCE_CURRENCY,
      remediationDays: [ops_control::Store]OPS_CONTROL.REMEDIATION_DAYS,
      isKeyControl: [ops_control::Store]OPS_CONTROL.IS_KEY_CONTROL,
      reconCode: [ops_control::Store]OPS_CONTROL.RECON_CODE,
      introducedOn: [ops_control::Store]OPS_CONTROL.INTRODUCED_ON,
      retiredOn: [ops_control::Store]OPS_CONTROL.RETIRED_ON
   }

   *ops_control::OpsControlOwner[opsControlOwner]: Relational
   {
      ~primaryKey ( [ops_control::Store]OPS_OWNER.OWNER_ID )
      ~mainTable [ops_control::Store]OPS_OWNER
      ownerId: [ops_control::Store]OPS_OWNER.OWNER_ID,
      ownerName: [ops_control::Store]OPS_OWNER.OWNER_NAME,
      ownerTeam: [ops_control::Store]OPS_OWNER.OWNER_TEAM,
      deskName: [ops_control::Store]OPS_OWNER.DESK_NAME,
      escalationTo: [ops_control::Store]OPS_OWNER.ESCALATION_TO,
      escalationLevel: [ops_control::Store]OPS_OWNER.ESCALATION_LEVEL,
      contactEmail: [ops_control::Store]OPS_OWNER.CONTACT_EMAIL
   }

   *ops_control::OpsEvidenceRequirement[opsEvidenceRequirement]: Relational
   {
      ~primaryKey ( [ops_control::Store]OPS_EVIDENCE_REQUIREMENT.EVIDENCE_CODE )
      ~mainTable [ops_control::Store]OPS_EVIDENCE_REQUIREMENT
      evidenceCode: [ops_control::Store]OPS_EVIDENCE_REQUIREMENT.EVIDENCE_CODE,
      evidenceKind: [ops_control::Store]OPS_EVIDENCE_REQUIREMENT.EVIDENCE_KIND,
      description: [ops_control::Store]OPS_EVIDENCE_REQUIREMENT.DESCRIPTION,
      retentionDays: [ops_control::Store]OPS_EVIDENCE_REQUIREMENT.RETENTION_DAYS,
      minArtefacts: [ops_control::Store]OPS_EVIDENCE_REQUIREMENT.MIN_ARTEFACTS,
      requiresSignature: [ops_control::Store]OPS_EVIDENCE_REQUIREMENT.REQUIRES_SIGNATURE,
      requiresFourEyes: [ops_control::Store]OPS_EVIDENCE_REQUIREMENT.REQUIRES_FOUR_EYES
   }

   // ---------------------------------------------------------- did it operate?

   // TWO primary key columns. `operatedOn` is mapped and nullable -- the whole
   // did-it-operate question is that column being null or not.
   *ops_control::OpsControlRun[opsControlRun]: Relational
   {
      ~primaryKey
      (
         [ops_control::Store]OPS_CONTROL_RUN.CONTROL_CODE,
         [ops_control::Store]OPS_CONTROL_RUN.COB_DATE
      )
      ~mainTable [ops_control::Store]OPS_CONTROL_RUN
      controlCode: [ops_control::Store]OPS_CONTROL_RUN.CONTROL_CODE,
      cobDate: [ops_control::Store]OPS_CONTROL_RUN.COB_DATE,
      dueOn: [ops_control::Store]OPS_CONTROL_RUN.DUE_ON,
      operatedOn: [ops_control::Store]OPS_CONTROL_RUN.OPERATED_ON,
      operatedBy: [ops_control::Store]OPS_CONTROL_RUN.OPERATED_BY,
      outcome: [ops_control::Store]OPS_CONTROL_RUN.OUTCOME,
      itemsChecked: [ops_control::Store]OPS_CONTROL_RUN.ITEMS_CHECKED,
      exceptionCount: [ops_control::Store]OPS_CONTROL_RUN.EXCEPTION_COUNT,
      observedAmount: [ops_control::Store]OPS_CONTROL_RUN.OBSERVED_AMOUNT,
      toleranceApplied: [ops_control::Store]OPS_CONTROL_RUN.TOLERANCE_APPLIED,
      evidenceCount: [ops_control::Store]OPS_CONTROL_RUN.EVIDENCE_COUNT,
      reconCode: [ops_control::Store]OPS_CONTROL_RUN.RECON_CODE,
      runSeq: [ops_control::Store]OPS_CONTROL_RUN.RUN_SEQ
   }

   *ops_control::OpsEvidenceItem[opsEvidenceItem]: Relational
   {
      ~primaryKey
      (
         [ops_control::Store]OPS_EVIDENCE_ITEM.CONTROL_CODE,
         [ops_control::Store]OPS_EVIDENCE_ITEM.COB_DATE,
         [ops_control::Store]OPS_EVIDENCE_ITEM.ARTEFACT_SEQ
      )
      ~mainTable [ops_control::Store]OPS_EVIDENCE_ITEM
      controlCode: [ops_control::Store]OPS_EVIDENCE_ITEM.CONTROL_CODE,
      cobDate: [ops_control::Store]OPS_EVIDENCE_ITEM.COB_DATE,
      artefactSeq: [ops_control::Store]OPS_EVIDENCE_ITEM.ARTEFACT_SEQ,
      artefactKind: [ops_control::Store]OPS_EVIDENCE_ITEM.ARTEFACT_KIND,
      artefactRef: [ops_control::Store]OPS_EVIDENCE_ITEM.ARTEFACT_REF,
      lodgedOn: [ops_control::Store]OPS_EVIDENCE_ITEM.LODGED_ON,
      lodgedBy: [ops_control::Store]OPS_EVIDENCE_ITEM.LODGED_BY,
      isComplete: [ops_control::Store]OPS_EVIDENCE_ITEM.IS_COMPLETE
   }

   // THE SIGNATURE, three key columns -- a four-eyes control is signed twice.
   *ops_control::OpsAttestation[opsAttestation]: Relational
   {
      ~primaryKey
      (
         [ops_control::Store]OPS_ATTESTATION.CONTROL_CODE,
         [ops_control::Store]OPS_ATTESTATION.COB_DATE,
         [ops_control::Store]OPS_ATTESTATION.ATTESTATION_SEQ
      )
      ~mainTable [ops_control::Store]OPS_ATTESTATION
      controlCode: [ops_control::Store]OPS_ATTESTATION.CONTROL_CODE,
      cobDate: [ops_control::Store]OPS_ATTESTATION.COB_DATE,
      attestationSeq: [ops_control::Store]OPS_ATTESTATION.ATTESTATION_SEQ,
      attestedBy: [ops_control::Store]OPS_ATTESTATION.ATTESTED_BY,
      attestedRole: [ops_control::Store]OPS_ATTESTATION.ATTESTED_ROLE,
      attestedOn: [ops_control::Store]OPS_ATTESTATION.ATTESTED_ON,
      statement: [ops_control::Store]OPS_ATTESTATION.STATEMENT,
      isCountersignature: [ops_control::Store]OPS_ATTESTATION.IS_COUNTERSIGNATURE,
      daysLate: [ops_control::Store]OPS_ATTESTATION.DAYS_LATE,
      revokedOn: [ops_control::Store]OPS_ATTESTATION.REVOKED_ON
   }

   // ---------------------------------------------------------- when it fails

   *ops_control::OpsIssue[opsIssue]: Relational
   {
      ~primaryKey ( [ops_control::Store]OPS_ISSUE.ISSUE_ID )
      ~mainTable [ops_control::Store]OPS_ISSUE
      issueId: [ops_control::Store]OPS_ISSUE.ISSUE_ID,
      controlCode: [ops_control::Store]OPS_ISSUE.CONTROL_CODE,
      cobDate: [ops_control::Store]OPS_ISSUE.COB_DATE,
      issueType: [ops_control::Store]OPS_ISSUE.ISSUE_TYPE,
      severity: [ops_control::Store]OPS_ISSUE.SEVERITY,
      raisedOn: [ops_control::Store]OPS_ISSUE.RAISED_ON,
      raisedBy: [ops_control::Store]OPS_ISSUE.RAISED_BY,
      remediationDueOn: [ops_control::Store]OPS_ISSUE.REMEDIATION_DUE_ON,
      closedOn: [ops_control::Store]OPS_ISSUE.CLOSED_ON,
      impactAmount: [ops_control::Store]OPS_ISSUE.IMPACT_AMOUNT,
      impactCurrency: [ops_control::Store]OPS_ISSUE.IMPACT_CURRENCY,
      extensionCount: [ops_control::Store]OPS_ISSUE.EXTENSION_COUNT,
      breakReconCode: [ops_control::Store]OPS_ISSUE.BREAK_RECON_CODE,
      breakCobDate: [ops_control::Store]OPS_ISSUE.BREAK_COB_DATE,
      breakInstitutionId: [ops_control::Store]OPS_ISSUE.BREAK_INSTITUTION_ID,
      breakAccountNo: [ops_control::Store]OPS_ISSUE.BREAK_ACCOUNT_NO,
      breakInstrumentId: [ops_control::Store]OPS_ISSUE.BREAK_INSTRUMENT_ID,
      breakDepotCode: [ops_control::Store]OPS_ISSUE.BREAK_DEPOT_CODE,
      breakType: [ops_control::Store]OPS_ISSUE.BREAK_TYPE,
      settlementBreakId: [ops_control::Store]OPS_ISSUE.SETTLEMENT_BREAK_ID,
      claimId: [ops_control::Store]OPS_ISSUE.CLAIM_ID
   }

   *ops_control::OpsRemediationAction[opsRemediationAction]: Relational
   {
      ~primaryKey
      (
         [ops_control::Store]OPS_REMEDIATION_ACTION.ISSUE_ID,
         [ops_control::Store]OPS_REMEDIATION_ACTION.ACTION_SEQ
      )
      ~mainTable [ops_control::Store]OPS_REMEDIATION_ACTION
      issueId: [ops_control::Store]OPS_REMEDIATION_ACTION.ISSUE_ID,
      actionSeq: [ops_control::Store]OPS_REMEDIATION_ACTION.ACTION_SEQ,
      ownerId: [ops_control::Store]OPS_REMEDIATION_ACTION.OWNER_ID,
      actionText: [ops_control::Store]OPS_REMEDIATION_ACTION.ACTION_TEXT,
      actionStatus: [ops_control::Store]OPS_REMEDIATION_ACTION.ACTION_STATUS,
      dueOn: [ops_control::Store]OPS_REMEDIATION_ACTION.DUE_ON,
      originalDueOn: [ops_control::Store]OPS_REMEDIATION_ACTION.ORIGINAL_DUE_ON,
      completedOn: [ops_control::Store]OPS_REMEDIATION_ACTION.COMPLETED_ON,
      extensionCount: [ops_control::Store]OPS_REMEDIATION_ACTION.EXTENSION_COUNT
   }

   // ---------------------------------------------------------- the KRIs

   *ops_control::OpsKri[opsKri]: Relational
   {
      ~primaryKey ( [ops_control::Store]OPS_KRI.KRI_CODE )
      ~mainTable [ops_control::Store]OPS_KRI
      kriCode: [ops_control::Store]OPS_KRI.KRI_CODE,
      kriName: [ops_control::Store]OPS_KRI.KRI_NAME,
      kriFamily: [ops_control::Store]OPS_KRI.KRI_FAMILY,
      controlCode: [ops_control::Store]OPS_KRI.CONTROL_CODE,
