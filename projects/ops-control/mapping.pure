      measureUnit: [ops_control::Store]OPS_KRI.MEASURE_UNIT,
      amberThreshold: [ops_control::Store]OPS_KRI.AMBER_THRESHOLD,
      redThreshold: [ops_control::Store]OPS_KRI.RED_THRESHOLD,
      direction: [ops_control::Store]OPS_KRI.DIRECTION,
      reportingFrequency: [ops_control::Store]OPS_KRI.REPORTING_FREQUENCY
   }

   *ops_control::OpsKriObservation[opsKriObservation]: Relational
   {
      ~primaryKey
      (
         [ops_control::Store]OPS_KRI_OBSERVATION.KRI_CODE,
         [ops_control::Store]OPS_KRI_OBSERVATION.COB_DATE
      )
      ~mainTable [ops_control::Store]OPS_KRI_OBSERVATION
      kriCode: [ops_control::Store]OPS_KRI_OBSERVATION.KRI_CODE,
      cobDate: [ops_control::Store]OPS_KRI_OBSERVATION.COB_DATE,
      observedValue: [ops_control::Store]OPS_KRI_OBSERVATION.OBSERVED_VALUE,
      observedCount: [ops_control::Store]OPS_KRI_OBSERVATION.OBSERVED_COUNT,
      amberThreshold: [ops_control::Store]OPS_KRI_OBSERVATION.AMBER_THRESHOLD,
      redThreshold: [ops_control::Store]OPS_KRI_OBSERVATION.RED_THRESHOLD,
      ragStatus: [ops_control::Store]OPS_KRI_OBSERVATION.RAG_STATUS,
      breachedOn: [ops_control::Store]OPS_KRI_OBSERVATION.BREACHED_ON,
      commentary: [ops_control::Store]OPS_KRI_OBSERVATION.COMMENTARY
   }

   // KRI ONE, keyed exactly like custody-recon's daily break-type aggregation.
