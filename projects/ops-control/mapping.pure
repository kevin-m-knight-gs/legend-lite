   {
      ~primaryKey
      (
         [ops_control::Store]OPS_AGEING_BREAK.RECON_CODE,
         [ops_control::Store]OPS_AGEING_BREAK.COB_DATE,
         [ops_control::Store]OPS_AGEING_BREAK.BREAK_TYPE
      )
      ~mainTable [ops_control::Store]OPS_AGEING_BREAK
      reconCode: [ops_control::Store]OPS_AGEING_BREAK.RECON_CODE,
      cobDate: [ops_control::Store]OPS_AGEING_BREAK.COB_DATE,
      breakType: [ops_control::Store]OPS_AGEING_BREAK.BREAK_TYPE,
      kriCode: [ops_control::Store]OPS_AGEING_BREAK.KRI_CODE,
      openBreakCount: [ops_control::Store]OPS_AGEING_BREAK.OPEN_BREAK_COUNT,
      aged30Count: [ops_control::Store]OPS_AGEING_BREAK.AGED_30_COUNT,
      aged60Count: [ops_control::Store]OPS_AGEING_BREAK.AGED_60_COUNT,
      aged90Count: [ops_control::Store]OPS_AGEING_BREAK.AGED_90_COUNT,
      oldestAgeDays: [ops_control::Store]OPS_AGEING_BREAK.OLDEST_AGE_DAYS,
      totalBreakValue: [ops_control::Store]OPS_AGEING_BREAK.TOTAL_BREAK_VALUE,
      breakCurrency: [ops_control::Store]OPS_AGEING_BREAK.BREAK_CURRENCY,
      assignedTo: [ops_control::Store]OPS_AGEING_BREAK.ASSIGNED_TO
   }

   *ops_control::OpsUnmatchedInstructionKri[opsUnmatchedInstructionKri]: Relational
   {
      ~primaryKey
      (
         [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.COB_DATE,
         [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.LINK_ID
      )
      ~mainTable [ops_control::Store]OPS_UNMATCHED_INSTRUCTION
      cobDate: [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.COB_DATE,
      linkId: [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.LINK_ID,
      kriCode: [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.KRI_CODE,
      linkStatus: [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.LINK_STATUS,
      expectedAmount: [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.EXPECTED_AMOUNT,
      currencyCode: [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.CURRENCY_CODE,
      ageDays: [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.AGE_DAYS,
      isEscalated: [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.IS_ESCALATED,
      expectedValueDate: [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.EXPECTED_VALUE_DATE,
      claimId: [ops_control::Store]OPS_UNMATCHED_INSTRUCTION.CLAIM_ID
   }

   *ops_control::OpsUnreconciledCashKri[opsUnreconciledCashKri]: Relational
   {
      ~primaryKey
      (
         [ops_control::Store]OPS_UNRECONCILED_CASH.COB_DATE,
         [ops_control::Store]OPS_UNRECONCILED_CASH.RECON_ID
      )
      ~mainTable [ops_control::Store]OPS_UNRECONCILED_CASH
      cobDate: [ops_control::Store]OPS_UNRECONCILED_CASH.COB_DATE,
      reconId: [ops_control::Store]OPS_UNRECONCILED_CASH.RECON_ID,
      kriCode: [ops_control::Store]OPS_UNRECONCILED_CASH.KRI_CODE,
      institutionId: [ops_control::Store]OPS_UNRECONCILED_CASH.INSTITUTION_ID,
      accountNo: [ops_control::Store]OPS_UNRECONCILED_CASH.ACCOUNT_NO,
      currencyCode: [ops_control::Store]OPS_UNRECONCILED_CASH.CURRENCY_CODE,
      unreconciledAmount: [ops_control::Store]OPS_UNRECONCILED_CASH.UNRECONCILED_AMOUNT,
      itemCount: [ops_control::Store]OPS_UNRECONCILED_CASH.ITEM_COUNT,
      ageDays: [ops_control::Store]OPS_UNRECONCILED_CASH.AGE_DAYS,
      settlementBreakId: [ops_control::Store]OPS_UNRECONCILED_CASH.SETTLEMENT_BREAK_ID
   }

   // ================================================= association mappings, inside ========

   ops_control::OpsControlOwnership: Relational
   {
      AssociationMapping
      (
         owner[opsControl, opsControlOwner]: [ops_control::Store]@Ops_ControlOwner,
         ownedControls[opsControlOwner, opsControl]: [ops_control::Store]@Ops_ControlOwner
      )
   }

   ops_control::OpsControlEvidence: Relational
   {
      AssociationMapping
      (
         evidenceRequirement[opsControl, opsEvidenceRequirement]: [ops_control::Store]@Ops_ControlEvidenceRequirement,
         requiringControls[opsEvidenceRequirement, opsControl]: [ops_control::Store]@Ops_ControlEvidenceRequirement
      )
   }

   ops_control::OpsControlRuns: Relational
   {
      AssociationMapping
      (
         runs[opsControl, opsControlRun]: [ops_control::Store]@Ops_ControlRuns,
         control[opsControlRun, opsControl]: [ops_control::Store]@Ops_ControlRuns
      )
   }

   ops_control::OpsRunEvidence: Relational
   {
      AssociationMapping
      (
         evidenceItems[opsControlRun, opsEvidenceItem]: [ops_control::Store]@Ops_RunEvidenceItems,
         evidencedRun[opsEvidenceItem, opsControlRun]: [ops_control::Store]@Ops_RunEvidenceItems
      )
   }

   ops_control::OpsRunAttestations: Relational
   {
      AssociationMapping
      (
         attestations[opsControlRun, opsAttestation]: [ops_control::Store]@Ops_RunAttestations,
         attestedRun[opsAttestation, opsControlRun]: [ops_control::Store]@Ops_RunAttestations
      )
   }

   ops_control::OpsRunIssues: Relational
   {
      AssociationMapping
      (
         issues[opsControlRun, opsIssue]: [ops_control::Store]@Ops_RunIssues,
         failedRun[opsIssue, opsControlRun]: [ops_control::Store]@Ops_RunIssues
      )
   }

   ops_control::OpsIssueRemediation: Relational
   {
      AssociationMapping
      (
         actions[opsIssue, opsRemediationAction]: [ops_control::Store]@Ops_IssueActions,
         remediatedIssue[opsRemediationAction, opsIssue]: [ops_control::Store]@Ops_IssueActions
      )
   }

   ops_control::OpsActionOwner: Relational
   {
      AssociationMapping
      (
         actionOwner[opsRemediationAction, opsControlOwner]: [ops_control::Store]@Ops_ActionOwner,
         assignedActions[opsControlOwner, opsRemediationAction]: [ops_control::Store]@Ops_ActionOwner
      )
   }

   ops_control::OpsControlKris: Relational
   {
      AssociationMapping
      (
         kris[opsControl, opsKri]: [ops_control::Store]@Ops_ControlKris,
         kriControl[opsKri, opsControl]: [ops_control::Store]@Ops_ControlKris
      )
   }

   ops_control::OpsKriOwnership: Relational
   {
      AssociationMapping
      (
         kriOwner[opsKri, opsControlOwner]: [ops_control::Store]@Ops_KriOwner,
         ownedKris[opsControlOwner, opsKri]: [ops_control::Store]@Ops_KriOwner
      )
   }

   ops_control::OpsKriObservations: Relational
   {
      AssociationMapping
      (
         observations[opsKri, opsKriObservation]: [ops_control::Store]@Ops_KriObservations,
         kri[opsKriObservation, opsKri]: [ops_control::Store]@Ops_KriObservations
      )
   }

   ops_control::OpsKriAgeingBreaks: Relational
   {
      AssociationMapping
      (
         ageingBreaks[opsKri, opsAgeingBreakKri]: [ops_control::Store]@Ops_KriAgeingBreaks,
         ageingKri[opsAgeingBreakKri, opsKri]: [ops_control::Store]@Ops_KriAgeingBreaks
      )
   }

   ops_control::OpsKriUnmatched: Relational
   {
      AssociationMapping
      (
         unmatchedInstructions[opsKri, opsUnmatchedInstructionKri]: [ops_control::Store]@Ops_KriUnmatchedInstructions,
         unmatchedKri[opsUnmatchedInstructionKri, opsKri]: [ops_control::Store]@Ops_KriUnmatchedInstructions
      )
   }

   ops_control::OpsKriUnreconciled: Relational
   {
      AssociationMapping
      (
         unreconciledCash[opsKri, opsUnreconciledCashKri]: [ops_control::Store]@Ops_KriUnreconciledCash,
         cashKri[opsUnreconciledCashKri, opsKri]: [ops_control::Store]@Ops_KriUnreconciledCash
      )
   }

   // ============================ association mappings, into custody-recon =================
   // Every target id here is custody-recon's own explicit one. `custody_recon_ReconBreak`
   // does not exist and naming it would fail with a message about the id, not the project.

   ops_control::OpsControlReconDefinition: Relational
   {
      AssociationMapping
      (
         reconDefinition[opsControl, rcnDefinition]: [ops_control::Store]@Ops_ControlReconDefinition,
         opsControls[rcnDefinition, opsControl]: [ops_control::Store]@Ops_ControlReconDefinition
      )
   }

   ops_control::OpsRunReconRun: Relational
   {
      AssociationMapping
      (
         reconRun[opsControlRun, rcnRun]: [ops_control::Store]@Ops_RunReconRun,
         opsControlRuns[rcnRun, opsControlRun]: [ops_control::Store]@Ops_RunReconRun
      )
   }

   // THE SEVEN-COLUMN ONE. custody_recon::ReconBreak gains `opsIssues` here, and
   // custody-recon does not know it.
   ops_control::OpsIssueReconBreak: Relational
   {
      AssociationMapping
      (
         reconBreak[opsIssue, rcnBreak]: [ops_control::Store]@Ops_IssueReconBreak,
         opsIssues[rcnBreak, opsIssue]: [ops_control::Store]@Ops_IssueReconBreak
      )
   }

   ops_control::OpsAgeingBreakTypes: Relational
   {
      AssociationMapping
      (
         breakTypeTotal[opsAgeingBreakKri, rcnBreakTypeTotal]: [ops_control::Store]@Ops_AgeingBreakTypeTotal,
         opsAgeingKris[rcnBreakTypeTotal, opsAgeingBreakKri]: [ops_control::Store]@Ops_AgeingBreakTypeTotal
      )
   }

   ops_control::OpsAgeingAssignee: Relational
   {
      AssociationMapping
      (
         assigneeQueue[opsAgeingBreakKri, rcnAssigneeLoad]: [ops_control::Store]@Ops_AgeingAssigneeLoad,
         opsQueueKris[rcnAssigneeLoad, opsAgeingBreakKri]: [ops_control::Store]@Ops_AgeingAssigneeLoad
      )
   }

   // =========================== association mappings, into settlement-flow ================

   ops_control::OpsIssueSettlementBreak: Relational
   {
      AssociationMapping
      (
         settlementBreak[opsIssue, sflReconciliationBreak]: [ops_control::Store]@Ops_IssueSettlementBreak,
         opsIssues[sflReconciliationBreak, opsIssue]: [ops_control::Store]@Ops_IssueSettlementBreak
      )
   }

   ops_control::OpsIssueSettlementClaim: Relational
   {
      AssociationMapping
      (
         settlementClaim[opsIssue, sflSettlementClaim]: [ops_control::Store]@Ops_IssueSettlementClaim,
         opsIssues[sflSettlementClaim, opsIssue]: [ops_control::Store]@Ops_IssueSettlementClaim
      )
   }

   ops_control::OpsUnmatchedLink: Relational
   {
      AssociationMapping
      (
         cashLink[opsUnmatchedInstructionKri, sflCashSettlementLink]: [ops_control::Store]@Ops_UnmatchedLink,
         opsUnmatchedKris[sflCashSettlementLink, opsUnmatchedInstructionKri]: [ops_control::Store]@Ops_UnmatchedLink
      )
   }

   ops_control::OpsUnmatchedClaim: Relational
   {
      AssociationMapping
      (
         unmatchedClaim[opsUnmatchedInstructionKri, sflSettlementClaim]: [ops_control::Store]@Ops_UnmatchedClaim,
         opsUnmatchedKris[sflSettlementClaim, opsUnmatchedInstructionKri]: [ops_control::Store]@Ops_UnmatchedClaim
      )
   }

   ops_control::OpsUnreconciledReconciliation: Relational
   {
      AssociationMapping
      (
         cashReconciliation[opsUnreconciledCashKri, sflReconciliation]: [ops_control::Store]@Ops_UnreconciledReconciliation,
         opsCashKris[sflReconciliation, opsUnreconciledCashKri]: [ops_control::Store]@Ops_UnreconciledReconciliation
      )
   }

   ops_control::OpsUnreconciledBreak: Relational
   {
      AssociationMapping
      (
         cashSettlementBreak[opsUnreconciledCashKri, sflReconciliationBreak]: [ops_control::Store]@Ops_UnreconciledSettlementBreak,
         opsCashKris[sflReconciliationBreak, opsUnreconciledCashKri]: [ops_control::Store]@Ops_UnreconciledSettlementBreak
      )
   }
)
