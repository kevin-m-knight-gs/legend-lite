###Mapping
// The position-keeping mapping. It INCLUDES both upstream mappings, so the sets this
// project's joins land on -- `caAccount` for an account, `ciBase` for an instrument --
// already exist and are not redefined here.
//
// Every ~primaryKey below names between two and six columns; not one of them is a single
// column, because nothing in this project is identified by one. The four position tables'
// keys all start with the same four columns, and PK_LOT_CLOSURE's runs to six.
//
// Every property mapping that crosses to another set names that set explicitly --
// `account[caAccount]`, `instrument[ciBase]` -- because both upstream projects give their
// sets explicit ids, which means the default ids (`core_account_Account`,
// `core_instrument_Instrument`) do not exist to fall back on.
//
// The last four sets are rooted on VIEWS. Their primary key is the view's ~groupBy, so
// one instance of AccountDayTotal is one account-day GROUP and never a position.
Mapping position_keeping::Mapping
(
   include core_account::Mapping
   include core_instrument::Mapping

   // The grain. Four key columns, and the two cross-project property mappings.
   position_keeping::Position[pkPosition]: Relational
   {
      ~primaryKey
      (
         [position_keeping::Store]PK_POSITION.INSTITUTION_ID,
         [position_keeping::Store]PK_POSITION.ACCOUNT_NO,
         [position_keeping::Store]PK_POSITION.INSTRUMENT_ID,
         [position_keeping::Store]PK_POSITION.COB_DATE
      )
      ~mainTable [position_keeping::Store]PK_POSITION
      institutionId: [position_keeping::Store]PK_POSITION.INSTITUTION_ID,
      accountNo: [position_keeping::Store]PK_POSITION.ACCOUNT_NO,
      instrumentId: [position_keeping::Store]PK_POSITION.INSTRUMENT_ID,
      cobDate: [position_keeping::Store]PK_POSITION.COB_DATE,
      openingQuantity: [position_keeping::Store]PK_POSITION.OPENING_QUANTITY,
      closingQuantity: [position_keeping::Store]PK_POSITION.CLOSING_QUANTITY,
      settledQuantity: [position_keeping::Store]PK_POSITION.SETTLED_QUANTITY,
      pendingQuantity: [position_keeping::Store]PK_POSITION.PENDING_QUANTITY,
      averageCost: [position_keeping::Store]PK_POSITION.AVERAGE_COST,
      costCurrency: [position_keeping::Store]PK_POSITION.COST_CURRENCY,
      costBasisAmount: [position_keeping::Store]PK_POSITION.COST_BASIS_AMOUNT,
      marketPrice: [position_keeping::Store]PK_POSITION.MARKET_PRICE,
      marketValue: [position_keeping::Store]PK_POSITION.MARKET_VALUE,
      realisedPnl: [position_keeping::Store]PK_POSITION.REALISED_PNL,
      unrealisedPnl: [position_keeping::Store]PK_POSITION.UNREALISED_PNL,
      pnlCurrency: [position_keeping::Store]PK_POSITION.PNL_CURRENCY,
      positionStatus: [position_keeping::Store]PK_POSITION.POSITION_STATUS,
      isShort: [position_keeping::Store]PK_POSITION.IS_SHORT,
      lastMovementDate: [position_keeping::Store]PK_POSITION.LAST_MOVEMENT_DATE,
      runSeq: [position_keeping::Store]PK_POSITION.RUN_SEQ,
      // Cross-project. The join carries both account columns; the set id is upstream's.
      account[caAccount]: [position_keeping::Store]@Pk_PositionAccount,
      instrument[ciBase]: [position_keeping::Store]@Pk_PositionInstrument,
      run[pkPositionRun]: [position_keeping::Store]@Pk_PositionRun,
      movements[pkPositionMovement]: [position_keeping::Store]@Pk_PositionMovements,
      lots[pkPositionLot]: [position_keeping::Store]@Pk_PositionLots,
      adjustments[pkPositionAdjustment]: [position_keeping::Store]@Pk_PositionAdjustments,
      ladder[pkSettlementLadderEntry]: [position_keeping::Store]@Pk_PositionLadder,
      breaks[pkPositionBreak]: [position_keeping::Store]@Pk_PositionBreaks,
      // Into the aggregations.
      movementTotal[pkMovementTotal]: [position_keeping::Store]@Pk_PositionMovementTotal,
      accountDayTotal[pkAccountDayTotal]: [position_keeping::Store]@Pk_PositionAccountDayTotal,
      instrumentDayTotal[pkInstrumentDayTotal]: [position_keeping::Store]@Pk_PositionInstrumentDayTotal,
      lifetime[pkAccountInstrumentLifetime]: [position_keeping::Store]@Pk_PositionLifetime
   }

