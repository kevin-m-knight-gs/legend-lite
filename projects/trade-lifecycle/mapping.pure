   // ---- Association mappings ----

   // THE self-join one. Both ends name [tlcAmendment, tlcAmendment] -- the same set id
   // twice -- and only the direction of travel over @Tlc_SupersededBy tells `supersedes`
   // from `supersededBy`.
   trade_lifecycle::TlcAmendmentChain: Relational
   {
      AssociationMapping
      (
         supersedes[tlcAmendment, tlcAmendment]: [trade_lifecycle::Store]@Tlc_SupersededBy,
         supersededBy[tlcAmendment, tlcAmendment]: [trade_lifecycle::Store]@Tlc_SupersededBy
      )
   }

   // ---- Cross-project association mappings ----
   // `tcTrade` and `evtBase` are the upstream set ids, taken from their MANIFESTs. Neither
   // project exposes a default id, so the bare `prop: [db]@Join` form would not resolve.

   trade_lifecycle::TlcTradeAmendments: Relational
   {
      AssociationMapping
      (
         amendedTrade[tlcAmendment, tcTrade]: [trade_lifecycle::Store]@Tlc_AmendmentTrade,
         lifecycleAmendments[tcTrade, tlcAmendment]: [trade_lifecycle::Store]@Tlc_AmendmentTrade
      )
   }

   trade_lifecycle::TlcTradeNovations: Relational
   {
      AssociationMapping
      (
         novatedTrade[tlcNovation, tcTrade]: [trade_lifecycle::Store]@Tlc_NovationTrade,
         lifecycleNovations[tcTrade, tlcNovation]: [trade_lifecycle::Store]@Tlc_NovationTrade
      )
   }

   trade_lifecycle::TlcTradeSnapshots: Relational
   {
      AssociationMapping
      (
         snapshotTrade[tlcVersionSnapshot, tcTrade]: [trade_lifecycle::Store]@Tlc_SnapshotTrade,
         lifecycleSnapshots[tcTrade, tlcVersionSnapshot]: [trade_lifecycle::Store]@Tlc_SnapshotTrade
      )
   }

   trade_lifecycle::TlcTradeCompressionMembers: Relational
   {
      AssociationMapping
      (
         compressedTrade[tlcCompressionMember, tcTrade]: [trade_lifecycle::Store]@Tlc_CompressionMemberTrade,
         lifecycleCompressionMembers[tcTrade, tlcCompressionMember]: [trade_lifecycle::Store]@Tlc_CompressionMemberTrade
      )
   }

   trade_lifecycle::TlcTradeCorporateActionImpacts: Relational
   {
      AssociationMapping
      (
         impactedTrade[tlcCorporateActionImpact, tcTrade]: [trade_lifecycle::Store]@Tlc_ImpactTrade,
         lifecycleCorporateActionImpacts[tcTrade, tlcCorporateActionImpact]: [trade_lifecycle::Store]@Tlc_ImpactTrade
      )
   }

   // The other half of the cross-dependency: into event-core's root set.
   trade_lifecycle::TlcImpactCorporateAction: Relational
   {
      AssociationMapping
      (
         corporateAction[tlcCorporateActionImpact, evtBase]: [trade_lifecycle::Store]@Tlc_ImpactCorporateAction,
         tradeImpacts[evtBase, tlcCorporateActionImpact]: [trade_lifecycle::Store]@Tlc_ImpactCorporateAction
      )
   }

   // ---- Association mappings inside trade-lifecycle ----

   trade_lifecycle::TlcAmendmentDetails: Relational
