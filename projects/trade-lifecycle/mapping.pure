###Mapping
// The trade-lifecycle mapping.
//
// Every set id is named EXPLICITLY and tlc-prefixed. That is not decoration: set ids are a
// GLOBAL namespace in Legend, and TlcAmendmentChain has trade_lifecycle::TlcAmendment on
// BOTH of its ends, so each of its two association ends has to name a source AND a target
// set -- [tlcAmendment, tlcAmendment], the same id twice, in both directions. Only the
// direction of travel over @Tlc_SupersededBy distinguishes `supersedes` from
// `supersededBy`.
//
// The two upstream mappings are included so the cross-project association ends can name
// their far set ids. Those ids come from the dependencies' MANIFESTs rather than from a
// guess: trade-capture names all of its sets explicitly, so `tcTrade` is the id and
// `trade_capture_Trade` does not exist; event-core's root set is `evtBase`, likewise the
// only id there is.
//
// The seven EnumerationMappings are the only place the physical code strings live. Each
// accepts a short code and the spelled-out form, because the confirmation feeds send one
// and the back office sends the other.
Mapping trade_lifecycle::Mapping
(
   include trade_capture::Mapping
   include event_core::Mapping

   // ---- Enumeration mappings ----

   trade_lifecycle::TlcAmendmentType: EnumerationMapping TlcAmendmentTypeMapping
   {
      ECONOMIC_AMENDMENT:     ['AMND', 'ECONOMIC_AMENDMENT'],
      NON_ECONOMIC_AMENDMENT: ['NAMD', 'NON_ECONOMIC_AMENDMENT'],
      NOVATION:               ['NOVA', 'NOVATION'],
      PARTIAL_TERMINATION:    ['PTRM', 'PARTIAL_TERMINATION'],
      FULL_TERMINATION:       ['FTRM', 'FULL_TERMINATION'],
      COMPRESSION:            ['CMPR', 'COMPRESSION'],
      UNWIND:                 ['UNWD', 'UNWIND'],
      EXERCISE:               ['EXER', 'EXERCISE'],
      EXPIRY:                 ['EXPI', 'EXPIRY'],
      RATE_RESET:             ['RSET', 'RATE_RESET'],
      CORPORATE_ACTION:       ['CACT', 'CORPORATE_ACTION'],
      RESTRUCTURING:          ['RSTR', 'RESTRUCTURING'],
      CORRECTION:             ['CORR', 'CORRECTION']
   }

   trade_lifecycle::TlcAmendmentStatus: EnumerationMapping TlcAmendmentStatusMapping
   {
      DRAFT:            ['DRFT', 'DRAFT'],
      PENDING_APPROVAL: ['PAPP', 'PENDING_APPROVAL'],
      APPROVED:         ['APPR', 'APPROVED'],
      APPLIED:          ['APLD', 'APPLIED'],
      SUPERSEDED:       ['SUPD', 'SUPERSEDED'],
      REJECTED:         ['REJT', 'REJECTED'],
      WITHDRAWN:        ['WDRN', 'WITHDRAWN']
   }

   trade_lifecycle::TlcConsentStatus: EnumerationMapping TlcConsentStatusMapping
   {
      REQUESTED: ['REQ', 'REQUESTED'],
      GRANTED:   ['GRT', 'GRANTED'],
      REFUSED:   ['REF', 'REFUSED'],
      DEEMED:    ['DEM', 'DEEMED'],
      LAPSED:    ['LPS', 'LAPSED']
   }

   trade_lifecycle::TlcTerminationReason: EnumerationMapping TlcTerminationReasonMapping
   {
      MUTUAL_AGREEMENT:       ['MUTL', 'MUTUAL_AGREEMENT'],
      COUNTERPARTY_DEFAULT:   ['DFLT', 'COUNTERPARTY_DEFAULT'],
      CREDIT_EVENT:           ['CRED', 'CREDIT_EVENT'],
      REGULATORY_REQUIREMENT: ['REGL', 'REGULATORY_REQUIREMENT'],
      PORTFOLIO_COMPRESSION:  ['COMP', 'PORTFOLIO_COMPRESSION'],
      OPTIONAL_BREAK:         ['BREK', 'OPTIONAL_BREAK'],
      ERROR_CORRECTION:       ['ERRC', 'ERROR_CORRECTION']
   }

   trade_lifecycle::TlcCompressionMethod: EnumerationMapping TlcCompressionMethodMapping
   {
      BILATERAL:                ['BILT', 'BILATERAL'],
      MULTILATERAL:             ['MULT', 'MULTILATERAL'],
      PORTFOLIO_RECONCILIATION: ['PREC', 'PORTFOLIO_RECONCILIATION'],
      RISK_CONSTRAINED:         ['RISK', 'RISK_CONSTRAINED'],
      COUPON_BLENDING:          ['CPBL', 'COUPON_BLENDING']
   }

   trade_lifecycle::TlcNotificationChannel: EnumerationMapping TlcNotificationChannelMapping
   {
      SWIFT:         ['SWFT', 'SWIFT'],
      FPML:          ['FPML', 'FPML'],
      EMAIL:         ['MAIL', 'EMAIL'],
      CLIENT_PORTAL: ['PRTL', 'CLIENT_PORTAL'],
      FAX:           ['FAX', 'FAX'],
      PHONE:         ['PHON', 'PHONE']
   }

   trade_lifecycle::TlcWorkflowState: EnumerationMapping TlcWorkflowStateMapping
   {
      OPEN:        ['OPEN', 'OPEN'],
      IN_PROGRESS: ['PROG', 'IN_PROGRESS'],
      BLOCKED:     ['BLKD', 'BLOCKED'],
      COMPLETED:   ['COMP', 'COMPLETED'],
      CANCELLED:   ['CANC', 'CANCELLED']
   }

   // ---- Class mappings ----

   // The recursive set. Both ends of TlcAmendmentChain point at this one id, in both
   // directions. The derived properties (isCurrentVersion, isChainRoot, isLive) are NOT
   // mapped -- they are computed from the chain itself.
   *trade_lifecycle::TlcAmendment[tlcAmendment]: Relational
   {
      ~primaryKey ( [trade_lifecycle::Store]TLC_AMENDMENT.AMENDMENT_ID )
      ~mainTable [trade_lifecycle::Store]TLC_AMENDMENT
      amendmentId: [trade_lifecycle::Store]TLC_AMENDMENT.AMENDMENT_ID,
      supersedesId: [trade_lifecycle::Store]TLC_AMENDMENT.SUPERSEDES_ID,
      amendmentType: EnumerationMapping TlcAmendmentTypeMapping: [trade_lifecycle::Store]TLC_AMENDMENT.AMENDMENT_TYPE,
      status: EnumerationMapping TlcAmendmentStatusMapping: [trade_lifecycle::Store]TLC_AMENDMENT.AMENDMENT_STATUS,
      versionNumber: [trade_lifecycle::Store]TLC_AMENDMENT.VERSION_NUMBER,
      effectiveDate: [trade_lifecycle::Store]TLC_AMENDMENT.EFFECTIVE_DATE,
      requestedAt: [trade_lifecycle::Store]TLC_AMENDMENT.REQUESTED_AT,
      appliedAt: [trade_lifecycle::Store]TLC_AMENDMENT.APPLIED_AT,
      requestedBy: [trade_lifecycle::Store]TLC_AMENDMENT.REQUESTED_BY,
      approvedBy: [trade_lifecycle::Store]TLC_AMENDMENT.APPROVED_BY,
      isEconomic: [trade_lifecycle::Store]TLC_AMENDMENT.IS_ECONOMIC,
      isClientInitiated: [trade_lifecycle::Store]TLC_AMENDMENT.IS_CLIENT_INITIATED,
      withdrawnOn: [trade_lifecycle::Store]TLC_AMENDMENT.WITHDRAWN_ON,
      externalReference: [trade_lifecycle::Store]TLC_AMENDMENT.EXTERNAL_REFERENCE,
      narrative: [trade_lifecycle::Store]TLC_AMENDMENT.NARRATIVE
   }

