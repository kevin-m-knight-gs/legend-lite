###Relational
// The trade-lifecycle store.
//
// The two `include`s are what make the cross-boundary joins below legal: an included
// database's tables are addressable as if they had been declared here, so Tlc_AmendmentTrade
// can name TC_TRADE and Tlc_ImpactCorporateAction can name EVT_CORPORATE_EVENT without
// either upstream project knowing this one exists.
//
// TLC_AMENDMENT is the table the whole project turns on. SUPERSEDES_ID is a foreign key
// into TLC_AMENDMENT's own AMENDMENT_ID, nullable exactly once per trade -- the first
// change ever made to it supersedes nothing. Nothing is ever updated in this table; a
// change to a trade is an INSERT that names its predecessor, so the rows for one trade form
// a linked list and the row nobody names is the trade as it stands today.
//
// Nothing is seeded: no ###Data element and no Runtime, per the contract.
Database trade_lifecycle::Store
(
   include trade_capture::Store
   include event_core::Store

   // The chain. One row per post-trade change of any kind; the per-kind terms live in the
   // detail tables below and are reached through AMENDMENT_ID.
   Table TLC_AMENDMENT
   (
      AMENDMENT_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      SUPERSEDES_ID VARCHAR(64),
      REASON_ID VARCHAR(64),
      SOURCE_ID VARCHAR(64),
      WORKFLOW_ID VARCHAR(64),
      AMENDMENT_TYPE VARCHAR(30) NOT NULL,
      AMENDMENT_STATUS VARCHAR(24) NOT NULL,
      VERSION_NUMBER INTEGER NOT NULL,
      EFFECTIVE_DATE DATE NOT NULL,
      REQUESTED_AT TIMESTAMP NOT NULL,
      APPLIED_AT TIMESTAMP,
      REQUESTED_BY VARCHAR(120) NOT NULL,
      APPROVED_BY VARCHAR(120),
      IS_ECONOMIC BIT NOT NULL,
      IS_CLIENT_INITIATED BIT NOT NULL,
      WITHDRAWN_ON DATE,
      EXTERNAL_REFERENCE VARCHAR(120),
      NARRATIVE VARCHAR(400)
   )

   Table TLC_AMENDMENT_DETAIL
   (
      DETAIL_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      FIELD_NAME VARCHAR(64) NOT NULL,
      OLD_VALUE VARCHAR(400),
      NEW_VALUE VARCHAR(400),
      VALUE_TYPE VARCHAR(24) NOT NULL,
      IS_ECONOMIC_FIELD BIT NOT NULL,
      SEQUENCE_NUMBER INTEGER NOT NULL
   )

   Table TLC_AMENDMENT_REASON
   (
      REASON_ID VARCHAR(64) PRIMARY KEY,
      REASON_CODE VARCHAR(32) NOT NULL,
      DESCRIPTION VARCHAR(400) NOT NULL,
      REQUIRES_APPROVAL BIT NOT NULL,
      IS_REPORTABLE BIT NOT NULL,
      REGULATORY_CATEGORY VARCHAR(64)
   )

   Table TLC_AMENDMENT_APPROVAL
   (
      APPROVAL_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      APPROVER_NAME VARCHAR(120) NOT NULL,
      APPROVER_ROLE VARCHAR(64) NOT NULL,
      APPROVED_AT TIMESTAMP NOT NULL,
      APPROVAL_LEVEL INTEGER NOT NULL,
      IS_OVERRIDE BIT NOT NULL,
      COMMENT_TEXT VARCHAR(400)
   )

   Table TLC_NOVATION
   (
      NOVATION_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      TRADE_ID VARCHAR(64) NOT NULL,
      TRANSFEROR_REFERENCE VARCHAR(64) NOT NULL,
      TRANSFEREE_REFERENCE VARCHAR(64) NOT NULL,
      REMAINING_PARTY_REFERENCE VARCHAR(64) NOT NULL,
      NOVATION_DATE DATE NOT NULL,
      NOVATED_NOTIONAL DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL,
      FEE_AMOUNT DOUBLE,
      IS_FULL_NOVATION BIT NOT NULL,
      AGREEMENT_REFERENCE VARCHAR(120)
   )

   Table TLC_NOVATION_CONSENT
   (
      CONSENT_ID VARCHAR(64) PRIMARY KEY,
      NOVATION_ID VARCHAR(64) NOT NULL,
      PARTY_REFERENCE VARCHAR(64) NOT NULL,
      PARTY_ROLE VARCHAR(32) NOT NULL,
      CONSENT_STATUS VARCHAR(24) NOT NULL,
      REQUESTED_AT TIMESTAMP NOT NULL,
      RESPONDED_AT TIMESTAMP,
      NOTICE_DEADLINE DATE,
      REFUSAL_REASON VARCHAR(400)
   )

   Table TLC_PARTIAL_TERMINATION
   (
      PARTIAL_TERMINATION_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      TERMINATION_DATE DATE NOT NULL,
      ORIGINAL_NOTIONAL DOUBLE NOT NULL,
      REDUCED_NOTIONAL DOUBLE NOT NULL,
      RESIDUAL_NOTIONAL DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL,
      TERMINATION_REASON VARCHAR(32) NOT NULL,
      SETTLEMENT_AMOUNT DOUBLE
   )

   Table TLC_TERMINATION
   (
      TERMINATION_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      TERMINATION_DATE DATE NOT NULL,
      EFFECTIVE_DATE DATE NOT NULL,
      TERMINATION_REASON VARCHAR(32) NOT NULL,
      TERMINATION_AMOUNT DOUBLE,
      CURRENCY VARCHAR(3),
      IS_EARLY_TERMINATION BIT NOT NULL,
      CALCULATION_AGENT VARCHAR(120),
      NOTICE_REFERENCE VARCHAR(120)
   )

   Table TLC_COMPRESSION_CYCLE
   (
      CYCLE_ID VARCHAR(64) PRIMARY KEY,
      CYCLE_REFERENCE VARCHAR(64) NOT NULL,
      RUN_DATE DATE NOT NULL,
      COMPRESSION_METHOD VARCHAR(32) NOT NULL,
      SERVICE_PROVIDER VARCHAR(120),
      TRADE_COUNT_BEFORE INTEGER NOT NULL,
      TRADE_COUNT_AFTER INTEGER NOT NULL,
      NOTIONAL_BEFORE DOUBLE NOT NULL,
      NOTIONAL_AFTER DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL
   )

   Table TLC_COMPRESSION_MEMBER
   (
      MEMBER_ID VARCHAR(64) PRIMARY KEY,
      CYCLE_ID VARCHAR(64) NOT NULL,
      AMENDMENT_ID VARCHAR(64),
      TRADE_ID VARCHAR(64) NOT NULL,
      NOTIONAL_BEFORE DOUBLE NOT NULL,
      NOTIONAL_AFTER DOUBLE NOT NULL,
      OUTCOME VARCHAR(32) NOT NULL,
      IS_REPLACEMENT_TRADE BIT NOT NULL,
      RISK_DELTA DOUBLE
   )

   Table TLC_UNWIND
   (
      UNWIND_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      UNWIND_DATE DATE NOT NULL,
      UNWIND_PRICE DOUBLE NOT NULL,
      MID_PRICE DOUBLE,
      SPREAD_PAID DOUBLE,
      CASH_SETTLEMENT_AMOUNT DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL,
      PRICE_SOURCE VARCHAR(64),
      IS_NEGOTIATED BIT NOT NULL
   )

   Table TLC_EXERCISE
   (
      EXERCISE_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      EXERCISE_DATE DATE NOT NULL,
      EXERCISE_STYLE VARCHAR(24) NOT NULL,
      EXERCISED_QUANTITY DOUBLE NOT NULL,
      REMAINING_QUANTITY DOUBLE NOT NULL,
      STRIKE_PRICE DOUBLE,
      SETTLEMENT_METHOD VARCHAR(24) NOT NULL,
      IS_AUTOMATIC BIT NOT NULL
   )

   Table TLC_EXPIRY
   (
      EXPIRY_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      EXPIRY_DATE DATE NOT NULL,
      EXPIRED_IN_THE_MONEY BIT NOT NULL,
      FINAL_REFERENCE_PRICE DOUBLE,
      PAYOUT_AMOUNT DOUBLE,
      CURRENCY VARCHAR(3),
      WAS_AUTO_EXERCISED BIT NOT NULL
   )

   Table TLC_RATE_RESET
   (
      RESET_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      RESET_DATE DATE NOT NULL,
      EFFECTIVE_DATE DATE NOT NULL,
      RATE_INDEX_CODE VARCHAR(32) NOT NULL,
      OBSERVED_RATE DOUBLE NOT NULL,
      SPREAD DOUBLE,
      ALL_IN_RATE DOUBLE NOT NULL,
      FIXING_SOURCE VARCHAR(64),
      IS_ESTIMATED BIT NOT NULL
   )

   Table TLC_LIFECYCLE_CASHFLOW
   (
      CASHFLOW_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      CASHFLOW_TYPE VARCHAR(32) NOT NULL,
      AMOUNT DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL,
      VALUE_DATE DATE NOT NULL,
      PAYER_REFERENCE VARCHAR(64) NOT NULL,
      RECEIVER_REFERENCE VARCHAR(64) NOT NULL,
      IS_SETTLED BIT NOT NULL,
      SETTLED_ON DATE
   )

   // The cross-dependency table. EVENT_ID reaches EVT_CORPORATE_EVENT in event-core and
   // TRADE_ID reaches TC_TRADE in trade-capture; AMENDMENT_ID ties the resulting change
   // back into this project's own chain.
   Table TLC_CORPORATE_ACTION_IMPACT
   (
      IMPACT_ID VARCHAR(64) PRIMARY KEY,
      EVENT_ID VARCHAR(40) NOT NULL,
      TRADE_ID VARCHAR(64) NOT NULL,
      AMENDMENT_ID VARCHAR(64),
      ADJUSTMENT_FACTOR DOUBLE NOT NULL,
      ORIGINAL_QUANTITY DOUBLE NOT NULL,
      ADJUSTED_QUANTITY DOUBLE NOT NULL,
      ORIGINAL_STRIKE DOUBLE,
      ADJUSTED_STRIKE DOUBLE,
      CASH_COMPENSATION DOUBLE,
      CURRENCY VARCHAR(3),
      ADJUSTMENT_METHOD VARCHAR(32) NOT NULL,
      IS_MANDATORY BIT NOT NULL,
      APPLIED_ON DATE
   )

   Table TLC_EVENT_NOTIFICATION
   (
      NOTIFICATION_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      NOTIFICATION_CHANNEL VARCHAR(24) NOT NULL,
      RECIPIENT_REFERENCE VARCHAR(64) NOT NULL,
      SENT_AT TIMESTAMP NOT NULL,
      ACKNOWLEDGED_AT TIMESTAMP,
      MESSAGE_REFERENCE VARCHAR(120),
      DELIVERY_STATUS VARCHAR(24) NOT NULL,
      RETRY_COUNT INTEGER NOT NULL
   )

   Table TLC_WORKFLOW
   (
      WORKFLOW_ID VARCHAR(64) PRIMARY KEY,
      WORKFLOW_TYPE VARCHAR(32) NOT NULL,
      WORKFLOW_STATE VARCHAR(24) NOT NULL,
      OPENED_AT TIMESTAMP NOT NULL,
      COMPLETED_ON DATE,
      ASSIGNED_TEAM VARCHAR(64),
      SLA_HOURS INTEGER,
      IS_BREACHED BIT NOT NULL
   )

   Table TLC_WORKFLOW_STEP
   (
      STEP_ID VARCHAR(64) PRIMARY KEY,
      WORKFLOW_ID VARCHAR(64) NOT NULL,
      STEP_NAME VARCHAR(64) NOT NULL,
      SEQUENCE_NUMBER INTEGER NOT NULL,
      WORKFLOW_STATE VARCHAR(24) NOT NULL,
      STARTED_AT TIMESTAMP,
      COMPLETED_AT TIMESTAMP,
      PERFORMED_BY VARCHAR(120),
      IS_MANDATORY BIT NOT NULL
   )

   Table TLC_AUDIT_ENTRY
   (
      AUDIT_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      ACTION_NAME VARCHAR(64) NOT NULL,
      PERFORMED_BY VARCHAR(120) NOT NULL,
      PERFORMED_AT TIMESTAMP NOT NULL,
      FIELD_TOUCHED VARCHAR(64),
      PREVIOUS_VALUE VARCHAR(400),
      RESULTING_VALUE VARCHAR(400),
      SOURCE_IP_ADDRESS VARCHAR(45)
   )

   Table TLC_EVENT_SOURCE
   (
      SOURCE_ID VARCHAR(64) PRIMARY KEY,
      SOURCE_CODE VARCHAR(32) NOT NULL,
      SOURCE_NAME VARCHAR(120) NOT NULL,
      IS_AUTOMATED BIT NOT NULL,
      IS_TRUSTED BIT NOT NULL,
      CONTACT_REFERENCE VARCHAR(120)
   )

   Table TLC_SUPPORTING_DOCUMENT
   (
      DOCUMENT_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      DOCUMENT_TYPE VARCHAR(32) NOT NULL,
      DOCUMENT_REFERENCE VARCHAR(120) NOT NULL,
      RECEIVED_ON DATE,
      IS_EXECUTED BIT NOT NULL,
      STORAGE_LOCATION VARCHAR(400)
   )

   Table TLC_RESTRUCTURING
   (
      RESTRUCTURING_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      RESTRUCTURING_DATE DATE NOT NULL,
      CREDIT_EVENT_TYPE VARCHAR(32) NOT NULL,
      SUCCESSOR_REFERENCE VARCHAR(120),
      RECOVERY_RATE DOUBLE,
      AUCTION_REFERENCE VARCHAR(120),
      IS_SUCCESSOR_DETERMINED BIT NOT NULL
   )

   Table TLC_ALLOCATION_ADJUSTMENT
   (
      ADJUSTMENT_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      ORIGINAL_ACCOUNT_REFERENCE VARCHAR(64) NOT NULL,
      NEW_ACCOUNT_REFERENCE VARCHAR(64) NOT NULL,
      ADJUSTED_QUANTITY DOUBLE NOT NULL,
      ADJUSTMENT_DATE DATE NOT NULL,
      IS_REPORTABLE BIT NOT NULL,
      REPORTED_ON DATE
   )

   Table TLC_CORRECTION
   (
      CORRECTION_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      CORRECTED_AT TIMESTAMP NOT NULL,
      ORIGINAL_BOOKED_AT TIMESTAMP NOT NULL,
      CORRECTION_CATEGORY VARCHAR(32) NOT NULL,
      WAS_REPORTED BIT NOT NULL,
      REGULATORY_RESUBMISSION_REF VARCHAR(120),
      DETECTED_BY VARCHAR(120)
   )

   Table TLC_BREAK_FEE
   (
      BREAK_FEE_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      FEE_AMOUNT DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL,
      BASIS_POINTS DOUBLE,
      CALCULATION_BASIS VARCHAR(32) NOT NULL,
      IS_WAIVED BIT NOT NULL,
      WAIVED_BY VARCHAR(120)
   )

   Table TLC_VERSION_SNAPSHOT
   (
      SNAPSHOT_ID VARCHAR(64) PRIMARY KEY,
      AMENDMENT_ID VARCHAR(64) NOT NULL,
      TRADE_ID VARCHAR(64) NOT NULL,
      VERSION_NUMBER INTEGER NOT NULL,
      AS_OF_DATE DATE NOT NULL,
      QUANTITY DOUBLE NOT NULL,
      PRICE DOUBLE NOT NULL,
      NOTIONAL DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL,
      COUNTERPARTY_REFERENCE VARCHAR(64),
      MATURITY_DATE DATE,
      IS_CURRENT BIT NOT NULL
   )

   // ---- The self-join ----
   // Both sides are TLC_AMENDMENT. {target} names the FAR side of the same table; without
   // it the condition would compare a row's SUPERSEDES_ID with its own AMENDMENT_ID and
   // match nothing. Read left-to-right it gives the amendment this one replaces; read in
   // reverse it gives the amendment that replaced this one, and the row with no reverse
   // match is the current version. Must stay on ONE line.
   Join Tlc_SupersededBy(TLC_AMENDMENT.SUPERSEDES_ID = {target}.AMENDMENT_ID)

   // ---- Cross-project joins, legal because the two stores are included above ----
   Join Tlc_AmendmentTrade(TLC_AMENDMENT.TRADE_ID = TC_TRADE.TRADE_ID)
   Join Tlc_NovationTrade(TLC_NOVATION.TRADE_ID = TC_TRADE.TRADE_ID)
   Join Tlc_SnapshotTrade(TLC_VERSION_SNAPSHOT.TRADE_ID = TC_TRADE.TRADE_ID)
   Join Tlc_CompressionMemberTrade(TLC_COMPRESSION_MEMBER.TRADE_ID = TC_TRADE.TRADE_ID)
   Join Tlc_ImpactTrade(TLC_CORPORATE_ACTION_IMPACT.TRADE_ID = TC_TRADE.TRADE_ID)
   Join Tlc_ImpactCorporateAction(TLC_CORPORATE_ACTION_IMPACT.EVENT_ID = EVT_CORPORATE_EVENT.EVENT_ID)

   // ---- Joins inside trade-lifecycle ----
   Join Tlc_AmendmentDetail(TLC_AMENDMENT_DETAIL.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentReasonLink(TLC_AMENDMENT.REASON_ID = TLC_AMENDMENT_REASON.REASON_ID)
   Join Tlc_AmendmentApproval(TLC_AMENDMENT_APPROVAL.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentNovation(TLC_NOVATION.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_NovationConsent(TLC_NOVATION_CONSENT.NOVATION_ID = TLC_NOVATION.NOVATION_ID)
   Join Tlc_AmendmentPartialTermination(TLC_PARTIAL_TERMINATION.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentTermination(TLC_TERMINATION.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_CycleMember(TLC_COMPRESSION_MEMBER.CYCLE_ID = TLC_COMPRESSION_CYCLE.CYCLE_ID)
   Join Tlc_AmendmentCompressionMember(TLC_COMPRESSION_MEMBER.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentUnwind(TLC_UNWIND.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentExercise(TLC_EXERCISE.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentExpiry(TLC_EXPIRY.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentRateReset(TLC_RATE_RESET.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentCashflow(TLC_LIFECYCLE_CASHFLOW.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentImpact(TLC_CORPORATE_ACTION_IMPACT.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentNotification(TLC_EVENT_NOTIFICATION.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentWorkflow(TLC_AMENDMENT.WORKFLOW_ID = TLC_WORKFLOW.WORKFLOW_ID)
   Join Tlc_WorkflowStep(TLC_WORKFLOW_STEP.WORKFLOW_ID = TLC_WORKFLOW.WORKFLOW_ID)
   Join Tlc_AmendmentAudit(TLC_AUDIT_ENTRY.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentSource(TLC_AMENDMENT.SOURCE_ID = TLC_EVENT_SOURCE.SOURCE_ID)
   Join Tlc_AmendmentDocument(TLC_SUPPORTING_DOCUMENT.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentRestructuring(TLC_RESTRUCTURING.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentAllocationAdjustment(TLC_ALLOCATION_ADJUSTMENT.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentCorrection(TLC_CORRECTION.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentBreakFee(TLC_BREAK_FEE.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Tlc_AmendmentSnapshot(TLC_VERSION_SNAPSHOT.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)

   // Amendments that were not withdrawn before they were applied. Written as a null test,
   // because a Filter will not take a boolean literal.
   Filter TlcStandingAmendments(TLC_AMENDMENT.WITHDRAWN_ON is null)

   // Workflows still in flight. Same reason for the same shape.
   Filter TlcOpenWorkflows(TLC_WORKFLOW.COMPLETED_ON is null)
)
