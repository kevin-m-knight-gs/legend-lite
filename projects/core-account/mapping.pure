      accountNo: [core_account::Store]CA_ACCOUNT_STATUS_EVENT.ACCOUNT_NO,
      effectiveFrom: [core_account::Store]CA_ACCOUNT_STATUS_EVENT.EFFECTIVE_FROM,
      status: [core_account::Store]CA_ACCOUNT_STATUS_EVENT.STATUS,
      reasonCode: [core_account::Store]CA_ACCOUNT_STATUS_EVENT.REASON_CODE,
      recordedBy: [core_account::Store]CA_ACCOUNT_STATUS_EVENT.RECORDED_BY,
      account[caAccount]: [core_account::Store]@Ca_AccountStatusEvents
   }

   core_account::AccountRestriction[caAccountRestriction]: Relational
   {
      ~primaryKey
      (
         [core_account::Store]CA_ACCOUNT_RESTRICTION.INSTITUTION_ID,
         [core_account::Store]CA_ACCOUNT_RESTRICTION.ACCOUNT_NO,
         [core_account::Store]CA_ACCOUNT_RESTRICTION.RESTRICTION_CODE
      )
      ~mainTable [core_account::Store]CA_ACCOUNT_RESTRICTION
      institutionId: [core_account::Store]CA_ACCOUNT_RESTRICTION.INSTITUTION_ID,
      accountNo: [core_account::Store]CA_ACCOUNT_RESTRICTION.ACCOUNT_NO,
      restrictionCode: [core_account::Store]CA_ACCOUNT_RESTRICTION.RESTRICTION_CODE,
      imposedOn: [core_account::Store]CA_ACCOUNT_RESTRICTION.IMPOSED_ON,
      liftedOn: [core_account::Store]CA_ACCOUNT_RESTRICTION.LIFTED_ON,
      imposedBy: [core_account::Store]CA_ACCOUNT_RESTRICTION.IMPOSED_BY,
