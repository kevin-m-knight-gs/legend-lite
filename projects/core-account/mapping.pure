      account[caAccount]: [core_account::Store]@Ca_AccountRestrictions
   }

   core_account::AccountMandate[caAccountMandate]: Relational
   {
      ~primaryKey
      (
         [core_account::Store]CA_ACCOUNT_MANDATE.INSTITUTION_ID,
         [core_account::Store]CA_ACCOUNT_MANDATE.ACCOUNT_NO,
         [core_account::Store]CA_ACCOUNT_MANDATE.MANDATE_SEQ
      )
      ~mainTable [core_account::Store]CA_ACCOUNT_MANDATE
      institutionId: [core_account::Store]CA_ACCOUNT_MANDATE.INSTITUTION_ID,
      accountNo: [core_account::Store]CA_ACCOUNT_MANDATE.ACCOUNT_NO,
