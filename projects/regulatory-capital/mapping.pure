###Mapping

// ============================================================
// regulatory_capital::Mapping -- 32 sets, five of them filter subtypes, three of them groups
// ============================================================
// THREE INCLUDES, AND WHAT THEY BUY. A class-valued property mapping can only name a set that
// exists in THIS mapping's scope, so the ten cross-project properties below need all three
// dependency mappings present: `[exaNetExposure]`, `[exaCounterpartyDayNet]`,
// `[exaNettingSet]` and `[exaCounterparty]` from exposure-agg, `[rexTransaction]` and
// `[rexReportingEntity]` from regulatory-extract, `[mgnMarginPortfolio]` and
// `[mgnInitialMargin]` from margin-calc.
//
// Every one of those ids is EXPLICIT in its own project, which means the default ids
// (`exposure_agg_ExaNetExposure`, `margin_calc_MgnInitialMargin`) do not exist to fall back
// on, and every id below was read out of a MANIFEST rather than guessed. Two of them do not
// follow their class name and are worth pointing at: `[exaCounterpartyDayNet]` is a set over
// a VIEW, and `[mgnInitialMargin]` has a three-column key.
//
// The same closure arrives here as in the store, and nothing outside the three dependencies
// is named: no `credit_`, `collateral_`, `trade_`, `reference_`, `client_`, `position_` or
// `risk_` package appears in this file, although every one of their mappings is present.
//
// SCHEMAS. This project's tables are in the default schema; regulatory-extract's are in
// `rex`, so the two chained property mappings that land on its columns write
// `[regulatory_extract::Store]rex.REX_TRANSACTION.REGIME_CODE` -- store, schema, table,
// column. The other two dependencies use the default schema and take no segment.
//
// THE FIVE FILTER SUBTYPES. `[rcpExposure]` is the ROOT set (`*`) over RCP_EXPOSURE, so
// unqualified, RcpExposure.all() is the whole regulatory book. Five sets extend it, each
// adding one `~filter` from this project's store and only the columns and links that mean
// something once the row is known to be of that type. None restates the key, the main table,
// or any of the fifty inherited property mappings.
//
//    RcpStandardisedExposure[rcpSaExposure]        RcpStandardisedRows      APPROACH_CODE = 'SA'
//    RcpIrbExposure[rcpIrbExposure]                RcpIrbRows               APPROACH_CODE = 'IRB'
//    RcpCounterpartyCreditExposure[rcpCcrExposure] RcpCounterpartyRiskRows  EXPOSURE_TYPE_CODE = 'DERIVATIVE'
//    RcpDefaultedExposure[rcpDefaulted]            RcpDefaultedRows         DEFAULT_STATUS = 'DEFAULTED'
//    RcpUnmitigatedExposure[rcpUnmitigated]        RcpUnmitigatedRows       CRM_ID is null
//
// They are NOT disjoint, and that is the point. An IRB derivative that has defaulted is a
// row of `rcpIrbExposure`, of `rcpCcrExposure` AND of `rcpDefaulted`, because the approach
// is an identity, the product type is another identity, and default is a state. Counting the
// book by summing the five sets double-counts; that is a property of the domain and not of
// the mapping.
//
// THE THREE GROUPS. The last three sets are rooted on VIEWS, and their `~primaryKey` is the
// view's `~groupBy` -- which is what makes one instance a GROUP and not a row. Navigating
// `exposure.rwaCell` crosses into a GROUP BY and can never come back out to another
// exposure.
//
// SET IDS ARE A GLOBAL NAMESPACE. Every one below is explicit and `rcp`-prefixed, so the
// default ids (`regulatory_capital_RcpExposure`) do not exist, and a downstream
// `extends [...]` or cross-project AssociationMapping must name the explicit one.
Mapping regulatory_capital::Mapping
(
   include exposure_agg::Mapping
   include regulatory_extract::Mapping
   include margin_calc::Mapping

   // ---- the run and the entity -----------------------------------------------------------

   regulatory_capital::RcpCapitalRun[rcpRun]: Relational
   {
      ~primaryKey ( [regulatory_capital::Store]RCP_CAPITAL_RUN.RUN_ID )
      ~mainTable [regulatory_capital::Store]RCP_CAPITAL_RUN
      runId: [regulatory_capital::Store]RCP_CAPITAL_RUN.RUN_ID,
      reportingDate: [regulatory_capital::Store]RCP_CAPITAL_RUN.REPORTING_DATE,
      runType: [regulatory_capital::Store]RCP_CAPITAL_RUN.RUN_TYPE,
      frameworkVersion: [regulatory_capital::Store]RCP_CAPITAL_RUN.FRAMEWORK_VERSION,
      startedAt: [regulatory_capital::Store]RCP_CAPITAL_RUN.STARTED_AT,
      completedAt: [regulatory_capital::Store]RCP_CAPITAL_RUN.COMPLETED_AT,
      exposureCount: [regulatory_capital::Store]RCP_CAPITAL_RUN.EXPOSURE_COUNT,
      unclassifiedCount: [regulatory_capital::Store]RCP_CAPITAL_RUN.UNCLASSIFIED_COUNT,
      triggeredBy: [regulatory_capital::Store]RCP_CAPITAL_RUN.TRIGGERED_BY,
      exposures[rcpExposure]: [regulatory_capital::Store]@Rcp_RunExposures
   }

   // The one link out to regulatory-extract that is not about a trade: the same firm entity
   // as the reporting side holds it, kept as a link rather than merged, because the two
   // systems disagreeing about who reported is itself a finding.
   regulatory_capital::RcpReportingEntity[rcpEntity]: Relational
   {
      ~primaryKey ( [regulatory_capital::Store]RCP_REPORTING_ENTITY.ENTITY_ID )
      ~mainTable [regulatory_capital::Store]RCP_REPORTING_ENTITY
      entityId: [regulatory_capital::Store]RCP_REPORTING_ENTITY.ENTITY_ID,
      entityName: [regulatory_capital::Store]RCP_REPORTING_ENTITY.ENTITY_NAME,
      consolidationBasis: [regulatory_capital::Store]RCP_REPORTING_ENTITY.CONSOLIDATION_BASIS,
      competentAuthority: [regulatory_capital::Store]RCP_REPORTING_ENTITY.COMPETENT_AUTHORITY,
      jurisdiction: [regulatory_capital::Store]RCP_REPORTING_ENTITY.JURISDICTION,
      reportingCurrency: [regulatory_capital::Store]RCP_REPORTING_ENTITY.REPORTING_CURRENCY,
      regulatoryEntityId: [regulatory_capital::Store]RCP_REPORTING_ENTITY.REGULATORY_ENTITY_ID,
      isGloballySystemic: [regulatory_capital::Store]RCP_REPORTING_ENTITY.IS_GLOBALLY_SYSTEMIC,
      deconsolidatedOn: [regulatory_capital::Store]RCP_REPORTING_ENTITY.DECONSOLIDATED_ON,
      reportingProfile[rexReportingEntity]: [regulatory_capital::Store]@Rcp_EntityReportingProfile,
      ownFunds[rcpOwnFunds]: [regulatory_capital::Store]@Rcp_EntityOwnFunds,
      requirements[rcpRequirement]: [regulatory_capital::Store]@Rcp_EntityRequirements,
      rwaTotals[rcpEntityRwaTotal]: [regulatory_capital::Store]@Rcp_EntityRwaTotals
   }

   // ---- the root set: every regulatory exposure, of whatever approach --------------------
   // The three-way fan-in is the last block of property mappings: three class-valued ones
   // onto three different projects' sets, and three chained ones that land on a dependency's
   // COLUMN. Both forms are here on purpose -- a capital return needs the objects to explain
   // a number and the flattened values to group without walking them.
   *regulatory_capital::RcpExposure[rcpExposure]: Relational
   {
      ~primaryKey ( [regulatory_capital::Store]RCP_EXPOSURE.EXPOSURE_ID )
      ~mainTable [regulatory_capital::Store]RCP_EXPOSURE
      exposureId: [regulatory_capital::Store]RCP_EXPOSURE.EXPOSURE_ID,
      entityId: [regulatory_capital::Store]RCP_EXPOSURE.ENTITY_ID,
      reportingDate: [regulatory_capital::Store]RCP_EXPOSURE.REPORTING_DATE,
      runId: [regulatory_capital::Store]RCP_EXPOSURE.RUN_ID,
      counterpartyId: [regulatory_capital::Store]RCP_EXPOSURE.COUNTERPARTY_ID,
      approachCode: [regulatory_capital::Store]RCP_EXPOSURE.APPROACH_CODE,
      exposureClassCode: [regulatory_capital::Store]RCP_EXPOSURE.EXPOSURE_CLASS_CODE,
      exposureTypeCode: [regulatory_capital::Store]RCP_EXPOSURE.EXPOSURE_TYPE_CODE,
      originalExposure: [regulatory_capital::Store]RCP_EXPOSURE.ORIGINAL_EXPOSURE,
      undrawnAmount: [regulatory_capital::Store]RCP_EXPOSURE.UNDRAWN_AMOUNT,
      creditConversionFactor: [regulatory_capital::Store]RCP_EXPOSURE.CREDIT_CONVERSION_FACTOR,
      exposureValue: [regulatory_capital::Store]RCP_EXPOSURE.EXPOSURE_VALUE,
      exposureAfterCrm: [regulatory_capital::Store]RCP_EXPOSURE.EXPOSURE_AFTER_CRM,
      riskWeightPct: [regulatory_capital::Store]RCP_EXPOSURE.RISK_WEIGHT_PCT,
      riskWeightedAmount: [regulatory_capital::Store]RCP_EXPOSURE.RISK_WEIGHTED_AMOUNT,
      residualMaturityYears: [regulatory_capital::Store]RCP_EXPOSURE.RESIDUAL_MATURITY_YEARS,
      currency: [regulatory_capital::Store]RCP_EXPOSURE.CURRENCY,
      crmId: [regulatory_capital::Store]RCP_EXPOSURE.CRM_ID,
      reportId: [regulatory_capital::Store]RCP_EXPOSURE.REPORT_ID,
      netExposureId: [regulatory_capital::Store]RCP_EXPOSURE.NET_EXPOSURE_ID,
      ecaiRatingSymbol: [regulatory_capital::Store]RCP_EXPOSURE.ECAI_RATING_SYMBOL,
      creditQualityStep: [regulatory_capital::Store]RCP_EXPOSURE.CREDIT_QUALITY_STEP,
      isUnrated: [regulatory_capital::Store]RCP_EXPOSURE.IS_UNRATED,
      supportingFactor: [regulatory_capital::Store]RCP_EXPOSURE.SUPPORTING_FACTOR,
      modelId: [regulatory_capital::Store]RCP_EXPOSURE.MODEL_ID,
      ratingGrade: [regulatory_capital::Store]RCP_EXPOSURE.RATING_GRADE,
      pointInTimePd: [regulatory_capital::Store]RCP_EXPOSURE.POINT_IN_TIME_PD,
      lossGivenDefault: [regulatory_capital::Store]RCP_EXPOSURE.LOSS_GIVEN_DEFAULT,
      assetCorrelation: [regulatory_capital::Store]RCP_EXPOSURE.ASSET_CORRELATION,
      maturityAdjustment: [regulatory_capital::Store]RCP_EXPOSURE.MATURITY_ADJUSTMENT,
      expectedLossAmount: [regulatory_capital::Store]RCP_EXPOSURE.EXPECTED_LOSS_AMOUNT,
      nettingSetId: [regulatory_capital::Store]RCP_EXPOSURE.NETTING_SET_ID,
      replacementCost: [regulatory_capital::Store]RCP_EXPOSURE.REPLACEMENT_COST,
      potentialFutureExposure: [regulatory_capital::Store]RCP_EXPOSURE.POTENTIAL_FUTURE_EXPOSURE,
      alphaFactor: [regulatory_capital::Store]RCP_EXPOSURE.ALPHA_FACTOR,
      defaultStatus: [regulatory_capital::Store]RCP_EXPOSURE.DEFAULT_STATUS,
      defaultedOn: [regulatory_capital::Store]RCP_EXPOSURE.DEFAULTED_ON,
      specificProvision: [regulatory_capital::Store]RCP_EXPOSURE.SPECIFIC_PROVISION,
      realisedLoss: [regulatory_capital::Store]RCP_EXPOSURE.REALISED_LOSS,

      // this project's own graph
      exposureClass[rcpExposureClass]: [regulatory_capital::Store]@Rcp_ExposureClass,
      creditRiskMitigation[rcpCrm]: [regulatory_capital::Store]@Rcp_ExposureCrm,
      run[rcpRun]: [regulatory_capital::Store]@Rcp_RunExposures,
      entity[rcpEntity]: [regulatory_capital::Store]@Rcp_EntityExposures,
      nettingSetCapital[rcpNettingSetCapital]: [regulatory_capital::Store]@Rcp_ExposureNettingSetCapital,
      // into this project's own two groups
      rwaCell[rcpRwaCell]: [regulatory_capital::Store]@Rcp_ExposureRwaCell,
      entityRwaTotal[rcpEntityRwaTotal]: [regulatory_capital::Store]@Rcp_ExposureEntityTotal,

      // THE FAN-IN, as objects. Three projects, one row.
      netExposure[exaNetExposure]: [regulatory_capital::Store]@Rcp_ExposureNetExposure,
      counterpartyDayNet[exaCounterpartyDayNet]: [regulatory_capital::Store]@Rcp_ExposureCounterpartyDayNet,
      transactionReport[rexTransaction]: [regulatory_capital::Store]@Rcp_ExposureTransactionReport,

      // THE FAN-IN, flattened. The leading @Join names THIS store, where the join is
      // declared; the final segment names the store the COLUMN lives in, which is the
      // dependency's. Note the `rex.` schema segment on the third one and its absence on the
      // first two -- exposure-agg puts its tables in the default schema and
      // regulatory-extract does not.
      creditSystemNetExposure: [regulatory_capital::Store]@Rcp_ExposureNetExposure | [exposure_agg::Store]EXA_NET_EXPOSURE.NET_EXPOSURE_AMOUNT,
      creditSystemCollateralValue: [regulatory_capital::Store]@Rcp_ExposureNetExposure | [exposure_agg::Store]EXA_NET_EXPOSURE.COLLATERAL_VALUE,
      reportedRegimeCode: [regulatory_capital::Store]@Rcp_ExposureTransactionReport | [regulatory_extract::Store]rex.REX_TRANSACTION.REGIME_CODE
   }

   // ---- the five filter subtypes ---------------------------------------------------------
   // One ~filter and a handful of mappings each. Everything else -- the key, the table, the
   // forty-odd inherited columns and the whole fan-in above -- comes from [rcpExposure].

   // The standardised rows. The two links here are the grid lookup: a rating symbol maps to
   // a credit quality step, and the step and the exposure class index one cell of the grid.
   // Neither means anything on an IRB row, which is why they are not on the root set.
   regulatory_capital::RcpStandardisedExposure[rcpSaExposure] extends [rcpExposure]: Relational
   {
      ~filter [regulatory_capital::Store]RcpStandardisedRows
      qualityStep[rcpQualityStep]: [regulatory_capital::Store]@Rcp_ExposureQualityStep,
      gridWeight[rcpRiskWeight]: [regulatory_capital::Store]@Rcp_ExposureGridWeight
   }

   // The modelled rows. The link is to the PERMISSION as much as to the model: a withdrawn
   // approval sends the whole book back to the standardised grid.
   regulatory_capital::RcpIrbExposure[rcpIrbExposure] extends [rcpExposure]: Relational
   {
      ~filter [regulatory_capital::Store]RcpIrbRows
      model[rcpIrbModel]: [regulatory_capital::Store]@Rcp_ExposureModel,
      parameterSet[rcpParameterSet]: [regulatory_capital::Store]@Rcp_ExposureParameterSet
   }

   // The derivative rows. OVERLAPS both of the above: a derivative is on the standardised or
   // the IRB approach for the credit leg and under SA-CCR for the exposure measure, and the
   // two facts are independent.
   regulatory_capital::RcpCounterpartyCreditExposure[rcpCcrExposure] extends [rcpExposure]: Relational
   {
      ~filter [regulatory_capital::Store]RcpCounterpartyRiskRows
      nettingSet[rcpNettingSetCapital]: [regulatory_capital::Store]@Rcp_ExposureNettingSetCapital,
      ccrTotal[rcpCcrTotal]: [regulatory_capital::Store]@Rcp_ExposureCcrTotal
   }

   // The defaulted rows. A STATE and not an approach, so this overlaps all three above. The
   // three columns here only exist once the row is known to have defaulted: what the workout
   // has recovered, and what triggered the default in the first place.
   regulatory_capital::RcpDefaultedExposure[rcpDefaulted] extends [rcpExposure]: Relational
   {
      ~filter [regulatory_capital::Store]RcpDefaultedRows
      workoutStatus: [regulatory_capital::Store]RCP_EXPOSURE.WORKOUT_STATUS,
      recoveryToDate: [regulatory_capital::Store]RCP_EXPOSURE.RECOVERY_TO_DATE,
      daysPastDue: [regulatory_capital::Store]RCP_EXPOSURE.DAYS_PAST_DUE
   }

   // The unsecured rows, as a NULL TEST rather than a flag. An exposure can be unmitigated
   // because nothing was offered, because what was offered was ineligible, or because the
   // documentation is still open -- three different problems that one boolean would flatten.
   regulatory_capital::RcpUnmitigatedExposure[rcpUnmitigated] extends [rcpExposure]: Relational
   {
      ~filter [regulatory_capital::Store]RcpUnmitigatedRows
      mitigationGapReason: [regulatory_capital::Store]RCP_EXPOSURE.MITIGATION_GAP_REASON,
      policyExceptionRef: [regulatory_capital::Store]RCP_EXPOSURE.POLICY_EXCEPTION_REF
   }

   // ---- the standardised grid, as data ----------------------------------------------------

   regulatory_capital::RcpExposureClass[rcpExposureClass]: Relational
   {
      ~primaryKey ( [regulatory_capital::Store]RCP_EXPOSURE_CLASS.EXPOSURE_CLASS_CODE )
      ~mainTable [regulatory_capital::Store]RCP_EXPOSURE_CLASS
      exposureClassCode: [regulatory_capital::Store]RCP_EXPOSURE_CLASS.EXPOSURE_CLASS_CODE,
      exposureClassName: [regulatory_capital::Store]RCP_EXPOSURE_CLASS.EXPOSURE_CLASS_NAME,
      legalReference: [regulatory_capital::Store]RCP_EXPOSURE_CLASS.LEGAL_REFERENCE,
      isRatingSensitive: [regulatory_capital::Store]RCP_EXPOSURE_CLASS.IS_RATING_SENSITIVE,
      defaultRiskWeightPct: [regulatory_capital::Store]RCP_EXPOSURE_CLASS.DEFAULT_RISK_WEIGHT_PCT,
      isIrbEligible: [regulatory_capital::Store]RCP_EXPOSURE_CLASS.IS_IRB_ELIGIBLE,
      correlationFloor: [regulatory_capital::Store]RCP_EXPOSURE_CLASS.CORRELATION_FLOOR,
      retiredOn: [regulatory_capital::Store]RCP_EXPOSURE_CLASS.RETIRED_ON,
      riskWeights[rcpRiskWeight]: [regulatory_capital::Store]@Rcp_ClassRiskWeights,
      exposures[rcpExposure]: [regulatory_capital::Store]@Rcp_ExposureClass
   }

   // TWO KEY COLUMNS: the agency and the symbol. One agency's A- is another's A3.
   regulatory_capital::RcpCreditQualityStep[rcpQualityStep]: Relational
   {
      ~primaryKey
      (
         [regulatory_capital::Store]RCP_CREDIT_QUALITY_STEP.ECAI_CODE,
         [regulatory_capital::Store]RCP_CREDIT_QUALITY_STEP.RATING_SYMBOL
      )
      ~mainTable [regulatory_capital::Store]RCP_CREDIT_QUALITY_STEP
      ecaiCode: [regulatory_capital::Store]RCP_CREDIT_QUALITY_STEP.ECAI_CODE,
      ratingSymbol: [regulatory_capital::Store]RCP_CREDIT_QUALITY_STEP.RATING_SYMBOL,
      qualityStep: [regulatory_capital::Store]RCP_CREDIT_QUALITY_STEP.QUALITY_STEP,
      benchmarkDefaultRate: [regulatory_capital::Store]RCP_CREDIT_QUALITY_STEP.BENCHMARK_DEFAULT_RATE,
      isLongTerm: [regulatory_capital::Store]RCP_CREDIT_QUALITY_STEP.IS_LONG_TERM,
      mappedFrom: [regulatory_capital::Store]RCP_CREDIT_QUALITY_STEP.MAPPED_FROM,
      mappedTo: [regulatory_capital::Store]RCP_CREDIT_QUALITY_STEP.MAPPED_TO
   }

   // TWO KEY COLUMNS: one cell of the grid is a class and a step, and neither alone is it.
   regulatory_capital::RcpRiskWeight[rcpRiskWeight]: Relational
   {
      ~primaryKey
      (
         [regulatory_capital::Store]RCP_RISK_WEIGHT.EXPOSURE_CLASS_CODE,
         [regulatory_capital::Store]RCP_RISK_WEIGHT.CREDIT_QUALITY_STEP
      )
      ~mainTable [regulatory_capital::Store]RCP_RISK_WEIGHT
      exposureClassCode: [regulatory_capital::Store]RCP_RISK_WEIGHT.EXPOSURE_CLASS_CODE,
      creditQualityStep: [regulatory_capital::Store]RCP_RISK_WEIGHT.CREDIT_QUALITY_STEP,
      riskWeightPct: [regulatory_capital::Store]RCP_RISK_WEIGHT.RISK_WEIGHT_PCT,
      shortTermRiskWeightPct: [regulatory_capital::Store]RCP_RISK_WEIGHT.SHORT_TERM_RISK_WEIGHT_PCT,
      jurisdiction: [regulatory_capital::Store]RCP_RISK_WEIGHT.JURISDICTION,
      effectiveFrom: [regulatory_capital::Store]RCP_RISK_WEIGHT.EFFECTIVE_FROM,
      supersededOn: [regulatory_capital::Store]RCP_RISK_WEIGHT.SUPERSEDED_ON,
      exposureClass[rcpExposureClass]: [regulatory_capital::Store]@Rcp_ClassRiskWeights
   }

   // ---- the modelled side -----------------------------------------------------------------

   regulatory_capital::RcpIrbModel[rcpIrbModel]: Relational
   {
      ~primaryKey ( [regulatory_capital::Store]RCP_IRB_MODEL.MODEL_ID )
      ~mainTable [regulatory_capital::Store]RCP_IRB_MODEL
      modelId: [regulatory_capital::Store]RCP_IRB_MODEL.MODEL_ID,
      modelName: [regulatory_capital::Store]RCP_IRB_MODEL.MODEL_NAME,
      irbApproach: [regulatory_capital::Store]RCP_IRB_MODEL.IRB_APPROACH,
      exposureClassCode: [regulatory_capital::Store]RCP_IRB_MODEL.EXPOSURE_CLASS_CODE,
      approvalReference: [regulatory_capital::Store]RCP_IRB_MODEL.APPROVAL_REFERENCE,
      approvedOn: [regulatory_capital::Store]RCP_IRB_MODEL.APPROVED_ON,
      withdrawnOn: [regulatory_capital::Store]RCP_IRB_MODEL.WITHDRAWN_ON,
      lastValidatedOn: [regulatory_capital::Store]RCP_IRB_MODEL.LAST_VALIDATED_ON,
      supervisoryMultiplier: [regulatory_capital::Store]RCP_IRB_MODEL.SUPERVISORY_MULTIPLIER,
      parameterSets[rcpParameterSet]: [regulatory_capital::Store]@Rcp_ModelParameterSets
   }

   // TWO KEY COLUMNS: grade 5 of one model is not grade 5 of another.
   regulatory_capital::RcpIrbParameterSet[rcpParameterSet]: Relational
   {
      ~primaryKey
      (
         [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.MODEL_ID,
         [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.RATING_GRADE
      )
      ~mainTable [regulatory_capital::Store]RCP_IRB_PARAMETER_SET
      modelId: [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.MODEL_ID,
      ratingGrade: [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.RATING_GRADE,
      gradePd: [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.GRADE_PD,
      gradeLgd: [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.GRADE_LGD,
      gradeEadFactor: [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.GRADE_EAD_FACTOR,
      assumedMaturityYears: [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.ASSUMED_MATURITY_YEARS,
      obligorCount: [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.OBLIGOR_COUNT,
      observedDefaultRate: [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.OBSERVED_DEFAULT_RATE,
      calibratedOn: [regulatory_capital::Store]RCP_IRB_PARAMETER_SET.CALIBRATED_ON,
      model[rcpIrbModel]: [regulatory_capital::Store]@Rcp_ModelParameterSets
   }

   // ---- credit risk mitigation ------------------------------------------------------------

   regulatory_capital::RcpCreditRiskMitigation[rcpCrm]: Relational
   {
      ~primaryKey ( [regulatory_capital::Store]RCP_CRM.CRM_ID )
      ~mainTable [regulatory_capital::Store]RCP_CRM
      crmId: [regulatory_capital::Store]RCP_CRM.CRM_ID,
      protectionType: [regulatory_capital::Store]RCP_CRM.PROTECTION_TYPE,
      methodCode: [regulatory_capital::Store]RCP_CRM.METHOD_CODE,
      collateralTypeCode: [regulatory_capital::Store]RCP_CRM.COLLATERAL_TYPE_CODE,
      collateralValue: [regulatory_capital::Store]RCP_CRM.COLLATERAL_VALUE,
      collateralHaircutPct: [regulatory_capital::Store]RCP_CRM.COLLATERAL_HAIRCUT_PCT,
      fxHaircutPct: [regulatory_capital::Store]RCP_CRM.FX_HAIRCUT_PCT,
      maturityMismatchAdjustment: [regulatory_capital::Store]RCP_CRM.MATURITY_MISMATCH_ADJUSTMENT,
      coveredAmount: [regulatory_capital::Store]RCP_CRM.COVERED_AMOUNT,
      isEligible: [regulatory_capital::Store]RCP_CRM.IS_ELIGIBLE,
      ineligibilityReason: [regulatory_capital::Store]RCP_CRM.INELIGIBILITY_REASON,
      protectionStart: [regulatory_capital::Store]RCP_CRM.PROTECTION_START,
      protectionEnd: [regulatory_capital::Store]RCP_CRM.PROTECTION_END,
      guarantee[rcpGuarantee]: [regulatory_capital::Store]@Rcp_CrmGuarantee,
      haircutSchedule[rcpHaircut]: [regulatory_capital::Store]@Rcp_CrmHaircutSchedule,
      exposures[rcpExposure]: [regulatory_capital::Store]@Rcp_CrmExposures
   }

   // TWO KEY COLUMNS: the published grid is banded on the collateral type AND the residual
   // maturity, and a haircut without its band is not a haircut.
   regulatory_capital::RcpSupervisoryHaircut[rcpHaircut]: Relational
   {
      ~primaryKey
      (
         [regulatory_capital::Store]RCP_SUPERVISORY_HAIRCUT.COLLATERAL_TYPE_CODE,
         [regulatory_capital::Store]RCP_SUPERVISORY_HAIRCUT.RESIDUAL_MATURITY_BAND
      )
      ~mainTable [regulatory_capital::Store]RCP_SUPERVISORY_HAIRCUT
      collateralTypeCode: [regulatory_capital::Store]RCP_SUPERVISORY_HAIRCUT.COLLATERAL_TYPE_CODE,
      residualMaturityBand: [regulatory_capital::Store]RCP_SUPERVISORY_HAIRCUT.RESIDUAL_MATURITY_BAND,
      haircutPct: [regulatory_capital::Store]RCP_SUPERVISORY_HAIRCUT.HAIRCUT_PCT,
      fxMismatchHaircutPct: [regulatory_capital::Store]RCP_SUPERVISORY_HAIRCUT.FX_MISMATCH_HAIRCUT_PCT,
      holdingPeriodDays: [regulatory_capital::Store]RCP_SUPERVISORY_HAIRCUT.HOLDING_PERIOD_DAYS,
      creditQualityStep: [regulatory_capital::Store]RCP_SUPERVISORY_HAIRCUT.CREDIT_QUALITY_STEP,
      isSovereignIssue: [regulatory_capital::Store]RCP_SUPERVISORY_HAIRCUT.IS_SOVEREIGN_ISSUE
   }

   regulatory_capital::RcpGuarantee[rcpGuarantee]: Relational
   {
      ~primaryKey ( [regulatory_capital::Store]RCP_GUARANTEE.GUARANTEE_ID )
      ~mainTable [regulatory_capital::Store]RCP_GUARANTEE
      guaranteeId: [regulatory_capital::Store]RCP_GUARANTEE.GUARANTEE_ID,
      protectionProviderId: [regulatory_capital::Store]RCP_GUARANTEE.PROTECTION_PROVIDER_ID,
