###Relational
// The custody store.
//
// It INCLUDES both dependencies' databases, because the joins that matter here cross
// projects: a holding row has to reach CA_ACCOUNT for the account it belongs to and
// CI_INSTRUMENT for the thing being held, and neither table lives in this project.
//
// Every join into CA_ACCOUNT is a TWO-column join. The account key is
// (INSTITUTION_ID, ACCOUNT_NO), so a join on ACCOUNT_NO alone would match accounts at
// other institutions -- and in custody that is not an abstract risk, since a custodian
// carries accounts for many institutions in the same omnibus depot.
//
// CST_DEPOT declares THREE primary key columns and CST_HOLDING declares four. That is
// not key sprawl, it is the grain: a depot code is unique inside an account, and a
// holding is unique inside (account, instrument, depot). Drop DEPOT_CODE from the
// holding key and the same stock in two depositories collapses into one row, which is
// exactly the error custody reconciliation exists to catch.
//
// CST_HOLDING is WIDE on purpose. QTY_* is the quantity block and POS_* is the place
// of safekeeping, including the nested POS_REG_* registration -- all on the holding
// row, so the mapping binds them as embedded properties and emits no join to read them.
Database custody_core::Store
(
   include core_account::Store
   include core_instrument::Store

   Table CST_CUSTODIAN
   (
      CUSTODIAN_ID VARCHAR(20) PRIMARY KEY,
      NAME VARCHAR(200),
      BIC VARCHAR(11),
      LEI VARCHAR(20),
      COUNTRY_CODE VARCHAR(2),
      CUSTODIAN_ROLE VARCHAR(20),
      IS_AFFILIATE BIT,
      ONBOARDED_ON DATE,
      TERMINATED_ON DATE
   )

   Table CST_DEPOSITORY
   (
      DEPOSITORY_ID VARCHAR(20) PRIMARY KEY,
      NAME VARCHAR(200),
      BIC VARCHAR(11),
      DEPOSITORY_TYPE VARCHAR(20),
      COUNTRY_CODE VARCHAR(2),
      MARKET_CODE VARCHAR(10),
      SETTLEMENT_CYCLE_DAYS INTEGER,
      IS_ACTIVE BIT
   )

   Table CST_MARKET
   (
      MARKET_CODE VARCHAR(10) PRIMARY KEY,
      NAME VARCHAR(120),
      COUNTRY_CODE VARCHAR(2),
      SETTLEMENT_CURRENCY VARCHAR(3),
      TIME_ZONE VARCHAR(40),
      IS_EMERGING BIT
   )

   // Three key columns: the same two firms are appointed market by market, so the
   // market is part of the identity of the appointment and not an attribute of it.
   Table CST_SUB_CUSTODIAN_LINK
   (
      GLOBAL_CUSTODIAN_ID VARCHAR(20) PRIMARY KEY,
      MARKET_CODE VARCHAR(10) PRIMARY KEY,
      SUB_CUSTODIAN_ID VARCHAR(20) PRIMARY KEY,
      AGREEMENT_REF VARCHAR(40),
      TIER INTEGER,
      EFFECTIVE_FROM DATE,
      TERMINATED_ON DATE,
      IS_CASH_CORRESPONDENT BIT,
      SERVICE_LEVEL VARCHAR(30)
   )

   Table CST_DEPOSITORY_MEMBERSHIP
   (
      CUSTODIAN_ID VARCHAR(20) PRIMARY KEY,
      DEPOSITORY_ID VARCHAR(20) PRIMARY KEY,
      PARTICIPANT_ID VARCHAR(30),
      MEMBERSHIP_TYPE VARCHAR(20),
      JOINED_ON DATE,
      RESIGNED_ON DATE
   )

   // The THREE-COLUMN key: (INSTITUTION_ID, ACCOUNT_NO) is the account, DEPOT_CODE is
   // unique only within it.
   Table CST_DEPOT
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      DEPOT_CODE VARCHAR(20) PRIMARY KEY,
      DEPOT_NAME VARCHAR(200),
      CUSTODIAN_ID VARCHAR(20),
      DEPOSITORY_ID VARCHAR(20),
      MARKET_CODE VARCHAR(10),
      SAFEKEEPING_ACCOUNT_ID VARCHAR(40),
      DEPOT_TYPE VARCHAR(20),
      IS_OMNIBUS BIT,
      BASE_CURRENCY VARCHAR(3),
      OPENED_ON DATE,
      CLOSED_ON DATE
   )

   Table CST_HOLDING
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      DEPOT_CODE VARCHAR(20) PRIMARY KEY,
      AS_OF_DATE DATE,
      HOLDING_STATUS VARCHAR(20),
      PRICE_CURRENCY VARCHAR(3),
      LAST_RECONCILED_ON DATE,

      // the quantity block
      QTY_SETTLED DOUBLE,
      QTY_TRADED DOUBLE,
      QTY_PENDING_RECEIPT DOUBLE,
      QTY_PENDING_DELIVERY DOUBLE,
      QTY_AVAILABLE DOUBLE,
      QTY_BLOCKED DOUBLE,
      QTY_UNIT VARCHAR(10),

      // the place-of-safekeeping block, with the registration nested inside it
      POS_TYPE VARCHAR(20),
      POS_BIC VARCHAR(11),
      POS_NAME VARCHAR(200),
      POS_COUNTRY_CODE VARCHAR(2),
      POS_MARKET_CODE VARCHAR(10),
      POS_ACCOUNT_ID VARCHAR(40),
      POS_REG_FORM VARCHAR(20),
      POS_REG_NAME VARCHAR(200),
      POS_REG_REFERENCE VARCHAR(60),
      POS_REG_DATE DATE,
      POS_REG_IS_SEGREGATED BIT
   )

   Table CST_PENDING_MOVEMENT
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      DEPOT_CODE VARCHAR(20) PRIMARY KEY,
      MOVEMENT_REF VARCHAR(40) PRIMARY KEY,
      MOVEMENT_DIRECTION VARCHAR(10),
      MOVEMENT_QUANTITY DOUBLE,
      TRADE_DATE DATE,
      INTENDED_SETTLEMENT_DATE DATE,
      ACTUAL_SETTLEMENT_DATE DATE,
      MOVEMENT_STATUS VARCHAR(20),
      IS_AGAINST_PAYMENT BIT,
      SETTLEMENT_AMOUNT DOUBLE,
      SETTLEMENT_CURRENCY VARCHAR(3),
      COUNTERPARTY_BIC VARCHAR(11),
      FAIL_REASON_CODE VARCHAR(20)
   )

   Table CST_HOLDING_ENCUMBRANCE
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      DEPOT_CODE VARCHAR(20) PRIMARY KEY,
      ENCUMBRANCE_CODE VARCHAR(20) PRIMARY KEY,
      ENCUMBRANCE_TYPE VARCHAR(20),
      ENCUMBERED_QUANTITY DOUBLE,
      BENEFICIARY_NAME VARCHAR(200),
      CREATED_ON DATE,
      RELEASED_ON DATE
   )

   // Their side of the reconciliation, kept beside ours rather than merged into it.
   Table CST_STATEMENT_LINE
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      DEPOT_CODE VARCHAR(20) PRIMARY KEY,
      STATEMENT_DATE DATE PRIMARY KEY,
      STATEMENT_REF VARCHAR(40),
      CUSTODIAN_QUANTITY DOUBLE,
      CUSTODIAN_STATUS VARCHAR(20),
      RECEIVED_ON DATE,
      IS_FINAL BIT
   )

   // ---- inside this project ----
   Join Cst_DepositoryMarket(CST_DEPOSITORY.MARKET_CODE = CST_MARKET.MARKET_CODE)
   Join Cst_LinkGlobalCustodian(CST_SUB_CUSTODIAN_LINK.GLOBAL_CUSTODIAN_ID = CST_CUSTODIAN.CUSTODIAN_ID)
   Join Cst_LinkSubCustodian(CST_SUB_CUSTODIAN_LINK.SUB_CUSTODIAN_ID = CST_CUSTODIAN.CUSTODIAN_ID)
   Join Cst_LinkMarket(CST_SUB_CUSTODIAN_LINK.MARKET_CODE = CST_MARKET.MARKET_CODE)
   Join Cst_MembershipCustodian(CST_DEPOSITORY_MEMBERSHIP.CUSTODIAN_ID = CST_CUSTODIAN.CUSTODIAN_ID)
   Join Cst_MembershipDepository(CST_DEPOSITORY_MEMBERSHIP.DEPOSITORY_ID = CST_DEPOSITORY.DEPOSITORY_ID)
   Join Cst_DepotCustodian(CST_DEPOT.CUSTODIAN_ID = CST_CUSTODIAN.CUSTODIAN_ID)
   Join Cst_DepotDepository(CST_DEPOT.DEPOSITORY_ID = CST_DEPOSITORY.DEPOSITORY_ID)
   Join Cst_DepotMarket(CST_DEPOT.MARKET_CODE = CST_MARKET.MARKET_CODE)

   // Three columns, because a depot is keyed by three.
   Join Cst_HoldingDepot(CST_HOLDING.INSTITUTION_ID = CST_DEPOT.INSTITUTION_ID and CST_HOLDING.ACCOUNT_NO = CST_DEPOT.ACCOUNT_NO and CST_HOLDING.DEPOT_CODE = CST_DEPOT.DEPOT_CODE)

   // Four columns, because a holding is keyed by four.
   Join Cst_HoldingMovements(CST_HOLDING.INSTITUTION_ID = CST_PENDING_MOVEMENT.INSTITUTION_ID and CST_HOLDING.ACCOUNT_NO = CST_PENDING_MOVEMENT.ACCOUNT_NO and CST_HOLDING.INSTRUMENT_ID = CST_PENDING_MOVEMENT.INSTRUMENT_ID and CST_HOLDING.DEPOT_CODE = CST_PENDING_MOVEMENT.DEPOT_CODE)
   Join Cst_HoldingEncumbrances(CST_HOLDING.INSTITUTION_ID = CST_HOLDING_ENCUMBRANCE.INSTITUTION_ID and CST_HOLDING.ACCOUNT_NO = CST_HOLDING_ENCUMBRANCE.ACCOUNT_NO and CST_HOLDING.INSTRUMENT_ID = CST_HOLDING_ENCUMBRANCE.INSTRUMENT_ID and CST_HOLDING.DEPOT_CODE = CST_HOLDING_ENCUMBRANCE.DEPOT_CODE)
   Join Cst_HoldingStatementLines(CST_HOLDING.INSTITUTION_ID = CST_STATEMENT_LINE.INSTITUTION_ID and CST_HOLDING.ACCOUNT_NO = CST_STATEMENT_LINE.ACCOUNT_NO and CST_HOLDING.INSTRUMENT_ID = CST_STATEMENT_LINE.INSTRUMENT_ID and CST_HOLDING.DEPOT_CODE = CST_STATEMENT_LINE.DEPOT_CODE)

   // ---- across the boundary, into the included stores ----
   // Two columns into CA_ACCOUNT, never one.
   Join Cst_DepotAccount(CST_DEPOT.INSTITUTION_ID = CA_ACCOUNT.INSTITUTION_ID and CST_DEPOT.ACCOUNT_NO = CA_ACCOUNT.ACCOUNT_NO)
   Join Cst_HoldingAccount(CST_HOLDING.INSTITUTION_ID = CA_ACCOUNT.INSTITUTION_ID and CST_HOLDING.ACCOUNT_NO = CA_ACCOUNT.ACCOUNT_NO)

   // One column into CI_INSTRUMENT, because an instrument id is global.
   Join Cst_HoldingInstrument(CST_HOLDING.INSTRUMENT_ID = CI_INSTRUMENT.INSTRUMENT_ID)
)
