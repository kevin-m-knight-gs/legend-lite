      underlyingTwo: [product_pricing::Store]PPR_CORRELATION.UNDERLYING_TWO,
      correlationValue: [product_pricing::Store]PPR_CORRELATION.CORRELATION_VALUE,
      estimationWindowDays: [product_pricing::Store]PPR_CORRELATION.ESTIMATION_WINDOW_DAYS,
      estimationMethod: [product_pricing::Store]PPR_CORRELATION.ESTIMATION_METHOD,
      isStressed: [product_pricing::Store]PPR_CORRELATION.IS_STRESSED,
      asOfDate: [product_pricing::Store]PPR_CORRELATION.AS_OF_DATE
   }

   product_pricing::PprDividendForecast[pprDividend]: Relational
   {
      ~primaryKey
      (
         [product_pricing::Store]PPR_DIVIDEND.UNDERLYING_CODE,
         [product_pricing::Store]PPR_DIVIDEND.EX_DATE
      )
      ~mainTable [product_pricing::Store]PPR_DIVIDEND
