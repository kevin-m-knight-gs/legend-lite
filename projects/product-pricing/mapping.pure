   // ================================================= model risk

   // `markAdjustment[vcAdjustment]` is the other end of this project's reason for existing:
   // the reserve is COMPUTED here and BOOKED in valuation-core, and the join carries that
   // project's full three-column adjustment key so one reserve maps to one adjustment.
   product_pricing::PprModelReserve[pprReserve]: Relational
   {
      ~primaryKey
      (
         [product_pricing::Store]PPR_MODEL_RESERVE.RUN_ID,
         [product_pricing::Store]PPR_MODEL_RESERVE.PRODUCT_CODE,
         [product_pricing::Store]PPR_MODEL_RESERVE.RESERVE_TYPE
      )
      ~mainTable [product_pricing::Store]PPR_MODEL_RESERVE
      runId: [product_pricing::Store]PPR_MODEL_RESERVE.RUN_ID,
      productCode: [product_pricing::Store]PPR_MODEL_RESERVE.PRODUCT_CODE,
      reserveType: [product_pricing::Store]PPR_MODEL_RESERVE.RESERVE_TYPE,
      instrumentId: [product_pricing::Store]PPR_MODEL_RESERVE.INSTRUMENT_ID,
      valuationRunId: [product_pricing::Store]PPR_MODEL_RESERVE.VALUATION_RUN_ID,
      adjustmentSeq: [product_pricing::Store]PPR_MODEL_RESERVE.ADJUSTMENT_SEQ,
      reserveBasisPoints: [product_pricing::Store]PPR_MODEL_RESERVE.RESERVE_BPS,
      reserveAmount: [product_pricing::Store]PPR_MODEL_RESERVE.RESERVE_AMOUNT,
      baseValue: [product_pricing::Store]PPR_MODEL_RESERVE.BASE_VALUE,
      fxRate: [product_pricing::Store]PPR_MODEL_RESERVE.FX_RATE,
      methodology: [product_pricing::Store]PPR_MODEL_RESERVE.METHODOLOGY,
      approvedBy: [product_pricing::Store]PPR_MODEL_RESERVE.APPROVED_BY,
      isReleased: [product_pricing::Store]PPR_MODEL_RESERVE.IS_RELEASED,
      rationale: [product_pricing::Store]PPR_MODEL_RESERVE.RATIONALE,
      markAdjustment[vcAdjustment]: [product_pricing::Store]@Ppr_ReserveAdjustment
   }

   product_pricing::PprModelValidation[pprValidation]: Relational
   {
      ~primaryKey
