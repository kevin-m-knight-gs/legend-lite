###Mapping
// The pricing mapping.
//
// It INCLUDES both dependencies' mappings, which is what makes two different kinds of
// cross-project reference below resolvable at once:
//
//  * `extends [prdProduct]` and `extends [prdYieldEnhancement]` -- set ids that live in
//    product-core. Extending is what makes the priced-product sets three lines rather than
//    thirty: the primary key, the main table CI_INSTRUMENT and every inherited column
//    mapping come from the set being extended, across TWO project boundaries
//    (ppr -> prd -> ci).
//  * `valuation[vcValuation]`, `valuationRun[vcRun]`, `markAdjustment[vcAdjustment]` --
//    property mappings whose TARGET set id lives in valuation-core.
//
// Both dependencies name every set id explicitly, so there is no `product_core_Product` or
// `valuation_core_VcValuation` default to fall back on, and every id below is taken from
// the dependency's MANIFEST rather than guessed.
//
// Two shape facts, stated once here rather than inferred from three hundred lines below:
//
//  * The main table of every priced-product set is core-instrument's CI_INSTRUMENT, two
//    projects up. This project's own columns live in PPR_PRODUCT_PRICING and are reached
//    through Ppr_PricingInstrument, so a property mapping reads
//    `[product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.COL` and an
//    association reads `@Ppr_PricingInstrument > @SomeOtherJoin`.
//  * Every set that adds a property declares it on its OWN set. A property declared on a
//    subclass cannot be mapped on the parent's set -- the trap product-core recorded, and
//    the reason PprAnalyticPricedProduct's five columns are on [pprAnalytic] and not on
//    [pprPricedProduct].
//
// No EnumerationMapping is needed: this project declares no enums and maps none of
// core-types', because core-types is not one of its dependencies.
Mapping product_pricing::Mapping
(
   include product_core::Mapping
   include valuation_core::Mapping

   // ================================================= the priced-product taxonomy

   // The root of this project's overlay, and the point where it joins the dependency's
   // taxonomy. It adds no primary key and no main table -- both come from [prdProduct],
   // which took them from [ciBase] -- only the join to this project's overlay table and
   // the filter that says the pricing desk owns the product at all.
   product_pricing::PprPricedProduct[pprPricedProduct] extends [prdProduct]: Relational
   {
      ~filter [product_pricing::Store]@Ppr_PricingInstrument | [product_pricing::Store]PprPricedRows
      modelCode: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.MODEL_CODE,
      modelFamily: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.MODEL_FAMILY,
      pricingStatus: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.PRICING_STATUS,
      pricingCurrency: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.PRICING_CURRENCY,
      pricingDesk: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.PRICING_DESK,
      valuationMethodCode: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.VALUATION_METHOD_CODE,
      discountCurveCode: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.DISCOUNT_CURVE_CODE,
      volatilitySurfaceCode: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.VOL_SURFACE_CODE,
      lastPricedOn: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.LAST_PRICED_ON,
      modelTier: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.MODEL_TIER,
      isModelValidated: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.IS_MODEL_VALIDATED,
      revaluationFrequency: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.REVALUATION_FREQUENCY,
      hasIndependentPriceCheck: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.HAS_INDEPENDENT_PRICE_CHECK,
      baseReserveBasisPoints: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.BASE_RESERVE_BPS,
      model[pprModel]: [product_pricing::Store]@Ppr_PricingInstrument > @Ppr_PricingModel,
      discountCurve[pprCurve]: [product_pricing::Store]@Ppr_PricingInstrument > @Ppr_PricingCurve,
      prices[pprProductPrice]: [product_pricing::Store]@Ppr_PricingInstrument > @Ppr_PricingProductPrice
   }

   // ---- the six model families, on this project's own MODEL_FAMILY column ----
   // Each extends [pprPricedProduct], so the chain to the base is four links long:
   // family -> pprPricedProduct -> prdProduct -> ciBase, crossing a project boundary twice.

   product_pricing::PprAnalyticPricedProduct[pprAnalytic] extends [pprPricedProduct]: Relational
   {
      ~filter [product_pricing::Store]@Ppr_PricingInstrument | [product_pricing::Store]PprAnalyticRows
      closedFormName: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.CLOSED_FORM_NAME,
      usesVolatilitySmile: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.USES_VOL_SMILE,
      quotedVolatility: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.QUOTED_VOLATILITY,
      analyticDayCount: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.ANALYTIC_DAY_COUNT,
      hasAnalyticGreeks: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.HAS_ANALYTIC_GREEKS
   }

   product_pricing::PprMonteCarloPricedProduct[pprMonteCarlo] extends [pprPricedProduct]: Relational
   {
      ~filter [product_pricing::Store]@Ppr_PricingInstrument | [product_pricing::Store]PprMonteCarloRows
      pathCount: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.PATH_COUNT,
      timeStepsPerYear: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.TIME_STEPS_PER_YEAR,
      randomSeed: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.RANDOM_SEED,
      varianceReduction: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.VARIANCE_REDUCTION,
      pathStandardDeviation: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.PATH_STD_DEV,
      isPathDependent: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.IS_PATH_DEPENDENT
   }

   product_pricing::PprLatticePricedProduct[pprLattice] extends [pprPricedProduct]: Relational
   {
      ~filter [product_pricing::Store]@Ppr_PricingInstrument | [product_pricing::Store]PprLatticeRows
      latticeType: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.LATTICE_TYPE,
      treeSteps: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.TREE_STEPS,
      exerciseStyle: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.EXERCISE_STYLE,
      yearsToExpiry: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.YEARS_TO_EXPIRY,
      handlesDiscreteDividends: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.HANDLES_DISCRETE_DIVIDENDS
   }

   product_pricing::PprAccrualPricedProduct[pprAccrual] extends [pprPricedProduct]: Relational
   {
      ~filter [product_pricing::Store]@Ppr_PricingInstrument | [product_pricing::Store]PprAccrualRows
      accrualBasis: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.ACCRUAL_BASIS,
      contractRatePercent: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.CONTRACT_RATE_PCT,
      isFairValueOption: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.IS_FAIR_VALUE_OPTION,
      daysToMaturity: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.DAYS_TO_MATURITY,
      fundingSpreadBasisPoints: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.FUNDING_SPREAD_BPS
   }

   product_pricing::PprNavPricedProduct[pprNav] extends [pprPricedProduct]: Relational
   {
      ~filter [product_pricing::Store]@Ppr_PricingInstrument | [product_pricing::Store]PprNavRows
      navSource: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.NAV_SOURCE,
      navLagDays: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.NAV_LAG_DAYS,
      swingFactorPercent: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.SWING_FACTOR_PCT,
      usesEstimatedNav: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.USES_ESTIMATED_NAV,
      navPerUnit: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.NAV_PER_UNIT
   }

   product_pricing::PprBrokerMarkedProduct[pprBrokerMarked] extends [pprPricedProduct]: Relational
   {
      ~filter [product_pricing::Store]@Ppr_PricingInstrument | [product_pricing::Store]PprBrokerMarkedRows
      brokerCount: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.BROKER_COUNT,
      brokerDispersionPercent: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.BROKER_DISPERSION_PCT,
      uncertaintyReserveBasisPoints: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.UNCERTAINTY_RESERVE_BPS,
      escalationOwner: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.ESCALATION_OWNER,
      isDeskSourced: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.IS_DESK_SOURCED
   }

   // ---- two concrete payoffs, extending product-core's CONCRETE sets ----
   // These do not extend [pprPricedProduct]; they extend the dependency's own concrete
   // product sets, because the facts they add are facts about that payoff. Their filter is
   // on PAYOFF_ENGINE rather than MODEL_FAMILY precisely because they are on a different
   // branch and must not be cut by the same column twice.

   product_pricing::PprPricedAutocall[pprAutocall] extends [prdYieldEnhancement]: Relational
   {
      ~filter [product_pricing::Store]@Ppr_PricingInstrument | [product_pricing::Store]PprAutocallPricedRows
      observationCount: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.OBSERVATION_COUNT,
      observationFrequency: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.OBSERVATION_FREQUENCY,
      hasMemoryCoupon: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.HAS_MEMORY_COUPON,
      autocallProbability: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.AUTOCALL_PROBABILITY,
      expectedLifeYears: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.EXPECTED_LIFE_YEARS,
      barrierBreachProbability: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.BARRIER_BREACH_PROBABILITY,
      pricingModelCode: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.PRICING_MODEL_CODE
   }

   product_pricing::PprPricedProtectedNote[pprProtectedNote] extends [prdCapitalProtected]: Relational
   {
      ~filter [product_pricing::Store]@Ppr_PricingInstrument | [product_pricing::Store]PprProtectedNotePricedRows
      zeroLegPresentValuePercent: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.ZERO_LEG_PV_PCT,
      optionLegPresentValuePercent: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.OPTION_LEG_PV_PCT,
      issuerFundingSpreadBasisPoints: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.ISSUER_FUNDING_SPREAD_BPS,
      isProtectionModelled: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.IS_PROTECTION_MODELLED,
      pricingModelCode: [product_pricing::Store]@Ppr_PricingInstrument | PPR_PRODUCT_PRICING.PRICING_MODEL_CODE
   }

   // ================================================= the model inventory

   // The models, on this project's own table. `valuationMethod[vcMethod]` is the target-set
   // form: valuation-core names its ids explicitly, so the bare join form would not resolve.
   product_pricing::PprPricingModel[pprModel]: Relational
   {
      ~primaryKey ( [product_pricing::Store]PPR_MODEL.MODEL_CODE )
      ~mainTable [product_pricing::Store]PPR_MODEL
      modelCode: [product_pricing::Store]PPR_MODEL.MODEL_CODE,
      modelName: [product_pricing::Store]PPR_MODEL.MODEL_NAME,
      modelKind: [product_pricing::Store]PPR_MODEL.MODEL_KIND,
      engineName: [product_pricing::Store]PPR_MODEL.ENGINE_NAME,
      engineVersion: [product_pricing::Store]PPR_MODEL.ENGINE_VERSION,
      assetClass: [product_pricing::Store]PPR_MODEL.ASSET_CLASS,
      valuationMethodCode: [product_pricing::Store]PPR_MODEL.VALUATION_METHOD_CODE,
      owningQuantTeam: [product_pricing::Store]PPR_MODEL.OWNING_QUANT_TEAM,
      approvalStatus: [product_pricing::Store]PPR_MODEL.APPROVAL_STATUS,
      isProduction: [product_pricing::Store]PPR_MODEL.IS_PRODUCTION,
      typicalRuntimeMillis: [product_pricing::Store]PPR_MODEL.TYPICAL_RUNTIME_MS,
      modelRiskTier: [product_pricing::Store]PPR_MODEL.MODEL_RISK_TIER,
      valuationMethod[vcMethod]: [product_pricing::Store]@Ppr_ModelValuationMethod,
      inputs[pprModelInput]: [product_pricing::Store]@Ppr_ModelInput,
      assignments[pprAssignment]: [product_pricing::Store]@Ppr_ModelAssignment,
      calibrations[pprCalibration]: [product_pricing::Store]@Ppr_ModelCalibration,
      validations[pprValidation]: [product_pricing::Store]@Ppr_ModelValidation,
      limitations[pprLimitation]: [product_pricing::Store]@Ppr_ModelLimitation
   }

   product_pricing::PprAnalyticModel[pprAnalyticModel] extends [pprModel]: Relational
   {
      ~filter [product_pricing::Store]PprAnalyticModelRows
      formulaName: [product_pricing::Store]PPR_MODEL.FORMULA_NAME,
      hasClosedFormGreeks: [product_pricing::Store]PPR_MODEL.HAS_CLOSED_FORM_GREEKS,
      smileTreatment: [product_pricing::Store]PPR_MODEL.SMILE_TREATMENT,
      validatedMoneynessMax: [product_pricing::Store]PPR_MODEL.VALIDATED_MONEYNESS_MAX
   }

   product_pricing::PprMonteCarloModel[pprMonteCarloModel] extends [pprModel]: Relational
   {
      ~filter [product_pricing::Store]PprMonteCarloModelRows
      defaultPathCount: [product_pricing::Store]PPR_MODEL.DEFAULT_PATH_COUNT,
      supportsAntithetic: [product_pricing::Store]PPR_MODEL.SUPPORTS_ANTITHETIC,
      supportsQuasiRandom: [product_pricing::Store]PPR_MODEL.SUPPORTS_QUASI_RANDOM,
      usesBrownianBridge: [product_pricing::Store]PPR_MODEL.USES_BROWNIAN_BRIDGE,
      convergenceTargetBasisPoints: [product_pricing::Store]PPR_MODEL.CONVERGENCE_TARGET_BPS
   }

   product_pricing::PprLatticeModel[pprLatticeModel] extends [pprModel]: Relational
   {
      ~filter [product_pricing::Store]PprLatticeModelRows
      latticeType: [product_pricing::Store]PPR_MODEL.LATTICE_TYPE,
      defaultStepCount: [product_pricing::Store]PPR_MODEL.DEFAULT_STEP_COUNT,
      supportsAmerican: [product_pricing::Store]PPR_MODEL.SUPPORTS_AMERICAN,
      supportsBermudan: [product_pricing::Store]PPR_MODEL.SUPPORTS_BERMUDAN,
      dividendTreatment: [product_pricing::Store]PPR_MODEL.DIVIDEND_TREATMENT
   }

   product_pricing::PprModelAssignment[pprAssignment]: Relational
   {
      ~primaryKey
      (
         [product_pricing::Store]PPR_MODEL_ASSIGNMENT.PRODUCT_SUBTYPE,
         [product_pricing::Store]PPR_MODEL_ASSIGNMENT.MODEL_CODE
      )
      ~mainTable [product_pricing::Store]PPR_MODEL_ASSIGNMENT
      productSubtype: [product_pricing::Store]PPR_MODEL_ASSIGNMENT.PRODUCT_SUBTYPE,
      modelCode: [product_pricing::Store]PPR_MODEL_ASSIGNMENT.MODEL_CODE,
      assignedOn: [product_pricing::Store]PPR_MODEL_ASSIGNMENT.ASSIGNED_ON,
      assignedBy: [product_pricing::Store]PPR_MODEL_ASSIGNMENT.ASSIGNED_BY,
      isPrimary: [product_pricing::Store]PPR_MODEL_ASSIGNMENT.IS_PRIMARY,
      fallbackModelCode: [product_pricing::Store]PPR_MODEL_ASSIGNMENT.FALLBACK_MODEL_CODE,
      rationale: [product_pricing::Store]PPR_MODEL_ASSIGNMENT.RATIONALE
   }

   product_pricing::PprModelInput[pprModelInput]: Relational
   {
      ~primaryKey
      (
         [product_pricing::Store]PPR_MODEL_INPUT.MODEL_CODE,
         [product_pricing::Store]PPR_MODEL_INPUT.INPUT_CODE
      )
      ~mainTable [product_pricing::Store]PPR_MODEL_INPUT
      modelCode: [product_pricing::Store]PPR_MODEL_INPUT.MODEL_CODE,
      inputCode: [product_pricing::Store]PPR_MODEL_INPUT.INPUT_CODE,
      inputName: [product_pricing::Store]PPR_MODEL_INPUT.INPUT_NAME,
      inputKind: [product_pricing::Store]PPR_MODEL_INPUT.INPUT_KIND,
      isMandatory: [product_pricing::Store]PPR_MODEL_INPUT.IS_MANDATORY,
      sourceReference: [product_pricing::Store]PPR_MODEL_INPUT.SOURCE_REFERENCE,
      defaultValue: [product_pricing::Store]PPR_MODEL_INPUT.DEFAULT_VALUE,
      unitOfMeasure: [product_pricing::Store]PPR_MODEL_INPUT.UNIT_OF_MEASURE
   }

   // ================================================= the market inputs

   product_pricing::PprVolatilitySurface[pprVolSurface]: Relational
   {
      ~primaryKey ( [product_pricing::Store]PPR_VOL_SURFACE.SURFACE_CODE )
      ~mainTable [product_pricing::Store]PPR_VOL_SURFACE
      surfaceCode: [product_pricing::Store]PPR_VOL_SURFACE.SURFACE_CODE,
      underlyingCode: [product_pricing::Store]PPR_VOL_SURFACE.UNDERLYING_CODE,
      surfaceType: [product_pricing::Store]PPR_VOL_SURFACE.SURFACE_TYPE,
      quoteConvention: [product_pricing::Store]PPR_VOL_SURFACE.QUOTE_CONVENTION,
      asOfDate: [product_pricing::Store]PPR_VOL_SURFACE.AS_OF_DATE,
      atmVolatility: [product_pricing::Store]PPR_VOL_SURFACE.ATM_VOLATILITY,
      skew25Delta: [product_pricing::Store]PPR_VOL_SURFACE.SKEW_25_DELTA,
      isArbitrageFree: [product_pricing::Store]PPR_VOL_SURFACE.IS_ARBITRAGE_FREE,
      interpolation: [product_pricing::Store]PPR_VOL_SURFACE.INTERPOLATION,
      pointCount: [product_pricing::Store]PPR_VOL_SURFACE.POINT_COUNT,
      points[pprVolPoint]: [product_pricing::Store]@Ppr_SurfacePoint
   }

   product_pricing::PprVolatilityPoint[pprVolPoint]: Relational
   {
      ~primaryKey
