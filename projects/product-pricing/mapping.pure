      startedAt: [product_pricing::Store]PPR_PRICING_RUN.STARTED_AT,
      isSignedOff: [product_pricing::Store]PPR_PRICING_RUN.IS_SIGNED_OFF,
      valuationRun[vcRun]: [product_pricing::Store]@Ppr_RunValuationRun,
      prices[pprProductPrice]: [product_pricing::Store]@Ppr_RunPrice
   }

   // The output of the project. `valuation[vcValuation]` crosses into valuation-core on
   // that project's full three-column key; the derived properties beside it are not mapped
   // at all, because a derived property whose body calls another project's function needs
   // no mapping -- the call crosses the boundary in the model, not here.
   product_pricing::PprProductPrice[pprProductPrice]: Relational
   {
      ~primaryKey
      (
         [product_pricing::Store]PPR_PRODUCT_PRICE.RUN_ID,
         [product_pricing::Store]PPR_PRODUCT_PRICE.PRODUCT_CODE
      )
      ~mainTable [product_pricing::Store]PPR_PRODUCT_PRICE
      runId: [product_pricing::Store]PPR_PRODUCT_PRICE.RUN_ID,
      productCode: [product_pricing::Store]PPR_PRODUCT_PRICE.PRODUCT_CODE,
      instrumentId: [product_pricing::Store]PPR_PRODUCT_PRICE.INSTRUMENT_ID,
      valuationRunId: [product_pricing::Store]PPR_PRODUCT_PRICE.VALUATION_RUN_ID,
      cobDate: [product_pricing::Store]PPR_PRODUCT_PRICE.COB_DATE,
      modelCode: [product_pricing::Store]PPR_PRODUCT_PRICE.MODEL_CODE,
      cleanModelPrice: [product_pricing::Store]PPR_PRODUCT_PRICE.CLEAN_MODEL_PRICE,
      accruedInterest: [product_pricing::Store]PPR_PRODUCT_PRICE.ACCRUED_INTEREST,
      quantity: [product_pricing::Store]PPR_PRODUCT_PRICE.QUANTITY,
      marketPrice: [product_pricing::Store]PPR_PRODUCT_PRICE.MARKET_PRICE,
      fxRate: [product_pricing::Store]PPR_PRODUCT_PRICE.FX_RATE,
      pricingCurrency: [product_pricing::Store]PPR_PRODUCT_PRICE.PRICING_CCY,
      reportingCurrency: [product_pricing::Store]PPR_PRODUCT_PRICE.REPORTING_CCY,
      confidencePercent: [product_pricing::Store]PPR_PRODUCT_PRICE.CONFIDENCE_PCT,
      tolerancePct: [product_pricing::Store]PPR_PRODUCT_PRICE.TOLERANCE_PCT,
      isModelPrice: [product_pricing::Store]PPR_PRODUCT_PRICE.IS_MODEL_PRICE,
      priceStatus: [product_pricing::Store]PPR_PRODUCT_PRICE.PRICE_STATUS,
      valuation[vcValuation]: [product_pricing::Store]@Ppr_PriceValuation,
      model[pprModel]: [product_pricing::Store]@Ppr_PriceModel,
      greekProfile[pprGreekProfile]: [product_pricing::Store]@Ppr_PriceGreekProfile,
      greeks[pprGreek]: [product_pricing::Store]@Ppr_PriceGreek,
      reserves[pprReserve]: [product_pricing::Store]@Ppr_PriceReserve
   }

   product_pricing::PprGreekProfile[pprGreekProfile]: Relational
   {
      ~primaryKey
      (
         [product_pricing::Store]PPR_GREEK_PROFILE.RUN_ID,
