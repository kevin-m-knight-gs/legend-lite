   }

   product_pricing::PprCorrelationEntry[pprCorrelation]: Relational
   {
      ~primaryKey
      (
         [product_pricing::Store]PPR_CORRELATION.MATRIX_CODE,
         [product_pricing::Store]PPR_CORRELATION.UNDERLYING_ONE,
         [product_pricing::Store]PPR_CORRELATION.UNDERLYING_TWO
