   // ================================================= what the runs produce

   product_pricing::PprPricingRun[pprPricingRun]: Relational
   {
      ~primaryKey ( [product_pricing::Store]PPR_PRICING_RUN.RUN_ID )
      ~mainTable [product_pricing::Store]PPR_PRICING_RUN
      runId: [product_pricing::Store]PPR_PRICING_RUN.RUN_ID,
      valuationRunId: [product_pricing::Store]PPR_PRICING_RUN.VALUATION_RUN_ID,
      cobDate: [product_pricing::Store]PPR_PRICING_RUN.COB_DATE,
      runType: [product_pricing::Store]PPR_PRICING_RUN.RUN_TYPE,
      status: [product_pricing::Store]PPR_PRICING_RUN.STATUS,
      productCount: [product_pricing::Store]PPR_PRICING_RUN.PRODUCT_COUNT,
