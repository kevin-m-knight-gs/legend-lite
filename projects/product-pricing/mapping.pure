      )
      ~mainTable [product_pricing::Store]PPR_VOL_POINT
      surfaceCode: [product_pricing::Store]PPR_VOL_POINT.SURFACE_CODE,
      expiryTenor: [product_pricing::Store]PPR_VOL_POINT.EXPIRY_TENOR,
      strikeBucket: [product_pricing::Store]PPR_VOL_POINT.STRIKE_BUCKET,
      strikePercent: [product_pricing::Store]PPR_VOL_POINT.STRIKE_PCT,
      impliedVolatility: [product_pricing::Store]PPR_VOL_POINT.IMPLIED_VOLATILITY,
      bidVolatility: [product_pricing::Store]PPR_VOL_POINT.BID_VOLATILITY,
      askVolatility: [product_pricing::Store]PPR_VOL_POINT.ASK_VOLATILITY,
      isInterpolated: [product_pricing::Store]PPR_VOL_POINT.IS_INTERPOLATED,
      quoteCount: [product_pricing::Store]PPR_VOL_POINT.QUOTE_COUNT
   }

   product_pricing::PprDiscountCurve[pprCurve]: Relational
   {
      ~primaryKey ( [product_pricing::Store]PPR_DISCOUNT_CURVE.CURVE_CODE )
      ~mainTable [product_pricing::Store]PPR_DISCOUNT_CURVE
      curveCode: [product_pricing::Store]PPR_DISCOUNT_CURVE.CURVE_CODE,
      curveName: [product_pricing::Store]PPR_DISCOUNT_CURVE.CURVE_NAME,
      currencyCode: [product_pricing::Store]PPR_DISCOUNT_CURVE.CURRENCY_CODE,
      curveType: [product_pricing::Store]PPR_DISCOUNT_CURVE.CURVE_TYPE,
      asOfDate: [product_pricing::Store]PPR_DISCOUNT_CURVE.AS_OF_DATE,
