###Relational
// The order-execution database.
//
// It INCLUDES BOTH dependency stores, and it has to: sixteen of the joins below have their
// far side in ORD_ORDER, ORD_EXECUTION, ORD_VENUE, TC_TRADE, TC_ALLOCATION, TC_TRADE_CHARGE
// or TC_VENUE, and a join can only name a table that is in scope.
//
// Note what that costs. order_core::Store already includes core_instrument::Store and
// core_book::Store; trade_capture::Store includes those two AND core_party::Store. Including
// both of mine therefore pulls core-instrument and core-book in TWICE, by two different
// routes -- the DIAMOND this layer of the project graph exists to test. It compiles, and the
// tables are not duplicated by it.
//
// Every table is OEX_ prefixed, every join Oex_, every filter Oex, because table names, join
// names and filter names are all GLOBAL namespaces in Legend: one collision anywhere in the
// graph fails the whole compile with a message naming the element and not the project that
// declared it.
//
// Foreign-key columns (ORDER_ID, TRADE_ID, VENUE_ID and the rest) are carried but are NOT
// mapped to properties where the model already reaches the thing by association -- a
// duplicated key would be a second answer to the same question. The exceptions are the
// natural keys the model genuinely owns (FILL_ID on a child row, ORDER_ID on a summary),
// which stay mapped because a row must be able to name its parent when the parent has not
// arrived.
Database order_execution::Store
(
   include order_core::Store
   include trade_capture::Store

   // ---------------------------------------------------------------- the link

   Table OEX_FILL
   (
      FILL_ID VARCHAR(64) PRIMARY KEY,
      VENUE_FILL_REF VARCHAR(64),
      FILL_QUANTITY DOUBLE NOT NULL,
      FILL_PRICE DOUBLE NOT NULL,
      GROSS_VALUE DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL,
      CUMULATIVE_QUANTITY DOUBLE NOT NULL,
      EXECUTED_AT TIMESTAMP NOT NULL,
      REPORTED_AT TIMESTAMP NOT NULL,
      LIQUIDITY_FLAG VARCHAR(16),
      BUST_TIME TIMESTAMP,
      EXECUTION_VENUE_MIC VARCHAR(4),
      SETTLEMENT_DATE DATE,
      // the foreign keys, into both dependencies and into this project's own rows
      ORDER_ID VARCHAR(64),
      EXECUTION_ID VARCHAR(64),
      SUMMARY_ID VARCHAR(64),
      QUOTE_ID VARCHAR(64),
      SESSION_ID VARCHAR(64)
   )

   Table OEX_EXEC_REPORT
   (
      REPORT_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      EXEC_TYPE VARCHAR(24) NOT NULL,
      SEQUENCE_NUMBER INTEGER NOT NULL,
      RECEIVED_AT TIMESTAMP NOT NULL,
      FIX_SESSION_ID VARCHAR(64),
      RAW_MESSAGE VARCHAR(1000),
      IS_DUPLICATE BIT NOT NULL
   )

   Table OEX_FILL_AMENDMENT
   (
      AMENDMENT_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      AMENDMENT_REASON VARCHAR(200) NOT NULL,
      OLD_QUANTITY DOUBLE NOT NULL,
      NEW_QUANTITY DOUBLE NOT NULL,
      OLD_PRICE DOUBLE NOT NULL,
      NEW_PRICE DOUBLE NOT NULL,
      AMENDED_AT TIMESTAMP NOT NULL,
      AMENDED_BY VARCHAR(64) NOT NULL,
      IS_VENUE_INITIATED BIT NOT NULL
   )

   // ---------------------------------------------------------------- the split

   Table OEX_ALLOCATION_SET
   (
      ALLOCATION_SET_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      FILL_QUANTITY DOUBLE NOT NULL,
      ALLOCATED_QUANTITY DOUBLE NOT NULL,
      ALLOCATION_COUNT INTEGER NOT NULL,
      ALLOCATION_STATUS VARCHAR(16) NOT NULL,
      ALLOCATED_AT TIMESTAMP,
      ALLOCATED_BY VARCHAR(64),
      ALLOCATION_METHOD VARCHAR(24) NOT NULL
   )

   Table OEX_FILL_ALLOCATION
   (
      FILL_ALLOCATION_ID VARCHAR(64) PRIMARY KEY,
      ALLOCATION_SET_ID VARCHAR(64) NOT NULL,
      FILL_ID VARCHAR(64) NOT NULL,
      ACCOUNT_REF VARCHAR(64) NOT NULL,
      CLIENT_REF VARCHAR(64),
      ALLOCATED_QUANTITY DOUBLE NOT NULL,
      FILL_QUANTITY DOUBLE NOT NULL,
      ALLOCATION_PRICE DOUBLE NOT NULL,
      ALLOCATION_CURRENCY VARCHAR(3) NOT NULL,
      ALLOCATION_STATUS VARCHAR(16) NOT NULL,
      ALLOCATED_AT TIMESTAMP,
      // the back office's own allocation of the same decision, in trade-capture
      TC_ALLOCATION_ID VARCHAR(64)
   )

   Table OEX_ALLOCATION_BREAK
   (
      ALLOCATION_BREAK_ID VARCHAR(64) PRIMARY KEY,
      ALLOCATION_SET_ID VARCHAR(64) NOT NULL,
      BREAK_TYPE VARCHAR(32) NOT NULL,
      BREAK_QUANTITY DOUBLE,
      BREAK_AMOUNT DOUBLE,
      SEVERITY VARCHAR(16) NOT NULL,
      DETECTED_AT TIMESTAMP NOT NULL,
      RESOLVED_AT TIMESTAMP,
      ASSIGNED_TO VARCHAR(64),
      RESOLUTION_NOTE VARCHAR(400)
   )

   // ---------------------------------------------------------------- order roll-up

   Table OEX_ORDER_FILL_SUMMARY
   (
      SUMMARY_ID VARCHAR(64) PRIMARY KEY,
      ORDER_ID VARCHAR(64) NOT NULL,
      ORDER_QUANTITY DOUBLE NOT NULL,
      FILLED_QUANTITY DOUBLE NOT NULL,
      AVERAGE_PRICE DOUBLE NOT NULL,
      GROSS_CONSIDERATION DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL,
      FILL_COUNT INTEGER NOT NULL,
      VENUE_COUNT INTEGER NOT NULL,
      FIRST_FILL_AT TIMESTAMP,
      LAST_FILL_AT TIMESTAMP,
      SUMMARY_AS_OF TIMESTAMP NOT NULL
   )

   // ---------------------------------------------------------------- into trade-capture

   Table OEX_TRADE_BOOKING
   (
      BOOKING_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      TRADE_REF VARCHAR(64),
      BOOKING_STATUS VARCHAR(16) NOT NULL,
      FILL_QUANTITY DOUBLE NOT NULL,
      BOOKED_QUANTITY DOUBLE NOT NULL,
      BOOKED_PRICE DOUBLE NOT NULL,
      BOOKED_CURRENCY VARCHAR(3) NOT NULL,
      BOOKED_AT TIMESTAMP,
      BOOKING_ATTEMPTS INTEGER NOT NULL,
      REJECTION_REASON VARCHAR(200),
      IS_AUTO_BOOKED BIT NOT NULL,
      // the trade-capture trade this fill was booked as
      TRADE_ID VARCHAR(64)
   )

   Table OEX_BOOKING_BREAK
   (
      BOOKING_BREAK_ID VARCHAR(64) PRIMARY KEY,
      BOOKING_ID VARCHAR(64) NOT NULL,
      FIELD_NAME VARCHAR(64) NOT NULL,
      FILL_VALUE VARCHAR(200),
      TRADE_VALUE VARCHAR(200),
      BREAK_TYPE VARCHAR(32) NOT NULL,
      SEVERITY VARCHAR(16) NOT NULL,
      DETECTED_AT TIMESTAMP NOT NULL,
      RESOLVED_AT TIMESTAMP,
      ASSIGNED_TO VARCHAR(64),
      TRADE_ID VARCHAR(64)
   )

   Table OEX_COST_LINE
   (
      COST_LINE_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      COST_TYPE VARCHAR(24) NOT NULL,
      IS_EXPLICIT BIT NOT NULL,
      COST_AMOUNT DOUBLE NOT NULL,
      COST_CURRENCY VARCHAR(3) NOT NULL,
      COST_BASIS_POINTS DOUBLE NOT NULL,
      IS_CHARGED_TO_CLIENT BIT NOT NULL,
      CALCULATION_METHOD VARCHAR(64),
      // the trade-capture charge that is the invoice behind an explicit line
      CHARGE_ID VARCHAR(64)
   )

   // ---------------------------------------------------------------- the benchmark

   Table OEX_ARRIVAL_SNAPSHOT
   (
      SNAPSHOT_ID VARCHAR(64) PRIMARY KEY,
      ORDER_ID VARCHAR(64) NOT NULL,
      ARRIVAL_PRICE DOUBLE NOT NULL,
      BID_PRICE DOUBLE NOT NULL,
      ASK_PRICE DOUBLE NOT NULL,
      BID_SIZE DOUBLE,
      ASK_SIZE DOUBLE,
      LAST_TRADED_PRICE DOUBLE,
      SNAPSHOT_CURRENCY VARCHAR(3) NOT NULL,
      ARRIVED_AT TIMESTAMP NOT NULL,
      SOURCE_FEED VARCHAR(64) NOT NULL,
      SNAPSHOT_VENUE_MIC VARCHAR(4)
   )

   Table OEX_BENCHMARK
   (
      BENCHMARK_ID VARCHAR(64) PRIMARY KEY,
      ORDER_ID VARCHAR(64) NOT NULL,
      BENCHMARK_TYPE VARCHAR(32) NOT NULL,
      BENCHMARK_PRICE DOUBLE NOT NULL,
      BENCHMARK_CURRENCY VARCHAR(3) NOT NULL,
      INTERVAL_START TIMESTAMP NOT NULL,
      INTERVAL_END TIMESTAMP NOT NULL,
      BENCHMARK_VOLUME DOUBLE,
      SOURCE_FEED VARCHAR(64) NOT NULL,
      IS_PRIMARY BIT NOT NULL
   )

   Table OEX_SLIPPAGE
   (
      SLIPPAGE_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      BENCHMARK_REF VARCHAR(64),
      BENCHMARK_TYPE VARCHAR(32) NOT NULL,
      FILL_PRICE DOUBLE NOT NULL,
      BENCHMARK_PRICE DOUBLE NOT NULL,
      MEASURED_QUANTITY DOUBLE NOT NULL,
      SLIPPAGE_AMOUNT DOUBLE NOT NULL,
      SLIPPAGE_BASIS_POINTS DOUBLE NOT NULL,
      SLIPPAGE_CURRENCY VARCHAR(3) NOT NULL,
      SIDE_SIGN DOUBLE NOT NULL,
      MEASURED_AT TIMESTAMP NOT NULL
   )

   Table OEX_MARKET_IMPACT
   (
      IMPACT_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      MODEL_NAME VARCHAR(64) NOT NULL,
      PRE_TRADE_PRICE DOUBLE NOT NULL,
      POST_TRADE_PRICE DOUBLE NOT NULL,
      TEMPORARY_IMPACT_BPS DOUBLE NOT NULL,
      PERMANENT_IMPACT_BPS DOUBLE NOT NULL,
      PREDICTED_IMPACT_BPS DOUBLE,
      IMPACT_CURRENCY VARCHAR(3) NOT NULL,
      ESTIMATED_AT TIMESTAMP NOT NULL
   )

   Table OEX_REVERSION
   (
      REVERSION_ID VARCHAR(64) PRIMARY KEY,
      IMPACT_ID VARCHAR(64) NOT NULL,
      HORIZON_SECONDS INTEGER NOT NULL,
      REFERENCE_PRICE DOUBLE NOT NULL,
      HORIZON_PRICE DOUBLE NOT NULL,
      REVERSION_BASIS_POINTS DOUBLE NOT NULL,
      MARKET_MOVE_BASIS_POINTS DOUBLE,
      MEASURED_AT TIMESTAMP NOT NULL
   )

   Table OEX_SHORTFALL
   (
      SHORTFALL_ID VARCHAR(64) PRIMARY KEY,
      ORDER_ID VARCHAR(64) NOT NULL,
      DECISION_PRICE DOUBLE NOT NULL,
      ARRIVAL_PRICE DOUBLE NOT NULL,
      AVERAGE_FILL_PRICE DOUBLE NOT NULL,
      CLOSING_PRICE DOUBLE,
      FILLED_QUANTITY DOUBLE NOT NULL,
      UNFILLED_QUANTITY DOUBLE NOT NULL,
      DELAY_COST_BPS DOUBLE NOT NULL,
      EXECUTION_COST_BPS DOUBLE NOT NULL,
      OPPORTUNITY_COST_BPS DOUBLE NOT NULL,
      EXPLICIT_COST_BPS DOUBLE NOT NULL,
      TOTAL_SHORTFALL_BPS DOUBLE NOT NULL,
      SHORTFALL_CURRENCY VARCHAR(3) NOT NULL,
      COMPUTED_AT TIMESTAMP NOT NULL,
      SNAPSHOT_ID VARCHAR(64)
   )

   // ---------------------------------------------------------------- the venue's quote

   Table OEX_VENUE_QUOTE
   (
      QUOTE_ID VARCHAR(64) PRIMARY KEY,
      VENUE_MIC VARCHAR(4) NOT NULL,
      INSTRUMENT_REF VARCHAR(60) NOT NULL,
      BID_PRICE DOUBLE NOT NULL,
      ASK_PRICE DOUBLE NOT NULL,
      BID_SIZE DOUBLE NOT NULL,
      ASK_SIZE DOUBLE NOT NULL,
      QUOTED_AT TIMESTAMP NOT NULL,
      QUOTE_CURRENCY VARCHAR(3) NOT NULL,
      IS_CONSOLIDATED BIT NOT NULL,
      SOURCE_FEED VARCHAR(64) NOT NULL,
      VENUE_ID VARCHAR(64)
   )

   Table OEX_QUOTE_COMPARISON
   (
      COMPARISON_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      QUOTE_REF VARCHAR(64),
      FILL_PRICE DOUBLE NOT NULL,
      QUOTE_BID_PRICE DOUBLE NOT NULL,
      QUOTE_ASK_PRICE DOUBLE NOT NULL,
      PRICE_OUTCOME VARCHAR(16) NOT NULL,
      PRICE_IMPROVEMENT DOUBLE NOT NULL,
      PRICE_IMPROVEMENT_BPS DOUBLE NOT NULL,
      QUOTE_AGE_MILLIS INTEGER NOT NULL,
      COMPARED_AT TIMESTAMP NOT NULL
   )

   // ---------------------------------------------------------------- the verdict

   Table OEX_POLICY
   (
      POLICY_ID VARCHAR(64) PRIMARY KEY,
      POLICY_NAME VARCHAR(200) NOT NULL,
      POLICY_VERSION INTEGER NOT NULL,
      CLIENT_CATEGORY VARCHAR(32) NOT NULL,
      EFFECTIVE_FROM DATE NOT NULL,
      EFFECTIVE_TO DATE,
      PASS_THRESHOLD DOUBLE NOT NULL,
      APPROVED_BY VARCHAR(64) NOT NULL
   )

   Table OEX_BESTEX_ASSESSMENT
   (
      ASSESSMENT_ID VARCHAR(64) PRIMARY KEY,
      ORDER_ID VARCHAR(64) NOT NULL,
      POLICY_REF VARCHAR(64),
      ASSESSED_QUANTITY DOUBLE NOT NULL,
      AVERAGE_FILL_PRICE DOUBLE NOT NULL,
      ARRIVAL_PRICE DOUBLE NOT NULL,
      SLIPPAGE_VS_ARRIVAL_BPS DOUBLE NOT NULL,
      OVERALL_SCORE DOUBLE NOT NULL,
      OUTCOME VARCHAR(24) NOT NULL,
      ASSESSED_AT TIMESTAMP NOT NULL,
      ASSESSED_BY VARCHAR(64) NOT NULL,
      REVIEWED_BY VARCHAR(64),
      REVIEW_NOTE VARCHAR(400),
      REPORT_ID VARCHAR(64)
   )

   Table OEX_BESTEX_FACTOR
   (
      FACTOR_ID VARCHAR(64) PRIMARY KEY,
      ASSESSMENT_ID VARCHAR(64) NOT NULL,
      FACTOR_NAME VARCHAR(32) NOT NULL,
      FACTOR_SCORE DOUBLE NOT NULL,
      FACTOR_WEIGHT DOUBLE NOT NULL,
      MEASURED_VALUE DOUBLE,
      MEASURE_UNIT VARCHAR(24),
      COMMENTARY VARCHAR(400)
   )

   Table OEX_BESTEX_REPORT
   (
      REPORT_ID VARCHAR(64) PRIMARY KEY,
      REPORT_NAME VARCHAR(200) NOT NULL,
      CLIENT_REF VARCHAR(64),
      REPORT_PERIOD_TYPE VARCHAR(16) NOT NULL,
      PERIOD_START DATE NOT NULL,
      PERIOD_END DATE NOT NULL,
      ORDER_COUNT INTEGER NOT NULL,
      ASSESSED_COUNT INTEGER NOT NULL,
      FAIL_COUNT INTEGER NOT NULL,
      PUBLISHED_AT TIMESTAMP,
      PUBLISHED_BY VARCHAR(64),
      REPORT_VERSION INTEGER NOT NULL
   )

   Table OEX_VENUE_PERFORMANCE
   (
      PERFORMANCE_ID VARCHAR(64) PRIMARY KEY,
      VENUE_MIC VARCHAR(4) NOT NULL,
      PERIOD_START DATE NOT NULL,
      PERIOD_END DATE NOT NULL,
      ORDER_COUNT INTEGER NOT NULL,
      FILL_COUNT INTEGER NOT NULL,
      FILLED_QUANTITY DOUBLE NOT NULL,
      NOTIONAL_TRADED DOUBLE NOT NULL,
      PERFORMANCE_CURRENCY VARCHAR(3) NOT NULL,
      FILL_RATE DOUBLE NOT NULL,
      AVERAGE_SLIPPAGE_BPS DOUBLE NOT NULL,
      AVERAGE_SPREAD_BPS DOUBLE NOT NULL,
      PRICE_IMPROVEMENT_RATE DOUBLE NOT NULL,
      AVERAGE_LATENCY_MILLIS INTEGER,
      REJECT_RATE DOUBLE NOT NULL,
      // the same venue as two projects know it, plus the report it is published in
      VENUE_ID VARCHAR(64),
      TC_VENUE_ID VARCHAR(64),
      REPORT_ID VARCHAR(64)
   )

   // ---------------------------------------------------------------- context

   Table OEX_PARTICIPATION
   (
      PARTICIPATION_ID VARCHAR(64) PRIMARY KEY,
      ORDER_ID VARCHAR(64) NOT NULL,
      INTERVAL_START TIMESTAMP NOT NULL,
      INTERVAL_END TIMESTAMP NOT NULL,
      TARGET_RATE DOUBLE NOT NULL,
      ACHIEVED_RATE DOUBLE NOT NULL,
      OUR_VOLUME DOUBLE NOT NULL,
      MARKET_VOLUME DOUBLE NOT NULL,
      INTERVAL_VWAP DOUBLE,
      SESSION_ID VARCHAR(64)
   )

   Table OEX_LIQUIDITY_CAPTURE
   (
      CAPTURE_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      CAPTURED_QUANTITY DOUBLE NOT NULL,
      CAPTURE_TYPE VARCHAR(16) NOT NULL,
      SPREAD_CAPTURE_RATIO DOUBLE NOT NULL,
      SPREAD_AT_FILL DOUBLE NOT NULL,
      REBATE_AMOUNT DOUBLE,
      REBATE_CURRENCY VARCHAR(3),
      IS_WASH_RISK BIT NOT NULL
   )

   Table OEX_SESSION
   (
      SESSION_ID VARCHAR(64) PRIMARY KEY,
      VENUE_MIC VARCHAR(4) NOT NULL,
      TRADING_DATE DATE NOT NULL,
      SESSION_TYPE VARCHAR(24) NOT NULL,
      SESSION_START TIMESTAMP NOT NULL,
      SESSION_END TIMESTAMP NOT NULL,
      IS_HALTED BIT NOT NULL,
      HALT_REASON VARCHAR(200),
      REFERENCE_PRICE DOUBLE
   )

   Table OEX_LATENCY
   (
      LATENCY_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      ORDER_SENT_AT TIMESTAMP NOT NULL,
      VENUE_ACK_AT TIMESTAMP,
      FILLED_AT TIMESTAMP NOT NULL,
      REPORT_RECEIVED_AT TIMESTAMP NOT NULL,
      GATEWAY_LATENCY_MICROS INTEGER NOT NULL,
      VENUE_LATENCY_MICROS INTEGER NOT NULL,
      TOTAL_LATENCY_MICROS INTEGER NOT NULL,
      IS_CLOCK_SYNCHRONISED BIT NOT NULL
   )

   Table OEX_EXCEPTION
   (
      EXCEPTION_ID VARCHAR(64) PRIMARY KEY,
      FILL_ID VARCHAR(64) NOT NULL,
      EXCEPTION_TYPE VARCHAR(32) NOT NULL,
      SEVERITY VARCHAR(16) NOT NULL,
      EXCEPTION_MESSAGE VARCHAR(400) NOT NULL,
      OBSERVED_VALUE DOUBLE,
      THRESHOLD_VALUE DOUBLE,
      RAISED_AT TIMESTAMP NOT NULL,
      RAISED_BY VARCHAR(64) NOT NULL,
      ACKNOWLEDGED_AT TIMESTAMP,
      CLEARED_AT TIMESTAMP,
      CLEARED_BY VARCHAR(64)
   )

   Table OEX_CLIENT_INSTRUCTION
   (
      INSTRUCTION_ID VARCHAR(64) PRIMARY KEY,
      ORDER_ID VARCHAR(64) NOT NULL,
      INSTRUCTION_TYPE VARCHAR(32) NOT NULL,
      INSTRUCTION_TEXT VARCHAR(400) NOT NULL,
      NUMERIC_VALUE DOUBLE,
      VENUE_MIC VARCHAR(4),
      RECEIVED_AT TIMESTAMP NOT NULL,
      RECEIVED_FROM VARCHAR(64) NOT NULL,
      RECEIVED_VIA VARCHAR(32) NOT NULL,
      OVERRIDES_POLICY BIT NOT NULL,
      ACKNOWLEDGED_AT TIMESTAMP
   )

   // ---------------------------------------------------------------- joins
   //
   // Each on ONE line. A wrapped join does compile, but the corpus's own reader
   // (scripts/corpus/model.py) refuses one, and these projects are meant to stay readable
   // by it.

   // ---- into order-core ----
   Join Oex_FillOrder(OEX_FILL.ORDER_ID = ORD_ORDER.ORDER_ID)
   Join Oex_FillSourceExecution(OEX_FILL.EXECUTION_ID = ORD_EXECUTION.EXECUTION_ID)
   Join Oex_SummaryOrder(OEX_ORDER_FILL_SUMMARY.ORDER_ID = ORD_ORDER.ORDER_ID)
   Join Oex_ArrivalOrder(OEX_ARRIVAL_SNAPSHOT.ORDER_ID = ORD_ORDER.ORDER_ID)
   Join Oex_BenchmarkOrder(OEX_BENCHMARK.ORDER_ID = ORD_ORDER.ORDER_ID)
   Join Oex_ShortfallOrder(OEX_SHORTFALL.ORDER_ID = ORD_ORDER.ORDER_ID)
   Join Oex_AssessmentOrder(OEX_BESTEX_ASSESSMENT.ORDER_ID = ORD_ORDER.ORDER_ID)
   Join Oex_ParticipationOrder(OEX_PARTICIPATION.ORDER_ID = ORD_ORDER.ORDER_ID)
   Join Oex_InstructionOrder(OEX_CLIENT_INSTRUCTION.ORDER_ID = ORD_ORDER.ORDER_ID)
   Join Oex_QuoteVenue(OEX_VENUE_QUOTE.VENUE_ID = ORD_VENUE.VENUE_ID)
   Join Oex_PerformanceVenue(OEX_VENUE_PERFORMANCE.VENUE_ID = ORD_VENUE.VENUE_ID)

   // ---- into trade-capture ----
   Join Oex_BookingTrade(OEX_TRADE_BOOKING.TRADE_ID = TC_TRADE.TRADE_ID)
   Join Oex_BookingBreakTrade(OEX_BOOKING_BREAK.TRADE_ID = TC_TRADE.TRADE_ID)
   Join Oex_AllocationTrade(OEX_FILL_ALLOCATION.TC_ALLOCATION_ID = TC_ALLOCATION.ALLOCATION_ID)
   Join Oex_CostCharge(OEX_COST_LINE.CHARGE_ID = TC_TRADE_CHARGE.CHARGE_ID)
   Join Oex_PerformanceMifidVenue(OEX_VENUE_PERFORMANCE.TC_VENUE_ID = TC_VENUE.VENUE_ID)

   // ---- internal ----
   Join Oex_FillReport(OEX_FILL.FILL_ID = OEX_EXEC_REPORT.FILL_ID)
   Join Oex_FillAmendment(OEX_FILL.FILL_ID = OEX_FILL_AMENDMENT.FILL_ID)
   Join Oex_FillAllocation(OEX_FILL.FILL_ID = OEX_FILL_ALLOCATION.FILL_ID)
   Join Oex_FillAllocationSet(OEX_FILL.FILL_ID = OEX_ALLOCATION_SET.FILL_ID)
   Join Oex_SetAllocation(OEX_ALLOCATION_SET.ALLOCATION_SET_ID = OEX_FILL_ALLOCATION.ALLOCATION_SET_ID)
   Join Oex_SetBreak(OEX_ALLOCATION_SET.ALLOCATION_SET_ID = OEX_ALLOCATION_BREAK.ALLOCATION_SET_ID)
   Join Oex_SummaryFill(OEX_ORDER_FILL_SUMMARY.SUMMARY_ID = OEX_FILL.SUMMARY_ID)
   Join Oex_FillBooking(OEX_FILL.FILL_ID = OEX_TRADE_BOOKING.FILL_ID)
   Join Oex_BookingBreakLink(OEX_TRADE_BOOKING.BOOKING_ID = OEX_BOOKING_BREAK.BOOKING_ID)
   Join Oex_FillCostLine(OEX_FILL.FILL_ID = OEX_COST_LINE.FILL_ID)
   Join Oex_FillSlippage(OEX_FILL.FILL_ID = OEX_SLIPPAGE.FILL_ID)
   Join Oex_BenchmarkSlippage(OEX_BENCHMARK.BENCHMARK_ID = OEX_SLIPPAGE.BENCHMARK_REF)
   Join Oex_FillImpact(OEX_FILL.FILL_ID = OEX_MARKET_IMPACT.FILL_ID)
   Join Oex_ImpactReversion(OEX_MARKET_IMPACT.IMPACT_ID = OEX_REVERSION.IMPACT_ID)
   Join Oex_ShortfallArrival(OEX_SHORTFALL.SNAPSHOT_ID = OEX_ARRIVAL_SNAPSHOT.SNAPSHOT_ID)
   Join Oex_FillQuote(OEX_FILL.QUOTE_ID = OEX_VENUE_QUOTE.QUOTE_ID)
   Join Oex_FillQuoteComparison(OEX_FILL.FILL_ID = OEX_QUOTE_COMPARISON.FILL_ID)
   Join Oex_QuoteComparison(OEX_VENUE_QUOTE.QUOTE_ID = OEX_QUOTE_COMPARISON.QUOTE_REF)
   Join Oex_AssessmentFactor(OEX_BESTEX_ASSESSMENT.ASSESSMENT_ID = OEX_BESTEX_FACTOR.ASSESSMENT_ID)
   Join Oex_AssessmentPolicy(OEX_BESTEX_ASSESSMENT.POLICY_REF = OEX_POLICY.POLICY_ID)
   Join Oex_AssessmentReport(OEX_BESTEX_ASSESSMENT.REPORT_ID = OEX_BESTEX_REPORT.REPORT_ID)
   Join Oex_ReportVenuePerformance(OEX_BESTEX_REPORT.REPORT_ID = OEX_VENUE_PERFORMANCE.REPORT_ID)
   Join Oex_FillLiquidity(OEX_FILL.FILL_ID = OEX_LIQUIDITY_CAPTURE.FILL_ID)
   Join Oex_FillSession(OEX_FILL.SESSION_ID = OEX_SESSION.SESSION_ID)
   Join Oex_SessionParticipation(OEX_SESSION.SESSION_ID = OEX_PARTICIPATION.SESSION_ID)
   Join Oex_FillLatency(OEX_FILL.FILL_ID = OEX_LATENCY.FILL_ID)
   Join Oex_FillException(OEX_FILL.FILL_ID = OEX_EXCEPTION.FILL_ID)

   // ---------------------------------------------------------------- filters
   //
   // Both are null tests. A Filter will NOT take a boolean literal -- `IS_BUSTED = true`
   // fails with `Unexpected token 'true'` -- so "still a real fill" has to be expressed as
   // the absence of the bust timestamp, which is how the column is modelled anyway.
   Filter OexLiveFills(OEX_FILL.BUST_TIME is null)
   Filter OexOpenBookingBreaks(OEX_BOOKING_BREAK.RESOLVED_AT is null)
)
