   // ==========================================================================================
   // THE FOUR AGGREGATION SETS -- `~mainTable` is a VIEW, `~primaryKey` is the `~groupBy`
   // ==========================================================================================
   // A query naming one of these classes reads the GROUP BY directly: one row per group, not
   // one per line. Navigating `lines` from here goes back DOWN to the rows that made the
   // group, which is the only direction that makes sense -- there is no sibling group to
   // reach sideways.

   firm_balance_sheet::FbsCategoryTotal[fbsCategoryTotal]: Relational
   {
      ~primaryKey
      (
         [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.INSTITUTION_ID,
         [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.AS_OF_DATE,
         [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.REPORTING_CURRENCY,
         [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.CATEGORY_CODE
      )
      ~mainTable [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL
      institutionId: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.INSTITUTION_ID,
      asOfDate: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.AS_OF_DATE,
      reportingCurrency: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.REPORTING_CURRENCY,
      categoryCode: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.CATEGORY_CODE,
      lineCount: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.LINE_COUNT,
      totalCarrying: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.TOTAL_CARRYING,
      totalGross: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.TOTAL_GROSS,
      totalImpairment: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.TOTAL_IMPAIRMENT,
      totalPriorCarrying: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.TOTAL_PRIOR_CARRYING,
      largestLine: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.LARGEST_LINE,
      smallestLine: [firm_balance_sheet::Store]fbs.FBS_CATEGORY_TOTAL.SMALLEST_LINE,
      statement[fbsStatement]: [firm_balance_sheet::Store]@Fbs_StatementCategoryTotal,
      category[fbsCategory]: [firm_balance_sheet::Store]@Fbs_CategoryCategoryTotal,
      lines[fbsLineItem]: [firm_balance_sheet::Store]@Fbs_LineCategoryTotal
   }

