###Mapping

// ============================================================
// client_reporting::Mapping -- thirty class sets, forty-one association sets
// ============================================================
// THREE mapping includes, matching the three store includes. That is what makes the
// dependencies' set ids -- `cliClient`, `cliMandate`, `cliClientContact`, `pkPosition`,
// `pkPositionMovement`, `pkAccountDayTotal`, `vcValuation`, `vcRun` -- nameable in the
// AssociationMappings at the foot of this file.
//
// All three dependencies declare their set ids EXPLICITLY, which means the default ids
// (`client_core_CliClient`, `position_keeping_Position`, `valuation_core_VcValuation`) do not
// exist to fall back on. Every cross-project association end below therefore names
// [sourceSetId, targetSetId] in full; the bare `prop: [db]@Join` form would only resolve
// against defaults and fails here with a message naming the property and not the project.
//
// This project's own set ids are crp-prefixed and are all named explicitly for the same
// reason a set id is prefixed at all: it is a GLOBAL namespace across the compiled graph.
// None is marked root, so a downstream `extends [...]` must name the id from the MANIFEST.
Mapping client_reporting::Mapping
(
   include client_core::Mapping
   include position_keeping::Mapping
   include valuation_core::Mapping

   // ---- the run -------------------------------------------------------------------------
   client_reporting::CrpStatementRun[crpStatementRun]: Relational
   {
      ~primaryKey
      (
         [client_reporting::Store]CRP_STATEMENT_RUN.RUN_ID
      )
      ~mainTable [client_reporting::Store]CRP_STATEMENT_RUN
      runId: [client_reporting::Store]CRP_STATEMENT_RUN.RUN_ID,
      periodEndDate: [client_reporting::Store]CRP_STATEMENT_RUN.PERIOD_END_DATE,
      runType: [client_reporting::Store]CRP_STATEMENT_RUN.RUN_TYPE,
      status: [client_reporting::Store]CRP_STATEMENT_RUN.STATUS,
      startedAt: [client_reporting::Store]CRP_STATEMENT_RUN.STARTED_AT,
      completedAt: [client_reporting::Store]CRP_STATEMENT_RUN.COMPLETED_AT,
      statementCount: [client_reporting::Store]CRP_STATEMENT_RUN.STATEMENT_COUNT,
      triggeredBy: [client_reporting::Store]CRP_STATEMENT_RUN.TRIGGERED_BY
   }

   // ---- what was agreed -------------------------------------------------------------------
   client_reporting::CrpReportingProfile[crpReportingProfile]: Relational
   {
      ~primaryKey
      (
         [client_reporting::Store]CRP_REPORTING_PROFILE.CLIENT_ID
      )
      ~mainTable [client_reporting::Store]CRP_REPORTING_PROFILE
      clientId: [client_reporting::Store]CRP_REPORTING_PROFILE.CLIENT_ID,
      valuationFrequency: [client_reporting::Store]CRP_REPORTING_PROFILE.VALUATION_FREQUENCY,
      transactionReporting: [client_reporting::Store]CRP_REPORTING_PROFILE.TRANSACTION_REPORTING,
      channelCode: [client_reporting::Store]CRP_REPORTING_PROFILE.CHANNEL_CODE,
      languageCode: [client_reporting::Store]CRP_REPORTING_PROFILE.LANGUAGE_CODE,
      reportingCurrency: [client_reporting::Store]CRP_REPORTING_PROFILE.REPORTING_CURRENCY,
      consolidateMandates: [client_reporting::Store]CRP_REPORTING_PROFILE.CONSOLIDATE_MANDATES,
      exAnteRequired: [client_reporting::Store]CRP_REPORTING_PROFILE.EX_ANTE_REQUIRED,
      depreciationNoticeRequired: [client_reporting::Store]CRP_REPORTING_PROFILE.DEPRECIATION_NOTICE_REQUIRED,
      optedOutOn: [client_reporting::Store]CRP_REPORTING_PROFILE.OPTED_OUT_ON
   }

   // ---- the document ------------------------------------------------------------------------
   // The last four property mappings are the fan-in in miniature. None of the columns they
   // read is on CRP_STATEMENT: the first three are one hop into client-core, and the fourth
   // is FOUR hops -- CRP_STATEMENT -> CLI_CLIENT -> CG_COUNTRY -> CG_SUB_REGION ->
   // CG_MACRO_REGION -- crossing two project boundaries and landing two layers below this
   // one. Single-valued because every hop is many-to-one; the pipe before the final column
   // is not optional.
   client_reporting::CrpStatement[crpStatement]: Relational
   {
      ~primaryKey
      (
         [client_reporting::Store]CRP_STATEMENT.STATEMENT_ID
      )
      ~mainTable [client_reporting::Store]CRP_STATEMENT
      statementId: [client_reporting::Store]CRP_STATEMENT.STATEMENT_ID,
      statementType: [client_reporting::Store]CRP_STATEMENT.STATEMENT_TYPE,
      periodStartDate: [client_reporting::Store]CRP_STATEMENT.PERIOD_START_DATE,
      periodEndDate: [client_reporting::Store]CRP_STATEMENT.PERIOD_END_DATE,
      reportingCurrency: [client_reporting::Store]CRP_STATEMENT.REPORTING_CURRENCY,
      status: [client_reporting::Store]CRP_STATEMENT.STATUS,
      generatedAt: [client_reporting::Store]CRP_STATEMENT.GENERATED_AT,
      approvedBy: [client_reporting::Store]CRP_STATEMENT.APPROVED_BY,
      withdrawnOn: [client_reporting::Store]CRP_STATEMENT.WITHDRAWN_ON,
      pageCount: [client_reporting::Store]CRP_STATEMENT.PAGE_COUNT,

      clientName: [client_reporting::Store]@Crp_StatementClient | [client_core::Store]CLI_CLIENT.CLIENT_NAME,
      mandateBenchmarkCode: [client_reporting::Store]@Crp_StatementMandate | [client_core::Store]CLI_MANDATE.BENCHMARK_CODE,
      mandateBaseCurrencyCode: [client_reporting::Store]@Crp_StatementMandate | [client_core::Store]CLI_MANDATE.BASE_CURRENCY_CODE,
      clientMacroRegionName: [client_reporting::Store]@Crp_StatementClient > @Cli_ClientCountry > @Cg_CountrySubRegion > @Cg_SubRegionMacroRegion | [core_geo::Store]CG_MACRO_REGION.NAME
   }

   client_reporting::CrpDocumentTemplate[crpDocumentTemplate]: Relational
   {
      ~primaryKey
      (
         [client_reporting::Store]CRP_DOCUMENT_TEMPLATE.TEMPLATE_CODE
      )
      ~mainTable [client_reporting::Store]CRP_DOCUMENT_TEMPLATE
      templateCode: [client_reporting::Store]CRP_DOCUMENT_TEMPLATE.TEMPLATE_CODE,
      templateName: [client_reporting::Store]CRP_DOCUMENT_TEMPLATE.TEMPLATE_NAME,
      versionNo: [client_reporting::Store]CRP_DOCUMENT_TEMPLATE.VERSION_NO,
      languageCode: [client_reporting::Store]CRP_DOCUMENT_TEMPLATE.LANGUAGE_CODE,
      statementType: [client_reporting::Store]CRP_DOCUMENT_TEMPLATE.STATEMENT_TYPE,
      approvedBy: [client_reporting::Store]CRP_DOCUMENT_TEMPLATE.APPROVED_BY,
      effectiveFrom: [client_reporting::Store]CRP_DOCUMENT_TEMPLATE.EFFECTIVE_FROM,
      withdrawnOn: [client_reporting::Store]CRP_DOCUMENT_TEMPLATE.WITHDRAWN_ON
   }

