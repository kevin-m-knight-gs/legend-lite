   }

   client_reporting::CrpCheckMandate: Relational
   {
      AssociationMapping
      (
         checkedMandate[crpDepreciationCheck, cliMandate]: [client_reporting::Store]@Crp_CheckMandate,
         depreciationChecks[cliMandate, crpDepreciationCheck]: [client_reporting::Store]@Crp_CheckMandate
      )
   }

   // ---- into position-keeping ---------------------------------------------------------------------------
   client_reporting::CrpLinePosition: Relational
   {
      AssociationMapping
      (
         position[crpValuationLine, pkPosition]: [client_reporting::Store]@Crp_LinePosition,
         valuationLines[pkPosition, crpValuationLine]: [client_reporting::Store]@Crp_LinePosition
