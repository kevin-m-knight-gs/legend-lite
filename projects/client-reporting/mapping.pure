   {
      AssociationMapping
      (
         accountDayTotal[crpValuationStatement, pkAccountDayTotal]: [client_reporting::Store]@Crp_StatementAccountDayTotal,
         valuationStatements[pkAccountDayTotal, crpValuationStatement]: [client_reporting::Store]@Crp_StatementAccountDayTotal
      )
   }

   // ---- into valuation-core ------------------------------------------------------------------------------
   client_reporting::CrpLineValuation: Relational
   {
      AssociationMapping
      (
         valuation[crpValuationLine, vcValuation]: [client_reporting::Store]@Crp_LineValuation,
         reportedLines[vcValuation, crpValuationLine]: [client_reporting::Store]@Crp_LineValuation
      )
   }

   client_reporting::CrpStatementValuationRun: Relational
   {
      AssociationMapping
      (
         valuationRun[crpValuationStatement, vcRun]: [client_reporting::Store]@Crp_StatementValuationRun,
         statementsProduced[vcRun, crpValuationStatement]: [client_reporting::Store]@Crp_StatementValuationRun
      )
   }

   // ---- from THIS project's aggregate, back across a boundary -------------------------------------------
   client_reporting::CrpPeriodTotalClient: Relational
   {
      AssociationMapping
      (
         totalClient[crpClientPeriodTotal, cliClient]: [client_reporting::Store]@Crp_PeriodTotalClient,
         periodTotals[cliClient, crpClientPeriodTotal]: [client_reporting::Store]@Crp_PeriodTotalClient
      )
   }
)
