      )
      ~mainTable [client_reporting::Store]CRP_SUPPRESSION
      suppressionId: [client_reporting::Store]CRP_SUPPRESSION.SUPPRESSION_ID,
      statementType: [client_reporting::Store]CRP_SUPPRESSION.STATEMENT_TYPE,
