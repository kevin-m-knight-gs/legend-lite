   // ---- the valuation statement ---------------------------------------------------------------
   // Two chained reads into two different dependencies: the first pair lands on
   // position-keeping's PK_ACCOUNT_DAY_TOTAL, which is a VIEW, so it reads a GROUP; the second
   // pair lands on valuation-core's run header.
   client_reporting::CrpValuationStatement[crpValuationStatement]: Relational
   {
      ~primaryKey
      (
         [client_reporting::Store]CRP_VALUATION_STATEMENT.STATEMENT_ID
      )
      ~mainTable [client_reporting::Store]CRP_VALUATION_STATEMENT
      statementId: [client_reporting::Store]CRP_VALUATION_STATEMENT.STATEMENT_ID,
      institutionId: [client_reporting::Store]CRP_VALUATION_STATEMENT.INSTITUTION_ID,
      accountNo: [client_reporting::Store]CRP_VALUATION_STATEMENT.ACCOUNT_NO,
      cobDate: [client_reporting::Store]CRP_VALUATION_STATEMENT.COB_DATE,
      valuationRunId: [client_reporting::Store]CRP_VALUATION_STATEMENT.VALUATION_RUN_ID,
      openingValue: [client_reporting::Store]CRP_VALUATION_STATEMENT.OPENING_VALUE,
      closingValue: [client_reporting::Store]CRP_VALUATION_STATEMENT.CLOSING_VALUE,
      netContributions: [client_reporting::Store]CRP_VALUATION_STATEMENT.NET_CONTRIBUTIONS,
      incomeReceived: [client_reporting::Store]CRP_VALUATION_STATEMENT.INCOME_RECEIVED,
      accruedInterest: [client_reporting::Store]CRP_VALUATION_STATEMENT.ACCRUED_INTEREST,
      cashBalance: [client_reporting::Store]CRP_VALUATION_STATEMENT.CASH_BALANCE,
      lineCount: [client_reporting::Store]CRP_VALUATION_STATEMENT.LINE_COUNT,
      unpricedLineCount: [client_reporting::Store]CRP_VALUATION_STATEMENT.UNPRICED_LINE_COUNT,

      accountTotalMarketValue: [client_reporting::Store]@Crp_StatementAccountDayTotal | [position_keeping::Store]PK_ACCOUNT_DAY_TOTAL.TOTAL_MARKET_VALUE,
      accountPositionCount: [client_reporting::Store]@Crp_StatementAccountDayTotal | [position_keeping::Store]PK_ACCOUNT_DAY_TOTAL.POSITION_COUNT,
      valuationRunReportingCurrency: [client_reporting::Store]@Crp_StatementValuationRun | [valuation_core::Store]VC_VALUATION_RUN.REPORTING_CCY,
      valuationRunStatus: [client_reporting::Store]@Crp_StatementValuationRun | [valuation_core::Store]VC_VALUATION_RUN.STATUS
   }

   // The join point of the project. Two chained reads, into two different dependencies, from
   // the same row: the quantity is checked against position-keeping and the price against
   // valuation-core.
   client_reporting::CrpValuationLine[crpValuationLine]: Relational
   {
      ~primaryKey
      (
         [client_reporting::Store]CRP_VALUATION_LINE.STATEMENT_ID,
         [client_reporting::Store]CRP_VALUATION_LINE.LINE_SEQ
      )
      ~mainTable [client_reporting::Store]CRP_VALUATION_LINE
      statementId: [client_reporting::Store]CRP_VALUATION_LINE.STATEMENT_ID,
      lineSeq: [client_reporting::Store]CRP_VALUATION_LINE.LINE_SEQ,
      institutionId: [client_reporting::Store]CRP_VALUATION_LINE.INSTITUTION_ID,
      accountNo: [client_reporting::Store]CRP_VALUATION_LINE.ACCOUNT_NO,
      instrumentId: [client_reporting::Store]CRP_VALUATION_LINE.INSTRUMENT_ID,
      cobDate: [client_reporting::Store]CRP_VALUATION_LINE.COB_DATE,
      valuationRunId: [client_reporting::Store]CRP_VALUATION_LINE.VALUATION_RUN_ID,
      quantity: [client_reporting::Store]CRP_VALUATION_LINE.QUANTITY,
      unitCost: [client_reporting::Store]CRP_VALUATION_LINE.UNIT_COST,
      marketPrice: [client_reporting::Store]CRP_VALUATION_LINE.MARKET_PRICE,
      marketValue: [client_reporting::Store]CRP_VALUATION_LINE.MARKET_VALUE,
      valueInReporting: [client_reporting::Store]CRP_VALUATION_LINE.VALUE_IN_REPORTING,
      weightPct: [client_reporting::Store]CRP_VALUATION_LINE.WEIGHT_PCT,
      unrealisedPnl: [client_reporting::Store]CRP_VALUATION_LINE.UNREALISED_PNL,
      assetClass: [client_reporting::Store]CRP_VALUATION_LINE.ASSET_CLASS,
      isPriceStale: [client_reporting::Store]CRP_VALUATION_LINE.IS_PRICE_STALE,

      positionClosingQuantity: [client_reporting::Store]@Crp_LinePosition | [position_keeping::Store]PK_POSITION.CLOSING_QUANTITY,
      positionMarketValue: [client_reporting::Store]@Crp_LinePosition | [position_keeping::Store]PK_POSITION.MARKET_VALUE,
      valuationDirtyPrice: [client_reporting::Store]@Crp_LineValuation | [valuation_core::Store]VC_VALUATION.DIRTY_PRICE,
      valuationFxRate: [client_reporting::Store]@Crp_LineValuation | [valuation_core::Store]VC_VALUATION.FX_RATE
   }

