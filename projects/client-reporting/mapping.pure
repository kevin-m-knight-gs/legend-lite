   // ==== associations, across a project boundary ==========================================================
   // Twelve of them, reaching ALL THREE dependencies. Every end names [sourceSetId,
   // targetSetId], and the ids on the far side are the dependency's explicit ones --
   // `cliClient`, `pkPosition`, `vcValuation`. The join itself lives in
   // client_reporting::Store even for the end whose source table belongs to the dependency,
   // because that is the store that includes all three.

   // ---- into client-core -------------------------------------------------------------------------------
   client_reporting::CrpStatementClient: Relational
   {
      AssociationMapping
      (
         client[crpStatement, cliClient]: [client_reporting::Store]@Crp_StatementClient,
         clientStatements[cliClient, crpStatement]: [client_reporting::Store]@Crp_StatementClient
      )
   }

   client_reporting::CrpStatementMandate: Relational
   {
      AssociationMapping
      (
         mandate[crpStatement, cliMandate]: [client_reporting::Store]@Crp_StatementMandate,
         mandateStatements[cliMandate, crpStatement]: [client_reporting::Store]@Crp_StatementMandate
      )
   }

   client_reporting::CrpRecipientContact: Relational
   {
      AssociationMapping
      (
         contact[crpStatementRecipient, cliClientContact]: [client_reporting::Store]@Crp_RecipientContact,
         recipientRows[cliClientContact, crpStatementRecipient]: [client_reporting::Store]@Crp_RecipientContact
      )
   }

   client_reporting::CrpProfileClient: Relational
   {
      AssociationMapping
      (
         profiledClient[crpReportingProfile, cliClient]: [client_reporting::Store]@Crp_ProfileClient,
         reportingProfile[cliClient, crpReportingProfile]: [client_reporting::Store]@Crp_ProfileClient
      )
   }

   client_reporting::CrpSuppressionClient: Relational
   {
      AssociationMapping
      (
         suppressedClient[crpSuppression, cliClient]: [client_reporting::Store]@Crp_SuppressionClient,
         suppressions[cliClient, crpSuppression]: [client_reporting::Store]@Crp_SuppressionClient
