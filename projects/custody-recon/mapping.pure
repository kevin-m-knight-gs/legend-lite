###Mapping
// The custody-recon mapping. It INCLUDES both upstream mappings, so the sets its
// cross-project property mappings land on -- `cstHolding`, `cstDepot`,
// `cstPendingMovement`, `cstStatementLine` on the custody side, `pkPosition`,
// `pkMovementTotal`, `pkSettlementLadderEntry` on the internal side -- already exist and
// are not redefined here. Both upstream projects give their sets EXPLICIT ids, so the
// default ids (`custody_core_CustodyHolding`, `position_keeping_Position`) do not exist
// and every crossing property mapping below names the upstream id by hand.
//
// Read the ~primaryKey lists in order and the shape of the project is visible without
// reading anything else: 1, 3, 2, 3, 5, 6, 7, 3, 2, then the four aggregates whose keys
// are their views' ~groupBy. Only RCN_DEFINITION is identified by one column, and that is
// because a reconciliation is a name somebody chose.
//
// `rcnItem` is the ROOT set. It is the class that carries both upstream key shapes, so it
// is the one a downstream project has any business starting a query from.
Mapping custody_recon::Mapping
(
   include custody_core::Mapping
   include position_keeping::Mapping

   custody_recon::ReconDefinition[rcnDefinition]: Relational
   {
      ~primaryKey
      (
         [custody_recon::Store]RCN_DEFINITION.RECON_CODE
      )
      ~mainTable [custody_recon::Store]RCN_DEFINITION
      reconCode: [custody_recon::Store]RCN_DEFINITION.RECON_CODE,
      reconName: [custody_recon::Store]RCN_DEFINITION.RECON_NAME,
      sourceASystem: [custody_recon::Store]RCN_DEFINITION.SOURCE_A_SYSTEM,
      sourceBSystem: [custody_recon::Store]RCN_DEFINITION.SOURCE_B_SYSTEM,
      frequency: [custody_recon::Store]RCN_DEFINITION.FREQUENCY,
      ownerTeam: [custody_recon::Store]RCN_DEFINITION.OWNER_TEAM,
      defaultToleranceQuantity: [custody_recon::Store]RCN_DEFINITION.DEFAULT_TOLERANCE_QUANTITY,
      introducedOn: [custody_recon::Store]RCN_DEFINITION.INTRODUCED_ON,
      retiredOn: [custody_recon::Store]RCN_DEFINITION.RETIRED_ON,
      toleranceRules[rcnToleranceRule]: [custody_recon::Store]@Rcn_DefinitionToleranceRules,
      ageingBands[rcnAgeingBand]: [custody_recon::Store]@Rcn_DefinitionAgeingBands,
      runs[rcnRun]: [custody_recon::Store]@Rcn_DefinitionRuns
   }

   // Three key columns.
   custody_recon::ToleranceRule[rcnToleranceRule]: Relational
   {
      ~primaryKey
      (
         [custody_recon::Store]RCN_TOLERANCE_RULE.RECON_CODE,
         [custody_recon::Store]RCN_TOLERANCE_RULE.RULE_SCOPE,
         [custody_recon::Store]RCN_TOLERANCE_RULE.RULE_CODE
      )
      ~mainTable [custody_recon::Store]RCN_TOLERANCE_RULE
      reconCode: [custody_recon::Store]RCN_TOLERANCE_RULE.RECON_CODE,
      ruleScope: [custody_recon::Store]RCN_TOLERANCE_RULE.RULE_SCOPE,
      ruleCode: [custody_recon::Store]RCN_TOLERANCE_RULE.RULE_CODE,
      toleranceQuantity: [custody_recon::Store]RCN_TOLERANCE_RULE.TOLERANCE_QUANTITY,
      tolerancePercent: [custody_recon::Store]RCN_TOLERANCE_RULE.TOLERANCE_PERCENT,
      toleranceAmount: [custody_recon::Store]RCN_TOLERANCE_RULE.TOLERANCE_AMOUNT,
      toleranceCurrency: [custody_recon::Store]RCN_TOLERANCE_RULE.TOLERANCE_CURRENCY,
      appliesFrom: [custody_recon::Store]RCN_TOLERANCE_RULE.APPLIES_FROM,
      appliesTo: [custody_recon::Store]RCN_TOLERANCE_RULE.APPLIES_TO,
      ruleNote: [custody_recon::Store]RCN_TOLERANCE_RULE.RULE_NOTE,
      definition[rcnDefinition]: [custody_recon::Store]@Rcn_DefinitionToleranceRules,
      items[rcnItem]: [custody_recon::Store]@Rcn_ItemToleranceRule
   }

