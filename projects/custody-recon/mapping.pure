   // ------------------------------------------------------------ the aggregate sets
   //
   // Rooted on views. Each ~primaryKey IS its view's ~groupBy, so an instance is a GROUP.

   // The reconciling aggregate. Its key is the position's five columns, because grouping
   // the depot away is how the custody side is given the internal side's shape -- and
   // then `position[pkPosition]` joins the group straight onto the position row.
   custody_recon::DepotRollup[rcnDepotRollup]: Relational
   {
      ~primaryKey
      (
         [custody_recon::Store]RCN_DEPOT_ROLLUP.RECON_CODE,
         [custody_recon::Store]RCN_DEPOT_ROLLUP.COB_DATE,
         [custody_recon::Store]RCN_DEPOT_ROLLUP.INSTITUTION_ID,
         [custody_recon::Store]RCN_DEPOT_ROLLUP.ACCOUNT_NO,
         [custody_recon::Store]RCN_DEPOT_ROLLUP.INSTRUMENT_ID
      )
      ~mainTable [custody_recon::Store]RCN_DEPOT_ROLLUP
      reconCode: [custody_recon::Store]RCN_DEPOT_ROLLUP.RECON_CODE,
      cobDate: [custody_recon::Store]RCN_DEPOT_ROLLUP.COB_DATE,
      institutionId: [custody_recon::Store]RCN_DEPOT_ROLLUP.INSTITUTION_ID,
      accountNo: [custody_recon::Store]RCN_DEPOT_ROLLUP.ACCOUNT_NO,
      instrumentId: [custody_recon::Store]RCN_DEPOT_ROLLUP.INSTRUMENT_ID,
      depotCount: [custody_recon::Store]RCN_DEPOT_ROLLUP.DEPOT_COUNT,
      totalCustodyQuantity: [custody_recon::Store]RCN_DEPOT_ROLLUP.TOTAL_CUSTODY_QUANTITY,
      totalInternalQuantity: [custody_recon::Store]RCN_DEPOT_ROLLUP.TOTAL_INTERNAL_QUANTITY,
      netDifference: [custody_recon::Store]RCN_DEPOT_ROLLUP.NET_DIFFERENCE,
      largestDepotQuantity: [custody_recon::Store]RCN_DEPOT_ROLLUP.LARGEST_DEPOT_QUANTITY,
      line[rcnLine]: [custody_recon::Store]@Rcn_LineDepotRollup,
      items[rcnItem]: [custody_recon::Store]@Rcn_ItemDepotRollup,
      position[pkPosition]: [custody_recon::Store]@Rcn_RollupPosition
   }

