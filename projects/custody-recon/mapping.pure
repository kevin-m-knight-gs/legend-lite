      bandOrder: [custody_recon::Store]RCN_AGEING_BAND.BAND_ORDER,
      definition[rcnDefinition]: [custody_recon::Store]@Rcn_DefinitionAgeingBands,
      breaks[rcnBreak]: [custody_recon::Store]@Rcn_BreakAgeingBand
   }

   // Three key columns: a day is reconciled more than once.
   custody_recon::ReconRun[rcnRun]: Relational
   {
      ~primaryKey
      (
         [custody_recon::Store]RCN_RUN.RECON_CODE,
         [custody_recon::Store]RCN_RUN.COB_DATE,
         [custody_recon::Store]RCN_RUN.RUN_SEQ
      )
      ~mainTable [custody_recon::Store]RCN_RUN
      reconCode: [custody_recon::Store]RCN_RUN.RECON_CODE,
      cobDate: [custody_recon::Store]RCN_RUN.COB_DATE,
      runSeq: [custody_recon::Store]RCN_RUN.RUN_SEQ,
      runType: [custody_recon::Store]RCN_RUN.RUN_TYPE,
      runStatus: [custody_recon::Store]RCN_RUN.RUN_STATUS,
      startedOn: [custody_recon::Store]RCN_RUN.STARTED_ON,
      completedOn: [custody_recon::Store]RCN_RUN.COMPLETED_ON,
      lineCount: [custody_recon::Store]RCN_RUN.LINE_COUNT,
      itemCount: [custody_recon::Store]RCN_RUN.ITEM_COUNT,
      matchedCount: [custody_recon::Store]RCN_RUN.MATCHED_COUNT,
      breakCount: [custody_recon::Store]RCN_RUN.BREAK_COUNT,
      triggeredBy: [custody_recon::Store]RCN_RUN.TRIGGERED_BY,
      definition[rcnDefinition]: [custody_recon::Store]@Rcn_DefinitionRuns,
      lines[rcnLine]: [custody_recon::Store]@Rcn_RunLines,
      items[rcnItem]: [custody_recon::Store]@Rcn_RunItems
   }

   // FIVE key columns -- the position's four with the recon code in front. Its `position`
   // mapping is a four-column join that never mentions a depot.
   custody_recon::ReconLine[rcnLine]: Relational
   {
      ~primaryKey
      (
         [custody_recon::Store]RCN_LINE.RECON_CODE,
         [custody_recon::Store]RCN_LINE.COB_DATE,
         [custody_recon::Store]RCN_LINE.INSTITUTION_ID,
         [custody_recon::Store]RCN_LINE.ACCOUNT_NO,
         [custody_recon::Store]RCN_LINE.INSTRUMENT_ID
      )
      ~mainTable [custody_recon::Store]RCN_LINE
      reconCode: [custody_recon::Store]RCN_LINE.RECON_CODE,
      cobDate: [custody_recon::Store]RCN_LINE.COB_DATE,
      institutionId: [custody_recon::Store]RCN_LINE.INSTITUTION_ID,
      accountNo: [custody_recon::Store]RCN_LINE.ACCOUNT_NO,
      instrumentId: [custody_recon::Store]RCN_LINE.INSTRUMENT_ID,
      runSeq: [custody_recon::Store]RCN_LINE.RUN_SEQ,
      depotCount: [custody_recon::Store]RCN_LINE.DEPOT_COUNT,
      custodyQuantity: [custody_recon::Store]RCN_LINE.CUSTODY_QUANTITY,
      internalQuantity: [custody_recon::Store]RCN_LINE.INTERNAL_QUANTITY,
      differenceQuantity: [custody_recon::Store]RCN_LINE.DIFFERENCE_QUANTITY,
      differenceValue: [custody_recon::Store]RCN_LINE.DIFFERENCE_VALUE,
      priceCurrency: [custody_recon::Store]RCN_LINE.PRICE_CURRENCY,
      quantityUnit: [custody_recon::Store]RCN_LINE.QUANTITY_UNIT,
      lineStatus: [custody_recon::Store]RCN_LINE.LINE_STATUS,
      isWithinTolerance: [custody_recon::Store]RCN_LINE.IS_WITHIN_TOLERANCE,
      matchedOn: [custody_recon::Store]RCN_LINE.MATCHED_ON,
      run[rcnRun]: [custody_recon::Store]@Rcn_RunLines,
      items[rcnItem]: [custody_recon::Store]@Rcn_LineItems,
      // CROSS-PROJECT, into position-keeping.
      position[pkPosition]: [custody_recon::Store]@Rcn_LinePosition,
      movementTotal[pkMovementTotal]: [custody_recon::Store]@Rcn_LineMovementTotal,
      ladder[pkSettlementLadderEntry]: [custody_recon::Store]@Rcn_LineLadder,
      rollup[rcnDepotRollup]: [custody_recon::Store]@Rcn_LineDepotRollup,
      accountTotal[rcnAccountReconTotal]: [custody_recon::Store]@Rcn_LineAccountTotal
   }

   // THE ROOT, and the six-column composite key. Look at the last three property mappings
   // together: `holding` is a four-column join with no date, `position` is a four-column
   // join with no depot, and `custodianStatement` is a five-column join that spends this
   // project's COB_DATE against the custodian's STATEMENT_DATE. One row, three different
   // ways of being identified, which is why its own key has to be the union of them.
   *custody_recon::ReconItem[rcnItem]: Relational
   {
      ~primaryKey
      (
         [custody_recon::Store]RCN_ITEM.RECON_CODE,
         [custody_recon::Store]RCN_ITEM.COB_DATE,
         [custody_recon::Store]RCN_ITEM.INSTITUTION_ID,
         [custody_recon::Store]RCN_ITEM.ACCOUNT_NO,
         [custody_recon::Store]RCN_ITEM.INSTRUMENT_ID,
         [custody_recon::Store]RCN_ITEM.DEPOT_CODE
      )
      ~mainTable [custody_recon::Store]RCN_ITEM
      reconCode: [custody_recon::Store]RCN_ITEM.RECON_CODE,
      cobDate: [custody_recon::Store]RCN_ITEM.COB_DATE,
      institutionId: [custody_recon::Store]RCN_ITEM.INSTITUTION_ID,
      accountNo: [custody_recon::Store]RCN_ITEM.ACCOUNT_NO,
      instrumentId: [custody_recon::Store]RCN_ITEM.INSTRUMENT_ID,
      depotCode: [custody_recon::Store]RCN_ITEM.DEPOT_CODE,
      runSeq: [custody_recon::Store]RCN_ITEM.RUN_SEQ,
      custodyQuantity: [custody_recon::Store]RCN_ITEM.CUSTODY_QUANTITY,
      custodySettledQuantity: [custody_recon::Store]RCN_ITEM.CUSTODY_SETTLED_QUANTITY,
      internalQuantity: [custody_recon::Store]RCN_ITEM.INTERNAL_QUANTITY,
      internalSettledQuantity: [custody_recon::Store]RCN_ITEM.INTERNAL_SETTLED_QUANTITY,
      differenceQuantity: [custody_recon::Store]RCN_ITEM.DIFFERENCE_QUANTITY,
      allocationBasis: [custody_recon::Store]RCN_ITEM.ALLOCATION_BASIS,
      allocationRatio: [custody_recon::Store]RCN_ITEM.ALLOCATION_RATIO,
      matchStatus: [custody_recon::Store]RCN_ITEM.MATCH_STATUS,
      hasCustodySide: [custody_recon::Store]RCN_ITEM.HAS_CUSTODY_SIDE,
      hasInternalSide: [custody_recon::Store]RCN_ITEM.HAS_INTERNAL_SIDE,
      toleranceScope: [custody_recon::Store]RCN_ITEM.TOLERANCE_SCOPE,
      toleranceCode: [custody_recon::Store]RCN_ITEM.TOLERANCE_CODE,
      matchedOn: [custody_recon::Store]RCN_ITEM.MATCHED_ON,
      line[rcnLine]: [custody_recon::Store]@Rcn_LineItems,
      run[rcnRun]: [custody_recon::Store]@Rcn_RunItems,
      breaks[rcnBreak]: [custody_recon::Store]@Rcn_ItemBreaks,
      toleranceRule[rcnToleranceRule]: [custody_recon::Store]@Rcn_ItemToleranceRule,
      rollup[rcnDepotRollup]: [custody_recon::Store]@Rcn_ItemDepotRollup,
      // CROSS-PROJECT, custody side: four columns, no date.
      holding[cstHolding]: [custody_recon::Store]@Rcn_ItemHolding,
      depot[cstDepot]: [custody_recon::Store]@Rcn_ItemDepot,
      pendingMovements[cstPendingMovement]: [custody_recon::Store]@Rcn_ItemPendingMovements,
      custodianStatement[cstStatementLine]: [custody_recon::Store]@Rcn_ItemStatementLine,
      // CROSS-PROJECT, internal side: four columns, no depot.
      position[pkPosition]: [custody_recon::Store]@Rcn_ItemPosition
   }

