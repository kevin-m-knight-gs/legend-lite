      addOnAmount: [margin_calc::Store]MGN_POSITION_MARGIN.ADDON_AMOUNT,
      marginCurrency: [margin_calc::Store]MGN_POSITION_MARGIN.MARGIN_CURRENCY,
      riskWeight: [margin_calc::Store]MGN_POSITION_MARGIN.RISK_WEIGHT,
      isMarginEligible: [margin_calc::Store]MGN_POSITION_MARGIN.IS_MARGIN_ELIGIBLE,
      // CROSS-PROJECT. position-keeping's set id, on all four columns.
      position[pkPosition]: [margin_calc::Store]@Mgn_PositionMarginPosition,
      portfolio[mgnMarginPortfolio]: [margin_calc::Store]@Mgn_PortfolioPositionMargins,
      portfolioTotal[mgnPortfolioMarginTotal]: [margin_calc::Store]@Mgn_PositionMarginPortfolioTotal
   }

   // ------------------------------------------------------------ the aggregate sets
   //
   // Rooted on views. The ~primaryKey IS the ~groupBy, so an instance is a group.

   margin_calc::MgnPortfolioMarginTotal[mgnPortfolioMarginTotal]: Relational
   {
      ~primaryKey
      (
         [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL.MARGIN_PORTFOLIO_ID,
         [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL.COB_DATE
      )
      ~mainTable [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL
      marginPortfolioId: [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL.MARGIN_PORTFOLIO_ID,
      cobDate: [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL.COB_DATE,
      positionCount: [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL.POSITION_COUNT,
      totalInitialMargin: [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL.TOTAL_INITIAL_MARGIN,
      totalVariationMargin: [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL.TOTAL_VARIATION_MARGIN,
      totalAddOn: [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL.TOTAL_ADDON,
      totalExposure: [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL.TOTAL_EXPOSURE,
      largestPositionMargin: [margin_calc::Store]MGN_PORTFOLIO_MARGIN_TOTAL.LARGEST_POSITION_MARGIN,
      portfolio[mgnMarginPortfolio]: [margin_calc::Store]@Mgn_PortfolioMarginTotals,
      positionMargins[mgnPositionMargin]: [margin_calc::Store]@Mgn_PositionMarginPortfolioTotal
   }

   margin_calc::MgnRiskClassSensitivityTotal[mgnRiskClassSensTotal]: Relational
   {
      ~primaryKey
      (
         [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL.MARGIN_PORTFOLIO_ID,
         [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL.COB_DATE,
         [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL.RISK_CLASS
      )
      ~mainTable [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL
      marginPortfolioId: [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL.MARGIN_PORTFOLIO_ID,
      cobDate: [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL.COB_DATE,
      riskClass: [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL.RISK_CLASS,
      sensitivityCount: [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL.SENSITIVITY_COUNT,
      totalWeightedSensitivity: [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL.TOTAL_WEIGHTED_SENSITIVITY,
      totalRawSensitivity: [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL.TOTAL_RAW_SENSITIVITY,
      largestWeightedSensitivity: [margin_calc::Store]MGN_RISK_CLASS_SENS_TOTAL.LARGEST_WEIGHTED_SENSITIVITY,
      riskClassMargin[mgnRiskClassMargin]: [margin_calc::Store]@Mgn_RiskClassMarginSensTotal,
      sensitivities[mgnSimmSensitivity]: [margin_calc::Store]@Mgn_SensitivityRiskClassTotal
   }
)
