###Mapping
// The margin-calc mapping. It INCLUDES both upstream mappings, so the sets this project's
// joins land on -- `pkPosition` for a position, `rskPortfolio`, `rskSensitivity`,
// `rskFactor` and `rskFactorTotal` for the risk side -- already exist and are not redefined
// here. Both dependencies give every set an EXPLICIT id, which means the default ids
// (`position_keeping_Position`, `risk_core_RskSensitivity`) do not exist to fall back on
// and every cross-project property mapping below has to name the real one.
//
// This is a DIAMOND: core-instrument's mapping arrives twice, once through each dependency,
// and must resolve to one set of sets.
//
// The last two sets are rooted on VIEWS. Their ~primaryKey is the view's ~groupBy, which is
// what makes one instance a GROUP and not a row.
Mapping margin_calc::Mapping
(
   include position_keeping::Mapping
   include risk_core::Mapping

   margin_calc::MgnMarginAgreement[mgnAgreement]: Relational
   {
      ~primaryKey
      (
         [margin_calc::Store]MGN_AGREEMENT.AGREEMENT_ID
      )
      ~mainTable [margin_calc::Store]MGN_AGREEMENT
      agreementId: [margin_calc::Store]MGN_AGREEMENT.AGREEMENT_ID,
      agreementType: [margin_calc::Store]MGN_AGREEMENT.AGREEMENT_TYPE,
      counterpartyId: [margin_calc::Store]MGN_AGREEMENT.COUNTERPARTY_ID,
      institutionId: [margin_calc::Store]MGN_AGREEMENT.INSTITUTION_ID,
      baseCurrency: [margin_calc::Store]MGN_AGREEMENT.BASE_CURRENCY,
      threshold: [margin_calc::Store]MGN_AGREEMENT.THRESHOLD,
      minimumTransferAmount: [margin_calc::Store]MGN_AGREEMENT.MINIMUM_TRANSFER_AMOUNT,
      roundingAmount: [margin_calc::Store]MGN_AGREEMENT.ROUNDING_AMOUNT,
      independentAmount: [margin_calc::Store]MGN_AGREEMENT.INDEPENDENT_AMOUNT,
      marginCallFrequency: [margin_calc::Store]MGN_AGREEMENT.MARGIN_CALL_FREQUENCY,
      closeOutPeriodDays: [margin_calc::Store]MGN_AGREEMENT.CLOSE_OUT_PERIOD_DAYS,
      confidencePct: [margin_calc::Store]MGN_AGREEMENT.CONFIDENCE_PCT,
      isBilateral: [margin_calc::Store]MGN_AGREEMENT.IS_BILATERAL,
      imMethod: [margin_calc::Store]MGN_AGREEMENT.IM_METHOD,
      effectiveFrom: [margin_calc::Store]MGN_AGREEMENT.EFFECTIVE_FROM,
      terminatedOn: [margin_calc::Store]MGN_AGREEMENT.TERMINATED_ON,
      calls[mgnMarginCall]: [margin_calc::Store]@Mgn_AgreementCalls,
      variationMargins[mgnVariationMargin]: [margin_calc::Store]@Mgn_AgreementVariationMargins,
      haircuts[mgnCollateralHaircut]: [margin_calc::Store]@Mgn_AgreementHaircuts,
      portfolios[mgnMarginPortfolio]: [margin_calc::Store]@Mgn_AgreementPortfolios
   }

   // The netting set, and the two cross-project property mappings that make it one.
   margin_calc::MgnMarginPortfolio[mgnMarginPortfolio]: Relational
   {
      ~primaryKey
      (
         [margin_calc::Store]MGN_MARGIN_PORTFOLIO.MARGIN_PORTFOLIO_ID
      )
      ~mainTable [margin_calc::Store]MGN_MARGIN_PORTFOLIO
      marginPortfolioId: [margin_calc::Store]MGN_MARGIN_PORTFOLIO.MARGIN_PORTFOLIO_ID,
      agreementId: [margin_calc::Store]MGN_MARGIN_PORTFOLIO.AGREEMENT_ID,
      riskPortfolioId: [margin_calc::Store]MGN_MARGIN_PORTFOLIO.RISK_PORTFOLIO_ID,
      institutionId: [margin_calc::Store]MGN_MARGIN_PORTFOLIO.INSTITUTION_ID,
      accountNo: [margin_calc::Store]MGN_MARGIN_PORTFOLIO.ACCOUNT_NO,
      baseCurrency: [margin_calc::Store]MGN_MARGIN_PORTFOLIO.BASE_CURRENCY,
      imMethod: [margin_calc::Store]MGN_MARGIN_PORTFOLIO.IM_METHOD,
      isSegregated: [margin_calc::Store]MGN_MARGIN_PORTFOLIO.IS_SEGREGATED,
      nettingSetCode: [margin_calc::Store]MGN_MARGIN_PORTFOLIO.NETTING_SET_CODE,
      agreement[mgnAgreement]: [margin_calc::Store]@Mgn_AgreementPortfolios,
      // CROSS-PROJECT. risk-core's set id, not a default one.
      riskPortfolio[rskPortfolio]: [margin_calc::Store]@Mgn_PortfolioRiskPortfolio,
      initialMargins[mgnInitialMargin]: [margin_calc::Store]@Mgn_PortfolioInitialMargins,
      riskClassMargins[mgnRiskClassMargin]: [margin_calc::Store]@Mgn_PortfolioRiskClassMargins,
      simmSensitivities[mgnSimmSensitivity]: [margin_calc::Store]@Mgn_PortfolioSimmSensitivities,
      positionMargins[mgnPositionMargin]: [margin_calc::Store]@Mgn_PortfolioPositionMargins,
      concentrationAddOns[mgnConcentrationAddOn]: [margin_calc::Store]@Mgn_PortfolioConcentrationAddOns,
      liquidityAddOns[mgnLiquidityAddOn]: [margin_calc::Store]@Mgn_PortfolioLiquidityAddOns,
      marginTotals[mgnPortfolioMarginTotal]: [margin_calc::Store]@Mgn_PortfolioMarginTotals
   }

