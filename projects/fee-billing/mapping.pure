      amount: [fee_billing::Store]BIL_ADJUSTMENT.AMOUNT,
      reason: [fee_billing::Store]BIL_ADJUSTMENT.REASON,
      raisedBy: [fee_billing::Store]BIL_ADJUSTMENT.RAISED_BY,
      approvedBy: [fee_billing::Store]BIL_ADJUSTMENT.APPROVED_BY,
      raisedOn: [fee_billing::Store]BIL_ADJUSTMENT.RAISED_ON,
      postedOn: [fee_billing::Store]BIL_ADJUSTMENT.POSTED_ON,
      invoice[bilInvoice]: [fee_billing::Store]@Bil_InvoiceAdjustments,
      line[bilInvoiceLine]: [fee_billing::Store]@Bil_LineAdjustments
   }

   fee_billing::BilDispute[bilDispute]: Relational
   {
      ~primaryKey ( [fee_billing::Store]BIL_DISPUTE.DISPUTE_ID )
      ~mainTable [fee_billing::Store]BIL_DISPUTE
      disputeId: [fee_billing::Store]BIL_DISPUTE.DISPUTE_ID,
      invoiceId: [fee_billing::Store]BIL_DISPUTE.INVOICE_ID,
