      resolvedOn: [fee_billing::Store]BIL_DISPUTE.RESOLVED_ON,
      creditId: [fee_billing::Store]BIL_DISPUTE.CREDIT_ID,
      invoice[bilInvoice]: [fee_billing::Store]@Bil_InvoiceDisputes,
      line[bilInvoiceLine]: [fee_billing::Store]@Bil_LineDisputes
   }

   // -------------------------------------------------------------- the AGGREGATE sets
   //
   // Rooted on the three views. The primary key IS the ~groupBy, so an instance is a group.

   fee_billing::BilInvoiceTotal[bilInvoiceTotal]: Relational
   {
      ~primaryKey ( [fee_billing::Store]BIL_INVOICE_TOTAL.INVOICE_ID )
      ~mainTable [fee_billing::Store]BIL_INVOICE_TOTAL
      invoiceId: [fee_billing::Store]BIL_INVOICE_TOTAL.INVOICE_ID,
      lineCount: [fee_billing::Store]BIL_INVOICE_TOTAL.LINE_COUNT,
      totalBillable: [fee_billing::Store]BIL_INVOICE_TOTAL.TOTAL_BILLABLE,
      totalGross: [fee_billing::Store]BIL_INVOICE_TOTAL.TOTAL_GROSS,
      totalDiscount: [fee_billing::Store]BIL_INVOICE_TOTAL.TOTAL_DISCOUNT,
      totalNet: [fee_billing::Store]BIL_INVOICE_TOTAL.TOTAL_NET,
      largestLineNet: [fee_billing::Store]BIL_INVOICE_TOTAL.LARGEST_LINE_NET,
      invoice[bilInvoice]: [fee_billing::Store]@Bil_InvoiceTotal
   }

   fee_billing::BilRunTotal[bilRunTotal]: Relational
   {
      ~primaryKey ( [fee_billing::Store]BIL_RUN_TOTAL.RUN_ID )
      ~mainTable [fee_billing::Store]BIL_RUN_TOTAL
      runId: [fee_billing::Store]BIL_RUN_TOTAL.RUN_ID,
      invoiceCount: [fee_billing::Store]BIL_RUN_TOTAL.INVOICE_COUNT,
      totalTax: [fee_billing::Store]BIL_RUN_TOTAL.TOTAL_TAX,
      totalDue: [fee_billing::Store]BIL_RUN_TOTAL.TOTAL_DUE,
      totalMinimumTopUp: [fee_billing::Store]BIL_RUN_TOTAL.TOTAL_MINIMUM_TOP_UP,
      totalCapReduction: [fee_billing::Store]BIL_RUN_TOTAL.TOTAL_CAP_REDUCTION,
      run[bilRun]: [fee_billing::Store]@Bil_RunTotal
   }

   // Two key columns: the grain is (invoice, fee type).
   fee_billing::BilFeeTypeTotal[bilFeeTypeTotal]: Relational
   {
      ~primaryKey
      (
         [fee_billing::Store]BIL_FEE_TYPE_TOTAL.INVOICE_ID,
         [fee_billing::Store]BIL_FEE_TYPE_TOTAL.FEE_TYPE_CODE
      )
      ~mainTable [fee_billing::Store]BIL_FEE_TYPE_TOTAL
      invoiceId: [fee_billing::Store]BIL_FEE_TYPE_TOTAL.INVOICE_ID,
      feeTypeCode: [fee_billing::Store]BIL_FEE_TYPE_TOTAL.FEE_TYPE_CODE,
      lineCount: [fee_billing::Store]BIL_FEE_TYPE_TOTAL.LINE_COUNT,
      totalGross: [fee_billing::Store]BIL_FEE_TYPE_TOTAL.TOTAL_GROSS,
      totalNet: [fee_billing::Store]BIL_FEE_TYPE_TOTAL.TOTAL_NET,
      invoice[bilInvoice]: [fee_billing::Store]@Bil_InvoiceFeeTypeTotal,
      feeType[bilFeeType]: [fee_billing::Store]@Bil_FeeTypeTotalFeeType
   }
)
