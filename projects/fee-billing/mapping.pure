      raisedOn: [fee_billing::Store]BIL_DISPUTE.RAISED_ON,
      raisedBy: [fee_billing::Store]BIL_DISPUTE.RAISED_BY,
      disputedAmount: [fee_billing::Store]BIL_DISPUTE.DISPUTED_AMOUNT,
      disputeStatus: [fee_billing::Store]BIL_DISPUTE.DISPUTE_STATUS,
