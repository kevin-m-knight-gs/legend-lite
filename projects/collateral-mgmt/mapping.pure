###Mapping
// ============================================================
// collateral_mgmt::Mapping -- 14 class sets, 21 association mappings
// ============================================================
// It INCLUDES both dependency mappings, because the cross-project association mappings at the
// bottom name set ids that live in them -- `copPostingPlan`, `copInventoryLot`,
// `copSubstitutionProposal` from collateral-opt, and `netSet`, `netCapitalTreatment` from
// legal-netting. Those projects declared their ids explicitly, so the default ids
// (`collateral_opt_CopPostingPlan`, `legal_netting_NetSet`) DO NOT EXIST and every cross-project
// end names [source, target] rather than the bare `prop: [db]@Join` form.
//
// Both included mappings pull in collateral_core::Mapping -- collateral-opt directly,
// legal-netting through exposure_agg::Mapping -- so this is a DIAMOND and the `col*` sets
// resolve once.
//
// Every set id here is prefixed `cmg`, since set ids are a GLOBAL namespace in Legend and one
// collision fails the whole graph with a message naming the id and not the project.
Mapping collateral_mgmt::Mapping
(
   include collateral_opt::Mapping
   include legal_netting::Mapping

   collateral_mgmt::CmgMarginTerms[cmgMarginTerms]: Relational
   {
      ~primaryKey ( [collateral_mgmt::Store]CMG_MARGIN_TERMS.TERMS_ID )
      ~mainTable [collateral_mgmt::Store]CMG_MARGIN_TERMS
      termsId: [collateral_mgmt::Store]CMG_MARGIN_TERMS.TERMS_ID,
      agreementId: [collateral_mgmt::Store]CMG_MARGIN_TERMS.AGREEMENT_ID,
      nettingSetId: [collateral_mgmt::Store]CMG_MARGIN_TERMS.NETTING_SET_ID,
      marginType: [collateral_mgmt::Store]CMG_MARGIN_TERMS.MARGIN_TYPE,
      baseCurrency: [collateral_mgmt::Store]CMG_MARGIN_TERMS.BASE_CURRENCY,
      thresholdAmount: [collateral_mgmt::Store]CMG_MARGIN_TERMS.THRESHOLD_AMOUNT,
      minimumTransferAmount: [collateral_mgmt::Store]CMG_MARGIN_TERMS.MINIMUM_TRANSFER_AMOUNT,
      roundingIncrement: [collateral_mgmt::Store]CMG_MARGIN_TERMS.ROUNDING_INCREMENT,
      independentAmount: [collateral_mgmt::Store]CMG_MARGIN_TERMS.INDEPENDENT_AMOUNT,
      callFrequency: [collateral_mgmt::Store]CMG_MARGIN_TERMS.CALL_FREQUENCY,
      notificationTime: [collateral_mgmt::Store]CMG_MARGIN_TERMS.NOTIFICATION_TIME,
      substitutionConsentRequired: [collateral_mgmt::Store]CMG_MARGIN_TERMS.SUBSTITUTION_CONSENT_REQUIRED,
      effectiveDate: [collateral_mgmt::Store]CMG_MARGIN_TERMS.EFFECTIVE_DATE,
      terminatedDate: [collateral_mgmt::Store]CMG_MARGIN_TERMS.TERMINATED_DATE
   }

   // The threshold and the MTA are mapped as APPLIED values on the call, not read through the
   // terms set. Two columns, two different tests, and the second is the one that decides
   // whether anything is sent.
   collateral_mgmt::CmgMarginCall[cmgMarginCall]: Relational
   {
      ~primaryKey ( [collateral_mgmt::Store]CMG_MARGIN_CALL.CALL_ID )
      ~mainTable [collateral_mgmt::Store]CMG_MARGIN_CALL
      callId: [collateral_mgmt::Store]CMG_MARGIN_CALL.CALL_ID,
      cobDate: [collateral_mgmt::Store]CMG_MARGIN_CALL.COB_DATE,
      nettingSetId: [collateral_mgmt::Store]CMG_MARGIN_CALL.NETTING_SET_ID,
      agreementId: [collateral_mgmt::Store]CMG_MARGIN_CALL.AGREEMENT_ID,
      termsId: [collateral_mgmt::Store]CMG_MARGIN_CALL.TERMS_ID,
      planId: [collateral_mgmt::Store]CMG_MARGIN_CALL.PLAN_ID,
      direction: [collateral_mgmt::Store]CMG_MARGIN_CALL.DIRECTION,
      exposureAmount: [collateral_mgmt::Store]CMG_MARGIN_CALL.EXPOSURE_AMOUNT,
      collateralHeldValue: [collateral_mgmt::Store]CMG_MARGIN_CALL.COLLATERAL_HELD_VALUE,
      thresholdApplied: [collateral_mgmt::Store]CMG_MARGIN_CALL.THRESHOLD_APPLIED,
      mtaApplied: [collateral_mgmt::Store]CMG_MARGIN_CALL.MTA_APPLIED,
      creditSupportAmount: [collateral_mgmt::Store]CMG_MARGIN_CALL.CREDIT_SUPPORT_AMOUNT,
      roundedCallAmount: [collateral_mgmt::Store]CMG_MARGIN_CALL.ROUNDED_CALL_AMOUNT,
      callCurrency: [collateral_mgmt::Store]CMG_MARGIN_CALL.CALL_CURRENCY,
      callStatus: [collateral_mgmt::Store]CMG_MARGIN_CALL.CALL_STATUS,
      issuedAt: [collateral_mgmt::Store]CMG_MARGIN_CALL.ISSUED_AT,
      responseDeadline: [collateral_mgmt::Store]CMG_MARGIN_CALL.RESPONSE_DEADLINE,
      isBelowMta: [collateral_mgmt::Store]CMG_MARGIN_CALL.IS_BELOW_MTA,
      closedOn: [collateral_mgmt::Store]CMG_MARGIN_CALL.CLOSED_ON
   }

