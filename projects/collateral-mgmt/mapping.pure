      raisedBySide: [collateral_mgmt::Store]CMG_CALL_EVENT.RAISED_BY_SIDE,
      actor: [collateral_mgmt::Store]CMG_CALL_EVENT.ACTOR,
      eventNote: [collateral_mgmt::Store]CMG_CALL_EVENT.EVENT_NOTE
   }

