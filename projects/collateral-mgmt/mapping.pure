   // ---- the aggregation, mapped over the ~groupBy view ---------------------------------------
   // The grouping columns are the key. Nothing is materialised: the engine folds the GROUP BY
   // into the SQL when the class is queried.
   collateral_mgmt::CmgDisputeDaySummary[cmgDisputeDaySummary]: Relational
   {
      ~primaryKey
      (
         [collateral_mgmt::Store]CMG_DISPUTE_DAY_SUMMARY.COB_DATE,
         [collateral_mgmt::Store]CMG_DISPUTE_DAY_SUMMARY.DISPUTE_STATUS
      )
      ~mainTable [collateral_mgmt::Store]CMG_DISPUTE_DAY_SUMMARY
      cobDate: [collateral_mgmt::Store]CMG_DISPUTE_DAY_SUMMARY.COB_DATE,
      disputeStatus: [collateral_mgmt::Store]CMG_DISPUTE_DAY_SUMMARY.DISPUTE_STATUS,
      disputeCount: [collateral_mgmt::Store]CMG_DISPUTE_DAY_SUMMARY.DISPUTE_COUNT,
      totalDisputed: [collateral_mgmt::Store]CMG_DISPUTE_DAY_SUMMARY.TOTAL_DISPUTED,
      totalUndisputed: [collateral_mgmt::Store]CMG_DISPUTE_DAY_SUMMARY.TOTAL_UNDISPUTED,
      largestDisputed: [collateral_mgmt::Store]CMG_DISPUTE_DAY_SUMMARY.LARGEST_DISPUTED
   }

   // ---- THE OR-JOIN -----------------------------------------------------------------------------
   // Both ends read the same disjunctive join, from opposite sides.
   collateral_mgmt::CmgApplicableCashRates: Relational
   {
      AssociationMapping
      (
         applicableRates[cmgCashBalance, cmgCashRateSchedule]: [collateral_mgmt::Store]@Cmg_BalanceCashRate,
         ratedBalances[cmgCashRateSchedule, cmgCashBalance]: [collateral_mgmt::Store]@Cmg_BalanceCashRate
      )
   }

