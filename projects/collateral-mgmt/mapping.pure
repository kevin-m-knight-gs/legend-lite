   // The dispute against its own daily rollup. Two-column join both ways.
   collateral_mgmt::CmgDisputeSummaryLink: Relational
   {
      AssociationMapping
      (
         daySummary[cmgDispute, cmgDisputeDaySummary]: [collateral_mgmt::Store]@Cmg_DisputeDaySummary,
         disputesInDay[cmgDisputeDaySummary, cmgDispute]: [collateral_mgmt::Store]@Cmg_DisputeDaySummary
      )
   }

   // ---- across the boundary into collateral-opt ------------------------------------------------
   // Every end names the DEPENDENCY's explicit set id -- `copPostingPlan`, `copInventoryLot`,
   // `copSubstitutionProposal` -- because that project declared its ids and the defaults do not
   // exist.
   collateral_mgmt::CmgCallFundingPlan: Relational
   {
      AssociationMapping
      (
         fundingPlan[cmgMarginCall, copPostingPlan]: [collateral_mgmt::Store]@Cmg_CallFundingPlan,
         answeredCalls[copPostingPlan, cmgMarginCall]: [collateral_mgmt::Store]@Cmg_CallFundingPlan
      )
   }

   collateral_mgmt::CmgMovementLot: Relational
   {
      AssociationMapping
      (
         deliveredLot[cmgMovement, copInventoryLot]: [collateral_mgmt::Store]@Cmg_MovementLot,
         deliveringMovements[copInventoryLot, cmgMovement]: [collateral_mgmt::Store]@Cmg_MovementLot
      )
   }

   collateral_mgmt::CmgSubstitutionProposalLink: Relational
   {
      AssociationMapping
      (
         optimiserProposal[cmgSubstitution, copSubstitutionProposal]: [collateral_mgmt::Store]@Cmg_SubstitutionProposal,
         substitutionRequests[copSubstitutionProposal, cmgSubstitution]: [collateral_mgmt::Store]@Cmg_SubstitutionProposal
      )
   }

   // ---- across the boundary into legal-netting -------------------------------------------------
   // `netSet` and `netCapitalTreatment` are legal-netting's explicit ids.
   collateral_mgmt::CmgCallNettingSet: Relational
   {
      AssociationMapping
      (
         nettingSet[cmgMarginCall, netSet]: [collateral_mgmt::Store]@Cmg_CallNettingSet,
         marginCalls[netSet, cmgMarginCall]: [collateral_mgmt::Store]@Cmg_CallNettingSet
      )
   }

   collateral_mgmt::CmgTermsNettingSet: Relational
   {
      AssociationMapping
      (
         securedSet[cmgMarginTerms, netSet]: [collateral_mgmt::Store]@Cmg_TermsNettingSet,
         marginTerms[netSet, cmgMarginTerms]: [collateral_mgmt::Store]@Cmg_TermsNettingSet
      )
   }

   collateral_mgmt::CmgBalanceNettingSet: Relational
   {
      AssociationMapping
      (
         collateralisedSet[cmgCashBalance, netSet]: [collateral_mgmt::Store]@Cmg_BalanceNettingSet,
         cashBalances[netSet, cmgCashBalance]: [collateral_mgmt::Store]@Cmg_BalanceNettingSet
      )
   }

   // Two-column join, (set, date).
   collateral_mgmt::CmgCallCapitalTreatment: Relational
   {
      AssociationMapping
      (
         capitalTreatment[cmgMarginCall, netCapitalTreatment]: [collateral_mgmt::Store]@Cmg_CallCapitalTreatment,
         marginCallsRaised[netCapitalTreatment, cmgMarginCall]: [collateral_mgmt::Store]@Cmg_CallCapitalTreatment
      )
   }
)
