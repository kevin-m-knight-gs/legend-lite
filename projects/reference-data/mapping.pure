      ~mainTable [reference_data::Store]RD_INSTRUMENT_RATING
      instrumentId: [reference_data::Store]RD_INSTRUMENT_RATING.INSTRUMENT_ID,
      agencyId: [reference_data::Store]RD_INSTRUMENT_RATING.AGENCY_ID,
