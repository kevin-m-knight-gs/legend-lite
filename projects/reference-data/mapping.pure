      isSolicited: [reference_data::Store]RD_INSTRUMENT_RATING.IS_SOLICITED,
      // Into the instrument master, naming core-instrument's ROOT set as the target.
      instrument[ciBase]: [reference_data::Store]@Rd_RatingInstrument,
      grade[rdRatingGrade]: [reference_data::Store]@Rd_RatingGrade
