###Mapping
// ============================================================
// reference_data::Mapping -- 30 sets, five of which are somebody else's table
// ============================================================
// Includes BOTH dependency mappings. Including core_instrument::Mapping is what makes
// `extends [ciBase]` resolvable at all: a set id is a global name, but a set may only be
// extended by a mapping that has the mapping declaring it in scope.
//
// Three kinds of set live here, and the first two are the point of the project:
//
//   CROSS-PROJECT SUBTYPES. Five sets whose class extends core_instrument::Instrument and
//   whose set extends core-instrument's ROOT set [ciBase]. Each adds one ~filter -- ours,
//   declared in reference_data::Store, over THEIR CI_INSTRUMENT -- and the columns that
//   only matter once a row is known to be in that universe. The primary key, the main
//   table and the twenty inherited property mappings all come from [ciBase]; none of them
//   is restated. An eligibility universe is a predicate over the master, and this says so
//   in three lines rather than in a nightly copy job.
//
//   ~DISTINCT SETS. rdIssuer and rdVenueUsage have no table of their own. They are the
//   DISTINCT values of a column pair on CI_INSTRUMENT, which is a real collapse: the master
//   carries ISSUER_NAME on every row, hundreds of instruments per issuer, so the set turns
//   a table of hundreds of thousands into a universe of thousands. ~primaryKey names the
//   collapsed columns and not the table's own INSTRUMENT_ID -- pointing it at the table PK
//   would leave one row per instrument and the ~distinct would collapse nothing.
//
//   OUR OWN TABLES. Twenty-three sets over RD_ tables.
//
// Every class-valued property names its TARGET set id -- `domicile[cgCountry]` -- rather
// than leaving it implicit. core-geo and core-instrument both name their set ids
// explicitly, so the default ids (`core_geo_CgCountry`) do not exist and the implicit form
// has nothing to resolve against.
Mapping reference_data::Mapping
(
   include core_instrument::Mapping
   include core_geo::Mapping

   // ================================================================================
   // 1. FIVE VIEWS OF THE INSTRUMENT MASTER
   //    class extends core_instrument::Instrument, set extends [ciBase], filter is ours
   // ================================================================================

   reference_data::RdListedInstrument[rdListed] extends [ciBase]: Relational
   {
      ~filter [reference_data::Store]RdListedRows
      venueMic: [core_instrument::Store]CI_INSTRUMENT.PRIMARY_EXCHANGE_MIC,
      boardLotSize: [core_instrument::Store]CI_INSTRUMENT.LOT_SIZE,
      admittedDate: [core_instrument::Store]CI_INSTRUMENT.LISTING_DATE
   }

   reference_data::RdRatedInstrument[rdRated] extends [ciBase]: Relational
   {
      ~filter [reference_data::Store]RdRatedRows
      masterRatingCode: [core_instrument::Store]CI_INSTRUMENT.CREDIT_RATING,
      ratedIssuerName: [core_instrument::Store]CI_INSTRUMENT.ISSUER_NAME,
      ratedCouponRate: [core_instrument::Store]CI_INSTRUMENT.COUPON_RATE
   }

   reference_data::RdIndexEligibleInstrument[rdIndexEligible] extends [ciBase]: Relational
   {
      ~filter [reference_data::Store]RdIndexEligibleRows
      freeFloatPct: [core_instrument::Store]CI_INSTRUMENT.FREE_FLOAT_PCT,
      issuedShareCount: [core_instrument::Store]CI_INSTRUMENT.SHARES_OUTSTANDING,
      sectorCode: [core_instrument::Store]CI_INSTRUMENT.GICS_SECTOR
   }

   reference_data::RdRestrictedInstrument[rdRestricted] extends [ciBase]: Relational
   {
      ~filter [reference_data::Store]RdRestrictedRows
      restrictedIssuerName: [core_instrument::Store]CI_INSTRUMENT.ISSUER_NAME,
      restrictedCountryCode: [core_instrument::Store]CI_INSTRUMENT.COUNTRY_OF_ISSUE
   }

   reference_data::RdSovereignIssue[rdSovereign] extends [ciBase]: Relational
   {
      ~filter [reference_data::Store]RdSovereignIssueRows
      sovereignName: [core_instrument::Store]CI_INSTRUMENT.ISSUING_SOVEREIGN,
      auctionDate: [core_instrument::Store]CI_INSTRUMENT.AUCTION_DATE,
      isInflationLinked: [core_instrument::Store]CI_INSTRUMENT.IS_INFLATION_LINKED
   }

   // ================================================================================
   // 2. THE ~DISTINCT SETS -- no table of their own
   // ================================================================================

   // The issuer universe. Many instruments, few issuers: this is the collapse.
   *reference_data::RdIssuer[rdIssuer]: Relational
   {
      ~distinct
      ~primaryKey ( [core_instrument::Store]CI_INSTRUMENT.ISSUER_NAME )
      ~mainTable [core_instrument::Store]CI_INSTRUMENT
      issuerName: [core_instrument::Store]CI_INSTRUMENT.ISSUER_NAME,
      domicileCountryCode: [core_instrument::Store]CI_INSTRUMENT.COUNTRY_OF_ISSUE
   }

   // The (venue, currency) pairs the master actually uses, as opposed to the venues static
   // data has onboarded. Same table, a different pair of columns, the same collapse.
   *reference_data::RdVenueUsage[rdVenueUsage]: Relational
   {
      ~distinct
      ~primaryKey ( [core_instrument::Store]CI_INSTRUMENT.PRIMARY_EXCHANGE_MIC )
      ~mainTable [core_instrument::Store]CI_INSTRUMENT
      venueMic: [core_instrument::Store]CI_INSTRUMENT.PRIMARY_EXCHANGE_MIC,
      settlementCurrency: [core_instrument::Store]CI_INSTRUMENT.CURRENCY
   }

   // ================================================================================
   // 3. OUR OWN TABLES
   // ================================================================================

   // ---- issuers -----------------------------------------------------------------------
   *reference_data::RdIssuerProfile[rdIssuerProfile]: Relational
   {
      ~primaryKey ( [reference_data::Store]RD_ISSUER.ISSUER_ID )
      ~mainTable [reference_data::Store]RD_ISSUER
      issuerId: [reference_data::Store]RD_ISSUER.ISSUER_ID,
      legalName: [reference_data::Store]RD_ISSUER.LEGAL_NAME,
      shortName: [reference_data::Store]RD_ISSUER.SHORT_NAME,
      domicileCountryCode: [reference_data::Store]RD_ISSUER.DOMICILE_COUNTRY_CODE,
      sectorCode: [reference_data::Store]RD_ISSUER.SECTOR_CODE,
      industryCode: [reference_data::Store]RD_ISSUER.INDUSTRY_CODE,
      isPubliclyTraded: [reference_data::Store]RD_ISSUER.IS_PUBLICLY_TRADED,
      isFinancialInstitution: [reference_data::Store]RD_ISSUER.IS_FINANCIAL_INSTITUTION,
      incorporationDate: [reference_data::Store]RD_ISSUER.INCORPORATION_DATE,
      dissolvedDate: [reference_data::Store]RD_ISSUER.DISSOLVED_DATE,

      // The core-geo dependency: one hop to the country, naming core-geo's set id.
      domicile[cgCountry]: [reference_data::Store]@Rd_IssuerCountry,
      // Three hops -- ours, then core-geo's two -- to a column on their third table. The
      // store qualifier is required on the first hop only; the pipe before the column is
      // not optional.
      domicileMacroRegionCode: [reference_data::Store]@Rd_IssuerCountry > @Cg_CountrySubRegion > @Cg_SubRegionMacroRegion | [core_geo::Store]CG_MACRO_REGION.CODE,

      identifiers[rdIssuerIdentifier]: [reference_data::Store]@Rd_IssuerIdentifier
   }

   *reference_data::RdIssuerIdentifier[rdIssuerIdentifier]: Relational
   {
      ~primaryKey
      (
         [reference_data::Store]RD_ISSUER_XREF.ISSUER_ID,
         [reference_data::Store]RD_ISSUER_XREF.SCHEME
      )
      ~mainTable [reference_data::Store]RD_ISSUER_XREF
      issuerId: [reference_data::Store]RD_ISSUER_XREF.ISSUER_ID,
      scheme: [reference_data::Store]RD_ISSUER_XREF.SCHEME,
      identifierValue: [reference_data::Store]RD_ISSUER_XREF.IDENTIFIER_VALUE,
      isPrimary: [reference_data::Store]RD_ISSUER_XREF.IS_PRIMARY,
      assignedDate: [reference_data::Store]RD_ISSUER_XREF.ASSIGNED_DATE
   }

   *reference_data::RdIssuerHierarchyLink[rdIssuerHierarchyLink]: Relational
   {
      ~primaryKey ( [reference_data::Store]RD_ISSUER_HIERARCHY.LINK_ID )
      ~mainTable [reference_data::Store]RD_ISSUER_HIERARCHY
      linkId: [reference_data::Store]RD_ISSUER_HIERARCHY.LINK_ID,
      childIssuerId: [reference_data::Store]RD_ISSUER_HIERARCHY.CHILD_ISSUER_ID,
      parentIssuerId: [reference_data::Store]RD_ISSUER_HIERARCHY.PARENT_ISSUER_ID,
      ownershipPct: [reference_data::Store]RD_ISSUER_HIERARCHY.OWNERSHIP_PCT,
      isUltimateParent: [reference_data::Store]RD_ISSUER_HIERARCHY.IS_ULTIMATE_PARENT,
      effectiveDate: [reference_data::Store]RD_ISSUER_HIERARCHY.EFFECTIVE_DATE,
      endDate: [reference_data::Store]RD_ISSUER_HIERARCHY.END_DATE,
      parent[rdIssuerProfile]: [reference_data::Store]@Rd_HierarchyParent
   }

