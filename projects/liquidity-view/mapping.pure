###Mapping

// liquidity_view::Mapping includes BOTH dependencies' mappings. That is the same diamond the
// store has: cash_core::Mapping brings core_account::Mapping, funding_core::Mapping brings
// core_account::Mapping and core_tenor::Mapping, and core-account arrives twice by two paths
// without being duplicated. Neither is included again here -- they are already present, and
// naming them would declare a dependency this project does not have.
//
// Every set id is explicit and starts `lqv`, per the contract. Set ids are a GLOBAL namespace
// across the whole graph, so a collision fails everything with a message that names the id
// and not the project.
//
// Every cross-project property names the DEPENDENCY's set id, read out of its MANIFEST rather
// than guessed: both cash-core and funding-core name their ids explicitly, so the default
// ids (`cash_core_CshCashMovement`, `funding_core_FndCurvePoint`) do not exist and the bare
// `prop: [db]@Join` form would not resolve.
Mapping liquidity_view::Mapping
(
  include cash_core::Mapping
  include funding_core::Mapping

  *liquidity_view::LqvLiquidityLadder[lqvLadder]: Relational
  {
    ~primaryKey ( [liquidity_view::Store]LQV_LADDER.LADDER_ID )
    ~mainTable [liquidity_view::Store]LQV_LADDER
    ladderId: [liquidity_view::Store]LQV_LADDER.LADDER_ID,
    ladderName: [liquidity_view::Store]LQV_LADDER.LADDER_NAME,
    regime: [liquidity_view::Store]LQV_LADDER.REGIME,
    basis: [liquidity_view::Store]LQV_LADDER.BASIS,
    ownerDesk: [liquidity_view::Store]LQV_LADDER.OWNER_DESK,
    retiredOn: [liquidity_view::Store]LQV_LADDER.RETIRED_ON,
    buckets[lqvBucket]: [liquidity_view::Store]@Lqv_LadderBuckets
  }

  // Composite key: the same bucket id exists on more than one ladder.
  *liquidity_view::LqvLiquidityBucket[lqvBucket]: Relational
  {
    ~primaryKey
    (
      [liquidity_view::Store]LQV_BUCKET.LADDER_ID,
      [liquidity_view::Store]LQV_BUCKET.BUCKET_ID
    )
    ~mainTable [liquidity_view::Store]LQV_BUCKET
    ladderId: [liquidity_view::Store]LQV_BUCKET.LADDER_ID,
    bucketId: [liquidity_view::Store]LQV_BUCKET.BUCKET_ID,
    bucketLabel: [liquidity_view::Store]LQV_BUCKET.BUCKET_LABEL,
    minDays: [liquidity_view::Store]LQV_BUCKET.MIN_DAYS,
    maxDays: [liquidity_view::Store]LQV_BUCKET.MAX_DAYS,
    sortOrder: [liquidity_view::Store]LQV_BUCKET.SORT_ORDER,
    ladder[lqvLadder]: [liquidity_view::Store]@Lqv_LadderBuckets,
    // The RANGE join read backwards: every flow whose DAYS_OUT lands in this band.
    flows[lqvFlow]: [liquidity_view::Store]@Lqv_FlowBucket,
    // And the pre-aggregated line for the same band, out of the store VIEW.
    totals[lqvBucketFlow]: [liquidity_view::Store]@Lqv_BucketTotals
  }

  // The flow. Three of its properties are joins and two of those are RANGES.
  *liquidity_view::LqvProjectedFlow[lqvFlow]: Relational
  {
    ~primaryKey ( [liquidity_view::Store]LQV_FLOW.FLOW_ID )
    ~mainTable [liquidity_view::Store]LQV_FLOW
    flowId: [liquidity_view::Store]LQV_FLOW.FLOW_ID,
    ladderId: [liquidity_view::Store]LQV_FLOW.LADDER_ID,
    asOfDate: [liquidity_view::Store]LQV_FLOW.AS_OF_DATE,
    institutionId: [liquidity_view::Store]LQV_FLOW.INSTITUTION_ID,
    accountNo: [liquidity_view::Store]LQV_FLOW.ACCOUNT_NO,
    movementId: [liquidity_view::Store]LQV_FLOW.MOVEMENT_ID,
    fundingCashflowId: [liquidity_view::Store]LQV_FLOW.FUNDING_CASHFLOW_ID,
    curveId: [liquidity_view::Store]LQV_FLOW.CURVE_ID,
    currencyCode: [liquidity_view::Store]LQV_FLOW.CURRENCY_CODE,
    bucketId: [liquidity_view::Store]LQV_FLOW.BUCKET_ID,
    daysOut: [liquidity_view::Store]LQV_FLOW.DAYS_OUT,
    grossAmount: [liquidity_view::Store]LQV_FLOW.GROSS_AMOUNT,
    direction: [liquidity_view::Store]LQV_FLOW.DIRECTION,
    flowType: [liquidity_view::Store]LQV_FLOW.FLOW_TYPE,
    isContractual: [liquidity_view::Store]LQV_FLOW.IS_CONTRACTUAL,
    // RANGE, within this project.
    band[lqvBucket]: [liquidity_view::Store]@Lqv_FlowBucket,
    // RANGE, across the boundary onto funding-core's own set id.
    curvePoint[fndCurvePoint]: [liquidity_view::Store]@Lqv_FlowCurvePoint,
    // Key joins across both boundaries.
    sourceMovement[cshCashMovement]: [liquidity_view::Store]@Lqv_FlowMovement,
    pricedCashflow[fndCashflow]: [liquidity_view::Store]@Lqv_FlowFundingCashflow
  }

  // ROOTED AT THE VIEW. A query naming LqvBucketFlowTotal reads the GROUP BY directly; there
  // is no flow-level set behind it and no rewrite. The primary key is all four grouping
  // columns, which is the grain the view produces.
  *liquidity_view::LqvBucketFlowTotal[lqvBucketFlow]: Relational
  {
    ~primaryKey
    (
      [liquidity_view::Store]LQV_BUCKET_FLOW.LADDER_ID,
      [liquidity_view::Store]LQV_BUCKET_FLOW.BUCKET_ID,
      [liquidity_view::Store]LQV_BUCKET_FLOW.CURRENCY_CODE,
      [liquidity_view::Store]LQV_BUCKET_FLOW.AS_OF_DATE
    )
    ~mainTable [liquidity_view::Store]LQV_BUCKET_FLOW
    ladderId: [liquidity_view::Store]LQV_BUCKET_FLOW.LADDER_ID,
    bucketId: [liquidity_view::Store]LQV_BUCKET_FLOW.BUCKET_ID,
    currencyCode: [liquidity_view::Store]LQV_BUCKET_FLOW.CURRENCY_CODE,
    asOfDate: [liquidity_view::Store]LQV_BUCKET_FLOW.AS_OF_DATE,
    netAmount: [liquidity_view::Store]LQV_BUCKET_FLOW.NET_AMOUNT,
    grossOutflow: [liquidity_view::Store]LQV_BUCKET_FLOW.GROSS_OUTFLOW,
    flowCount: [liquidity_view::Store]LQV_BUCKET_FLOW.FLOW_COUNT,
    bucket[lqvBucket]: [liquidity_view::Store]@Lqv_BucketTotals
  }

