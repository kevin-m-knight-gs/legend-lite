###Mapping
// The trade-capture mapping.
//
// It INCLUDES all three dependency mappings, which is what makes the cross-project
// association ends below resolvable: `trades[ciBase, tcTrade]` names a set id that belongs
// to core_instrument::Mapping, and a set id can only be named if the mapping that declares
// it is in scope.
//
// Every set id is stated explicitly and tc-prefixed. Two consequences worth knowing:
//   * the DEFAULT ids (`trade_capture_Trade`) therefore do not exist, so a downstream
//     project extending one of these sets must name the tc id;
//   * every AssociationMapping end must carry [sourceSetId, targetSetId], because the bare
//     `prop: [db]@Join` form resolves only against default ids -- and half the ends here
//     have a far side whose id was declared in another project entirely.
Mapping trade_capture::Mapping
(
   include core_instrument::Mapping
   include core_party::Mapping
   include core_book::Mapping

   // ---- ENUM TRANSFORMERS ----
   // The database stores codes and the model exposes enums. These seven blocks are the only
   // place the physical strings live, so when an upstream feed changes 'BUY' to 'B' the
   // change is one line and not a search across the mapping.
   trade_capture::TradeSide: EnumerationMapping TcTradeSideMapping
   {
      BUY:          ['B', 'BUY', 'BOT'],
      SELL:         ['S', 'SELL', 'SLD'],
      BUY_TO_COVER: ['BC', 'BUY_TO_COVER'],
      SELL_SHORT:   ['SS', 'SELL_SHORT']
   }

   trade_capture::TradeStatus: EnumerationMapping TcTradeStatusMapping
   {
      NEW:       ['N', 'NEW'],
      VERIFIED:  ['V', 'VERIFIED'],
      CONFIRMED: ['C', 'CONFIRMED'],
      ALLOCATED: ['AL', 'ALLOCATED'],
      SETTLED:   ['ST', 'SETTLED'],
      CANCELLED: ['X', 'CANCELLED'],
      AMENDED:   ['AM', 'AMENDED']
   }

   trade_capture::ConfirmationMethod: EnumerationMapping TcConfirmationMethodMapping
   {
      ELECTRONIC: ['ELEC', 'ELECTRONIC'],
      SWIFT:      ['SWFT', 'SWIFT'],
      EMAIL:      ['MAIL', 'EMAIL'],
      FAX:        ['FAX'],
      PAPER:      ['PAPR', 'PAPER']
   }

   trade_capture::AllocationStatus: EnumerationMapping TcAllocationStatusMapping
   {
      PENDING:   ['P', 'PENDING'],
      PARTIAL:   ['PT', 'PARTIAL'],
      ALLOCATED: ['A', 'ALLOCATED'],
      REJECTED:  ['R', 'REJECTED']
   }

   trade_capture::VenueType: EnumerationMapping TcVenueTypeMapping
   {
      EXCHANGE:                ['XCHG', 'EXCHANGE'],
      MTF:                     ['MTF'],
      OTF:                     ['OTF'],
      SYSTEMATIC_INTERNALISER: ['SI', 'SYSTEMATIC_INTERNALISER'],
      OTC:                     ['OTC'],
      DARK_POOL:               ['DARK', 'DARK_POOL']
   }

   trade_capture::ChargeType: EnumerationMapping TcChargeTypeMapping
   {
      COMMISSION:      ['COMM', 'COMMISSION'],
      EXCHANGE_FEE:    ['EXFE', 'EXCHANGE_FEE'],
      CLEARING_FEE:    ['CLFE', 'CLEARING_FEE'],
      SETTLEMENT_FEE:  ['STFE', 'SETTLEMENT_FEE'],
      STAMP_DUTY:      ['STMP', 'STAMP_DUTY'],
      TRANSACTION_TAX: ['FTT', 'TRANSACTION_TAX'],
      RESEARCH:        ['RSCH', 'RESEARCH']
   }

   trade_capture::MatchStatus: EnumerationMapping TcMatchStatusMapping
   {
      UNMATCHED: ['U', 'UNMATCHED'],
      MATCHED:   ['M', 'MATCHED'],
      DISPUTED:  ['D', 'DISPUTED'],
      RESOLVED:  ['RS', 'RESOLVED']
   }

   // ---- class sets ----
   // The foreign-key columns (INSTRUMENT_ID, BOOK_ID, COUNTERPARTY_ID ...) appear in the
   // joins and nowhere in these sets: the model reaches those things by association, and a
   // duplicated key property would be a second answer to the same question.
   *trade_capture::Trade[tcTrade]: Relational
   {
      ~primaryKey ( [trade_capture::Store]TC_TRADE.TRADE_ID )
      ~mainTable [trade_capture::Store]TC_TRADE
      tradeId: [trade_capture::Store]TC_TRADE.TRADE_ID,
      tradeVersion: [trade_capture::Store]TC_TRADE.TRADE_VERSION,
      externalTradeRef: [trade_capture::Store]TC_TRADE.EXTERNAL_TRADE_REF,
      side: EnumerationMapping TcTradeSideMapping: [trade_capture::Store]TC_TRADE.SIDE,
      status: EnumerationMapping TcTradeStatusMapping: [trade_capture::Store]TC_TRADE.STATUS,
      quantity: [trade_capture::Store]TC_TRADE.QUANTITY,
      price: [trade_capture::Store]TC_TRADE.PRICE,
      notional: [trade_capture::Store]TC_TRADE.NOTIONAL,
      currency: [trade_capture::Store]TC_TRADE.CURRENCY,
      settlementCurrency: [trade_capture::Store]TC_TRADE.SETTLEMENT_CURRENCY,
      tradeDate: [trade_capture::Store]TC_TRADE.TRADE_DATE,
      settlementDate: [trade_capture::Store]TC_TRADE.SETTLEMENT_DATE,
      executionTime: [trade_capture::Store]TC_TRADE.EXECUTION_TIME,
      captureTime: [trade_capture::Store]TC_TRADE.CAPTURE_TIME,
      isBlock: [trade_capture::Store]TC_TRADE.IS_BLOCK,
      isCancelled: [trade_capture::Store]TC_TRADE.IS_CANCELLED,
      accruedInterest: [trade_capture::Store]TC_TRADE.ACCRUED_INTEREST,
      comment: [trade_capture::Store]TC_TRADE.COMMENT_TEXT
   }

   *trade_capture::TradeLeg[tcTradeLeg]: Relational
   {
      ~primaryKey ( [trade_capture::Store]TC_TRADE_LEG.LEG_ID )
      ~mainTable [trade_capture::Store]TC_TRADE_LEG
      legId: [trade_capture::Store]TC_TRADE_LEG.LEG_ID,
      legNumber: [trade_capture::Store]TC_TRADE_LEG.LEG_NUMBER,
      legType: [trade_capture::Store]TC_TRADE_LEG.LEG_TYPE,
      legSide: EnumerationMapping TcTradeSideMapping: [trade_capture::Store]TC_TRADE_LEG.LEG_SIDE,
      legQuantity: [trade_capture::Store]TC_TRADE_LEG.LEG_QUANTITY,
      legPrice: [trade_capture::Store]TC_TRADE_LEG.LEG_PRICE,
      legCurrency: [trade_capture::Store]TC_TRADE_LEG.LEG_CURRENCY,
      legStartDate: [trade_capture::Store]TC_TRADE_LEG.LEG_START_DATE,
      legEndDate: [trade_capture::Store]TC_TRADE_LEG.LEG_END_DATE,
      payReceive: [trade_capture::Store]TC_TRADE_LEG.PAY_RECEIVE,
      fixedRate: [trade_capture::Store]TC_TRADE_LEG.FIXED_RATE,
      floatingIndex: [trade_capture::Store]TC_TRADE_LEG.FLOATING_INDEX,
      spread: [trade_capture::Store]TC_TRADE_LEG.SPREAD
   }

