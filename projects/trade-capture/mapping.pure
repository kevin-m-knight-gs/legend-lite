      authoredTime: [trade_capture::Store]TC_TRADE_NOTE.AUTHORED_TIME,
      isInternal: [trade_capture::Store]TC_TRADE_NOTE.IS_INTERNAL
   }

   *trade_capture::CaptureSource[tcCaptureSource]: Relational
   {
      ~primaryKey ( [trade_capture::Store]TC_CAPTURE_SOURCE.SOURCE_ID )
      ~mainTable [trade_capture::Store]TC_CAPTURE_SOURCE
      sourceId: [trade_capture::Store]TC_CAPTURE_SOURCE.SOURCE_ID,
      sourceCode: [trade_capture::Store]TC_CAPTURE_SOURCE.SOURCE_CODE,
      sourceName: [trade_capture::Store]TC_CAPTURE_SOURCE.SOURCE_NAME,
