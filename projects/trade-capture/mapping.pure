      taggedTime: [trade_capture::Store]TC_TRADE_TAG.TAGGED_TIME
   }

   // ---- CROSS-PROJECT association mappings ----
   // The far set id in each pair -- ciBase, cbBook, cpLegalEntity -- was declared in
   // another project and read out of its MANIFEST. Naming it is mandatory: those projects
   // give their sets explicit ids, so the default ids (core_instrument_Instrument and so
   // on) do not exist at all. The store qualifier is trade_capture::Store because that is
   // where the join is declared, even though one end of it is a foreign table.
   trade_capture::TradeInstrument: Relational
   {
      AssociationMapping
      (
         instrument[tcTrade, ciBase]: [trade_capture::Store]@Tc_TradeInstrument,
         trades[ciBase, tcTrade]: [trade_capture::Store]@Tc_TradeInstrument
      )
   }

   trade_capture::LegInstrument: Relational
   {
      AssociationMapping
      (
         legInstrument[tcTradeLeg, ciBase]: [trade_capture::Store]@Tc_LegInstrument,
         instrumentLegs[ciBase, tcTradeLeg]: [trade_capture::Store]@Tc_LegInstrument
      )
   }

   trade_capture::TradeBook: Relational
   {
      AssociationMapping
      (
         book[tcTrade, cbBook]: [trade_capture::Store]@Tc_TradeBook,
         bookedTrades[cbBook, tcTrade]: [trade_capture::Store]@Tc_TradeBook
      )
   }

   trade_capture::CounterpartyEntity: Relational
   {
      AssociationMapping
      (
         legalEntity[tcCounterparty, cpLegalEntity]: [trade_capture::Store]@Tc_CounterpartyEntity,
         counterpartyRoles[cpLegalEntity, tcCounterparty]: [trade_capture::Store]@Tc_CounterpartyEntity
      )
   }

   trade_capture::AllocationEntity: Relational
   {
      AssociationMapping
      (
         allocationEntity[tcAllocation, cpLegalEntity]: [trade_capture::Store]@Tc_AllocationEntity,
