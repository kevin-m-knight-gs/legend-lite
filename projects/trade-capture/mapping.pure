   *trade_capture::TradeTag[tcTradeTag]: Relational
   {
      ~primaryKey ( [trade_capture::Store]TC_TRADE_TAG.TAG_ID )
      ~mainTable [trade_capture::Store]TC_TRADE_TAG
      tagId: [trade_capture::Store]TC_TRADE_TAG.TAG_ID,
      tagKey: [trade_capture::Store]TC_TRADE_TAG.TAG_KEY,
      tagValue: [trade_capture::Store]TC_TRADE_TAG.TAG_VALUE,
