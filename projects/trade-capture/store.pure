###Relational
// The trade-capture database.
//
// It INCLUDES all three dependency stores. That is not decoration: a join whose far side is
// CI_INSTRUMENT, CP_LEGAL_ENTITY or CB_BOOK can only be declared here if those tables are
// in scope, and they are in scope only because of the includes. Six of the joins below
// cross a project boundary and are the physical half of the cross-project associations in
// model.pure.
//
// Every table is TC_ prefixed, every join Tc_, every filter Tc, because table names, join
// names and filter names are all GLOBAL namespaces in Legend -- one collision anywhere in
// the graph fails the whole compile with a message that names the element and not the
// project that declared it.
Database trade_capture::Store
(
   include core_instrument::Store
   include core_party::Store
   include core_book::Store

   // The trade header. INSTRUMENT_ID, BOOK_ID, COUNTERPARTY_ID and the rest are foreign
   // keys and stay columns -- they have to live somewhere -- but they are deliberately not
   // mapped to properties, because the model reaches those things by association instead.
   Table TC_TRADE
   (
      TRADE_ID VARCHAR(64) PRIMARY KEY,
      TRADE_VERSION INTEGER NOT NULL,
      EXTERNAL_TRADE_REF VARCHAR(64),
      SIDE VARCHAR(16) NOT NULL,
      STATUS VARCHAR(16) NOT NULL,
      QUANTITY DOUBLE NOT NULL,
      PRICE DOUBLE NOT NULL,
      NOTIONAL DOUBLE NOT NULL,
      CURRENCY VARCHAR(3) NOT NULL,
      SETTLEMENT_CURRENCY VARCHAR(3),
      TRADE_DATE DATE NOT NULL,
      SETTLEMENT_DATE DATE,
      EXECUTION_TIME TIMESTAMP NOT NULL,
      CAPTURE_TIME TIMESTAMP NOT NULL,
      IS_BLOCK BIT NOT NULL,
      IS_CANCELLED BIT NOT NULL,
      ACCRUED_INTEREST DOUBLE,
      COMMENT_TEXT VARCHAR(400),
      CANCEL_DATE DATE,
      // the foreign keys, all of them nullable except the ones capture will not accept
      INSTRUMENT_ID VARCHAR(60) NOT NULL,
      BOOK_ID VARCHAR(64),
      COUNTERPARTY_ID VARCHAR(64),
      TRADER_ID VARCHAR(64),
      VENUE_ID VARCHAR(64),
      BLOCK_ID VARCHAR(64),
      SOURCE_ID VARCHAR(64)
   )

   Table TC_TRADE_LEG
   (
      LEG_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      LEG_NUMBER INTEGER NOT NULL,
      LEG_TYPE VARCHAR(32) NOT NULL,
      LEG_SIDE VARCHAR(16) NOT NULL,
      LEG_QUANTITY DOUBLE NOT NULL,
      LEG_PRICE DOUBLE NOT NULL,
      LEG_CURRENCY VARCHAR(3) NOT NULL,
      LEG_START_DATE DATE,
      LEG_END_DATE DATE,
      PAY_RECEIVE VARCHAR(8),
      FIXED_RATE DOUBLE,
      FLOATING_INDEX VARCHAR(32),
      SPREAD DOUBLE,
      // a leg can be on a different instrument from its trade header
      INSTRUMENT_ID VARCHAR(60)
   )

   Table TC_BLOCK_TRADE
   (
      BLOCK_ID VARCHAR(64) PRIMARY KEY,
      BLOCK_REF VARCHAR(64) NOT NULL,
      BLOCK_QUANTITY DOUBLE NOT NULL,
      FILLED_QUANTITY DOUBLE NOT NULL,
      AVERAGE_PRICE DOUBLE NOT NULL,
      ALLOCATION_STATUS VARCHAR(16) NOT NULL,
      BLOCK_DATE DATE NOT NULL,
      IS_COMPLETE BIT NOT NULL
   )

   Table TC_ALLOCATION
   (
      ALLOCATION_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      INSTRUCTION_ID VARCHAR(64),
      ALLOCATION_REF VARCHAR(64),
      ALLOCATED_QUANTITY DOUBLE NOT NULL,
      ALLOCATED_PRICE DOUBLE NOT NULL,
      ALLOCATED_NOTIONAL DOUBLE NOT NULL,
      ALLOCATION_STATUS VARCHAR(16) NOT NULL,
      ACCOUNT_NUMBER VARCHAR(64),
      ALLOCATION_TIME TIMESTAMP NOT NULL,
      IS_CONFIRMED BIT NOT NULL,
      REJECTION_REASON VARCHAR(200),
      // the end client, in the party master
      ENTITY_ID VARCHAR(40)
   )

   Table TC_ALLOCATION_INSTRUCTION
   (
      INSTRUCTION_ID VARCHAR(64) PRIMARY KEY,
      INSTRUCTION_REF VARCHAR(64) NOT NULL,
      SPLIT_PERCENTAGE DOUBLE NOT NULL,
      BASIS VARCHAR(32) NOT NULL,
      RECEIVED_TIME TIMESTAMP NOT NULL,
      IS_STANDING BIT NOT NULL,
      EFFECTIVE_FROM DATE,
      EFFECTIVE_TO DATE
   )

   Table TC_CONFIRMATION
   (
      CONFIRMATION_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      CONFIRMATION_REF VARCHAR(64),
      METHOD VARCHAR(16) NOT NULL,
      SENT_TIME TIMESTAMP,
      ACKNOWLEDGED_TIME TIMESTAMP,
      IS_AFFIRMED BIT NOT NULL,
      AFFIRMED_BY VARCHAR(120),
      DOCUMENT_URL VARCHAR(400),
      FAILURE_REASON VARCHAR(200)
   )

   Table TC_AMENDMENT
   (
      AMENDMENT_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      AMENDMENT_SEQUENCE INTEGER NOT NULL,
      AMENDED_FIELD VARCHAR(64) NOT NULL,
      OLD_VALUE VARCHAR(200),
      NEW_VALUE VARCHAR(200),
      AMENDED_BY VARCHAR(120) NOT NULL,
      AMENDED_TIME TIMESTAMP NOT NULL,
      REASON_CODE VARCHAR(32),
      IS_ECONOMIC BIT NOT NULL
   )

   Table TC_CANCELLATION
   (
      CANCELLATION_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      CANCELLED_BY VARCHAR(120) NOT NULL,
      CANCELLED_TIME TIMESTAMP NOT NULL,
      REASON_CODE VARCHAR(32) NOT NULL,
      REASON_TEXT VARCHAR(400),
      IS_REBOOK_EXPECTED BIT NOT NULL
   )

   Table TC_TRADE_VERSION
   (
      VERSION_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      VERSION_NUMBER INTEGER NOT NULL,
      VERSION_QUANTITY DOUBLE NOT NULL,
      VERSION_PRICE DOUBLE NOT NULL,
      VERSION_STATUS VARCHAR(16) NOT NULL,
      VALID_FROM TIMESTAMP NOT NULL,
      VALID_TO TIMESTAMP,
      CHANGED_BY VARCHAR(120) NOT NULL
   )

   Table TC_TRADE_XREF
   (
      TRADE_IDENTIFIER_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      SCHEME VARCHAR(32) NOT NULL,
      IDENTIFIER_VALUE VARCHAR(120) NOT NULL,
      ASSIGNED_BY VARCHAR(120),
      ASSIGNED_TIME TIMESTAMP,
      IS_PRIMARY BIT NOT NULL
   )

   Table TC_TRADE_CHARGE
   (
      CHARGE_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      CHARGE_TYPE VARCHAR(24) NOT NULL,
      CHARGE_AMOUNT DOUBLE NOT NULL,
      CHARGE_CURRENCY VARCHAR(3) NOT NULL,
      CHARGE_RATE DOUBLE,
      IS_INCLUDED_IN_NET BIT NOT NULL,
      IS_CLIENT_BEARING BIT NOT NULL,
      CALCULATED_TIME TIMESTAMP
   )

   Table TC_COMMISSION_SCHEDULE
   (
      SCHEDULE_ID VARCHAR(64) PRIMARY KEY,
      SCHEDULE_NAME VARCHAR(120) NOT NULL,
      BASIS_POINTS DOUBLE NOT NULL,
      MINIMUM_CHARGE DOUBLE NOT NULL,
      MAXIMUM_CHARGE DOUBLE,
      SCHEDULE_CURRENCY VARCHAR(3) NOT NULL,
      APPLIES_FROM DATE NOT NULL,
      APPLIES_TO DATE
   )

   Table TC_SETTLEMENT_INSTRUCTION
   (
      INSTRUCTION_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      DELIVERY_TYPE VARCHAR(32) NOT NULL,
      CUSTODIAN_BIC VARCHAR(11),
      ACCOUNT_NUMBER VARCHAR(64),
      PLACE_OF_SETTLEMENT VARCHAR(64),
      SETTLEMENT_AMOUNT DOUBLE NOT NULL,
      SETTLEMENT_CURRENCY VARCHAR(3) NOT NULL,
      VALUE_DATE DATE NOT NULL,
      IS_DVP BIT NOT NULL
   )

   Table TC_VENUE
   (
      VENUE_ID VARCHAR(64) PRIMARY KEY,
      MIC VARCHAR(4) NOT NULL,
      VENUE_NAME VARCHAR(200) NOT NULL,
      VENUE_TYPE VARCHAR(32) NOT NULL,
      COUNTRY_CODE VARCHAR(2),
      OPERATING_MIC VARCHAR(4),
      TIMEZONE VARCHAR(64),
      IS_ACTIVE BIT NOT NULL
   )

   Table TC_TRADER
   (
      TRADER_ID VARCHAR(64) PRIMARY KEY,
      FIRST_NAME VARCHAR(120) NOT NULL,
      LAST_NAME VARCHAR(120) NOT NULL,
      EMAIL VARCHAR(200),
      BADGE_ID VARCHAR(32),
      DESK_NAME VARCHAR(120),
      IS_ACTIVE BIT NOT NULL,
      START_DATE DATE
   )

   Table TC_SALESPERSON
   (
      SALESPERSON_ID VARCHAR(64) PRIMARY KEY,
      FIRST_NAME VARCHAR(120) NOT NULL,
      LAST_NAME VARCHAR(120) NOT NULL,
      EMAIL VARCHAR(200),
      COVERAGE_REGION VARCHAR(64),
      IS_ACTIVE BIT NOT NULL
   )

   Table TC_SALES_CREDIT
   (
      CREDIT_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      SALESPERSON_ID VARCHAR(64) NOT NULL,
      CREDIT_PERCENTAGE DOUBLE NOT NULL,
      CREDIT_AMOUNT DOUBLE NOT NULL,
      CREDIT_CURRENCY VARCHAR(3) NOT NULL,
      CREDIT_DATE DATE NOT NULL,
      IS_FINAL BIT NOT NULL
   )

   Table TC_COUNTERPARTY
   (
      COUNTERPARTY_ID VARCHAR(64) PRIMARY KEY,
      SHORT_NAME VARCHAR(120) NOT NULL,
      COUNTERPARTY_TYPE VARCHAR(32) NOT NULL,
      TRADING_ACCOUNT_REF VARCHAR(64),
      DEFAULT_SETTLEMENT_DAYS INTEGER,
      IS_CLEARING_ELIGIBLE BIT NOT NULL,
      IS_ACTIVE BIT NOT NULL,
      ONBOARDED_DATE DATE,
      SCHEDULE_ID VARCHAR(64),
      // the registered legal person, in the party master
      ENTITY_ID VARCHAR(40)
   )

   Table TC_CLEARING_BROKER
   (
      BROKER_ID VARCHAR(64) PRIMARY KEY,
      BROKER_CODE VARCHAR(32) NOT NULL,
      CLEARING_MEMBER_CODE VARCHAR(32),
      CLEARING_HOUSE VARCHAR(64),
      IS_ACTIVE BIT NOT NULL,
      ENTITY_ID VARCHAR(40)
   )

   Table TC_GIVE_UP
   (
      GIVE_UP_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      BROKER_ID VARCHAR(64),
      GIVE_UP_REF VARCHAR(64),
      GIVE_UP_TIME TIMESTAMP NOT NULL,
      IS_ACCEPTED BIT NOT NULL,
      ACCEPTED_TIME TIMESTAMP,
      REJECTION_REASON VARCHAR(200)
   )

   Table TC_TRADE_MATCH
   (
      MATCH_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      MATCH_STATUS VARCHAR(16) NOT NULL,
      COUNTERPARTY_REF VARCHAR(64),
      MATCHED_TIME TIMESTAMP,
      MATCH_SCORE DOUBLE,
      MATCHED_BY VARCHAR(120)
   )

   Table TC_TRADE_BREAK
   (
      BREAK_ID VARCHAR(64) PRIMARY KEY,
      MATCH_ID VARCHAR(64) NOT NULL,
      BREAK_FIELD VARCHAR(64) NOT NULL,
      OUR_VALUE VARCHAR(200),
      THEIR_VALUE VARCHAR(200),
      RAISED_TIME TIMESTAMP NOT NULL,
      RESOLVED_TIME TIMESTAMP,
      ASSIGNED_TO VARCHAR(120),
      SEVERITY VARCHAR(16) NOT NULL
   )

   Table TC_TRADE_APPROVAL
   (
      APPROVAL_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      APPROVAL_TYPE VARCHAR(32) NOT NULL,
      APPROVED_BY VARCHAR(120) NOT NULL,
      APPROVED_TIME TIMESTAMP NOT NULL,
      IS_GRANTED BIT NOT NULL,
      APPROVAL_COMMENT VARCHAR(400)
   )

   Table TC_TRADE_NOTE
   (
      NOTE_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      NOTE_TEXT VARCHAR(1000) NOT NULL,
      AUTHORED_BY VARCHAR(120) NOT NULL,
      AUTHORED_TIME TIMESTAMP NOT NULL,
      IS_INTERNAL BIT NOT NULL
   )

   Table TC_CAPTURE_SOURCE
   (
      SOURCE_ID VARCHAR(64) PRIMARY KEY,
      SOURCE_CODE VARCHAR(32) NOT NULL,
      SOURCE_NAME VARCHAR(120) NOT NULL,
      SOURCE_TYPE VARCHAR(32) NOT NULL,
      IS_REAL_TIME BIT NOT NULL,
      IS_ACTIVE BIT NOT NULL
   )

   Table TC_TRADE_TAG
   (
      TAG_ID VARCHAR(64) PRIMARY KEY,
      TRADE_ID VARCHAR(64) NOT NULL,
      TAG_KEY VARCHAR(64) NOT NULL,
      TAG_VALUE VARCHAR(200),
      TAGGED_BY VARCHAR(120),
      TAGGED_TIME TIMESTAMP
   )

   // ---- the six CROSS-PROJECT joins ----
   // Each far side is a table this project does not declare. They resolve only because of
   // the three `include` lines at the top, and a join condition must be on ONE line.
   Join Tc_TradeInstrument(TC_TRADE.INSTRUMENT_ID = CI_INSTRUMENT.INSTRUMENT_ID)
   Join Tc_LegInstrument(TC_TRADE_LEG.INSTRUMENT_ID = CI_INSTRUMENT.INSTRUMENT_ID)
   Join Tc_TradeBook(TC_TRADE.BOOK_ID = CB_BOOK.BOOK_ID)
   Join Tc_CounterpartyEntity(TC_COUNTERPARTY.ENTITY_ID = CP_LEGAL_ENTITY.ENTITY_ID)
   Join Tc_AllocationEntity(TC_ALLOCATION.ENTITY_ID = CP_LEGAL_ENTITY.ENTITY_ID)
   Join Tc_ClearingBrokerEntity(TC_CLEARING_BROKER.ENTITY_ID = CP_LEGAL_ENTITY.ENTITY_ID)

   // ---- joins within this project ----
   Join Tc_TradeTrader(TC_TRADE.TRADER_ID = TC_TRADER.TRADER_ID)
   Join Tc_TradeVenue(TC_TRADE.VENUE_ID = TC_VENUE.VENUE_ID)
   Join Tc_TradeCounterparty(TC_TRADE.COUNTERPARTY_ID = TC_COUNTERPARTY.COUNTERPARTY_ID)
   Join Tc_TradeBlock(TC_TRADE.BLOCK_ID = TC_BLOCK_TRADE.BLOCK_ID)
   Join Tc_TradeSource(TC_TRADE.SOURCE_ID = TC_CAPTURE_SOURCE.SOURCE_ID)
   Join Tc_TradeLeg(TC_TRADE.TRADE_ID = TC_TRADE_LEG.TRADE_ID)
   Join Tc_TradeAllocation(TC_TRADE.TRADE_ID = TC_ALLOCATION.TRADE_ID)
   Join Tc_AllocationInstruction(TC_ALLOCATION.INSTRUCTION_ID = TC_ALLOCATION_INSTRUCTION.INSTRUCTION_ID)
   Join Tc_TradeConfirmation(TC_TRADE.TRADE_ID = TC_CONFIRMATION.TRADE_ID)
   Join Tc_TradeAmendment(TC_TRADE.TRADE_ID = TC_AMENDMENT.TRADE_ID)
   Join Tc_TradeCancellation(TC_TRADE.TRADE_ID = TC_CANCELLATION.TRADE_ID)
   Join Tc_TradeVersionLink(TC_TRADE.TRADE_ID = TC_TRADE_VERSION.TRADE_ID)
   Join Tc_TradeIdentifier(TC_TRADE.TRADE_ID = TC_TRADE_XREF.TRADE_ID)
   Join Tc_TradeCharge(TC_TRADE.TRADE_ID = TC_TRADE_CHARGE.TRADE_ID)
   Join Tc_CounterpartyCommission(TC_COUNTERPARTY.SCHEDULE_ID = TC_COMMISSION_SCHEDULE.SCHEDULE_ID)
   Join Tc_TradeSettlement(TC_TRADE.TRADE_ID = TC_SETTLEMENT_INSTRUCTION.TRADE_ID)
   Join Tc_TradeGiveUp(TC_TRADE.TRADE_ID = TC_GIVE_UP.TRADE_ID)
   Join Tc_BrokerGiveUp(TC_GIVE_UP.BROKER_ID = TC_CLEARING_BROKER.BROKER_ID)
   Join Tc_TradeMatch(TC_TRADE.TRADE_ID = TC_TRADE_MATCH.TRADE_ID)
   Join Tc_MatchBreak(TC_TRADE_MATCH.MATCH_ID = TC_TRADE_BREAK.MATCH_ID)
   Join Tc_TradeApproval(TC_TRADE.TRADE_ID = TC_TRADE_APPROVAL.TRADE_ID)
   Join Tc_TradeNote(TC_TRADE.TRADE_ID = TC_TRADE_NOTE.TRADE_ID)
   Join Tc_TradeTag(TC_TRADE.TRADE_ID = TC_TRADE_TAG.TRADE_ID)
   Join Tc_TradeSalesCredit(TC_TRADE.TRADE_ID = TC_SALES_CREDIT.TRADE_ID)
   Join Tc_SalespersonCredit(TC_SALES_CREDIT.SALESPERSON_ID = TC_SALESPERSON.SALESPERSON_ID)

   // Live trades only. A Filter will not take a boolean literal -- `IS_CANCELLED = true`
   // fails the parser with `Unexpected token 'true'` -- so the test is on the date column
   // that is null exactly when the trade is still live.
   Filter TcLiveTrades(TC_TRADE.CANCEL_DATE is null)

   // Confirmations that never came back. Also a null test, for the same reason.
   Filter TcUnacknowledgedConfirmations(TC_CONFIRMATION.ACKNOWLEDGED_TIME is null)
)
