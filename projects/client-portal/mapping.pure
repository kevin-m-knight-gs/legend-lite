         userAuditEvents[cpoUser, cpoAuditEvent]: [client_portal::Store]@Cpo_UserAudit
      )
   }

   // ---- into this project's own aggregates ---------------------------------------------------

   client_portal::CpoEntryViewTotals: Relational
   {
      AssociationMapping
      (
         totalEntry[cpoEntryViewTotal, cpoDocumentEntry]: [client_portal::Store]@Cpo_EntryViewTotal,
         viewTotal[cpoDocumentEntry, cpoEntryViewTotal]: [client_portal::Store]@Cpo_EntryViewTotal
      )
   }

   client_portal::CpoUserActivityTotals: Relational
   {
      AssociationMapping
      (
         activityUser[cpoUserActivityTotal, cpoUser]: [client_portal::Store]@Cpo_UserActivityTotal,
         activityTotals[cpoUser, cpoUserActivityTotal]: [client_portal::Store]@Cpo_UserActivityTotal
      )
   }

   client_portal::CpoClientOutstandingTotals: Relational
   {
      AssociationMapping
      (
         outstandingTotal[cpoInvoiceView, cpoClientOutstandingTotal]: [client_portal::Store]@Cpo_ClientOutstandingTotal,
         clientInvoiceViews[cpoClientOutstandingTotal, cpoInvoiceView]: [client_portal::Store]@Cpo_ClientOutstandingTotal
      )
   }

   // ==== associations, across a project boundary ==============================================
   //
   // Seven, reaching BOTH dependencies. Every end names [sourceSetId, targetSetId], and the
   // far-side ids are the dependency's explicit ones -- crpStatement, crpDelivery,
   // crpCostsDisclosure, crpDepreciationNotice, bilInvoice, bilDispute. The join itself lives
   // in client_portal::Store even for the end whose source table belongs to the dependency,
   // because that is the store that includes both.

   // ---- into client-reporting -----------------------------------------------------------------
   client_portal::CpoEntryStatement: Relational
   {
      AssociationMapping
      (
         statement[cpoDocumentEntry, crpStatement]: [client_portal::Store]@Cpo_EntryStatement,
         portalEntries[crpStatement, cpoDocumentEntry]: [client_portal::Store]@Cpo_EntryStatement
      )
   }

   client_portal::CpoEntryDelivery: Relational
   {
      AssociationMapping
      (
         delivery[cpoDocumentEntry, crpDelivery]: [client_portal::Store]@Cpo_EntryDelivery,
         portalEntry[crpDelivery, cpoDocumentEntry]: [client_portal::Store]@Cpo_EntryDelivery
      )
   }

   client_portal::CpoRequestDisclosure: Relational
   {
      AssociationMapping
      (
         disclosure[cpoAckRequest, crpCostsDisclosure]: [client_portal::Store]@Cpo_RequestDisclosure,
         disclosureRequests[crpCostsDisclosure, cpoAckRequest]: [client_portal::Store]@Cpo_RequestDisclosure
      )
   }

   client_portal::CpoAlertNotice: Relational
   {
      AssociationMapping
      (
         notice[cpoAlert, crpDepreciationNotice]: [client_portal::Store]@Cpo_AlertNotice,
         portalAlerts[crpDepreciationNotice, cpoAlert]: [client_portal::Store]@Cpo_AlertNotice
      )
   }

   // ---- into fee-billing ------------------------------------------------------------------------
   client_portal::CpoInvoiceViewInvoice: Relational
   {
      AssociationMapping
      (
         invoice[cpoInvoiceView, bilInvoice]: [client_portal::Store]@Cpo_PortalInvoice,
         portalView[bilInvoice, cpoInvoiceView]: [client_portal::Store]@Cpo_PortalInvoice
      )
   }

   client_portal::CpoInstructionInvoice: Relational
   {
      AssociationMapping
      (
         instructedInvoice[cpoPaymentInstruction, bilInvoice]: [client_portal::Store]@Cpo_InstructionInvoice,
         invoiceInstructions[bilInvoice, cpoPaymentInstruction]: [client_portal::Store]@Cpo_InstructionInvoice
      )
   }

   client_portal::CpoAlertDispute: Relational
   {
      AssociationMapping
      (
         dispute[cpoAlert, bilDispute]: [client_portal::Store]@Cpo_AlertDispute,
         disputeAlerts[bilDispute, cpoAlert]: [client_portal::Store]@Cpo_AlertDispute
      )
   }
)
