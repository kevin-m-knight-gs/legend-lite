   // ==== associations, internal ==============================================================
   //
   // The AssociationMapping(...) wrapper is mandatory: without it the grammar reads the block
   // as a CLASS mapping and reports "Can't find class client_portal::CpoUserSessions", which
   // names the wrong problem. Both ends use the SAME join; the engine reverses it for the end
   // that walks against the declared direction.

   client_portal::CpoUserEntitlements: Relational
   {
      AssociationMapping
      (
         entitledUser[cpoEntitlement, cpoUser]: [client_portal::Store]@Cpo_UserEntitlements,
         entitlements[cpoUser, cpoEntitlement]: [client_portal::Store]@Cpo_UserEntitlements
      )
   }

   client_portal::CpoUserSessions: Relational
   {
      AssociationMapping
      (
         sessionUser[cpoSession, cpoUser]: [client_portal::Store]@Cpo_UserSessions,
         sessions[cpoUser, cpoSession]: [client_portal::Store]@Cpo_UserSessions
      )
   }

   // Both ends are the SAME set, and only the direction of travel over @Cpo_NodeParent
   // separates the parent from the children.
   client_portal::CpoNodeParent: Relational
   {
      AssociationMapping
      (
         parentNode[cpoNavNode, cpoNavNode]: [client_portal::Store]@Cpo_NodeParent,
         childNodes[cpoNavNode, cpoNavNode]: [client_portal::Store]@Cpo_NodeParent
      )
   }

   client_portal::CpoNodeAccessRules: Relational
   {
      AssociationMapping
      (
         accessNode[cpoNodeAccess, cpoNavNode]: [client_portal::Store]@Cpo_NodeAccessRules,
         accessRules[cpoNavNode, cpoNodeAccess]: [client_portal::Store]@Cpo_NodeAccessRules
      )
   }

   client_portal::CpoEntryNode: Relational
   {
      AssociationMapping
      (
         entryNode[cpoDocumentEntry, cpoNavNode]: [client_portal::Store]@Cpo_EntryNode,
         nodeEntries[cpoNavNode, cpoDocumentEntry]: [client_portal::Store]@Cpo_EntryNode
      )
   }

   client_portal::CpoEntryViews: Relational
   {
      AssociationMapping
      (
         entry[cpoDocumentView, cpoDocumentEntry]: [client_portal::Store]@Cpo_EntryViews,
         views[cpoDocumentEntry, cpoDocumentView]: [client_portal::Store]@Cpo_EntryViews
