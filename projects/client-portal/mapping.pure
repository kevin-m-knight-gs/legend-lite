      scope: [client_portal::Store]CPO_ENTITLEMENT.SCOPE,
      permissionLevel: [client_portal::Store]CPO_ENTITLEMENT.PERMISSION_LEVEL,
      grantedOn: [client_portal::Store]CPO_ENTITLEMENT.GRANTED_ON,
      grantedBy: [client_portal::Store]CPO_ENTITLEMENT.GRANTED_BY,
      sourceKind: [client_portal::Store]CPO_ENTITLEMENT.SOURCE_KIND,
