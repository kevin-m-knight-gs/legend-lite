      modelPrice: [product_catalogue::Store]pct.PCT_INDICATIVE_PRICE.MODEL_PRICE,
      spreadBasisPoints: [product_catalogue::Store]pct.PCT_INDICATIVE_PRICE.SPREAD_BPS,
      priceCurrency: [product_catalogue::Store]pct.PCT_INDICATIVE_PRICE.PRICE_CURRENCY,
      runId: [product_catalogue::Store]pct.PCT_INDICATIVE_PRICE.RUN_ID,
      isStale: [product_catalogue::Store]pct.PCT_INDICATIVE_PRICE.IS_STALE,
      pricingRun[pprPricingRun]: [product_catalogue::Store]@Pct_PriceRun,
      product[pctProduct]: [product_catalogue::Store]@Pct_InstrumentIndicativePrice
   }

