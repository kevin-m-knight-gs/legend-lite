   // ================================================================================
   // 5. WHERE IT MAY NOT BE SOLD
   // ================================================================================

   // The source table of the `~distinct` barred-jurisdiction set above, mapped here at its
   // own full (product, jurisdiction) grain. The two sets share a main table and disagree
   // about what a row is, which is the whole point of `~distinct`.
   *product_catalogue::PctJurisdictionBar[pctJurisdictionBar]: Relational
   {
      ~primaryKey
      (
         [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.INSTRUMENT_ID,
         [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.JURISDICTION_CODE
      )
      ~mainTable [product_catalogue::Store]pct.PCT_JURISDICTION_BAR
      instrumentId: [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.INSTRUMENT_ID,
      jurisdictionCode: [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.JURISDICTION_CODE,
      jurisdictionName: [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.JURISDICTION_NAME,
      jurisdictionRegion: [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.JURISDICTION_REGION,
      barType: [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.BAR_TYPE,
      reasonCode: [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.REASON_CODE,
      legalReference: [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.LEGAL_REFERENCE,
      imposedOn: [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.IMPOSED_ON,
      liftedOn: [product_catalogue::Store]pct.PCT_JURISDICTION_BAR.LIFTED_ON,
      product[pctProduct]: [product_catalogue::Store]@Pct_InstrumentBar
   }

   // `barredJurisdiction` targets the ~distinct set: the restriction names a jurisdiction,
   // and the jurisdiction universe is the collapsed bar table.
   *product_catalogue::PctSalesRestriction[pctRestriction]: Relational
   {
      ~primaryKey ( [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.RESTRICTION_ID )
      ~mainTable [product_catalogue::Store]pct.PCT_SALES_RESTRICTION
      restrictionId: [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.RESTRICTION_ID,
      instrumentId: [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.INSTRUMENT_ID,
      restrictionKind: [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.RESTRICTION_KIND,
      channelCode: [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.CHANNEL_CODE,
      jurisdictionCode: [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.JURISDICTION_CODE,
      thresholdAmount: [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.THRESHOLD_AMOUNT,
      thresholdCurrency: [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.THRESHOLD_CURRENCY,
      effectiveOn: [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.EFFECTIVE_ON,
      expiresOn: [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.EXPIRES_ON,
      note: [product_catalogue::Store]pct.PCT_SALES_RESTRICTION.NOTE,
      channel[pctChannel]: [product_catalogue::Store]@Pct_RestrictionChannel,
      barredJurisdiction[pctBarredJurisdiction]: [product_catalogue::Store]@Pct_RestrictionJurisdiction,
      product[pctProduct]: [product_catalogue::Store]@Pct_InstrumentRestriction
   }

   *product_catalogue::PctWithdrawal[pctWithdrawal]: Relational
   {
      ~primaryKey ( [product_catalogue::Store]pct.PCT_WITHDRAWAL.WITHDRAWAL_ID )
      ~mainTable [product_catalogue::Store]pct.PCT_WITHDRAWAL
      withdrawalId: [product_catalogue::Store]pct.PCT_WITHDRAWAL.WITHDRAWAL_ID,
      instrumentId: [product_catalogue::Store]pct.PCT_WITHDRAWAL.INSTRUMENT_ID,
      withdrawnOn: [product_catalogue::Store]pct.PCT_WITHDRAWAL.WITHDRAWN_ON,
      reasonCode: [product_catalogue::Store]pct.PCT_WITHDRAWAL.REASON_CODE,
      reasonText: [product_catalogue::Store]pct.PCT_WITHDRAWAL.REASON_TEXT,
      holdingsMayContinue: [product_catalogue::Store]pct.PCT_WITHDRAWAL.HOLDINGS_MAY_CONTINUE,
      runoffEndOn: [product_catalogue::Store]pct.PCT_WITHDRAWAL.RUNOFF_END_ON,
      successorInstrumentId: [product_catalogue::Store]pct.PCT_WITHDRAWAL.SUCCESSOR_INSTRUMENT_ID,
      decidedBy: [product_catalogue::Store]pct.PCT_WITHDRAWAL.DECIDED_BY,
      product[pctProduct]: [product_catalogue::Store]@Pct_InstrumentWithdrawal
   }

