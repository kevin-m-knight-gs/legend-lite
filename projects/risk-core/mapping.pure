   // ---- limits ----

   risk_core::RskRiskLimit[rskLimit]: Relational
   {
      ~primaryKey ( [risk_core::Store]RSK_RISK_LIMIT.LIMIT_ID )
      ~mainTable [risk_core::Store]RSK_RISK_LIMIT
      limitId: [risk_core::Store]RSK_RISK_LIMIT.LIMIT_ID,
      portfolioId: [risk_core::Store]RSK_RISK_LIMIT.PORTFOLIO_ID,
      factorId: [risk_core::Store]RSK_RISK_LIMIT.FACTOR_ID,
