      results: [risk_core::Store]@Rsk_ScenarioResult
   }

   risk_core::RskScenarioShock[rskScenarioShock]: Relational
   {
      ~primaryKey
      (
         [risk_core::Store]RSK_SCENARIO_SHOCK.SCENARIO_ID,
         [risk_core::Store]RSK_SCENARIO_SHOCK.FACTOR_ID
      )
      ~mainTable [risk_core::Store]RSK_SCENARIO_SHOCK
      scenarioId: [risk_core::Store]RSK_SCENARIO_SHOCK.SCENARIO_ID,
      factorId: [risk_core::Store]RSK_SCENARIO_SHOCK.FACTOR_ID,
