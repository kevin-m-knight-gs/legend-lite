   risk_core::RskLimitBreach[rskLimitBreach]: Relational
   {
      ~primaryKey
      (
         [risk_core::Store]RSK_LIMIT_BREACH.LIMIT_ID,
         [risk_core::Store]RSK_LIMIT_BREACH.COB_DATE,
         [risk_core::Store]RSK_LIMIT_BREACH.BREACH_SEQ
      )
