      approvedBy: [risk_core::Store]RSK_LIMIT_BREACH.APPROVED_BY,
      closedOn: [risk_core::Store]RSK_LIMIT_BREACH.CLOSED_ON,
      limit: [risk_core::Store]@Rsk_LimitBreach
   }

   // ---- the instrument, extended across the boundary ----
   // Extends the UPSTREAM set [ciBase], so the key, the main table and all twenty base
   // property mappings come from core-instrument. The five risk-only columns live in this
   // project's own table and are reached through a join -- the `@Join | TABLE.COLUMN` form,
   // which is how a set gets a scalar from somewhere other than its main table.
   risk_core::RskRiskInstrument[rskRiskInstrument] extends [ciBase]: Relational
   {
      riskModel: [risk_core::Store]@Rsk_InstrumentRiskAttr | [risk_core::Store]RSK_INSTRUMENT_RISK.RISK_MODEL,
      pricingLibrary: [risk_core::Store]@Rsk_InstrumentRiskAttr | [risk_core::Store]RSK_INSTRUMENT_RISK.PRICING_LIBRARY,
      isVolSensitive: [risk_core::Store]@Rsk_InstrumentRiskAttr | [risk_core::Store]RSK_INSTRUMENT_RISK.IS_VOL_SENSITIVE,
      defaultShockBp: [risk_core::Store]@Rsk_InstrumentRiskAttr | [risk_core::Store]RSK_INSTRUMENT_RISK.DEFAULT_SHOCK_BP,
      factorCount: [risk_core::Store]@Rsk_InstrumentRiskAttr | [risk_core::Store]RSK_INSTRUMENT_RISK.FACTOR_COUNT
   }
)
