   risk_core::RskVarBacktest[rskVarBacktest]: Relational
   {
      ~primaryKey
      (
         [risk_core::Store]RSK_VAR_BACKTEST.PORTFOLIO_ID,
         [risk_core::Store]RSK_VAR_BACKTEST.COB_DATE
      )
      ~mainTable [risk_core::Store]RSK_VAR_BACKTEST
      portfolioId: [risk_core::Store]RSK_VAR_BACKTEST.PORTFOLIO_ID,
      cobDate: [risk_core::Store]RSK_VAR_BACKTEST.COB_DATE,
      varAmount: [risk_core::Store]RSK_VAR_BACKTEST.VAR_AMOUNT,
      actualPnl: [risk_core::Store]RSK_VAR_BACKTEST.ACTUAL_PNL,
      isException: [risk_core::Store]RSK_VAR_BACKTEST.IS_EXCEPTION,
      exceptionCount250d: [risk_core::Store]RSK_VAR_BACKTEST.EXCEPTION_COUNT_250D,
      zoneCode: [risk_core::Store]RSK_VAR_BACKTEST.ZONE_CODE,
      currency: [risk_core::Store]RSK_VAR_BACKTEST.CURRENCY
   }

   // ---- stress ----

   risk_core::RskStressScenario[rskScenario]: Relational
   {
      ~primaryKey ( [risk_core::Store]RSK_STRESS_SCENARIO.SCENARIO_ID )
      ~mainTable [risk_core::Store]RSK_STRESS_SCENARIO
      scenarioId: [risk_core::Store]RSK_STRESS_SCENARIO.SCENARIO_ID,
      scenarioName: [risk_core::Store]RSK_STRESS_SCENARIO.SCENARIO_NAME,
      scenarioType: [risk_core::Store]RSK_STRESS_SCENARIO.SCENARIO_TYPE,
