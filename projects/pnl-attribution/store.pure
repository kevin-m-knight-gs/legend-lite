###Relational
// The P&L attribution store, and the physical half of THE DIAMOND.
//
// It INCLUDES both dependency stores -- and only those two. Their own includes bring
// CI_INSTRUMENT, CA_ACCOUNT, CPR_* and CFX_* into scope transitively, and not one join below
// names any of them: every cross-project join here lands on a PK_* or a VC_* table, which is
// what makes the declared dependency list the true one.
//
// ------------------------------------------------------------------ closing the diamond
//
// PNL_LINE carries five key columns. Four of them are position-keeping's whole position
// grain, and three of them (INSTRUMENT_ID, COB_DATE, plus VALUATION_RUN_ID off-key) are
// valuation-core's whole valuation grain. One table, both keys, so:
//
//   Pnl_LinePosition   4 columns into PK_POSITION  -- and through it to the INSTRUMENT MASTER
//   Pnl_LineValuation  3 columns into VC_VALUATION -- and through it to PRICES and RATES
//
// The two upstream stores have no join between them and never will; they share only the
// string in INSTRUMENT_ID. This table is where that string becomes one security again. Each
// join is then made twice, once against COB_DATE and once against PRIOR_COB_DATE, because a
// P&L is a difference and both ends have to be reachable.
//
// ------------------------------------------------------------------ datatypes
//
//   NUMERIC(20,6)  money -- values, effects, residuals, fees. A P&L explain that does not
//                  reconcile to the last unit has not explained anything, so money is exact.
//   FLOAT          rates, ratios, percentages and tolerances -- compared against a threshold
//                  rather than for equality, and therefore allowed to be approximate.
//   SMALLINT       counts bounded by construction: a sequence, a severity, a step number.
//
// REAL is not used: it parses and cannot be read back at execution (UPSTREAM_FINDINGS F53).
//
// ------------------------------------------------------------------ the aggregation
//
// The five Views at the bottom are the AGGREGATION shape. They are not database views -- no
// DDL is created and nothing seeds them; the engine folds their GROUP BY into the SQL it
// generates. Their ~groupBy columns are their primary key, which is both what makes them
// joinable and what they MEAN: one row of PNL_ACCOUNT_DAY_TOTAL is an account and a day, not
// a P&L line. Four group the line table at four different widths -- account-day,
// instrument-day, currency, whole run -- and the fifth groups the COMPONENT table by cause,
// which is the totals table of the explain itself.
Database pnl_attribution::Store
(
   include position_keeping::Store
   include valuation_core::Store

   // ---------------------------------------------------------- the run

   // One attribution batch. Keyed by ATTRIBUTION_ID alone: it is what makes every line key
   // unique, so it cannot itself be keyed by anything below it. VALUATION_RUN_ID and
   // POSITION_RUN_SEQ are the two upstream runs it differenced -- the diamond, declared once
   // at the top before a single line is written.
   Table PNL_RUN
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      COB_DATE DATE NOT NULL,
      PRIOR_COB_DATE DATE,
      VALUATION_RUN_ID VARCHAR(20),
      PRIOR_VALUATION_RUN_ID VARCHAR(20),
      POSITION_RUN_SEQ INTEGER,
      METHOD_CODE VARCHAR(12),
      REPORTING_CCY CHAR(3),
      STATUS VARCHAR(12),
      LINE_COUNT SMALLINT,
      BROKEN_LINE_COUNT SMALLINT,
      TOTAL_PNL NUMERIC(20,6),
      TOTAL_RESIDUAL NUMERIC(20,6),
      STARTED_AT TIMESTAMP,
      IS_SIGNED_OFF BIT
   )

   // ---------------------------------------------------------- the grain

   // THE DIAMOND TABLE. Five primary key columns: the attribution run, plus position-keeping's
   // four-column position grain. Dropping ATTRIBUTION_ID would let a re-attribution overwrite
   // the answer it should sit beside; dropping any of the other four merges positions that
   // are genuinely different.
   //
   // INSTRUMENT_ID is VARCHAR(60) to match PK_POSITION rather than VC_VALUATION's VARCHAR(20),
   // because the wider of the two is the only one that cannot truncate.
   Table PNL_LINE
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      PRIOR_COB_DATE DATE,
      VALUATION_RUN_ID VARCHAR(20),
      PRIOR_VALUATION_RUN_ID VARCHAR(20),
      OPENING_QUANTITY NUMERIC(20,6),
      CLOSING_QUANTITY NUMERIC(20,6),
      OPENING_MARKET_VALUE NUMERIC(20,6),
      CLOSING_MARKET_VALUE NUMERIC(20,6),
      PRICE_EFFECT NUMERIC(20,6),
      FX_EFFECT NUMERIC(20,6),
      CARRY_EFFECT NUMERIC(20,6),
      FEE_EFFECT NUMERIC(20,6),
      TRADE_EFFECT NUMERIC(20,6),
      AMENDMENT_EFFECT NUMERIC(20,6),
      REALISED_PNL NUMERIC(20,6),
      UNREALISED_PNL NUMERIC(20,6),
      CLEAN_PNL NUMERIC(20,6),
      ACCRUED_PNL NUMERIC(20,6),
      PNL_CURRENCY CHAR(3),
      REPORTING_CCY CHAR(3),
      FX_RATE FLOAT,
      ATTRIBUTION_QUALITY FLOAT,
      IS_EXPLAINED BIT,
      METHOD_CODE VARCHAR(12)
   )

   // The reconciliation, on the line's own five columns: both market values, both rates, both
   // quantities. Its own table rather than more columns on PNL_LINE because it is read on its
   // own, the moment a residual is large.
   Table PNL_VALUE_BRIDGE
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      OPENING_VALUE NUMERIC(20,6),
      CLOSING_VALUE NUMERIC(20,6),
      OPENING_VALUE_REPORTING NUMERIC(20,6),
      CLOSING_VALUE_REPORTING NUMERIC(20,6),
      OPENING_FX_RATE FLOAT,
      CLOSING_FX_RATE FLOAT,
      OPENING_QUANTITY NUMERIC(20,6),
      CLOSING_QUANTITY NUMERIC(20,6),
      VALUE_CURRENCY CHAR(3),
      REPORTING_CCY CHAR(3)
   )

   // THE RESIDUAL. One row per line, and the row a control function works from.
   Table PNL_RESIDUAL
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      RESIDUAL_AMOUNT NUMERIC(20,6),
      RESIDUAL_PCT FLOAT,
      TOLERANCE_PCT FLOAT,
      TOLERANCE_AMOUNT NUMERIC(20,6),
      POLICY_CODE VARCHAR(24),
      IS_WITHIN_TOLERANCE BIT,
      EXPLAINED_ON DATE,
      EXPLAINED_BY VARCHAR(60),
      RESIDUAL_REASON VARCHAR(120)
   )

   // ---------------------------------------------------------- the components

   // SIX key columns: the line's five plus the cause. One table serves seven types -- the base
   // and six filter-subtypes -- so the columns after COMPUTED_SEQ are nullable and belong to
   // exactly one subtype each. A price effect has no use for FEE_RATE_BPS and never carries
   // one; the filter on COMPONENT_CODE is what makes that a type statement rather than a
   // convention.
   Table PNL_COMPONENT
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      COMPONENT_CODE VARCHAR(12) PRIMARY KEY,
      COMPONENT_AMOUNT NUMERIC(20,6),
      AMOUNT_IN_REPORTING NUMERIC(20,6),
      COMPONENT_CCY CHAR(3),
      FX_RATE FLOAT,
      CONTRIBUTION_PCT FLOAT,
      QUANTITY_USED NUMERIC(20,6),
      COMPUTED_SEQ SMALLINT,
      IS_ESTIMATED BIT,
      OPEN_PRICE NUMERIC(20,6),
      CLOSE_PRICE NUMERIC(20,6),
      OPEN_FX_RATE FLOAT,
      CLOSE_FX_RATE FLOAT,
      CARRY_TYPE VARCHAR(16),
      DAY_COUNT_FRACTION FLOAT,
      FEE_TYPE VARCHAR(16),
      FEE_RATE_BPS FLOAT,
      TRADE_COUNT SMALLINT,
      TRADED_QUANTITY NUMERIC(20,6),
      AMENDMENT_COUNT SMALLINT,
      RESTATED_FROM DATE
   )

   // The explain waterfall, one row per rung. The sixth key column is the STEP order, because
   // under a sequential method the order is part of the answer and not a display choice.
   Table PNL_EXPLAIN_STEP
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      STEP_SEQ SMALLINT PRIMARY KEY,
      STEP_CODE VARCHAR(16),
      STEP_LABEL VARCHAR(60),
      OPENING_BALANCE NUMERIC(20,6),
      STEP_AMOUNT NUMERIC(20,6),
      CLOSING_BALANCE NUMERIC(20,6),
      IS_SUBTOTAL BIT
   )

   // ---------------------------------------------------------- the two splits

   // Realised against unrealised, on the line's five columns.
   Table PNL_REALISED_SPLIT
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      REALISED_PNL NUMERIC(20,6),
      UNREALISED_PNL NUMERIC(20,6),
      REALISED_FROM_CLOSURES NUMERIC(20,6),
      OPENING_UNREALISED NUMERIC(20,6),
      CLOSING_UNREALISED NUMERIC(20,6),
      CLOSED_QUANTITY NUMERIC(20,6),
      MATCHING_METHOD VARCHAR(20)
   )

   // Clean against dirty, same five columns. COUPON_PAID is here because a coupon that pays
   // today resets accrued to zero and breaks the otherwise reliable identity between the
   // change in accrued and the accrued P&L.
   Table PNL_CLEAN_DIRTY
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      CLEAN_PNL NUMERIC(20,6),
      ACCRUED_PNL NUMERIC(20,6),
      DIRTY_PNL NUMERIC(20,6),
      OPENING_ACCRUED NUMERIC(20,6),
      CLOSING_ACCRUED NUMERIC(20,6),
      COUPON_PAID NUMERIC(20,6),
      DAY_COUNT_BASIS CHAR(7)
   )

   // ---------------------------------------------------------- the detail

   // Carry, one strand per row: the sixth key column is the KIND of carry, because netting a
   // coupon against a borrow fee produces a number nobody can take apart again.
   Table PNL_CARRY_ACCRUAL
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      CARRY_TYPE VARCHAR(16) PRIMARY KEY,
      ACCRUAL_AMOUNT NUMERIC(20,6),
      CARRY_RATE FLOAT,
      DAY_COUNT_FRACTION FLOAT,
      PERIOD_START_DATE DATE,
      PERIOD_END_DATE DATE,
      ACCRUAL_CCY CHAR(3),
      IS_PAID BIT
   )

   // One fee actually charged. The sixth key column is a sequence: a day carries several.
   Table PNL_FEE_CHARGE
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      FEE_SEQ SMALLINT PRIMARY KEY,
      FEE_TYPE VARCHAR(16),
      FEE_AMOUNT NUMERIC(20,6),
      FEE_CCY CHAR(3),
      FEE_RATE_BPS FLOAT,
      CHARGED_BY VARCHAR(60),
      INVOICE_REFERENCE VARCHAR(40),
      IS_ACCRUED BIT
   )

   // One trade's day-one P&L. The sixth key column is the booking reference, which is the same
   // string PK_POSITION_MOVEMENT carries -- MOVEMENT_SEQ then makes the join back exact.
   Table PNL_TRADE_PNL
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      TRADE_REFERENCE VARCHAR(60) PRIMARY KEY,
      TRADE_QUANTITY NUMERIC(20,6),
      TRADE_PRICE NUMERIC(20,6),
      TRADE_CASH NUMERIC(20,6),
      DAY_ONE_PNL NUMERIC(20,6),
      FEE_AMOUNT NUMERIC(20,6),
      TRADE_CCY CHAR(3),
      MOVEMENT_SEQ INTEGER,
      IS_SAME_DAY_CLOSE BIT
   )

   // A restatement of a prior day, booked into today. Both the before and the after are
   // columns, so the original figure survives the correction.
   Table PNL_AMENDMENT
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      AMENDMENT_SEQ SMALLINT PRIMARY KEY,
      AMENDMENT_TYPE VARCHAR(16),
      ORIGINAL_COB_DATE DATE,
      AMOUNT_BEFORE NUMERIC(20,6),
      AMOUNT_AFTER NUMERIC(20,6),
      REASON VARCHAR(200),
      RAISED_BY VARCHAR(60),
      APPROVED_BY VARCHAR(60),
      RAISED_ON DATE
   )

   // A breached residual with an owner. The sixth key column is the break code, so the same
   // kind of break cannot be raised twice on one line.
   Table PNL_BREAK
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      INSTRUMENT_ID VARCHAR(60) PRIMARY KEY,
      COB_DATE DATE PRIMARY KEY,
      BREAK_CODE VARCHAR(24) PRIMARY KEY,
      POLICY_CODE VARCHAR(24),
      SEVERITY SMALLINT,
      BREAK_AMOUNT NUMERIC(20,6),
      BREAK_PCT FLOAT,
      DETECTED_ON DATE,
      RESOLVED_ON DATE,
      ASSIGNED_TO VARCHAR(60)
   )

   // ---------------------------------------------------------- the policy layer

   // The tolerance a residual is held to. Stated as a percentage AND an absolute floor.
   Table PNL_TOLERANCE_POLICY
   (
      POLICY_CODE VARCHAR(24) PRIMARY KEY,
      ASSET_CLASS VARCHAR(12),
      METHOD_CODE VARCHAR(12),
      RESIDUAL_TOLERANCE_PCT FLOAT,
      RESIDUAL_TOLERANCE_AMOUNT NUMERIC(20,6),
      ESCALATION_LEVEL SMALLINT,
      IS_DEFAULT BIT
   )

   // The algorithm that split the day. EXPECTED_RESIDUAL_PCT is FLOAT and is the honest part:
   // a method that drops cross terms cannot reconcile to zero and says so here.
   Table PNL_METHOD
   (
      METHOD_CODE VARCHAR(12) PRIMARY KEY,
      METHOD_NAME VARCHAR(60) NOT NULL,
      EFFECT_ORDER VARCHAR(60),
      IS_SEQUENTIAL BIT,
      CROSS_TERM_HANDLING VARCHAR(20),
      EXPECTED_RESIDUAL_PCT FLOAT
   )

   // One role's acceptance of a run.
   Table PNL_SIGN_OFF
   (
      ATTRIBUTION_ID VARCHAR(24) PRIMARY KEY,
      SIGN_OFF_SEQ SMALLINT PRIMARY KEY,
      SIGN_OFF_ROLE VARCHAR(30),
      SIGNED_BY VARCHAR(60),
      SIGNED_ON DATE,
      COMMENTARY VARCHAR(200),
      IS_FINAL BIT
   )

   // ---------------------------------------------------------- THE AGGREGATIONS

   // One row per account per day per run: a desk's daily report, without reading a line.
   View PNL_ACCOUNT_DAY_TOTAL
   (
      ~groupBy
      (
         PNL_LINE.ATTRIBUTION_ID,
         PNL_LINE.INSTITUTION_ID,
         PNL_LINE.ACCOUNT_NO,
         PNL_LINE.COB_DATE
      )
      ATTRIBUTION_ID: PNL_LINE.ATTRIBUTION_ID PRIMARY KEY,
      INSTITUTION_ID: PNL_LINE.INSTITUTION_ID PRIMARY KEY,
      ACCOUNT_NO: PNL_LINE.ACCOUNT_NO PRIMARY KEY,
      COB_DATE: PNL_LINE.COB_DATE PRIMARY KEY,
      LINE_COUNT: count(PNL_LINE.INSTRUMENT_ID),
      TOTAL_OPENING_VALUE: sum(PNL_LINE.OPENING_MARKET_VALUE),
      TOTAL_CLOSING_VALUE: sum(PNL_LINE.CLOSING_MARKET_VALUE),
      TOTAL_PRICE_EFFECT: sum(PNL_LINE.PRICE_EFFECT),
      TOTAL_FX_EFFECT: sum(PNL_LINE.FX_EFFECT),
      TOTAL_CARRY_EFFECT: sum(PNL_LINE.CARRY_EFFECT),
      TOTAL_FEE_EFFECT: sum(PNL_LINE.FEE_EFFECT),
      TOTAL_TRADE_EFFECT: sum(PNL_LINE.TRADE_EFFECT),
      TOTAL_AMENDMENT_EFFECT: sum(PNL_LINE.AMENDMENT_EFFECT),
      TOTAL_REALISED_PNL: sum(PNL_LINE.REALISED_PNL),
      TOTAL_UNREALISED_PNL: sum(PNL_LINE.UNREALISED_PNL)
   )

   // One row per instrument per day, ACROSS accounts. The grouping drops the account, which is
   // the whole question: what did the firm make on this security.
   View PNL_INSTRUMENT_DAY_TOTAL
   (
      ~groupBy
      (
         PNL_LINE.ATTRIBUTION_ID,
         PNL_LINE.INSTRUMENT_ID,
         PNL_LINE.COB_DATE
      )
      ATTRIBUTION_ID: PNL_LINE.ATTRIBUTION_ID PRIMARY KEY,
      INSTRUMENT_ID: PNL_LINE.INSTRUMENT_ID PRIMARY KEY,
      COB_DATE: PNL_LINE.COB_DATE PRIMARY KEY,
      ACCOUNT_COUNT: count(PNL_LINE.ACCOUNT_NO),
      TOTAL_OPENING_VALUE: sum(PNL_LINE.OPENING_MARKET_VALUE),
      TOTAL_CLOSING_VALUE: sum(PNL_LINE.CLOSING_MARKET_VALUE),
      TOTAL_PRICE_EFFECT: sum(PNL_LINE.PRICE_EFFECT),
      TOTAL_FX_EFFECT: sum(PNL_LINE.FX_EFFECT),
      TOTAL_CARRY_EFFECT: sum(PNL_LINE.CARRY_EFFECT),
      TOTAL_FEE_EFFECT: sum(PNL_LINE.FEE_EFFECT),
      TOTAL_TRADE_EFFECT: sum(PNL_LINE.TRADE_EFFECT),
      TOTAL_AMENDMENT_EFFECT: sum(PNL_LINE.AMENDMENT_EFFECT),
      TOTAL_REALISED_PNL: sum(PNL_LINE.REALISED_PNL),
      TOTAL_UNREALISED_PNL: sum(PNL_LINE.UNREALISED_PNL)
   )

   // One row per currency per run. The grouping drops the account, the instrument AND the
   // date -- the cut a treasury desk reads.
   View PNL_CURRENCY_TOTAL
   (
      ~groupBy
      (
         PNL_LINE.ATTRIBUTION_ID,
         PNL_LINE.PNL_CURRENCY
      )
      ATTRIBUTION_ID: PNL_LINE.ATTRIBUTION_ID PRIMARY KEY,
      PNL_CURRENCY: PNL_LINE.PNL_CURRENCY PRIMARY KEY,
      LINE_COUNT: count(PNL_LINE.INSTRUMENT_ID),
      TOTAL_CLOSING_VALUE: sum(PNL_LINE.CLOSING_MARKET_VALUE),
      TOTAL_FX_EFFECT: sum(PNL_LINE.FX_EFFECT),
      TOTAL_PRICE_EFFECT: sum(PNL_LINE.PRICE_EFFECT),
      TOTAL_REALISED_PNL: sum(PNL_LINE.REALISED_PNL),
      TOTAL_UNREALISED_PNL: sum(PNL_LINE.UNREALISED_PNL)
   )

   // The whole run as one row. The grouping keeps only the attribution id -- the firm-level
   // explain, and the row a sign-off is actually decided on.
   View PNL_RUN_TOTAL
   (
      ~groupBy
      (
         PNL_LINE.ATTRIBUTION_ID
      )
      ATTRIBUTION_ID: PNL_LINE.ATTRIBUTION_ID PRIMARY KEY,
      LINE_COUNT: count(PNL_LINE.INSTRUMENT_ID),
      ACCOUNT_COUNT: count(PNL_LINE.ACCOUNT_NO),
      TOTAL_OPENING_VALUE: sum(PNL_LINE.OPENING_MARKET_VALUE),
      TOTAL_CLOSING_VALUE: sum(PNL_LINE.CLOSING_MARKET_VALUE),
      TOTAL_PRICE_EFFECT: sum(PNL_LINE.PRICE_EFFECT),
      TOTAL_FX_EFFECT: sum(PNL_LINE.FX_EFFECT),
      TOTAL_CARRY_EFFECT: sum(PNL_LINE.CARRY_EFFECT),
      TOTAL_FEE_EFFECT: sum(PNL_LINE.FEE_EFFECT),
      TOTAL_TRADE_EFFECT: sum(PNL_LINE.TRADE_EFFECT),
      TOTAL_AMENDMENT_EFFECT: sum(PNL_LINE.AMENDMENT_EFFECT),
      TOTAL_REALISED_PNL: sum(PNL_LINE.REALISED_PNL),
      TOTAL_UNREALISED_PNL: sum(PNL_LINE.UNREALISED_PNL)
   )

   // The only view grouped out of the COMPONENT table rather than the line table, and so the
   // only one that answers "how much of the firm's day was FX". max() and min() come with the
   // total because a total of zero built from two enormous opposite numbers is not zero in any
   // sense a reader cares about.
   View PNL_COMPONENT_TOTAL
   (
      ~groupBy
      (
         PNL_COMPONENT.ATTRIBUTION_ID,
         PNL_COMPONENT.COMPONENT_CODE
      )
      ATTRIBUTION_ID: PNL_COMPONENT.ATTRIBUTION_ID PRIMARY KEY,
      COMPONENT_CODE: PNL_COMPONENT.COMPONENT_CODE PRIMARY KEY,
      COMPONENT_COUNT: count(PNL_COMPONENT.INSTRUMENT_ID),
      TOTAL_AMOUNT: sum(PNL_COMPONENT.COMPONENT_AMOUNT),
      TOTAL_IN_REPORTING: sum(PNL_COMPONENT.AMOUNT_IN_REPORTING),
      LARGEST_AMOUNT: max(PNL_COMPONENT.COMPONENT_AMOUNT),
      SMALLEST_AMOUNT: min(PNL_COMPONENT.COMPONENT_AMOUNT)
   )

   // ---------------------------------------------------------- THE DIAMOND JOINS
   //
   // Four joins, two tables, two dates. This is the entire point of the project: the left
   // half of each pair reaches position-keeping (and through it the instrument master), the
   // right half reaches valuation-core (and through it prices and rates), and both halves
   // agree because they match on the same INSTRUMENT_ID column of the same row.

   // Today, position side. All four position columns -- anything less crosses accounts,
   // securities or dates.
   Join Pnl_LinePosition(PNL_LINE.INSTITUTION_ID = PK_POSITION.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PK_POSITION.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PK_POSITION.INSTRUMENT_ID and PNL_LINE.COB_DATE = PK_POSITION.COB_DATE)
   // Yesterday, position side. Same four columns, but PRIOR_COB_DATE against the position's
   // COB_DATE -- which is only possible because position-keeping keeps yesterday's row.
   Join Pnl_LinePriorPosition(PNL_LINE.INSTITUTION_ID = PK_POSITION.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PK_POSITION.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PK_POSITION.INSTRUMENT_ID and PNL_LINE.PRIOR_COB_DATE = PK_POSITION.COB_DATE)
   // Today, valuation side. The valuation's whole three-column key: run, instrument and date.
   // Dropping the run would match the overnight mark and the intraday re-run at once.
   Join Pnl_LineValuation(PNL_LINE.VALUATION_RUN_ID = VC_VALUATION.RUN_ID and PNL_LINE.INSTRUMENT_ID = VC_VALUATION.INSTRUMENT_ID and PNL_LINE.COB_DATE = VC_VALUATION.COB_DATE)
   // Yesterday, valuation side. A DIFFERENT run id as well as a different date, because the
   // prior day's marks came out of the prior day's batch.
   Join Pnl_LineOpeningValuation(PNL_LINE.PRIOR_VALUATION_RUN_ID = VC_VALUATION.RUN_ID and PNL_LINE.INSTRUMENT_ID = VC_VALUATION.INSTRUMENT_ID and PNL_LINE.PRIOR_COB_DATE = VC_VALUATION.COB_DATE)

   // ---------------------------------------------------------- other cross-project joins

   // Into position-keeping's own aggregation: the day's movements, already grouped. Comparing
   // its NET_QUANTITY_DELTA against this line's quantity change is what separates a trade
   // effect from a price effect, and it costs one grouped read.
   Join Pnl_LineMovementTotal(PNL_LINE.INSTITUTION_ID = PK_MOVEMENT_TOTAL.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PK_MOVEMENT_TOTAL.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PK_MOVEMENT_TOTAL.INSTRUMENT_ID and PNL_LINE.COB_DATE = PK_MOVEMENT_TOTAL.COB_DATE)
   // Into the holding history, date dropped -- context for a line whose residual is large.
   Join Pnl_LineLifetime(PNL_LINE.INSTITUTION_ID = PK_POSITION_LIFETIME.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PK_POSITION_LIFETIME.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PK_POSITION_LIFETIME.INSTRUMENT_ID)
   // Into valuation-core's accrual, on instrument and date. The run is deliberately not part
   // of it: two runs on one date accrue the same amount.
   Join Pnl_LineAccrual(PNL_LINE.INSTRUMENT_ID = VC_ACCRUAL.INSTRUMENT_ID and PNL_LINE.COB_DATE = VC_ACCRUAL.COB_DATE)
   // The carry strand to the accrual it should reconcile against.
   Join Pnl_CarryAccrualSource(PNL_CARRY_ACCRUAL.INSTRUMENT_ID = VC_ACCRUAL.INSTRUMENT_ID and PNL_CARRY_ACCRUAL.COB_DATE = VC_ACCRUAL.COB_DATE)
   // A day-one P&L row back to the movement that caused it: the position's four columns plus
   // the movement sequence, which is five.
   Join Pnl_TradePnlMovement(PNL_TRADE_PNL.INSTITUTION_ID = PK_POSITION_MOVEMENT.INSTITUTION_ID and PNL_TRADE_PNL.ACCOUNT_NO = PK_POSITION_MOVEMENT.ACCOUNT_NO and PNL_TRADE_PNL.INSTRUMENT_ID = PK_POSITION_MOVEMENT.INSTRUMENT_ID and PNL_TRADE_PNL.COB_DATE = PK_POSITION_MOVEMENT.COB_DATE and PNL_TRADE_PNL.MOVEMENT_SEQ = PK_POSITION_MOVEMENT.MOVEMENT_SEQ)
   // The run to both upstream runs -- the diamond at batch level.
   Join Pnl_RunValuationRun(PNL_RUN.VALUATION_RUN_ID = VC_VALUATION_RUN.RUN_ID)
   Join Pnl_RunPositionRun(PNL_RUN.COB_DATE = PK_RUN.COB_DATE and PNL_RUN.POSITION_RUN_SEQ = PK_RUN.RUN_SEQ)

   // CROSS-PROJECT, VIEW TO VIEW. A P&L group reaching a position group -- neither side reads
   // a row, and the two GROUP BYs line up column for column because both projects grain the
   // account on two columns and the security on one.
   Join Pnl_AccountDayTotalPositionTotal(PNL_ACCOUNT_DAY_TOTAL.INSTITUTION_ID = PK_ACCOUNT_DAY_TOTAL.INSTITUTION_ID and PNL_ACCOUNT_DAY_TOTAL.ACCOUNT_NO = PK_ACCOUNT_DAY_TOTAL.ACCOUNT_NO and PNL_ACCOUNT_DAY_TOTAL.COB_DATE = PK_ACCOUNT_DAY_TOTAL.COB_DATE)
   Join Pnl_InstrumentDayTotalPositionTotal(PNL_INSTRUMENT_DAY_TOTAL.INSTRUMENT_ID = PK_INSTRUMENT_DAY_TOTAL.INSTRUMENT_ID and PNL_INSTRUMENT_DAY_TOTAL.COB_DATE = PK_INSTRUMENT_DAY_TOTAL.COB_DATE)
   // CROSS-PROJECT from a group into valuation-core: a currency subtotal to the reporting
   // currency's rounding rule, so a subtotal is rounded the way a valuation of it is.
   Join Pnl_CurrencyTotalReportingCurrency(PNL_CURRENCY_TOTAL.PNL_CURRENCY = VC_REPORTING_CURRENCY.CURRENCY_CODE)

   // ---------------------------------------------------------- joins within this project

   // The run to everything it produced. Used in both directions.
   Join Pnl_RunLines(PNL_RUN.ATTRIBUTION_ID = PNL_LINE.ATTRIBUTION_ID)
   Join Pnl_RunSignOffs(PNL_RUN.ATTRIBUTION_ID = PNL_SIGN_OFF.ATTRIBUTION_ID)
   Join Pnl_RunMethod(PNL_RUN.METHOD_CODE = PNL_METHOD.METHOD_CODE)
   Join Pnl_LineMethod(PNL_LINE.METHOD_CODE = PNL_METHOD.METHOD_CODE)

   // Five columns from the line to each of its children. Anything less crosses runs, accounts,
   // securities or dates.
   Join Pnl_LineComponents(PNL_LINE.ATTRIBUTION_ID = PNL_COMPONENT.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_COMPONENT.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_COMPONENT.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_COMPONENT.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_COMPONENT.COB_DATE)
   Join Pnl_LineExplainSteps(PNL_LINE.ATTRIBUTION_ID = PNL_EXPLAIN_STEP.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_EXPLAIN_STEP.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_EXPLAIN_STEP.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_EXPLAIN_STEP.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_EXPLAIN_STEP.COB_DATE)
   Join Pnl_LineResidual(PNL_LINE.ATTRIBUTION_ID = PNL_RESIDUAL.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_RESIDUAL.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_RESIDUAL.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_RESIDUAL.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_RESIDUAL.COB_DATE)
   Join Pnl_LineValueBridge(PNL_LINE.ATTRIBUTION_ID = PNL_VALUE_BRIDGE.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_VALUE_BRIDGE.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_VALUE_BRIDGE.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_VALUE_BRIDGE.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_VALUE_BRIDGE.COB_DATE)
   Join Pnl_LineRealisedSplit(PNL_LINE.ATTRIBUTION_ID = PNL_REALISED_SPLIT.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_REALISED_SPLIT.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_REALISED_SPLIT.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_REALISED_SPLIT.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_REALISED_SPLIT.COB_DATE)
   Join Pnl_LineCleanDirty(PNL_LINE.ATTRIBUTION_ID = PNL_CLEAN_DIRTY.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_CLEAN_DIRTY.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_CLEAN_DIRTY.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_CLEAN_DIRTY.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_CLEAN_DIRTY.COB_DATE)
   Join Pnl_LineCarryAccruals(PNL_LINE.ATTRIBUTION_ID = PNL_CARRY_ACCRUAL.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_CARRY_ACCRUAL.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_CARRY_ACCRUAL.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_CARRY_ACCRUAL.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_CARRY_ACCRUAL.COB_DATE)
   Join Pnl_LineFeeCharges(PNL_LINE.ATTRIBUTION_ID = PNL_FEE_CHARGE.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_FEE_CHARGE.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_FEE_CHARGE.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_FEE_CHARGE.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_FEE_CHARGE.COB_DATE)
   Join Pnl_LineTradePnl(PNL_LINE.ATTRIBUTION_ID = PNL_TRADE_PNL.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_TRADE_PNL.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_TRADE_PNL.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_TRADE_PNL.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_TRADE_PNL.COB_DATE)
   Join Pnl_LineAmendments(PNL_LINE.ATTRIBUTION_ID = PNL_AMENDMENT.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_AMENDMENT.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_AMENDMENT.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_AMENDMENT.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_AMENDMENT.COB_DATE)
   Join Pnl_LineBreaks(PNL_LINE.ATTRIBUTION_ID = PNL_BREAK.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_BREAK.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_BREAK.ACCOUNT_NO and PNL_LINE.INSTRUMENT_ID = PNL_BREAK.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_BREAK.COB_DATE)

   // The policy layer.
   Join Pnl_ResidualPolicy(PNL_RESIDUAL.POLICY_CODE = PNL_TOLERANCE_POLICY.POLICY_CODE)
   Join Pnl_BreakPolicy(PNL_BREAK.POLICY_CODE = PNL_TOLERANCE_POLICY.POLICY_CODE)
   Join Pnl_PolicyMethod(PNL_TOLERANCE_POLICY.METHOD_CODE = PNL_METHOD.METHOD_CODE)

   // ---------------------------------------------------------- joins INTO the aggregations
   //
   // Each of these crosses from rows to groups. A line reaches its book's day, its security's
   // day, its currency and its whole run; a component reaches its cause's total. None of them
   // reads another line.
   Join Pnl_LineAccountDayTotal(PNL_LINE.ATTRIBUTION_ID = PNL_ACCOUNT_DAY_TOTAL.ATTRIBUTION_ID and PNL_LINE.INSTITUTION_ID = PNL_ACCOUNT_DAY_TOTAL.INSTITUTION_ID and PNL_LINE.ACCOUNT_NO = PNL_ACCOUNT_DAY_TOTAL.ACCOUNT_NO and PNL_LINE.COB_DATE = PNL_ACCOUNT_DAY_TOTAL.COB_DATE)
   Join Pnl_LineInstrumentDayTotal(PNL_LINE.ATTRIBUTION_ID = PNL_INSTRUMENT_DAY_TOTAL.ATTRIBUTION_ID and PNL_LINE.INSTRUMENT_ID = PNL_INSTRUMENT_DAY_TOTAL.INSTRUMENT_ID and PNL_LINE.COB_DATE = PNL_INSTRUMENT_DAY_TOTAL.COB_DATE)
   Join Pnl_LineCurrencyTotal(PNL_LINE.ATTRIBUTION_ID = PNL_CURRENCY_TOTAL.ATTRIBUTION_ID and PNL_LINE.PNL_CURRENCY = PNL_CURRENCY_TOTAL.PNL_CURRENCY)
   Join Pnl_LineRunTotal(PNL_LINE.ATTRIBUTION_ID = PNL_RUN_TOTAL.ATTRIBUTION_ID)
   Join Pnl_RunRunTotal(PNL_RUN.ATTRIBUTION_ID = PNL_RUN_TOTAL.ATTRIBUTION_ID)
   Join Pnl_ComponentComponentTotal(PNL_COMPONENT.ATTRIBUTION_ID = PNL_COMPONENT_TOTAL.ATTRIBUTION_ID and PNL_COMPONENT.COMPONENT_CODE = PNL_COMPONENT_TOTAL.COMPONENT_CODE)
   Join Pnl_RunComponentTotals(PNL_RUN.ATTRIBUTION_ID = PNL_COMPONENT_TOTAL.ATTRIBUTION_ID)

   // ---------------------------------------------------------- filters
   //
   // Six of these back the six filter-subtypes of PnlComponent: one table, one discriminator,
   // six types. String comparisons, not boolean literals -- a Filter will not take `= true`
   // and fails with `Unexpected token 'true'`.
   Filter PnlPriceRows(PNL_COMPONENT.COMPONENT_CODE = 'PRICE')
   Filter PnlFxRows(PNL_COMPONENT.COMPONENT_CODE = 'FX')
   Filter PnlCarryRows(PNL_COMPONENT.COMPONENT_CODE = 'CARRY')
   Filter PnlFeeRows(PNL_COMPONENT.COMPONENT_CODE = 'FEE')
   Filter PnlNewTradeRows(PNL_COMPONENT.COMPONENT_CODE = 'TRADE')
   Filter PnlAmendmentRows(PNL_COMPONENT.COMPONENT_CODE = 'AMEND')
   // Null tests, for the same reason.
   Filter PnlUnexplainedResiduals(PNL_RESIDUAL.EXPLAINED_ON is null)
   Filter PnlOpenBreaks(PNL_BREAK.RESOLVED_ON is null)
)
