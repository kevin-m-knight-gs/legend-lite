   // ------------------------------------------------------------ THE AGGREGATE SETS
   //
   // Rooted on views. The primary key IS the ~groupBy, so an instance is a group and never a
   // line. Two of them reach position-keeping's own groups -- view to view, across a project
   // boundary, without either side reading a row.

   pnl_attribution::PnlAccountDayTotal[pnlAccountDayTotal]: Relational
   {
      ~primaryKey
      (
         [pnl_attribution::Store]PNL_ACCOUNT_DAY_TOTAL.ATTRIBUTION_ID,
         [pnl_attribution::Store]PNL_ACCOUNT_DAY_TOTAL.INSTITUTION_ID,
         [pnl_attribution::Store]PNL_ACCOUNT_DAY_TOTAL.ACCOUNT_NO,
         [pnl_attribution::Store]PNL_ACCOUNT_DAY_TOTAL.COB_DATE
      )
      ~mainTable [pnl_attribution::Store]PNL_ACCOUNT_DAY_TOTAL
      attributionId: [pnl_attribution::Store]PNL_ACCOUNT_DAY_TOTAL.ATTRIBUTION_ID,
      institutionId: [pnl_attribution::Store]PNL_ACCOUNT_DAY_TOTAL.INSTITUTION_ID,
      accountNo: [pnl_attribution::Store]PNL_ACCOUNT_DAY_TOTAL.ACCOUNT_NO,
      cobDate: [pnl_attribution::Store]PNL_ACCOUNT_DAY_TOTAL.COB_DATE,
      scope([pnl_attribution::Store]PNL_ACCOUNT_DAY_TOTAL)
      (
         lineCount: LINE_COUNT,
         totalOpeningValue: TOTAL_OPENING_VALUE,
         totalClosingValue: TOTAL_CLOSING_VALUE,
         totalPriceEffect: TOTAL_PRICE_EFFECT,
         totalFxEffect: TOTAL_FX_EFFECT,
         totalCarryEffect: TOTAL_CARRY_EFFECT,
         totalFeeEffect: TOTAL_FEE_EFFECT,
         totalTradeEffect: TOTAL_TRADE_EFFECT,
         totalAmendmentEffect: TOTAL_AMENDMENT_EFFECT,
         totalRealisedPnl: TOTAL_REALISED_PNL,
         totalUnrealisedPnl: TOTAL_UNREALISED_PNL
      ),
      lines[pnlLine]: [pnl_attribution::Store]@Pnl_LineAccountDayTotal,
      // CROSS-PROJECT, GROUP TO GROUP.
      positionTotal[pkAccountDayTotal]: [pnl_attribution::Store]@Pnl_AccountDayTotalPositionTotal
   }

   pnl_attribution::PnlInstrumentDayTotal[pnlInstrumentDayTotal]: Relational
   {
