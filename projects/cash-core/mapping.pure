   // Two account properties, two DIFFERENT joins, one target table. Getting these the wrong
   // way round is the classic sweep bug, and the mapping is where it is prevented.
   cash_core::CshSweepRule[cshSweepRule]: Relational
   {
      ~primaryKey
      (
         [cash_core::Store]CSH_SWEEP_RULE.SOURCE_INSTITUTION_ID,
         [cash_core::Store]CSH_SWEEP_RULE.SOURCE_ACCOUNT_NO,
         [cash_core::Store]CSH_SWEEP_RULE.RULE_SEQ
      )
      ~mainTable [cash_core::Store]CSH_SWEEP_RULE
      sourceInstitutionId: [cash_core::Store]CSH_SWEEP_RULE.SOURCE_INSTITUTION_ID,
      sourceAccountNo: [cash_core::Store]CSH_SWEEP_RULE.SOURCE_ACCOUNT_NO,
      ruleSeq: [cash_core::Store]CSH_SWEEP_RULE.RULE_SEQ,
      poolId: [cash_core::Store]CSH_SWEEP_RULE.POOL_ID,
      targetInstitutionId: [cash_core::Store]CSH_SWEEP_RULE.TARGET_INSTITUTION_ID,
      targetAccountNo: [cash_core::Store]CSH_SWEEP_RULE.TARGET_ACCOUNT_NO,
      sweepCurrency: EnumerationMapping CshCurrencyMapping: [cash_core::Store]CSH_SWEEP_RULE.SWEEP_CURRENCY,
      sweepType: [cash_core::Store]CSH_SWEEP_RULE.SWEEP_TYPE,
      targetBalance: [cash_core::Store]CSH_SWEEP_RULE.TARGET_BALANCE,
      minimumAmount: [cash_core::Store]CSH_SWEEP_RULE.MINIMUM_AMOUNT,
      frequency: [cash_core::Store]CSH_SWEEP_RULE.FREQUENCY,
      cutoffTime: [cash_core::Store]CSH_SWEEP_RULE.CUTOFF_TIME,
      activatedOn: [cash_core::Store]CSH_SWEEP_RULE.ACTIVATED_ON,
      deactivatedOn: [cash_core::Store]CSH_SWEEP_RULE.DEACTIVATED_ON,
      sourceAccount: [cash_core::Store]@Csh_SweepRuleSourceAccount,
      targetAccount: [cash_core::Store]@Csh_SweepRuleTargetAccount,
      pool: [cash_core::Store]@Csh_PoolSweepRules,
      executions: [cash_core::Store]@Csh_SweepRuleExecutions
   }

   cash_core::CshSweepExecution[cshSweepExecution]: Relational
