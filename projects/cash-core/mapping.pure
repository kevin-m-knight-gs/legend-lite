###Mapping
// The cash book's mapping. Three things to notice.
//
// CshCurrencyMapping is an EnumerationMapping for an enum that belongs to ANOTHER PROJECT:
// core_types::CtCurrency. The database stores ISO 4217 codes -- alpha in our own feeds,
// numeric in the ISO 20022 ones -- and this is the single place either of them is turned
// into the upstream enum. Nothing downstream ever sees a currency String. CshCountryMapping
// does the same for core_types::CtCountry, and is applied INSIDE an embedded block.
//
// `paymentReference ( ... orderingParty ( ... ) )` on the movement and again on the
// statement line is an EMBEDDED property mapping. The properties are complex-typed but
// their columns are on CSH_CASH_MOVEMENT and CSH_STATEMENT_LINE respectively, so no join is
// emitted for them: reading who sent a payment costs nothing beyond reading the movement.
// The same value type is embedded on two different tables, which is the point of it being
// a value type and not a table.
//
// `include core_account::Mapping` brings in the caAccount set implementation, which is what
// every `account:` property below resolves to across the join.
Mapping cash_core::Mapping
(
   include core_account::Mapping

   // ---- the cross-project enum transformers ----
   // Both source forms are listed for each value because a cash book reads more than one
   // feed: our own files carry 'USD', an ISO 20022 message carries '840'.
   core_types::CtCurrency: EnumerationMapping CshCurrencyMapping
   {
      USD: ['USD', '840'],
      EUR: ['EUR', '978'],
      GBP: ['GBP', '826'],
      CHF: ['CHF', '756'],
      CAD: ['CAD', '124'],
      AUD: ['AUD', '036'],
      SEK: ['SEK', '752'],
      NOK: ['NOK', '578'],
      CNY: ['CNY', '156'],
      SGD: ['SGD', '702'],
      HKD: ['HKD', '344'],
      INR: ['INR', '356'],
      BRL: ['BRL', '986'],
      MXN: ['MXN', '484'],
      ZAR: ['ZAR', '710'],
      JPY: ['JPY', '392'],
      KRW: ['KRW', '410'],
      CLP: ['CLP', '152'],
      ISK: ['ISK', '352'],
      VND: ['VND', '704'],
      KWD: ['KWD', '414'],
      BHD: ['BHD', '048'],
      JOD: ['JOD', '400'],
      OMR: ['OMR', '512'],
      TND: ['TND', '788']
   }

   core_types::CtCountry: EnumerationMapping CshCountryMapping
   {
      US: ['US'],
      GB: ['GB'],
      DE: ['DE'],
      FR: ['FR'],
      CH: ['CH'],
      CA: ['CA'],
      AU: ['AU'],
      SE: ['SE'],
      NO: ['NO'],
      CN: ['CN'],
      SG: ['SG'],
      HK: ['HK'],
      IN: ['IN'],
      BR: ['BR'],
      MX: ['MX'],
      ZA: ['ZA'],
      JP: ['JP'],
      KR: ['KR'],
      CL: ['CL'],
      IS: ['IS'],
      VN: ['VN'],
      KW: ['KW'],
      BH: ['BH'],
      JO: ['JO'],
      OM: ['OM'],
      TN: ['TN']
   }

   // ---- the cash book ----
   cash_core::CshCashAccountProfile[cshCashAccountProfile]: Relational
   {
      ~primaryKey
      (
         [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.INSTITUTION_ID,
         [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.ACCOUNT_NO
      )
      ~mainTable [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE
      institutionId: [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.INSTITUTION_ID,
      accountNo: [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.ACCOUNT_NO,
      baseCurrency: EnumerationMapping CshCurrencyMapping: [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.BASE_CURRENCY,
      cashAccountType: [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.CASH_ACCOUNT_TYPE,
      overdraftLimit: [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.OVERDRAFT_LIMIT,
      cutoffTime: [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.CUTOFF_TIME,
      isSweepable: [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.IS_SWEEPABLE,
      poolId: [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.POOL_ID,
      openedForCashOn: [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.OPENED_FOR_CASH_ON,
      closedForCashOn: [cash_core::Store]CSH_CASH_ACCOUNT_PROFILE.CLOSED_FOR_CASH_ON,
      account: [cash_core::Store]@Csh_ProfileAccount,
      pool: [cash_core::Store]@Csh_PoolMembers,
      movements: [cash_core::Store]@Csh_MovementProfile,
      balances: [cash_core::Store]@Csh_BalanceProfile
   }

   // The embedded payment reference is the whole reason CSH_CASH_MOVEMENT is wide.
   cash_core::CshCashMovement[cshCashMovement]: Relational
   {
      ~primaryKey
      (
         [cash_core::Store]CSH_CASH_MOVEMENT.INSTITUTION_ID,
         [cash_core::Store]CSH_CASH_MOVEMENT.ACCOUNT_NO,
         [cash_core::Store]CSH_CASH_MOVEMENT.MOVEMENT_ID
      )
      ~mainTable [cash_core::Store]CSH_CASH_MOVEMENT
      institutionId: [cash_core::Store]CSH_CASH_MOVEMENT.INSTITUTION_ID,
      accountNo: [cash_core::Store]CSH_CASH_MOVEMENT.ACCOUNT_NO,
      movementId: [cash_core::Store]CSH_CASH_MOVEMENT.MOVEMENT_ID,
      direction: [cash_core::Store]CSH_CASH_MOVEMENT.DIRECTION,
      amount: [cash_core::Store]CSH_CASH_MOVEMENT.AMOUNT,
      currency: EnumerationMapping CshCurrencyMapping: [cash_core::Store]CSH_CASH_MOVEMENT.CURRENCY_CODE,
      valueDate: [cash_core::Store]CSH_CASH_MOVEMENT.VALUE_DATE,
      bookingDate: [cash_core::Store]CSH_CASH_MOVEMENT.BOOKING_DATE,
      status: [cash_core::Store]CSH_CASH_MOVEMENT.STATUS,
      movementType: [cash_core::Store]CSH_CASH_MOVEMENT.MOVEMENT_TYPE,
      sourceSystem: [cash_core::Store]CSH_CASH_MOVEMENT.SOURCE_SYSTEM,
      reconciledOn: [cash_core::Store]CSH_CASH_MOVEMENT.RECONCILED_ON,
      reversalOf: [cash_core::Store]CSH_CASH_MOVEMENT.REVERSAL_OF,
      paymentReference
      (
         endToEndId: [cash_core::Store]CSH_CASH_MOVEMENT.PAY_END_TO_END_ID,
         instructionId: [cash_core::Store]CSH_CASH_MOVEMENT.PAY_INSTRUCTION_ID,
         scheme: [cash_core::Store]CSH_CASH_MOVEMENT.PAY_SCHEME,
         purposeCode: [cash_core::Store]CSH_CASH_MOVEMENT.PAY_PURPOSE_CODE,
         remittanceInfo: [cash_core::Store]CSH_CASH_MOVEMENT.PAY_REMITTANCE_INFO,
         chargeBearer: [cash_core::Store]CSH_CASH_MOVEMENT.PAY_CHARGE_BEARER,
         orderingParty
         (
            partyName: [cash_core::Store]CSH_CASH_MOVEMENT.PAY_ORD_NAME,
            bic: [cash_core::Store]CSH_CASH_MOVEMENT.PAY_ORD_BIC,
            partyAccount: [cash_core::Store]CSH_CASH_MOVEMENT.PAY_ORD_ACCOUNT,
            country: EnumerationMapping CshCountryMapping: [cash_core::Store]CSH_CASH_MOVEMENT.PAY_ORD_COUNTRY
         )
      ),
      account: [cash_core::Store]@Csh_MovementAccount,
      profile: [cash_core::Store]@Csh_MovementProfile,
      statusHistory: [cash_core::Store]@Csh_MovementStatusEvents
   }

