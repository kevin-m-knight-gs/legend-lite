###Relational
// The cash book's tables. Three things to notice.
//
// `include core_account::Store` brings CA_ACCOUNT into scope so the joins below can reach
// it. Without the include the join conditions would not resolve -- there is no import in
// Legend, and a Database only sees the tables it declares or includes.
//
// EVERY join to CA_ACCOUNT matches TWO columns, because core-account keys an account by
// (INSTITUTION_ID, ACCOUNT_NO). Csh_SweepRuleSourceAccount and Csh_SweepRuleTargetAccount
// are two separate two-column joins from the SAME table to the SAME table, because a sweep
// rule names two accounts and they must not be confused with each other.
//
// CSH_CASH_MOVEMENT and CSH_STATEMENT_LINE are both WIDE at the PAY_* end on purpose.
// Those columns are the payment reference block written onto the row, which is what lets
// the mapping bind them as an embedded property and emit no join for them.
Database cash_core::Store
(
   include core_account::Store

   Table CSH_CASH_ACCOUNT_PROFILE
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      BASE_CURRENCY VARCHAR(3),
      CASH_ACCOUNT_TYPE VARCHAR(20),
      OVERDRAFT_LIMIT DOUBLE,
      CUTOFF_TIME VARCHAR(5),
      IS_SWEEPABLE BIT,
      POOL_ID VARCHAR(20),
      OPENED_FOR_CASH_ON DATE,
      CLOSED_FOR_CASH_ON DATE
   )

   // VALUE_DATE and BOOKING_DATE are both here and neither is derived. PAY_* is the
   // payment reference block; PAY_ORD_* is the ordering party nested inside it.
   Table CSH_CASH_MOVEMENT
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      MOVEMENT_ID VARCHAR(40) PRIMARY KEY,
      DIRECTION VARCHAR(6),
      AMOUNT DOUBLE,
      CURRENCY_CODE VARCHAR(3),
      VALUE_DATE DATE,
      BOOKING_DATE DATE,
      STATUS VARCHAR(20),
      MOVEMENT_TYPE VARCHAR(20),
      SOURCE_SYSTEM VARCHAR(30),
      RECONCILED_ON DATE,
      REVERSAL_OF VARCHAR(40),
      PAY_END_TO_END_ID VARCHAR(35),
      PAY_INSTRUCTION_ID VARCHAR(35),
      PAY_SCHEME VARCHAR(20),
      PAY_PURPOSE_CODE VARCHAR(4),
      PAY_REMITTANCE_INFO VARCHAR(140),
      PAY_CHARGE_BEARER VARCHAR(4),
      PAY_ORD_NAME VARCHAR(140),
      PAY_ORD_BIC VARCHAR(11),
      PAY_ORD_ACCOUNT VARCHAR(34),
      PAY_ORD_COUNTRY VARCHAR(2)
   )

   Table CSH_MOVEMENT_STATUS_EVENT
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      MOVEMENT_ID VARCHAR(40) PRIMARY KEY,
      STATUS_SEQ INTEGER PRIMARY KEY,
      STATUS VARCHAR(20),
      CHANGED_ON DATE,
      REASON_CODE VARCHAR(20),
      CHANGED_BY VARCHAR(60)
   )

   // Four key columns: an account holds more than one currency, and a balance is struck
   // per day.
   Table CSH_CASH_BALANCE
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      CURRENCY_CODE VARCHAR(3) PRIMARY KEY,
      BALANCE_DATE DATE PRIMARY KEY,
      BALANCE_BASIS VARCHAR(10),
      OPENING_BALANCE DOUBLE,
      CLOSING_BALANCE DOUBLE,
      AVAILABLE_BALANCE DOUBLE,
      PENDING_CREDITS DOUBLE,
      PENDING_DEBITS DOUBLE,
      IS_FINAL BIT
   )

   Table CSH_STATEMENT
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      CURRENCY_CODE VARCHAR(3) PRIMARY KEY,
      STATEMENT_DATE DATE PRIMARY KEY,
      STATEMENT_REF VARCHAR(40),
      OPENING_BALANCE DOUBLE,
      CLOSING_BALANCE DOUBLE,
      LINE_COUNT INTEGER,
      RECEIVED_ON DATE,
      FORMAT_CODE VARCHAR(10)
   )

   // The bank's copy of the payment reference, in the same shape as ours on the movement
   // row, so the two can be compared column for column.
   Table CSH_STATEMENT_LINE
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      CURRENCY_CODE VARCHAR(3) PRIMARY KEY,
      STATEMENT_DATE DATE PRIMARY KEY,
      LINE_NO INTEGER PRIMARY KEY,
      MOVEMENT_ID VARCHAR(40),
      DIRECTION VARCHAR(6),
      AMOUNT DOUBLE,
      VALUE_DATE DATE,
      BOOKING_DATE DATE,
      BANK_REF VARCHAR(40),
      MATCHED_ON DATE,
      PAY_END_TO_END_ID VARCHAR(35),
      PAY_INSTRUCTION_ID VARCHAR(35),
      PAY_SCHEME VARCHAR(20),
      PAY_PURPOSE_CODE VARCHAR(4),
      PAY_REMITTANCE_INFO VARCHAR(140),
      PAY_CHARGE_BEARER VARCHAR(4),
      PAY_ORD_NAME VARCHAR(140),
      PAY_ORD_BIC VARCHAR(11),
      PAY_ORD_ACCOUNT VARCHAR(34),
      PAY_ORD_COUNTRY VARCHAR(2)
   )

   Table CSH_BALANCE_BREAK
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      CURRENCY_CODE VARCHAR(3) PRIMARY KEY,
      BALANCE_DATE DATE PRIMARY KEY,
      BREAK_CODE VARCHAR(20) PRIMARY KEY,
      BREAK_AMOUNT DOUBLE,
      DETECTED_ON DATE,
      RESOLVED_ON DATE,
      ASSIGNED_TO VARCHAR(60),
      COMMENTARY VARCHAR(200)
   )

   Table CSH_CASH_POOL
   (
      POOL_ID VARCHAR(20) PRIMARY KEY,
      POOL_NAME VARCHAR(120),
      POOL_TYPE VARCHAR(20),
      POOL_CURRENCY VARCHAR(3),
      HEADER_INSTITUTION_ID VARCHAR(20),
      HEADER_ACCOUNT_NO VARCHAR(34),
      IS_NOTIONAL BIT,
      EFFECTIVE_FROM DATE
   )

   // Two institution/account pairs on one row: where the cash comes from and where it
   // goes. Each gets its own two-column join below.
   Table CSH_SWEEP_RULE
   (
      SOURCE_INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      SOURCE_ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      RULE_SEQ INTEGER PRIMARY KEY,
      POOL_ID VARCHAR(20),
      TARGET_INSTITUTION_ID VARCHAR(20),
      TARGET_ACCOUNT_NO VARCHAR(34),
      SWEEP_CURRENCY VARCHAR(3),
      SWEEP_TYPE VARCHAR(20),
      TARGET_BALANCE DOUBLE,
      MINIMUM_AMOUNT DOUBLE,
      FREQUENCY VARCHAR(20),
      CUTOFF_TIME VARCHAR(5),
      ACTIVATED_ON DATE,
      DEACTIVATED_ON DATE
   )

   Table CSH_SWEEP_EXECUTION
   (
      SOURCE_INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      SOURCE_ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      RULE_SEQ INTEGER PRIMARY KEY,
      EXECUTION_DATE DATE PRIMARY KEY,
      SWEPT_AMOUNT DOUBLE,
      MOVEMENT_ID VARCHAR(40),
      STATUS VARCHAR(20),
      BALANCE_BEFORE DOUBLE,
      BALANCE_AFTER DOUBLE,
      FAILURE_REASON VARCHAR(120)
   )

   Table CSH_INTEREST_ACCRUAL
   (
      INSTITUTION_ID VARCHAR(20) PRIMARY KEY,
      ACCOUNT_NO VARCHAR(34) PRIMARY KEY,
      CURRENCY_CODE VARCHAR(3) PRIMARY KEY,
      ACCRUAL_DATE DATE PRIMARY KEY,
      ACCRUAL_BASIS VARCHAR(20),
      ANNUAL_RATE DOUBLE,
      ACCRUED_AMOUNT DOUBLE,
      BALANCE_USED DOUBLE,
      RATE_SOURCE VARCHAR(30),
      IS_DEBIT_INTEREST BIT
   )

   // ---- out to the account master: two columns, every time ----
   Join Csh_ProfileAccount(CSH_CASH_ACCOUNT_PROFILE.INSTITUTION_ID = CA_ACCOUNT.INSTITUTION_ID and CSH_CASH_ACCOUNT_PROFILE.ACCOUNT_NO = CA_ACCOUNT.ACCOUNT_NO)
   Join Csh_MovementAccount(CSH_CASH_MOVEMENT.INSTITUTION_ID = CA_ACCOUNT.INSTITUTION_ID and CSH_CASH_MOVEMENT.ACCOUNT_NO = CA_ACCOUNT.ACCOUNT_NO)
   Join Csh_BalanceAccount(CSH_CASH_BALANCE.INSTITUTION_ID = CA_ACCOUNT.INSTITUTION_ID and CSH_CASH_BALANCE.ACCOUNT_NO = CA_ACCOUNT.ACCOUNT_NO)
   Join Csh_StatementAccount(CSH_STATEMENT.INSTITUTION_ID = CA_ACCOUNT.INSTITUTION_ID and CSH_STATEMENT.ACCOUNT_NO = CA_ACCOUNT.ACCOUNT_NO)
   Join Csh_AccrualAccount(CSH_INTEREST_ACCRUAL.INSTITUTION_ID = CA_ACCOUNT.INSTITUTION_ID and CSH_INTEREST_ACCRUAL.ACCOUNT_NO = CA_ACCOUNT.ACCOUNT_NO)
   Join Csh_PoolHeaderAccount(CSH_CASH_POOL.HEADER_INSTITUTION_ID = CA_ACCOUNT.INSTITUTION_ID and CSH_CASH_POOL.HEADER_ACCOUNT_NO = CA_ACCOUNT.ACCOUNT_NO)

   // The same table twice over, distinguished only by which pair of columns is matched.
   Join Csh_SweepRuleSourceAccount(CSH_SWEEP_RULE.SOURCE_INSTITUTION_ID = CA_ACCOUNT.INSTITUTION_ID and CSH_SWEEP_RULE.SOURCE_ACCOUNT_NO = CA_ACCOUNT.ACCOUNT_NO)
   Join Csh_SweepRuleTargetAccount(CSH_SWEEP_RULE.TARGET_INSTITUTION_ID = CA_ACCOUNT.INSTITUTION_ID and CSH_SWEEP_RULE.TARGET_ACCOUNT_NO = CA_ACCOUNT.ACCOUNT_NO)

   // ---- inside the cash book ----
   Join Csh_MovementProfile(CSH_CASH_MOVEMENT.INSTITUTION_ID = CSH_CASH_ACCOUNT_PROFILE.INSTITUTION_ID and CSH_CASH_MOVEMENT.ACCOUNT_NO = CSH_CASH_ACCOUNT_PROFILE.ACCOUNT_NO)
   Join Csh_BalanceProfile(CSH_CASH_BALANCE.INSTITUTION_ID = CSH_CASH_ACCOUNT_PROFILE.INSTITUTION_ID and CSH_CASH_BALANCE.ACCOUNT_NO = CSH_CASH_ACCOUNT_PROFILE.ACCOUNT_NO)
   Join Csh_MovementStatusEvents(CSH_CASH_MOVEMENT.INSTITUTION_ID = CSH_MOVEMENT_STATUS_EVENT.INSTITUTION_ID and CSH_CASH_MOVEMENT.ACCOUNT_NO = CSH_MOVEMENT_STATUS_EVENT.ACCOUNT_NO and CSH_CASH_MOVEMENT.MOVEMENT_ID = CSH_MOVEMENT_STATUS_EVENT.MOVEMENT_ID)

   // Balance and statement are the same grain -- ours and theirs, side by side.
   Join Csh_BalanceStatement(CSH_CASH_BALANCE.INSTITUTION_ID = CSH_STATEMENT.INSTITUTION_ID and CSH_CASH_BALANCE.ACCOUNT_NO = CSH_STATEMENT.ACCOUNT_NO and CSH_CASH_BALANCE.CURRENCY_CODE = CSH_STATEMENT.CURRENCY_CODE and CSH_CASH_BALANCE.BALANCE_DATE = CSH_STATEMENT.STATEMENT_DATE)
   Join Csh_BalanceBreaks(CSH_CASH_BALANCE.INSTITUTION_ID = CSH_BALANCE_BREAK.INSTITUTION_ID and CSH_CASH_BALANCE.ACCOUNT_NO = CSH_BALANCE_BREAK.ACCOUNT_NO and CSH_CASH_BALANCE.CURRENCY_CODE = CSH_BALANCE_BREAK.CURRENCY_CODE and CSH_CASH_BALANCE.BALANCE_DATE = CSH_BALANCE_BREAK.BALANCE_DATE)
   Join Csh_BalanceAccruals(CSH_CASH_BALANCE.INSTITUTION_ID = CSH_INTEREST_ACCRUAL.INSTITUTION_ID and CSH_CASH_BALANCE.ACCOUNT_NO = CSH_INTEREST_ACCRUAL.ACCOUNT_NO and CSH_CASH_BALANCE.CURRENCY_CODE = CSH_INTEREST_ACCRUAL.CURRENCY_CODE and CSH_CASH_BALANCE.BALANCE_DATE = CSH_INTEREST_ACCRUAL.ACCRUAL_DATE)

   Join Csh_StatementLines(CSH_STATEMENT.INSTITUTION_ID = CSH_STATEMENT_LINE.INSTITUTION_ID and CSH_STATEMENT.ACCOUNT_NO = CSH_STATEMENT_LINE.ACCOUNT_NO and CSH_STATEMENT.CURRENCY_CODE = CSH_STATEMENT_LINE.CURRENCY_CODE and CSH_STATEMENT.STATEMENT_DATE = CSH_STATEMENT_LINE.STATEMENT_DATE)
   Join Csh_StatementLineMovement(CSH_STATEMENT_LINE.INSTITUTION_ID = CSH_CASH_MOVEMENT.INSTITUTION_ID and CSH_STATEMENT_LINE.ACCOUNT_NO = CSH_CASH_MOVEMENT.ACCOUNT_NO and CSH_STATEMENT_LINE.MOVEMENT_ID = CSH_CASH_MOVEMENT.MOVEMENT_ID)

   // ---- sweeps ----
   Join Csh_PoolSweepRules(CSH_CASH_POOL.POOL_ID = CSH_SWEEP_RULE.POOL_ID)
   Join Csh_PoolMembers(CSH_CASH_POOL.POOL_ID = CSH_CASH_ACCOUNT_PROFILE.POOL_ID)
   Join Csh_SweepRuleExecutions(CSH_SWEEP_RULE.SOURCE_INSTITUTION_ID = CSH_SWEEP_EXECUTION.SOURCE_INSTITUTION_ID and CSH_SWEEP_RULE.SOURCE_ACCOUNT_NO = CSH_SWEEP_EXECUTION.SOURCE_ACCOUNT_NO and CSH_SWEEP_RULE.RULE_SEQ = CSH_SWEEP_EXECUTION.RULE_SEQ)
   Join Csh_SweepExecutionMovement(CSH_SWEEP_EXECUTION.SOURCE_INSTITUTION_ID = CSH_CASH_MOVEMENT.INSTITUTION_ID and CSH_SWEEP_EXECUTION.SOURCE_ACCOUNT_NO = CSH_CASH_MOVEMENT.ACCOUNT_NO and CSH_SWEEP_EXECUTION.MOVEMENT_ID = CSH_CASH_MOVEMENT.MOVEMENT_ID)
)
