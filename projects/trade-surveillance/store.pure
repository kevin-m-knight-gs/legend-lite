###Relational
// The trade-surveillance store.
//
// The two `include`s make every cross-boundary join below legal: an included database's
// tables are addressable as if declared here, so Sur_FillEvidenceFill can name OEX_FILL and
// Sur_PatternAmendment can name TLC_AMENDMENT without either upstream project knowing this
// one exists. The two closures overlap on trade_capture::Store (order-execution includes it
// for the booking seam, trade-lifecycle for the amended trade) and the diamond closes: the
// tables are not duplicated and the joins resolve.
//
// SUR_CASE.RELATED_CASE_ID is the self-referencing column the whole project's shape turns
// on -- a case names a related case, and Sur_RelatedCase reads it in both directions.
//
// Nothing is seeded: no ###Data element and no Runtime, per the contract.
Database trade_surveillance::Store
(
   include order_execution::Store
   include trade_lifecycle::Store

   // ---- The model, and the evidence it works ----

   Table SUR_MODEL
   (
      MODEL_ID VARCHAR(64) PRIMARY KEY,
      MODEL_CODE VARCHAR(32) NOT NULL,
      MODEL_NAME VARCHAR(120) NOT NULL,
      ALERT_TYPE VARCHAR(32) NOT NULL,
      MODEL_STATE VARCHAR(20) NOT NULL,
      MODEL_VERSION VARCHAR(20) NOT NULL,
      OWNER_TEAM VARCHAR(80) NOT NULL,
      DEPLOYED_ON DATE NOT NULL,
      RETIRED_ON DATE,
      LOOKBACK_MINUTES INTEGER NOT NULL,
      DESCRIPTION VARCHAR(400) NOT NULL,
      FP_TOLERANCE DOUBLE NOT NULL
   )

   Table SUR_MODEL_PARAMETER
   (
      PARAMETER_ID VARCHAR(64) PRIMARY KEY,
      MODEL_ID VARCHAR(64) NOT NULL,
      PARAMETER_NAME VARCHAR(80) NOT NULL,
      PARAMETER_VALUE DOUBLE NOT NULL,
      UNIT_CODE VARCHAR(24) NOT NULL,
      EFFECTIVE_FROM DATE NOT NULL,
      EFFECTIVE_TO DATE,
      CHANGED_BY VARCHAR(120) NOT NULL,
      APPROVED_BY VARCHAR(120),
      RATIONALE VARCHAR(400)
   )

   Table SUR_MODEL_CALIBRATION
   (
      CALIBRATION_ID VARCHAR(64) PRIMARY KEY,
      MODEL_ID VARCHAR(64) NOT NULL,
      RUN_ON DATE NOT NULL,
      SAMPLE_FROM DATE NOT NULL,
      SAMPLE_TO DATE NOT NULL,
      ALERTS_SIMULATED INTEGER NOT NULL,
      TRUE_POSITIVES INTEGER NOT NULL,
      FALSE_POSITIVES INTEGER NOT NULL,
      METHOD_NAME VARCHAR(80) NOT NULL,
      APPROVED_BY VARCHAR(120)
   )

   // The row that decides whether the model stays switched on. FP_TOLERANCE_AT_REVIEW is a
   // snapshot of SUR_MODEL.FP_TOLERANCE, so re-tuning the model cannot retrospectively
   // make an old period acceptable.
   Table SUR_MODEL_PERFORMANCE
   (
      PERFORMANCE_ID VARCHAR(64) PRIMARY KEY,
      MODEL_ID VARCHAR(64) NOT NULL,
      PERIOD_START DATE NOT NULL,
      PERIOD_END DATE NOT NULL,
      ALERTS_RAISED INTEGER NOT NULL,
      ALERTS_TRIAGED_OUT INTEGER NOT NULL,
      CASES_OPENED INTEGER NOT NULL,
      REPORTS_FILED INTEGER NOT NULL,
      MEAN_TRIAGE_MINUTES DOUBLE NOT NULL,
      FP_TOLERANCE_AT_REVIEW DOUBLE NOT NULL,
      REVIEWED_BY VARCHAR(120),
      REVIEW_COMMENT VARCHAR(400)
   )

   Table SUR_RUN
   (
      RUN_ID VARCHAR(64) PRIMARY KEY,
      MODEL_ID VARCHAR(64) NOT NULL,
      BUSINESS_DATE DATE NOT NULL,
      STARTED_AT TIMESTAMP NOT NULL,
      COMPLETED_AT TIMESTAMP,
      ROWS_SCANNED INTEGER NOT NULL,
      ALERTS_RAISED INTEGER NOT NULL,
      RUN_STATUS VARCHAR(24) NOT NULL,
      IS_REPLAY BIT NOT NULL
   )

   // ---- The alert and its window ----

   // SUMMARY_ID reaches OEX_ORDER_FILL_SUMMARY and WATCH_ENTRY_ID reaches
   // SUR_WATCH_LIST_ENTRY. Neither is mapped to a property -- the model navigates.
   Table SUR_ALERT
   (
      ALERT_ID VARCHAR(64) PRIMARY KEY,
      RUN_ID VARCHAR(64),
      MODEL_ID VARCHAR(64) NOT NULL,
      WINDOW_ID VARCHAR(64),
      SUMMARY_ID VARCHAR(64),
      WATCH_ENTRY_ID VARCHAR(64),
      ALERT_REFERENCE VARCHAR(64) NOT NULL,
      ALERT_TYPE VARCHAR(32) NOT NULL,
      ALERT_STATUS VARCHAR(24) NOT NULL,
      SEVERITY VARCHAR(12) NOT NULL,
      SCORE DOUBLE NOT NULL,
      RAISED_AT TIMESTAMP NOT NULL,
      BUSINESS_DATE DATE NOT NULL,
      INSTRUMENT_REF VARCHAR(64) NOT NULL,
      TRADER_REF VARCHAR(64) NOT NULL,
      DESK_REF VARCHAR(64),
      BOOK_REF VARCHAR(64),
      ACCOUNT_REF VARCHAR(64),
      MARKET_PHASE VARCHAR(24) NOT NULL,
      CLOSED_AT TIMESTAMP,
      NARRATIVE VARCHAR(400),
      IS_REOPENED BIT NOT NULL
   )

   Table SUR_EVIDENCE_WINDOW
   (
      WINDOW_ID VARCHAR(64) PRIMARY KEY,
      WINDOW_START TIMESTAMP NOT NULL,
      WINDOW_END TIMESTAMP NOT NULL,
      LOOKBACK_MINUTES INTEGER NOT NULL,
      VENUE_REF VARCHAR(64),
      INSTRUMENT_REF VARCHAR(64) NOT NULL,
      OBSERVATION_COUNT INTEGER NOT NULL,
      IS_TRUNCATED BIT NOT NULL
   )

   Table SUR_EVIDENCE_ITEM
   (
      ITEM_ID VARCHAR(64) PRIMARY KEY,
      WINDOW_ID VARCHAR(64) NOT NULL,
      EVIDENCE_KIND VARCHAR(24) NOT NULL,
      SOURCE_SYSTEM VARCHAR(64) NOT NULL,
      SOURCE_REFERENCE VARCHAR(120) NOT NULL,
      OBSERVED_AT TIMESTAMP NOT NULL,
      SEQUENCE_NUMBER INTEGER NOT NULL,
      IS_MATERIAL BIT NOT NULL,
      NOTE_TEXT VARCHAR(400)
   )

   // FILL_ID crosses into order-execution's OEX_FILL.
   Table SUR_FILL_EVIDENCE
   (
      FILL_EVIDENCE_ID VARCHAR(64) PRIMARY KEY,
      ITEM_ID VARCHAR(64) NOT NULL,
      FILL_ID VARCHAR(64),
      FILL_REFERENCE VARCHAR(64) NOT NULL,
      QUANTITY DOUBLE NOT NULL,
      PRICE DOUBLE NOT NULL,
      SIDE_CODE VARCHAR(8) NOT NULL,
      IS_AGGRESSIVE BIT NOT NULL,
      CONTRIBUTION_WEIGHT DOUBLE NOT NULL
   )

   // AMENDMENT_ID crosses into trade-lifecycle's TLC_AMENDMENT.
   Table SUR_AMENDMENT_EVIDENCE
   (
      AMENDMENT_EVIDENCE_ID VARCHAR(64) PRIMARY KEY,
      ITEM_ID VARCHAR(64) NOT NULL,
      AMENDMENT_ID VARCHAR(64),
      AMENDMENT_REFERENCE VARCHAR(64) NOT NULL,
      FIELD_CHANGED VARCHAR(64) NOT NULL,
      OLD_VALUE VARCHAR(400),
      NEW_VALUE VARCHAR(400),
      AMENDED_AT TIMESTAMP NOT NULL,
      DAYS_AFTER_TRADE INTEGER NOT NULL,
      IS_ECONOMIC BIT NOT NULL
   )

   // AMENDMENT_ID here points at the HEAD of the chain -- the amendment nothing supersedes
   // -- so trade-lifecycle's own Tlc_SupersededBy replays what this row measures.
   Table SUR_AMENDMENT_PATTERN
   (
      PATTERN_ID VARCHAR(64) PRIMARY KEY,
      ALERT_ID VARCHAR(64) NOT NULL,
      AMENDMENT_ID VARCHAR(64),
      CHAIN_LENGTH INTEGER NOT NULL,
      FIRST_AMENDED_AT TIMESTAMP NOT NULL,
      LAST_AMENDED_AT TIMESTAMP NOT NULL,
      DISTINCT_FIELDS INTEGER NOT NULL,
      ECONOMIC_COUNT INTEGER NOT NULL,
      SAME_USER_COUNT INTEGER NOT NULL,
      NOTIONAL_DRIFT_PCT DOUBLE NOT NULL,
      IS_AFTER_SETTLEMENT BIT NOT NULL
   )

   // ---- The per-alert-type measurements ----

   Table SUR_BOOK_SNAPSHOT
   (
      SNAPSHOT_ID VARCHAR(64) PRIMARY KEY,
      WINDOW_ID VARCHAR(64) NOT NULL,
      CAPTURED_AT TIMESTAMP NOT NULL,
      BEST_BID DOUBLE NOT NULL,
      BEST_ASK DOUBLE NOT NULL,
      BID_DEPTH DOUBLE NOT NULL,
      ASK_DEPTH DOUBLE NOT NULL,
      IMBALANCE_RATIO DOUBLE NOT NULL,
      LEVEL_COUNT INTEGER NOT NULL
   )

   Table SUR_BOOK_LEVEL
   (
      LEVEL_ID VARCHAR(64) PRIMARY KEY,
      SNAPSHOT_ID VARCHAR(64) NOT NULL,
      SIDE_CODE VARCHAR(8) NOT NULL,
      LEVEL_INDEX INTEGER NOT NULL,
      PRICE DOUBLE NOT NULL,
      QUANTITY DOUBLE NOT NULL,
      OWN_QUANTITY DOUBLE NOT NULL,
      ORDER_COUNT INTEGER NOT NULL
   )

   Table SUR_CANCELLATION_BURST
   (
      BURST_ID VARCHAR(64) PRIMARY KEY,
      WINDOW_ID VARCHAR(64) NOT NULL,
      BURST_START TIMESTAMP NOT NULL,
      BURST_END TIMESTAMP NOT NULL,
      ORDERS_PLACED INTEGER NOT NULL,
      ORDERS_CANCELLED INTEGER NOT NULL,
      MEDIAN_LIFETIME_MILLIS INTEGER NOT NULL,
      MAX_DISPLAYED_QUANTITY DOUBLE NOT NULL,
      SIDE_CODE VARCHAR(8) NOT NULL
   )

   // ORDER_TO_TRADE_RATIO is nullable on purpose: an interval with messages and no trades
   // is the quote-stuffing case, and there is no ratio to store for it.
   Table SUR_MESSAGE_RATE
   (
      METRIC_ID VARCHAR(64) PRIMARY KEY,
      WINDOW_ID VARCHAR(64) NOT NULL,
      SUMMARY_ID VARCHAR(64),
      INTERVAL_START TIMESTAMP NOT NULL,
      INTERVAL_SECONDS INTEGER NOT NULL,
      MESSAGE_COUNT INTEGER NOT NULL,
      TRADE_COUNT INTEGER NOT NULL,
      PEAK_MESSAGES_PER_SECOND DOUBLE NOT NULL,
      ORDER_TO_TRADE_RATIO DOUBLE,
      VENUE_REF VARCHAR(64) NOT NULL
   )

   Table SUR_PRICE_IMPACT
   (
      OBSERVATION_ID VARCHAR(64) PRIMARY KEY,
      WINDOW_ID VARCHAR(64) NOT NULL,
      HORIZON_SECONDS INTEGER NOT NULL,
      PRICE_BEFORE DOUBLE NOT NULL,
      PRICE_AFTER DOUBLE NOT NULL,
      REFERENCE_PRICE DOUBLE NOT NULL,
      MOVE_BPS DOUBLE NOT NULL,
      MARKET_MOVE_BPS DOUBLE NOT NULL,
      VOLUME_SHARE DOUBLE NOT NULL,
      IS_REVERTED BIT NOT NULL
   )

   Table SUR_CLOSING_INFLUENCE
   (
      INFLUENCE_ID VARCHAR(64) PRIMARY KEY,
      WINDOW_ID VARCHAR(64) NOT NULL,
      CLOSING_PRICE DOUBLE NOT NULL,
      REFERENCE_PRICE DOUBLE NOT NULL,
      OWN_VOLUME DOUBLE NOT NULL,
      AUCTION_VOLUME DOUBLE NOT NULL,
      LAST_MINUTE_ORDER_COUNT INTEGER NOT NULL,
      PRICE_MOVE_BPS DOUBLE NOT NULL,
      IS_BENCHMARK_DATE BIT NOT NULL
   )

   // Two foreign keys into OEX_FILL, one per leg, plus the booking seam.
   Table SUR_WASH_MATCH
   (
      MATCH_ID VARCHAR(64) PRIMARY KEY,
      ALERT_ID VARCHAR(64) NOT NULL,
      BUY_FILL_ID VARCHAR(64),
      SELL_FILL_ID VARCHAR(64),
      BOOKING_ID VARCHAR(64),
      MATCHED_QUANTITY DOUBLE NOT NULL,
      BUY_PRICE DOUBLE NOT NULL,
      SELL_PRICE DOUBLE NOT NULL,
      SECONDS_APART INTEGER NOT NULL,
      BUY_ACCOUNT_REF VARCHAR(64) NOT NULL,
      SELL_ACCOUNT_REF VARCHAR(64) NOT NULL,
      BENEFICIAL_OWNER_REF VARCHAR(64),
      IS_SAME_BENEFICIAL_OWNER BIT NOT NULL,
      NET_POSITION_CHANGE DOUBLE NOT NULL
   )

   Table SUR_FRONT_RUNNING
   (
      SEQUENCE_ID VARCHAR(64) PRIMARY KEY,
      ALERT_ID VARCHAR(64) NOT NULL,
      AHEAD_FILL_ID VARCHAR(64),
      CLIENT_ORDER_REF VARCHAR(64) NOT NULL,
      HOUSE_ORDER_REF VARCHAR(64) NOT NULL,
      SECONDS_AHEAD INTEGER NOT NULL,
      CLIENT_QUANTITY DOUBLE NOT NULL,
      HOUSE_QUANTITY DOUBLE NOT NULL,
      PRICE_ADVANTAGE_BPS DOUBLE NOT NULL,
      SAME_INSTRUMENT BIT NOT NULL,
      SAME_DIRECTION BIT NOT NULL
   )

   Table SUR_WATCH_LIST
   (
      LIST_ID VARCHAR(64) PRIMARY KEY,
      LIST_CODE VARCHAR(32) NOT NULL,
      LIST_NAME VARCHAR(120) NOT NULL,
      LIST_TYPE VARCHAR(24) NOT NULL,
      MAINTAINED_BY VARCHAR(120) NOT NULL,
      EFFECTIVE_FROM DATE NOT NULL,
      EFFECTIVE_TO DATE,
      IS_RESTRICTED BIT NOT NULL
   )

   Table SUR_WATCH_LIST_ENTRY
   (
      ENTRY_ID VARCHAR(64) PRIMARY KEY,
      LIST_ID VARCHAR(64) NOT NULL,
      SUBJECT_REF VARCHAR(64) NOT NULL,
      SUBJECT_TYPE VARCHAR(24) NOT NULL,
      ADDED_ON DATE NOT NULL,
      REMOVED_ON DATE,
      REASON_TEXT VARCHAR(400) NOT NULL,
      ADDED_BY VARCHAR(120) NOT NULL,
      IS_BLOCKING BIT NOT NULL
   )

   Table SUR_NEWS_EVENT
   (
      NEWS_ID VARCHAR(64) PRIMARY KEY,
      ENTRY_ID VARCHAR(64),
      HEADLINE VARCHAR(400) NOT NULL,
      PUBLISHED_AT TIMESTAMP NOT NULL,
      NEWS_SOURCE VARCHAR(80) NOT NULL,
      INSTRUMENT_REF VARCHAR(64) NOT NULL,
      IS_PRICE_SENSITIVE BIT NOT NULL,
      PRICE_MOVE_BPS DOUBLE,
      CATEGORY VARCHAR(48) NOT NULL
   )

   // ---- Triage ----

   Table SUR_TRIAGE
   (
      TRIAGE_ID VARCHAR(64) PRIMARY KEY,
      ALERT_ID VARCHAR(64) NOT NULL,
      REASON_ID VARCHAR(64),
      ANALYST_ID VARCHAR(64),
      REVIEWED_AT TIMESTAMP NOT NULL,
      TRIAGE_OUTCOME VARCHAR(32) NOT NULL,
      MINUTES_SPENT INTEGER NOT NULL,
      REVIEWER_COMMENT VARCHAR(400),
      IS_AUTO_TRIAGED BIT NOT NULL,
      CONFIDENCE DOUBLE NOT NULL,
      SECOND_REVIEW_REQUIRED BIT NOT NULL
   )

   Table SUR_TRIAGE_REASON
   (
      REASON_ID VARCHAR(64) PRIMARY KEY,
      REASON_CODE VARCHAR(32) NOT NULL,
      DESCRIPTION VARCHAR(400) NOT NULL,
      IS_FALSE_POSITIVE_REASON BIT NOT NULL,
      REQUIRES_MODEL_REVIEW BIT NOT NULL,
      USAGE_COUNT INTEGER NOT NULL
   )

   // ---- The case ----

   // RELATED_CASE_ID is the self-referencing column. It is a foreign key into this table's
   // own CASE_ID and is null on every case nobody has related to anything, which is most
   // of them. LINK_REASON says what the edge means -- DUPLICATE and SAME_TRADER lead to
   // opposite actions.
   Table SUR_CASE
   (
      CASE_ID VARCHAR(64) PRIMARY KEY,
      RELATED_CASE_ID VARCHAR(64),
      OWNER_ID VARCHAR(64),
      CASE_REFERENCE VARCHAR(64) NOT NULL,
      OPENED_ON DATE NOT NULL,
      CASE_STATUS VARCHAR(28) NOT NULL,
      CASE_OUTCOME VARCHAR(32),
      SEVERITY VARCHAR(12) NOT NULL,
      LINK_REASON VARCHAR(28),
      TARGET_TRADER_REF VARCHAR(64) NOT NULL,
      TARGET_DESK_REF VARCHAR(64),
      INSTRUMENT_REF VARCHAR(64),
      DUE_ON DATE,
      CLOSED_ON DATE,
      SUMMARY_TEXT VARCHAR(400),
      IS_REGULATOR_NOTIFIED BIT NOT NULL
   )

   Table SUR_CASE_ALERT
   (
      LINK_ID VARCHAR(64) PRIMARY KEY,
      CASE_ID VARCHAR(64) NOT NULL,
      ALERT_ID VARCHAR(64) NOT NULL,
      ADDED_AT TIMESTAMP NOT NULL,
      ADDED_BY VARCHAR(120) NOT NULL,
      IS_PRIMARY_ALERT BIT NOT NULL,
      NOTE_TEXT VARCHAR(400)
   )

   Table SUR_ANALYST
   (
      ANALYST_ID VARCHAR(64) PRIMARY KEY,
      ANALYST_NAME VARCHAR(120) NOT NULL,
      TEAM_NAME VARCHAR(80) NOT NULL,
      SENIORITY VARCHAR(24) NOT NULL,
      COVERAGE_REGION VARCHAR(48) NOT NULL,
      IS_CERTIFIED BIT NOT NULL,
      JOINED_ON DATE NOT NULL,
      LEFT_ON DATE,
      OPEN_CASE_LIMIT INTEGER NOT NULL
   )

   Table SUR_CASE_ASSIGNMENT
   (
      ASSIGNMENT_ID VARCHAR(64) PRIMARY KEY,
      CASE_ID VARCHAR(64) NOT NULL,
      ANALYST_ID VARCHAR(64) NOT NULL,
      ASSIGNED_AT TIMESTAMP NOT NULL,
      ASSIGNED_BY VARCHAR(120) NOT NULL,
      UNASSIGNED_AT TIMESTAMP,
      ROLE_NAME VARCHAR(48) NOT NULL,
      IS_OWNER BIT NOT NULL,
      HANDOVER_NOTE VARCHAR(400)
   )

   Table SUR_INVESTIGATION_STEP
   (
      STEP_ID VARCHAR(64) PRIMARY KEY,
      CASE_ID VARCHAR(64) NOT NULL,
      ANALYST_ID VARCHAR(64),
      STEP_NUMBER INTEGER NOT NULL,
      STEP_TYPE VARCHAR(48) NOT NULL,
      PERFORMED_AT TIMESTAMP NOT NULL,
      PERFORMED_BY VARCHAR(120) NOT NULL,
      FINDING_TEXT VARCHAR(400),
      IS_COMPLETE BIT NOT NULL,
      EVIDENCE_REFERENCE VARCHAR(120)
   )

   Table SUR_DESK_ENQUIRY
   (
      ENQUIRY_ID VARCHAR(64) PRIMARY KEY,
      CASE_ID VARCHAR(64) NOT NULL,
      SENT_AT TIMESTAMP NOT NULL,
      SENT_TO VARCHAR(120) NOT NULL,
      QUESTION_TEXT VARCHAR(400) NOT NULL,
      RESPONDED_AT TIMESTAMP,
      RESPONSE_TEXT VARCHAR(400),
      RESPONSE_ACCEPTED_BY VARCHAR(120),
      IS_SATISFACTORY BIT NOT NULL,
      ESCALATED_FOR_NO_RESPONSE BIT NOT NULL
   )

   Table SUR_COMMUNICATION
   (
      COMMUNICATION_ID VARCHAR(64) PRIMARY KEY,
      CASE_ID VARCHAR(64) NOT NULL,
      CHANNEL VARCHAR(32) NOT NULL,
      OCCURRED_AT TIMESTAMP NOT NULL,
      PARTICIPANTS VARCHAR(400) NOT NULL,
      DIRECTION_CODE VARCHAR(16) NOT NULL,
      EXCERPT VARCHAR(400),
      IS_PRIVILEGED BIT NOT NULL,
      RETRIEVED_FROM VARCHAR(80) NOT NULL,
      RETENTION_EXPIRES_ON DATE
   )

   // ---- Escalation and the filing ----

   Table SUR_ESCALATION
   (
      ESCALATION_ID VARCHAR(64) PRIMARY KEY,
      CASE_ID VARCHAR(64) NOT NULL,
      ESCALATED_AT TIMESTAMP NOT NULL,
      ESCALATED_BY VARCHAR(120) NOT NULL,
      ESCALATED_TO VARCHAR(120) NOT NULL,
      ESCALATION_LEVEL INTEGER NOT NULL,
      RATIONALE VARCHAR(400) NOT NULL,
      DECIDED_AT TIMESTAMP,
      DECISION_TEXT VARCHAR(400),
      IS_REPORT_RECOMMENDED BIT NOT NULL
   )

   Table SUR_STR
   (
      REPORT_ID VARCHAR(64) PRIMARY KEY,
      CASE_ID VARCHAR(64) NOT NULL,
      ESCALATION_ID VARCHAR(64),
      REPORT_REFERENCE VARCHAR(64) NOT NULL,
      REPORT_STATUS VARCHAR(24) NOT NULL,
      DRAFTED_ON DATE NOT NULL,
      SUBMITTED_ON DATE,
      REGULATOR_CODE VARCHAR(24) NOT NULL,
      JURISDICTION VARCHAR(48) NOT NULL,
      SUBMITTED_BY VARCHAR(120),
      ACKNOWLEDGEMENT_REFERENCE VARCHAR(64),
      SUSPICION_SUMMARY VARCHAR(400) NOT NULL,
      IS_SUSPICIOUS_ORDER BIT NOT NULL,
      IS_SUSPICIOUS_TRANSACTION BIT NOT NULL,
      WITHDRAWN_ON DATE
   )

   // ---- The self-join ----
   // Both sides are SUR_CASE. {target} names the FAR side of the same table; without it the
   // condition would compare a row's RELATED_CASE_ID against its own CASE_ID and match
   // nothing. Read left to right it gives the case this one is linked TO; read in reverse
   // it gives every case that points AT this one, which is how eight spoofing alerts on one
   // trader collapse into one investigation. Must stay on ONE line.
   Join Sur_RelatedCase(SUR_CASE.RELATED_CASE_ID = {target}.CASE_ID)

   // ---- Cross-project joins, legal because the two stores are included above ----
   Join Sur_FillEvidenceFill(SUR_FILL_EVIDENCE.FILL_ID = OEX_FILL.FILL_ID)
   Join Sur_WashBuyFill(SUR_WASH_MATCH.BUY_FILL_ID = OEX_FILL.FILL_ID)
   Join Sur_WashSellFill(SUR_WASH_MATCH.SELL_FILL_ID = OEX_FILL.FILL_ID)
   Join Sur_FrontRunAheadFill(SUR_FRONT_RUNNING.AHEAD_FILL_ID = OEX_FILL.FILL_ID)
   Join Sur_AlertOrderSummary(SUR_ALERT.SUMMARY_ID = OEX_ORDER_FILL_SUMMARY.SUMMARY_ID)
   Join Sur_MessageRateOrderSummary(SUR_MESSAGE_RATE.SUMMARY_ID = OEX_ORDER_FILL_SUMMARY.SUMMARY_ID)
   Join Sur_WashBooking(SUR_WASH_MATCH.BOOKING_ID = OEX_TRADE_BOOKING.BOOKING_ID)
   Join Sur_AmendmentEvidenceAmendment(SUR_AMENDMENT_EVIDENCE.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)
   Join Sur_PatternAmendment(SUR_AMENDMENT_PATTERN.AMENDMENT_ID = TLC_AMENDMENT.AMENDMENT_ID)

   // ---- Joins inside trade-surveillance ----
   Join Sur_ModelParameter(SUR_MODEL_PARAMETER.MODEL_ID = SUR_MODEL.MODEL_ID)
   Join Sur_ModelCalibration(SUR_MODEL_CALIBRATION.MODEL_ID = SUR_MODEL.MODEL_ID)
   Join Sur_ModelPerformance(SUR_MODEL_PERFORMANCE.MODEL_ID = SUR_MODEL.MODEL_ID)
   Join Sur_ModelRun(SUR_RUN.MODEL_ID = SUR_MODEL.MODEL_ID)
   Join Sur_RunAlert(SUR_ALERT.RUN_ID = SUR_RUN.RUN_ID)
   Join Sur_AlertModel(SUR_ALERT.MODEL_ID = SUR_MODEL.MODEL_ID)
   Join Sur_AlertWindow(SUR_ALERT.WINDOW_ID = SUR_EVIDENCE_WINDOW.WINDOW_ID)
   Join Sur_WindowItem(SUR_EVIDENCE_ITEM.WINDOW_ID = SUR_EVIDENCE_WINDOW.WINDOW_ID)
   Join Sur_ItemFillEvidence(SUR_FILL_EVIDENCE.ITEM_ID = SUR_EVIDENCE_ITEM.ITEM_ID)
   Join Sur_ItemAmendmentEvidence(SUR_AMENDMENT_EVIDENCE.ITEM_ID = SUR_EVIDENCE_ITEM.ITEM_ID)
   Join Sur_AlertAmendmentPattern(SUR_AMENDMENT_PATTERN.ALERT_ID = SUR_ALERT.ALERT_ID)
   Join Sur_WindowBookSnapshot(SUR_BOOK_SNAPSHOT.WINDOW_ID = SUR_EVIDENCE_WINDOW.WINDOW_ID)
   Join Sur_SnapshotLevel(SUR_BOOK_LEVEL.SNAPSHOT_ID = SUR_BOOK_SNAPSHOT.SNAPSHOT_ID)
   Join Sur_WindowCancellationBurst(SUR_CANCELLATION_BURST.WINDOW_ID = SUR_EVIDENCE_WINDOW.WINDOW_ID)
   Join Sur_WindowMessageRate(SUR_MESSAGE_RATE.WINDOW_ID = SUR_EVIDENCE_WINDOW.WINDOW_ID)
   Join Sur_WindowPriceImpact(SUR_PRICE_IMPACT.WINDOW_ID = SUR_EVIDENCE_WINDOW.WINDOW_ID)
   Join Sur_WindowClosingInfluence(SUR_CLOSING_INFLUENCE.WINDOW_ID = SUR_EVIDENCE_WINDOW.WINDOW_ID)
   Join Sur_AlertWashMatch(SUR_WASH_MATCH.ALERT_ID = SUR_ALERT.ALERT_ID)
   Join Sur_AlertFrontRunning(SUR_FRONT_RUNNING.ALERT_ID = SUR_ALERT.ALERT_ID)
   Join Sur_ListEntry(SUR_WATCH_LIST_ENTRY.LIST_ID = SUR_WATCH_LIST.LIST_ID)
   Join Sur_EntryNews(SUR_NEWS_EVENT.ENTRY_ID = SUR_WATCH_LIST_ENTRY.ENTRY_ID)
   Join Sur_AlertWatchEntry(SUR_ALERT.WATCH_ENTRY_ID = SUR_WATCH_LIST_ENTRY.ENTRY_ID)
   Join Sur_AlertTriage(SUR_TRIAGE.ALERT_ID = SUR_ALERT.ALERT_ID)
   Join Sur_TriageReasonLink(SUR_TRIAGE.REASON_ID = SUR_TRIAGE_REASON.REASON_ID)
   Join Sur_TriageAnalyst(SUR_TRIAGE.ANALYST_ID = SUR_ANALYST.ANALYST_ID)
   Join Sur_CaseAlertLinkCase(SUR_CASE_ALERT.CASE_ID = SUR_CASE.CASE_ID)
   Join Sur_CaseAlertLinkAlert(SUR_CASE_ALERT.ALERT_ID = SUR_ALERT.ALERT_ID)
   Join Sur_CaseAssignment(SUR_CASE_ASSIGNMENT.CASE_ID = SUR_CASE.CASE_ID)
   Join Sur_AssignmentAnalyst(SUR_CASE_ASSIGNMENT.ANALYST_ID = SUR_ANALYST.ANALYST_ID)
   Join Sur_CaseOwner(SUR_CASE.OWNER_ID = SUR_ANALYST.ANALYST_ID)
   Join Sur_CaseStep(SUR_INVESTIGATION_STEP.CASE_ID = SUR_CASE.CASE_ID)
   Join Sur_StepAnalyst(SUR_INVESTIGATION_STEP.ANALYST_ID = SUR_ANALYST.ANALYST_ID)
   Join Sur_CaseEnquiry(SUR_DESK_ENQUIRY.CASE_ID = SUR_CASE.CASE_ID)
   Join Sur_CaseCommunication(SUR_COMMUNICATION.CASE_ID = SUR_CASE.CASE_ID)
   Join Sur_CaseEscalation(SUR_ESCALATION.CASE_ID = SUR_CASE.CASE_ID)
   Join Sur_CaseReport(SUR_STR.CASE_ID = SUR_CASE.CASE_ID)
   Join Sur_EscalationReport(SUR_STR.ESCALATION_ID = SUR_ESCALATION.ESCALATION_ID)

   // Alerts nobody has closed yet. A null test, because a Filter will not take a boolean
   // literal.
   Filter SurOpenAlerts(SUR_ALERT.CLOSED_AT is null)

   // Cases still being worked. Same shape, same reason.
   Filter SurOpenCases(SUR_CASE.CLOSED_ON is null)

   // Models still raising alerts. Note this does NOT find "models that should stay switched
   // on" -- that is a comparison of a measured rate against a snapshotted tolerance, which
   // no single-table filter can express.
   Filter SurLiveModels(SUR_MODEL.RETIRED_ON is null)
)
