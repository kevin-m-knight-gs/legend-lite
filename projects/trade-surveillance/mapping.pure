   // ---- THE SELF-ASSOCIATION MAPPING ----
   // [surCase, surCase] on both ends, the same set id twice. Only the direction of travel
   // over @Sur_RelatedCase tells them apart.
   trade_surveillance::SurCaseRelation: Relational
   {
      AssociationMapping
      (
         relatedCase[surCase, surCase]: [trade_surveillance::Store]@Sur_RelatedCase,
         linkedCases[surCase, surCase]: [trade_surveillance::Store]@Sur_RelatedCase
      )
   }

   // ---- Cross-project association mappings ----
   // `oexFill`, `oexOrderFillSummary`, `oexTradeBooking` and `tlcAmendment` are the
   // upstream set ids, taken from their MANIFESTs. Neither dependency has a default id --
   // both name every set explicitly -- so these cannot be guessed from the class names.

   trade_surveillance::SurFillEvidenceLink: Relational
   {
      AssociationMapping
      (
         evidenceFill[surFillEvidence, oexFill]: [trade_surveillance::Store]@Sur_FillEvidenceFill,
         surveillanceFillEvidence[oexFill, surFillEvidence]: [trade_surveillance::Store]@Sur_FillEvidenceFill
      )
   }

   trade_surveillance::SurWashBuyFillLink: Relational
   {
      AssociationMapping
