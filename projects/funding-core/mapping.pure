  *funding_core::FndCurveDefinition[fndCurve]: Relational
  {
    ~primaryKey ( [funding_core::Store]FND_CURVE.CURVE_ID )
    ~mainTable [funding_core::Store]FND_CURVE
    curveId: [funding_core::Store]FND_CURVE.CURVE_ID,
    curveName: [funding_core::Store]FND_CURVE.CURVE_NAME,
    currencyCode: [funding_core::Store]FND_CURVE.CURRENCY_CODE,
