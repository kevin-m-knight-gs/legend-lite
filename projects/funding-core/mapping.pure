    points[fndCurvePoint]: [funding_core::Store]@Fnd_CurvePoints
  }

  // The MILESTONED set. CURVE_ID and FROM_Z together are the key -- one curve has many
  // versions, and a version is only identified once you say which span. FROM_Z and THRU_Z
  // appear here and nowhere on the class; the engine adds the date predicate.
  *funding_core::FndCurveVersion[fndCurveVersion]: Relational
  {
    ~primaryKey ( [funding_core::Store]FND_CURVE_MS.CURVE_ID, [funding_core::Store]FND_CURVE_MS.FROM_Z )
    ~mainTable [funding_core::Store]FND_CURVE_MS
    curveId: [funding_core::Store]FND_CURVE_MS.CURVE_ID,
    curveName: [funding_core::Store]FND_CURVE_MS.CURVE_NAME,
    currencyCode: [funding_core::Store]FND_CURVE_MS.CURRENCY_CODE,
    methodology: [funding_core::Store]FND_CURVE_MS.METHODOLOGY,
    benchmarkCode: [funding_core::Store]FND_CURVE_MS.BENCHMARK_CODE,
    baseRateBps: [funding_core::Store]FND_CURVE_MS.BASE_RATE_BPS,
    status: [funding_core::Store]FND_CURVE_MS.STATUS,
    approvedBy: [funding_core::Store]FND_CURVE_MS.APPROVED_BY
  }

  *funding_core::FndCurvePoint[fndCurvePoint]: Relational
  {
    ~primaryKey ( [funding_core::Store]FND_CURVE_POINT.CURVE_ID, [funding_core::Store]FND_CURVE_POINT.POINT_SEQ )
    ~mainTable [funding_core::Store]FND_CURVE_POINT
    curveId: [funding_core::Store]FND_CURVE_POINT.CURVE_ID,
    pointSeq: [funding_core::Store]FND_CURVE_POINT.POINT_SEQ,
    bucketId: [funding_core::Store]FND_CURVE_POINT.BUCKET_ID,
    minDays: [funding_core::Store]FND_CURVE_POINT.MIN_DAYS,
    maxDays: [funding_core::Store]FND_CURVE_POINT.MAX_DAYS,
    transferRateBps: [funding_core::Store]FND_CURVE_POINT.TRANSFER_RATE_BPS,
    liquiditySpreadBps: [funding_core::Store]FND_CURVE_POINT.LIQUIDITY_SPREAD_BPS,
    curve[fndCurve]: [funding_core::Store]@Fnd_CurvePoints,
    // The keyed route across the project boundary, for contrast with the range one below.
    bucket[ctnBucket]: [funding_core::Store]@Fnd_PointTenorBucket,
    // The RANGE join traversed backwards: every cashflow that lands in this point's interval.
    cashflows[fndCashflow]: [funding_core::Store]@Fnd_CashflowPoint
  }

