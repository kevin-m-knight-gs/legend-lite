  *funding_core::FndCashflow[fndCashflow]: Relational
  {
    ~primaryKey ( [funding_core::Store]FND_CASHFLOW.CASHFLOW_ID )
    ~mainTable [funding_core::Store]FND_CASHFLOW
    cashflowId: [funding_core::Store]FND_CASHFLOW.CASHFLOW_ID,
    institutionId: [funding_core::Store]FND_CASHFLOW.INSTITUTION_ID,
    accountNo: [funding_core::Store]FND_CASHFLOW.ACCOUNT_NO,
    curveId: [funding_core::Store]FND_CASHFLOW.CURVE_ID,
    flowType: [funding_core::Store]FND_CASHFLOW.FLOW_TYPE,
    valueDate: [funding_core::Store]FND_CASHFLOW.VALUE_DATE,
    maturityDate: [funding_core::Store]FND_CASHFLOW.MATURITY_DATE,
    daysToMaturity: [funding_core::Store]FND_CASHFLOW.DAYS_TO_MATURITY,
    notional: [funding_core::Store]FND_CASHFLOW.NOTIONAL,
    currencyCode: [funding_core::Store]FND_CASHFLOW.CURRENCY_CODE,
    // Two-column join into another project's composite key.
    account[caAccount]: [funding_core::Store]@Fnd_CashflowAccount,
    curve[fndCurve]: [funding_core::Store]@Fnd_CashflowCurve,
    // The RANGE join, forwards, within this project: the priced point.
    point[fndCurvePoint]: [funding_core::Store]@Fnd_CashflowPoint,
    // The RANGE join, forwards, across the boundary: the standard tenor band.
    bucket[ctnBucket]: [funding_core::Store]@Fnd_CashflowTenorBucket
  }

