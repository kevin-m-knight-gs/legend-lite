###Service
Service dest::S_legacy
{
  pattern: '/legacy';
  documentation: '';
  execution: Single
  {
    query: |dest::CTrade.all()->project([x|$x.identifier, x|$x.units], ['identifier', 'units']);
    mapping: dest::M2M;
    runtime: dest::RT;
  }
  testSuites:
  [
    s:
    {
      data: [ connections: [ env: Reference #{ src::Seed }# ] ]
      tests:
      [
        t:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            a: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '[]'; }#; }#
          ]
        }
      ]
    }
  ]
}
