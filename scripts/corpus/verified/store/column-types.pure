    C_INTEGER INTEGER,
    C_INT INT,
    C_BIGINT BIGINT NOT NULL,
    C_SMALLINT SMALLINT,
    C_TINYINT TINYINT,
    C_FLOAT FLOAT,
    C_DOUBLE DOUBLE,
