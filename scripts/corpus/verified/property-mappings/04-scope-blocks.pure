###Pure
Class test::Person
{
  firstName: String[1];
  lastName: String[1];
  category: String[1];
  firmName: String[1];
  city: String[1];
  country: String[1];
}

###Relational
Database test::db
(
  Schema sales
  (
    Table PERSON_TBL
    (
      ID INTEGER PRIMARY KEY,
      FIRSTNAME VARCHAR(200),
      LASTNAME VARCHAR(200),
      STATE_CODE VARCHAR(10),
      FIRM_ID INTEGER,
      ADDR_ID INTEGER
    )
    Table FIRM_TBL
    (
      ID INTEGER PRIMARY KEY,
      LEGAL_NAME VARCHAR(200)
    )
  )

  Table ADDR_TBL
  (
    ID INTEGER PRIMARY KEY,
    CITY VARCHAR(200),
    COUNTRY VARCHAR(200)
  )
  Join Person_Firm(sales.PERSON_TBL.FIRM_ID = sales.FIRM_TBL.ID)
  Join Person_Addr(sales.PERSON_TBL.ADDR_ID = ADDR_TBL.ID)
)

###Mapping
Mapping test::M
(
  *test::Person: Relational
  {
    ~mainTable [test::db]sales.PERSON_TBL

    // full scope: database pointer + schema.table. Columns inside are bare names.
    scope([test::db]sales.PERSON_TBL)
    (
      firstName: FIRSTNAME,
      lastName: LASTNAME,
      category: if(equal(substring(STATE_CODE, 1, 2), 'US'), 'DOMESTIC', sqlNull()),
      firmName: @Person_Firm | FIRM_TBL.LEGAL_NAME
    ),

    // scope with only a database pointer: full schema.table.column paths inside
    scope([test::db])
    (
      city: ADDR_TBL.CITY,
      country: @Person_Addr | ADDR_TBL.COUNTRY
    )
  }
)
