###Pure
Class simple::Person
{
  firstName: String[1];
  lastName: String[1];
  age: Integer[1];
  firm: simple::Firm[1];
  manager: simple::Firm[1];
}

Class simple::Firm
{
  legalName: String[1];
}

###Relational
Database simple::dbInc
(
  Table personTable
  (
    ID INTEGER PRIMARY KEY,
    FIRSTNAME VARCHAR(200),
    LASTNAME VARCHAR(200),
    AGE INTEGER,
    FIRM SEMISTRUCTURED,
    FIRM_JSON JSON
  )

  Join personSelfJoin(personTable.ID = {target}.ID)
)

###ExternalFormat
Binding simple::TestBinding
{
  contentType: 'application/json';
  modelIncludes: [
    simple::Firm
  ];
}

###Mapping
Mapping simple::simpleRelationalMappingInc
(
  *simple::Person: Relational
  {
    ~mainTable [simple::dbInc]personTable
    firstName: [simple::dbInc]personTable.FIRSTNAME,
    lastName: [simple::dbInc]personTable.LASTNAME,
    age: [simple::dbInc]personTable.AGE,

    // Binding transformer over a SEMISTRUCTURED column
    firm: Binding simple::TestBinding: [simple::dbInc]personTable.FIRM,

    // Binding transformer over a join navigation onto a JSON column
    manager: Binding simple::TestBinding: [simple::dbInc]@personSelfJoin | [simple::dbInc]personTable.FIRM_JSON
  }
)
