// REJECTS: Field 'database' is required
//
// The walker half of the sink pair (the grammar half is
// neg-persistence-relational-sink-with-binding): `relationalSink: SINK_RELATIONAL BRACE_OPEN
// (sinkDatabase)* BRACE_CLOSE` accepts an empty body, so `sink: Relational { }` is a
// well-formed tree that names no database at all. visitRelationalSink requires it.
###Persistence
Persistence test::persistence::neg::EmptyRelationalSink
{
  doc: 'relational sink with no database';
  trigger: Manual;
  service: test::persistence::Service;
  persister: Batch
  {
    sink: Relational
    {
    }
    ingestMode: NontemporalSnapshot
    {
      auditing: None;
    }
    targetShape: Flat
    {
      modelClass: test::persistence::ModelClass;
      targetName: 'TestDataset1';
    }
  }
}
