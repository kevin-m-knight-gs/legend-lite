// REJECTS: Field 'batchIdOutName' is required
//
// One level deeper than the ingest-mode checks: inside a milestoning SCHEME the column names
// are `(batchIdInName | batchIdOutName)*` in the .g4 and both are required by
// visitBatchIdTransactionMilestoning. A BatchId scheme naming only the in-column parses.
###Persistence
Persistence test::persistence::neg::BatchIdNoOutName
{
  doc: 'batch id milestoning naming only the in column';
  trigger: Manual;
  service: test::persistence::Service;
  persister: Batch
  {
    sink: Relational
    {
      database: test::persistence::Database;
    }
    ingestMode: UnitemporalSnapshot
    {
      transactionMilestoning: BatchId
      {
        batchIdInName: 'BATCH_IN';
      }
    }
    targetShape: Flat
    {
      modelClass: test::persistence::ModelClass;
      targetName: 'TestDataset1';
    }
  }
}
