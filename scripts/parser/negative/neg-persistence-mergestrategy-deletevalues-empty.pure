// REJECTS: PLACEHOLDER
//
// The other half of the v1/v2 `deleteValues` divergence: the v1 list is
// `STRING (COMMA STRING)*` with no `?` around it, so it cannot be EMPTY, while the v2 list is
// `(identifier (COMMA identifier)*)?` and an empty `[]` is legal there.
//
// An empty bracket pair is the kind of thing a hand-written parser normalises away without
// noticing which of the two rules it is implementing.
###Persistence
Persistence test::persistence::neg::MergeStrategyEmptyValues
{
  doc: 'v1 merge strategy with an empty delete value list';
  trigger: Manual;
  service: test::persistence::Service;
  persister: Batch
  {
    sink: Relational
    {
      database: test::persistence::Database;
    }
    ingestMode: UnitemporalDelta
    {
      mergeStrategy: DeleteIndicator
      {
        deleteField: deleted;
        deleteValues: [];
      }
      transactionMilestoning: BatchId
      {
        batchIdInName: 'BATCH_IN';
        batchIdOutName: 'BATCH_OUT';
      }
    }
    targetShape: Flat
    {
      modelClass: test::persistence::ModelClass;
      targetName: 'TestDataset1';
    }
  }
}
