// nowhere to write, and the grammar does not mind.
###Persistence
Persistence test::persistence::neg::BatchNoSink
{
  doc: 'batch persister with no sink';
  trigger: Manual;
  service: test::persistence::Service;
  persister: Batch
  {
    ingestMode: NontemporalSnapshot
    {
      auditing: None;
    }
    targetShape: Flat
    {
      modelClass: test::persistence::ModelClass;
      targetName: 'TestDataset1';
    }
  }
}
