<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.finos.legend</groupId>
        <artifactId>legend-lite</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>legend-lite-engine</artifactId>
    <packaging>jar</packaging>
    <name>Legend Lite - Engine</name>

    <properties>
        <surefire.excludedGroups>heavy</surefire.excludedGroups>
    </properties>
    <description>Core Legend Lite engine with Pure parser, compiler, and SQL generator.</description>

    <dependencies>
        <!-- legend-lite-core: the replacement pipeline. QueryService delegates
             to core (PHASE_K_EXECUTION.md); the engine pipeline remains
             reachable via -Dlegend.pipeline=engine. -->
        <dependency>
            <groupId>org.finos.legend</groupId>
            <artifactId>legend-lite-core</artifactId>
        </dependency>

        <!-- DuckDB JDBC Driver -->
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
        </dependency>

        <!-- H2 (test only): the ADVISORY SECOND TARGET (#67) — the
             corpus's golden SQL executes on the engine's own dialect and
             its rows verify against ours; the platform itself never
             depends on H2 (core detects the driver reflectively). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.1.214</version>
            <scope>test</scope>
        </dependency>

        <!-- SQLite JDBC Driver -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>

        <!-- JUnit 5 (test scope) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Surefire: exclude heavy tests from default suite -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
