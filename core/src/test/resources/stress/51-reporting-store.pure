###Mapping
Mapping reporting::FlatMapping
(
    include trading::Codes

    // The navigated columns are [0..1] on the class because the denormalization encodes
    // the OUTER JOIN RESULT: TRD-0007's counterparty does not exist and two trades have
    // no trader, so those columns are genuinely NULL here — exactly as they are on the
    // canonical side.
    reporting::FlatTrade: Relational {
        ~mainTable [store::DB] TRADE_FLAT
        tradeId: [store::DB] TRADE_FLAT.TRADE_ID,
        tradeDate: [store::DB] TRADE_FLAT.TRADE_DATE,
        quantity: [store::DB] TRADE_FLAT.QUANTITY,
        price: [store::DB] TRADE_FLAT.PRICE,
        notional: [store::DB] TRADE_FLAT.NOTIONAL,
        side: EnumerationMapping SideMapping: [store::DB] TRADE_FLAT.SIDE,
        status: [store::DB] TRADE_FLAT.STATUS,
        currency: [store::DB] TRADE_FLAT.CURRENCY,
        instrName: [store::DB] TRADE_FLAT.INSTR_NAME,
        instrTicker: [store::DB] TRADE_FLAT.INSTR_TICKER,
        instrIsin: [store::DB] TRADE_FLAT.INSTR_ISIN,
        bookName: [store::DB] TRADE_FLAT.BOOK_NAME,
        cptyName: [store::DB] TRADE_FLAT.CPTY_NAME,
        cptyLei: [store::DB] TRADE_FLAT.CPTY_LEI,
        traderLast: [store::DB] TRADE_FLAT.TRADER_LAST
    }
)


###Mapping
// The real mapping-invariance test: the SAME class, trading::Trade, mapped to the
// denormalized table instead of the normalized one. N0 and N2 are the identical query
// text — same root, same property paths — differing only in which mapping resolves them.
//
// The four navigations are EMBEDDED property mappings: `instrument ( ... )` binds the
// association end's properties directly to columns of TRADE_FLAT, so no join is emitted
// at all. Association ends are legal here (the property is resolved via
// _propertiesFromAssociations); what is NOT legal is an embedded block inside an
// AssociationMapping, which fails with "Can't find property owner class for property".
Mapping reporting::EmbeddedFlatMapping
(
    include trading::Codes

    trading::Trade: Relational {
        ~primaryKey ([store::DB] TRADE_FLAT.TRADE_ID)
        ~mainTable [store::DB] TRADE_FLAT
        tradeId: [store::DB] TRADE_FLAT.TRADE_ID,
        tradeDate: [store::DB] TRADE_FLAT.TRADE_DATE,
        settlementDate: [store::DB] TRADE_FLAT.SETTLEMENT_DATE,
        quantity: [store::DB] TRADE_FLAT.QUANTITY,
        price: [store::DB] TRADE_FLAT.PRICE,
        notional: [store::DB] TRADE_FLAT.NOTIONAL,
        side: EnumerationMapping SideMapping: [store::DB] TRADE_FLAT.SIDE,
        status: [store::DB] TRADE_FLAT.STATUS,
        tradeType: [store::DB] TRADE_FLAT.TRADE_TYPE,
        currency: [store::DB] TRADE_FLAT.CURRENCY,
        commission: [store::DB] TRADE_FLAT.COMMISSION,
        fees: [store::DB] TRADE_FLAT.FEES,
        executionVenue: [store::DB] TRADE_FLAT.EXECUTION_VENUE,
        isBlock: [store::DB] TRADE_FLAT.IS_BLOCK,
        createdTime: [store::DB] TRADE_FLAT.CREATED_TIME,
        lastModifiedTime: [store::DB] TRADE_FLAT.LAST_MODIFIED_TIME,
        instrument
        (
            instrumentId: [store::DB] TRADE_FLAT.INSTR_ID,
            name: [store::DB] TRADE_FLAT.INSTR_NAME,
            ticker: [store::DB] TRADE_FLAT.INSTR_TICKER,
            isin: [store::DB] TRADE_FLAT.INSTR_ISIN,
            assetClass: [store::DB] TRADE_FLAT.INSTR_ASSET_CLASS,
            currency: [store::DB] TRADE_FLAT.INSTR_CURRENCY
        ),
        book
        (
            bookId: [store::DB] TRADE_FLAT.BOOK_ID,
            name: [store::DB] TRADE_FLAT.BOOK_NAME,
            currency: [store::DB] TRADE_FLAT.BOOK_CURRENCY
        ),
        counterparty
        (
            counterpartyId: [store::DB] TRADE_FLAT.CPTY_ID,
            legalName: [store::DB] TRADE_FLAT.CPTY_NAME,
            lei: [store::DB] TRADE_FLAT.CPTY_LEI,
            tier: [store::DB] TRADE_FLAT.CPTY_TIER
        ),
        trader
        (
            traderId: [store::DB] TRADE_FLAT.TRADER_ID,
            firstName: [store::DB] TRADE_FLAT.TRADER_FIRST,
            lastName: [store::DB] TRADE_FLAT.TRADER_LAST
        )
    }
)

###Mapping
Mapping reporting::RollupMapping
(
    // The association mapping that makes the view REACHABLE. Without it BookRollup is an
    // island: nothing navigates to it, so the only service that ever touched `View` was the
    // one rooted at it, and the construct sat at three of its forty possible feature pairs.
    // A construct nothing can reach is a construct nothing can combine.
    reporting::BookHasRollup: Relational {
        AssociationMapping (
            rollup: [store::DB] @Book_Rollup,
            book: [store::DB] @Book_Rollup
        )
    }

    reporting::BookRollup: Relational {
        ~primaryKey ([store::DB] NOTIONAL_BY_BOOK.BOOK_ID)
        ~mainTable [store::DB] NOTIONAL_BY_BOOK
        bookId: [store::DB] NOTIONAL_BY_BOOK.BOOK_ID,
        tradeCount: [store::DB] NOTIONAL_BY_BOOK.TRADE_COUNT,
        totalNotional: [store::DB] NOTIONAL_BY_BOOK.TOTAL_NOTIONAL,
        maxNotional: [store::DB] NOTIONAL_BY_BOOK.MAX_NOTIONAL
    }
)

###Mapping
// The INLINE form of the same denormalization. Where EmbeddedFlatMapping repeats the
// counterparty's column bindings inside the property block, this one names a root set
// implementation and reuses ITS bindings:
//
//     counterparty () Inline[cptyInline]
//
// The property block must be EMPTY -- the whole point is that the mapping lives once, in
// the referenced root, and is shared. Both roots read the SAME table, which is what makes
// the reuse meaningful rather than a redirection to somewhere else.
//
// The result must equal what the embedded form returns, and what the canonical joined
// model returns: a fourth member of the L2 invariance group.
Mapping reporting::InlineFlatMapping
(
    include trading::Codes

    counterparty::Counterparty[cptyInline]: Relational {
        ~primaryKey ([store::DB] TRADE_FLAT.CPTY_ID)
        ~mainTable [store::DB] TRADE_FLAT
        counterpartyId: [store::DB] TRADE_FLAT.CPTY_ID,
        legalName: [store::DB] TRADE_FLAT.CPTY_NAME,
        lei: [store::DB] TRADE_FLAT.CPTY_LEI,
        tier: [store::DB] TRADE_FLAT.CPTY_TIER
    }

    trading::Trade: Relational {
        ~primaryKey ([store::DB] TRADE_FLAT.TRADE_ID)
        ~mainTable [store::DB] TRADE_FLAT
        tradeId: [store::DB] TRADE_FLAT.TRADE_ID,
        tradeDate: [store::DB] TRADE_FLAT.TRADE_DATE,
        quantity: [store::DB] TRADE_FLAT.QUANTITY,
        price: [store::DB] TRADE_FLAT.PRICE,
        notional: [store::DB] TRADE_FLAT.NOTIONAL,
        side: EnumerationMapping SideMapping: [store::DB] TRADE_FLAT.SIDE,
        status: [store::DB] TRADE_FLAT.STATUS,
        currency: [store::DB] TRADE_FLAT.CURRENCY,
        instrument
        (
            name: [store::DB] TRADE_FLAT.INSTR_NAME,
            ticker: [store::DB] TRADE_FLAT.INSTR_TICKER,
            isin: [store::DB] TRADE_FLAT.INSTR_ISIN
        ),
        book
        (
            name: [store::DB] TRADE_FLAT.BOOK_NAME
        ),
        counterparty () Inline[cptyInline],
        trader
        (
            lastName: [store::DB] TRADE_FLAT.TRADER_LAST
        )
    }
)


###Runtime
Runtime stress::InlineFlatRT
{
    mappings: [ reporting::InlineFlatMapping ];
    connections: [ store::DB: [ environment: store::Conn ] ];
}

###Pure
// Declared here rather than in a domain file because the view it reaches is declared here.
// `rollup` is [0..1]: four books, three rollup rows, so one book has none.
Association reporting::BookHasRollup
{
   book: positions::Book[0..1];
   rollup: reporting::BookRollup[0..1];
}
