      ~filter [store::DB]TrfSecuritiesFinancingFlagRows
   }

   mifidfields::RejectionFeedbackItem[trfRejectionFeedback] extends [mifidfieldsBase]: Relational
   {
      ~filter [store::DB]TrfRejectionFeedbackRows
   }
)
