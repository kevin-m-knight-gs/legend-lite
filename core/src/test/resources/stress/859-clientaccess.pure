      status: [store::DB]CLIENT_ACCESS_ARRANGEMENT.STATUS,
      isActive: [store::DB]CLIENT_ACCESS_ARRANGEMENT.IS_ACTIVE,
      riskScore: [store::DB]CLIENT_ACCESS_ARRANGEMENT.RISK_SCORE
   }

