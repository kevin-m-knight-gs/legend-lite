      recordId: [store::DB]CLIENT_ACCESS_ARRANGEMENT.RECORD_ID,
      recordType: [store::DB]CLIENT_ACCESS_ARRANGEMENT.RECORD_TYPE,
      bookId: [store::DB]CLIENT_ACCESS_ARRANGEMENT.BOOK_ID,
      notional: [store::DB]CLIENT_ACCESS_ARRANGEMENT.NOTIONAL,
      currency: [store::DB]CLIENT_ACCESS_ARRANGEMENT.CURRENCY,
      tradeDate: [store::DB]CLIENT_ACCESS_ARRANGEMENT.TRADE_DATE,
