###Pure
// OTC derivatives: the product taxonomy.
//
// Thirteen products over three tables, which is how a firm actually models this. The terms
// every OTC trade shares -- counterparty, notional, dates, clearing, master agreement -- sit
// in one table with a PRODUCT_TYPE discriminator; the parts that differ per family sit in
// their own. A swap has legs, an option has a strike and an expiry, a variance swap has
// neither, and a single wide table would carry forty nulls a row.
//
// Each subtype carries the risk measure its own desk quotes, which is the honest difference
// between these products at this level of detail: a rates swap is sized in DV01, a basis
// swap in spread DV01 an order of magnitude smaller, a CDS in loss-given-default net of
// recovery, a variance swap in vega notional. None of it is a pricing model -- these are the
// crude pre-trade numbers a limit check uses.
Class derivatives::OtcTrade
{
   otcId: String[1];
   productType: String[1];
   assetClass: String[1];
   counterpartyId: String[1];
   tradeDate: StrictDate[1];
   effectiveDate: StrictDate[1];
   terminationDate: StrictDate[1];
   notional: Float[1];
   currency: String[1];
   clearingStatus: String[1];
   // Null for a bilateral trade: there is no clearing house, rather than an unknown one.
   clearingHouse: String[0..1];
   masterAgreement: String[0..1];
   collateralised: Boolean[1];

   // Tenor in years, which every risk number below is a function of.
   //
   // The unit is the DurationUnit enum, fully qualified. A relational mapping takes the
   // string 'DAYS' -- its lowering strips the quotes -- but a Pure expression will not:
   // "Can't find a match for function dateDiff(StrictDate[1],StrictDate[1],String[1])".
   // The same function, spelled two ways depending on which side of the mapping it is on.
   tenorYears() { dateDiff($this.effectiveDate, $this.terminationDate, meta::pure::functions::date::DurationUnit.DAYS) / 365.0 } : Float[1];
   // Notional converted at a caller-supplied rate. FX is never a property of the trade.
   notionalIn(fxRate: Float[1]) { $this.notional * $fxRate } : Float[1];
}

// A vanilla fixed-for-floating swap -- the most traded OTC product there is.
Class derivatives::InterestRateSwap extends derivatives::OtcTrade
{
   // DV01 per basis point, the way a rates desk sizes a swap: notional x tenor x 0.0001.
   // The tenor is written out rather than calling tenorYears(): a derived property calling
   // another derived property is not in the oracle's expression grammar, and inlining is
   // honest where pretending would not be.
   dv01() { $this.notional * (dateDiff($this.effectiveDate, $this.terminationDate, meta::pure::functions::date::DurationUnit.DAYS) / 365.0) * 0.0001 } : Float[1];
}

// Fixed against a compounded overnight index. Since the LIBOR transition this is what
// the discounting curve is built from.
Class derivatives::OvernightIndexSwap extends derivatives::OtcTrade
{
   dv01() { $this.notional * (dateDiff($this.effectiveDate, $this.terminationDate, meta::pure::functions::date::DurationUnit.DAYS) / 365.0) * 0.0001 } : Float[1];
}

// Floating against floating on two tenors of the same index. NEITHER leg is fixed, which
// is the case a 'one leg is fixed' assumption gets wrong.
Class derivatives::BasisSwap extends derivatives::OtcTrade
{
   // A basis swap carries no outright rate risk; the exposure is the spread between
   // the two tenors, which is an order of magnitude smaller.
   spreadDv01() { $this.notional * (dateDiff($this.effectiveDate, $this.terminationDate, meta::pure::functions::date::DurationUnit.DAYS) / 365.0) * 0.00001 } : Float[1];
}

// A single forward period, cash settled against the rate fixing. No legs at all.
Class derivatives::ForwardRateAgreement extends derivatives::OtcTrade
{
   settlementRisk() { $this.notional * 0.0025 } : Float[1];
}

// An option to enter a swap. A payer swaption pays fixed if it is exercised.
Class derivatives::Swaption extends derivatives::OtcTrade
{
   // Premium at risk is capped at the notional for the buyer; this is the crude
   // pre-trade limit check, not a pricing model.
   maxLoss() { $this.notional * 0.05 } : Float[1];
}

// A strip of caplets on a floating index, one per reset.
Class derivatives::InterestRateCap extends derivatives::OtcTrade
{
   maxLoss() { $this.notional * 0.03 } : Float[1];
}

// Protection on a single reference entity. The premium is quoted in basis points and the
// exposure on default is the notional less recovery.
Class derivatives::CreditDefaultSwap extends derivatives::OtcTrade
{
   // Standard 40% recovery assumption for senior unsecured.
   lossGivenDefault() { $this.notional * 0.60 } : Float[1];
}

// Protection on a standardised index basket. Notionals are large because the risk is
// diversified across the constituents.
Class derivatives::CreditIndexTrade extends derivatives::OtcTrade
{
   // Diversified, so the single-name equivalent is a fraction of the notional.
   singleNameEquivalent() { $this.notional / 125.0 } : Float[1];
}

// An FX forward on a currency that cannot be delivered, cash settled in USD.
Class derivatives::NonDeliverableForward extends derivatives::OtcTrade
{
   settlementRisk() { $this.notional * 0.02 } : Float[1];
}

// An FX option, here with a knock-out barrier.
Class derivatives::FxOption extends derivatives::OtcTrade
{
   maxLoss() { $this.notional * 0.04 } : Float[1];
}

// Total return on an equity index against a funding leg.
Class derivatives::EquitySwap extends derivatives::OtcTrade
{
   // Equity delta is the whole notional: a total return swap is fully directional.
   equityDelta() { $this.notional } : Float[1];
}

// Realised variance against a strike. No legs: the payoff is a formula, not a schedule.
Class derivatives::VarianceSwap extends derivatives::OtcTrade
{
   // Vega notional, which is how a variance swap is actually sized and quoted.
   vegaNotional() { $this.notional / 2.0 } : Float[1];
}

// A fixed price against a floating commodity index.
Class derivatives::CommoditySwap extends derivatives::OtcTrade
{
   commodityDelta() { $this.notional } : Float[1];
}

// A swap's legs. Two for a swap, none for an option or a variance swap.
Class derivatives::SwapLeg
{
   legId: String[1];
   otcId: String[1];
   legNumber: Integer[1];
   legType: String[1];
   payReceive: String[1];
   // Null on a floating leg, and the floating fields are null on a fixed one. Both are
   // genuinely absent rather than unknown.
   fixedRate: Float[0..1];
   floatingIndex: String[0..1];
   spreadBp: Float[0..1];
   resetFrequency: String[0..1];
   paymentFrequency: String[1];
   dayCount: String[1];
   legNotional: Float[1];
   legCurrency: String[1];
}

// Option terms, for the three trades that have them.
Class derivatives::OptionTerms
{
   otcId: String[1];
   optionStyle: String[1];
   callPut: String[1];
   strike: Float[1];
   premium: Float[1];
   premiumCurrency: String[1];
   expiryDate: StrictDate[1];
   underlyingTenor: String[0..1];
   barrierLevel: Float[0..1];
   barrierType: String[0..1];
}

Association derivatives::TradeLegs
{
   trade: derivatives::OtcTrade[0..1];
   legs: derivatives::SwapLeg[*];
}

Association derivatives::TradeOptionTerms
{
   optionTrade: derivatives::OtcTrade[0..1];
   optionTerms: derivatives::OptionTerms[0..1];
}

// ---------------------------------------------------------------- the exotic book
//
// Fifty-eight further product types, all real, over the same base table. This is what a
// derivatives taxonomy looks like at a firm that runs an exotics desk: the vanilla thirteen
// above are the flow, and these are what the structuring desk actually sells.
//
// Each carries the measure its own desk quotes, because that is the honest difference
// between them at this level of detail -- a Bermudan swaption is sized in exercise vega, a
// tranche in correlation risk, an accumulator in gamma, a longevity swap in basis. None of
// it is a pricing model.
//
// Most have no rows today, and that is realistic rather than a gap: a firm's product
// taxonomy covers what it CAN book, not what it happens to hold this morning. The
// discriminator still has to be right, and a service over an empty subtype still has to
// return an empty result rather than the whole table -- which is precisely the thing that
// breaks when a ~filter is wrong.

// Pays a long-tenor swap rate rather than a short index, so it is exposed to the SHAPE of the curve and not just its level.
Class derivatives::ConstantMaturitySwap extends derivatives::OtcTrade
{
   cmsDv01() { $this.notional * 0.00012 } : Float[1];
}

// Fixed against a realised inflation index. The floating leg is published monthly and revised.
Class derivatives::InflationSwap extends derivatives::OtcTrade
{
   inflationDv01() { $this.notional * 0.00009 } : Float[1];
}

// Two floating legs in different currencies, with notional exchanged at both ends. Carries FX risk a single-currency swap does not.
Class derivatives::CrossCurrencySwap extends derivatives::OtcTrade
{
   xccyBasisRisk() { $this.notional * 0.00015 } : Float[1];
}

// Notional steps down on a schedule, usually to match a loan being repaid.
Class derivatives::AmortisingSwap extends derivatives::OtcTrade
{
   averageLifeDv01() { $this.notional * 0.00006 } : Float[1];
}

// Notional steps up, matching a facility being drawn.
Class derivatives::AccretingSwap extends derivatives::OtcTrade
{
   averageLifeDv01() { $this.notional * 0.00007 } : Float[1];
}

// Notional both accretes and amortises across the life.
Class derivatives::RollercoasterSwap extends derivatives::OtcTrade
{
   averageLifeDv01() { $this.notional * 0.00007 } : Float[1];
}

// One payment at maturity rather than a schedule, so all the cash flow risk sits at the end.
Class derivatives::ZeroCouponSwap extends derivatives::OtcTrade
{
   terminalDv01() { $this.notional * 0.00018 } : Float[1];
}

// The floating leg fixes at the END of the period, which gives it convexity a vanilla swap has none of.
Class derivatives::ArrearsSwap extends derivatives::OtcTrade
{
   convexityAdjustment() { $this.notional * 0.00002 } : Float[1];
}

// A swap the issuer can cancel. Equivalent to a swap plus a swaption.
Class derivatives::CallableSwap extends derivatives::OtcTrade
{
   optionAdjustedDv01() { $this.notional * 0.00008 } : Float[1];
}

// Accrues a coupon only on days the index sits inside a corridor.
Class derivatives::RangeAccrual extends derivatives::OtcTrade
{
   accrualRisk() { $this.notional * 0.00004 } : Float[1];
}

// An option on the difference between two swap rates, so it prices the curve slope directly.
Class derivatives::CmsSpreadOption extends derivatives::OtcTrade
{
   slopeVega() { $this.notional * 0.00025 } : Float[1];
}

// Exercisable on several dates rather than one. The hardest vanilla-adjacent product to price.
Class derivatives::BermudanSwaption extends derivatives::OtcTrade
{
   exerciseVega() { $this.notional * 0.00060 } : Float[1];
}

// A swaption whose underlying starts well after expiry.
Class derivatives::MidcurveSwaption extends derivatives::OtcTrade
{
   forwardVega() { $this.notional * 0.00045 } : Float[1];
}

// A strip of floorlets. The mirror of a cap.
Class derivatives::InterestRateFloor extends derivatives::OtcTrade
{
   floorVega() { $this.notional * 0.00030 } : Float[1];
}

// A cap bought and a floor sold, which fixes the cost at the price of giving up the upside.
Class derivatives::InterestRateCollar extends derivatives::OtcTrade
{
   netVega() { $this.notional * 0.00012 } : Float[1];
}

// Pays a fixed amount rather than the excess, so the payoff is discontinuous at the strike.
Class derivatives::DigitalCap extends derivatives::OtcTrade
{
   digitalRisk() { $this.notional * 0.00050 } : Float[1];
}

// Protection on a slice of an index's loss distribution. Correlation is the primary risk, not spread.
Class derivatives::CdsTranche extends derivatives::OtcTrade
{
   correlationRisk() { $this.notional * 0.00080 } : Float[1];
}

// Pays on the first name in a basket to default. Long correlation.
Class derivatives::FirstToDefaultBasket extends derivatives::OtcTrade
{
   basketCorrelation() { $this.notional * 0.00120 } : Float[1];
}

// Pays on the nth default. Higher n is longer correlation still.
Class derivatives::NthToDefaultBasket extends derivatives::OtcTrade
{
   basketCorrelation() { $this.notional * 0.00100 } : Float[1];
}

// Trades the recovery rate itself, stripped of default timing.
Class derivatives::RecoverySwap extends derivatives::OtcTrade
{
   recoveryRisk() { $this.notional * 0.00040 } : Float[1];
}

// A funded note whose principal is written down on a credit event.
Class derivatives::CreditLinkedNote extends derivatives::OtcTrade
{
   fundedLgd() { $this.notional * 0.60 } : Float[1];
}

// A CDS whose spread resets to the prevailing market spread.
Class derivatives::ConstantMaturityCds extends derivatives::OtcTrade
{
   spreadResetRisk() { $this.notional * 0.00035 } : Float[1];
}

// Protection referencing secured loans, so recovery assumptions are far higher.
Class derivatives::LoanCds extends derivatives::OtcTrade
{
   securedLgd() { $this.notional * 0.30 } : Float[1];
}

// Protection on a sovereign. Restructuring is the usual trigger rather than bankruptcy.
Class derivatives::SovereignCds extends derivatives::OtcTrade
{
   sovereignLgd() { $this.notional * 0.65 } : Float[1];
}

// A spot and a forward in one trade. Funding, not direction.
Class derivatives::FxSwap extends derivatives::OtcTrade
{
   fundingBasis() { $this.notional * 0.00005 } : Float[1];
}

// Knocks in or out when spot touches a level, so the delta is discontinuous at the barrier.
Class derivatives::FxBarrierOption extends derivatives::OtcTrade
{
   barrierGap() { $this.notional * 0.00090 } : Float[1];
}

// Pays a fixed amount if spot ends the right side of a strike.
Class derivatives::FxDigital extends derivatives::OtcTrade
{
   digitalRisk() { $this.notional * 0.00070 } : Float[1];
}

// Settles against an AVERAGE of fixings, which damps the vega considerably.
Class derivatives::FxAsianOption extends derivatives::OtcTrade
{
   averagingVega() { $this.notional * 0.00030 } : Float[1];
}

// Accumulates a position daily while spot stays in range, and doubles up below it.
Class derivatives::FxAccumulator extends derivatives::OtcTrade
{
   accumulatorGamma() { $this.notional * 0.00150 } : Float[1];
}

// Redeems early once accumulated gains hit a target. The client is short the tail.
Class derivatives::FxTargetRedemptionForward extends derivatives::OtcTrade
{
   tarfTailRisk() { $this.notional * 0.00200 } : Float[1];
}

// Pays a foreign asset's return in domestic currency at a fixed FX rate.
Class derivatives::QuantoForward extends derivatives::OtcTrade
{
   quantoCorrelation() { $this.notional * 0.00045 } : Float[1];
}

// A cross-currency swap on a non-deliverable currency, cash settled throughout.
Class derivatives::NonDeliverableSwap extends derivatives::OtcTrade
{
   ndsSettlementRisk() { $this.notional * 0.00025 } : Float[1];
}

// A bilateral equity option, struck off-exchange with bespoke terms.
Class derivatives::OtcEquityOption extends derivatives::OtcTrade
{
   equityVega() { $this.notional * 0.00080 } : Float[1];
}

// Trades realised dividends against a fixed strike. No price exposure at all.
Class derivatives::DividendSwap extends derivatives::OtcTrade
{
   dividendRisk() { $this.notional * 0.00060 } : Float[1];
}

// Total return of a single name against funding.
Class derivatives::EquityTotalReturnSwap extends derivatives::OtcTrade
{
   equityDelta() { $this.notional } : Float[1];
}

// Redeems early if the underlying is above a trigger on an observation date. Short a down-and-in put.
Class derivatives::Autocallable extends derivatives::OtcTrade
{
   autocallGamma() { $this.notional * 0.00180 } : Float[1];
}

// A high coupon paid for by a short put. The client is long yield and short the crash.
Class derivatives::ReverseConvertible extends derivatives::OtcTrade
{
   shortPutDelta() { $this.notional * 0.40 } : Float[1];
}

// A series of forward-starting options, so the risk is to forward volatility rather than spot volatility.
Class derivatives::Cliquet extends derivatives::OtcTrade
{
   forwardVolRisk() { $this.notional * 0.00110 } : Float[1];
}

// Strikes at the best level reached over the life. Expensive, and pure path dependency.
Class derivatives::LookbackOption extends derivatives::OtcTrade
{
   pathRisk() { $this.notional * 0.00140 } : Float[1];
}

// An option on a weighted basket, so correlation between the members is priced directly.
Class derivatives::BasketOption extends derivatives::OtcTrade
{
   basketCorrelation() { $this.notional * 0.00095 } : Float[1];
}

// Pays on the best or worst of several underlyings. Correlation again, and the wrong sign.
Class derivatives::RainbowOption extends derivatives::OtcTrade
{
   worstOfRisk() { $this.notional * 0.00130 } : Float[1];
}

// Realised volatility against a strike, linear in vol where a variance swap is linear in variance.
Class derivatives::VolatilitySwap extends derivatives::OtcTrade
{
   volNotional() { $this.notional / 2.0 } : Float[1];
}

// Accrues variance only while spot is inside a corridor.
Class derivatives::CorridorVarianceSwap extends derivatives::OtcTrade
{
   corridorVega() { $this.notional * 0.00075 } : Float[1];
}

// Variance weighted by spot, so the exposure grows as the market rallies.
Class derivatives::GammaSwap extends derivatives::OtcTrade
{
   spotWeightedGamma() { $this.notional * 0.00085 } : Float[1];
}

// Financing against equity collateral. The rate is the borrow, not the risk-free.
Class derivatives::EquityRepo extends derivatives::OtcTrade
{
   borrowRisk() { $this.notional * 0.00020 } : Float[1];
}

// An option on a commodity future, usually with wide smile.
Class derivatives::CommodityOption extends derivatives::OtcTrade
{
   commodityVega() { $this.notional * 0.00100 } : Float[1];
}

// An option on the spread between two commodities -- crack, spark, crush.
Class derivatives::CommoditySpreadOption extends derivatives::OtcTrade
{
   spreadCorrelation() { $this.notional * 0.00090 } : Float[1];
}

// Settles against a monthly average, which is how physical commodity contracts price.
Class derivatives::CommodityAsianOption extends derivatives::OtcTrade
{
   averagingVega() { $this.notional * 0.00050 } : Float[1];
}

// Pays on heating or cooling degree days. Uncorrelated with everything else in the book.
Class derivatives::WeatherDerivative extends derivatives::OtcTrade
{
   weatherBasis() { $this.notional * 0.00300 } : Float[1];
}

// A forward on a shipping route's rate. Settles against a published index.
Class derivatives::FreightForwardAgreement extends derivatives::OtcTrade
{
   freightBasis() { $this.notional * 0.00250 } : Float[1];
}

// A forward on carbon allowances, whose supply is set by policy rather than by producers.
Class derivatives::EmissionsForward extends derivatives::OtcTrade
{
   policyRisk() { $this.notional * 0.00220 } : Float[1];
}

// A long-dated FX and rates hybrid, callable, and famously hard to hedge.
Class derivatives::PowerReverseDualCurrency extends derivatives::OtcTrade
{
   hybridCorrelation() { $this.notional * 0.00280 } : Float[1];
}

// A range accrual the issuer can call, so it is short volatility twice over.
Class derivatives::CallableRangeAccrual extends derivatives::OtcTrade
{
   callableAccrualRisk() { $this.notional * 0.00160 } : Float[1];
}

// Strips a convertible into its bond and its option, so each desk holds the part it wants.
Class derivatives::ConvertibleAssetSwap extends derivatives::OtcTrade
{
   stripRisk() { $this.notional * 0.00070 } : Float[1];
}

// A funded note whose redemption tracks an equity payoff.
Class derivatives::EquityLinkedNote extends derivatives::OtcTrade
{
   fundedEquityDelta() { $this.notional * 0.85 } : Float[1];
}

// Pays an inflation-linked coupon against nominal funding.
Class derivatives::InflationLinkedSwap extends derivatives::OtcTrade
{
   realRateDv01() { $this.notional * 0.00011 } : Float[1];
}

// Transfers the risk that a pension scheme's members live longer than assumed.
Class derivatives::LongevitySwap extends derivatives::OtcTrade
{
   longevityBasis() { $this.notional * 0.00400 } : Float[1];
}

// A forward on mortgage pools not yet specified. Prepayment is the risk that matters.
Class derivatives::MortgageTba extends derivatives::OtcTrade
{
   prepaymentRisk() { $this.notional * 0.00130 } : Float[1];
}

###Mapping
Mapping derivatives::OtcMapping
(
   // The ROOT set. A class mapped by more than one set implementation needs exactly one
   // root, or compilation fails with "mapped by N set implementations and has 0 roots".
   *derivatives::OtcTrade[otcBase]: Relational
   {
      ~primaryKey ( [store::DB]OTC_TRADE.OTC_ID )
      ~mainTable [store::DB]OTC_TRADE
      otcId: [store::DB]OTC_TRADE.OTC_ID,
      productType: [store::DB]OTC_TRADE.PRODUCT_TYPE,
      assetClass: [store::DB]OTC_TRADE.ASSET_CLASS,
      counterpartyId: [store::DB]OTC_TRADE.COUNTERPARTY_ID,
      tradeDate: [store::DB]OTC_TRADE.TRADE_DATE,
      effectiveDate: [store::DB]OTC_TRADE.EFFECTIVE_DATE,
      terminationDate: [store::DB]OTC_TRADE.TERMINATION_DATE,
      notional: [store::DB]OTC_TRADE.NOTIONAL,
      currency: [store::DB]OTC_TRADE.CURRENCY,
      clearingStatus: [store::DB]OTC_TRADE.CLEARING_STATUS,
      clearingHouse: [store::DB]OTC_TRADE.CLEARING_HOUSE,
      masterAgreement: [store::DB]OTC_TRADE.MASTER_AGREEMENT,
      collateralised: [store::DB]OTC_TRADE.COLLATERALISED
   }

   // `extends [otcBase]` inherits every property mapping above, so each subtype declares
   // only its discriminator. Thirteen products, thirteen filters, one table.
   // InterestRateSwap
   derivatives::InterestRateSwap[otcIrs] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcIrsRows
   }

   // OvernightIndexSwap
   derivatives::OvernightIndexSwap[otcOis] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcOisRows
   }

   // BasisSwap
   derivatives::BasisSwap[otcBasisSwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcBasisSwapRows
   }

   // ForwardRateAgreement
   derivatives::ForwardRateAgreement[otcFra] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcFraRows
   }

   // Swaption
   derivatives::Swaption[otcSwaption] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcSwaptionRows
   }

   // InterestRateCap
   derivatives::InterestRateCap[otcCap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcCapRows
   }

   // CreditDefaultSwap
   derivatives::CreditDefaultSwap[otcCds] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcCdsRows
   }

   // CreditIndexTrade
   derivatives::CreditIndexTrade[otcCdsIndex] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcCdsIndexRows
   }

   // NonDeliverableForward
   derivatives::NonDeliverableForward[otcNdf] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcNdfRows
   }

   // FxOption
   derivatives::FxOption[otcFxOption] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcFxOptionRows
   }

   // EquitySwap
   derivatives::EquitySwap[otcEquitySwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcEquitySwapRows
   }

   // VarianceSwap
   derivatives::VarianceSwap[otcVarianceSwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcVarianceSwapRows
   }

   // CommoditySwap
   derivatives::CommoditySwap[otcCommoditySwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcCommoditySwapRows
   }

   derivatives::ConstantMaturitySwap[otcConstantMaturitySwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcConstantMaturitySwapRows
   }

   derivatives::InflationSwap[otcInflationSwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcInflationSwapRows
   }

   derivatives::CrossCurrencySwap[otcCrossCurrencySwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcCrossCurrencySwapRows
   }

   derivatives::AmortisingSwap[otcAmortisingSwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcAmortisingSwapRows
   }

   derivatives::AccretingSwap[otcAccretingSwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcAccretingSwapRows
   }

   derivatives::RollercoasterSwap[otcRollercoasterSwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcRollercoasterSwapRows
   }

   derivatives::ZeroCouponSwap[otcZeroCouponSwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcZeroCouponSwapRows
   }

   derivatives::ArrearsSwap[otcArrearsSwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcArrearsSwapRows
   }

   derivatives::CallableSwap[otcCallableSwap] extends [otcBase]: Relational
   {
      ~filter [store::DB]OtcCallableSwapRows
   }

   derivatives::RangeAccrual[otcRangeAccrual] extends [otcBase]: Relational
