   derivatives::SwapLeg: Relational
   {
      ~primaryKey ( [store::DB]OTC_SWAP_LEG.LEG_ID )
      ~mainTable [store::DB]OTC_SWAP_LEG
      legId: [store::DB]OTC_SWAP_LEG.LEG_ID,
      otcId: [store::DB]OTC_SWAP_LEG.OTC_ID,
      legNumber: [store::DB]OTC_SWAP_LEG.LEG_NUMBER,
      legType: [store::DB]OTC_SWAP_LEG.LEG_TYPE,
      payReceive: [store::DB]OTC_SWAP_LEG.PAY_RECEIVE,
      fixedRate: [store::DB]OTC_SWAP_LEG.FIXED_RATE,
      floatingIndex: [store::DB]OTC_SWAP_LEG.FLOATING_INDEX,
      spreadBp: [store::DB]OTC_SWAP_LEG.SPREAD_BP,
      resetFrequency: [store::DB]OTC_SWAP_LEG.RESET_FREQUENCY,
      paymentFrequency: [store::DB]OTC_SWAP_LEG.PAYMENT_FREQUENCY,
      dayCount: [store::DB]OTC_SWAP_LEG.DAY_COUNT,
      legNotional: [store::DB]OTC_SWAP_LEG.LEG_NOTIONAL,
      legCurrency: [store::DB]OTC_SWAP_LEG.LEG_CURRENCY
   }

   derivatives::OptionTerms: Relational
   {
      ~primaryKey ( [store::DB]OTC_OPTION_TERMS.OTC_ID )
      ~mainTable [store::DB]OTC_OPTION_TERMS
      otcId: [store::DB]OTC_OPTION_TERMS.OTC_ID,
      optionStyle: [store::DB]OTC_OPTION_TERMS.OPTION_STYLE,
      callPut: [store::DB]OTC_OPTION_TERMS.CALL_PUT,
      strike: [store::DB]OTC_OPTION_TERMS.STRIKE,
      premium: [store::DB]OTC_OPTION_TERMS.PREMIUM,
      premiumCurrency: [store::DB]OTC_OPTION_TERMS.PREMIUM_CURRENCY,
      expiryDate: [store::DB]OTC_OPTION_TERMS.EXPIRY_DATE,
      underlyingTenor: [store::DB]OTC_OPTION_TERMS.UNDERLYING_TENOR,
      barrierLevel: [store::DB]OTC_OPTION_TERMS.BARRIER_LEVEL,
      barrierType: [store::DB]OTC_OPTION_TERMS.BARRIER_TYPE
   }

   // The ends NAME their source and target set ids. They have to: OtcTrade is mapped with
   // an explicit set id, because a class with subtype sets needs one, and an unqualified end
   // pointing at such a class compiles cleanly and then fails at plan generation with
   //
   //     meta::pure::router::store::routing::Void not supported!
   //
   // which names no association, no class and no set. The default set id of an unnamed class
   // mapping is its package path with :: replaced by _, hence derivatives_SwapLeg.
   derivatives::TradeLegs: Relational
   {
      AssociationMapping
      (
         legs[otcBase, derivatives_SwapLeg]: [store::DB]@OtcTrade_Leg,
         trade[derivatives_SwapLeg, otcBase]: [store::DB]@OtcTrade_Leg
      )
   }

   derivatives::TradeOptionTerms: Relational
   {
      AssociationMapping
      (
         optionTerms[otcBase, derivatives_OptionTerms]: [store::DB]@OtcTrade_OptionTerms,
         optionTrade[derivatives_OptionTerms, otcBase]: [store::DB]@OtcTrade_OptionTerms
      )
   }
)
