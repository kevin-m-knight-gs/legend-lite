      ~filter [store::DB]ImpBackstop30dpdRows
   }

   impairment::NinetyDayBackstop[impBackstop90dpd] extends [impairmentBase]: Relational
   {
      ~filter [store::DB]ImpBackstop90dpdRows
   }

   impairment::ForborneExposure[impForbearance] extends [impairmentBase]: Relational
