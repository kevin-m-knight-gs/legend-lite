   }

   marks::AskPriceMark[mktAskPrice] extends [marksBase]: Relational
   {
      ~filter [store::DB]MktAskPriceRows
   }

   marks::YieldCurvePoint[mktYieldCurvePoint] extends [marksBase]: Relational
   {
      ~filter [store::DB]MktYieldCurvePointRows
   }

   marks::CreditCurvePoint[mktCreditCurvePoint] extends [marksBase]: Relational
