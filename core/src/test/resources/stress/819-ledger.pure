   {
      ~filter [store::DB]LedDividendEntryRows
   }

   ledger::DividendPayableEntry[ledDividendPayable] extends [ledgerBase]: Relational
   {
      ~filter [store::DB]LedDividendPayableRows
   }

   ledger::CouponEntry[ledCouponEntry] extends [ledgerBase]: Relational
