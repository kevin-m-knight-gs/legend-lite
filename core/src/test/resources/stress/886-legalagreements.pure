###Pure
// The documents that decide what happens when something goes wrong.
//
// 16 types over one table. A reference-data taxonomy is where discriminated
// subtypes earn their keep: the types differ in what they MEAN rather than in what columns
// they carry, so one table with a discriminator is the honest shape and 16 tables
// would be ceremony.
//
// Not every type carries rows. The rest are types the firm can process and does not have
// today, which is the normal state of reference data and the sharpest test of a ~filter --
// an empty result is only correct if the filter works, and the failure mode is returning the
// whole table.
Class legalagreements::LegalAgreement
{
   // The book this record belongs to. Declared on the BASE class and mapped
   // on the BASE set, so every subtype inherits both and can navigate it.
   book: positions::Book[0..1];
   recordId: String[1];
   recordType: String[1];
   bookId: String[1];
   notional: Float[1];
   currency: String[1];
   tradeDate: StrictDate[1];
   maturityDate: StrictDate[0..1];
   status: String[1];
   isActive: Boolean[1];
   riskScore: Float[1];

   // Notional per unit of risk score -- the crude size-versus-danger number a
   // supervisor asks for first. Division, so the engine is in double from here.
   notionalPerRiskPoint() { $this.notional / $this.riskScore } : Float[1];
   // A qualified property: the notional converted at a rate the caller supplies.
   notionalIn(fxRate: Float[1]) { $this.notional * $fxRate } : Float[1];
}

// The netting agreement, and the reason exposure is net.
Class legalagreements::IsdaMasterAgreement2002 extends legalagreements::LegalAgreement
{
}

// Still in force in places, with different close-out mechanics.
Class legalagreements::IsdaMasterAgreement1992 extends legalagreements::LegalAgreement
{
}

// Title transfer, so the collateral is the taker's.
Class legalagreements::EnglishLawCreditSupportAnnex extends legalagreements::LegalAgreement
{
}

// A security interest instead, which behaves differently in default.
Class legalagreements::NewYorkLawCreditSupportAnnex extends legalagreements::LegalAgreement
{
}

// The 2016 regime for daily margin.
Class legalagreements::VariationMarginCsa extends legalagreements::LegalAgreement
{
}

// Segregated with a third party, and not rehypothecable.
Class legalagreements::InitialMarginCreditSupportDeed extends legalagreements::LegalAgreement
{
}

// For repo, with its own close-out netting.
Class legalagreements::GlobalMasterRepurchaseAgreement extends legalagreements::LegalAgreement
{
}

// For securities lending.
Class legalagreements::GlobalMasterSecuritiesLendingAgreement extends legalagreements::LegalAgreement
{
}

// Where rehypothecation limits are set.
Class legalagreements::PrimeBrokerageAgreement extends legalagreements::LegalAgreement
{
}

// The client clearing terms, and the porting arrangements.
Class legalagreements::ClearedDerivativesAddendum extends legalagreements::LegalAgreement
{
}

// Three-way, between client, executing broker and clearer.
Class legalagreements::GiveUpAgreement extends legalagreements::LegalAgreement
{
}

// Which decides who may be told what.
Class legalagreements::ConfidentialityAgreement extends legalagreements::LegalAgreement
{
}

// The legal opinion that makes netting count for capital.
Class legalagreements::NettingOpinion extends legalagreements::LegalAgreement
{
}

// One with a clean opinion in the relevant jurisdiction.
Class legalagreements::QualifyingMasterAgreement extends legalagreements::LegalAgreement
{
}

// How the number is calculated when it all ends.
Class legalagreements::CloseOutAmountDetermination extends legalagreements::LegalAgreement
{
}

// The mechanism used long before litigation.
Class legalagreements::DisputeResolutionProvision extends legalagreements::LegalAgreement
{
}

