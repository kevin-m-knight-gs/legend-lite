(
   *legalagreements::LegalAgreement[legalagreementsBase]: Relational
   {
      ~primaryKey ( [store::DB]LEGAL_AGREEMENT.RECORD_ID )
      ~mainTable [store::DB]LEGAL_AGREEMENT
      recordId: [store::DB]LEGAL_AGREEMENT.RECORD_ID,
      recordType: [store::DB]LEGAL_AGREEMENT.RECORD_TYPE,
      bookId: [store::DB]LEGAL_AGREEMENT.BOOK_ID,
      notional: [store::DB]LEGAL_AGREEMENT.NOTIONAL,
