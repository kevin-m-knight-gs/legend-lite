      isActive: [store::DB]LEGAL_AGREEMENT.IS_ACTIVE,
      riskScore: [store::DB]LEGAL_AGREEMENT.RISK_SCORE,
      book[positions_Book]: [store::DB]@LegalagreementsBaseBook
