###Pure
// Third parties: what has been outsourced, and what cannot be.
//
// 16 types over one table. A reference-data taxonomy is where discriminated
// subtypes earn their keep: the types differ in what they MEAN rather than in what columns
// they carry, so one table with a discriminator is the honest shape and 16 tables
// would be ceremony.
//
// Not every type carries rows. The rest are types the firm can process and does not have
// today, which is the normal state of reference data and the sharpest test of a ~filter --
// an empty result is only correct if the filter works, and the failure mode is returning the
// whole table.
Class outsourcing::OutsourcingArrangement
{
   // The book this record belongs to. Declared on the BASE class and mapped
   // on the BASE set, so every subtype inherits both and can navigate it.
   book: positions::Book[0..1];
   recordId: String[1];
   recordType: String[1];
   bookId: String[1];
   notional: Float[1];
   currency: String[1];
   tradeDate: StrictDate[1];
   maturityDate: StrictDate[0..1];
   status: String[1];
   isActive: Boolean[1];
   riskScore: Float[1];

   // Notional per unit of risk score -- the crude size-versus-danger number a
   // supervisor asks for first. Division, so the engine is in double from here.
   notionalPerRiskPoint() { $this.notional / $this.riskScore } : Float[1];
   // A qualified property: the notional converted at a rate the caller supplies.
   notionalIn(fxRate: Float[1]) { $this.notional * $fxRate } : Float[1];
}

// Failure would materially impair the firm, so the register is regulated.
Class outsourcing::CriticalOutsourcing extends outsourcing::OutsourcingArrangement
{
}

// Recorded, and reviewed less often.
Class outsourcing::NonCriticalOutsourcing extends outsourcing::OutsourcingArrangement
{
}

// Where concentration risk is a supervisory topic.
Class outsourcing::CloudInfrastructureService extends outsourcing::OutsourcingArrangement
{
}

// The same, with less control over the stack.
Class outsourcing::CloudSoftwareService extends outsourcing::OutsourcingArrangement
{
}

// Still outsourcing, and still on the register.
Class outsourcing::IntragroupOutsourcing extends outsourcing::OutsourcingArrangement
{
}

// The provider's provider, and the visibility problem again.
Class outsourcing::SubOutsourcingChain extends outsourcing::OutsourcingArrangement
{
}

// Where the data actually is.
Class outsourcing::OffshoreServiceLocation extends outsourcing::OutsourcingArrangement
{
}

// Required to be credible, which is a high bar.
Class outsourcing::OutsourcingExitPlan extends outsourcing::OutsourcingArrangement
{
}

// Including the regulator's right of access.
Class outsourcing::ContractualAuditRight extends outsourcing::OutsourcingArrangement
{
}

// With credits that never cover the actual loss.
Class outsourcing::ServiceLevelAgreement extends outsourcing::OutsourcingArrangement
{
}

// At the firm level and across the market.
Class outsourcing::ConcentrationRiskAssessment extends outsourcing::OutsourcingArrangement
{
}

// Before signing, and documented.
Class outsourcing::PreContractDueDiligence extends outsourcing::OutsourcingArrangement
{
}

// After signing, which is where it usually lapses.
Class outsourcing::OngoingProviderMonitoring extends outsourcing::OutsourcingArrangement
{
}

// Contractual, and with a clock.
Class outsourcing::ProviderIncidentNotification extends outsourcing::OutsourcingArrangement
{
}

// The record supervisors ask for first.
Class outsourcing::OutsourcingRegisterEntry extends outsourcing::OutsourcingArrangement
{
}

// What lets the firm leave, and how quickly.
Class outsourcing::TerminationTrigger extends outsourcing::OutsourcingArrangement
{
}

