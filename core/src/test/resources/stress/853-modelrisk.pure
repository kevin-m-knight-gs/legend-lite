   {
      ~filter [store::DB]MdlCreditScorecardRows
   }

   modelrisk::ExpectedCreditLossModel[mdlEclModel] extends [modelriskBase]: Relational
   {
      ~filter [store::DB]MdlEclModelRows
   }

   modelrisk::AmlDetectionModel[mdlAmlDetection] extends [modelriskBase]: Relational
   {
      ~filter [store::DB]MdlAmlDetectionRows
   }

   modelrisk::FraudDetectionModel[mdlFraudModel] extends [modelriskBase]: Relational
   {
      ~filter [store::DB]MdlFraudModelRows
   }

   modelrisk::ExecutionAlgorithm[mdlAlgoExecution] extends [modelriskBase]: Relational
