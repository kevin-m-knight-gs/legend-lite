###Service
Service stress::H0_Instrument
{
    pattern: '/stress/h0';
    documentation: 'Executes the hier:: feature mapping for hier::Instrument. Plain columns over the inheritance hierarchy\'s root set. Generated by scripts/corpus/hier.py -- the class list is derived from what the ORACLE can resolve, so a property the reader cannot model (a join chain, a Binding transformer) excludes its class automatically rather than being remembered in a list here.';
    execution: Single
    {
    query: |hier::Instrument.all()
        ->project(~[
            instrumentId:x|$x.instrumentId,
            assetClass:x|$x.assetClass,
            name:x|$x.name
        ])
        ->sort(~instrumentId->ascending());
        mapping: hier::HierMapping;
        runtime: hier::HierRT;
    }
  testSuites:
  [
    H0_Instrument_suite:
    {
      data:
      [
        connections:
        [
          hierEnv:
            Reference
            #{
              hier::InstrumentData
            }#
        ]
      ]
      tests:
      [
        // 3 columns over the hier:: feature mapping.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instrumentId":"HI-0001","assetClass":"ASSET-CLASS-001","name":"Northbridge"},{"instrumentId":"HI-0002","assetClass":"ASSET-CLASS-002","name":"Kestrel"},{"instrumentId":"HI-0003","assetClass":null,"name":"Aldgate"},{"instrumentId":"HI-0004","assetClass":"ASSET-CLASS-004","name":"Fenwick"},{"instrumentId":"HI-0005","assetClass":"ASSET-CLASS-005","name":"Thameside"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::H1_IssuerLabel
{
    pattern: '/stress/h1';
    documentation: 'Executes the hier:: feature mapping for hier::IssuerLabel. 3 of the projected columns are DYNAFUNCTIONS (concat, toLower, toUpper); the oracle evaluates each independently of the engine. Generated by scripts/corpus/hier.py -- the class list is derived from what the ORACLE can resolve, so a property the reader cannot model (a join chain, a Binding transformer) excludes its class automatically rather than being remembered in a list here.';
    execution: Single
    {
    query: |hier::IssuerLabel.all()
        ->project(~[
            issuerId:x|$x.issuerId,
            fullLabel:x|$x.fullLabel,
            lowerName:x|$x.lowerName,
            upperName:x|$x.upperName
        ])
        ->sort(~issuerId->ascending());
        mapping: hier::IssuerMapping;
        runtime: hier::IssuerRT;
    }
  testSuites:
  [
    H1_IssuerLabel_suite:
    {
      data:
      [
        connections:
        [
          issuerEnv:
            Reference
            #{
              hier::IssuerData
            }#
        ]
      ]
      tests:
      [
        // 4 columns over the hier:: feature mapping.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"issuerId":"HI-0001","fullLabel":"NorthbridgeCONTACT-EMAIL-001","lowerName":"northbridge","upperName":"NORTHBRIDGE"},{"issuerId":"HI-0002","fullLabel":"KestrelCONTACT-EMAIL-002","lowerName":"kestrel","upperName":"KESTREL"},{"issuerId":"HI-0003","fullLabel":"Aldgate","lowerName":"aldgate","upperName":"ALDGATE"},{"issuerId":"HI-0004","fullLabel":"FenwickCONTACT-EMAIL-004","lowerName":"fenwick","upperName":"FENWICK"},{"issuerId":"HI-0005","fullLabel":"ThamesideCONTACT-EMAIL-005","lowerName":"thameside","upperName":"THAMESIDE"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
