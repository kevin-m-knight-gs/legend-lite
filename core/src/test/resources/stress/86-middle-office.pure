   middleoffice::CollateralBreak[brkCollateralBreak] extends [breakBase]: Relational
   {
      ~filter [store::DB]BrkCollateralBreakRows
   }

   middleoffice::TradeLifecycle: Relational
   {
      AssociationMapping
      (
         lifecycleEvents[otcBase, lifecycleBase]: [store::DB]@OtcTrade_LifecycleEvent,
         eventTrade[lifecycleBase, otcBase]: [store::DB]@OtcTrade_LifecycleEvent
      )
   }

   middleoffice::TradeConfirmation: Relational
   {
      AssociationMapping
      (
         confirmations[otcBase, middleoffice_Confirmation]: [store::DB]@OtcTrade_ConfirmationMo,
         confirmedTrade[middleoffice_Confirmation, otcBase]: [store::DB]@OtcTrade_ConfirmationMo
      )
   }

   middleoffice::TradeBreaks: Relational
   {
      AssociationMapping
      (
         breaks[otcBase, breakBase]: [store::DB]@OtcTrade_Break,
