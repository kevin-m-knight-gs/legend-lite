      otcId: [store::DB]CONFIRMATION_MO.OTC_ID,
      method: [store::DB]CONFIRMATION_MO.METHOD,
      platform: [store::DB]CONFIRMATION_MO.PLATFORM,
      sentAt: [store::DB]CONFIRMATION_MO.SENT_AT,
      matchedAt: [store::DB]CONFIRMATION_MO.MATCHED_AT,
      status: [store::DB]CONFIRMATION_MO.STATUS,
