      detectedDate: [store::DB]TRADE_BREAK.DETECTED_DATE,
      severity: [store::DB]TRADE_BREAK.SEVERITY,
      status: [store::DB]TRADE_BREAK.STATUS,
      assignedTo: [store::DB]TRADE_BREAK.ASSIGNED_TO,
      resolvedDate: [store::DB]TRADE_BREAK.RESOLVED_DATE,
      ageDays: [store::DB]TRADE_BREAK.AGE_DAYS,
      fieldName: [store::DB]TRADE_BREAK.FIELD_NAME,
      ourValue: [store::DB]TRADE_BREAK.OUR_VALUE,
      theirValue: [store::DB]TRADE_BREAK.THEIR_VALUE
   }

   middleoffice::EconomicBreak[brkEconomicBreak] extends [breakBase]: Relational
   {
      ~filter [store::DB]BrkEconomicBreakRows
