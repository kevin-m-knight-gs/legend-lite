    // The empty leg. It maps exactly like the others and contributes no rows.
    trading::HistTrade[fx]: Relational {
        ~primaryKey ([store::DB] TRADE_FX.TRADE_ID)
        ~mainTable [store::DB] TRADE_FX
        tradeId: [store::DB] TRADE_FX.TRADE_ID,
        tradeDate: [store::DB] TRADE_FX.TRADE_DATE,
        quantity: [store::DB] TRADE_FX.QUANTITY,
        price: [store::DB] TRADE_FX.PRICE,
