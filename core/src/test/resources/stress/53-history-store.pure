    }

    trading::HistTrade[rates]: Relational {
        ~primaryKey ([store::DB] TRADE_RATES.TRADE_ID)
        ~mainTable [store::DB] TRADE_RATES
        tradeId: [store::DB] TRADE_RATES.TRADE_ID,
        tradeDate: [store::DB] TRADE_RATES.TRADE_DATE,
        quantity: [store::DB] TRADE_RATES.QUANTITY,
        price: [store::DB] TRADE_RATES.PRICE,
