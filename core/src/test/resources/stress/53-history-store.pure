        side: EnumerationMapping SideMapping: [store::DB] TRADE_FX.SIDE,
        status: [store::DB] TRADE_FX.STATUS,
        currency: [store::DB] TRADE_FX.CURRENCY
    }

    // The `*` marks the ROOT set implementation for the class — the one a query on
    // trading::HistTrade dispatches to. Without it the three partitions are three
    // unrelated mappings and dispatch is ambiguous.
    *trading::HistTrade: Operation
    {
