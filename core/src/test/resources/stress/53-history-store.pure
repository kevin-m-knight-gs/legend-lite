        ~mainTable [store::DB] TRADE_EQ
        tradeId: [store::DB] TRADE_EQ.TRADE_ID,
        tradeDate: [store::DB] TRADE_EQ.TRADE_DATE,
        quantity: [store::DB] TRADE_EQ.QUANTITY,
