###Pure
// The client lifecycle, which is longer and more expensive than anyone expects.
//
// 16 types over one table. A reference-data taxonomy is where discriminated
// subtypes earn their keep: the types differ in what they MEAN rather than in what columns
// they carry, so one table with a discriminator is the honest shape and 16 tables
// would be ceremony.
//
// Not every type carries rows. The rest are types the firm can process and does not have
// today, which is the normal state of reference data and the sharpest test of a ~filter --
// an empty result is only correct if the filter works, and the failure mode is returning the
// whole table.
Class clientlifecycle::ClientLifecycleStage
{
   // The book this record belongs to. Declared on the BASE class and mapped
   // on the BASE set, so every subtype inherits both and can navigate it.
   book: positions::Book[0..1];
   recordId: String[1];
   recordType: String[1];
   bookId: String[1];
   notional: Float[1];
   currency: String[1];
   tradeDate: StrictDate[1];
   maturityDate: StrictDate[0..1];
   status: String[1];
   isActive: Boolean[1];
   riskScore: Float[1];

   // Notional per unit of risk score -- the crude size-versus-danger number a
   // supervisor asks for first. Division, so the engine is in double from here.
   notionalPerRiskPoint() { $this.notional / $this.riskScore } : Float[1];
   // A qualified property: the notional converted at a rate the caller supplies.
   notionalIn(fxRate: Float[1]) { $this.notional * $fxRate } : Float[1];
}

// Before anything is signed, and before most of the cost.
Class clientlifecycle::ProspectStage extends clientlifecycle::ClientLifecycleStage
{
}

// Sanctions and adverse media, before effort is spent.
Class clientlifecycle::InitialScreeningStage extends clientlifecycle::ClientLifecycleStage
{
}

// Documents, and the reason onboarding takes months.
Class clientlifecycle::KycCollectionStage extends clientlifecycle::ClientLifecycleStage
{
}

// Through the structure to the people, which is the hard part.
Class clientlifecycle::BeneficialOwnershipStage extends clientlifecycle::ClientLifecycleStage
{
}

// Which decides how much of the rest is required.
Class clientlifecycle::ClientRiskRatingStage extends clientlifecycle::ClientLifecycleStage
{
}

// Limits set before the first trade.
Class clientlifecycle::CreditApprovalStage extends clientlifecycle::ClientLifecycleStage
{
}

// The ISDA and the CSA, and months more.
Class clientlifecycle::DocumentationNegotiationStage extends clientlifecycle::ClientLifecycleStage
{
}

// Static data, SSIs, and the entitlements.
Class clientlifecycle::AccountOpeningStage extends clientlifecycle::ClientLifecycleStage
{
}

// Where everything above is tested at once.
Class clientlifecycle::FirstTradeStage extends clientlifecycle::ClientLifecycleStage
{
}

// Risk-rated frequency, and a queue that never empties.
Class clientlifecycle::PeriodicReviewStage extends clientlifecycle::ClientLifecycleStage
{
}

// Something changed, so the file is reopened.
Class clientlifecycle::TriggerEventReviewStage extends clientlifecycle::ClientLifecycleStage
{
}

// No activity, and still costing to maintain.
Class clientlifecycle::DormantClientStage extends clientlifecycle::ClientLifecycleStage
{
}

// Which often needs the whole file refreshed.
Class clientlifecycle::ReactivationStage extends clientlifecycle::ClientLifecycleStage
{
}

// Notice given, positions to unwind.
Class clientlifecycle::OffboardingNoticeStage extends clientlifecycle::ClientLifecycleStage
{
}

// The part that determines when the relationship really ends.
Class clientlifecycle::PositionUnwindStage extends clientlifecycle::ClientLifecycleStage
{
}

// Years after the last trade, and legally required.
Class clientlifecycle::RecordRetentionStage extends clientlifecycle::ClientLifecycleStage
{
}

