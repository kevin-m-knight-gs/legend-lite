      ~filter [store::DB]SecLiquidityFacilityRows
   }

   securitisation::ServicerAdvanceItem[secServicerAdvance] extends [securitisationBase]: Relational
   {
      ~filter [store::DB]SecServicerAdvanceRows
   }
)
