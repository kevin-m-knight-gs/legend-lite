   {
      ~primaryKey ( [combo::ComboDB]COMBO_ROOT.ROOT_ID )
      ~mainTable [combo::ComboDB]COMBO_ROOT
      scope([combo::ComboDB]COMBO_ROOT)
      (
         rootId: ROOT_ID,
         r_s_nn1: R_S_NN1,
         r_s_nl1: R_S_NL1,
         r_i_nn1: R_I_NN1,
         r_i_nl1: R_I_NL1,
         r_f_nn1: R_F_NN1,
         r_f_nl1: R_F_NL1,
         r_b_nn1: R_B_NN1,
         r_b_nl1: R_B_NL1
