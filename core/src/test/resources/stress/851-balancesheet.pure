      ~filter [store::DB]BsiIntangibleSoftwareRows
   }

   balancesheet::DeferredTaxAsset[bsiDeferredTaxAsset] extends [balancesheetBase]: Relational
   {
      ~filter [store::DB]BsiDeferredTaxAssetRows
   }

   balancesheet::RightOfUseAsset[bsiRightOfUse] extends [balancesheetBase]: Relational
   {
      ~filter [store::DB]BsiRightOfUseRows
   }

   balancesheet::CustomerDepositLiability[bsiCustomerDepositLiab] extends [balancesheetBase]: Relational
