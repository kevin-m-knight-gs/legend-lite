Mapping eqexotics::EqexoticsMapping
(
   *eqexotics::EquityExoticPayoff[eqexoticsBase]: Relational
   {
      ~primaryKey ( [store::DB]EQ_EXOTIC_PAYOFF.RECORD_ID )
      ~mainTable [store::DB]EQ_EXOTIC_PAYOFF
      recordId: [store::DB]EQ_EXOTIC_PAYOFF.RECORD_ID,
      recordType: [store::DB]EQ_EXOTIC_PAYOFF.RECORD_TYPE,
      bookId: [store::DB]EQ_EXOTIC_PAYOFF.BOOK_ID,
      notional: [store::DB]EQ_EXOTIC_PAYOFF.NOTIONAL,
      currency: [store::DB]EQ_EXOTIC_PAYOFF.CURRENCY,
      tradeDate: [store::DB]EQ_EXOTIC_PAYOFF.TRADE_DATE,
      maturityDate: [store::DB]EQ_EXOTIC_PAYOFF.MATURITY_DATE,
