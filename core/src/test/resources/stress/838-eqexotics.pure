###Pure
// Exotic equity payoffs: what the note actually pays, and on what.
//
// 16 types over one table. A reference-data taxonomy is where discriminated
// subtypes earn their keep: the types differ in what they MEAN rather than in what columns
// they carry, so one table with a discriminator is the honest shape and 16 tables
// would be ceremony.
//
// Not every type carries rows. The rest are types the firm can process and does not have
// today, which is the normal state of reference data and the sharpest test of a ~filter --
// an empty result is only correct if the filter works, and the failure mode is returning the
// whole table.
Class eqexotics::EquityExoticPayoff
{
   recordId: String[1];
   recordType: String[1];
   bookId: String[1];
   notional: Float[1];
   currency: String[1];
   tradeDate: StrictDate[1];
   maturityDate: StrictDate[0..1];
   status: String[1];
   isActive: Boolean[1];
   riskScore: Float[1];

   // Notional per unit of risk score -- the crude size-versus-danger number a
   // supervisor asks for first. Division, so the engine is in double from here.
   notionalPerRiskPoint() { $this.notional / $this.riskScore } : Float[1];
   // A qualified property: the notional converted at a rate the caller supplies.
   notionalIn(fxRate: Float[1]) { $this.notional * $fxRate } : Float[1];
}

// Redeems early if the underlying is above a barrier on an observation date.
Class eqexotics::AutocallableNote extends eqexotics::EquityExoticPayoff
{
}

// Pays on the weakest name in the basket, which is why it is cheap.
Class eqexotics::WorstOfBasketOption extends eqexotics::EquityExoticPayoff
{
}

// Pays on the strongest name, and costs accordingly.
Class eqexotics::BestOfBasketOption extends eqexotics::EquityExoticPayoff
{
}

// Ranked payoff across several underlyings at once.
Class eqexotics::RainbowOption extends eqexotics::EquityExoticPayoff
{
}

// A series of forward-starting options, each struck at the last reset.
Class eqexotics::CliquetOption extends eqexotics::EquityExoticPayoff
{
}

// Locks in the best performer at each observation and removes it from the basket.
Class eqexotics::HimalayaOption extends eqexotics::EquityExoticPayoff
{
}

// Pays against the best price reached over the life.
Class eqexotics::FixedStrikeLookback extends eqexotics::EquityExoticPayoff
{
}

// Struck at the best price reached, so it always finishes in the money.
Class eqexotics::FloatingStrikeLookback extends eqexotics::EquityExoticPayoff
{
}

// Averages the underlying, which kills the gamma and the price with it.
Class eqexotics::ArithmeticAsianOption extends eqexotics::EquityExoticPayoff
{
}

// Dies if the underlying trades above the barrier.
Class eqexotics::UpAndOutBarrier extends eqexotics::EquityExoticPayoff
{
}

// Does not exist until the underlying trades below the barrier.
Class eqexotics::DownAndInBarrier extends eqexotics::EquityExoticPayoff
{
}

// Pays a fixed amount or nothing, with a discontinuity at the strike.
Class eqexotics::CashOrNothingDigital extends eqexotics::EquityExoticPayoff
{
}

// Pays realised variance against a strike, with no directional exposure at all.
Class eqexotics::VarianceSwap extends eqexotics::EquityExoticPayoff
{
}

// Variance, but only accrued while the underlying is inside a range.
Class eqexotics::CorridorVarianceSwap extends eqexotics::EquityExoticPayoff
{
}

// Index variance against the sum of its constituents' variance.
Class eqexotics::DispersionTrade extends eqexotics::EquityExoticPayoff
{
}

// Rebalances between risky and riskless to protect a floor.
Class eqexotics::CppiStructure extends eqexotics::EquityExoticPayoff
{
}

