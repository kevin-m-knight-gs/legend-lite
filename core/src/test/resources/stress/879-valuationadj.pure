   {
      ~filter [store::DB]XvaMvaRows
   }

   valuationadj::CapitalValuationAdjustment[xvaKva] extends [valuationadjBase]: Relational
   {
      ~filter [store::DB]XvaKvaRows
   }

   valuationadj::CollateralValuationAdjustment[xvaColva] extends [valuationadjBase]: Relational
