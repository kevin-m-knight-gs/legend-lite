   {
      ~primaryKey ( [store::DB]PROCESSING_EXCEPTION.EXCEPTION_ID )
      ~mainTable [store::DB]PROCESSING_EXCEPTION
      exceptionId: [store::DB]PROCESSING_EXCEPTION.EXCEPTION_ID,
      exceptionType: [store::DB]PROCESSING_EXCEPTION.EXCEPTION_TYPE,
      sourceSystem: [store::DB]PROCESSING_EXCEPTION.SOURCE_SYSTEM,
      severity: [store::DB]PROCESSING_EXCEPTION.SEVERITY,
