        // 8 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001","col_none_notnull_embedded":"Northbridge","col_none_notnull_top":"Northbridge","chain1_none_notnull_top":null,"chain2_none_notnull_top":null,"col_nest_notnull_top":"NORTHBRIDGER-ALT-001","chain1_nest_nullable_top":"","chain2_up_notnull_embedded":null,"chain2_cat_nullable_top":""},{"rootId":"CR-0002","col_none_notnull_embedded":"Kestrel","col_none_notnull_top":"Kestrel","chain1_none_notnull_top":null,"chain2_none_notnull_top":null,"col_nest_notnull_top":"KESTRELR-ALT-002","chain1_nest_nullable_top":"","chain2_up_notnull_embedded":null,"chain2_cat_nullable_top":""},{"rootId":"CR-0003","col_none_notnull_embedded":"Aldgate","col_none_notnull_top":"Aldgate","chain1_none_notnull_top":"Northbridge","chain2_none_notnull_top":null,"col_nest_notnull_top":"ALDGATER-ALT-003","chain1_nest_nullable_top":"H1-NOTE-001H1-MEMO-001","chain2_up_notnull_embedded":null,"chain2_cat_nullable_top":""},{"rootId":"CR-0004","col_none_notnull_embedded":"Fenwick","col_none_notnull_top":"Fenwick","chain1_none_notnull_top":"Kestrel","chain2_none_notnull_top":null,"col_nest_notnull_top":"FENWICKR-ALT-004","chain1_nest_nullable_top":"H1-NOTE-002H1-MEMO-002","chain2_up_notnull_embedded":null,"chain2_cat_nullable_top":""},{"rootId":"CR-0005","col_none_notnull_embedded":"Thameside","col_none_notnull_top":"Thameside","chain1_none_notnull_top":"Aldgate","chain2_none_notnull_top":"Northbridge","col_nest_notnull_top":"THAMESIDER-ALT-005","chain1_nest_nullable_top":"H1-MEMO-003","chain2_up_notnull_embedded":"NORTHBRIDGE","chain2_cat_nullable_top":"H2-NOTE-001H2-MEMO-001"}]';
