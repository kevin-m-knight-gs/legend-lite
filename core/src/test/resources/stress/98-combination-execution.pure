    {
    query: |combo::C15.all()
        ->project(~[
            rootId:x|$x.rootId,
            col_float_times_nullable_embedded:x|$x.nested.col_float_times_nullable_embedded,
            chain1_char_none_notnull_embedded:x|$x.nested.chain1_char_none_notnull_embedded,
            chain1_int_none_nullable_embedded:x|$x.nested.chain1_int_none_nullable_embedded,
