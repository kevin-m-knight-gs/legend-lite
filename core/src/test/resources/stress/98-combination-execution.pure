Service stress::CB_SchemaQualified
{
    pattern: '/stress/cb_schema';
    documentation: 'Reads combo::Summary, whose every reference is schema-qualified. The corpus declared a Schema and mapped over none, so a schema-qualified reference had never been resolved by a mapping and a schema-qualified ###Data key had never seeded anything. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::Summary.all()
        ->project(~[
            sm_b_nl1:x|$x.sm_b_nl1,
            sm_b_nn1:x|$x.sm_b_nn1,
            sm_bi_nl1:x|$x.sm_bi_nl1,
            sm_bi_nn1:x|$x.sm_bi_nn1,
            sm_c_nl1:x|$x.sm_c_nl1,
            sm_c_nn1:x|$x.sm_c_nn1,
            sm_de_nl1:x|$x.sm_de_nl1,
            sm_de_nn1:x|$x.sm_de_nn1,
            sm_dt_nl1:x|$x.sm_dt_nl1,
            sm_dt_nn1:x|$x.sm_dt_nn1,
            sm_f_nl1:x|$x.sm_f_nl1,
            sm_f_nn1:x|$x.sm_f_nn1,
            sm_i_nl1:x|$x.sm_i_nl1,
            sm_i_nn1:x|$x.sm_i_nn1,
            sm_s_nl1:x|$x.sm_s_nl1,
            sm_s_nn1:x|$x.sm_s_nn1,
            sm_si_nl1:x|$x.sm_si_nl1,
            sm_si_nn1:x|$x.sm_si_nn1,
            sm_ts_nl1:x|$x.sm_ts_nl1,
            sm_ts_nn1:x|$x.sm_ts_nn1,
            summaryId:x|$x.summaryId
        ])
        ->sort(~summaryId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_SchemaQualified_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 20 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
