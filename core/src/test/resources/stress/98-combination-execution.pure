Service stress::CB_NotEqualsNull
{
    pattern: '/stress/cb_notequalsnull';
    documentation: 'Comparison `!=` against a column that is NULL in some rows. F28: the engine KEEPS the row whose operand is NULL. SQL three-valued logic makes the comparison UNKNOWN, and a predicate that is not TRUE excludes. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C0.all()
        ->filter({x|($x.dyna1_string_none_nullable_top != ' none')})
        ->project(~[
            rootId:x|$x.rootId,
            dyna1_string_none_nullable_top:x|$x.dyna1_string_none_nullable_top
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_NotEqualsNull_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 1 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001","dyna1_string_none_nullable_top":"A-S-NL1-001"},{"rootId":"CR-0003","dyna1_string_none_nullable_top":"A-S-NL1-003"},{"rootId":"CR-0004","dyna1_string_none_nullable_top":"A-S-NL1-004"},{"rootId":"CR-0005","dyna1_string_none_nullable_top":"A-S-NL1-005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CB_EqualsNull
{
    pattern: '/stress/cb_equalsnull';
    documentation: 'Comparison `==` against a column that is NULL in some rows. The complement, which AGREES. Both readings exclude a NULL here, which is why no `==` predicate in the corpus ever exposed F28. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C0.all()
        ->filter({x|($x.dyna1_string_none_nullable_top == ' none')})
        ->project(~[
            rootId:x|$x.rootId,
            dyna1_string_none_nullable_top:x|$x.dyna1_string_none_nullable_top
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_EqualsNull_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 1 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CB_GreaterNull
{
    pattern: '/stress/cb_greaternull';
    documentation: 'Comparison `>` against a column that is NULL in some rows. An ORDERED comparison against the same NULL, which also AGREES -- so the engine excludes for `>` and keeps for `!=`, and those cannot both be right. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C0.all()
        ->filter({x|($x.dyna1_string_none_nullable_top > ' ')})
        ->project(~[
            rootId:x|$x.rootId,
            dyna1_string_none_nullable_top:x|$x.dyna1_string_none_nullable_top
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_GreaterNull_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 1 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001","dyna1_string_none_nullable_top":"A-S-NL1-001"},{"rootId":"CR-0003","dyna1_string_none_nullable_top":"A-S-NL1-003"},{"rootId":"CR-0004","dyna1_string_none_nullable_top":"A-S-NL1-004"},{"rootId":"CR-0005","dyna1_string_none_nullable_top":"A-S-NL1-005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CB_SchemaQualified
{
    pattern: '/stress/cb_schema';
    documentation: 'Reads combo::Summary, whose every reference is schema-qualified. The corpus declared a Schema and mapped over none, so a schema-qualified reference had never been resolved by a mapping and a schema-qualified ###Data key had never seeded anything. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::Summary.all()
        ->project(~[
            sm_b_nl1:x|$x.sm_b_nl1,
            sm_b_nn1:x|$x.sm_b_nn1,
            sm_f_nl1:x|$x.sm_f_nl1,
            sm_f_nn1:x|$x.sm_f_nn1,
            sm_i_nl1:x|$x.sm_i_nl1,
            sm_i_nn1:x|$x.sm_i_nn1,
            sm_s_nl1:x|$x.sm_s_nl1,
            sm_s_nn1:x|$x.sm_s_nn1,
            summaryId:x|$x.summaryId
        ])
        ->sort(~summaryId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_SchemaQualified_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 8 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"sm_b_nl1":true,"sm_b_nn1":true,"sm_f_nl1":1187.5,"sm_f_nn1":1187.5,"sm_i_nl1":213,"sm_i_nn1":213,"sm_s_nl1":"SM-S-NL1-001","sm_s_nn1":"SM-S-NN1-001","summaryId":"CS-0001"},{"sm_b_nl1":false,"sm_b_nn1":false,"sm_f_nl1":null,"sm_f_nn1":1225.0,"sm_i_nl1":220,"sm_i_nn1":220,"sm_s_nl1":"SM-S-NL1-002","sm_s_nn1":"SM-S-NN1-002","summaryId":"CS-0002"},{"sm_b_nl1":true,"sm_b_nn1":true,"sm_f_nl1":1262.5,"sm_f_nn1":1262.5,"sm_i_nl1":227,"sm_i_nn1":227,"sm_s_nl1":null,"sm_s_nn1":"SM-S-NN1-003","summaryId":"CS-0003"},{"sm_b_nl1":null,"sm_b_nn1":true,"sm_f_nl1":1300.0,"sm_f_nn1":1300.0,"sm_i_nl1":234,"sm_i_nn1":234,"sm_s_nl1":"SM-S-NL1-004","sm_s_nn1":"SM-S-NN1-004","summaryId":"CS-0004"},{"sm_b_nl1":false,"sm_b_nn1":false,"sm_f_nl1":1337.5,"sm_f_nn1":1337.5,"sm_i_nl1":null,"sm_i_nn1":241,"sm_s_nl1":"SM-S-NL1-005","sm_s_nn1":"SM-S-NN1-005","summaryId":"CS-0005"}]';
                  }#;
