            ineq_int_abs_nullable_top:x|$x.ineq_int_abs_nullable_top,
            ineq_decimal_abs_nullable_top:x|$x.ineq_decimal_abs_nullable_top,
            multicol_char_up_nullable_top:x|$x.multicol_char_up_nullable_top,
            multicol_float_abs_nullable_top:x|$x.multicol_float_abs_nullable_top,
            ormix_string_up_nullable_top:x|$x.ormix_string_up_nullable_top,
            ormix_smallint_abs_nullable_top:x|$x.ormix_smallint_abs_nullable_top,
            ormix_timestamp_none_nullable_top:x|$x.ormix_timestamp_none_nullable_top
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
