Service stress::CB_Scoped
{
    pattern: '/stress/cb_scoped';
    documentation: 'Reads combo::Scoped, whose property mappings sit inside `scope([db]TABLE)` and name their columns BARE. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::Scoped.all()
        ->project(~[
            r_b_nl1:x|$x.r_b_nl1,
            r_b_nn1:x|$x.r_b_nn1,
            r_bi_nl1:x|$x.r_bi_nl1,
            r_bi_nn1:x|$x.r_bi_nn1,
            r_c_nl1:x|$x.r_c_nl1,
            r_c_nn1:x|$x.r_c_nn1,
            r_de_nl1:x|$x.r_de_nl1,
            r_de_nn1:x|$x.r_de_nn1,
            r_dt_nl1:x|$x.r_dt_nl1,
            r_dt_nn1:x|$x.r_dt_nn1,
            r_f_nl1:x|$x.r_f_nl1,
            r_f_nn1:x|$x.r_f_nn1,
            r_i_nl1:x|$x.r_i_nl1,
            r_i_nn1:x|$x.r_i_nn1,
            r_s_nl1:x|$x.r_s_nl1,
            r_s_nn1:x|$x.r_s_nn1,
            r_si_nl1:x|$x.r_si_nl1,
            r_si_nn1:x|$x.r_si_nn1,
            r_ts_nl1:x|$x.r_ts_nl1,
            r_ts_nn1:x|$x.r_ts_nn1,
            rootId:x|$x.rootId
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_Scoped_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 20 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"r_b_nl1":false,"r_b_nn1":false,"r_bi_nl1":52,"r_bi_nn1":52,"r_c_nl1":"R-C-NL1-001","r_c_nn1":"R-C-NN1-001","r_de_nl1":325.0,"r_de_nn1":325.0,"r_dt_nl1":"2024-07-07","r_dt_nn1":"2024-07-07","r_f_nl1":325.0,"r_f_nn1":325.0,"r_i_nl1":52,"r_i_nn1":52,"r_s_nl1":"R-S-NL1-001","r_s_nn1":"R-S-NN1-001","r_si_nl1":null,"r_si_nn1":52,"r_ts_nl1":null,"r_ts_nn1":"2024-07-07T06:15:00.000000000+0000","rootId":"CR-0001"},{"r_b_nl1":null,"r_b_nn1":true,"r_bi_nl1":59,"r_bi_nn1":59,"r_c_nl1":"R-C-NL1-002","r_c_nn1":"R-C-NN1-002","r_de_nl1":362.5,"r_de_nn1":362.5,"r_dt_nl1":"2024-08-08","r_dt_nn1":"2024-08-08","r_f_nl1":362.5,"r_f_nn1":362.5,"r_i_nl1":null,"r_i_nn1":59,"r_s_nl1":"R-S-NL1-002","r_s_nn1":"R-S-NN1-002","r_si_nl1":59,"r_si_nn1":59,"r_ts_nl1":"2024-08-08T07:15:00.000000000+0000","r_ts_nn1":"2024-08-08T07:15:00.000000000+0000","rootId":"CR-0002"},{"r_b_nl1":true,"r_b_nn1":true,"r_bi_nl1":66,"r_bi_nn1":66,"r_c_nl1":"R-C-NL1-003","r_c_nn1":"R-C-NN1-003","r_de_nl1":400.0,"r_de_nn1":400.0,"r_dt_nl1":"2024-09-09","r_dt_nn1":"2024-09-09","r_f_nl1":null,"r_f_nn1":400.0,"r_i_nl1":66,"r_i_nn1":66,"r_s_nl1":null,"r_s_nn1":"R-S-NN1-003","r_si_nl1":66,"r_si_nn1":66,"r_ts_nl1":"2024-09-09T08:15:00.000000000+0000","r_ts_nn1":"2024-09-09T08:15:00.000000000+0000","rootId":"CR-0003"},{"r_b_nl1":false,"r_b_nn1":false,"r_bi_nl1":null,"r_bi_nn1":73,"r_c_nl1":"R-C-NL1-004","r_c_nn1":"R-C-NN1-004","r_de_nl1":437.5,"r_de_nn1":437.5,"r_dt_nl1":null,"r_dt_nn1":"2024-10-10","r_f_nl1":437.5,"r_f_nn1":437.5,"r_i_nl1":73,"r_i_nn1":73,"r_s_nl1":"R-S-NL1-004","r_s_nn1":"R-S-NN1-004","r_si_nl1":73,"r_si_nn1":73,"r_ts_nl1":"2024-10-10T09:15:00.000000000+0000","r_ts_nn1":"2024-10-10T09:15:00.000000000+0000","rootId":"CR-0004"},{"r_b_nl1":true,"r_b_nn1":true,"r_bi_nl1":80,"r_bi_nn1":80,"r_c_nl1":null,"r_c_nn1":"R-C-NN1-005","r_de_nl1":null,"r_de_nn1":475.0,"r_dt_nl1":"2024-11-11","r_dt_nn1":"2024-11-11","r_f_nl1":475.0,"r_f_nn1":475.0,"r_i_nl1":80,"r_i_nn1":80,"r_s_nl1":"R-S-NL1-005","r_s_nn1":"R-S-NN1-005","r_si_nl1":80,"r_si_nn1":80,"r_ts_nl1":"2024-11-11T10:15:00.000000000+0000","r_ts_nn1":"2024-11-11T10:15:00.000000000+0000","rootId":"CR-0005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CB_AssocSetIds
{
    pattern: '/stress/cb_assoc_setids';
    documentation: 'Navigates combo::RootHop from combo::C0, whose AssociationMapping names an explicit SOURCE and TARGET set id on each end. The ids are load-bearing: COMBO_ROOT carries eight set implementations, so an unqualified end would be ambiguous. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C0.all()
        ->project(~[
            rootId:x|$x.rootId,
            hopCode:x|$x.hop.hopCode,
            hopLeaf:x|$x.hop.h1_s_nn1
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_AssocSetIds_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 2 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001","hopCode":null,"hopLeaf":null},{"rootId":"CR-0002","hopCode":null,"hopLeaf":null},{"rootId":"CR-0003","hopCode":"CH-0001","hopLeaf":"H1-S-NN1-001"},{"rootId":"CR-0004","hopCode":"CH-0002","hopLeaf":"H1-S-NN1-002"},{"rootId":"CR-0005","hopCode":"CH-0003","hopLeaf":"H1-S-NN1-003"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CB_Otherwise
{
    pattern: '/stress/cb_otherwise';
    documentation: 'Reads the embedded property on combo::WithOtherwise, mapped with an `Otherwise` fallback that never applies because the inline columns are NOT NULL. The fallback half is pinned by O1_CounterpartyOtherwise under F13. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::WithOtherwise.all()
        ->project(~[
            rootId:x|$x.rootId,
            code:x|$x.inline.code,
            label:x|$x.inline.label
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_Otherwise_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 2 combination cells, each a distinct (reach, transform, nullability, host) stacking.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001","code":"AA","label":"OTW-LABEL-001"},{"rootId":"CR-0002","code":"BB","label":"OTW-LABEL-002"},{"rootId":"CR-0003","code":"CC","label":"OTW-LABEL-003"},{"rootId":"CR-0004","code":"DD","label":"OTW-LABEL-004"},{"rootId":"CR-0005","code":"EE","label":"OTW-LABEL-005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
