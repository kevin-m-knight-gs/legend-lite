###Service
Service stress::CB_C0
{
    pattern: '/stress/cb_c0';
    documentation: 'Combination matrix cell: class filter=none, extends=no. Projects every property cell dealt to this class -- each a distinct (reach, transform, nullability, host) combination. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C0.all()
        ->project(~[
            rootId:x|$x.rootId,
            col_none_notnull_embedded:x|$x.nested.col_none_notnull_embedded,
            col_none_notnull_top:x|$x.col_none_notnull_top,
            chain1_none_notnull_top:x|$x.chain1_none_notnull_top,
            chain2_none_notnull_top:x|$x.chain2_none_notnull_top,
            col_nest_notnull_top:x|$x.col_nest_notnull_top,
            chain1_nest_nullable_top:x|$x.chain1_nest_nullable_top,
            chain2_up_notnull_embedded:x|$x.nested.chain2_up_notnull_embedded,
            chain2_cat_nullable_top:x|$x.chain2_cat_nullable_top
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_C0_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
