                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CB_GreaterNull
{
    pattern: '/stress/cb_greaternull';
    documentation: 'Comparison `>` against a column that is NULL in some rows. An ORDERED comparison against the same NULL, which also AGREES -- so the engine excludes for `>` and keeps for `!=`, and those cannot both be right. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C1.all()
        ->filter({x|($x.col_string_none_nullable_top > ' ')})
        ->project(~[
            rootId:x|$x.rootId,
            col_string_none_nullable_top:x|$x.col_string_none_nullable_top
