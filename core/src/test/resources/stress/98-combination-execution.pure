Service stress::CB_C15
{
    pattern: '/stress/cb_c15';
    documentation: 'Combination matrix cell: class filter=multigrain, extends=yes. Projects every property cell dealt to this class -- each a distinct (reach, transform, nullability, host) combination. Generated by scripts/corpus/combos.py.';
