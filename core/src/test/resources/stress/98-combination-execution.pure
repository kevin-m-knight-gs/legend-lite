                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001","col_string_none_nullable_top":"R-S-NL1-001"},{"rootId":"CR-0002","col_string_none_nullable_top":"R-S-NL1-002"},{"rootId":"CR-0004","col_string_none_nullable_top":"R-S-NL1-004"},{"rootId":"CR-0005","col_string_none_nullable_top":"R-S-NL1-005"}]';
