###Service
Service stress::CB_C0
{
    pattern: '/stress/cb_c0';
    documentation: 'Combination matrix cell: class filter=none, extends=no. Projects every property cell dealt to this class -- each a distinct (reach, transform, nullability, host) combination. Generated by scripts/corpus/combos.py.';
    execution: Single
    {
    query: |combo::C0.all()
        ->project(~[
            rootId:x|$x.rootId,
            col_string_none_notnull_embedded:x|$x.nested.col_string_none_notnull_embedded,
            col_string_none_notnull_top:x|$x.col_string_none_notnull_top,
            chain1_string_none_notnull_top:x|$x.chain1_string_none_notnull_top,
            chain2_string_none_notnull_top:x|$x.chain2_string_none_notnull_top,
            col_bool_none_notnull_top:x|$x.col_bool_none_notnull_top,
            col_float_none_notnull_top:x|$x.col_float_none_notnull_top,
            col_bool_isnotnull_notnull_top:x|$x.col_bool_isnotnull_notnull_top,
            col_int_plus_notnull_top:x|$x.col_int_plus_notnull_top,
            col_float_sqrt_notnull_top:x|$x.col_float_sqrt_notnull_top,
            col_int_times_notnull_top:x|$x.col_int_times_notnull_top,
            dyna1_string_none_nullable_top:x|$x.dyna1_string_none_nullable_top,
            dyna1_bool_none_notnull_top:x|$x.dyna1_bool_none_notnull_top,
            dyna2_int_abs_nullable_top:x|$x.dyna2_int_abs_nullable_top,
            ineq_string_up_nullable_top:x|$x.ineq_string_up_nullable_top,
            multicol_string_none_notnull_top:x|$x.multicol_string_none_notnull_top,
            multicol_bool_none_nullable_top:x|$x.multicol_bool_none_nullable_top,
            ormix_bool_none_notnull_top:x|$x.ormix_bool_none_notnull_top
        ])
        ->sort(~rootId->ascending());
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    CB_C0_suite:
    {
