   {
      ~primaryKey ( [store::DB]INSURANCE_LINKED_ITEM.RECORD_ID )
      ~mainTable [store::DB]INSURANCE_LINKED_ITEM
      recordId: [store::DB]INSURANCE_LINKED_ITEM.RECORD_ID,
      recordType: [store::DB]INSURANCE_LINKED_ITEM.RECORD_TYPE,
      bookId: [store::DB]INSURANCE_LINKED_ITEM.BOOK_ID,
      notional: [store::DB]INSURANCE_LINKED_ITEM.NOTIONAL,
      currency: [store::DB]INSURANCE_LINKED_ITEM.CURRENCY,
      tradeDate: [store::DB]INSURANCE_LINKED_ITEM.TRADE_DATE,
      maturityDate: [store::DB]INSURANCE_LINKED_ITEM.MATURITY_DATE,
      status: [store::DB]INSURANCE_LINKED_ITEM.STATUS,
      isActive: [store::DB]INSURANCE_LINKED_ITEM.IS_ACTIVE,
      riskScore: [store::DB]INSURANCE_LINKED_ITEM.RISK_SCORE
   }

