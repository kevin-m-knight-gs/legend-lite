// The ONE store::DB — merged from the per-domain store files.
// Engine-lite silently UNIONED same-named Database declarations across
// sources; real Legend (and core) treats a duplicate FQN as an error,
// so the tables/joins live in this single declaration.

###Relational
Database store::DB
(
    // ---- from 31-products-store.pure ----
    Table INSTRUMENT (INSTRUMENT_ID VARCHAR(200) PRIMARY KEY, TICKER VARCHAR(200), NAME VARCHAR(200), ISIN VARCHAR(200), CUSIP VARCHAR(200), SEDOL VARCHAR(200), ASSET_CLASS VARCHAR(200), PRODUCT_TYPE VARCHAR(200), IS_ACTIVE BIT, LISTING_DATE DATE, MATURITY_DATE DATE, NOTIONAL_AMOUNT DOUBLE, CURRENCY VARCHAR(200), DESCRIPTION VARCHAR(200), ISSUE_DATE DATE, EQUITY_ID VARCHAR(200), BOND_ID VARCHAR(200), FUTURE_ID VARCHAR(200), FX_FORWARD_ID VARCHAR(200), SWAP_ID VARCHAR(200), CDS_ID VARCHAR(200), STRUCTURED_PRODUCT_ID VARCHAR(200), ETF_ID VARCHAR(200), CURRENCY_CODE VARCHAR(200), EXCHANGE_MIC VARCHAR(200), SECTOR_ID VARCHAR(200))
    Table EQUITY (EQUITY_ID VARCHAR(200) PRIMARY KEY, TICKER VARCHAR(200), COMPANY_NAME VARCHAR(200), SHARE_CLASS VARCHAR(200), MARKET_CAP DOUBLE, SHARES_OUTSTANDING DOUBLE, DIVIDEND_YIELD DOUBLE, PE_RATIO DOUBLE, BETA DOUBLE, PRIMARY_EXCHANGE VARCHAR(200), IS_ADR BIT, LOT_SIZE INTEGER, LAST_PRICE DOUBLE, PRICE_DATE DATE, INSTRUMENT_ID VARCHAR(200))
    Table BOND (BOND_ID VARCHAR(200) PRIMARY KEY, ISSUER_NAME VARCHAR(200), COUPON_RATE DOUBLE, COUPON_FREQUENCY INTEGER, FACE_VALUE DOUBLE, MATURITY_DATE DATE, ISSUE_DATE DATE, CREDIT_RATING VARCHAR(200), YIELD_TO_MATURITY DOUBLE, DURATION DOUBLE, CONVEXITY DOUBLE, IS_CALLABLE BIT, CALL_DATE DATE, CALL_PRICE DOUBLE, BOND_TYPE VARCHAR(200), CURRENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200), ISSUER_ID VARCHAR(200))
    Table OPTION (OPTION_ID VARCHAR(200) PRIMARY KEY, OPTION_TYPE VARCHAR(200), STRIKE_PRICE DOUBLE, EXPIRATION_DATE DATE, PREMIUM DOUBLE, IMPLIED_VOLATILITY DOUBLE, DELTA DOUBLE, GAMMA DOUBLE, THETA DOUBLE, VEGA DOUBLE, EXERCISE_STYLE VARCHAR(200), IS_IN_THE_MONEY BIT, UNDERLYING_PRICE DOUBLE, CONTRACT_SIZE INTEGER, OPEN_INTEREST INTEGER, UNDERLYING_ID VARCHAR(200))
    Table FUTURE (FUTURE_ID VARCHAR(200) PRIMARY KEY, CONTRACT_NAME VARCHAR(200), CONTRACT_MONTH VARCHAR(200), CONTRACT_YEAR INTEGER, TICK_SIZE DOUBLE, CONTRACT_SIZE INTEGER, LAST_TRADING_DATE DATE, FIRST_NOTICE_DATE DATE, SETTLEMENT_TYPE VARCHAR(200), MARGIN_REQUIRED DOUBLE, DAILY_LIMIT DOUBLE, OPEN_INTEREST INTEGER, INSTRUMENT_ID VARCHAR(200))
    Table FX_FORWARD (FORWARD_ID VARCHAR(200) PRIMARY KEY, BASE_CURRENCY VARCHAR(200), QUOTE_CURRENCY VARCHAR(200), FORWARD_RATE DOUBLE, SPOT_RATE DOUBLE, FORWARD_POINTS DOUBLE, NOTIONAL_BASE DOUBLE, NOTIONAL_QUOTE DOUBLE, VALUE_DATE DATE, TRADE_DATE DATE, TENOR VARCHAR(200), IS_NDF BIT, INSTRUMENT_ID VARCHAR(200))
    Table SWAP (SWAP_ID VARCHAR(200) PRIMARY KEY, SWAP_TYPE VARCHAR(200), NOTIONAL DOUBLE, FIXED_RATE DOUBLE, FLOATING_INDEX VARCHAR(200), FLOATING_SPREAD DOUBLE, START_DATE DATE, END_DATE DATE, PAYMENT_FREQUENCY VARCHAR(200), DAY_COUNT_CONVENTION VARCHAR(200), CURRENCY VARCHAR(200), IS_CLEARED BIT, CLEARING_HOUSE VARCHAR(200), CURRENT_NPV DOUBLE, INSTRUMENT_ID VARCHAR(200))
    Table CREDIT_DEFAULT_SWAP (CDS_ID VARCHAR(200) PRIMARY KEY, REFERENCE_ENTITY VARCHAR(200), NOTIONAL DOUBLE, SPREAD DOUBLE, PREMIUM_LEG DOUBLE, PROTECTION_LEG DOUBLE, MATURITY_DATE DATE, EFFECTIVE_DATE DATE, RECOVERY_RATE DOUBLE, IS_TRIGGERED BIT, TRIGGER_DATE DATE, CURRENCY VARCHAR(200), SENIORITY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table STRUCTURED_PRODUCT (PRODUCT_ID VARCHAR(200) PRIMARY KEY, PRODUCT_NAME VARCHAR(200), UNDERLYING_TYPE VARCHAR(200), NOTIONAL DOUBLE, ISSUE_DATE DATE, MATURITY_DATE DATE, KNOCK_IN_BARRIER DOUBLE, KNOCK_OUT_BARRIER DOUBLE, PARTICIPATION_RATE DOUBLE, COUPON_RATE DOUBLE, PRINCIPAL_PROTECTION DOUBLE, CURRENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table ETF (ETF_ID VARCHAR(200) PRIMARY KEY, TICKER VARCHAR(200), FUND_NAME VARCHAR(200), ASSET_CLASS VARCHAR(200), EXPENSE_RATIO DOUBLE, TOTAL_ASSETS DOUBLE, NAV DOUBLE, NAV_DATE DATE, TRACKING_ERROR DOUBLE, INDEX_NAME VARCHAR(200), IS_LEVERAGED BIT, LEVERAGE_MULTIPLE DOUBLE, DIVIDEND_FREQUENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))

    Join Equity_Instrument(EQUITY.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Bond_Instrument(BOND.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Option_Underlying(OPTION.UNDERLYING_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Future_Instrument(FUTURE.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join FxForward_Instrument(FX_FORWARD.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Swap_Instrument(SWAP.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join CDS_Instrument(CREDIT_DEFAULT_SWAP.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join StructuredProduct_Instrument(STRUCTURED_PRODUCT.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join ETF_Instrument(ETF.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)

    // ---- from 32-refdata-store.pure ----
    Table CURRENCY (CODE VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), NUMERIC_CODE INTEGER, MINOR_UNIT INTEGER, SYMBOL VARCHAR(200), IS_ACTIVE BIT, REGION VARCHAR(200), IS_MAJOR BIT, CENTRAL_BANK VARCHAR(200), FIXING_SOURCE VARCHAR(200), COUNTRY_ID VARCHAR(200))
    Table EXCHANGE (MIC VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), CITY VARCHAR(200), TIMEZONE VARCHAR(200), OPEN_TIME VARCHAR(200), CLOSE_TIME VARCHAR(200), IS_ELECTRONIC BIT, OPERATING_MIC VARCHAR(200), WEBSITE VARCHAR(200), REGULATORY_BODY VARCHAR(200), COUNTRY_ID VARCHAR(200))
    Table SECTOR (SECTOR_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), GICS_CODE VARCHAR(200), LEVEL INTEGER, DESCRIPTION VARCHAR(200), IS_ACTIVE BIT, PARENT_SECTOR_ID VARCHAR(200), MARKET_CAP_WEIGHT DOUBLE, NUMBER_OF_COMPANIES INTEGER, LAST_UPDATED DATE)
    Table INDUSTRY (INDUSTRY_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), SIC_CODE VARCHAR(200), NAICS_CODE VARCHAR(200), DESCRIPTION VARCHAR(200), IS_ACTIVE BIT, SUB_INDUSTRY_OF VARCHAR(200), AVERAGE_PE DOUBLE, AVERAGE_DIVIDEND_YIELD DOUBLE, LAST_UPDATED DATE, SECTOR_ID VARCHAR(200))
    Table ISSUER (ISSUER_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), LEI VARCHAR(200), TICKER VARCHAR(200), CREDIT_RATING VARCHAR(200), RATING_AGENCY VARCHAR(200), DOMICILE VARCHAR(200), ISSUER_TYPE VARCHAR(200), IS_ACTIVE BIT, INCORPORATION_DATE DATE, TOTAL_DEBT_OUTSTANDING DOUBLE, WEBSITE VARCHAR(200), COUNTRY_ID VARCHAR(200))
    Table COUNTRY (COUNTRY_CODE VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), ISO3_CODE VARCHAR(200), REGION VARCHAR(200), SUB_REGION VARCHAR(200), CONTINENT VARCHAR(200), CAPITAL_CITY VARCHAR(200), TIME_ZONE VARCHAR(200), GDP DOUBLE, POPULATION INTEGER, IS_EU BIT, IS_OECD BIT)
    Table CALENDAR (CALENDAR_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), CALENDAR_TYPE VARCHAR(200), YEAR INTEGER, NUMBER_OF_HOLIDAYS INTEGER, IS_ACTIVE BIT, SOURCE VARCHAR(200), LAST_UPDATED DATE, DESCRIPTION VARCHAR(200), TIMEZONE VARCHAR(200), COUNTRY_ID VARCHAR(200))
    Table RATING (RATING_ID VARCHAR(200) PRIMARY KEY, AGENCY VARCHAR(200), RATING_VALUE VARCHAR(200), RATING_DATE DATE, OUTLOOK VARCHAR(200), WATCH_STATUS VARCHAR(200), IS_INVESTMENT_GRADE BIT, PREVIOUS_RATING VARCHAR(200), PREVIOUS_DATE DATE, RATING_TYPE VARCHAR(200), SECTOR VARCHAR(200), ISSUER_ID VARCHAR(200))
    Table INDEX (INDEX_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), TICKER VARCHAR(200), PROVIDER VARCHAR(200), ASSET_CLASS VARCHAR(200), GEOGRAPHY VARCHAR(200), CURRENCY VARCHAR(200), NUMBER_OF_CONSTITUENTS INTEGER, LAUNCH_DATE DATE, REBALANCE_FREQUENCY VARCHAR(200), METHODOLOGY VARCHAR(200), LAST_LEVEL DOUBLE, LAST_LEVEL_DATE DATE)
    Table INDEX_CONSTITUENT (CONSTITUENT_ID VARCHAR(200) PRIMARY KEY, EFFECTIVE_DATE DATE, WEIGHT DOUBLE, SHARES_HELD DOUBLE, MARKET_CAP DOUBLE, FREE_FLOAT_FACTOR DOUBLE, ADDED_DATE DATE, REMOVED_DATE DATE, IS_ACTIVE BIT, SECTOR VARCHAR(200), INDEX_ID VARCHAR(200))

    Join Sector_Industry(INDUSTRY.SECTOR_ID = SECTOR.SECTOR_ID)
    Join Country_Exchange(EXCHANGE.COUNTRY_ID = COUNTRY.COUNTRY_CODE)
    Join Issuer_Country(ISSUER.COUNTRY_ID = COUNTRY.COUNTRY_CODE)
    Join Index_IndexConstituent(INDEX_CONSTITUENT.INDEX_ID = INDEX.INDEX_ID)
    Join Rating_Issuer(RATING.ISSUER_ID = ISSUER.ISSUER_ID)
    Join Calendar_Country(CALENDAR.COUNTRY_ID = COUNTRY.COUNTRY_CODE)
    Join Currency_Country(CURRENCY.COUNTRY_ID = COUNTRY.COUNTRY_CODE)

    // ---- from 33-counterparty-store.pure ----
    Table COUNTERPARTY (COUNTERPARTY_ID VARCHAR(200) PRIMARY KEY, LEGAL_NAME VARCHAR(200), SHORT_NAME VARCHAR(200), LEI VARCHAR(200), COUNTERPARTY_TYPE VARCHAR(200), DOMICILE VARCHAR(200), INCORPORATION_COUNTRY VARCHAR(200), IS_ACTIVE BIT, ONBOARD_DATE DATE, CREDIT_RATING VARCHAR(200), RATING_AGENCY VARCHAR(200), TIER VARCHAR(200), PARENT_ENTITY_ID VARCHAR(200), INDUSTRY VARCHAR(200), WEBSITE VARCHAR(200), CLASSIFICATION_ID VARCHAR(200), COUNTRY_CODE VARCHAR(200))
    Table CONTACT (CONTACT_ID VARCHAR(200) PRIMARY KEY, FIRST_NAME VARCHAR(200), LAST_NAME VARCHAR(200), EMAIL VARCHAR(200), PHONE VARCHAR(200), ROLE VARCHAR(200), DEPARTMENT VARCHAR(200), IS_PRIMARY BIT, IS_ACTIVE BIT, LAST_CONTACT_DATE DATE, PREFERRED_CHANNEL VARCHAR(200), TITLE VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table CREDIT_RATING (RATING_ID VARCHAR(200) PRIMARY KEY, AGENCY VARCHAR(200), LONG_TERM_RATING VARCHAR(200), SHORT_TERM_RATING VARCHAR(200), OUTLOOK VARCHAR(200), RATING_DATE DATE, PREVIOUS_RATING VARCHAR(200), PREVIOUS_DATE DATE, WATCH_STATUS VARCHAR(200), IS_INVESTMENT_GRADE BIT, REVIEW_DATE DATE, ANALYST_NAME VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table AGREEMENT (AGREEMENT_ID VARCHAR(200) PRIMARY KEY, AGREEMENT_TYPE VARCHAR(200), EFFECTIVE_DATE DATE, TERMINATION_DATE DATE, GOVERNING_LAW VARCHAR(200), STATUS VARCHAR(200), VERSION INTEGER, SIGNED_DATE DATE, LAST_AMEND_DATE DATE, THRESHOLD DOUBLE, MINIMUM_TRANSFER_AMOUNT DOUBLE, INDEPENDENT_AMOUNT DOUBLE, CURRENCY VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table CLASSIFICATION (CLASSIFICATION_ID VARCHAR(200) PRIMARY KEY, CLASSIFICATION_TYPE VARCHAR(200), MIFID_CLASSIFICATION VARCHAR(200), DODDF_FRANK_CLASSIFICATION VARCHAR(200), EMIR_CLASSIFICATION VARCHAR(200), IS_FINANCIAL_COUNTERPARTY BIT, IS_SMALL_FINANCIAL BIT, EFFECTIVE_DATE DATE, REVIEW_DATE DATE, APPROVED_BY VARCHAR(200), NOTES VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table ACCOUNT (ACCOUNT_ID VARCHAR(200) PRIMARY KEY, ACCOUNT_NAME VARCHAR(200), ACCOUNT_TYPE VARCHAR(200), CURRENCY VARCHAR(200), STATUS VARCHAR(200), OPEN_DATE DATE, CLOSE_DATE DATE, CUSTODIAN VARCHAR(200), BROKER_ID VARCHAR(200), CLEARING_MEMBER_ID VARCHAR(200), MARGIN_TYPE VARCHAR(200), IS_SEGREGATED BIT, COUNTERPARTY_ID VARCHAR(200))
    Table BENEFICIAL_OWNER (OWNER_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), OWNERSHIP_PERCENTAGE DOUBLE, NATIONALITY VARCHAR(200), DATE_OF_BIRTH DATE, IS_PEP BIT, IS_VERIFIED BIT, VERIFICATION_DATE DATE, ID_TYPE VARCHAR(200), ID_NUMBER VARCHAR(200), ADDRESS VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table COUNTERPARTY_LIMIT (LIMIT_ID VARCHAR(200) PRIMARY KEY, LIMIT_TYPE VARCHAR(200), LIMIT_AMOUNT DOUBLE, CURRENT_UTILIZATION DOUBLE, UTILIZATION_PCT DOUBLE, CURRENCY VARCHAR(200), EFFECTIVE_DATE DATE, EXPIRY_DATE DATE, STATUS VARCHAR(200), APPROVED_BY VARCHAR(200), APPROVAL_DATE DATE, BREACH_COUNT INTEGER, COUNTERPARTY_ID VARCHAR(200))
    Table KYCRECORD (KYC_ID VARCHAR(200) PRIMARY KEY, STATUS VARCHAR(200), RISK_RATING VARCHAR(200), DUE_DILIGENCE_LEVEL VARCHAR(200), LAST_REVIEW_DATE DATE, NEXT_REVIEW_DATE DATE, REVIEWED_BY VARCHAR(200), APPROVED_BY VARCHAR(200), APPROVAL_DATE DATE, DOCUMENT_COUNT INTEGER, IS_COMPLETE BIT, EXPIRY_DATE DATE, NOTES VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table SANCTIONS_CHECK (CHECK_ID VARCHAR(200) PRIMARY KEY, CHECK_DATE TIMESTAMP, SCREENING_PROVIDER VARCHAR(200), RESULT VARCHAR(200), MATCH_COUNT INTEGER, FALSE_POSITIVE_COUNT INTEGER, TRUE_MATCH_COUNT INTEGER, STATUS VARCHAR(200), RESOLVED_DATE TIMESTAMP, RESOLVED_BY VARCHAR(200), LIST_CHECKED VARCHAR(200), IS_CLEARED BIT, COUNTERPARTY_ID VARCHAR(200))

    Join Counterparty_Contact(CONTACT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_CreditRating(CREDIT_RATING.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_Agreement(AGREEMENT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_Classification(CLASSIFICATION.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_Account(ACCOUNT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_BeneficialOwner(BENEFICIAL_OWNER.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_CounterpartyLimit(COUNTERPARTY_LIMIT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_KYC(KYCRECORD.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Counterparty_SanctionsCheck(SANCTIONS_CHECK.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)

    // ---- from 34-org-store.pure ----
    Table DESK (DESK_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), DESK_TYPE VARCHAR(200), ASSET_CLASS VARCHAR(200), REGION VARCHAR(200), IS_ACTIVE BIT, HEAD_TRADER VARCHAR(200), COST_CENTER VARCHAR(200), FLOOR VARCHAR(200), BUILDING VARCHAR(200), PHONE VARCHAR(200), RISK_LIMIT DOUBLE, PNL_TARGET DOUBLE, BUSINESS_UNIT_ID VARCHAR(200))
    Table TRADER (TRADER_ID VARCHAR(200) PRIMARY KEY, FIRST_NAME VARCHAR(200), LAST_NAME VARCHAR(200), BADGE VARCHAR(200), EMAIL VARCHAR(200), HIRE_DATE DATE, SENIORITY VARCHAR(200), IS_ACTIVE BIT, SPECIALIZATION VARCHAR(200), LICENSE VARCHAR(200), MAX_NOTIONAL DOUBLE, PNL_YTD DOUBLE, PHONE VARCHAR(200), DESK_ID VARCHAR(200), MANAGER_ID VARCHAR(200))
    Table PORTFOLIO_MANAGER (PM_ID VARCHAR(200) PRIMARY KEY, FIRST_NAME VARCHAR(200), LAST_NAME VARCHAR(200), EMAIL VARCHAR(200), STRATEGY VARCHAR(200), AUM DOUBLE, HIRE_DATE DATE, IS_ACTIVE BIT, PERFORMANCE_YTD DOUBLE, BENCHMARK VARCHAR(200), RISK_BUDGET DOUBLE, INVESTMENT_STYLE VARCHAR(200), CFA BIT, DESK_ID VARCHAR(200))
    Table BUSINESS_UNIT (BU_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), HEAD VARCHAR(200), DIVISION VARCHAR(200), IS_ACTIVE BIT, HEADCOUNT INTEGER, BUDGET DOUBLE, COST_CENTER VARCHAR(200), REGION VARCHAR(200), ESTABLISHED_DATE DATE, DESCRIPTION VARCHAR(200), LEGAL_ENTITY_ID VARCHAR(200))
    Table LEGAL_ENTITY (LE_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), JURISDICTION VARCHAR(200), LEI VARCHAR(200), ENTITY_TYPE VARCHAR(200), INCORPORATION_DATE DATE, REGISTRATION_NUMBER VARCHAR(200), REGULATORY_STATUS VARCHAR(200), IS_ACTIVE BIT, CAPITAL_BASE DOUBLE, PARENT_ENTITY_ID VARCHAR(200), TAX_ID VARCHAR(200), REGION_ID VARCHAR(200))
    Table REGION (REGION_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), CODE VARCHAR(200), TIMEZONE VARCHAR(200), HEAD_OF_REGION VARCHAR(200), IS_ACTIVE BIT, HEADCOUNT INTEGER, REVENUE_TARGET DOUBLE, COST_TARGET DOUBLE, DESCRIPTION VARCHAR(200))
    Table COST_CENTER (COST_CENTER_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), DEPARTMENT VARCHAR(200), BUDGET_AMOUNT DOUBLE, SPENT_AMOUNT DOUBLE, REMAINING_AMOUNT DOUBLE, FISCAL_YEAR INTEGER, MANAGER VARCHAR(200), IS_ACTIVE BIT, APPROVAL_THRESHOLD DOUBLE, CURRENCY VARCHAR(200))
    Table DEPARTMENT (DEPARTMENT_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), HEAD VARCHAR(200), HEADCOUNT INTEGER, IS_ACTIVE BIT, BUDGET DOUBLE, FLOOR VARCHAR(200), BUILDING VARCHAR(200), PHONE VARCHAR(200), ESTABLISHED_DATE DATE, PARENT_DEPARTMENT_ID VARCHAR(200), COST_CENTER_ID VARCHAR(200), BUSINESS_UNIT_ID VARCHAR(200))
    Table TEAM (TEAM_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), LEAD VARCHAR(200), TEAM_SIZE INTEGER, IS_ACTIVE BIT, FOCUS VARCHAR(200), FORMATION_DATE DATE, OBJECTIVE VARCHAR(200), PERFORMANCE_RATING DOUBLE, SLACK_CHANNEL VARCHAR(200), DEPARTMENT_ID VARCHAR(200))
    Table APPROVER (APPROVER_ID VARCHAR(200) PRIMARY KEY, FIRST_NAME VARCHAR(200), LAST_NAME VARCHAR(200), EMAIL VARCHAR(200), APPROVAL_LEVEL INTEGER, MAX_APPROVAL_AMOUNT DOUBLE, DEPARTMENT VARCHAR(200), IS_ACTIVE BIT, DELEGATE_TO VARCHAR(200), TITLE VARCHAR(200), CURRENCY VARCHAR(200), TEAM_ID VARCHAR(200))

    Join Desk_Trader(TRADER.DESK_ID = DESK.DESK_ID)
    Join Desk_BusinessUnit(DESK.BUSINESS_UNIT_ID = BUSINESS_UNIT.BU_ID)
    Join BusinessUnit_LegalEntity(BUSINESS_UNIT.LEGAL_ENTITY_ID = LEGAL_ENTITY.LE_ID)
    Join LegalEntity_Region(LEGAL_ENTITY.REGION_ID = REGION.REGION_ID)
    Join Department_Team(TEAM.DEPARTMENT_ID = DEPARTMENT.DEPARTMENT_ID)
    Join Department_CostCenter(DEPARTMENT.COST_CENTER_ID = COST_CENTER.COST_CENTER_ID)
    Join BusinessUnit_Department(DEPARTMENT.BUSINESS_UNIT_ID = BUSINESS_UNIT.BU_ID)
    Join Team_Approver(APPROVER.TEAM_ID = TEAM.TEAM_ID)

    // ---- from 35-positions-store.pure ----
    Table BOOK (BOOK_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200) NOT NULL, BOOK_TYPE VARCHAR(200), CURRENCY VARCHAR(200) NOT NULL, IS_ACTIVE BIT, OPEN_DATE DATE, CLOSE_DATE DATE, LEGAL_ENTITY VARCHAR(200), STRATEGY VARCHAR(200), PNL_YTD DOUBLE, POSITION_COUNT INTEGER, RISK_LIMIT DOUBLE, DESCRIPTION VARCHAR(200), DESK_ID VARCHAR(200))
    Table POSITION (POSITION_ID VARCHAR(200) PRIMARY KEY, QUANTITY DOUBLE, AVERAGE_COST DOUBLE, MARKET_VALUE DOUBLE, UNREALIZED_PN_L DOUBLE, REALIZED_PN_L DOUBLE, CURRENCY VARCHAR(200), POSITION_DATE DATE, DIRECTION VARCHAR(200), COST_BASIS DOUBLE, ACCRUED_INTEREST DOUBLE, LAST_UPDATED TIMESTAMP, IS_OPEN BIT, SETTLEMENT_DATE DATE, BOOK_ID VARCHAR(200), PORTFOLIO_ID VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table PORTFOLIO (PORTFOLIO_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), STRATEGY VARCHAR(200), INCEPTION DATE, AUM DOUBLE, CURRENCY VARCHAR(200), BENCHMARK VARCHAR(200), IS_ACTIVE BIT, NAV DOUBLE, NAV_DATE DATE, RETURN_YTD DOUBLE, RETURN_MTD DOUBLE, SHARPE_RATIO DOUBLE, MAX_DRAWDOWN DOUBLE, PM_ID VARCHAR(200))
    Table CASH_BALANCE (BALANCE_ID VARCHAR(200) PRIMARY KEY, BALANCE DOUBLE, CURRENCY VARCHAR(200), BALANCE_DATE DATE, BALANCE_TYPE VARCHAR(200), ACCOUNT_ID VARCHAR(200), AVAILABLE_BALANCE DOUBLE, PENDING_AMOUNT DOUBLE, IS_OVERDRAWN BIT, OVERDRAFT_LIMIT DOUBLE, LAST_UPDATED TIMESTAMP, BOOK_ID VARCHAR(200))
    Table INVENTORY (INVENTORY_ID VARCHAR(200) PRIMARY KEY, AVAILABLE_QUANTITY DOUBLE, LOCKED_QUANTITY DOUBLE, BORROWED_QUANTITY DOUBLE, LENT_QUANTITY DOUBLE, TOTAL_QUANTITY DOUBLE, INVENTORY_DATE DATE, SOURCE VARCHAR(200), LOCATION_TYPE VARCHAR(200), IS_SETTLED BIT, LAST_UPDATED TIMESTAMP, CUSTODIAN VARCHAR(200), BOOK_ID VARCHAR(200))
    Table LOT_POSITION (LOT_ID VARCHAR(200) PRIMARY KEY, QUANTITY DOUBLE, COST_PRICE DOUBLE, COST_BASIS DOUBLE, ACQUIRE_DATE DATE, LOT_TYPE VARCHAR(200), IS_OPEN BIT, CLOSE_DATE DATE, CLOSE_PRICE DOUBLE, REALIZED_GAIN DOUBLE, HOLDING_PERIOD INTEGER, TAX_METHOD VARCHAR(200), POSITION_ID VARCHAR(200))
    Table BOOK_TRANSFER (TRANSFER_ID VARCHAR(200) PRIMARY KEY, FROM_BOOK_ID VARCHAR(200), TO_BOOK_ID VARCHAR(200), QUANTITY DOUBLE, PRICE DOUBLE, TRANSFER_DATE DATE, REASON VARCHAR(200), STATUS VARCHAR(200), APPROVED_BY VARCHAR(200), APPROVAL_DATE DATE, CURRENCY VARCHAR(200), NOTIONAL DOUBLE, SOURCE_BOOK_ID VARCHAR(200))
    Table POSITION_BREAK (BREAK_ID VARCHAR(200) PRIMARY KEY, BREAK_TYPE VARCHAR(200), EXPECTED_QUANTITY DOUBLE, ACTUAL_QUANTITY DOUBLE, DIFFERENCE DOUBLE, BREAK_DATE DATE, STATUS VARCHAR(200), PRIORITY VARCHAR(200), ASSIGNED_TO VARCHAR(200), RESOLVED_DATE DATE, RESOLUTION VARCHAR(200), AGE_IN_DAYS INTEGER, POSITION_ID VARCHAR(200))
    Table RECONCILIATION_ITEM (RECON_ID VARCHAR(200) PRIMARY KEY, SOURCE VARCHAR(200), TARGET VARCHAR(200), SOURCE_VALUE DOUBLE, TARGET_VALUE DOUBLE, DIFFERENCE DOUBLE, RECON_DATE DATE, STATUS VARCHAR(200), MATCH_TYPE VARCHAR(200), IS_MATCHED BIT, COMMENT VARCHAR(200), RESOLVED_BY VARCHAR(200), POSITION_ID VARCHAR(200))
    Table POSITION_SNAPSHOT (SNAPSHOT_ID VARCHAR(200) PRIMARY KEY, SNAPSHOT_DATE DATE, SNAPSHOT_TIME TIMESTAMP, QUANTITY DOUBLE, MARKET_VALUE DOUBLE, UNREALIZED_PN_L DOUBLE, COST_BASIS DOUBLE, CURRENCY VARCHAR(200), SOURCE VARCHAR(200), IS_EOD BIT, VERSION INTEGER, POSITION_ID VARCHAR(200))

    Join Position_Book(POSITION.BOOK_ID = BOOK.BOOK_ID)
    Join Portfolio_Position(POSITION.PORTFOLIO_ID = PORTFOLIO.PORTFOLIO_ID)
    Join CashBalance_Book(CASH_BALANCE.BOOK_ID = BOOK.BOOK_ID)
    Join Inventory_Book(INVENTORY.BOOK_ID = BOOK.BOOK_ID)
    Join LotPosition_Position(LOT_POSITION.POSITION_ID = POSITION.POSITION_ID)
    Join BookTransfer_Book(BOOK_TRANSFER.SOURCE_BOOK_ID = BOOK.BOOK_ID)
    Join PositionBreak_Position(POSITION_BREAK.POSITION_ID = POSITION.POSITION_ID)
    Join ReconciliationItem_Position(RECONCILIATION_ITEM.POSITION_ID = POSITION.POSITION_ID)
    Join PositionSnapshot_Position(POSITION_SNAPSHOT.POSITION_ID = POSITION.POSITION_ID)

    // ---- L5: a real pre-aggregated table, for AggregationAware ----
    // Unlike NOTIONAL_BY_BOOK (a Legend View, which the engine inlines as a GROUP BY),
    // this is a PHYSICAL table a warehouse job would populate overnight. An
    // AggregationAware mapping lets a query hit it INSTEAD of the detail table when the
    // query's shape matches -- same answer, far less work.
    //
    // Its rows are derived from TRADE by scripts/corpus/aggregate.py, so detail and
    // aggregate agree by construction. A hand-written aggregate that disagreed would make
    // "which table did it read" observable, but would also mean the corpus asserts
    // something false; the SQL is inspected instead.
    Table TRADE_BY_BOOK (BOOK_ID VARCHAR(200) PRIMARY KEY, TOTAL_NOTIONAL DOUBLE, TRADE_COUNT INTEGER)

    // ---- L4: the rollup View ----
    // Notional by book — the standard warehouse rollup, and the thing a risk report
    // actually reads. This is a Legend View, not a database view: no DDL is created for
    // it, the engine inlines the GROUP BY into the query it generates.
    //
    // Worth contrasting with F2_BookChildCounts, which counts trades per book by OUTER
    // JOINING from BOOK. That returns a row for BK-LEGACY with a count. This groups the
    // TRADE table, so BK-LEGACY -- which has no trades -- produces NO GROUP AT ALL and is
    // simply absent. Two defensible answers to "trades per book" that differ on exactly
    // the empty case, both asserted.
    View NOTIONAL_BY_BOOK
    (
      ~groupBy
      (
        TRADE.BOOK_ID
      )
      BOOK_ID: TRADE.BOOK_ID PRIMARY KEY,
      TRADE_COUNT: count(TRADE.TRADE_ID),
      TOTAL_NOTIONAL: sum(TRADE.NOTIONAL),
      MAX_NOTIONAL: max(TRADE.NOTIONAL)
    )

    // ---- L3b: BITEMPORAL reference data ----
    // Business time answers "when was this true?"; processing time answers "when did we
    // BELIEVE it?". Both together answer the question a regulator actually asks: what did
    // we know on date P about date B -- and, crucially, what did a CORRECTION change.
    //
    // Both specs live in one milestoning block, comma-separated, and their predicates AND
    // together. The primary key spans the entity plus BOTH from-columns.
    Table INSTR_RATING_BI
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z, INFINITY_DATE = %9999-12-31),
        processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31)
      )
      INSTRUMENT_ID VARCHAR(200) PRIMARY KEY,
      FROM_Z DATE PRIMARY KEY,
      IN_Z DATE PRIMARY KEY,
      THRU_Z DATE,
      OUT_Z DATE,
      CREDIT_RATING VARCHAR(20),
      SOURCE VARCHAR(50)
    )

    // ---- L4: the partitioned trade history ----
    // Real trade stores are partitioned; this one splits by asset class, which is the
    // shape that survives when a firm's rates and equities businesses run on different
    // platforms. The three partitions are UNIONED back into one class by an Operation
    // mapping, and TRADE_FX is deliberately EMPTY -- a union leg contributing no rows is
    // the case that breaks naive union implementations.
    //
    // Contents are DERIVED from TRADE by scripts/corpus/partition.py, so
    // HistTrade.all() and Trade.all() must return the same rows by construction.
    Table TRADE_EQ (TRADE_ID VARCHAR(200) PRIMARY KEY, TRADE_DATE DATE, QUANTITY DOUBLE, PRICE DOUBLE, NOTIONAL DOUBLE, SIDE VARCHAR(200), STATUS VARCHAR(200), CURRENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table TRADE_RATES (TRADE_ID VARCHAR(200) PRIMARY KEY, TRADE_DATE DATE, QUANTITY DOUBLE, PRICE DOUBLE, NOTIONAL DOUBLE, SIDE VARCHAR(200), STATUS VARCHAR(200), CURRENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table TRADE_FX (TRADE_ID VARCHAR(200) PRIMARY KEY, TRADE_DATE DATE, QUANTITY DOUBLE, PRICE DOUBLE, NOTIONAL DOUBLE, SIDE VARCHAR(200), STATUS VARCHAR(200), CURRENCY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))

    // ---- L5: partially-denormalized reporting table, for Otherwise ----
    // The realistic shape Otherwise exists for: a reporting table CACHES the counterparty
    // inline, but the cache is not always populated. CPTY_FK is always present; the two
    // CPTY_*_INLINE columns are blank for some rows. An Otherwise mapping uses the inline
    // columns when they are there and falls back to a real join when they are not, so the
    // answer is complete either way.
    //
    // The embedded block's ~primaryKey is what decides "is the inline data present" --
    // it must be a column that is NULL exactly when the cache is empty, which is why the
    // fallback FK is a SEPARATE column.
    Table TRADE_FLAT_PARTIAL (TRADE_ID VARCHAR(200) PRIMARY KEY, NOTIONAL DOUBLE, STATUS VARCHAR(200), CPTY_FK VARCHAR(200), CPTY_ID_INLINE VARCHAR(200), CPTY_NAME_INLINE VARCHAR(200), CPTY_LEI_INLINE VARCHAR(200))

    // ---- Reference-data taxonomies: corporate actions, securities, order tickets ----
    Table CA_EVENT (ACTION_ID VARCHAR(60) PRIMARY KEY, ACTION_TYPE VARCHAR(60), SECURITY_ID VARCHAR(60), ANNOUNCED_DATE DATE, EX_DATE DATE, RECORD_DATE DATE, PAY_DATE DATE, STATUS VARCHAR(60), IS_MANDATORY BIT, CASH_RATE DECIMAL(18,4), RATIO_OLD INTEGER, RATIO_NEW INTEGER, CURRENCY VARCHAR(60))

    Table SECURITY_MASTER (SECURITY_KEY VARCHAR(60) PRIMARY KEY, SECURITY_TYPE VARCHAR(60), DESCRIPTION VARCHAR(60), ISSUER_NAME VARCHAR(60), CURRENCY VARCHAR(60), ISSUE_DATE DATE, MATURITY_DATE DATE, FACE_VALUE DECIMAL(18,4), IS_LISTED BIT, EXCHANGE_MIC VARCHAR(60), ASSET_CLASS VARCHAR(60))

    Table ORDER_TICKET (TICKET_ID VARCHAR(60) PRIMARY KEY, ORDER_TYPE VARCHAR(60), SECURITY_ID VARCHAR(60), SIDE VARCHAR(60), QUANTITY INTEGER, LIMIT_PRICE DECIMAL(18,4), TIME_IN_FORCE VARCHAR(60), VENUE VARCHAR(60), PLACED_AT TIMESTAMP, STATUS VARCHAR(60), FILLED_QUANTITY INTEGER, TRADER_ID VARCHAR(60))

    Table COLLATERAL_TYPE_HOLDING (HOLDING_ID VARCHAR(60) PRIMARY KEY, COLLATERAL_TYPE VARCHAR(60), COUNTERPARTY_ID VARCHAR(60), MARKET_VALUE DECIMAL(18,4), HAIRCUT_PCT DECIMAL(18,4), CURRENCY VARCHAR(60), VALUATION_DATE DATE, IS_ELIGIBLE BIT, CUSTODIAN VARCHAR(60), MATURITY_DATE DATE)

    Table REG_SUBMISSION (SUBMISSION_ID VARCHAR(60) PRIMARY KEY, REPORT_TYPE VARCHAR(60), REGIME VARCHAR(60), AUTHORITY VARCHAR(60), REPORTING_DATE DATE, SUBMITTED_AT TIMESTAMP, RECORD_COUNT INTEGER, STATUS VARCHAR(60), ACKNOWLEDGED_AT TIMESTAMP, REJECTION_REASON VARCHAR(60), IS_LATE BIT)

    Table RISK_LIMIT_DEF (LIMIT_ID VARCHAR(60) PRIMARY KEY, LIMIT_TYPE VARCHAR(60), SCOPE VARCHAR(60), SCOPE_VALUE VARCHAR(60), LIMIT_AMOUNT DECIMAL(18,4), UTILISATION DECIMAL(18,4), CURRENCY VARCHAR(60), EFFECTIVE_FROM DATE, APPROVED_BY VARCHAR(60), BREACHED_ON DATE, IS_HARD BIT)

    Table ACCOUNT_REGISTER (ACCOUNT_ID VARCHAR(60) PRIMARY KEY, ACCOUNT_TYPE VARCHAR(60), ACCOUNT_NAME VARCHAR(60), CURRENCY VARCHAR(60), BALANCE DECIMAL(18,4), OPENED_ON DATE, IS_SEGREGATED BIT, OWNER_ID VARCHAR(60), CUSTODIAN VARCHAR(60), CLOSED_ON DATE)

    Table FEE_CHARGE (CHARGE_ID VARCHAR(60) PRIMARY KEY, FEE_TYPE VARCHAR(60), COUNTERPARTY_ID VARCHAR(60), GROSS_AMOUNT DECIMAL(18,4), TAX_AMOUNT DECIMAL(18,4), CURRENCY VARCHAR(60), CHARGED_ON DATE, IS_REBATABLE BIT, INVOICE_REF VARCHAR(60), BASIS_POINTS DECIMAL(18,4))

    Table MARKET_DATA_POINT (POINT_ID VARCHAR(60) PRIMARY KEY, DATA_TYPE VARCHAR(60), INSTRUMENT_REF VARCHAR(60), COB_DATE DATE, VALUE DECIMAL(18,4), CURRENCY VARCHAR(60), SOURCE VARCHAR(60), IS_STALE BIT, TENOR VARCHAR(60), PREVIOUS_VALUE DECIMAL(18,4))

    // ---- Back office: where cash actually moves ----
    //
    // Standing instructions say where to send things, payments are the instructions to move
    // them, nostro movements are what the correspondent says happened, and reconciliation
    // items are the differences between the last two -- which is the entire job.
    //
    // PAYMENT and NOSTRO_MOVEMENT are deliberately NOT mirrors of each other. One statement
    // line has no payment behind it, one payment never reached the statement, and one pair
    // agrees on amount and disagrees on value date. Those three are what a reconciliation
    // exists to find, and a seed where both sides match is a seed that tests nothing.
    Table BO_SSI (SSI_ID VARCHAR(24) PRIMARY KEY,
        COUNTERPARTY_ID VARCHAR(12), CURRENCY VARCHAR(3), INSTRUMENT_TYPE VARCHAR(12),
        CORRESPONDENT_BIC VARCHAR(11), ACCOUNT_NUMBER VARCHAR(24),
        PLACE_OF_SETTLEMENT VARCHAR(2), IS_DEFAULT BIT, EFFECTIVE_FROM DATE,
        EFFECTIVE_TO DATE, STATUS VARCHAR(12))

    Table PAYMENT (PAYMENT_ID VARCHAR(16) PRIMARY KEY, OTC_ID VARCHAR(12),
        SSI_ID VARCHAR(24), PAYMENT_TYPE VARCHAR(16), DIRECTION VARCHAR(4),
        AMOUNT DECIMAL(18,2), CURRENCY VARCHAR(3), VALUE_DATE DATE, STATUS VARCHAR(12),
        SETTLED_AT TIMESTAMP, REFERENCE VARCHAR(24), FAIL_REASON VARCHAR(60))

    Table BO_NOSTRO (NOSTRO_ID VARCHAR(16) PRIMARY KEY, CORRESPONDENT_BIC VARCHAR(11),
        CURRENCY VARCHAR(3), ACCOUNT_NUMBER VARCHAR(24), ACCOUNT_NAME VARCHAR(40),
        OPENING_BALANCE DECIMAL(18,2), IS_ACTIVE BIT, LAST_RECONCILED DATE)

    Table NOSTRO_MOVEMENT (MOVEMENT_ID VARCHAR(16) PRIMARY KEY, NOSTRO_ID VARCHAR(16),
        VALUE_DATE DATE, AMOUNT DECIMAL(18,2), CURRENCY VARCHAR(3),
        STATEMENT_REF VARCHAR(20), NARRATIVE VARCHAR(60), POSTED_AT TIMESTAMP)

    Table RECON_ITEM (RECON_ID VARCHAR(16) PRIMARY KEY, NOSTRO_ID VARCHAR(16),
        PAYMENT_ID VARCHAR(16), MOVEMENT_ID VARCHAR(16), ITEM_TYPE VARCHAR(24),
        AMOUNT DECIMAL(18,2), CURRENCY VARCHAR(3), RECON_DATE DATE, STATUS VARCHAR(16),
        ASSIGNED_TO VARCHAR(30), AGE_DAYS INTEGER)

    // ---- Middle office: what happens to a trade after it is booked ----
    //
    // The lifecycle event table is the spine. Every amendment, termination, novation, reset
    // and credit event lands here with its own type, and the TYPE decides which columns mean
    // anything: a rate reset carries a fixing and no notional change, a partial termination
    // carries a notional change and no fixing. That is exactly the shape a discriminator
    // models and a wide table does not.
    Table LIFECYCLE_EVENT (EVENT_ID VARCHAR(16) PRIMARY KEY, OTC_ID VARCHAR(12),
        EVENT_TYPE VARCHAR(24), EVENT_DATE DATE, EFFECTIVE_DATE DATE, STATUS VARCHAR(12),
        INITIATED_BY VARCHAR(30), NOTIONAL_DELTA DECIMAL(18,2), FIXING_RATE DECIMAL(12,4),
        CASH_FLOW DECIMAL(18,2), COUNTERPARTY_REF VARCHAR(24), NOTES VARCHAR(120))

    Table CONFIRMATION_MO (CONFIRMATION_ID VARCHAR(16) PRIMARY KEY, OTC_ID VARCHAR(12),
        METHOD VARCHAR(12), PLATFORM VARCHAR(20), SENT_AT TIMESTAMP, MATCHED_AT TIMESTAMP,
        STATUS VARCHAR(14), CHASE_COUNT INTEGER, AFFIRMED_BY VARCHAR(30))

    Table TRADE_BREAK (BREAK_ID VARCHAR(16) PRIMARY KEY, OTC_ID VARCHAR(12),
        BREAK_TYPE VARCHAR(24), DETECTED_DATE DATE, SEVERITY VARCHAR(8),
        STATUS VARCHAR(12), ASSIGNED_TO VARCHAR(30), RESOLVED_DATE DATE, AGE_DAYS INTEGER,
        FIELD_NAME VARCHAR(24), OUR_VALUE VARCHAR(24), THEIR_VALUE VARCHAR(24))

    // ---- Market risk: a run, the factors it shocked, the numbers it produced ----
    //
    // The shape every market-risk stack has. One batch per day per scope, a factor hierarchy
    // underneath it, and a measure table that fans out to trades x factors x tenor buckets.
    // Firm-level numbers and per-trade sensitivities are different tables because they are
    // different grains, which is the thing a single wide "risk" table always gets wrong.
    Table RISK_RUN (RUN_ID VARCHAR(24) PRIMARY KEY, COB_DATE DATE, RUN_TYPE VARCHAR(12),
        SCOPE VARCHAR(20), MODEL_VERSION VARCHAR(16), STATUS VARCHAR(12),
        STARTED_AT TIMESTAMP, COMPLETED_AT TIMESTAMP, TRADE_COUNT INTEGER,
        APPROVED_BY VARCHAR(40))

    Table MR_RISK_FACTOR (FACTOR_ID VARCHAR(32) PRIMARY KEY, FACTOR_TYPE VARCHAR(20),
        CURVE_NAME VARCHAR(20), CURRENCY VARCHAR(3), TENOR VARCHAR(6),
        TENOR_MONTHS INTEGER, ASSET_CLASS VARCHAR(12))

    Table SENSITIVITY (SENSITIVITY_ID VARCHAR(16) PRIMARY KEY, RUN_ID VARCHAR(24),
        OTC_ID VARCHAR(12), FACTOR_ID VARCHAR(32), MEASURE_TYPE VARCHAR(20),
        MEASURE_VALUE DECIMAL(18,2), MEASURE_CURRENCY VARCHAR(3),
        SHOCK_SIZE DECIMAL(9,4), SHOCK_UNIT VARCHAR(6), COB_DATE DATE)

    Table RISK_MEASURE (MEASURE_ID VARCHAR(16) PRIMARY KEY, RUN_ID VARCHAR(24),
        MEASURE_TYPE VARCHAR(24), SCOPE VARCHAR(20), CONFIDENCE DECIMAL(6,4),
        HORIZON_DAYS INTEGER, MEASURE_VALUE DECIMAL(18,2), CURRENCY VARCHAR(3),
        LOOKBACK_DAYS INTEGER, MODEL_NAME VARCHAR(20))

    Table MR_STRESS_SCENARIO (SCENARIO_ID VARCHAR(20) PRIMARY KEY, SCENARIO_NAME VARCHAR(60),
        SCENARIO_TYPE VARCHAR(16), SEVERITY VARCHAR(12), HORIZON_DAYS INTEGER,
        AS_OF_EVENT DATE, IS_REGULATORY BIT)

    Table SCENARIO_RESULT (RESULT_ID VARCHAR(16) PRIMARY KEY, RUN_ID VARCHAR(24),
        SCENARIO_ID VARCHAR(20), SCOPE VARCHAR(20), STRESSED_PNL DECIMAL(18,2),
        BASE_PNL DECIMAL(18,2), CURRENCY VARCHAR(3), COB_DATE DATE, BREACHED_LIMIT BIT)

    // ---- OTC derivatives: shared economics, per-family extensions ----
    //
    // One table of the terms every OTC trade has -- counterparty, notional, dates, clearing
    // -- with a PRODUCT_TYPE discriminator, and the parts that differ per family in their
    // own tables. A swap has legs and an option has a strike; neither has the other's
    // columns, and a single wide table would carry forty nulls a row.
    //
    // This is how a firm models a product taxonomy, and it is why thirteen product classes
    // need three tables rather than thirteen.
    Table OTC_TRADE (OTC_ID VARCHAR(12) PRIMARY KEY, PRODUCT_TYPE VARCHAR(40),
        ASSET_CLASS VARCHAR(12), COUNTERPARTY_ID VARCHAR(12), TRADE_DATE DATE,
        EFFECTIVE_DATE DATE, TERMINATION_DATE DATE, NOTIONAL DECIMAL(18,2),
        CURRENCY VARCHAR(3), CLEARING_STATUS VARCHAR(12), CLEARING_HOUSE VARCHAR(10),
        MASTER_AGREEMENT VARCHAR(12), COLLATERALISED BIT)

    // Two legs for a swap, none for an option. Pay/receive is from the firm's side, and a
    // basis swap has a floating leg on BOTH sides -- the case a "one leg is fixed"
    // assumption gets wrong.
    Table OTC_SWAP_LEG (LEG_ID VARCHAR(16) PRIMARY KEY, OTC_ID VARCHAR(12),
        LEG_NUMBER INTEGER, LEG_TYPE VARCHAR(12), PAY_RECEIVE VARCHAR(8),
        FIXED_RATE DECIMAL(9,4), FLOATING_INDEX VARCHAR(24), SPREAD_BP DECIMAL(9,4),
        RESET_FREQUENCY VARCHAR(14), PAYMENT_FREQUENCY VARCHAR(14), DAY_COUNT VARCHAR(10),
        LEG_NOTIONAL DECIMAL(18,2), LEG_CURRENCY VARCHAR(3))

    // Three of thirteen trades have option terms, so this join is empty for the other ten.
    Table OTC_OPTION_TERMS (OTC_ID VARCHAR(12) PRIMARY KEY, OPTION_STYLE VARCHAR(12),
        CALL_PUT VARCHAR(8), STRIKE DECIMAL(12,4), PREMIUM DECIMAL(18,2),
        PREMIUM_CURRENCY VARCHAR(3), EXPIRY_DATE DATE, UNDERLYING_TENOR VARCHAR(6),
        BARRIER_LEVEL DECIMAL(12,4), BARRIER_TYPE VARCHAR(16))

    // ---- Fixed income: a security's coupon schedule and what has been paid ----
    //
    // The deepest one-to-many in the corpus, and it is deep because a coupon schedule
    // genuinely is: a thirty-year Treasury paying semi-annually has sixty accrual periods.
    // Everything else here fans out three or four ways, which is enough to exercise a join
    // and not enough to be a schedule.
    //
    // COUPON_PERIOD is the accrual calendar and exists for the whole life of the bond;
    // COUPON_PAYMENT exists only where a coupon has actually been paid, so the outer join
    // is empty for every future period. That hole is the shape a real query has to handle,
    // not a NULL put there to be awkward.
    Table DEBT_SECURITY (SECURITY_ID VARCHAR(12) PRIMARY KEY, DESCRIPTION VARCHAR(120),
        ISSUER_NAME VARCHAR(80), ISSUER_COUNTRY VARCHAR(2), CURRENCY VARCHAR(3),
        COUPON_RATE DECIMAL(9,4), COUPON_FREQUENCY INTEGER, DAY_COUNT_BASIS VARCHAR(10),
        FACE_VALUE DECIMAL(18,2), ISSUE_DATE DATE, MATURITY_DATE DATE,
        SENIORITY VARCHAR(20), IS_CALLABLE BIT, WITHHOLDING_RATE DECIMAL(6,4))

    Table COUPON_PERIOD (PERIOD_ID VARCHAR(20) PRIMARY KEY, SECURITY_ID VARCHAR(12),
        PERIOD_NUMBER INTEGER, ACCRUAL_START_DATE DATE, ACCRUAL_END_DATE DATE,
        PAYMENT_DATE DATE, ACCRUAL_DAYS INTEGER, NOTIONAL DECIMAL(18,2),
        COUPON_RATE DECIMAL(9,4), COUPON_AMOUNT DECIMAL(18,2), IS_PAID BIT)

    Table COUPON_PAYMENT (PAYMENT_ID VARCHAR(24) PRIMARY KEY, PERIOD_ID VARCHAR(20),
        SECURITY_ID VARCHAR(12), PAYMENT_DATE DATE, GROSS_AMOUNT DECIMAL(18,2),
        WITHHOLDING_TAX DECIMAL(18,2), NET_AMOUNT DECIMAL(18,2), CURRENCY VARCHAR(3),
        STATUS VARCHAR(20))

    // ---- L3: business-temporal (SCD2) reference data ----
    // A counterparty's credit rating changes over time and the history is kept. This is
    // the single most common temporal shape in a bank, and it is the one that makes
    // "as of when?" a real question rather than a decoration.
    //
    // The milestoning block must come FIRST inside the parentheses, ahead of the columns.
    // PRIMARY KEY is COMPOSITE (id + FROM_Z) because the whole point is several rows per
    // counterparty; declaring only COUNTERPARTY_ID compiles and then fails at insert time
    // when the test harness generates DDL from this schema.
    //
    // INFINITY_DATE is REQUIRED for %latest. Without it the milestoning parses, compiles
    // and serves dated queries perfectly well, and only %latest fails -- at plan
    // generation, with "requires it to specify a milestoning 'INFINITY_DATE'". The
    // open-ended THRU_Z values in the seed must match it exactly.
    Table CPTY_RATING_MS
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z, INFINITY_DATE = %9999-12-31)
      )
      COUNTERPARTY_ID VARCHAR(200) PRIMARY KEY,
      FROM_Z DATE PRIMARY KEY,
      THRU_Z DATE,
      RATING VARCHAR(20),
      AGENCY VARCHAR(50),
      OUTLOOK VARCHAR(20),
      IS_INVESTMENT_GRADE BIT
    )

    // ---- L2: the denormalized reporting table ----
    // Every firm has one. It carries the trade together with the reference data a report
    // needs, so a report does not join at read time. Its rows are DERIVED from the
    // normalized tables by scripts/corpus/flat.py rather than authored, which is what
    // makes mapping invariance a real test: if the two shapes disagree, the disagreement
    // is the engine's, not the fixture's.
    Table TRADE_FLAT (TRADE_ID VARCHAR(200) PRIMARY KEY, TRADE_DATE DATE, SETTLEMENT_DATE DATE, QUANTITY DOUBLE, PRICE DOUBLE, NOTIONAL DOUBLE, SIDE VARCHAR(200), STATUS VARCHAR(200), TRADE_TYPE VARCHAR(200), CURRENCY VARCHAR(200), COMMISSION DOUBLE, FEES DOUBLE, EXECUTION_VENUE VARCHAR(200), IS_BLOCK BIT, CREATED_TIME TIMESTAMP, LAST_MODIFIED_TIME TIMESTAMP, INSTR_ID VARCHAR(200), INSTR_NAME VARCHAR(200), INSTR_TICKER VARCHAR(200), INSTR_ASSET_CLASS VARCHAR(200), INSTR_CURRENCY VARCHAR(200), INSTR_ISIN VARCHAR(200), BOOK_ID VARCHAR(200), BOOK_NAME VARCHAR(200), BOOK_CURRENCY VARCHAR(200), CPTY_ID VARCHAR(200), CPTY_NAME VARCHAR(200), CPTY_LEI VARCHAR(200), CPTY_TIER VARCHAR(200), TRADER_ID VARCHAR(200), TRADER_FIRST VARCHAR(200), TRADER_LAST VARCHAR(200))

    // ---- from 36-trading-store.pure ----
    Table TRADE (TRADE_ID VARCHAR(200) PRIMARY KEY, TRADE_DATE DATE, SETTLEMENT_DATE DATE, QUANTITY DOUBLE, PRICE DOUBLE, NOTIONAL DOUBLE NOT NULL, SIDE VARCHAR(200), STATUS VARCHAR(200) NOT NULL, TRADE_TYPE VARCHAR(200), CURRENCY VARCHAR(200), COMMISSION DOUBLE, FEES DOUBLE, EXECUTION_VENUE VARCHAR(200), IS_BLOCK BIT, CREATED_TIME TIMESTAMP, LAST_MODIFIED_TIME TIMESTAMP, ORDER_ID VARCHAR(200), BLOCK_ID VARCHAR(200), AVG_PRICE_TRADE_ID VARCHAR(200), BOOK_ID VARCHAR(200), COUNTERPARTY_ID VARCHAR(200), INSTRUMENT_ID VARCHAR(200), TRADER_ID VARCHAR(200))
    Table TRADE_ORDER (ORDER_ID VARCHAR(200) PRIMARY KEY, ORDER_DATE DATE, SIDE VARCHAR(200), QUANTITY DOUBLE, FILLED_QUANTITY DOUBLE, REMAINING_QUANTITY DOUBLE, LIMIT_PRICE DOUBLE, STOP_PRICE DOUBLE, TIME_IN_FORCE VARCHAR(200), STATUS VARCHAR(200), PRIORITY INTEGER, CREATED_TIME TIMESTAMP, LAST_MODIFIED_TIME TIMESTAMP, EXPIRY_DATE DATE, IS_ALGO_ORDER BIT, ALGO_STRATEGY VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table EXECUTION (EXECUTION_ID VARCHAR(200) PRIMARY KEY, EXECUTION_TIME TIMESTAMP, FILLED_QUANTITY DOUBLE, FILL_PRICE DOUBLE, VENUE VARCHAR(200), BROKER VARCHAR(200), COMMISSION DOUBLE, FILL_TYPE VARCHAR(200), EXECUTION_ALGO VARCHAR(200), ARRIVAL_PRICE DOUBLE, SLIPPAGE DOUBLE, MARKET_IMPACT DOUBLE, IS_PARTIAL_FILL BIT, SEQUENCE_NUMBER INTEGER, LAST_MARKET VARCHAR(200), ORDER_ID VARCHAR(200))
    Table ALLOCATION (ALLOCATION_ID VARCHAR(200) PRIMARY KEY, QUANTITY DOUBLE, PRICE DOUBLE, NOTIONAL DOUBLE, ACCOUNT VARCHAR(200), ALLOCATION_DATE DATE, STATUS VARCHAR(200), COMMISSION DOUBLE, FEES DOUBLE, SETTLEMENT_DATE DATE, CURRENCY VARCHAR(200), IS_CONFIRMED BIT, TRADE_ID VARCHAR(200), BOOK_ID VARCHAR(200))
    Table TRADE_LIFECYCLE_EVENT (EVENT_ID VARCHAR(200) PRIMARY KEY, EVENT_TYPE VARCHAR(200), EVENT_DATE TIMESTAMP, REASON VARCHAR(200), PREVIOUS_VALUE VARCHAR(200), NEW_VALUE VARCHAR(200), FIELD_CHANGED VARCHAR(200), PERFORMED_BY VARCHAR(200), IS_SYSTEM_GENERATED BIT, APPROVED_BY VARCHAR(200), APPROVAL_DATE TIMESTAMP, COMMENT VARCHAR(200), TRADE_ID VARCHAR(200))
    Table BLOCK (BLOCK_ID VARCHAR(200) PRIMARY KEY, BLOCK_DATE DATE, TOTAL_QUANTITY DOUBLE, AVERAGE_PRICE DOUBLE, TOTAL_NOTIONAL DOUBLE, NUMBER_OF_ALLOCATIONS INTEGER, STATUS VARCHAR(200), SIDE VARCHAR(200), CURRENCY VARCHAR(200), BROKER VARCHAR(200), IS_COMPLETE BIT, COMPLETED_TIME TIMESTAMP)
    Table ORDER_ROUTE (ROUTE_ID VARCHAR(200) PRIMARY KEY, ROUTE_DATE TIMESTAMP, DESTINATION VARCHAR(200), ROUTE_QUANTITY DOUBLE, ROUTED_PRICE DOUBLE, STATUS VARCHAR(200), ROUTE_TYPE VARCHAR(200), PRIORITY INTEGER, LATENCY_MS INTEGER, IS_SMART_ROUTED BIT, REJECT_REASON VARCHAR(200), BROKER VARCHAR(200), ORDER_ID VARCHAR(200))
    Table FILL_DETAIL (FILL_ID VARCHAR(200) PRIMARY KEY, FILL_TIME TIMESTAMP, FILL_QUANTITY DOUBLE, FILL_PRICE DOUBLE, VENUE VARCHAR(200), COUNTERPARTY_ID VARCHAR(200), LIQUIDITY_TYPE VARCHAR(200), IS_MIDPOINT BIT, IS_DARK_POOL BIT, SEQUENCE_NUMBER INTEGER, FEES DOUBLE, REBATE DOUBLE, EXECUTION_ID VARCHAR(200))
    Table TRADE_CORRECTION (CORRECTION_ID VARCHAR(200) PRIMARY KEY, CORRECTION_DATE TIMESTAMP, CORRECTION_TYPE VARCHAR(200), ORIGINAL_VALUE VARCHAR(200), CORRECTED_VALUE VARCHAR(200), FIELD_CORRECTED VARCHAR(200), REASON VARCHAR(200), PERFORMED_BY VARCHAR(200), APPROVED_BY VARCHAR(200), STATUS VARCHAR(200), IS_REVERSED BIT, TRADE_ID VARCHAR(200))
    Table AVERAGE_PRICE_TRADE (AVG_TRADE_ID VARCHAR(200) PRIMARY KEY, AVG_PRICE DOUBLE, TOTAL_QUANTITY DOUBLE, TOTAL_NOTIONAL DOUBLE, NUMBER_OF_FILLS INTEGER, VWAP_PRICE DOUBLE, TWAP_PRICE DOUBLE, ARRIVAL_PRICE DOUBLE, CLOSE_PRICE DOUBLE, TRADE_DATE DATE, SIDE VARCHAR(200), CURRENCY VARCHAR(200))

    Join Order_Trade(TRADE.ORDER_ID = TRADE_ORDER.ORDER_ID)
    Join Order_Execution(EXECUTION.ORDER_ID = TRADE_ORDER.ORDER_ID)
    Join Trade_Allocation(ALLOCATION.TRADE_ID = TRADE.TRADE_ID)
    Join Trade_LifecycleEvent(TRADE_LIFECYCLE_EVENT.TRADE_ID = TRADE.TRADE_ID)
    Join Trade_Block(TRADE.BLOCK_ID = BLOCK.BLOCK_ID)
    Join Order_OrderRoute(ORDER_ROUTE.ORDER_ID = TRADE_ORDER.ORDER_ID)
    Join Execution_FillDetail(FILL_DETAIL.EXECUTION_ID = EXECUTION.EXECUTION_ID)
    Join Trade_TradeCorrection(TRADE_CORRECTION.TRADE_ID = TRADE.TRADE_ID)
    Join Trade_AveragePriceTrade(TRADE.AVG_PRICE_TRADE_ID = AVERAGE_PRICE_TRADE.AVG_TRADE_ID)

    // ---- from 37-pnl-store.pure ----
    Table DAILY_PN_L (PNL_ID VARCHAR(200) PRIMARY KEY, PNL_DATE DATE, TOTAL_PN_L DOUBLE, REALIZED_PN_L DOUBLE, UNREALIZED_PN_L DOUBLE, NEW_TRADE_PN_L DOUBLE, CARRY_PN_L DOUBLE, FX_PN_L DOUBLE, COMMISSIONS DOUBLE, FEES DOUBLE, CURRENCY VARCHAR(200), IS_OFFICIAL BIT, PUBLISHED_TIME TIMESTAMP, VERSION INTEGER, MTD_PN_L_ID VARCHAR(200), BOOK_ID VARCHAR(200), DESK_ID VARCHAR(200), TRADER_ID VARCHAR(200))
    Table PN_LATTRIBUTION (ATTRIBUTION_ID VARCHAR(200) PRIMARY KEY, ATTRIBUTION_DATE DATE, CATEGORY VARCHAR(200), AMOUNT DOUBLE, CURRENCY VARCHAR(200), RISK_FACTOR VARCHAR(200), MODEL VARCHAR(200), CONFIDENCE DOUBLE, IS_RESIDUAL BIT, EXPLANATION VARCHAR(200), VERSION INTEGER, DAILY_PN_L_ID VARCHAR(200))
    Table HYPOTHETICAL_PN_L (HYPOTHETICAL_ID VARCHAR(200) PRIMARY KEY, SCENARIO_NAME VARCHAR(200), CALC_DATE DATE, HYPOTHETICAL_PN_L DOUBLE, CLEAN_PN_L DOUBLE, DELTA_APPROX DOUBLE, FULL_REVAL DOUBLE, CURRENCY VARCHAR(200), MODEL VARCHAR(200), IS_BACKTEST BIT, BACKTEST_DATE DATE, CONFIDENCE DOUBLE, DAILY_PN_L_ID VARCHAR(200))
    Table PN_LADJUSTMENT (ADJUSTMENT_ID VARCHAR(200) PRIMARY KEY, ADJUSTMENT_DATE DATE, ADJUSTMENT_TYPE VARCHAR(200), AMOUNT DOUBLE, REASON VARCHAR(200), APPROVED_BY VARCHAR(200), APPROVAL_DATE DATE, STATUS VARCHAR(200), CURRENCY VARCHAR(200), ORIGINAL_PN_L DOUBLE, ADJUSTED_PN_L DOUBLE, COMMENT VARCHAR(200), IS_REVERSED BIT, DAILY_PN_L_ID VARCHAR(200))
    Table REVENUE_ALLOCATION (ALLOCATION_ID VARCHAR(200) PRIMARY KEY, ALLOCATION_DATE DATE, REVENUE DOUBLE, ALLOCATION_BASIS VARCHAR(200), PERCENTAGE DOUBLE, ALLOCATED_AMOUNT DOUBLE, CURRENCY VARCHAR(200), PERIOD VARCHAR(200), IS_MANUAL_OVERRIDE BIT, OVERRIDE_BY VARCHAR(200), COMMENT VARCHAR(200), DAILY_PN_L_ID VARCHAR(200))
    Table ACCRUAL_ENTRY (ACCRUAL_ID VARCHAR(200) PRIMARY KEY, ACCRUAL_DATE DATE, ACCRUAL_TYPE VARCHAR(200), AMOUNT DOUBLE, START_DATE DATE, END_DATE DATE, DAY_COUNT INTEGER, RATE DOUBLE, CURRENCY VARCHAR(200), STATUS VARCHAR(200), IS_REVERSED BIT, REVERSAL_DATE DATE, DAILY_PN_L_ID VARCHAR(200))
    Table VALUATION_ADJUSTMENT (ADJUSTMENT_ID VARCHAR(200) PRIMARY KEY, ADJUSTMENT_TYPE VARCHAR(200), AMOUNT DOUBLE, CALC_DATE DATE, METHODOLOGY VARCHAR(200), CURRENCY VARCHAR(200), CONFIDENCE_LEVEL DOUBLE, PREVIOUS_AMOUNT DOUBLE, CHANGE_AMOUNT DOUBLE, APPROVED_BY VARCHAR(200), STATUS VARCHAR(200), IS_ACTIVE BIT, DAILY_PN_L_ID VARCHAR(200))
    Table PN_LEXPLAIN (EXPLAIN_ID VARCHAR(200) PRIMARY KEY, EXPLAIN_DATE DATE, MARKET_MOVE DOUBLE, CARRY_ROLL_DOWN DOUBLE, THETA DOUBLE, NEW_TRADE_IMPACT DOUBLE, CROSS_EFFECT DOUBLE, RESIDUAL DOUBLE, TOTAL_EXPLAINED DOUBLE, UNEXPLAINED DOUBLE, CURRENCY VARCHAR(200), MODEL VARCHAR(200), IS_COMPLETE BIT, DAILY_PN_L_ID VARCHAR(200))
    Table MTDPN_L (MTD_ID VARCHAR(200) PRIMARY KEY, MONTH_START_DATE DATE, AS_OF_DATE DATE, MTD_PN_L DOUBLE, MTD_REALIZED_PN_L DOUBLE, MTD_UNREALIZED_PN_L DOUBLE, MTD_FEES DOUBLE, MTD_COMMISSIONS DOUBLE, CURRENCY VARCHAR(200), TRADING_DAYS INTEGER, BEST_DAY DOUBLE, WORST_DAY DOUBLE, IS_FINALIZED BIT, YTD_PN_L_ID VARCHAR(200))
    Table YTDPN_L (YTD_ID VARCHAR(200) PRIMARY KEY, YEAR_START_DATE DATE, AS_OF_DATE DATE, YTD_PN_L DOUBLE, YTD_REALIZED_PN_L DOUBLE, YTD_UNREALIZED_PN_L DOUBLE, YTD_FEES DOUBLE, YTD_COMMISSIONS DOUBLE, CURRENCY VARCHAR(200), TRADING_DAYS INTEGER, BEST_MONTH DOUBLE, WORST_MONTH DOUBLE, ANNUALIZED_RETURN DOUBLE, IS_FINALIZED BIT)

    Join DailyPnL_PnLAttribution(PN_LATTRIBUTION.DAILY_PN_L_ID = DAILY_PN_L.PNL_ID)
    Join DailyPnL_PnLExplain(PN_LEXPLAIN.DAILY_PN_L_ID = DAILY_PN_L.PNL_ID)
    Join DailyPnL_PnLAdjustment(PN_LADJUSTMENT.DAILY_PN_L_ID = DAILY_PN_L.PNL_ID)
    Join DailyPnL_HypotheticalPnL(HYPOTHETICAL_PN_L.DAILY_PN_L_ID = DAILY_PN_L.PNL_ID)
    Join DailyPnL_AccrualEntry(ACCRUAL_ENTRY.DAILY_PN_L_ID = DAILY_PN_L.PNL_ID)
    Join DailyPnL_ValuationAdjustment(VALUATION_ADJUSTMENT.DAILY_PN_L_ID = DAILY_PN_L.PNL_ID)
    Join DailyPnL_RevenueAllocation(REVENUE_ALLOCATION.DAILY_PN_L_ID = DAILY_PN_L.PNL_ID)
    Join MTDPnL_DailyPnL(DAILY_PN_L.MTD_PN_L_ID = MTDPN_L.MTD_ID)
    Join YTDPnL_MTDPnL(MTDPN_L.YTD_PN_L_ID = YTDPN_L.YTD_ID)

    // ---- from 38-risk-store.pure ----
    Table VA_RRESULT (VAR_ID VARCHAR(200) PRIMARY KEY, CALC_DATE DATE, VAR_AMOUNT DOUBLE, CONFIDENCE_LEVEL DOUBLE, HOLDING_PERIOD INTEGER, METHODOLOGY VARCHAR(200), CURRENCY VARCHAR(200), COMPONENT_VA_R DOUBLE, MARGINAL_VA_R DOUBLE, INCREMENTAL_VA_R DOUBLE, DIVERSIFICATION_BENEFIT DOUBLE, IS_BREACHED BIT, MODEL VARCHAR(200), RUN_TIME TIMESTAMP, PORTFOLIO_ID VARCHAR(200))
    Table GREEKS (GREEKS_ID VARCHAR(200) PRIMARY KEY, CALC_DATE DATE, DELTA DOUBLE, GAMMA DOUBLE, VEGA DOUBLE, THETA DOUBLE, RHO DOUBLE, CHARM DOUBLE, VANNA DOUBLE, VOLGA DOUBLE, CURRENCY VARCHAR(200), MODEL VARCHAR(200), IS_EOD BIT, UNDERLYING_PRICE DOUBLE, INSTRUMENT_ID VARCHAR(200), POSITION_ID VARCHAR(200))
    Table RISK_LIMIT (LIMIT_ID VARCHAR(200) PRIMARY KEY, LIMIT_TYPE VARCHAR(200), LIMIT_AMOUNT DOUBLE, CURRENT_UTILIZATION DOUBLE, UTILIZATION_PCT DOUBLE, CURRENCY VARCHAR(200), EFFECTIVE_DATE DATE, EXPIRY_DATE DATE, STATUS VARCHAR(200), APPROVED_BY VARCHAR(200), APPROVAL_DATE DATE, WARNING_THRESHOLD DOUBLE, HARD_LIMIT DOUBLE, IS_ACTIVE BIT, DESK_ID VARCHAR(200))
    Table LIMIT_BREACH (BREACH_ID VARCHAR(200) PRIMARY KEY, BREACH_DATE TIMESTAMP, BREACH_AMOUNT DOUBLE, SEVERITY VARCHAR(200), STATUS VARCHAR(200), ESCALATION_LEVEL INTEGER, RESOLVED_DATE TIMESTAMP, RESOLVED_BY VARCHAR(200), RESOLUTION VARCHAR(200), PEAK_EXPOSURE DOUBLE, DURATION_MINUTES INTEGER, IS_ACTIVE BIT, RISK_LIMIT_ID VARCHAR(200))
    Table STRESS_SCENARIO (SCENARIO_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), CATEGORY VARCHAR(200), DESCRIPTION VARCHAR(200), CREATED_DATE DATE, CREATED_BY VARCHAR(200), IS_ACTIVE BIT, IS_REGULATORY BIT, SHOCK_MAGNITUDE DOUBLE, HISTORICAL_DATE DATE, RISK_FACTOR_COUNT INTEGER, LAST_RUN_DATE DATE)
    Table STRESS_RESULT (RESULT_ID VARCHAR(200) PRIMARY KEY, CALC_DATE DATE, STRESSED_PN_L DOUBLE, STRESSED_VA_R DOUBLE, BASELINE_PN_L DOUBLE, DELTA_FROM_BASELINE DOUBLE, CURRENCY VARCHAR(200), MODEL VARCHAR(200), RUN_TIME TIMESTAMP, IS_BREACHED BIT, BREACH_AMOUNT DOUBLE, CONFIDENCE DOUBLE, SCENARIO_ID VARCHAR(200))
    Table SENSITIVITY_RESULT (SENSITIVITY_ID VARCHAR(200) PRIMARY KEY, SENSITIVITY_TYPE VARCHAR(200), RISK_FACTOR VARCHAR(200), SENSITIVITY_VALUE DOUBLE, CALC_DATE DATE, TENOR VARCHAR(200), CURRENCY VARCHAR(200), MODEL VARCHAR(200), BUMP_SIZE DOUBLE, PREVIOUS_VALUE DOUBLE, CHANGE_AMOUNT DOUBLE, IS_SIGNIFICANT BIT, RISK_FACTOR_ID VARCHAR(200))
    Table RISK_FACTOR (FACTOR_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), FACTOR_TYPE VARCHAR(200), ASSET_CLASS VARCHAR(200), CURRENCY VARCHAR(200), TENOR VARCHAR(200), CURRENT_LEVEL DOUBLE, PREVIOUS_LEVEL DOUBLE, DAILY_CHANGE DOUBLE, VOLATILITY DOUBLE, SOURCE VARCHAR(200), LAST_UPDATED TIMESTAMP, IS_ACTIVE BIT)
    Table EXPOSURE_SNAPSHOT (SNAPSHOT_ID VARCHAR(200) PRIMARY KEY, SNAPSHOT_DATE DATE, GROSS_EXPOSURE DOUBLE, NET_EXPOSURE DOUBLE, LONG_EXPOSURE DOUBLE, SHORT_EXPOSURE DOUBLE, LEVERAGE DOUBLE, CURRENCY VARCHAR(200), ASSET_CLASS VARCHAR(200), REGION VARCHAR(200), IS_EOD BIT, RUN_TIME TIMESTAMP, VAR_RESULT_ID VARCHAR(200))
    Table CONCENTRATION_RISK (CONCENTRATION_ID VARCHAR(200) PRIMARY KEY, CALC_DATE DATE, DIMENSION_TYPE VARCHAR(200), DIMENSION_VALUE VARCHAR(200), EXPOSURE DOUBLE, EXPOSURE_PCT DOUBLE, LIMIT DOUBLE, IS_BREACHED BIT, CURRENCY VARCHAR(200), RANK INTEGER, PREVIOUS_EXPOSURE DOUBLE, CHANGE_AMOUNT DOUBLE, VAR_RESULT_ID VARCHAR(200))

    Join RiskLimit_LimitBreach(LIMIT_BREACH.RISK_LIMIT_ID = RISK_LIMIT.LIMIT_ID)
    Join StressScenario_StressResult(STRESS_RESULT.SCENARIO_ID = STRESS_SCENARIO.SCENARIO_ID)
    Join RiskFactor_SensitivityResult(SENSITIVITY_RESULT.RISK_FACTOR_ID = RISK_FACTOR.FACTOR_ID)
    Join VaRResult_ExposureSnapshot(EXPOSURE_SNAPSHOT.VAR_RESULT_ID = VA_RRESULT.VAR_ID)
    Join VaRResult_ConcentrationRisk(CONCENTRATION_RISK.VAR_RESULT_ID = VA_RRESULT.VAR_ID)

    // ---- from 39-settlement-store.pure ----
    Table SETTLEMENT (SETTLEMENT_ID VARCHAR(200) PRIMARY KEY, SETTLEMENT_DATE DATE, AMOUNT DOUBLE, CURRENCY VARCHAR(200), STATUS VARCHAR(200), SETTLED_DATE DATE, SETTLEMENT_METHOD VARCHAR(200), CUSTODIAN VARCHAR(200), DEPOSITORY VARCHAR(200), SETTLED_AMOUNT DOUBLE, FAIL_REASON VARCHAR(200), IS_PARTIAL BIT, PRIORITY INTEGER, LAST_UPDATED TIMESTAMP, NETTING_ID VARCHAR(200), COUNTERPARTY_ID VARCHAR(200), TRADE_ID VARCHAR(200))
    Table SETTLEMENT_INSTRUCTION (INSTRUCTION_ID VARCHAR(200) PRIMARY KEY, INSTRUCTION_TYPE VARCHAR(200), CREATED_DATE TIMESTAMP, EFFECTIVE_DATE DATE, BENEFICIARY_ACCOUNT VARCHAR(200), BENEFICIARY_NAME VARCHAR(200), INTERMEDIARY_BANK VARCHAR(200), SWIFT_CODE VARCHAR(200), IBAN VARCHAR(200), CURRENCY VARCHAR(200), IS_STANDING BIT, STATUS VARCHAR(200), APPROVED_BY VARCHAR(200), SETTLEMENT_ID VARCHAR(200))
    Table CASH_SETTLEMENT (CASH_SETTLEMENT_ID VARCHAR(200) PRIMARY KEY, PAYMENT_DATE DATE, AMOUNT DOUBLE, CURRENCY VARCHAR(200), PAYMENT_METHOD VARCHAR(200), DEBIT_ACCOUNT VARCHAR(200), CREDIT_ACCOUNT VARCHAR(200), STATUS VARCHAR(200), VALUE_DATE DATE, IS_NETTING BIT, REFERENCE VARCHAR(200), CONFIRMED_DATE TIMESTAMP, SETTLEMENT_ID VARCHAR(200), NOSTRO_ACCOUNT_ID VARCHAR(200))
    Table SECURITIES_SETTLEMENT (SEC_SETTLEMENT_ID VARCHAR(200) PRIMARY KEY, SETTLEMENT_DATE DATE, QUANTITY DOUBLE, DELIVERY_TYPE VARCHAR(200), CUSTODIAN VARCHAR(200), DEPOSITORY VARCHAR(200), STATUS VARCHAR(200), MATCH_STATUS VARCHAR(200), IS_DELIVERY BIT, SETTLED_QUANTITY DOUBLE, FAILED_QUANTITY DOUBLE, LAST_UPDATED TIMESTAMP, PRIORITY VARCHAR(200), SETTLEMENT_ID VARCHAR(200))
    Table SETTLEMENT_FAIL (FAIL_ID VARCHAR(200) PRIMARY KEY, FAIL_DATE DATE, FAIL_REASON VARCHAR(200), ORIGINAL_SETTLEMENT_DATE DATE, REVISED_SETTLEMENT_DATE DATE, AMOUNT DOUBLE, CURRENCY VARCHAR(200), PENALTY_AMOUNT DOUBLE, STATUS VARCHAR(200), AGE_IN_DAYS INTEGER, IS_RESOLVED BIT, RESOLVED_DATE DATE, ESCALATION_LEVEL INTEGER, SETTLEMENT_ID VARCHAR(200))
    Table CORPORATE_ACTION (CORP_ACTION_ID VARCHAR(200) PRIMARY KEY, ACTION_TYPE VARCHAR(200), EX_DATE DATE, RECORD_DATE DATE, PAYMENT_DATE DATE, RATIO DOUBLE, CASH_AMOUNT DOUBLE, CURRENCY VARCHAR(200), STATUS VARCHAR(200), IS_MANDATORY BIT, ELECTION_DEADLINE DATE, DESCRIPTION VARCHAR(200), ANNOUNCEMENT_DATE DATE, INSTRUMENT_ID VARCHAR(200))
    Table CORPORATE_ACTION_ELECTION (ELECTION_ID VARCHAR(200) PRIMARY KEY, ELECTION_DATE DATE, ELECTION_TYPE VARCHAR(200), QUANTITY DOUBLE, CASH_AMOUNT DOUBLE, STATUS VARCHAR(200), SUBMITTED_BY VARCHAR(200), APPROVED_BY VARCHAR(200), IS_DEFAULT BIT, DEADLINE DATE, CURRENCY VARCHAR(200), CORPORATE_ACTION_ID VARCHAR(200))
    Table SETTLEMENT_LADDER (LADDER_ID VARCHAR(200) PRIMARY KEY, LADDER_DATE DATE, T0_AMOUNT DOUBLE, T1_AMOUNT DOUBLE, T2_AMOUNT DOUBLE, T3_PLUS_AMOUNT DOUBLE, TOTAL_AMOUNT DOUBLE, CURRENCY VARCHAR(200), DIRECTION VARCHAR(200), ASSET_TYPE VARCHAR(200), IS_PROJECTED BIT, LAST_UPDATED TIMESTAMP)
    Table NOSTRO_ACCOUNT (ACCOUNT_ID VARCHAR(200) PRIMARY KEY, ACCOUNT_NAME VARCHAR(200), CURRENCY VARCHAR(200), BANK VARCHAR(200), SWIFT_CODE VARCHAR(200), ACCOUNT_NUMBER VARCHAR(200), BALANCE DOUBLE, BALANCE_DATE DATE, IS_ACTIVE BIT, OPEN_DATE DATE, DAILY_LIMIT DOUBLE, DESCRIPTION VARCHAR(200))
    Table SETTLEMENT_NETTING (NETTING_ID VARCHAR(200) PRIMARY KEY, NETTING_DATE DATE, GROSS_PAY_AMOUNT DOUBLE, GROSS_RECEIVE_AMOUNT DOUBLE, NET_AMOUNT DOUBLE, CURRENCY VARCHAR(200), TRADE_COUNT INTEGER, STATUS VARCHAR(200), IS_MULTILATERAL BIT, NET_DIRECTION VARCHAR(200), SAVINGS_AMOUNT DOUBLE)

    Join Settlement_Instruction(SETTLEMENT_INSTRUCTION.SETTLEMENT_ID = SETTLEMENT.SETTLEMENT_ID)
    Join Settlement_CashSettlement(CASH_SETTLEMENT.SETTLEMENT_ID = SETTLEMENT.SETTLEMENT_ID)
    Join Settlement_SecuritiesSettlement(SECURITIES_SETTLEMENT.SETTLEMENT_ID = SETTLEMENT.SETTLEMENT_ID)
    Join Settlement_SettlementFail(SETTLEMENT_FAIL.SETTLEMENT_ID = SETTLEMENT.SETTLEMENT_ID)
    Join CorporateAction_Election(CORPORATE_ACTION_ELECTION.CORPORATE_ACTION_ID = CORPORATE_ACTION.CORP_ACTION_ID)
    Join Settlement_Netting(SETTLEMENT.NETTING_ID = SETTLEMENT_NETTING.NETTING_ID)
    Join CashSettlement_NostroAccount(CASH_SETTLEMENT.NOSTRO_ACCOUNT_ID = NOSTRO_ACCOUNT.ACCOUNT_ID)

    // ---- from 40-ops-store.pure ----
    Table CONFIRMATION (CONFIRM_ID VARCHAR(200) PRIMARY KEY, STATUS VARCHAR(200), SENT_DATE DATE, AFFIRMED_DATE DATE, CONFIRM_METHOD VARCHAR(200), AFFIRMED_BY VARCHAR(200), DAYS_OUTSTANDING INTEGER, IS_OVERDUE BIT, TEMPLATE_TYPE VARCHAR(200), VERSION INTEGER, LAST_SENT_TIME TIMESTAMP, COUNTERPARTY_REF VARCHAR(200), IS_ELECTRONIC BIT, TRADE_ID VARCHAR(200))
    Table NETTING_SET (NETTING_SET_ID VARCHAR(200) PRIMARY KEY, AGREEMENT_TYPE VARCHAR(200), EFFECTIVE_DATE DATE, TERMINATION_DATE DATE, CURRENCY VARCHAR(200), IS_ACTIVE BIT, MEMBER_COUNT INTEGER, LAST_NETTING_DATE DATE, NETTING_FREQUENCY VARCHAR(200), THRESHOLD DOUBLE, DESCRIPTION VARCHAR(200))
    Table NETTING_RESULT (RESULT_ID VARCHAR(200) PRIMARY KEY, NETTING_DATE DATE, GROSS_AMOUNT DOUBLE, NET_AMOUNT DOUBLE, TRADE_COUNT INTEGER, SAVINGS_AMOUNT DOUBLE, SAVINGS_PCT DOUBLE, CURRENCY VARCHAR(200), STATUS VARCHAR(200), IS_FINALIZED BIT, RUN_TIME TIMESTAMP, VERSION INTEGER, NETTING_SET_ID VARCHAR(200))
    Table TRADE_EXCEPTION (EXCEPTION_ID VARCHAR(200) PRIMARY KEY, EXCEPTION_TYPE VARCHAR(200), SEVERITY VARCHAR(200), DETECTED_DATE TIMESTAMP, DESCRIPTION VARCHAR(200), STATUS VARCHAR(200), ASSIGNED_TO VARCHAR(200), RESOLVED_DATE TIMESTAMP, RESOLVED_BY VARCHAR(200), RESOLUTION VARCHAR(200), AGE_IN_DAYS INTEGER, PRIORITY INTEGER, IS_ESCALATED BIT, INCIDENT_ID VARCHAR(200), TRADE_ID VARCHAR(200))
    Table BREAK_RESOLUTION (RESOLUTION_ID VARCHAR(200) PRIMARY KEY, RESOLUTION_DATE TIMESTAMP, RESOLUTION_TYPE VARCHAR(200), ACTION VARCHAR(200), PERFORMED_BY VARCHAR(200), APPROVED_BY VARCHAR(200), COMMENT VARCHAR(200), IS_AUTO_RESOLVED BIT, TIME_TAKEN_MINUTES INTEGER, COST_IMPACT DOUBLE, STATUS VARCHAR(200), TRADE_EXCEPTION_ID VARCHAR(200))
    Table RECONCILIATION_RUN (RUN_ID VARCHAR(200) PRIMARY KEY, RUN_DATE DATE, RUN_TIME TIMESTAMP, SOURCE VARCHAR(200), TARGET VARCHAR(200), TOTAL_ITEMS INTEGER, MATCHED_ITEMS INTEGER, UNMATCHED_ITEMS INTEGER, MATCH_RATE DOUBLE, STATUS VARCHAR(200), DURATION_SECONDS INTEGER, RUN_TYPE VARCHAR(200), IS_AUTOMATIC BIT)
    Table DATA_QUALITY_ISSUE (ISSUE_ID VARCHAR(200) PRIMARY KEY, ISSUE_TYPE VARCHAR(200), SEVERITY VARCHAR(200), DETECTED_DATE TIMESTAMP, SOURCE VARCHAR(200), FIELD_NAME VARCHAR(200), EXPECTED_VALUE VARCHAR(200), ACTUAL_VALUE VARCHAR(200), STATUS VARCHAR(200), ASSIGNED_TO VARCHAR(200), RESOLVED_DATE TIMESTAMP, IMPACT_SCOPE VARCHAR(200), IS_BLOCKING BIT, RECONCILIATION_RUN_ID VARCHAR(200))
    Table OPERATIONAL_INCIDENT (INCIDENT_ID VARCHAR(200) PRIMARY KEY, INCIDENT_TYPE VARCHAR(200), SEVERITY VARCHAR(200), OCCURRED_DATE TIMESTAMP, DESCRIPTION VARCHAR(200), IMPACT_ASSESSMENT VARCHAR(200), ROOT_CAUSE VARCHAR(200), STATUS VARCHAR(200), ASSIGNED_TO VARCHAR(200), RESOLVED_DATE TIMESTAMP, LOSS_AMOUNT DOUBLE, CURRENCY VARCHAR(200), IS_REPORTABLE BIT)
    Table STPRATE (STP_ID VARCHAR(200) PRIMARY KEY, MEASURE_DATE DATE, TOTAL_TRADES INTEGER, STP_TRADES INTEGER, MANUAL_TRADES INTEGER, STP_RATE DOUBLE, ASSET_CLASS VARCHAR(200), REGION VARCHAR(200), TARGET DOUBLE, IS_ABOVE_TARGET BIT, TREND VARCHAR(200))
    Table PROCESSING_QUEUE (QUEUE_ID VARCHAR(200) PRIMARY KEY, QUEUE_NAME VARCHAR(200), ITEM_COUNT INTEGER, OLDEST_ITEM_DATE TIMESTAMP, PRIORITY VARCHAR(200), STATUS VARCHAR(200), ASSIGNED_TEAM VARCHAR(200), AVG_PROCESSING_TIME_MS INTEGER, SLA_MINUTES INTEGER, IS_BREACHING_SLA BIT, LAST_PROCESSED_TIME TIMESTAMP, THROUGHPUT_PER_HOUR INTEGER)

    Join NettingSet_NettingResult(NETTING_RESULT.NETTING_SET_ID = NETTING_SET.NETTING_SET_ID)
    Join TradeException_BreakResolution(BREAK_RESOLUTION.TRADE_EXCEPTION_ID = TRADE_EXCEPTION.EXCEPTION_ID)
    Join ReconciliationRun_DataQualityIssue(DATA_QUALITY_ISSUE.RECONCILIATION_RUN_ID = RECONCILIATION_RUN.RUN_ID)
    Join OperationalIncident_TradeException(TRADE_EXCEPTION.INCIDENT_ID = OPERATIONAL_INCIDENT.INCIDENT_ID)

    // ---- from 41-collateral-store.pure ----
    Table MARGIN_CALL (MARGIN_CALL_ID VARCHAR(200) PRIMARY KEY, CALL_DATE DATE, CALL_AMOUNT DOUBLE, CURRENCY VARCHAR(200), DIRECTION VARCHAR(200), STATUS VARCHAR(200), RESPONSE_DEADLINE TIMESTAMP, AGREED_AMOUNT DOUBLE, DISPUTED_AMOUNT DOUBLE, CALL_TYPE VARCHAR(200), IS_DISPUTED BIT, DISPUTE_REASON VARCHAR(200), SETTLED_DATE DATE, VERSION INTEGER, AGREEMENT_ID VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table COLLATERAL_AGREEMENT (AGREEMENT_ID VARCHAR(200) PRIMARY KEY, AGREEMENT_TYPE VARCHAR(200), EFFECTIVE_DATE DATE, TERMINATION_DATE DATE, MINIMUM_TRANSFER_AMOUNT DOUBLE, THRESHOLD DOUBLE, INDEPENDENT_AMOUNT DOUBLE, ROUNDING_AMOUNT DOUBLE, CURRENCY VARCHAR(200), ELIGIBLE_COLLATERAL VARCHAR(200), VALUATION_FREQUENCY VARCHAR(200), DISPUTE_RESOLUTION_DAYS INTEGER, IS_ACTIVE BIT, GOVERNING_LAW VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table COLLATERAL_POSTING (POSTING_ID VARCHAR(200) PRIMARY KEY, AMOUNT DOUBLE, COLLATERAL_TYPE VARCHAR(200), POSTING_DATE DATE, DIRECTION VARCHAR(200), STATUS VARCHAR(200), MARKET_VALUE DOUBLE, HAIRCUT DOUBLE, HAIRCUT_PCT DOUBLE, ADJ_VALUE DOUBLE, CURRENCY VARCHAR(200), CUSTODIAN VARCHAR(200), SETTLED_DATE DATE, MARGIN_CALL_ID VARCHAR(200))
    Table COLLATERAL_BALANCE (BALANCE_ID VARCHAR(200) PRIMARY KEY, BALANCE_DATE DATE, POSTED_AMOUNT DOUBLE, RECEIVED_AMOUNT DOUBLE, NET_AMOUNT DOUBLE, REQUIRED_AMOUNT DOUBLE, EXCESS_DEFICIT DOUBLE, CURRENCY VARCHAR(200), COLLATERAL_TYPE VARCHAR(200), IS_DEFICIT BIT, LAST_UPDATED TIMESTAMP, AGREEMENT_ID VARCHAR(200))
    Table HAIRCUT_SCHEDULE (HAIRCUT_ID VARCHAR(200) PRIMARY KEY, COLLATERAL_TYPE VARCHAR(200), HAIRCUT DOUBLE, TENOR VARCHAR(200), CREDIT_RATING VARCHAR(200), CURRENCY VARCHAR(200), EFFECTIVE_DATE DATE, EXPIRY_DATE DATE, IS_REGULATORY BIT, SOURCE VARCHAR(200), AGREEMENT_ID VARCHAR(200))
    Table ELIGIBILITY_RULE (RULE_ID VARCHAR(200) PRIMARY KEY, RULE_NAME VARCHAR(200), COLLATERAL_TYPE VARCHAR(200), MIN_RATING VARCHAR(200), MAX_TENOR VARCHAR(200), MAX_CONCENTRATION DOUBLE, CURRENCY VARCHAR(200), IS_ACTIVE BIT, EFFECTIVE_DATE DATE, DESCRIPTION VARCHAR(200), PRIORITY INTEGER, AGREEMENT_ID VARCHAR(200))
    Table COLLATERAL_SUBSTITUTION (SUBSTITUTION_ID VARCHAR(200) PRIMARY KEY, REQUEST_DATE DATE, OUT_COLLATERAL_TYPE VARCHAR(200), OUT_AMOUNT DOUBLE, IN_COLLATERAL_TYPE VARCHAR(200), IN_AMOUNT DOUBLE, STATUS VARCHAR(200), APPROVED_BY VARCHAR(200), APPROVAL_DATE DATE, REASON VARCHAR(200), CURRENCY VARCHAR(200), IS_APPROVED BIT, MARGIN_CALL_ID VARCHAR(200))
    Table INITIAL_MARGIN (IM_ID VARCHAR(200) PRIMARY KEY, CALC_DATE DATE, IM_AMOUNT DOUBLE, METHODOLOGY VARCHAR(200), CURRENCY VARCHAR(200), IS_REGULATORY BIT, POSTED_AMOUNT DOUBLE, RECEIVED_AMOUNT DOUBLE, EXCESS_DEFICIT DOUBLE, MODEL VARCHAR(200), RUN_TIME TIMESTAMP, VERSION INTEGER, AGREEMENT_ID VARCHAR(200))
    Table VARIATION_MARGIN (VM_ID VARCHAR(200) PRIMARY KEY, CALC_DATE DATE, VM_AMOUNT DOUBLE, MTM DOUBLE, PREVIOUS_MTM DOUBLE, CHANGE_MTM DOUBLE, CURRENCY VARCHAR(200), POSTED_AMOUNT DOUBLE, RECEIVED_AMOUNT DOUBLE, EXCESS_DEFICIT DOUBLE, STATUS VARCHAR(200), LAST_UPDATED TIMESTAMP, AGREEMENT_ID VARCHAR(200))
    Table COLLATERAL_DISPUTE (DISPUTE_ID VARCHAR(200) PRIMARY KEY, DISPUTE_DATE DATE, DISPUTED_AMOUNT DOUBLE, OUR_AMOUNT DOUBLE, THEIR_AMOUNT DOUBLE, REASON VARCHAR(200), STATUS VARCHAR(200), CURRENCY VARCHAR(200), RESOLVED_DATE DATE, RESOLVED_AMOUNT DOUBLE, ESCALATION_LEVEL INTEGER, AGE_IN_DAYS INTEGER, ASSIGNED_TO VARCHAR(200), MARGIN_CALL_ID VARCHAR(200))

    Join MarginCall_Agreement(MARGIN_CALL.AGREEMENT_ID = COLLATERAL_AGREEMENT.AGREEMENT_ID)
    Join MarginCall_Posting(COLLATERAL_POSTING.MARGIN_CALL_ID = MARGIN_CALL.MARGIN_CALL_ID)
    Join Agreement_Balance(COLLATERAL_BALANCE.AGREEMENT_ID = COLLATERAL_AGREEMENT.AGREEMENT_ID)
    Join Agreement_HaircutSchedule(HAIRCUT_SCHEDULE.AGREEMENT_ID = COLLATERAL_AGREEMENT.AGREEMENT_ID)
    Join Agreement_EligibilityRule(ELIGIBILITY_RULE.AGREEMENT_ID = COLLATERAL_AGREEMENT.AGREEMENT_ID)
    Join MarginCall_Substitution(COLLATERAL_SUBSTITUTION.MARGIN_CALL_ID = MARGIN_CALL.MARGIN_CALL_ID)
    Join MarginCall_Dispute(COLLATERAL_DISPUTE.MARGIN_CALL_ID = MARGIN_CALL.MARGIN_CALL_ID)
    Join Agreement_InitialMargin(INITIAL_MARGIN.AGREEMENT_ID = COLLATERAL_AGREEMENT.AGREEMENT_ID)
    Join Agreement_VariationMargin(VARIATION_MARGIN.AGREEMENT_ID = COLLATERAL_AGREEMENT.AGREEMENT_ID)

    // ---- from 42-sales-store.pure ----
    Table SALES_CREDIT (CREDIT_ID VARCHAR(200) PRIMARY KEY, CREDIT_AMOUNT DOUBLE, CREDIT_DATE DATE, CREDIT_TYPE VARCHAR(200), CURRENCY VARCHAR(200), SPLIT_PCT DOUBLE, STATUS VARCHAR(200), IS_OVERRIDE BIT, OVERRIDE_BY VARCHAR(200), ORIGINAL_AMOUNT DOUBLE, REGION VARCHAR(200), PRODUCT_AREA VARCHAR(200), SALES_PERSON_ID VARCHAR(200), TRADE_ID VARCHAR(200))
    Table SALES_PERSON (SALES_PERSON_ID VARCHAR(200) PRIMARY KEY, FIRST_NAME VARCHAR(200), LAST_NAME VARCHAR(200), EMAIL VARCHAR(200), REGION VARCHAR(200), TIER VARCHAR(200), HIRE_DATE DATE, IS_ACTIVE BIT, REVENUE_YTD DOUBLE, REVENUE_TARGET DOUBLE, CLIENT_COUNT INTEGER, SPECIALIZATION VARCHAR(200), PHONE VARCHAR(200), TERRITORY_ID VARCHAR(200), COMMISSION_STRUCTURE_ID VARCHAR(200), DESK_ID VARCHAR(200))
    Table CLIENT_COVERAGE (COVERAGE_ID VARCHAR(200) PRIMARY KEY, ROLE VARCHAR(200), START_DATE DATE, END_DATE DATE, PRODUCT_AREA VARCHAR(200), REGION VARCHAR(200), IS_ACTIVE BIT, COVERAGE_TYPE VARCHAR(200), REVENUE_SPLIT DOUBLE, LAST_CONTACT_DATE DATE, NOTES VARCHAR(200), SALES_PERSON_ID VARCHAR(200), COUNTERPARTY_ID VARCHAR(200))
    Table SALES_PIPELINE (PIPELINE_ID VARCHAR(200) PRIMARY KEY, DEAL_NAME VARCHAR(200), STAGE VARCHAR(200), EXPECTED_REVENUE DOUBLE, PROBABILITY DOUBLE, EXPECTED_CLOSE_DATE DATE, CURRENCY VARCHAR(200), PRODUCT_TYPE VARCHAR(200), CREATED_DATE DATE, LAST_UPDATED TIMESTAMP, IS_WON BIT, LOST_REASON VARCHAR(200), COMPETITOR_NAME VARCHAR(200), SALES_PERSON_ID VARCHAR(200))
    Table CLIENT_INTERACTION (INTERACTION_ID VARCHAR(200) PRIMARY KEY, INTERACTION_DATE TIMESTAMP, INTERACTION_TYPE VARCHAR(200), SUBJECT VARCHAR(200), DURATION INTEGER, OUTCOME VARCHAR(200), FOLLOW_UP_DATE DATE, ATTENDEES INTEGER, IS_FOLLOW_UP_COMPLETE BIT, CHANNEL VARCHAR(200), SENTIMENT VARCHAR(200), NOTES VARCHAR(200), SALES_PERSON_ID VARCHAR(200))
    Table REVENUE_BUDGET (BUDGET_ID VARCHAR(200) PRIMARY KEY, FISCAL_YEAR INTEGER, QUARTER INTEGER, BUDGET_AMOUNT DOUBLE, ACTUAL_AMOUNT DOUBLE, VARIANCE_AMOUNT DOUBLE, VARIANCE_PCT DOUBLE, CURRENCY VARCHAR(200), REGION VARCHAR(200), PRODUCT_AREA VARCHAR(200), IS_FINALIZED BIT, LAST_UPDATED TIMESTAMP, SALES_PERSON_ID VARCHAR(200))
    Table CLIENT_TIER (TIER_ID VARCHAR(200) PRIMARY KEY, TIER_NAME VARCHAR(200), MIN_REVENUE DOUBLE, MAX_REVENUE DOUBLE, SERVICE_LEVEL VARCHAR(200), DISCOUNT_PCT DOUBLE, IS_ACTIVE BIT, DESCRIPTION VARCHAR(200), REVIEW_FREQUENCY VARCHAR(200), LAST_REVIEW_DATE DATE)
    Table SALES_TERRITORY (TERRITORY_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), REGION VARCHAR(200), COUNTRIES VARCHAR(200), HEADCOUNT INTEGER, REVENUE_TARGET DOUBLE, ACTUAL_REVENUE DOUBLE, IS_ACTIVE BIT, DESCRIPTION VARCHAR(200), MANAGER_NAME VARCHAR(200))
    Table COMMISSION_STRUCTURE (STRUCTURE_ID VARCHAR(200) PRIMARY KEY, STRUCTURE_NAME VARCHAR(200), COMMISSION_PCT DOUBLE, MIN_DEAL_SIZE DOUBLE, MAX_DEAL_SIZE DOUBLE, PRODUCT_AREA VARCHAR(200), EFFECTIVE_DATE DATE, EXPIRY_DATE DATE, IS_ACTIVE BIT, ACCELERATOR_PCT DOUBLE, CAP_AMOUNT DOUBLE, CURRENCY VARCHAR(200))
    Table CLIENT_ACTIVITY (ACTIVITY_ID VARCHAR(200) PRIMARY KEY, ACTIVITY_DATE DATE, ACTIVITY_TYPE VARCHAR(200), TRADE_COUNT INTEGER, TRADE_VOLUME DOUBLE, REVENUE DOUBLE, COMMISSION DOUBLE, PRODUCT_AREA VARCHAR(200), IS_ACTIVE BIT, CURRENCY VARCHAR(200), REGION VARCHAR(200), COVERAGE_ID VARCHAR(200))

    Join SalesCredit_SalesPerson(SALES_CREDIT.SALES_PERSON_ID = SALES_PERSON.SALES_PERSON_ID)
    Join SalesPerson_ClientCoverage(CLIENT_COVERAGE.SALES_PERSON_ID = SALES_PERSON.SALES_PERSON_ID)
    Join SalesPerson_Pipeline(SALES_PIPELINE.SALES_PERSON_ID = SALES_PERSON.SALES_PERSON_ID)
    Join SalesPerson_ClientInteraction(CLIENT_INTERACTION.SALES_PERSON_ID = SALES_PERSON.SALES_PERSON_ID)
    Join SalesPerson_RevenueBudget(REVENUE_BUDGET.SALES_PERSON_ID = SALES_PERSON.SALES_PERSON_ID)
    Join SalesPerson_Territory(SALES_PERSON.TERRITORY_ID = SALES_TERRITORY.TERRITORY_ID)
    Join SalesPerson_Commission(SALES_PERSON.COMMISSION_STRUCTURE_ID = COMMISSION_STRUCTURE.STRUCTURE_ID)
    Join ClientActivity_ClientCoverage(CLIENT_ACTIVITY.COVERAGE_ID = CLIENT_COVERAGE.COVERAGE_ID)

    // ---- from 43-regulatory-store.pure ----
    Table TRADE_REPORT (REPORT_ID VARCHAR(200) PRIMARY KEY, REGIME VARCHAR(200), STATUS VARCHAR(200), SUBMISSION_DATE TIMESTAMP, REPORT_TYPE VARCHAR(200), UTI VARCHAR(200), USI VARCHAR(200), REPORTING_ENTITY VARCHAR(200), REPORTING_COUNTERPARTY VARCHAR(200), REJECT_REASON VARCHAR(200), RETRY_COUNT INTEGER, IS_LATE_REPORT BIT, DUE_DATE DATE, TRADE_ID VARCHAR(200))
    Table TRANSACTION_COST (TCA_ID VARCHAR(200) PRIMARY KEY, COST_BPS DOUBLE, IMPLEMENTATION_SHORTFALL DOUBLE, MARKET_IMPACT_BPS DOUBLE, BENCHMARK VARCHAR(200), ANALYSIS_DATE DATE, ARRIVAL_PRICE DOUBLE, EXECUTION_PRICE DOUBLE, VWAP_PRICE DOUBLE, CLOSING_PRICE DOUBLE, CURRENCY VARCHAR(200), IS_BEST_EXECUTION BIT, MODEL VARCHAR(200), EXECUTION_ID VARCHAR(200))
    Table REGULATORY_FILING (FILING_ID VARCHAR(200) PRIMARY KEY, FILING_TYPE VARCHAR(200), REGIME VARCHAR(200), FILING_DATE DATE, DUE_DATE DATE, STATUS VARCHAR(200), SUBMITTED_BY VARCHAR(200), APPROVED_BY VARCHAR(200), IS_AMENDMENT BIT, PREVIOUS_FILING_ID VARCHAR(200), REFERENCE_NUMBER VARCHAR(200), PERIOD_START DATE, PERIOD_END DATE)
    Table COMPLIANCE_ALERT (ALERT_ID VARCHAR(200) PRIMARY KEY, ALERT_TYPE VARCHAR(200), SEVERITY VARCHAR(200), TRIGGERED_DATE TIMESTAMP, DESCRIPTION VARCHAR(200), STATUS VARCHAR(200), ASSIGNED_TO VARCHAR(200), RESOLVED_DATE TIMESTAMP, RESOLUTION VARCHAR(200), IS_FALSE_POSITIVE BIT, RULE_ID VARCHAR(200), ESCALATION_LEVEL INTEGER, DUE_DATE DATE)
    Table SANCTIONS_SCREENING (SCREENING_ID VARCHAR(200) PRIMARY KEY, SCREENING_DATE TIMESTAMP, SCREENING_TYPE VARCHAR(200), LIST_TYPE VARCHAR(200), RESULT VARCHAR(200), MATCH_SCORE DOUBLE, MATCHED_NAME VARCHAR(200), STATUS VARCHAR(200), REVIEWED_BY VARCHAR(200), REVIEW_DATE TIMESTAMP, IS_FALSE_POSITIVE BIT, PROVIDER VARCHAR(200), COMPLIANCE_ALERT_ID VARCHAR(200))
    Table BEST_EXECUTION_REPORT (REPORT_ID VARCHAR(200) PRIMARY KEY, REPORT_DATE DATE, VENUE VARCHAR(200), ASSET_CLASS VARCHAR(200), EXECUTION_QUALITY DOUBLE, PRICE_IMPROVEMENT DOUBLE, FILL_RATE DOUBLE, AVG_LATENCY_MS INTEGER, ORDER_COUNT INTEGER, TOTAL_VOLUME DOUBLE, CURRENCY VARCHAR(200), IS_PASSING BIT, PERIOD VARCHAR(200))
    Table POSITION_LIMIT (LIMIT_ID VARCHAR(200) PRIMARY KEY, LIMIT_TYPE VARCHAR(200), REGIME VARCHAR(200), LIMIT_AMOUNT DOUBLE, CURRENT_POSITION DOUBLE, UTILIZATION_PCT DOUBLE, EFFECTIVE_DATE DATE, EXPIRY_DATE DATE, STATUS VARCHAR(200), IS_BREACHED BIT, LAST_CHECKED TIMESTAMP, REPORTING_THRESHOLD DOUBLE)
    Table TRADE_REPORT_STATUS (STATUS_ID VARCHAR(200) PRIMARY KEY, STATUS_DATE TIMESTAMP, PREVIOUS_STATUS VARCHAR(200), NEW_STATUS VARCHAR(200), REASON VARCHAR(200), UPDATED_BY VARCHAR(200), IS_AUTOMATIC BIT, TR_REPOSITORY VARCHAR(200), RESPONSE_CODE VARCHAR(200), RESPONSE_MESSAGE VARCHAR(200), TRADE_REPORT_ID VARCHAR(200))
    Table REGULATORY_CAPITAL (CAPITAL_ID VARCHAR(200) PRIMARY KEY, CALC_DATE DATE, RWA_AMOUNT DOUBLE, CAPITAL_REQUIREMENT DOUBLE, TIER1_CAPITAL DOUBLE, TIER2_CAPITAL DOUBLE, TOTAL_CAPITAL DOUBLE, CAPITAL_RATIO DOUBLE, LEVERAGE_RATIO DOUBLE, CURRENCY VARCHAR(200), FRAMEWORK VARCHAR(200), IS_COMPLIANT BIT, FILING_ID VARCHAR(200), LE_ID VARCHAR(200))
    Table LIQUIDITY_COVERAGE (LCR_ID VARCHAR(200) PRIMARY KEY, CALC_DATE DATE, HQLA DOUBLE, NET_CASH_OUTFLOWS DOUBLE, LCR DOUBLE, NSFR DOUBLE, CURRENCY VARCHAR(200), STRESS_SCENARIO VARCHAR(200), IS_COMPLIANT BIT, MINIMUM_REQUIRED DOUBLE, BUFFER DOUBLE, LAST_UPDATED TIMESTAMP, FILING_ID VARCHAR(200))

    Join TradeReport_TradeReportStatus(TRADE_REPORT_STATUS.TRADE_REPORT_ID = TRADE_REPORT.REPORT_ID)
    Join ComplianceAlert_SanctionsScreening(SANCTIONS_SCREENING.COMPLIANCE_ALERT_ID = COMPLIANCE_ALERT.ALERT_ID)
    Join RegulatoryFiling_RegulatoryCapital(REGULATORY_CAPITAL.FILING_ID = REGULATORY_FILING.FILING_ID)
    Join RegulatoryFiling_LiquidityCoverage(LIQUIDITY_COVERAGE.FILING_ID = REGULATORY_FILING.FILING_ID)

    // ---- from 44-marketdata-store.pure ----
    Table MARKET_QUOTE (QUOTE_ID VARCHAR(200) PRIMARY KEY, QUOTE_TIME TIMESTAMP, BID DOUBLE, ASK DOUBLE, MID DOUBLE, LAST DOUBLE, VOLUME DOUBLE, OPEN_PRICE DOUBLE, HIGH_PRICE DOUBLE, LOW_PRICE DOUBLE, CLOSE_PRICE DOUBLE, SOURCE VARCHAR(200), IS_DELAYED BIT, SNAPSHOT_ID VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table FX_RATE (RATE_ID VARCHAR(200) PRIMARY KEY, CURRENCY_PAIR VARCHAR(200), SPOT_RATE DOUBLE, BID_RATE DOUBLE, ASK_RATE DOUBLE, RATE_DATE TIMESTAMP, SOURCE VARCHAR(200), MID_RATE DOUBLE, DAILY_CHANGE DOUBLE, DAILY_CHANGE_PCT DOUBLE, IS_OFFICIAL BIT, FIXING_TIME VARCHAR(200), SNAPSHOT_ID VARCHAR(200), BASE_CURRENCY_CODE VARCHAR(200))
    Table VOLATILITY_SURFACE (SURFACE_ID VARCHAR(200) PRIMARY KEY, SURFACE_DATE DATE, UNDERLYING VARCHAR(200), SURFACE_TYPE VARCHAR(200), ATM_VOL DOUBLE, SKEW25_D DOUBLE, BUTTERFLY25_D DOUBLE, RISK_REVERSAL25_D DOUBLE, SOURCE VARCHAR(200), MODEL VARCHAR(200), IS_EOD BIT, LAST_UPDATED TIMESTAMP)
    Table YIELD_CURVE (CURVE_ID VARCHAR(200) PRIMARY KEY, CURVE_DATE DATE, CURVE_NAME VARCHAR(200), CURRENCY VARCHAR(200), CURVE_TYPE VARCHAR(200), INTERPOLATION VARCHAR(200), POINT_COUNT INTEGER, SOURCE VARCHAR(200), IS_OFFICIAL BIT, OVERNIGHT_RATE DOUBLE, ONE_YEAR_RATE DOUBLE, TEN_YEAR_RATE DOUBLE, THIRTY_YEAR_RATE DOUBLE, LAST_UPDATED TIMESTAMP)
    Table CREDIT_SPREAD (SPREAD_ID VARCHAR(200) PRIMARY KEY, SPREAD_DATE DATE, REFERENCE_ENTITY VARCHAR(200), TENOR VARCHAR(200), SPREAD DOUBLE, PREVIOUS_SPREAD DOUBLE, CHANGE_AMOUNT DOUBLE, SENIORITY VARCHAR(200), CURRENCY VARCHAR(200), SOURCE VARCHAR(200), IS_INVERTED BIT, RECOVERY_RATE DOUBLE)
    Table BENCHMARK_RATE (RATE_ID VARCHAR(200) PRIMARY KEY, RATE_NAME VARCHAR(200), RATE_DATE DATE, RATE_VALUE DOUBLE, PREVIOUS_RATE DOUBLE, CHANGE_AMOUNT DOUBLE, TENOR VARCHAR(200), CURRENCY VARCHAR(200), SOURCE VARCHAR(200), IS_OFFICIAL BIT, FIXING_TIME VARCHAR(200), ADMINISTRATOR VARCHAR(200), YIELD_CURVE_ID VARCHAR(200))
    Table CORPORATE_SPREAD (SPREAD_ID VARCHAR(200) PRIMARY KEY, SPREAD_DATE DATE, SECTOR VARCHAR(200), RATING VARCHAR(200), TENOR VARCHAR(200), SPREAD DOUBLE, BENCHMARK_SPREAD DOUBLE, Z_SPREAD DOUBLE, OAS_SPREAD DOUBLE, CURRENCY VARCHAR(200), SOURCE VARCHAR(200), NUMBER_OF_BONDS INTEGER)
    Table DIVIDEND_FORECAST (FORECAST_ID VARCHAR(200) PRIMARY KEY, EX_DATE DATE, PAYMENT_DATE DATE, AMOUNT DOUBLE, CURRENCY VARCHAR(200), DIVIDEND_TYPE VARCHAR(200), FREQUENCY VARCHAR(200), YIELD DOUBLE, IS_CONFIRMED BIT, SOURCE VARCHAR(200), PREVIOUS_AMOUNT DOUBLE, GROWTH_RATE DOUBLE)
    Table IMPLIED_VOL_POINT (POINT_ID VARCHAR(200) PRIMARY KEY, VOL_DATE DATE, STRIKE DOUBLE, EXPIRY DATE, IMPLIED_VOL DOUBLE, DELTA DOUBLE, MONEYNESS DOUBLE, SOURCE VARCHAR(200), MODEL VARCHAR(200), IS_ATM BIT, BID_VOL DOUBLE, ASK_VOL DOUBLE, SURFACE_ID VARCHAR(200))
    Table MARKET_DATA_SNAPSHOT (SNAPSHOT_ID VARCHAR(200) PRIMARY KEY, SNAPSHOT_TIME TIMESTAMP, SNAPSHOT_TYPE VARCHAR(200), SOURCE VARCHAR(200), ITEM_COUNT INTEGER, IS_COMPLETE BIT, IS_OFFICIAL BIT, STATUS VARCHAR(200), PROCESSING_TIME_MS INTEGER, VERSION INTEGER, DESCRIPTION VARCHAR(200))

    Join VolatilitySurface_ImpliedVolPoint(IMPLIED_VOL_POINT.SURFACE_ID = VOLATILITY_SURFACE.SURFACE_ID)
    Join YieldCurve_BenchmarkRate(BENCHMARK_RATE.YIELD_CURVE_ID = YIELD_CURVE.CURVE_ID)
    Join MarketDataSnapshot_MarketQuote(MARKET_QUOTE.SNAPSHOT_ID = MARKET_DATA_SNAPSHOT.SNAPSHOT_ID)
    Join MarketDataSnapshot_FxRate(FX_RATE.SNAPSHOT_ID = MARKET_DATA_SNAPSHOT.SNAPSHOT_ID)

    // ---- from 45-funding-store.pure ----
    Table CASH_FLOW (CASH_FLOW_ID VARCHAR(200) PRIMARY KEY, AMOUNT DOUBLE, CASH_FLOW_TYPE VARCHAR(200), PAYMENT_DATE DATE, CURRENCY VARCHAR(200), DIRECTION VARCHAR(200), STATUS VARCHAR(200), PROJECTED_DATE DATE, SETTLED_DATE DATE, IS_PROJECTED BIT, SOURCE VARCHAR(200), REFERENCE VARCHAR(200), PRIORITY INTEGER, BOOK_ID VARCHAR(200))
    Table FUNDING_RATE (RATE_ID VARCHAR(200) PRIMARY KEY, RATE_DATE DATE, RATE_BPS DOUBLE, TENOR VARCHAR(200), RATE_TYPE VARCHAR(200), CURRENCY VARCHAR(200), BENCHMARK VARCHAR(200), SPREAD DOUBLE, ALL_IN_RATE DOUBLE, SOURCE VARCHAR(200), IS_ACTIVE BIT, LAST_UPDATED TIMESTAMP)
    Table REPO_TRADE (REPO_ID VARCHAR(200) PRIMARY KEY, TRADE_DATE DATE, START_DATE DATE, END_DATE DATE, REPO_RATE DOUBLE, NOTIONAL DOUBLE, COLLATERAL_TYPE VARCHAR(200), HAIRCUT DOUBLE, DIRECTION VARCHAR(200), STATUS VARCHAR(200), CURRENCY VARCHAR(200), IS_OPEN BIT, MATURITY_TYPE VARCHAR(200), DAILY_ACCRUAL DOUBLE, FUNDING_RATE_ID VARCHAR(200))
    Table SECURITIES_LOAN (LOAN_ID VARCHAR(200) PRIMARY KEY, LOAN_DATE DATE, QUANTITY DOUBLE, LENDING_FEE DOUBLE, REBATE_RATE DOUBLE, COLLATERAL_TYPE VARCHAR(200), COLLATERAL_VALUE DOUBLE, DIRECTION VARCHAR(200), STATUS VARCHAR(200), RETURN_DATE DATE, CURRENCY VARCHAR(200), IS_RECALLABLE BIT, RECALL_DATE DATE, FUNDING_RATE_ID VARCHAR(200))
    Table FUNDING_REQUIREMENT (REQUIREMENT_ID VARCHAR(200) PRIMARY KEY, REQUIREMENT_DATE DATE, AMOUNT DOUBLE, CURRENCY VARCHAR(200), URGENCY VARCHAR(200), SOURCE VARCHAR(200), STATUS VARCHAR(200), DUE_DATE DATE, FILLED_AMOUNT DOUBLE, GAP_AMOUNT DOUBLE, IS_MET_BY_DEADLINE BIT, COST_ESTIMATE DOUBLE, LIQUIDITY_POOL_ID VARCHAR(200))
    Table LIQUIDITY_POOL (POOL_ID VARCHAR(200) PRIMARY KEY, POOL_NAME VARCHAR(200), TOTAL_AMOUNT DOUBLE, AVAILABLE_AMOUNT DOUBLE, RESERVED_AMOUNT DOUBLE, CURRENCY VARCHAR(200), POOL_TYPE VARCHAR(200), IS_ACTIVE BIT, MIN_BALANCE DOUBLE, MAX_CAPACITY DOUBLE, LAST_UPDATED TIMESTAMP)
    Table TREASURY_TRANSACTION (TRANSACTION_ID VARCHAR(200) PRIMARY KEY, TRANSACTION_DATE DATE, AMOUNT DOUBLE, TRANSACTION_TYPE VARCHAR(200), CURRENCY VARCHAR(200), FROM_ACCOUNT VARCHAR(200), TO_ACCOUNT VARCHAR(200), STATUS VARCHAR(200), APPROVED_BY VARCHAR(200), REFERENCE VARCHAR(200), VALUE_DATE DATE, IS_INTERCOMPANY BIT)
    Table FUNDING_COST (COST_ID VARCHAR(200) PRIMARY KEY, COST_DATE DATE, COST_AMOUNT DOUBLE, COST_TYPE VARCHAR(200), CURRENCY VARCHAR(200), RATE_BPS DOUBLE, NOTIONAL DOUBLE, DAY_COUNT INTEGER, ACCRUAL_PERIOD VARCHAR(200), IS_ALLOCATED BIT, ALLOCATED_TO VARCHAR(200), CASH_FLOW_ID VARCHAR(200))
    Table INTERCOMPANY_LOAN (LOAN_ID VARCHAR(200) PRIMARY KEY, LENDER VARCHAR(200), BORROWER VARCHAR(200), PRINCIPAL DOUBLE, INTEREST_RATE DOUBLE, START_DATE DATE, MATURITY_DATE DATE, CURRENCY VARCHAR(200), STATUS VARCHAR(200), OUTSTANDING_BALANCE DOUBLE, ACCRUED_INTEREST DOUBLE, IS_SUBORDINATED BIT)
    Table CASH_FORECAST (FORECAST_ID VARCHAR(200) PRIMARY KEY, FORECAST_DATE DATE, HORIZON VARCHAR(200), PROJECTED_INFLOWS DOUBLE, PROJECTED_OUTFLOWS DOUBLE, NET_CASH_FLOW DOUBLE, OPENING_BALANCE DOUBLE, CLOSING_BALANCE DOUBLE, CURRENCY VARCHAR(200), CONFIDENCE DOUBLE, SCENARIO VARCHAR(200), LAST_UPDATED TIMESTAMP, LIQUIDITY_POOL_ID VARCHAR(200))

    Join CashFlow_FundingCost(FUNDING_COST.CASH_FLOW_ID = CASH_FLOW.CASH_FLOW_ID)
    Join RepoTrade_FundingRate(REPO_TRADE.FUNDING_RATE_ID = FUNDING_RATE.RATE_ID)
    Join SecuritiesLoan_FundingRate(SECURITIES_LOAN.FUNDING_RATE_ID = FUNDING_RATE.RATE_ID)
    Join LiquidityPool_FundingRequirement(FUNDING_REQUIREMENT.LIQUIDITY_POOL_ID = LIQUIDITY_POOL.POOL_ID)
    Join CashForecast_LiquidityPool(CASH_FORECAST.LIQUIDITY_POOL_ID = LIQUIDITY_POOL.POOL_ID)

    // ---- from 46-accounting-store.pure ----
    Table JOURNAL_ENTRY (ENTRY_ID VARCHAR(200) PRIMARY KEY, ENTRY_DATE DATE, POSTING_DATE DATE, DEBIT_AMOUNT DOUBLE, CREDIT_AMOUNT DOUBLE, CURRENCY VARCHAR(200), DESCRIPTION VARCHAR(200), REFERENCE VARCHAR(200), STATUS VARCHAR(200), POSTED_BY VARCHAR(200), APPROVED_BY VARCHAR(200), IS_REVERSAL BIT, REVERSAL_OF VARCHAR(200), PERIOD VARCHAR(200), GL_ACCOUNT_ID VARCHAR(200), COST_CENTER_ID VARCHAR(200))
    Table GENERAL_LEDGER_ACCOUNT (ACCOUNT_ID VARCHAR(200) PRIMARY KEY, ACCOUNT_NAME VARCHAR(200), ACCOUNT_NUMBER VARCHAR(200), ACCOUNT_TYPE VARCHAR(200), NORMAL_BALANCE VARCHAR(200), CURRENCY VARCHAR(200), IS_ACTIVE BIT, PARENT_ACCOUNT_ID VARCHAR(200), LEVEL INTEGER, OPEN_DATE DATE, CLOSE_DATE DATE, DESCRIPTION VARCHAR(200))
    Table SUBLEDGER_ENTRY (SUBLEDGER_ENTRY_ID VARCHAR(200) PRIMARY KEY, ENTRY_DATE DATE, AMOUNT DOUBLE, SUBLEDGER_TYPE VARCHAR(200), REFERENCE VARCHAR(200), CURRENCY VARCHAR(200), STATUS VARCHAR(200), IS_POSTED_TO_GL BIT, POSTING_DATE DATE, SOURCE VARCHAR(200), LINE_NUMBER INTEGER, DESCRIPTION VARCHAR(200), JOURNAL_ENTRY_ID VARCHAR(200))
    Table ACCOUNTING_RULE (RULE_ID VARCHAR(200) PRIMARY KEY, RULE_NAME VARCHAR(200), RULE_TYPE VARCHAR(200), DEBIT_ACCOUNT_ID VARCHAR(200), CREDIT_ACCOUNT_ID VARCHAR(200), EFFECTIVE_DATE DATE, EXPIRY_DATE DATE, IS_ACTIVE BIT, PRIORITY INTEGER, CONDITION VARCHAR(200), DESCRIPTION VARCHAR(200), LAST_MODIFIED TIMESTAMP, GL_ACCOUNT_ID VARCHAR(200))
    Table TRIAL_BALANCE (TRIAL_BALANCE_ID VARCHAR(200) PRIMARY KEY, PERIOD_END DATE, TOTAL_DEBITS DOUBLE, TOTAL_CREDITS DOUBLE, IS_BALANCED BIT, DIFFERENCE DOUBLE, CURRENCY VARCHAR(200), STATUS VARCHAR(200), GENERATED_DATE TIMESTAMP, GENERATED_BY VARCHAR(200), PERIOD VARCHAR(200), VERSION INTEGER)
    Table BALANCE_SHEET (BALANCE_SHEET_ID VARCHAR(200) PRIMARY KEY, REPORT_DATE DATE, TOTAL_ASSETS DOUBLE, TOTAL_LIABILITIES DOUBLE, TOTAL_EQUITY DOUBLE, CURRENCY VARCHAR(200), IS_AUDITED BIT, PERIOD VARCHAR(200), VERSION INTEGER, PREPARED_BY VARCHAR(200), APPROVED_BY VARCHAR(200), STATUS VARCHAR(200), TRIAL_BALANCE_ID VARCHAR(200))
    Table INCOME_STATEMENT (STATEMENT_ID VARCHAR(200) PRIMARY KEY, PERIOD_START DATE, PERIOD_END DATE, TOTAL_REVENUE DOUBLE, TOTAL_EXPENSES DOUBLE, NET_INCOME DOUBLE, CURRENCY VARCHAR(200), IS_AUDITED BIT, VERSION INTEGER, PREPARED_BY VARCHAR(200), APPROVED_BY VARCHAR(200), STATUS VARCHAR(200), TRIAL_BALANCE_ID VARCHAR(200))
    Table COST_ALLOCATION (ALLOCATION_ID VARCHAR(200) PRIMARY KEY, ALLOCATION_DATE DATE, AMOUNT DOUBLE, FROM_COST_CENTER VARCHAR(200), TO_COST_CENTER VARCHAR(200), ALLOCATION_BASIS VARCHAR(200), PERCENTAGE DOUBLE, CURRENCY VARCHAR(200), PERIOD VARCHAR(200), STATUS VARCHAR(200), APPROVED_BY VARCHAR(200), IS_REVERSED BIT)
    Table ACCRUAL_SCHEDULE (SCHEDULE_ID VARCHAR(200) PRIMARY KEY, SCHEDULE_NAME VARCHAR(200), START_DATE DATE, END_DATE DATE, TOTAL_AMOUNT DOUBLE, MONTHLY_AMOUNT DOUBLE, ACCRUED_TO_DATE DOUBLE, REMAINING_AMOUNT DOUBLE, CURRENCY VARCHAR(200), STATUS VARCHAR(200), IS_ACTIVE BIT, FREQUENCY VARCHAR(200))
    Table AUDIT_TRAIL (AUDIT_ID VARCHAR(200) PRIMARY KEY, AUDIT_DATE TIMESTAMP, ACTION VARCHAR(200), TABLE_NAME VARCHAR(200), RECORD_ID VARCHAR(200), FIELD_NAME VARCHAR(200), OLD_VALUE VARCHAR(200), NEW_VALUE VARCHAR(200), PERFORMED_BY VARCHAR(200), IP_ADDRESS VARCHAR(200), IS_SYSTEM_ACTION BIT)

    Join JournalEntry_GLAccount(JOURNAL_ENTRY.GL_ACCOUNT_ID = GENERAL_LEDGER_ACCOUNT.ACCOUNT_ID)
    Join SubledgerEntry_JournalEntry(SUBLEDGER_ENTRY.JOURNAL_ENTRY_ID = JOURNAL_ENTRY.ENTRY_ID)
    Join GLAccount_AccountingRule(ACCOUNTING_RULE.GL_ACCOUNT_ID = GENERAL_LEDGER_ACCOUNT.ACCOUNT_ID)
    Join TrialBalance_BalanceSheet(BALANCE_SHEET.TRIAL_BALANCE_ID = TRIAL_BALANCE.TRIAL_BALANCE_ID)
    Join TrialBalance_IncomeStatement(INCOME_STATEMENT.TRIAL_BALANCE_ID = TRIAL_BALANCE.TRIAL_BALANCE_ID)

    // ---- from 47-clearing-store.pure ----
    Table CLEARING_MEMBER (MEMBER_ID VARCHAR(200) PRIMARY KEY, MEMBER_NAME VARCHAR(200), MEMBER_TYPE VARCHAR(200), STATUS VARCHAR(200), JOIN_DATE DATE, CREDIT_RATING VARCHAR(200), DEFAULT_FUND_CONTRIBUTION DOUBLE, GUARANTEE_FUND_CONTRIBUTION DOUBLE, IS_ACTIVE BIT, JURISDICTION VARCHAR(200), LEI VARCHAR(200), CURRENCY VARCHAR(200), CLEARING_HOUSE_ID VARCHAR(200))
    Table CLEARED_TRADE (CLEARED_TRADE_ID VARCHAR(200) PRIMARY KEY, CLEARING_DATE DATE, ORIGINAL_TRADE_ID VARCHAR(200), NOTIONAL DOUBLE, CLEARING_FEE DOUBLE, STATUS VARCHAR(200), PRODUCT_TYPE VARCHAR(200), CURRENCY VARCHAR(200), MATURITY_DATE DATE, IS_COMPRESSED BIT, COMPRESSION_DATE DATE, NOVATION_DATE DATE, CLEARING_MEMBER_ID VARCHAR(200), TRADE_ID VARCHAR(200))
    Table CCPMARGIN_CALL (CCP_MARGIN_ID VARCHAR(200) PRIMARY KEY, CALL_DATE DATE, INITIAL_MARGIN DOUBLE, VARIATION_MARGIN DOUBLE, ADDITIONAL_MARGIN DOUBLE, TOTAL_MARGIN DOUBLE, CURRENCY VARCHAR(200), STATUS VARCHAR(200), DUE_DATE DATE, PAID_AMOUNT DOUBLE, IS_PAID BIT, CALL_TYPE VARCHAR(200), CLEARING_MEMBER_ID VARCHAR(200))
    Table DEFAULT_FUND (FUND_ID VARCHAR(200) PRIMARY KEY, FUND_NAME VARCHAR(200), TOTAL_SIZE DOUBLE, UTILIZED_AMOUNT DOUBLE, AVAILABLE_AMOUNT DOUBLE, CURRENCY VARCHAR(200), AS_OF_DATE DATE, LAST_ASSESSMENT_DATE DATE, NEXT_ASSESSMENT_DATE DATE, IS_ADEQUATE BIT, TARGET_SIZE DOUBLE, CLEARING_HOUSE_ID VARCHAR(200))
    Table CLEARING_HOUSE (CLEARING_HOUSE_ID VARCHAR(200) PRIMARY KEY, NAME VARCHAR(200), SHORT_NAME VARCHAR(200), JURISDICTION VARCHAR(200), REGULATOR VARCHAR(200), IS_QCCP BIT, PRODUCT_TYPES VARCHAR(200), WEBSITE VARCHAR(200), LEI VARCHAR(200), MEMBER_COUNT INTEGER, DAILY_VOLUME DOUBLE, CURRENCY VARCHAR(200))
    Table NOVATION_REQUEST (NOVATION_ID VARCHAR(200) PRIMARY KEY, REQUEST_DATE DATE, REQUEST_TYPE VARCHAR(200), STATUS VARCHAR(200), STEPPING_IN_PARTY VARCHAR(200), STEPPING_OUT_PARTY VARCHAR(200), REMAINING_PARTY VARCHAR(200), NOTIONAL DOUBLE, CURRENCY VARCHAR(200), EFFECTIVE_DATE DATE, APPROVED_DATE DATE, IS_APPROVED BIT, CLEARED_TRADE_ID VARCHAR(200))
    Table TRADE_COMPRESSION (COMPRESSION_ID VARCHAR(200) PRIMARY KEY, COMPRESSION_DATE DATE, TRADES_BEFORE INTEGER, TRADES_AFTER INTEGER, NOTIONAL_BEFORE DOUBLE, NOTIONAL_AFTER DOUBLE, REDUCTION_PCT DOUBLE, STATUS VARCHAR(200), CYCLE VARCHAR(200), CURRENCY VARCHAR(200), PRODUCT_TYPE VARCHAR(200), IS_SUCCESSFUL BIT)
    Table PORTFOLIO_RECONCILIATION (RECON_ID VARCHAR(200) PRIMARY KEY, RECON_DATE DATE, TOTAL_POSITIONS INTEGER, MATCHED_POSITIONS INTEGER, UNMATCHED_POSITIONS INTEGER, MATCH_RATE DOUBLE, STATUS VARCHAR(200), FREQUENCY VARCHAR(200), DAYS_TO_RESOLVE INTEGER, IS_COMPLETE BIT, NOTIONAL_DIFFERENCE DOUBLE, CURRENCY VARCHAR(200))
    Table CLEARING_FEE (FEE_ID VARCHAR(200) PRIMARY KEY, FEE_DATE DATE, FEE_TYPE VARCHAR(200), AMOUNT DOUBLE, CURRENCY VARCHAR(200), FEE_SCHEDULE VARCHAR(200), VOLUME_DISCOUNT DOUBLE, NET_FEE DOUBLE, STATUS VARCHAR(200), INVOICE_ID VARCHAR(200), IS_PAID BIT, CLEARING_MEMBER_ID VARCHAR(200))
    Table POSITION_TRANSFER (TRANSFER_ID VARCHAR(200) PRIMARY KEY, TRANSFER_DATE DATE, FROM_MEMBER VARCHAR(200), TO_MEMBER VARCHAR(200), NOTIONAL DOUBLE, TRADE_COUNT INTEGER, STATUS VARCHAR(200), REASON VARCHAR(200), APPROVED_BY VARCHAR(200), EFFECTIVE_DATE DATE, CURRENCY VARCHAR(200), IS_REGULATORY BIT)

    Join ClearingHouse_ClearingMember(CLEARING_MEMBER.CLEARING_HOUSE_ID = CLEARING_HOUSE.CLEARING_HOUSE_ID)
    Join ClearingMember_ClearedTrade(CLEARED_TRADE.CLEARING_MEMBER_ID = CLEARING_MEMBER.MEMBER_ID)
    Join ClearingMember_CCPMarginCall(CCPMARGIN_CALL.CLEARING_MEMBER_ID = CLEARING_MEMBER.MEMBER_ID)
    Join ClearingHouse_DefaultFund(DEFAULT_FUND.CLEARING_HOUSE_ID = CLEARING_HOUSE.CLEARING_HOUSE_ID)
    Join ClearingMember_ClearingFee(CLEARING_FEE.CLEARING_MEMBER_ID = CLEARING_MEMBER.MEMBER_ID)
    Join ClearedTrade_NovationRequest(NOVATION_REQUEST.CLEARED_TRADE_ID = CLEARED_TRADE.CLEARED_TRADE_ID)

    // ---- from 48-tax-store.pure ----
    Table TAX_LOT (LOT_ID VARCHAR(200) PRIMARY KEY, ACQUIRE_DATE DATE, QUANTITY DOUBLE, COST_PRICE DOUBLE, COST_BASIS DOUBLE, CURRENT_VALUE DOUBLE, UNREALIZED_GAIN DOUBLE, TAX_METHOD VARCHAR(200), HOLDING_PERIOD VARCHAR(200), IS_OPEN BIT, CLOSE_DATE DATE, CURRENCY VARCHAR(200), POSITION_ID VARCHAR(200))
    Table WITHHOLDING_TAX (WITHHOLDING_ID VARCHAR(200) PRIMARY KEY, PAYMENT_DATE DATE, GROSS_AMOUNT DOUBLE, WITHHOLDING_RATE DOUBLE, WITHHOLDING_AMOUNT DOUBLE, NET_AMOUNT DOUBLE, CURRENCY VARCHAR(200), TAX_JURISDICTION VARCHAR(200), INCOME_TYPE VARCHAR(200), IS_RECLAIMABLE BIT, TREATY_RATE DOUBLE, STATUS VARCHAR(200))
    Table TAX_RECLAIM (RECLAIM_ID VARCHAR(200) PRIMARY KEY, RECLAIM_DATE DATE, RECLAIM_AMOUNT DOUBLE, CURRENCY VARCHAR(200), JURISDICTION VARCHAR(200), STATUS VARCHAR(200), SUBMITTED_DATE DATE, RECEIVED_DATE DATE, RECEIVED_AMOUNT DOUBLE, AGE_IN_DAYS INTEGER, CLAIM_TYPE VARCHAR(200), IS_PARTIAL BIT, WITHHOLDING_TAX_ID VARCHAR(200))
    Table COST_BASIS (COST_BASIS_ID VARCHAR(200) PRIMARY KEY, ORIGINAL_COST DOUBLE, ADJUSTED_COST DOUBLE, ADJUSTMENT_AMOUNT DOUBLE, ADJUSTMENT_REASON VARCHAR(200), ACQUISITION_DATE DATE, METHOD VARCHAR(200), CURRENCY VARCHAR(200), IS_ADJUSTED BIT, WASH_SALE_AMOUNT DOUBLE, ACCRUED_MARKET_DISCOUNT DOUBLE)
    Table TAX_JURISDICTION (JURISDICTION_ID VARCHAR(200) PRIMARY KEY, JURISDICTION_NAME VARCHAR(200), COUNTRY_CODE VARCHAR(200), DOMESTIC_RATE DOUBLE, TREATY_RATE DOUBLE, DIVIDEND_RATE DOUBLE, INTEREST_RATE DOUBLE, CAPITAL_GAINS_RATE DOUBLE, IS_ACTIVE BIT, EFFECTIVE_DATE DATE, LAST_UPDATED TIMESTAMP)
    Table TAX_TREATY (TREATY_ID VARCHAR(200) PRIMARY KEY, COUNTRY1 VARCHAR(200), COUNTRY2 VARCHAR(200), EFFECTIVE_DATE DATE, DIVIDEND_RATE DOUBLE, INTEREST_RATE DOUBLE, ROYALTY_RATE DOUBLE, CAPITAL_GAINS_EXEMPT BIT, IS_ACTIVE BIT, LAST_AMEND_DATE DATE, SOURCE VARCHAR(200), JURISDICTION_ID VARCHAR(200))
    Table TAX_REPORT (REPORT_ID VARCHAR(200) PRIMARY KEY, REPORT_TYPE VARCHAR(200), REPORT_YEAR INTEGER, TOTAL_INCOME DOUBLE, TOTAL_WITHHOLDING DOUBLE, TOTAL_GAINS DOUBLE, TOTAL_LOSSES DOUBLE, NET_TAXABLE DOUBLE, CURRENCY VARCHAR(200), STATUS VARCHAR(200), GENERATED_DATE DATE, FILING_DEADLINE DATE)
    Table CAPITAL_GAIN (GAIN_ID VARCHAR(200) PRIMARY KEY, SALE_DATE DATE, SALE_PROCEEDS DOUBLE, COST_BASIS DOUBLE, GAIN_LOSS DOUBLE, HOLDING_PERIOD VARCHAR(200), IS_SHORT_TERM BIT, WASH_SALE_DISALLOWED DOUBLE, ADJUSTED_GAIN DOUBLE, CURRENCY VARCHAR(200), TAX_RATE DOUBLE, TAX_LOT_ID VARCHAR(200))
    Table TAX_PROVISION (PROVISION_ID VARCHAR(200) PRIMARY KEY, PROVISION_DATE DATE, CURRENT_TAX DOUBLE, DEFERRED_TAX DOUBLE, TOTAL_PROVISION DOUBLE, EFFECTIVE_RATE DOUBLE, STATUTORY_RATE DOUBLE, RATE_DIFFERENCE DOUBLE, CURRENCY VARCHAR(200), JURISDICTION VARCHAR(200), PERIOD VARCHAR(200), STATUS VARCHAR(200), TAX_REPORT_ID VARCHAR(200))
    Table WHTRATE (RATE_ID VARCHAR(200) PRIMARY KEY, JURISDICTION VARCHAR(200), INCOME_TYPE VARCHAR(200), STANDARD_RATE DOUBLE, TREATY_RATE DOUBLE, EFFECTIVE_DATE DATE, EXPIRY_DATE DATE, IS_ACTIVE BIT, SOURCE VARCHAR(200), LAST_UPDATED TIMESTAMP, JURISDICTION_ID VARCHAR(200))

    Join TaxLot_CapitalGain(CAPITAL_GAIN.TAX_LOT_ID = TAX_LOT.LOT_ID)
    Join WithholdingTax_TaxReclaim(TAX_RECLAIM.WITHHOLDING_TAX_ID = WITHHOLDING_TAX.WITHHOLDING_ID)
    Join TaxJurisdiction_WHTRate(WHTRATE.JURISDICTION_ID = TAX_JURISDICTION.JURISDICTION_ID)
    Join TaxJurisdiction_TaxTreaty(TAX_TREATY.JURISDICTION_ID = TAX_JURISDICTION.JURISDICTION_ID)
    Join TaxReport_TaxProvision(TAX_PROVISION.TAX_REPORT_ID = TAX_REPORT.REPORT_ID)

    // ---- from 49-research-store.pure ----
    Table ANALYST_RECOMMENDATION (RECOMMENDATION_ID VARCHAR(200) PRIMARY KEY, RECOMMENDATION VARCHAR(200), PREVIOUS_RECOMMENDATION VARCHAR(200), TARGET_PRICE DOUBLE, PREVIOUS_TARGET_PRICE DOUBLE, RATING_DATE DATE, UPSIDE DOUBLE, CONVICTION VARCHAR(200), TIME_HORIZON VARCHAR(200), IS_INITIATION BIT, SECTOR VARCHAR(200), CURRENCY VARCHAR(200), COMPANY_ID VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table RESEARCH_REPORT (REPORT_ID VARCHAR(200) PRIMARY KEY, TITLE VARCHAR(200), PUBLISH_DATE DATE, REPORT_TYPE VARCHAR(200), PAGE_COUNT INTEGER, IS_PUBLISHED BIT, ABSTRACT_TEXT VARCHAR(200), SECTOR VARCHAR(200), REGION VARCHAR(200), DOWNLOAD_COUNT INTEGER, LANGUAGE VARCHAR(200), IS_PRIMARY_RESEARCH BIT, COVERAGE_ID VARCHAR(200))
    Table EARNINGS_ESTIMATE (ESTIMATE_ID VARCHAR(200) PRIMARY KEY, FISCAL_YEAR INTEGER, FISCAL_QUARTER INTEGER, EPS_ESTIMATE DOUBLE, REVENUE_ESTIMATE DOUBLE, PREVIOUS_EPS DOUBLE, PREVIOUS_REVENUE DOUBLE, ESTIMATE_DATE DATE, CURRENCY VARCHAR(200), CONFIDENCE VARCHAR(200), IS_CONSENSUS BIT, NUMBER_OF_ANALYSTS INTEGER, COMPANY_ID VARCHAR(200))
    Table TARGET_PRICE (TARGET_PRICE_ID VARCHAR(200) PRIMARY KEY, TARGET_PRICE DOUBLE, CURRENT_PRICE DOUBLE, UPSIDE DOUBLE, TARGET_DATE DATE, SET_DATE DATE, METHODOLOGY VARCHAR(200), TIME_HORIZON VARCHAR(200), CURRENCY VARCHAR(200), PREVIOUS_TARGET DOUBLE, CONFIDENCE VARCHAR(200), COMPANY_ID VARCHAR(200))
    Table SECTOR_OUTLOOK (OUTLOOK_ID VARCHAR(200) PRIMARY KEY, SECTOR VARCHAR(200), OUTLOOK VARCHAR(200), PREVIOUS_OUTLOOK VARCHAR(200), OUTLOOK_DATE DATE, KEY_THEME VARCHAR(200), RISK_LEVEL VARCHAR(200), TIME_HORIZON VARCHAR(200), REGION VARCHAR(200), TOP_PICK VARCHAR(200), IS_PUBLISHED BIT)
    Table COMPANY_PROFILE (PROFILE_ID VARCHAR(200) PRIMARY KEY, COMPANY_NAME VARCHAR(200), TICKER VARCHAR(200), SECTOR VARCHAR(200), MARKET_CAP DOUBLE, EMPLOYEES INTEGER, FOUNDED INTEGER, HEADQUARTERS VARCHAR(200), CEO VARCHAR(200), DESCRIPTION VARCHAR(200), WEBSITE VARCHAR(200), CURRENCY VARCHAR(200), FISCAL_YEAR_END VARCHAR(200), SECTOR_OUTLOOK_ID VARCHAR(200))
    Table PEER_COMPARISON (COMPARISON_ID VARCHAR(200) PRIMARY KEY, COMPARISON_DATE DATE, METRIC VARCHAR(200), VALUE DOUBLE, PEER_AVERAGE DOUBLE, PEER_MEDIAN DOUBLE, PERCENTILE DOUBLE, RANK INTEGER, PEER_GROUP_SIZE INTEGER, IS_ABOVE_PEER BIT, CURRENCY VARCHAR(200), COMPANY_ID VARCHAR(200))
    Table ANALYST_COVERAGE (COVERAGE_ID VARCHAR(200) PRIMARY KEY, START_DATE DATE, END_DATE DATE, IS_ACTIVE BIT, REGION VARCHAR(200), SECTOR VARCHAR(200), COVERAGE_TYPE VARCHAR(200), PUBLISHED_REPORT_COUNT INTEGER, LAST_PUBLISH_DATE DATE, ACCURACY DOUBLE)
    Table CONSENSUS_FORECAST (FORECAST_ID VARCHAR(200) PRIMARY KEY, FORECAST_DATE DATE, METRIC VARCHAR(200), CONSENSUS_VALUE DOUBLE, HIGH_ESTIMATE DOUBLE, LOW_ESTIMATE DOUBLE, NUMBER_OF_ESTIMATES INTEGER, STANDARD_DEVIATION DOUBLE, PERIOD VARCHAR(200), CURRENCY VARCHAR(200), PREVIOUS_CONSENSUS DOUBLE, COMPANY_ID VARCHAR(200))
    Table RESEARCH_NOTE (NOTE_ID VARCHAR(200) PRIMARY KEY, NOTE_DATE DATE, NOTE_TYPE VARCHAR(200), SUBJECT VARCHAR(200), CONTENT VARCHAR(200), IS_URGENT BIT, SENTIMENT VARCHAR(200), IMPACT_LEVEL VARCHAR(200), SECTOR VARCHAR(200), REGION VARCHAR(200), IS_PUBLISHED BIT, COVERAGE_ID VARCHAR(200))

    Join CompanyProfile_AnalystRecommendation(ANALYST_RECOMMENDATION.COMPANY_ID = COMPANY_PROFILE.PROFILE_ID)
    Join CompanyProfile_EarningsEstimate(EARNINGS_ESTIMATE.COMPANY_ID = COMPANY_PROFILE.PROFILE_ID)
    Join CompanyProfile_TargetPrice(TARGET_PRICE.COMPANY_ID = COMPANY_PROFILE.PROFILE_ID)
    Join CompanyProfile_PeerComparison(PEER_COMPARISON.COMPANY_ID = COMPANY_PROFILE.PROFILE_ID)
    Join AnalystCoverage_ResearchReport(RESEARCH_REPORT.COVERAGE_ID = ANALYST_COVERAGE.COVERAGE_ID)
    Join AnalystCoverage_ResearchNote(RESEARCH_NOTE.COVERAGE_ID = ANALYST_COVERAGE.COVERAGE_ID)
    Join SectorOutlook_CompanyProfile(COMPANY_PROFILE.SECTOR_OUTLOOK_ID = SECTOR_OUTLOOK.OUTLOOK_ID)
    Join ConsensusForecast_CompanyProfile(CONSENSUS_FORECAST.COMPANY_ID = COMPANY_PROFILE.PROFILE_ID)

    // ---- from 50-prime-store.pure ----
    Table PRIME_BROKER_ACCOUNT (PB_ACCOUNT_ID VARCHAR(200) PRIMARY KEY, ACCOUNT_NAME VARCHAR(200), ACCOUNT_TYPE VARCHAR(200), CURRENCY VARCHAR(200), STATUS VARCHAR(200), OPEN_DATE DATE, CLOSE_DATE DATE, MARGIN_TYPE VARCHAR(200), IS_SEGREGATED BIT, CUSTODIAN VARCHAR(200), LEGAL_ENTITY VARCHAR(200), SERVICE_TIER VARCHAR(200), ANNUAL_FEE DOUBLE, COUNTERPARTY_ID VARCHAR(200))
    Table CLIENT_BALANCE (BALANCE_ID VARCHAR(200) PRIMARY KEY, BALANCE_DATE DATE, CASH_BALANCE DOUBLE, LONG_MARKET_VALUE DOUBLE, SHORT_MARKET_VALUE DOUBLE, NET_EQUITY DOUBLE, MARGIN_REQUIREMENT DOUBLE, EXCESS_DEFICIT DOUBLE, CURRENCY VARCHAR(200), IS_DEFICIT BIT, PENDING_ACTIVITY DOUBLE, LAST_UPDATED TIMESTAMP, PB_ACCOUNT_ID VARCHAR(200))
    Table FINANCING_RATE (RATE_ID VARCHAR(200) PRIMARY KEY, RATE_DATE DATE, LONG_RATE DOUBLE, SHORT_RATE DOUBLE, SPREAD_BPS DOUBLE, BENCHMARK VARCHAR(200), CURRENCY VARCHAR(200), TIER VARCHAR(200), EFFECTIVE_DATE DATE, EXPIRY_DATE DATE, IS_NEGOTIABLE BIT, LAST_UPDATED TIMESTAMP, PB_ACCOUNT_ID VARCHAR(200))
    Table MARGIN_REQUIREMENT (MARGIN_ID VARCHAR(200) PRIMARY KEY, CALC_DATE DATE, REG_TMARGIN DOUBLE, HOUSE_MARGIN DOUBLE, CONCENTRATION_MARGIN DOUBLE, TOTAL_MARGIN DOUBLE, CURRENCY VARCHAR(200), METHODOLOGY VARCHAR(200), IS_BREACHED BIT, BREACH_AMOUNT DOUBLE, CALL_AMOUNT DOUBLE, DUE_DATE DATE, PB_ACCOUNT_ID VARCHAR(200))
    Table SHORT_LOCATE (LOCATE_ID VARCHAR(200) PRIMARY KEY, REQUEST_DATE TIMESTAMP, QUANTITY DOUBLE, LOCATED_QUANTITY DOUBLE, RATE DOUBLE, STATUS VARCHAR(200), EXPIRY_DATE DATE, SOURCE VARCHAR(200), IS_PRE_BORROW BIT, FILL_PCT DOUBLE, PRIORITY VARCHAR(200), REQUESTED_BY VARCHAR(200), PB_ACCOUNT_ID VARCHAR(200))
    Table BORROW_AVAILABILITY (AVAILABILITY_ID VARCHAR(200) PRIMARY KEY, AVAIL_DATE DATE, AVAILABLE_QUANTITY DOUBLE, BORROWED_QUANTITY DOUBLE, RATE DOUBLE, RATE_TYPE VARCHAR(200), SOURCE VARCHAR(200), IS_EASY_TO_BORROW BIT, SPECIAL_RATE DOUBLE, LAST_UPDATED TIMESTAMP, EXPIRY_DATE DATE)
    Table SYNTHETIC_POSITION (SYNTHETIC_ID VARCHAR(200) PRIMARY KEY, QUANTITY DOUBLE, ENTRY_PRICE DOUBLE, CURRENT_PRICE DOUBLE, UNREALIZED_PN_L DOUBLE, FINANCING_COST DOUBLE, CURRENCY VARCHAR(200), START_DATE DATE, END_DATE DATE, RESET_FREQUENCY VARCHAR(200), IS_OPEN BIT, DIVIDEND_ENTITLEMENT DOUBLE, PB_ACCOUNT_ID VARCHAR(200), INSTRUMENT_ID VARCHAR(200))
    Table SWAP_FINANCING (FINANCING_ID VARCHAR(200) PRIMARY KEY, FINANCING_DATE DATE, NOTIONAL DOUBLE, FINANCING_RATE DOUBLE, FINANCING_COST DOUBLE, DAY_COUNT INTEGER, CURRENCY VARCHAR(200), BENCHMARK VARCHAR(200), SPREAD DOUBLE, IS_ACCRUED BIT, ACCRUAL_PERIOD VARCHAR(200), STATUS VARCHAR(200), SYNTHETIC_POSITION_ID VARCHAR(200))
    Table PORTFOLIO_SWAP (SWAP_ID VARCHAR(200) PRIMARY KEY, SWAP_TYPE VARCHAR(200), NOTIONAL DOUBLE, START_DATE DATE, END_DATE DATE, RESET_DATE DATE, FINANCING_RATE DOUBLE, DIVIDEND_PCT DOUBLE, CURRENCY VARCHAR(200), STATUS VARCHAR(200), NAV DOUBLE, IS_OPEN BIT, PB_ACCOUNT_ID VARCHAR(200))
    Table CLIENT_STATEMENT (STATEMENT_ID VARCHAR(200) PRIMARY KEY, STATEMENT_DATE DATE, OPENING_BALANCE DOUBLE, CLOSING_BALANCE DOUBLE, TOTAL_DEBITS DOUBLE, TOTAL_CREDITS DOUBLE, FINANCING_CHARGES DOUBLE, FEES DOUBLE, CURRENCY VARCHAR(200), PERIOD VARCHAR(200), STATUS VARCHAR(200), GENERATED_DATE TIMESTAMP, PB_ACCOUNT_ID VARCHAR(200))

    Join PBAccount_ClientBalance(CLIENT_BALANCE.PB_ACCOUNT_ID = PRIME_BROKER_ACCOUNT.PB_ACCOUNT_ID)
    Join PBAccount_FinancingRate(FINANCING_RATE.PB_ACCOUNT_ID = PRIME_BROKER_ACCOUNT.PB_ACCOUNT_ID)
    Join PBAccount_MarginRequirement(MARGIN_REQUIREMENT.PB_ACCOUNT_ID = PRIME_BROKER_ACCOUNT.PB_ACCOUNT_ID)
    Join PBAccount_ShortLocate(SHORT_LOCATE.PB_ACCOUNT_ID = PRIME_BROKER_ACCOUNT.PB_ACCOUNT_ID)
    Join PBAccount_SyntheticPosition(SYNTHETIC_POSITION.PB_ACCOUNT_ID = PRIME_BROKER_ACCOUNT.PB_ACCOUNT_ID)
    Join SyntheticPosition_SwapFinancing(SWAP_FINANCING.SYNTHETIC_POSITION_ID = SYNTHETIC_POSITION.SYNTHETIC_ID)
    Join PBAccount_PortfolioSwap(PORTFOLIO_SWAP.PB_ACCOUNT_ID = PRIME_BROKER_ACCOUNT.PB_ACCOUNT_ID)
    Join PBAccount_ClientStatement(CLIENT_STATEMENT.PB_ACCOUNT_ID = PRIME_BROKER_ACCOUNT.PB_ACCOUNT_ID)

    // ---- from 90-cross-domain-store.pure ----
    Join Trade_Instrument(TRADE.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Order_Instrument(TRADE_ORDER.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Trade_Book(TRADE.BOOK_ID = BOOK.BOOK_ID)
    Join Allocation_Book(ALLOCATION.BOOK_ID = BOOK.BOOK_ID)
    Join Trade_Trader(TRADE.TRADER_ID = TRADER.TRADER_ID)
    Join Trade_Counterparty(TRADE.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join Book_Desk(BOOK.DESK_ID = DESK.DESK_ID)
    Join Portfolio_PortfolioManager(PORTFOLIO.PM_ID = PORTFOLIO_MANAGER.PM_ID)
    Join Position_Instrument(POSITION.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Settlement_Trade(SETTLEMENT.TRADE_ID = TRADE.TRADE_ID)
    Join CorporateAction_Instrument(CORPORATE_ACTION.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join DailyPnL_Book(DAILY_PN_L.BOOK_ID = BOOK.BOOK_ID)
    Join DailyPnL_Trader(DAILY_PN_L.TRADER_ID = TRADER.TRADER_ID)
    Join DailyPnL_Desk(DAILY_PN_L.DESK_ID = DESK.DESK_ID)
    Join VaRResult_Portfolio(VA_RRESULT.PORTFOLIO_ID = PORTFOLIO.PORTFOLIO_ID)
    Join Greeks_Position(GREEKS.POSITION_ID = POSITION.POSITION_ID)
    Join RiskLimit_Desk(RISK_LIMIT.DESK_ID = DESK.DESK_ID)
    Join CollateralAgreement_Counterparty(COLLATERAL_AGREEMENT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join MarginCall_Counterparty(MARGIN_CALL.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join ClientCoverage_Counterparty(CLIENT_COVERAGE.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join SalesCredit_Trade(SALES_CREDIT.TRADE_ID = TRADE.TRADE_ID)
    Join SalesPerson_Desk(SALES_PERSON.DESK_ID = DESK.DESK_ID)
    Join Confirmation_Trade(CONFIRMATION.TRADE_ID = TRADE.TRADE_ID)
    Join TradeException_Trade(TRADE_EXCEPTION.TRADE_ID = TRADE.TRADE_ID)
    Join TradeReport_Trade(TRADE_REPORT.TRADE_ID = TRADE.TRADE_ID)
    Join TransactionCost_Execution(TRANSACTION_COST.EXECUTION_ID = EXECUTION.EXECUTION_ID)
    Join Instrument_Sector(INSTRUMENT.SECTOR_ID = SECTOR.SECTOR_ID)
    Join Instrument_Currency(INSTRUMENT.CURRENCY_CODE = CURRENCY.CODE)
    Join Instrument_Exchange(INSTRUMENT.EXCHANGE_MIC = EXCHANGE.MIC)
    Join Bond_Issuer(BOND.ISSUER_ID = ISSUER.ISSUER_ID)
    Join Counterparty_Country(COUNTERPARTY.COUNTRY_CODE = COUNTRY.COUNTRY_CODE)
    Join MarketQuote_Instrument(MARKET_QUOTE.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join CashFlow_Book(CASH_FLOW.BOOK_ID = BOOK.BOOK_ID)
    Join TaxLot_Position(TAX_LOT.POSITION_ID = POSITION.POSITION_ID)
    Join AnalystRecommendation_Instrument(ANALYST_RECOMMENDATION.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join ClearedTrade_Trade(CLEARED_TRADE.TRADE_ID = TRADE.TRADE_ID)
    Join PBAccount_Counterparty(PRIME_BROKER_ACCOUNT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)
    Join SyntheticPosition_Instrument(SYNTHETIC_POSITION.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join JournalEntry_CostCenter(JOURNAL_ENTRY.COST_CENTER_ID = COST_CENTER.COST_CENTER_ID)
    Join RegulatoryCapital_LegalEntity(REGULATORY_CAPITAL.LE_ID = LEGAL_ENTITY.LE_ID)
    Join PortfolioManager_Desk(PORTFOLIO_MANAGER.DESK_ID = DESK.DESK_ID)
    Join FxRate_Currency(FX_RATE.BASE_CURRENCY_CODE = CURRENCY.CODE)
    Join Greeks_Instrument(GREEKS.INSTRUMENT_ID = INSTRUMENT.INSTRUMENT_ID)
    Join Settlement_Counterparty(SETTLEMENT.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)

    // ---- L4: store-level filters, used by filtered class mappings ----
    // A filtered mapping is how a firm exposes "the executed book" as its own class
    // without repeating the predicate in every query. It also gives a free invariance:
    // the filtered mapping must equal the unfiltered mapping with the same predicate
    // applied in the QUERY.
    // ---- L4: a {target} SELF-JOIN ----
    // Org charts are recursive: a trader reports to a trader. {target} is how Legend
    // names the far side of a join whose two ends are the SAME table -- writing
    // TRADER.MANAGER_ID = TRADER.TRADER_ID would be a tautology matching every row
    // against itself.
    Join Trader_Manager(TRADER.MANAGER_ID = {target}.TRADER_ID)
    // Reaches the VIEW from the book that owns it. BOOK has four rows and the view has
    // three, so one book resolves to nothing -- a NULL to-one, which is the case the corpus
    // wants reachable rather than a tidy one-to-one.
    Join Book_Rollup(BOOK.BOOK_ID = NOTIONAL_BY_BOOK.BOOK_ID)

    // The coupon schedule. Security to period is one-to-sixty at the deep end; period to
    // payment is one-to-zero-or-one, and the zero half is every coupon not yet due.
    Filter CaCashDividendRows(CA_EVENT.ACTION_TYPE = 'CASH_DIVIDEND')
    Filter CaSpecialDividendRows(CA_EVENT.ACTION_TYPE = 'SPECIAL_DIVIDEND')
    Filter CaStockDividendRows(CA_EVENT.ACTION_TYPE = 'STOCK_DIVIDEND')
    Filter CaScripDividendRows(CA_EVENT.ACTION_TYPE = 'SCRIP_DIVIDEND')
    Filter CaDripRows(CA_EVENT.ACTION_TYPE = 'DRIP')
    Filter CaStockSplitRows(CA_EVENT.ACTION_TYPE = 'STOCK_SPLIT')
    Filter CaReverseSplitRows(CA_EVENT.ACTION_TYPE = 'REVERSE_SPLIT')
    Filter CaBonusIssueRows(CA_EVENT.ACTION_TYPE = 'BONUS_ISSUE')
    Filter CaRightsIssueRows(CA_EVENT.ACTION_TYPE = 'RIGHTS_ISSUE')
    Filter CaOpenOfferRows(CA_EVENT.ACTION_TYPE = 'OPEN_OFFER')
    Filter CaMergerRows(CA_EVENT.ACTION_TYPE = 'MERGER')
    Filter CaAcquisitionRows(CA_EVENT.ACTION_TYPE = 'ACQUISITION')
    Filter CaSpinoffRows(CA_EVENT.ACTION_TYPE = 'SPINOFF')
    Filter CaDemergerRows(CA_EVENT.ACTION_TYPE = 'DEMERGER')
    Filter CaTenderOfferRows(CA_EVENT.ACTION_TYPE = 'TENDER_OFFER')
    Filter CaExchangeOfferRows(CA_EVENT.ACTION_TYPE = 'EXCHANGE_OFFER')
    Filter CaSchemeOfArrangementRows(CA_EVENT.ACTION_TYPE = 'SCHEME_OF_ARRANGEMENT')
    Filter CaCapitalReturnRows(CA_EVENT.ACTION_TYPE = 'CAPITAL_RETURN')
    Filter CaReturnOfCapitalRows(CA_EVENT.ACTION_TYPE = 'RETURN_OF_CAPITAL')
    Filter CaRedemptionRows(CA_EVENT.ACTION_TYPE = 'REDEMPTION')
    Filter CaPartialRedemptionRows(CA_EVENT.ACTION_TYPE = 'PARTIAL_REDEMPTION')
    Filter CaCallRows(CA_EVENT.ACTION_TYPE = 'CALL')
    Filter CaPutRows(CA_EVENT.ACTION_TYPE = 'PUT')
    Filter CaConversionRows(CA_EVENT.ACTION_TYPE = 'CONVERSION')
    Filter CaCouponPaymentRows(CA_EVENT.ACTION_TYPE = 'COUPON_PAYMENT')
    Filter CaNameChangeRows(CA_EVENT.ACTION_TYPE = 'NAME_CHANGE')
    Filter CaIsinChangeRows(CA_EVENT.ACTION_TYPE = 'ISIN_CHANGE')
    Filter CaDelistingRows(CA_EVENT.ACTION_TYPE = 'DELISTING')
    Filter CaBankruptcyRows(CA_EVENT.ACTION_TYPE = 'BANKRUPTCY')
    Filter CaLiquidationRows(CA_EVENT.ACTION_TYPE = 'LIQUIDATION')
    Filter CaConsentSolicitationRows(CA_EVENT.ACTION_TYPE = 'CONSENT_SOLICITATION')
    Filter CaWarrantExerciseRows(CA_EVENT.ACTION_TYPE = 'WARRANT_EXERCISE')
    Filter SecCommonStockRows(SECURITY_MASTER.SECURITY_TYPE = 'COMMON_STOCK')
    Filter SecPreferredStockRows(SECURITY_MASTER.SECURITY_TYPE = 'PREFERRED_STOCK')
    Filter SecAdrRows(SECURITY_MASTER.SECURITY_TYPE = 'ADR')
    Filter SecGdrRows(SECURITY_MASTER.SECURITY_TYPE = 'GDR')
    Filter SecReitRows(SECURITY_MASTER.SECURITY_TYPE = 'REIT')
    Filter SecMlpRows(SECURITY_MASTER.SECURITY_TYPE = 'MLP')
    Filter SecClosedEndFundRows(SECURITY_MASTER.SECURITY_TYPE = 'CLOSED_END_FUND')
    Filter SecEtfShareRows(SECURITY_MASTER.SECURITY_TYPE = 'ETF_SHARE')
    Filter SecEtnRows(SECURITY_MASTER.SECURITY_TYPE = 'ETN')
    Filter SecWarrantRows(SECURITY_MASTER.SECURITY_TYPE = 'WARRANT')
    Filter SecSubscriptionRightRows(SECURITY_MASTER.SECURITY_TYPE = 'SUBSCRIPTION_RIGHT')
    Filter SecGovernmentBondRows(SECURITY_MASTER.SECURITY_TYPE = 'GOVERNMENT_BOND')
    Filter SecTreasuryBillRows(SECURITY_MASTER.SECURITY_TYPE = 'TREASURY_BILL')
    Filter SecInflationLinkedBondRows(SECURITY_MASTER.SECURITY_TYPE = 'INFLATION_LINKED_BOND')
    Filter SecAgencyBondRows(SECURITY_MASTER.SECURITY_TYPE = 'AGENCY_BOND')
    Filter SecMunicipalBondRows(SECURITY_MASTER.SECURITY_TYPE = 'MUNICIPAL_BOND')
    Filter SecCorporateBondRows(SECURITY_MASTER.SECURITY_TYPE = 'CORPORATE_BOND')
    Filter SecHighYieldBondRows(SECURITY_MASTER.SECURITY_TYPE = 'HIGH_YIELD_BOND')
    Filter SecConvertibleBondRows(SECURITY_MASTER.SECURITY_TYPE = 'CONVERTIBLE_BOND')
    Filter SecFloatingRateNoteRows(SECURITY_MASTER.SECURITY_TYPE = 'FLOATING_RATE_NOTE')
    Filter SecZeroCouponBondRows(SECURITY_MASTER.SECURITY_TYPE = 'ZERO_COUPON_BOND')
    Filter SecCoveredBondRows(SECURITY_MASTER.SECURITY_TYPE = 'COVERED_BOND')
    Filter SecPerpetualBondRows(SECURITY_MASTER.SECURITY_TYPE = 'PERPETUAL_BOND')
    Filter SecSubordinatedNoteRows(SECURITY_MASTER.SECURITY_TYPE = 'SUBORDINATED_NOTE')
    Filter SecAssetBackedSecurityRows(SECURITY_MASTER.SECURITY_TYPE = 'ASSET_BACKED_SECURITY')
    Filter SecMortgageBackedSecurityRows(SECURITY_MASTER.SECURITY_TYPE = 'MORTGAGE_BACKED_SECURITY')
    Filter SecCollateralisedLoanObligationRows(SECURITY_MASTER.SECURITY_TYPE = 'COLLATERALISED_LOAN_OBLIGATION')
    Filter SecCommercialPaperRows(SECURITY_MASTER.SECURITY_TYPE = 'COMMERCIAL_PAPER')
    Filter SecCertificateOfDepositRows(SECURITY_MASTER.SECURITY_TYPE = 'CERTIFICATE_OF_DEPOSIT')
    Filter SecRepoSecurityRows(SECURITY_MASTER.SECURITY_TYPE = 'REPO_SECURITY')
    Filter SecMutualFundUnitRows(SECURITY_MASTER.SECURITY_TYPE = 'MUTUAL_FUND_UNIT')
    Filter SecMoneyMarketFundRows(SECURITY_MASTER.SECURITY_TYPE = 'MONEY_MARKET_FUND')
    Filter SecFutureContractRows(SECURITY_MASTER.SECURITY_TYPE = 'FUTURE_CONTRACT')
    Filter SecListedOptionRows(SECURITY_MASTER.SECURITY_TYPE = 'LISTED_OPTION')
    Filter SecStructuredNoteRows(SECURITY_MASTER.SECURITY_TYPE = 'STRUCTURED_NOTE')
    Filter SecDepositaryInterestRows(SECURITY_MASTER.SECURITY_TYPE = 'DEPOSITARY_INTEREST')
    Filter OrdMarketRows(ORDER_TICKET.ORDER_TYPE = 'MARKET')
    Filter OrdLimitRows(ORDER_TICKET.ORDER_TYPE = 'LIMIT')
    Filter OrdStopRows(ORDER_TICKET.ORDER_TYPE = 'STOP')
    Filter OrdStopLimitRows(ORDER_TICKET.ORDER_TYPE = 'STOP_LIMIT')
    Filter OrdMarketOnCloseRows(ORDER_TICKET.ORDER_TYPE = 'MARKET_ON_CLOSE')
    Filter OrdLimitOnCloseRows(ORDER_TICKET.ORDER_TYPE = 'LIMIT_ON_CLOSE')
    Filter OrdMarketOnOpenRows(ORDER_TICKET.ORDER_TYPE = 'MARKET_ON_OPEN')
    Filter OrdIcebergRows(ORDER_TICKET.ORDER_TYPE = 'ICEBERG')
    Filter OrdHiddenRows(ORDER_TICKET.ORDER_TYPE = 'HIDDEN')
    Filter OrdPeggedRows(ORDER_TICKET.ORDER_TYPE = 'PEGGED')
    Filter OrdMidpointPegRows(ORDER_TICKET.ORDER_TYPE = 'MIDPOINT_PEG')
    Filter OrdTwapRows(ORDER_TICKET.ORDER_TYPE = 'TWAP')
    Filter OrdVwapRows(ORDER_TICKET.ORDER_TYPE = 'VWAP')
    Filter OrdPovRows(ORDER_TICKET.ORDER_TYPE = 'POV')
    Filter OrdImplementationShortfallRows(ORDER_TICKET.ORDER_TYPE = 'IMPLEMENTATION_SHORTFALL')
    Filter OrdLiquiditySeekingRows(ORDER_TICKET.ORDER_TYPE = 'LIQUIDITY_SEEKING')
    Filter OrdDarkAggregatorRows(ORDER_TICKET.ORDER_TYPE = 'DARK_AGGREGATOR')
    Filter OrdCloseAuctionAlgoRows(ORDER_TICKET.ORDER_TYPE = 'CLOSE_AUCTION_ALGO')
    Filter OrdFillOrKillRows(ORDER_TICKET.ORDER_TYPE = 'FILL_OR_KILL')
    Filter OrdImmediateOrCancelRows(ORDER_TICKET.ORDER_TYPE = 'IMMEDIATE_OR_CANCEL')
    Filter OrdAllOrNoneRows(ORDER_TICKET.ORDER_TYPE = 'ALL_OR_NONE')
    Filter OrdGoodTillCancelledRows(ORDER_TICKET.ORDER_TYPE = 'GOOD_TILL_CANCELLED')
    Filter OrdGoodTillDateRows(ORDER_TICKET.ORDER_TYPE = 'GOOD_TILL_DATE')
    Filter OrdDayOrderRows(ORDER_TICKET.ORDER_TYPE = 'DAY_ORDER')
    Filter OrdAtTheOpenRows(ORDER_TICKET.ORDER_TYPE = 'AT_THE_OPEN')

    Filter ColCashUsdRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'CASH_USD')
    Filter ColCashEurRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'CASH_EUR')
    Filter ColCashGbpRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'CASH_GBP')
    Filter ColGovtBondUsRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'GOVT_BOND_US')
    Filter ColGovtBondDeRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'GOVT_BOND_DE')
    Filter ColGovtBondUkRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'GOVT_BOND_UK')
    Filter ColGovtBondJpRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'GOVT_BOND_JP')
    Filter ColSupranationalRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'SUPRANATIONAL')
    Filter ColAgencyMbsRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'AGENCY_MBS')
    Filter ColCorporateIgRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'CORPORATE_IG')
    Filter ColCorporateHyRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'CORPORATE_HY')
    Filter ColEquityIndexRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'EQUITY_INDEX')
    Filter ColEquitySingleRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'EQUITY_SINGLE')
    Filter ColMoneyMarketFundRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'MONEY_MARKET_FUND')
    Filter ColGoldRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'GOLD')
    Filter ColLetterOfCreditRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'LETTER_OF_CREDIT')
    Filter ColCoveredBondCollRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'COVERED_BOND_COLL')
    Filter ColAbsCollRows(COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE = 'ABS_COLL')

    Filter RegMifidTransactionRows(REG_SUBMISSION.REPORT_TYPE = 'MIFID_TRANSACTION')
    Filter RegMifidTradeRows(REG_SUBMISSION.REPORT_TYPE = 'MIFID_TRADE')
    Filter RegEmirTradeRows(REG_SUBMISSION.REPORT_TYPE = 'EMIR_TRADE')
    Filter RegEmirValuationRows(REG_SUBMISSION.REPORT_TYPE = 'EMIR_VALUATION')
    Filter RegSftrRows(REG_SUBMISSION.REPORT_TYPE = 'SFTR')
    Filter RegDoddFrankSdrRows(REG_SUBMISSION.REPORT_TYPE = 'DODD_FRANK_SDR')
    Filter RegDoddFrankRtRows(REG_SUBMISSION.REPORT_TYPE = 'DODD_FRANK_RT')
    Filter RegCftcLargeTraderRows(REG_SUBMISSION.REPORT_TYPE = 'CFTC_LARGE_TRADER')
    Filter RegAsicDerivativeRows(REG_SUBMISSION.REPORT_TYPE = 'ASIC_DERIVATIVE')
    Filter RegMasOtcRows(REG_SUBMISSION.REPORT_TYPE = 'MAS_OTC')
    Filter RegHkmaOtcRows(REG_SUBMISSION.REPORT_TYPE = 'HKMA_OTC')
    Filter RegCanadianTrRows(REG_SUBMISSION.REPORT_TYPE = 'CANADIAN_TR')
    Filter RegSec13fRows(REG_SUBMISSION.REPORT_TYPE = 'SEC_13F')
    Filter RegShortSellingRows(REG_SUBMISSION.REPORT_TYPE = 'SHORT_SELLING')
    Filter RegBestExecutionRows(REG_SUBMISSION.REPORT_TYPE = 'BEST_EXECUTION')
    Filter RegTransactionCostRows(REG_SUBMISSION.REPORT_TYPE = 'TRANSACTION_COST')
    Filter RegLiquidityCoverageRows(REG_SUBMISSION.REPORT_TYPE = 'LIQUIDITY_COVERAGE')
    Filter RegNetStableFundingRows(REG_SUBMISSION.REPORT_TYPE = 'NET_STABLE_FUNDING')
    Filter RegLargeExposureRows(REG_SUBMISSION.REPORT_TYPE = 'LARGE_EXPOSURE')
    Filter RegFrtbMarketRiskRows(REG_SUBMISSION.REPORT_TYPE = 'FRTB_MARKET_RISK')
    Filter RegCvaCapitalRows(REG_SUBMISSION.REPORT_TYPE = 'CVA_CAPITAL')
    Filter RegLeverageRatioRows(REG_SUBMISSION.REPORT_TYPE = 'LEVERAGE_RATIO')
    Filter RegPillar3Rows(REG_SUBMISSION.REPORT_TYPE = 'PILLAR_3')
    Filter RegRecoveryResolutionRows(REG_SUBMISSION.REPORT_TYPE = 'RECOVERY_RESOLUTION')

    Filter LimNotionalLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'NOTIONAL_LIMIT')
    Filter LimDv01LimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'DV01_LIMIT')
    Filter LimCs01LimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'CS01_LIMIT')
    Filter LimVegaLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'VEGA_LIMIT')
    Filter LimVarLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'VAR_LIMIT')
    Filter LimStressLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'STRESS_LIMIT')
    Filter LimConcentrationLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'CONCENTRATION_LIMIT')
    Filter LimCounterpartyLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'COUNTERPARTY_LIMIT')
    Filter LimSettlementLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'SETTLEMENT_LIMIT')
    Filter LimIssuerLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'ISSUER_LIMIT')
    Filter LimCountryLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'COUNTRY_LIMIT')
    Filter LimSectorLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'SECTOR_LIMIT')
    Filter LimTenorLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'TENOR_LIMIT')
    Filter LimLiquidityLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'LIQUIDITY_LIMIT')
    Filter LimStopLossRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'STOP_LOSS')
    Filter LimDrawdownLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'DRAWDOWN_LIMIT')
    Filter LimOvernightLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'OVERNIGHT_LIMIT')
    Filter LimIntradayLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'INTRADAY_LIMIT')
    Filter LimGrossLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'GROSS_LIMIT')
    Filter LimNetLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'NET_LIMIT')
    Filter LimLeverageLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'LEVERAGE_LIMIT')
    Filter LimCapitalLimitRows(RISK_LIMIT_DEF.LIMIT_TYPE = 'CAPITAL_LIMIT')

    Filter AcctClientCashRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'CLIENT_CASH')
    Filter AcctClientSecuritiesRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'CLIENT_SECURITIES')
    Filter AcctFirmCashRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'FIRM_CASH')
    Filter AcctFirmSecuritiesRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'FIRM_SECURITIES')
    Filter AcctNostroRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'NOSTRO')
    Filter AcctVostroRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'VOSTRO')
    Filter AcctSuspenseRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'SUSPENSE')
    Filter AcctClearingRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'CLEARING')
    Filter AcctMarginRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'MARGIN')
    Filter AcctOmnibusRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'OMNIBUS')
    Filter AcctSegregatedRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'SEGREGATED')
    Filter AcctTriPartyRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'TRI_PARTY')
    Filter AcctProprietaryRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'PROPRIETARY')
    Filter AcctHedgeRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'HEDGE')
    Filter AcctErrorAccountRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'ERROR_ACCOUNT')
    Filter AcctFeeAccountRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'FEE_ACCOUNT')
    Filter AcctTaxAccountRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'TAX_ACCOUNT')
    Filter AcctSettlementAccountRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'SETTLEMENT_ACCOUNT')
    Filter AcctCollateralAccountRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'COLLATERAL_ACCOUNT')
    Filter AcctCustodyRows(ACCOUNT_REGISTER.ACCOUNT_TYPE = 'CUSTODY')

    Filter FeeBrokerageRows(FEE_CHARGE.FEE_TYPE = 'BROKERAGE')
    Filter FeeExchangeFeeRows(FEE_CHARGE.FEE_TYPE = 'EXCHANGE_FEE')
    Filter FeeClearingFeeRows(FEE_CHARGE.FEE_TYPE = 'CLEARING_FEE')
    Filter FeeSettlementFeeRows(FEE_CHARGE.FEE_TYPE = 'SETTLEMENT_FEE')
    Filter FeeCustodyFeeRows(FEE_CHARGE.FEE_TYPE = 'CUSTODY_FEE')
    Filter FeeManagementFeeRows(FEE_CHARGE.FEE_TYPE = 'MANAGEMENT_FEE')
    Filter FeePerformanceFeeRows(FEE_CHARGE.FEE_TYPE = 'PERFORMANCE_FEE')
    Filter FeeFinancingChargeRows(FEE_CHARGE.FEE_TYPE = 'FINANCING_CHARGE')
    Filter FeeBorrowFeeRows(FEE_CHARGE.FEE_TYPE = 'BORROW_FEE')
    Filter FeeStampDutyRows(FEE_CHARGE.FEE_TYPE = 'STAMP_DUTY')
    Filter FeeFttRows(FEE_CHARGE.FEE_TYPE = 'FTT')
    Filter FeeSecFeeRows(FEE_CHARGE.FEE_TYPE = 'SEC_FEE')
    Filter FeeWithholdingTaxRows(FEE_CHARGE.FEE_TYPE = 'WITHHOLDING_TAX')
    Filter FeeResearchChargeRows(FEE_CHARGE.FEE_TYPE = 'RESEARCH_CHARGE')
    Filter FeeMarketDataFeeRows(FEE_CHARGE.FEE_TYPE = 'MARKET_DATA_FEE')
    Filter FeePlatformFeeRows(FEE_CHARGE.FEE_TYPE = 'PLATFORM_FEE')
    Filter FeeWireFeeRows(FEE_CHARGE.FEE_TYPE = 'WIRE_FEE')
    Filter FeeOverdraftInterestRows(FEE_CHARGE.FEE_TYPE = 'OVERDRAFT_INTEREST')
    Filter FeeBreakCostRows(FEE_CHARGE.FEE_TYPE = 'BREAK_COST')
    Filter FeeAmendmentFeeRows(FEE_CHARGE.FEE_TYPE = 'AMENDMENT_FEE')

    Filter MktSpotPriceRows(MARKET_DATA_POINT.DATA_TYPE = 'SPOT_PRICE')
    Filter MktClosingPriceRows(MARKET_DATA_POINT.DATA_TYPE = 'CLOSING_PRICE')
    Filter MktMidPriceRows(MARKET_DATA_POINT.DATA_TYPE = 'MID_PRICE')
    Filter MktBidPriceRows(MARKET_DATA_POINT.DATA_TYPE = 'BID_PRICE')
    Filter MktAskPriceRows(MARKET_DATA_POINT.DATA_TYPE = 'ASK_PRICE')
    Filter MktYieldCurvePointRows(MARKET_DATA_POINT.DATA_TYPE = 'YIELD_CURVE_POINT')
    Filter MktCreditCurvePointRows(MARKET_DATA_POINT.DATA_TYPE = 'CREDIT_CURVE_POINT')
    Filter MktVolSurfacePointRows(MARKET_DATA_POINT.DATA_TYPE = 'VOL_SURFACE_POINT')
    Filter MktFxSpotRateRows(MARKET_DATA_POINT.DATA_TYPE = 'FX_SPOT_RATE')
    Filter MktFxForwardPointRows(MARKET_DATA_POINT.DATA_TYPE = 'FX_FORWARD_POINT')
    Filter MktBasisSpreadRows(MARKET_DATA_POINT.DATA_TYPE = 'BASIS_SPREAD')
    Filter MktIndexLevelRows(MARKET_DATA_POINT.DATA_TYPE = 'INDEX_LEVEL')
    Filter MktFixingRateRows(MARKET_DATA_POINT.DATA_TYPE = 'FIXING_RATE')
    Filter MktInflationIndexRows(MARKET_DATA_POINT.DATA_TYPE = 'INFLATION_INDEX')
    Filter MktDividendForecastRows(MARKET_DATA_POINT.DATA_TYPE = 'DIVIDEND_FORECAST')
    Filter MktBorrowRateRows(MARKET_DATA_POINT.DATA_TYPE = 'BORROW_RATE')
    Filter MktRecoveryRateRows(MARKET_DATA_POINT.DATA_TYPE = 'RECOVERY_RATE')
    Filter MktCorrelationRows(MARKET_DATA_POINT.DATA_TYPE = 'CORRELATION')
    Filter MktCommodityCurvePointRows(MARKET_DATA_POINT.DATA_TYPE = 'COMMODITY_CURVE_POINT')
    Filter MktVolatilityIndexRows(MARKET_DATA_POINT.DATA_TYPE = 'VOLATILITY_INDEX')
    Filter MktCdsSpreadRows(MARKET_DATA_POINT.DATA_TYPE = 'CDS_SPREAD')
    Filter MktSwapRateRows(MARKET_DATA_POINT.DATA_TYPE = 'SWAP_RATE')

    Join Counterparty_Ssi(COUNTERPARTY.COUNTERPARTY_ID = BO_SSI.COUNTERPARTY_ID)
    Join Ssi_Payment(BO_SSI.SSI_ID = PAYMENT.SSI_ID)
    Join OtcTrade_Payment(OTC_TRADE.OTC_ID = PAYMENT.OTC_ID)
    Join Nostro_Movement(BO_NOSTRO.NOSTRO_ID = NOSTRO_MOVEMENT.NOSTRO_ID)
    Join Nostro_ReconItem(BO_NOSTRO.NOSTRO_ID = RECON_ITEM.NOSTRO_ID)
    Join ReconItem_Payment(RECON_ITEM.PAYMENT_ID = PAYMENT.PAYMENT_ID)
    Join ReconItem_Movement(RECON_ITEM.MOVEMENT_ID = NOSTRO_MOVEMENT.MOVEMENT_ID)

    Filter PaySwiftMt202Rows(PAYMENT.PAYMENT_TYPE = 'SWIFT_MT202')
    Filter PayTarget2Rows(PAYMENT.PAYMENT_TYPE = 'TARGET2')
    Filter PayFedwireRows(PAYMENT.PAYMENT_TYPE = 'FEDWIRE')
    Filter PayBookTransferRows(PAYMENT.PAYMENT_TYPE = 'BOOK_TRANSFER')
    Filter RecMatchedRows(RECON_ITEM.ITEM_TYPE = 'MATCHED')
    Filter RecUnmatchedStatementRows(RECON_ITEM.ITEM_TYPE = 'UNMATCHED_STATEMENT')
    Filter RecUnmatchedLedgerRows(RECON_ITEM.ITEM_TYPE = 'UNMATCHED_LEDGER')
    Filter RecValueDateMismatchRows(RECON_ITEM.ITEM_TYPE = 'VALUE_DATE_MISMATCH')

    Join OtcTrade_LifecycleEvent(OTC_TRADE.OTC_ID = LIFECYCLE_EVENT.OTC_ID)
    Join OtcTrade_ConfirmationMo(OTC_TRADE.OTC_ID = CONFIRMATION_MO.OTC_ID)
    Join OtcTrade_Break(OTC_TRADE.OTC_ID = TRADE_BREAK.OTC_ID)

    // Lifecycle event and break discriminators.
    Filter EvtNewTradeRows(LIFECYCLE_EVENT.EVENT_TYPE = 'NEW_TRADE')
    Filter EvtAmendmentRows(LIFECYCLE_EVENT.EVENT_TYPE = 'AMENDMENT')
    Filter EvtPartialTerminationRows(LIFECYCLE_EVENT.EVENT_TYPE = 'PARTIAL_TERMINATION')
    Filter EvtFullTerminationRows(LIFECYCLE_EVENT.EVENT_TYPE = 'FULL_TERMINATION')
    Filter EvtNovationRows(LIFECYCLE_EVENT.EVENT_TYPE = 'NOVATION')
    Filter EvtCompressionRows(LIFECYCLE_EVENT.EVENT_TYPE = 'COMPRESSION')
    Filter EvtIncreaseRows(LIFECYCLE_EVENT.EVENT_TYPE = 'INCREASE')
    Filter EvtRateResetRows(LIFECYCLE_EVENT.EVENT_TYPE = 'RATE_RESET')
    Filter EvtFixingRows(LIFECYCLE_EVENT.EVENT_TYPE = 'FIXING')
    Filter EvtExerciseRows(LIFECYCLE_EVENT.EVENT_TYPE = 'EXERCISE')
    Filter EvtCreditEventRows(LIFECYCLE_EVENT.EVENT_TYPE = 'CREDIT_EVENT')
    Filter BrkEconomicBreakRows(TRADE_BREAK.BREAK_TYPE = 'ECONOMIC_BREAK')
    Filter BrkConfirmationBreakRows(TRADE_BREAK.BREAK_TYPE = 'CONFIRMATION_BREAK')
    Filter BrkSettlementBreakRows(TRADE_BREAK.BREAK_TYPE = 'SETTLEMENT_BREAK')
    Filter BrkReferenceDataBreakRows(TRADE_BREAK.BREAK_TYPE = 'REFERENCE_DATA_BREAK')
    Filter BrkValuationBreakRows(TRADE_BREAK.BREAK_TYPE = 'VALUATION_BREAK')
    Filter BrkCollateralBreakRows(TRADE_BREAK.BREAK_TYPE = 'COLLATERAL_BREAK')

    Join RiskRun_Sensitivity(RISK_RUN.RUN_ID = SENSITIVITY.RUN_ID)
    Join RiskRun_Measure(RISK_RUN.RUN_ID = RISK_MEASURE.RUN_ID)
    Join RiskRun_ScenarioResult(RISK_RUN.RUN_ID = SCENARIO_RESULT.RUN_ID)
    Join Scenario_Result(MR_STRESS_SCENARIO.SCENARIO_ID = SCENARIO_RESULT.SCENARIO_ID)
    Join Sensitivity_Factor(SENSITIVITY.FACTOR_ID = MR_RISK_FACTOR.FACTOR_ID)
    Join Sensitivity_OtcTrade(SENSITIVITY.OTC_ID = OTC_TRADE.OTC_ID)

    // Discriminators for the risk-measure taxonomy. A historical VaR and a parametric VaR
    // answer the same question with different models and belong to different classes.
    Filter RiskHistoricalVarRows(RISK_MEASURE.MEASURE_TYPE = 'HISTORICAL_VAR')
    Filter RiskParametricVarRows(RISK_MEASURE.MEASURE_TYPE = 'PARAMETRIC_VAR')
    Filter RiskMonteCarloVarRows(RISK_MEASURE.MEASURE_TYPE = 'MONTE_CARLO_VAR')
    Filter RiskExpectedShortfallRows(RISK_MEASURE.MEASURE_TYPE = 'EXPECTED_SHORTFALL')
    Filter RiskStressedVarRows(RISK_MEASURE.MEASURE_TYPE = 'STRESSED_VAR')
    Filter RiskCvaRows(RISK_MEASURE.MEASURE_TYPE = 'CVA')
    Filter RiskDvaRows(RISK_MEASURE.MEASURE_TYPE = 'DVA')
    Filter RiskFvaRows(RISK_MEASURE.MEASURE_TYPE = 'FVA')
    Filter RiskPfeRows(RISK_MEASURE.MEASURE_TYPE = 'PFE')
    Filter SensDv01Rows(SENSITIVITY.MEASURE_TYPE = 'DV01')
    Filter SensCs01Rows(SENSITIVITY.MEASURE_TYPE = 'CS01')
    Filter SensVegaRows(SENSITIVITY.MEASURE_TYPE = 'VEGA')
    Filter SensFxDeltaRows(SENSITIVITY.MEASURE_TYPE = 'FX_DELTA')
    Filter SensEquityDeltaRows(SENSITIVITY.MEASURE_TYPE = 'EQUITY_DELTA')
    Filter SensCommodityDeltaRows(SENSITIVITY.MEASURE_TYPE = 'COMMODITY_DELTA')

    Join OtcTrade_Leg(OTC_TRADE.OTC_ID = OTC_SWAP_LEG.OTC_ID)
    Join OtcTrade_OptionTerms(OTC_TRADE.OTC_ID = OTC_OPTION_TERMS.OTC_ID)
    Join OtcTrade_Counterparty(OTC_TRADE.COUNTERPARTY_ID = COUNTERPARTY.COUNTERPARTY_ID)

    // The product-type discriminators. One per class in the taxonomy, which is what makes
    // thirteen subclasses over one table possible.
    Filter OtcIrsRows(OTC_TRADE.PRODUCT_TYPE = 'IRS')
    Filter OtcOisRows(OTC_TRADE.PRODUCT_TYPE = 'OIS')
    Filter OtcBasisSwapRows(OTC_TRADE.PRODUCT_TYPE = 'BASIS_SWAP')
    Filter OtcFraRows(OTC_TRADE.PRODUCT_TYPE = 'FRA')
    Filter OtcSwaptionRows(OTC_TRADE.PRODUCT_TYPE = 'SWAPTION')
    Filter OtcCapRows(OTC_TRADE.PRODUCT_TYPE = 'CAP')
    Filter OtcCdsRows(OTC_TRADE.PRODUCT_TYPE = 'CDS')
    Filter OtcCdsIndexRows(OTC_TRADE.PRODUCT_TYPE = 'CDS_INDEX')
    Filter OtcNdfRows(OTC_TRADE.PRODUCT_TYPE = 'NDF')
    Filter OtcFxOptionRows(OTC_TRADE.PRODUCT_TYPE = 'FX_OPTION')
    Filter OtcEquitySwapRows(OTC_TRADE.PRODUCT_TYPE = 'EQUITY_SWAP')
    Filter OtcVarianceSwapRows(OTC_TRADE.PRODUCT_TYPE = 'VARIANCE_SWAP')
    Filter OtcCommoditySwapRows(OTC_TRADE.PRODUCT_TYPE = 'COMMODITY_SWAP')

    // The exotic book. Fifty-eight more product types over the same base table -- the
    // taxonomy a derivatives firm actually carries, most of which it is not holding today.
    Filter OtcConstantMaturitySwapRows(OTC_TRADE.PRODUCT_TYPE = 'CONSTANT_MATURITY_SWAP')
    Filter OtcInflationSwapRows(OTC_TRADE.PRODUCT_TYPE = 'INFLATION_SWAP')
    Filter OtcCrossCurrencySwapRows(OTC_TRADE.PRODUCT_TYPE = 'CROSS_CURRENCY_SWAP')
    Filter OtcAmortisingSwapRows(OTC_TRADE.PRODUCT_TYPE = 'AMORTISING_SWAP')
    Filter OtcAccretingSwapRows(OTC_TRADE.PRODUCT_TYPE = 'ACCRETING_SWAP')
    Filter OtcRollercoasterSwapRows(OTC_TRADE.PRODUCT_TYPE = 'ROLLERCOASTER_SWAP')
    Filter OtcZeroCouponSwapRows(OTC_TRADE.PRODUCT_TYPE = 'ZERO_COUPON_SWAP')
    Filter OtcArrearsSwapRows(OTC_TRADE.PRODUCT_TYPE = 'ARREARS_SWAP')
    Filter OtcCallableSwapRows(OTC_TRADE.PRODUCT_TYPE = 'CALLABLE_SWAP')
    Filter OtcRangeAccrualRows(OTC_TRADE.PRODUCT_TYPE = 'RANGE_ACCRUAL')
    Filter OtcCmsSpreadOptionRows(OTC_TRADE.PRODUCT_TYPE = 'CMS_SPREAD_OPTION')
    Filter OtcBermudanSwaptionRows(OTC_TRADE.PRODUCT_TYPE = 'BERMUDAN_SWAPTION')
    Filter OtcMidcurveSwaptionRows(OTC_TRADE.PRODUCT_TYPE = 'MIDCURVE_SWAPTION')
    Filter OtcFloorRows(OTC_TRADE.PRODUCT_TYPE = 'FLOOR')
    Filter OtcCollarRows(OTC_TRADE.PRODUCT_TYPE = 'COLLAR')
    Filter OtcDigitalCapRows(OTC_TRADE.PRODUCT_TYPE = 'DIGITAL_CAP')
    Filter OtcCdsTrancheRows(OTC_TRADE.PRODUCT_TYPE = 'CDS_TRANCHE')
    Filter OtcFirstToDefaultRows(OTC_TRADE.PRODUCT_TYPE = 'FIRST_TO_DEFAULT')
    Filter OtcNthToDefaultRows(OTC_TRADE.PRODUCT_TYPE = 'NTH_TO_DEFAULT')
    Filter OtcRecoverySwapRows(OTC_TRADE.PRODUCT_TYPE = 'RECOVERY_SWAP')
    Filter OtcCreditLinkedNoteRows(OTC_TRADE.PRODUCT_TYPE = 'CREDIT_LINKED_NOTE')
    Filter OtcConstantMaturityCdsRows(OTC_TRADE.PRODUCT_TYPE = 'CONSTANT_MATURITY_CDS')
    Filter OtcLoanCdsRows(OTC_TRADE.PRODUCT_TYPE = 'LOAN_CDS')
    Filter OtcSovereignCdsRows(OTC_TRADE.PRODUCT_TYPE = 'SOVEREIGN_CDS')
    Filter OtcFxSwapRows(OTC_TRADE.PRODUCT_TYPE = 'FX_SWAP')
    Filter OtcFxBarrierOptionRows(OTC_TRADE.PRODUCT_TYPE = 'FX_BARRIER_OPTION')
    Filter OtcFxDigitalRows(OTC_TRADE.PRODUCT_TYPE = 'FX_DIGITAL')
    Filter OtcFxAsianOptionRows(OTC_TRADE.PRODUCT_TYPE = 'FX_ASIAN_OPTION')
    Filter OtcFxAccumulatorRows(OTC_TRADE.PRODUCT_TYPE = 'FX_ACCUMULATOR')
    Filter OtcFxTarfRows(OTC_TRADE.PRODUCT_TYPE = 'FX_TARF')
    Filter OtcQuantoForwardRows(OTC_TRADE.PRODUCT_TYPE = 'QUANTO_FORWARD')
    Filter OtcNdsRows(OTC_TRADE.PRODUCT_TYPE = 'NDS')
    Filter OtcEquityOptionOtcRows(OTC_TRADE.PRODUCT_TYPE = 'EQUITY_OPTION_OTC')
    Filter OtcDividendSwapRows(OTC_TRADE.PRODUCT_TYPE = 'DIVIDEND_SWAP')
    Filter OtcTotalReturnSwapRows(OTC_TRADE.PRODUCT_TYPE = 'TOTAL_RETURN_SWAP')
    Filter OtcAutocallableRows(OTC_TRADE.PRODUCT_TYPE = 'AUTOCALLABLE')
    Filter OtcReverseConvertibleRows(OTC_TRADE.PRODUCT_TYPE = 'REVERSE_CONVERTIBLE')
    Filter OtcCliquetRows(OTC_TRADE.PRODUCT_TYPE = 'CLIQUET')
    Filter OtcLookbackOptionRows(OTC_TRADE.PRODUCT_TYPE = 'LOOKBACK_OPTION')
    Filter OtcBasketOptionRows(OTC_TRADE.PRODUCT_TYPE = 'BASKET_OPTION')
    Filter OtcRainbowOptionRows(OTC_TRADE.PRODUCT_TYPE = 'RAINBOW_OPTION')
    Filter OtcVolatilitySwapRows(OTC_TRADE.PRODUCT_TYPE = 'VOLATILITY_SWAP')
    Filter OtcCorridorVarianceSwapRows(OTC_TRADE.PRODUCT_TYPE = 'CORRIDOR_VARIANCE_SWAP')
    Filter OtcGammaSwapRows(OTC_TRADE.PRODUCT_TYPE = 'GAMMA_SWAP')
    Filter OtcEquityRepoRows(OTC_TRADE.PRODUCT_TYPE = 'EQUITY_REPO')
    Filter OtcCommodityOptionRows(OTC_TRADE.PRODUCT_TYPE = 'COMMODITY_OPTION')
    Filter OtcCommoditySpreadRows(OTC_TRADE.PRODUCT_TYPE = 'COMMODITY_SPREAD')
    Filter OtcCommodityAsianRows(OTC_TRADE.PRODUCT_TYPE = 'COMMODITY_ASIAN')
    Filter OtcWeatherDerivativeRows(OTC_TRADE.PRODUCT_TYPE = 'WEATHER_DERIVATIVE')
    Filter OtcFreightForwardRows(OTC_TRADE.PRODUCT_TYPE = 'FREIGHT_FORWARD')
    Filter OtcEmissionsForwardRows(OTC_TRADE.PRODUCT_TYPE = 'EMISSIONS_FORWARD')
    Filter OtcPrdcRows(OTC_TRADE.PRODUCT_TYPE = 'PRDC')
    Filter OtcCallableRangeAccrualRows(OTC_TRADE.PRODUCT_TYPE = 'CALLABLE_RANGE_ACCRUAL')
    Filter OtcConvertibleAssetSwapRows(OTC_TRADE.PRODUCT_TYPE = 'CONVERTIBLE_ASSET_SWAP')
    Filter OtcEquityLinkedNoteRows(OTC_TRADE.PRODUCT_TYPE = 'EQUITY_LINKED_NOTE')
    Filter OtcInflationLinkedSwapRows(OTC_TRADE.PRODUCT_TYPE = 'INFLATION_LINKED_SWAP')
    Filter OtcLongevitySwapRows(OTC_TRADE.PRODUCT_TYPE = 'LONGEVITY_SWAP')
    Filter OtcMortgageTbaRows(OTC_TRADE.PRODUCT_TYPE = 'MORTGAGE_TBA')

    Join Security_CouponPeriod(DEBT_SECURITY.SECURITY_ID = COUPON_PERIOD.SECURITY_ID)
    Join CouponPeriod_Payment(COUPON_PERIOD.PERIOD_ID = COUPON_PAYMENT.PERIOD_ID)
    // Reach the MILESTONED tables from the entities they describe. Both were islands, so the
    // only services carrying `milestoning` and `composite PK` were the nine rooted at them,
    // and each construct sat at five of its forty possible pairs. The FROM_Z/THRU_Z columns
    // are not in the condition: milestoning supplies them, and putting them here would be
    // asserting the temporal semantics by hand instead of letting the engine apply them.
    Join Counterparty_RatingMS(COUNTERPARTY.COUNTERPARTY_ID = CPTY_RATING_MS.COUNTERPARTY_ID)
    Join Instrument_RatingBI(INSTRUMENT.INSTRUMENT_ID = INSTR_RATING_BI.INSTRUMENT_ID)

    Join TradeFlatPartial_Counterparty(TRADE_FLAT_PARTIAL.CPTY_FK = COUNTERPARTY.COUNTERPARTY_ID)

    Filter ExecutedTrades(TRADE.STATUS = 'EXECUTED')
)
