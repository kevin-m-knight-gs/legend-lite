// Connection-DSL constructs the corpus never wrote. It had four connections, all DuckDB or
// H2 with `auth: Test`, and nothing else the grammar offers.
//
// These are DECLARATIONS. A connection naming a warehouse this machine cannot reach still
// exercises the parser, the compiler and the protocol -- which is where a connection is most
// likely to be wrong -- and no service routes to one, so nothing here tries to open a socket.
// The connections that DO execute are the DuckDB ones the rest of the corpus uses.
//
// The RelationalMapper element referenced below is declared in 57-query-postprocessor.pure.
###Connection
// Every remaining connection-body property, plus the post-processors.
RelationalDatabaseConnection surface::TunedConn
{
   store: combo::ComboDB;
   type: DuckDB;
   specification: DuckDB { };
   auth: Test;
   queryTimeOutInSeconds: 60;
   quoteIdentifiers: true;
   postProcessors:
   [
      // Inline name rewriting, and the element-based form declared above.
      mapper
      {
         mappers:
         [
            schema { from: 'analytics'; to: 'PROD_ANALYTICS'; },
            table { from: 'COMBO_SUMMARY'; to: 'PROD_SUMMARY'; schemaFrom: 'analytics'; schemaTo: 'PROD_ANALYTICS'; }
         ];
      },
      // The `relationalMapper { surface::ProdMapper }` form is NOT here, and that is an
      // open question rather than a decision. Referencing the declared element fails in the
      // full model with "Can't find the packageable element 'surface::ProdMapper'", whether
      // the element shares this file or has its own. The element itself compiles; only the
      // reference from a post-processor does not resolve. Not recorded as a finding because
      // it has not been isolated far enough to say whether it is the engine or this
      // harness's model assembly.
      ExtractSubQueriesAsCTEsPostProcessor
   ];
}

// The datasource specifications that need no credentials.
RelationalDatabaseConnection surface::LocalH2Conn
{
   store: combo::ComboDB;
   type: H2;
   specification: LocalH2
   {
      testDataSetupSqls: [ 'create schema if not exists surface;' ];
   };
   auth: DefaultH2;
}

RelationalDatabaseConnection surface::StaticConn
{
   store: combo::ComboDB;
   type: Postgres;
   specification: Static
   {
      name: 'surfacedb';
      host: 'localhost';
      port: 5432;
   };
   auth: UserNamePassword
   {
      baseVaultReference: 'surface-base';
      userNameVaultReference: 'surface-user';
      passwordVaultReference: 'surface-pass';
   };
}

RelationalDatabaseConnection surface::EmbeddedH2Conn
{
   store: combo::ComboDB;
   type: H2;
   specification: EmbeddedH2
   {
      name: 'surfacedb';
      directory: '/tmp/surface';
      autoServerMode: true;
   };
   auth: DelegatedKerberos
   {
      serverPrincipal: 'HTTP/surface';
   };
}

RelationalDatabaseConnection surface::TokenConn
{
   store: combo::ComboDB;
   type: Databricks;
   specification: Databricks
   {
      hostname: 'surface.cloud';
      port: '443';
      protocol: 'https';
      httpPath: '/sql/1.0/endpoints/surface';
   };
   auth: ApiToken
   {
      apiToken: 'surface-token-ref';
   };
}

// The MODEL connections: a class fed from a literal payload rather than from a store, and
// the chain form that feeds one mapping from another's output.
JsonModelConnection surface::JsonConn
{
   class: combo::Scoped;
   url: 'data:application/json,{"rootId":"CR-0001"}';
}

XmlModelConnection surface::XmlConn
{
   class: combo::Scoped;
   url: 'data:application/xml,<Scoped><rootId>CR-0001</rootId></Scoped>';
}
