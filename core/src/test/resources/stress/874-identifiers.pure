      ~filter [store::DB]IdnBloombergTickerRows
   }

   identifiers::LegalEntityIdentifier[idnLei] extends [identifiersBase]: Relational
   {
      ~filter [store::DB]IdnLeiRows
   }

   identifiers::UniqueProductIdentifier[idnUpi] extends [identifiersBase]: Relational
   {
      ~filter [store::DB]IdnUpiRows
   }

   identifiers::UniqueTradeIdentifier[idnUti] extends [identifiersBase]: Relational
   {
      ~filter [store::DB]IdnUtiRows
   }

   identifiers::MarketIdentifierCode[idnMic] extends [identifiersBase]: Relational
