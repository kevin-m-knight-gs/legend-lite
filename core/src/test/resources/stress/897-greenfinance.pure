   {
      ~filter [store::DB]GrnSustainabilityLinkedBondRows
   }

   greenfinance::TransitionBond[grnTransitionBond] extends [greenfinanceBase]: Relational
   {
      ~filter [store::DB]GrnTransitionBondRows
   }

   greenfinance::SustainabilityLinkedLoan[grnSustainabilityLinkedLoan] extends [greenfinanceBase]: Relational
