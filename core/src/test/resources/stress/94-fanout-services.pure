Service stress::GG_SalesPersonTree
{
    pattern: '/stress/gg_salesperson';
    documentation: 'Generated graph fetch on sales::SalesPerson: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |sales::SalesPerson.all()
        ->graphFetch(#{
  sales::SalesPerson
  {
    salesPersonId,
    clientCount,
    phone,
    revenueTarget,
    commissionStructure
    {
      structureId,
      acceleratorPct,
      capAmount
    },
    desk
    {
      deskId,
      assetClass,
      building,
      businessUnit
      {
        buId,
        budget
      }
    }
  }
}#)
        ->serialize(#{
  sales::SalesPerson
  {
    salesPersonId,
    clientCount,
    phone,
    revenueTarget,
    commissionStructure
    {
      structureId,
      acceleratorPct,
      capAmount
    },
    desk
    {
      deskId,
      assetClass,
      building,
      businessUnit
      {
        buId,
        budget
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_SalesPersonTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"salesPersonId":"SLS-002","clientCount":367,"phone":"PHONE-001","revenueTarget":2012.5,"commissionStructure":null,"desk":null},{"salesPersonId":"SLS-003","clientCount":374,"phone":null,"revenueTarget":null,"commissionStructure":null,"desk":null},{"salesPersonId":"SLS-001","clientCount":null,"phone":"PHONE-003","revenueTarget":2087.5,"commissionStructure":{"structureId":"CS-0001","acceleratorPct":null,"capAmount":1337.5},"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY","building":"200 West","businessUnit":{"buId":"BU-EQ","budget":400.0}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::GG_SettlementTree
{
    pattern: '/stress/gg_settlement';
    documentation: 'Generated graph fetch on settlement::Settlement: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |settlement::Settlement.all()
        ->graphFetch(#{
  settlement::Settlement
  {
    settlementId,
    amount,
    currency,
    custodian,
    counterparty
    {
      counterpartyId,
      counterpartyType,
      creditRating,
      country
      {
        countryCode,
        capitalCity
      }
    },
    netting
    {
      nettingId,
      savingsAmount
    }
  }
}#)
        ->serialize(#{
  settlement::Settlement
  {
    settlementId,
    amount,
    currency,
    custodian,
    counterparty
    {
      counterpartyId,
      counterpartyType,
      creditRating,
      country
      {
        countryCode,
        capitalCity
      }
    },
    netting
    {
      nettingId,
      savingsAmount
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_SettlementTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 18 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"settlementId":"STL-0001","amount":190500.0,"currency":"USD","custodian":"Northern Trust","counterparty":{"counterpartyId":"CP-0001","counterpartyType":"ASSET_MANAGER","creditRating":"AA-","country":{"countryCode":"US","capitalCity":"Washington"}},"netting":null},{"settlementId":"STL-0002","amount":477500.0,"currency":"USD","custodian":"Northern Trust","counterparty":{"counterpartyId":"CP-0001","counterpartyType":"ASSET_MANAGER","creditRating":"AA-","country":{"countryCode":"US","capitalCity":"Washington"}},"netting":null},{"settlementId":"STL-0003","amount":250000.0,"currency":"USD","custodian":"Northern Trust","counterparty":{"counterpartyId":"CP-0002","counterpartyType":"BROKER_DEALER","creditRating":"A+","country":{"countryCode":"GB","capitalCity":"London"}},"netting":{"nettingId":"NET-003","savingsAmount":2200.0}},{"settlementId":"STL-0004","amount":250000.0,"currency":"USD","custodian":"Northern Trust","counterparty":{"counterpartyId":"CP-0002","counterpartyType":"BROKER_DEALER","creditRating":"A+","country":{"countryCode":"GB","capitalCity":"London"}},"netting":null},{"settlementId":"STL-0005","amount":250000.0,"currency":"USD","custodian":"Northern Trust","counterparty":{"counterpartyId":"CP-0003","counterpartyType":"HEDGE_FUND","creditRating":"BBB","country":{"countryCode":"DE","capitalCity":"Berlin"}},"netting":null},{"settlementId":"STL-0006","amount":250000.0,"currency":"USD","custodian":"Northern Trust","counterparty":{"counterpartyId":"CP-0001","counterpartyType":"ASSET_MANAGER","creditRating":"AA-","country":{"countryCode":"US","capitalCity":"Washington"}},"netting":{"nettingId":"NET-006","savingsAmount":null}},{"settlementId":"STL-0007","amount":282000.0,"currency":"USD","custodian":"Northern Trust","counterparty":null,"netting":null},{"settlementId":"STL-0008","amount":576750.0,"currency":"USD","custodian":"Northern Trust","counterparty":{"counterpartyId":"CP-0002","counterpartyType":