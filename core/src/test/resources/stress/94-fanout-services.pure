Service stress::BO4_CashByCurrency
{
    pattern: '/stress/bo4';
    documentation: 'Payments by currency and status: the treasury cash ladder.';
    execution: Single
    {
    query: |backoffice::Payment.all()
        ->project(~[
            currency:x|$x.currency,
            status:x|$x.status,
            amount:x|$x.amount
        ])
        ->groupBy(~[currency, status], ~[
            paymentCount: x|$x.amount : agg|$agg->count(),
            totalAmount: x|$x.amount : agg|$agg->sum(),
            largest: x|$x.amount : agg|$agg->max()
        ])
        ->sort(~currency->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BO4_CashByCurrency_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"currency":"EUR","status":"SETTLED","paymentCount":2,"totalAmount":1038312.5,"largest":725812.5},{"currency":"USD","status":"SETTLED","paymentCount":1,"totalAmount":666400.0,"largest":666400.0},{"currency":"USD","status":"FAILED","paymentCount":1,"totalAmount":84500.0,"largest":84500.0},{"currency":"USD","status":"CANCELLED","paymentCount":1,"totalAmount":112000.0,"largest":112000.0},{"currency":"USD","status":"PENDING","paymentCount":1,"totalAmount":41250.0,"largest":41250.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

