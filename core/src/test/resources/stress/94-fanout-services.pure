Service stress::E1_ExecutedByMapping
{
    pattern: '/stress/e1';
    documentation: 'Filter invariance, mapping side: the SAME rows reached through a class whose mapping carries ~filter [store::DB] ExecutedTrades. The query has no predicate at all.';
    execution: Single
    {
    query: |trading::ExecutedTrade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            side:x|$x.side,
            status:x|$x.status,
            currency:x|$x.currency
        ]);
        mapping: trading::ExecutedMapping;
        runtime: stress::ExecutedRT;
    }
