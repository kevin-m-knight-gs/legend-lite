Service stress::SP_defYieldCurveEmpty
{
    pattern: '/stress/sp_defyieldcurveempty';
    documentation: 'Coverage-directed stack on curves::YieldCurve (Empty), reusing the reach of AA_CurvesYieldCurveCounts and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |curves::YieldCurve.all()
        ->filter({x|($x.curveId > ' ')})
        ->project(~[
            curveId:x|$x.curveId,
            benchmarkSeriesCurrency:x|$x.benchmarkSeries.currency,
            benchmarkSeriesIsDaily:x|$x.benchmarkSeries.isDaily,
            hasNone:x|$x.points->isEmpty()
        ])
        ->sort(~curveId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    SP_defYieldCurveEmpty_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 8 rows; 8 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","benchmarkSeriesCurrency":"EUR","benchmarkSeriesIsDaily":true,"hasNone":false},{"curveId":"EUR.ESTR.OIS","benchmarkSeriesCurrency":"EUR","benchmarkSeriesIsDaily":true,"hasNone":false},{"curveId":"EUR.EURIBOR.6M","benchmarkSeriesCurrency":"EUR","benchmarkSeriesIsDaily":true,"hasNone":false},{"curveId":"GBP.SONIA.OIS","benchmarkSeriesCurrency":null,"benchmarkSeriesIsDaily":null,"hasNone":false},{"curveId":"JPY.TONA.OIS","benchmarkSeriesCurrency":null,"benchmarkSeriesIsDaily":null,"hasNone":false},{"curveId":"USD.LIBOR.3M","benchmarkSeriesCurrency":null,"benchmarkSeriesIsDaily":null,"hasNone":false},{"curveId":"USD.SOFR.OIS","benchmarkSeriesCurrency":"USD","benchmarkSeriesIsDaily":true,"hasNone":false},{"curveId":"USD.UST.GOVT","benchmarkSeriesCurrency":"USD","benchmarkSeriesIsDaily":true,"hasNone":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

