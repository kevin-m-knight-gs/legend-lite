        ->project(~[
            breakId:x|$x.breakId,
            breakType:x|$x.breakType,
            severity:x|$x.severity,
            status:x|$x.status,
            ageDays:x|$x.ageDays,
            resolvedDate:x|$x.resolvedDate,
            fieldName:x|$x.fieldName,
            ourValue:x|$x.ourValue,
            theirValue:x|$x.theirValue
        ])
        ->sort(~breakId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
