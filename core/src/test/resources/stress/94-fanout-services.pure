Service stress::M2_CanonicalWithEnum
{
    pattern: '/stress/m2';
    documentation: 'The M2M chain projecting the enum-mapped `side`. The relational mapping translates \'B\' to BUY; through a ModelChainConnection the raw code arrives instead. Isolated from M1 so one defect does not mask an unrelated invariance.';
    execution: Single
    {
    query: |canonical::CanonicalTrade.all()
        ->project(
            [
                x|$x.identifier,
                x|$x.side
            ],
            ['identifier', 'side']
        );
        mapping: canonical::M2MMapping;
        runtime: stress::CanonicalRT;
    }
  testSuites:
  [
    M2_CanonicalWithEnum_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"identifier":"TRD-0001","side":"BUY"},{"identifier":"TRD-0002","side":"BUY"},{"identifier":"TRD-0003","side":"BUY"},{"identifier":"TRD-0004","side":"SELL"},{"identifier":"TRD-0005","side":"BUY"},{"identifier":"TRD-0006","side":"BUY"},{"identifier":"TRD-0007","side":"BUY"},{"identifier":"TRD-0008","side":"BUY"},{"identifier":"TRD-0009","side":"BUY"},{"identifier":"TRD-0010","side":"BUY"},{"identifier":"TRD-0011","side":"BUY"},{"identifier":"TRD-0012","side":null},{"identifier":"TRD-0013","side":"SELL"},{"identifier":"TRD-0014","side":"BUY"},{"identifier":"TRD-0015","side":"BUY"},{"identifier":"TRD-0016","side":"BUY"},{"identifier":"TRD-0017","side":"SELL"},{"identifier":"TRD-0018","side":"BUY"},{"identifier":"TRD-0019","side":"BUY"},{"identifier":"TRD-0020","side":"BUY"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

