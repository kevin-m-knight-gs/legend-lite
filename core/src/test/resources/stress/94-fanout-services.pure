            chain1_float_plus_notnull_top:x|$x.chain1_float_plus_notnull_top,
            chain1_float_log_nullable_top:x|$x.chain1_float_log_nullable_top,
            chain1_decimal_abs_notnull_top:x|$x.chain1_decimal_abs_notnull_top,
            chain1_bool_none_notnull_top:x|$x.chain1_bool_none_notnull_top,
