    documentation: 'Emptiness of 1 to-many association(s) on marketdata::VolatilitySurface. Both `isEmpty` and `isNotEmpty` are projected for each end: asserting one alone would let a constant answer pass, and asserting both means the service is green only where the two disagree row by row. The corpus declares 177 to-many ends and traversed twelve; `count()` cannot carry the volume because F6 makes it return 1 over an empty set, and these predicates are correct there. Generated by scripts/corpus/tomany.py.';
    execution: Single
    {
    query: |marketdata::VolatilitySurface.all()
        ->project(~[
            surfaceId:x|$x.surfaceId,
            volPointsEmpty:x|$x.volPoints->isEmpty(),
            volPointsAny:x|$x.volPoints->isNotEmpty()
        ])
        ->sort(~surfaceId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TM_VolatilitySurfaceEmpty_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 5 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"surfaceId":"VS-0001","volPointsEmpty":false,"volPointsAny":true},{"surfaceId":"VS-0002","volPointsEmpty":false,"volPointsAny":true},{"surfaceId":"VS-0003","volPointsEmpty":false,"volPointsAny":true},{"surfaceId":"VS-0004","volPointsEmpty":true,"volPointsAny":false},{"surfaceId":"VS-0005","volPointsEmpty":true,"volPointsAny":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

