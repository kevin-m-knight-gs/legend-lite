Service stress::F13_RatingsOnChangeDate
{
    pattern: '/stress/t13';
    documentation: 'The day the new version takes effect. [FROM, THRU) is start-inclusive and end-EXCLUSIVE, so this must return BB+, not BBB. One day apart from T12 and the only difference between them is the boundary rule.';
    execution: Single
    {
    query: |counterparty::RatingVersion.all(%2024-06-07)
        ->project(~[
            counterpartyId:x|$x.counterpartyId,
            rating:x|$x.rating,
            agency:x|$x.agency,
            outlook:x|$x.outlook,
            isInvestmentGrade:x|$x.isInvestmentGrade
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F13_RatingsOnChangeDate_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"counterpartyId":"CP-0001","rating":"AA-","agency":"S&P","outlook":"STABLE","isInvestmentGrade":true},{"counterpartyId":"CP-0002","rating":"A+","agency":"Moody\'s","outlook":"STABLE","isInvestmentGrade":true},{"counterpartyId":"CP-0003","rating":"BB+","agency":"Fitch","outlook":"NEGATIVE","isInvestmentGrade":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

