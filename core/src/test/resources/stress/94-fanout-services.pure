Service stress::J0_TradeBookModelJoin
{
    pattern: '/stress/j0';
    documentation: 'trading::Trade to positions::Book through a ModelJoin over two Relation class mappings, instead of the store Join the canonical model uses. The answer must not change.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            notional:x|$x.notional,
            status:x|$x.status,
            bookName:x|$x.book.name,
            bookCurrency:x|$x.book.currency
        ]);
        mapping: modeljoin::JoinMapping;
        runtime: stress::ModelJoinRT;
    }
  testSuites:
  [
    J0_TradeBookModelJoin_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","notional":190500.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0002","notional":477500.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0003","notional":250000.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0004","notional":250000.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0005","notional":250000.0,"status":"EXECUTED","bookName":"Volatility Arb","bookCurrency":"USD"},{"tradeId":"TRD-0006","notional":250000.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0007","notional":282000.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0008","notional":18975.0,"status":"CANCELLED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0009","notional":576750.0,"status":"EXECUTE","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0010","notional":498000.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0011","notional":167300.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0012","notional":369000.0,"status":"PENDING","bookName":"Volatility Arb","bookCurrency":"USD"},{"tradeId":"TRD-0013","notional":171250.0,"status":"EXECUTED","bookName":"EMEA Cash Equity","bookCurrency":"EUR"},{"tradeId":"TRD-0014","notional":69000.0,"status":"EXECUTED","bookName":"EMEA Cash Equity","bookCurrency":"EUR"},{"tradeId":"TRD-0015","notional":35000.0,"status":"SETTLED","bookName":"EMEA Cash Equity","bookCurrency":"EUR"},{"tradeId":"TRD-0016","notional":264600.0,"status":"EXECUTED","bookName":"EMEA Cash Equity","bookCurrency":"EUR"},{"tradeId":"TRD-0017","notional":385000.0,"status":"EXECUTED","bookName":"EMEA Cash Equity","bookCurrency":"EUR"},{"tradeId":"TRD-0018","notional":4912500.0,"status":"EXECUTED","bookName":"Volatility Arb","bookCurrency":"USD"},{"tradeId":"TRD-0019","notional":1960000.0,"status":"EXECUTED","bookName":"Volatility Arb","bookCurrency":"USD"},{"tradeId":"TRD-0020","notional":975000.0,"status":"REJECTED","bookName":"Volatility Arb","bookCurrency":"USD"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MU0_MonetaryTrade
{
    pattern: '/stress/mu0';
    documentation: 'A Measure-typed amount through the M2M layer. Units cannot be mapped relationally at all -- legend-engine has no Unit handling in the relational compiler -- so a monetary amount that carries its unit has to be composed in an M2M mapping with newUnit(...)->cast(...).';
    execution: Single
    {
    query: |canonical::MonetaryTrade.all()
        ->graphFetch(#{
  canonical::MonetaryTrade
  {
    identifier,
    amount
  }
}#)
        ->serialize(#{
  canonical::MonetaryTrade
  {
    identifier,
    amount
  }
}#);
        mapping: canonical::MoneyMapping;
        runtime: stress::MoneyRT;
    }
  testSuites:
  [
    MU0_MonetaryTrade_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"identifier":"TRD-0001","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":190500.0}},{"identifier":"TRD-0002","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":477500.0}},{"identifier":"TRD-0003","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":250000.0}},{"identifier":"TRD-0004","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":250000.0}},{"identifier":"TRD-0005","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":250000.0}},{"identifier":"TRD-0006","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":250000.0}},{"identifier":"TRD-0007","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":282000.0}},{"identifier":"TRD-0008","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":18975.0}},{"identifier":"TRD-0009","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":576750.0}},{"identifier":"TRD-0010","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":498000.0}},{"identifier":"TRD-0011","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":167300.0}},{"identifier":"TRD-0012","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":369000.0}},{"identifier":"TRD-0013","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":171250.0}},{"identifier":"TRD-0014","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":69000.0}},{"identifier":"TRD-0015","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":35000.0}},{"identifier":"TRD-0016","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":264600.0}},{"identifier":"TRD-0017","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":385000.0}},{"identifier":"TRD-0018","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":4912500.0}},{"identifier":"TRD-0019","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":1960000.0}},{"identifier":"TRD-0020","amount":{"unit":[{"unitId":"stress::Money~USD","exponentValue":1}],"value":975000.0}}]}';
                  }#;
