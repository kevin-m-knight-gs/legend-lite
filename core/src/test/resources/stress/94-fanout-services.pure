002","tenorYears":2.4876712328767123,"notionalGbp":40290000.0},{"otcId":"OTC-000038","productType":"WEATHER_DERIVATIVE","assetClass":"COMMODITY","notional":53000000.0,"currency":"USD","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":3.9808219178082194,"notionalGbp":41870000.0},{"otcId":"OTC-000039","productType":"EMISSIONS_FORWARD","assetClass":"COMMODITY","notional":55000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":0.9726027397260274,"notionalGbp":43450000.0},{"otcId":"OTC-000040","productType":"CALLABLE_RANGE_ACCRUAL","assetClass":"HYBRID","notional":57000000.0,"currency":"JPY","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":2.967123287671233,"notionalGbp":45030000.0},{"otcId":"OTC-000041","productType":"EQUITY_LINKED_NOTE","assetClass":"HYBRID","notional":59000000.0,"currency":"JPY","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":5.536986301369863,"notionalGbp":46610000.0},{"otcId":"OTC-000042","productType":"LONGEVITY_SWAP","assetClass":"HYBRID","notional":61000000.0,"currency":"JPY","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":2.5342465753424657,"notionalGbp":48190000.0}]';
