    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"tradeId":"TRD-0001","side":"BUY","notional":190500.0,"status":"EXECUTED"},{"tradeId":"TRD-0002","side":"BUY","notional":477500.0,"status":"EXECUTED"},{"tradeId":"TRD-0003","side":"BUY","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0004","side":"SELL","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0005","side":"BUY","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0006","side":"BUY","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0007","side":"BUY","notional":282000.0,"status":"EXECUTED"},{"tradeId":"TRD-0008","side":"BUY","notional":18975.0,"status":"CANCELLED"},{"tradeId":"TRD-0009","side":"BUY","notional":576750.0,"status":"EXECUTE"},{"tradeId":"TRD-0010","side":"BUY","notional":498000.0,"status":"EXECUTED"},{"tradeId":"TRD-0011","side":"BUY","notional":167300.0,"status":"EXECUTED"},{"tradeId":"TRD-0012","side":null,"notional":369000.0,"status":"PENDING"},{"tradeId":"TRD-0013","side":"SELL","notional":171250.0,"status":"EXECUTED"},{"tradeId":"TRD-0014","side":"BUY","notional":69000.0,"status":"EXECUTED"},{"tradeId":"TRD-0015","side":"BUY","notional":35000.0,"status":"SETTLED"},{"tradeId":"TRD-0016","side":"BUY","notional":264600.0,"status":"EXECUTED"},{"tradeId":"TRD-0017","side":"SELL","notional":385000.0,"status":"EXECUTED"},{"tradeId":"TRD-0018","side":"BUY","notional":4912500.0,"status":"EXECUTED"},{"tradeId":"TRD-0019","side":"BUY","notional":1960000.0,"status":"EXECUTED"},{"tradeId":"TRD-0020","side":"BUY","notional":975000.0,"status":"REJECTED"}]}';
                  }#;
              }#
          ]
        }
      ]
