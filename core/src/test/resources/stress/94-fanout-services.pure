Service stress::D_DeskDense
{
    pattern: '/stress/d_desk';
    documentation: 'Dense stack on org::Desk: several distinct navigation chains plus whatever the model offers along them, with a filter, a sort and a limit. Generated from the model by scripts/corpus/stacks.py, so it deepens as the model does rather than needing a new hand-written service per domain.';
    execution: Single
    {
    query: |org::Desk.all()
        ->filter({x|($x.name > ' ')})
        ->project(~[
            deskId:x|$x.deskId,
            businessUnitName:x|$x.businessUnit.name,
            businessUnitLegalEntityRegionName:x|$x.businessUnit.legalEntity.region.name,
            businessUnitLegalEntityJurisdiction:x|$x.businessUnit.legalEntity.jurisdiction
        ])
        ->sort(~deskId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
