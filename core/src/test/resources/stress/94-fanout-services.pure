Service stress::F6_PositionGreeksCounts
{
    pattern: '/stress/f6';
    documentation: 'Fan-out on the shallowest possible association, so a failure here cannot be blamed on join depth. Three of six positions have no greeks row.';
    execution: Single
    {
    query: |positions::Position.all()
        ->project(~[
            positionId:x|$x.positionId,
            direction:x|$x.direction,
            currency:x|$x.currency,
            isOpen:x|$x.isOpen,
            instrumentName:x|$x.instrument.name,
            greeksCount:x|$x.greeks->count()
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F6_PositionGreeksCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 3 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"positionId":"POS-0001","direction":"LONG","currency":"USD","isOpen":true,"instrumentName":"Apple Inc","greeksCount":1},{"positionId":"POS-0002","direction":"LONG","currency":"USD","isOpen":true,"instrumentName":"Microsoft Corp","greeksCount":1},{"positionId":"POS-0003","direction":"SHORT","currency":"GBP","isOpen":true,"instrumentName":"HSBC Holdings plc","greeksCount":0},{"positionId":"POS-0004","direction":"LONG","currency":"GBP","isOpen":true,"instrumentName":"SAP SE","greeksCount":0},{"positionId":"POS-0005","direction":"LONG","currency":"GBP","isOpen":true,"instrumentName":"UK Gilt 4.25% 2055","greeksCount":1},{"positionId":"POS-0006","direction":"FLAT","currency":"GBP","isOpen":false,"instrumentName":"Nestle SA","greeksCount":0}]';
                  }#;
              }#
          ]
        }
      ]
    }
