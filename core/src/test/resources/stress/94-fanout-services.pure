// The fan-out battery. Every ->count() here crosses a to-many association, which the
// original 12 services never did (0 of 530 projection paths). Expectations come from the
// reference evaluator; the zeroes are the point -- see scripts/corpus/battery.py.
//
// GENERATED by scripts/corpus/build.py -- do not edit by hand.

###Service
Service stress::F7_TradeDerivedProperties
{
    pattern: '/stress/f7';
    documentation: 'Derived properties alongside the columns they are computed from, so a wrong value cannot hide: grossAmount is total arithmetic over two [1] measures.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            quantity:x|$x.quantity,
            price:x|$x.price,
            commission:x|$x.commission,
            fees:x|$x.fees,
            settlementDate:x|$x.settlementDate,
            side:x|$x.side,
            grossAmount:x|$x.grossAmount,
            grossInGbp:x|$x.grossAmountIn(0.79),
            grossInEur:x|$x.grossAmountIn(0.92)
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F7_TradeDerivedProperties_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","quantity":1000.0,"price":190.5,"commission":95.25,"fees":12.1,"settlementDate":"2024-06-05","side":"BUY","grossAmount":190500.0,"grossInGbp":150495.0,"grossInEur":175260.0},{"tradeId":"TRD-0002","quantity":2500.0,"price":191.0,"commission":238.75,"fees":30.25,"settlementDate":"2024-06-05","side":"BUY","grossAmount":477500.0,"grossInGbp":377225.0,"grossInEur":439300.0},{"tradeId":"TRD-0003","quantity":500.0,"price":500.0,"commission":null,"fees":null,"settlementDate":"2024-06-05","side":"BUY","grossAmount":250000.0,"grossInGbp":197500.0,"grossInEur":230000.0},{"tradeId":"TRD-0004","quantity":1250.0,"price":200.0,"commission":125.0,"fees":15.0,"settlementDate":"2024-06-06","side":"SELL","grossAmount":250000.0,"grossInGbp":197500.0,"grossInEur":230000.0},{"tradeId":"TRD-0005","quantity":2000.0,"price":125.0,"commission":100.0,"fees":11.5,"settlementDate":"2024-06-06","side":"BUY","grossAmount":250000.0,"grossInGbp":197500.0,"grossInEur":230000.0},{"tradeId":"TRD-0006","quantity":800.0,"price":312.5,"commission":80.0,"fees":9.0,"settlementDate":"2024-06-06","side":"BUY","grossAmount":250000.0,"grossInGbp":197500.0,"grossInEur":230000.0},{"tradeId":"TRD-0007","quantity":1500.0,"price":188.0,"commission":142.5,"fees":18.0,"settlementDate":"2024-06-07","side":"BUY","grossAmount":282000.0,"grossInGbp":222780.0,"grossInEur":259440.0},{"tradeId":"TRD-0008","quantity":100.0,"price":189.75,"commission":null,"fees":1.0,"settlementDate":null,"side":"BUY","grossAmount":18975.0,"grossInGbp":14990.25,"grossInEur":17457.0},{"tradeId":"TRD-0009","quantity":3000.0,"price":192.25,"commission":285.0,"fees":36.0,"settlementDate":"2024-06-07","side":"BUY","grossAmount":576750.0,"grossInGbp":455632.5,"grossInEur":530610.0},{"tradeId":"TRD-0010","quantity":1200.0,"price":415.0,"commission":249.0,"fees":31.5,"settlementDate":"2024-06-07","side":"BUY","grossAmount":498000.0,"grossInGbp":393420.0,"grossInEur":458160.0},{"tradeId":"TRD-0011","qu