Service stress::SP_ExecutedExecutedTradeGraph
{
    pattern: '/stress/sp_executedexecutedtradegraph';
    documentation: 'Coverage-directed stack on trading::ExecutedTrade (Graph), reusing the reach of E1_ExecutedByMapping and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |trading::ExecutedTrade.all()
        ->graphFetch(#{
  trading::ExecutedTrade
  {
    tradeId,
    tradeDate,
    quantity,
    price,
    notional,
    side,
    status,
    currency
  }
}#)
        ->serialize(#{
  trading::ExecutedTrade
  {
    tradeId,
    tradeDate,
    quantity,
    price,
    notional,
    side,
    status,
    currency
  }
}#);
        mapping: trading::ExecutedMapping;
        runtime: stress::ExecutedRT;
    }
  testSuites:
  [
    SP_ExecutedExecutedTradeGraph_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 15 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"tradeId":"TRD-0001","tradeDate":"2024-06-03","quantity":1000.0,"price":190.5,"notional":190500.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0002","tradeDate":"2024-06-03","quantity":2500.0,"price":191.0,"notional":477500.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0003","tradeDate":"2024-06-03","quantity":500.0,"price":500.0,"notional":250000.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0004","tradeDate":"2024-06-03","quantity":1250.0,"price":200.0,"notional":250000.0,"side":"SELL","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0005","tradeDate":"2024-06-03","quantity":2000.0,"price":125.0,"notional":250000.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0006","tradeDate":"2024-06-03","quantity":800.0,"price":312.5,"notional":250000.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0007","tradeDate":"2024-06-03","quantity":1500.0,"price":188.0,"notional":282000.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0010","tradeDate":"2024-06-04","quantity":1200.0,"price":415.0,"notional":498000.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0011","tradeDate":"2024-06-04","quantity":400.0,"price":418.25,"notional":167300.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0013","tradeDate":"2024-06-05","quantity":25000.0,"price":6.85,"notional":171250.0,"side":"SELL","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0014","tradeDate":"2024-06-05","quantity":10000.0,"price":6.9,"notional":69000.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0016","tradeDate":"2024-06-06","quantity":1500.0,"price":176.4,"notional":264600.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0017","tradeDate":"2024-06-06","quantity":2200.0,"price":175.0,"notional":385000.0,"side":"SELL","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0018","tradeDate":"2024-06-07","quantity":5000000.0,"price":0.9825,"notional":4912500.0,"side":"BUY","status":"EXECUTED","currency":"USD"},{"tradeId":"TRD-0019","tradeDate":"2024-06-07","quantity":2000000.0,"price":0.98,"notional":1960000.0,"side":"BUY","status":"EXECUTED","currency":"USD"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::SP_defClearedTradeEmpty
{
    pattern: '/stress/sp_defclearedtradeempty';
    documentation: 'Coverage-directed stack on clearing::ClearedTrade (Empty), reusing the reach of D_ClearedTradeDense and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |clearing::ClearedTrade.all()
        ->filter({x|($x.clearedTradeId > ' ')})
        ->project(~[
            clearedTradeId:x|$x.clearedTradeId,
            tradeInstrumentInstrumentCurrencyName:x|$x.trade.instrument.instrumentCurrency.name,
            tradeInstrumentExchangeName:x|$x.trade.instrument.exchange.name,
            tradeBookRollupBookId:x|$x.trade.book.rollup.bookId,
            tradeSide:x|$x.trade.side,
            tradeGrossAmount:x|$x.trade.grossAmount,
            hasNone:x|$x.novationRequests->isEmpty()
        ])
        ->sort(~clearedTradeId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    SP_defClearedTradeEmpty_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 3 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"clearedTradeId":"CT-0001","tradeInstrumentInstrumentCurrencyName":null,"tradeInstrumentExchangeName":null,"tradeBookRollupBookId":null,"tradeSide":null,"tradeGrossAmount":null,"hasNone":false},{"clearedTradeId":"CT-0002","tradeInstrumentInstrumentCurrencyName":null,"tradeInstrumentExchangeName":null,"tradeBookRollupBookId":null,"tradeSide":null,"tradeGrossAmount":null,"hasNone":false},{"clearedTradeId":"CT-0003","tradeInstrumentInstrumentCurrencyName":"US Dollar","tradeInstrumentExchangeName":"Nasdaq Stock Market","tradeBookRollupBookId":"BK-CASH-US","tradeSide":"BUY","tradeGrossAmount":190500.0,"hasNone":false},{"clearedTradeId":"CT-0004","tradeInstrumentInstrumentCurrencyName":"US Dollar","tradeInstrumentExchangeName":"Nasdaq Stock Market","tradeBookRollupBookId":"BK-CASH-US","tradeSide":"BUY","tradeGrossAmount":477500.0,"hasNone":true},{"clearedTradeId":"CT-0005","tradeInstrumentInstrumentCurrencyName":"US Dollar","tradeInstrumentExchangeName":"Nasdaq Stock Market","tradeBookRollupBookId":"BK-CASH-US","tradeSide":"BUY","tradeGrossAmount":250000.0,"hasNone":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

