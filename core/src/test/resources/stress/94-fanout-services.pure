    pattern: '/stress/crpx_annualsuitabilityreport';
    documentation: 'clientreporting::AnnualSuitabilityReport only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |clientreporting::AnnualSuitabilityReport.all()
        ->project(~[
            recordId:x|$x.recordId,
            recordType:x|$x.recordType,
            notionalPerRiskPoint:x|$x.notionalPerRiskPoint,
            notionalGbp:x|$x.notionalIn(0.79),
            currency:x|$x.currency,
            maturityDate:x|$x.maturityDate,
            isActive:x|$x.isActive
        ])
        ->sort(~recordId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CRPX_AnnualSuitabilityReport_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"recordId":"CRP-00016","recordType":"ANNUAL_SUITABILITY","notionalPerRiskPoint":1600000.0,"notionalGbp":15800000.0,"currency":"JPY","maturityDate":"2028-04-16","isActive":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

