Service stress::GG_FundingRequirementTree
{
    pattern: '/stress/gg_fundingrequirement';
    documentation: 'Generated graph fetch on funding::FundingRequirement: 5 keys, 1 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |funding::FundingRequirement.all()
        ->graphFetch(#{
  funding::FundingRequirement
  {
    requirementId,
    costEstimate,
    filledAmount,
    gapAmount,
    liquidityPool
    {
      poolId,
      maxCapacity,
      minBalance
    }
  }
}#)
        ->serialize(#{
  funding::FundingRequirement
  {
    requirementId,
    costEstimate,
    filledAmount,
    gapAmount,
    liquidityPool
    {
      poolId,
      maxCapacity,
      minBalance
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_FundingRequirementTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"requirementId":"FR-0001","costEstimate":512.5,"filledAmount":512.5,"gapAmount":null,"liquidityPool":null},{"requirementId":"FR-0002","costEstimate":550.0,"filledAmount":550.0,"gapAmount":550.0,"liquidityPool":null},{"requirementId":"FR-0003","costEstimate":null,"filledAmount":587.5,"gapAmount":587.5,"liquidityPool":{"poolId":"LP-0001","maxCapacity":null,"minBalance":512.5}},{"requirementId":"FR-0004","costEstimate":625.0,"filledAmount":625.0,"gapAmount":625.0,"liquidityPool":{"poolId":"LP-0002","maxCapacity":550.0,"minBalance":550.0}},{"requirementId":"FR-0005","costEstimate":662.5,"filledAmount":null,"gapAmount":662.5,"liquidityPool":{"poolId":"LP-0003","maxCapacity":587.5,"minBalance":587.5}}]}';
