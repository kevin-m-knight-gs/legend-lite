    query: |trading::Trade.all()
        ->graphFetch(#{
  trading::Trade
  {
    tradeId,
    status,
    notional,
    instrument
    {
      instrumentId,
      name,
      ticker
    },
    counterparty
    {
      counterpartyId,
      legalName,
      lei
    }
  }
}#)
        ->serialize(#{
  trading::Trade
  {
    tradeId,
    status,
    notional,
    instrument
    {
      instrumentId,
      name,
      ticker
    },
    counterparty
    {
      counterpartyId,
      legalName,
      lei
    }
  }
}#);
