}

Service stress::F4_SectorInstrumentCounts
{
    pattern: '/stress/f4';
    documentation: 'Fan-out across a link that is itself broken elsewhere: SEC-55 has no instruments, and INST-GILT30 points at a sector id that does not exist, so it is counted under no sector at all.';
    execution: Single
    {
    query: |refdata::Sector.all()
        ->project(~[
            sectorId:x|$x.sectorId,
            name:x|$x.name,
            gicsCode:x|$x.gicsCode,
            isActive:x|$x.isActive,
            instrumentCount:x|$x.instruments->count()
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F4_SectorInstrumentCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 1 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"sectorId":"SEC-45","name":"Information Technology","gicsCode":"45","isActive":true,"instrumentCount":2},{"sectorId":"SEC-40","name":"Financials","gicsCode":"40","isActive":true,"instrumentCount":1},{"sectorId":"SEC-35","name":"Health Care","gicsCode":"35","isActive":true,"instrumentCount":2},{"sectorId":"SEC-55","name":"Utilities","gicsCode":"55","isActive":false,"instrumentCount":0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F5_TraderChildCounts
{
    pattern: '/stress/f5';
    documentation: 'Fan-out with a NULL foreign key on the child side: two trades carry no trader, so they must be counted under no trader rather than under all of them.';
    execution: Single
    {
    query: |org::Trader.all()
        ->project(~[
            traderId:x|$x.traderId,
            firstName:x|$x.firstName,
