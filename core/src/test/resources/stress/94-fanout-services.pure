Service stress::GG17_AllocationTree
{
    pattern: '/stress/gg17';
    documentation: 'Generated graph fetch on trading::Allocation: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |trading::Allocation.all()
        ->graphFetch(#{
  trading::Allocation
  {
    allocationId,
    account,
    allocationDate,
    commission,
    book
    {
      bookId,
      bookType,
      closeDate
    },
    trade
    {
      tradeId,
      commission,
      createdTime
    }
  }
}#)
        ->serialize(#{
  trading::Allocation
  {
    allocationId,
    account,
    allocationDate,
    commission,
    book
    {
      bookId,
      bookType,
      closeDate
    },
    trade
    {
      tradeId,
      commission,
      createdTime
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG17_AllocationTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"allocationId":"A-0001","account":"ACCOUNT-001","allocationDate":"2024-04-04","commission":212.5,"book":null,"trade":null},{"allocationId":"A-0002","account":"ACCOUNT-002","allocationDate":"2024-05-05","commission":250.0,"book":null,"trade":null},{"allocationId":"A-0003","account":"ACCOUNT-003","allocationDate":"2024-06-06","commission":287.5,"book":{"bookId":"BK-CASH-US","bookType":"TRADING","closeDate":null},"trade":{"tradeId":"TRD-0001","commission":95.25,"createdTime":"2024-06-03T09:07:00.000000000+0000"}},{"allocationId":"A-0004","account":"ACCOUNT-004","allocationDate":"2024-07-07","commission":325.0,"book":{"bookId":"BK-CASH-EU","bookType":"TRADING","closeDate":null},"trade":{"tradeId":"TRD-0002","commission":238.75,"createdTime":"2024-06-03T09:14:00.000000000+0000"}},{"allocationId":"A-0005","account":"ACCOUNT-005","allocationDate":"2024-08-08","commission":362.5,"book":{"bookId":"BK-VOL-01","bookType":"TRADING","closeDate":null},"trade":{"tradeId":"TRD-0003","commission":null,"createdTime":"2024-06-03T09:21:00.000000000+0000"}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

