            dyna1_bool_isnull_notnull_top:x|$x.dyna1_bool_isnull_notnull_top,
            dyna2_string_up_nullable_top:x|$x.dyna2_string_up_nullable_top,
            dyna2_smallint_none_notnull_top:x|$x.dyna2_smallint_none_notnull_top,
            dyna2_bool_none_nullable_top:x|$x.dyna2_bool_none_nullable_top,
            ineq_string_up_notnull_top:x|$x.ineq_string_up_notnull_top,
            ineq_smallint_none_nullable_top:x|$x.ineq_smallint_none_nullable_top,
            ineq_date_none_nullable_top:x|$x.ineq_date_none_nullable_top,
            multicol_int_none_nullable_top:x|$x.multicol_int_none_nullable_top,
            multicol_decimal_none_nullable_top:x|$x.multicol_decimal_none_nullable_top,
            ormix_string_none_nullable_top:x|$x.ormix_string_none_nullable_top,
            ormix_smallint_none_nullable_top:x|$x.ormix_smallint_none_nullable_top,
            ormix_date_none_nullable_top:x|$x.ormix_date_none_nullable_top
        ])
        ->groupBy(~[rootId], ~[
            n: x|$x.col_float_abs_nullable_top : agg|$agg->count(),
            tot: x|$x.col_float_abs_nullable_top : agg|$agg->sum()
        ]);
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    SP_ComboC9Group_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0005","n":1,"tot":512.5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

