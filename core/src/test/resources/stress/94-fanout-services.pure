        ->filter({x|($x.status != ' none')})
        ->project(~[
            confirmId:x|$x.confirmId,
            tradeBookDeskName:x|$x.trade.book.desk.name,
            tradeTraderManagerBadge:x|$x.trade.trader.manager.badge,
            tradeCounterpartyCountryName:x|$x.trade.counterparty.country.name,
