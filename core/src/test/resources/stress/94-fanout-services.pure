            chain2_int_plus_notnull_embedded:x|$x.nested.chain2_int_plus_notnull_embedded,
            chain2_int_times_nullable_embedded:x|$x.nested.chain2_int_times_nullable_embedded,
            chain2_int_bxor_notnull_embedded:x|$x.nested.chain2_int_bxor_notnull_embedded,
            chain2_bigint_plus_nullable_embedded:x|$x.nested.chain2_bigint_plus_nullable_embedded,
            chain2_smallint_none_notnull_embedded:x|$x.nested.chain2_smallint_none_notnull_embedded,
            chain2_smallint_sign_nullable_embedded:x|$x.nested.chain2_smallint_sign_nullable_embedded,
