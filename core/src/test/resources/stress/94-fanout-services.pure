Service stress::N2_TradeEmbeddedFlat
{
    pattern: '/stress/n2';
    documentation: 'Mapping invariance, embedded side: byte-identical query to N0, resolved against TRADE_FLAT through embedded property mappings. No join is emitted at all, and the answer must not change.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            side:x|$x.side,
            status:x|$x.status,
            currency:x|$x.currency,
            grossAmount:x|$x.grossAmount,
            instrName:x|$x.instrument.name,
            instrTicker:x|$x.instrument.ticker,
            instrIsin:x|$x.instrument.isin,
            bookName:x|$x.book.name,
            cptyName:x|$x.counterparty.legalName,
            cptyLei:x|$x.counterparty.lei,
            traderLast:x|$x.trader.lastName
        ]);
        mapping: reporting::EmbeddedFlatMapping;
        runtime: stress::EmbeddedFlatRT;
    }
