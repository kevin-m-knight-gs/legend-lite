Service stress::OT5_UncollateralisedTrades
{
    pattern: '/stress/ot5';
    documentation: 'Uncollateralised OTC trades and whether they have option terms. The commodity swap has no clearing house and no master agreement -- three optional columns genuinely absent on one row.';
    execution: Single
    {
    query: |derivatives::OtcTrade.all()
        ->filter({x|($x.collateralised == false)})
        ->project(~[
            otcId:x|$x.otcId,
            productType:x|$x.productType,
            collateralised:x|$x.collateralised,
            masterAgreement:x|$x.masterAgreement,
            noOptionTerms:x|$x.optionTerms->isEmpty()
        ])
        ->sort(~otcId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT5_UncollateralisedTrades_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 2 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"otcId":"OTC-000006","productType":"CAP","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":false},{"otcId":"OTC-000010","productType":"FX_OPTION","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":false},{"otcId":"OTC-000012","productType":"VARIANCE_SWAP","collateralised":false,"masterAgreement":"ISDA_2002","noOptionTerms":true},{"otcId":"OTC-000013","productType":"COMMODITY_SWAP","collateralised":false,"masterAgreement":null,"noOptionTerms":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MR0_RunSummary
{
    pattern: '/stress/mr0';
    documentation: 'Risk runs with their wall-clock duration. The failed run has no completion time, so its duration is null rather than zero, and the intraday run has no approver.';
    execution: Single
    {
    query: |risk::RiskRun.all()
        ->project(~[
            runId:x|$x.runId,
            cobDate:x|$x.cobDate,
            runType:x|$x.runType,
            status:x|$x.status,
            approvedBy:x|$x.approvedBy,
            durationMinutes:x|$x.durationMinutes,
            noMeasures:x|$x.measures->isEmpty()
        ])
        ->sort(~runId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MR0_RunSummary_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 3 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"runId":"RUN-20240626-EOD","cobDate":"2024-06-26","runType":"EOD","status":"FAILED","approvedBy":null,"durationMinutes":null,"noMeasures":true},{"runId":"RUN-20240627-EOD","cobDate":"2024-06-27","runType":"EOD","status":"COMPLETE","approvedBy":"risk.controller","durationMinutes":87,"noMeasures":false},{"runId":"RUN-20240628-EOD","cobDate":"2024-06-28","runType":"EOD","status":"COMPLETE","approvedBy":"risk.controller","durationMinutes":93,"noMeasures":false},{"runId":"RUN-20240628-INTRA","cobDate":"2024-06-28","runType":"INTRADAY","status":"COMPLETE","approvedBy":null,"durationMinutes":9,"noMeasures":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MR1_FirmVar
{
    pattern: '/stress/mr1';
    documentation: 'Firm-level risk measures with the model that produced each. The XVA rows have no confidence level and no horizon -- a CVA is an adjustment, not a percentile.';
    execution: Single
    {
    query: |risk::RiskMeasure.all()
        ->project(~[
            measureId:x|$x.measureId,
            measureType:x|$x.measureType,
            confidence:x|$x.confidence,
            horizonDays:x|$x.horizonDays,
            measureValue:x|$x.measureValue,
            modelName:x|$x.modelName,
            valueEur:x|$x.valueIn(0.92),
            cobDate:x|$x.measureRun.cobDate
        ])
        ->sort(~measureId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MR1_FirmVar_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 11 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
