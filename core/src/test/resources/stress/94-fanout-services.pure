                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"counterpartyId":"CP-0001","rating":"AA","agency":"S&P","outlook":"STABLE","isInvestmentGrade":true},{"counterpartyId":"CP-0002","rating":"A+","agency":"Moody\'s","outlook":"STABLE","isInvestmentGrade":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

