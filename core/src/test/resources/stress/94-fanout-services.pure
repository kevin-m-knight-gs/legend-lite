Service stress::AA_TraderCounts
{
    pattern: '/stress/aa_trader';
    documentation: 'Generated aggregate on org::Trader: 2 count(s) over to-many associations, every parent of which HAS children. This is the non-empty half of the property the F-series pins on the empty half -- F6 makes count() over an empty to-many return 1, so an end with any childless parent is excluded here rather than quarantined. Several counts on one root so the outer joins interact; a single-aggregate probe cannot show that. Generated by scripts/corpus/aggregates.py.';
    execution: Single
    {
    query: |org::Trader.all()
        ->project(~[
            traderId:x|$x.traderId,
            dailyPnLsCount:x|$x.dailyPnLs->count(),
            tradesCount:x|$x.trades->count()
        ])
        ->sort(~traderId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    AA_TraderCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"traderId":"TRD-001","dailyPnLsCount":1,"tradesCount":4},{"traderId":"TRD-002","dailyPnLsCount":1,"tradesCount":4},{"traderId":"TRD-003","dailyPnLsCount":3,"tradesCount":7},{"traderId":"TRD-004","dailyPnLsCount":1,"tradesCount":3}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

