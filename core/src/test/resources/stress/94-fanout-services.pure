Service stress::AA_CurvesYieldCurveCounts
{
    pattern: '/stress/aa_curvesyieldcurve';
    documentation: 'Generated aggregate on curves::YieldCurve: 2 count(s) over to-many associations, every parent of which HAS children. This is the non-empty half of the property the F-series pins on the empty half -- F6 makes count() over an empty to-many return 1, so an end with any childless parent is excluded here rather than quarantined. Several counts on one root so the outer joins interact; a single-aggregate probe cannot show that. Generated by scripts/corpus/aggregates.py.';
    execution: Single
    {
    query: |curves::YieldCurve.all()
        ->project(~[
            curveId:x|$x.curveId,
            pointsCount:x|$x.points->count(),
            summariesCount:x|$x.summaries->count()
        ])
        ->sort(~curveId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    AA_CurvesYieldCurveCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 8 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","pointsCount":24,"summariesCount":2},{"curveId":"EUR.ESTR.OIS","pointsCount":24,"summariesCount":2},{"curveId":"EUR.EURIBOR.6M","pointsCount":24,"summariesCount":2},{"curveId":"GBP.SONIA.OIS","pointsCount":24,"summariesCount":2},{"curveId":"JPY.TONA.OIS","pointsCount":24,"summariesCount":2},{"curveId":"USD.LIBOR.3M","pointsCount":24,"summariesCount":2},{"curveId":"USD.SOFR.OIS","pointsCount":24,"summariesCount":2},{"curveId":"USD.UST.GOVT","pointsCount":24,"summariesCount":2}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

