Service stress::TM_ClearingMemberEmpty
{
    pattern: '/stress/tm_clearingmember';
    documentation: 'Emptiness of 3 to-many association(s) on clearing::ClearingMember. Both `isEmpty` and `isNotEmpty` are projected for each end: asserting one alone would let a constant answer pass, and asserting both means the service is green only where the two disagree row by row. The corpus declares 177 to-many ends and traversed twelve; `count()` cannot carry the volume because F6 makes it return 1 over an empty set, and these predicates are correct there. Generated by scripts/corpus/tomany.py.';
    execution: Single
    {
    query: |clearing::ClearingMember.all()
        ->project(~[
            memberId:x|$x.memberId,
            ccpMarginCallsEmpty:x|$x.ccpMarginCalls->isEmpty(),
            ccpMarginCallsAny:x|$x.ccpMarginCalls->isNotEmpty(),
            clearedTradesEmpty:x|$x.clearedTrades->isEmpty(),
            clearedTradesAny:x|$x.clearedTrades->isNotEmpty(),
            clearingFeesEmpty:x|$x.clearingFees->isEmpty(),
            clearingFeesAny:x|$x.clearingFees->isNotEmpty()
        ])
        ->sort(~memberId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TM_ClearingMemberEmpty_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
