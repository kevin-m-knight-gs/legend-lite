Service stress::SP_defOtcTradeCount
{
    pattern: '/stress/sp_defotctradecount';
    documentation: 'Coverage-directed stack on derivatives::OtcTrade (Count), reusing the reach of D_OtcTradeDense and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |derivatives::OtcTrade.all()
        ->filter({x|($x.otcId > ' ')})
        ->project(~[
            otcId:x|$x.otcId,
            optionTermsOptionTradeOptionTermsBarrierType:x|$x.optionTerms.optionTrade.optionTerms.barrierType,
            optionTermsOptionTradeCurrency:x|$x.optionTerms.optionTrade.currency,
            tenorYears:x|$x.tenorYears,
