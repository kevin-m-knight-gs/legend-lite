Service stress::J0_TradeBookModelJoin
{
    pattern: '/stress/j0';
    documentation: 'trading::Trade to positions::Book through a ModelJoin over two Relation class mappings, instead of the store Join the canonical model uses. The answer must not change.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            notional:x|$x.notional,
            status:x|$x.status,
            bookName:x|$x.book.name,
            bookCurrency:x|$x.book.currency
        ]);
        mapping: modeljoin::JoinMapping;
        runtime: stress::ModelJoinRT;
    }
  testSuites:
  [
    J0_TradeBookModelJoin_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","notional":190500.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0002","notional":477500.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0003","notional":250000.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0004","notional":250000.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0005","notional":250000.0,"status":"EXECUTED","bookName":"Volatility Arb","bookCurrency":"USD"},{"tradeId":"TRD-0006","notional":250000.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0007","notional":282000.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0008","notional":18975.0,"status":"CANCELLED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0009","notional":576750.0,"status":"EXECUTE","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0010","notional":498000.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0011","notional":167300.0,"status":"EXECUTED","bookName":"US Cash Equity","bookCurrency":"USD"},{"tradeId":"TRD-0012","notional":369000.0,"status":"PENDING","bookName":"Volatility Arb","bookCurrency":"USD"},{"tradeId":"TRD-0013","notional":171250.0,"status":"EXECUTED","bookName":"EMEA Cash Equity","bookCurrency":"EUR"},{"tradeId":"TRD-0014","notional":69000.0,"status":"EXECUTED","bookName":"EMEA Cash Equity","bookCurrency":"EUR"},{"tradeId":"TRD-0015","notional":35000.0,"status":"SETTLED","bookName":"EMEA Cash Equity","bookCurrency":"EUR"},{"tradeId":"TRD-0016","notional":264600.0,"status":"EXECUTED","bookName":"EMEA Cash Equity","bookCurrency":"EUR"},{"tradeId":"TRD-0017","notional":385000.0,"status":"EXECUTED","bookName":"EMEA Cash Equity","bookCurrency":"EUR"},{"tradeId":"TRD-0018","notional":4912500.0,"status":"EXECUTED","bookName":"Volatility Arb","bookCurrency":"USD"},{"tradeId":"TRD-0019","notional":1960000.0,"status":"EXECUTED","bookName":"Volatility Arb","bookCurrency":"USD"},{"tradeId":"TRD-0020","notional":975000.0,"status":"REJECTED","bookName":"Volatility Arb","bookCurrency":"USD"}]';
