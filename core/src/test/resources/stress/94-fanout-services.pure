Service stress::F12_RatingsDayBeforeChange
{
    pattern: '/stress/t12';
    documentation: 'The day BEFORE CP-0003 crosses out of investment grade. Must return BBB.';
    execution: Single
    {
    query: |counterparty::RatingVersion.all(%2024-06-06)
        ->project(~[
            counterpartyId:x|$x.counterpartyId,
            rating:x|$x.rating,
            agency:x|$x.agency,
            outlook:x|$x.outlook,
            isInvestmentGrade:x|$x.isInvestmentGrade
        ]);
        mapping: stress::AllMapping;
