                    data: '[{"tradeId":"TRD-0001","side":"BUY","status":"EXECUTED","quantity":1000.0,"price":190.5,"sectorName":"Information Technology","sectorGics":"45","deskName":"Cash Equities","deskRegion":"Americas","cptyCountry":"United States","cptyRegion":"Americas","traderDesk":"Cash Equities","grossAmount":190500.0,"grossGbp":150495.0,"grossEur":175260.0,"isLarge":false},{"tradeId":"TRD-0002","side":"BUY","status":"EXECUTED","quantity":2500.0,"price":191.0,"sectorName":"Information Technology","sectorGics":"45","deskName":"Cash Equities","deskRegion":"Americas","cptyCountry":"United States","cptyRegion":"Americas","traderDesk":"Cash Equities","grossAmount":477500.0,"grossGbp":377225.0,"grossEur":439300.0,"isLarge":true},{"tradeId":"TRD-0004","side":"SELL","status":"EXECUTED","quantity":1250.0,"price":200.0,"sectorName":"Information Technology","sectorGics":"45","deskName":"Cash Equities","deskRegion":"Americas","cptyCountry":"United Kingdom","cptyRegion":"EMEA","traderDesk":"Cash Equities","grossAmount":250000.0,"grossGbp":197500.0,"grossEur":230000.0,"isLarge":false},{"tradeId":"TRD-0005","side":"BUY","status":"EXECUTED","quantity":2000.0,"price":125.0,"sectorName":"Information Technology","sectorGics":"45","deskName":"Equity Derivatives","deskRegion":"EMEA","cptyCountry":"Germany","cptyRegion":"EMEA","traderDesk":"Equity Derivatives","grossAmount":250000.0,"grossGbp":197500.0,"grossEur":230000.0,"isLarge":false},{"tradeId":"TRD-0006","side":"BUY","status":"EXECUTED","quantity":800.0,"price":312.5,"sectorName":"Information Technology","sectorGics":"45","deskName":"Cash Equities","deskRegion":"Americas","cptyCountry":"United States","cptyRegion":"Americas","traderDesk":null,"grossAmount":250000.0,"grossGbp":197500.0,"grossEur":230000.0,"isLarge":false},{"tradeId":"TRD-0007","side":"BUY","status":"EXECUTED","quantity":1500.0,"price":188.0,"sectorName":"Information Technology","sectorGics":"45","deskName":"Cash Equities","deskRegion":"Americas","cptyCountry