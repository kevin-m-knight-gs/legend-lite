    pattern: '/stress/clix_mutualfundclient';
    documentation: 'clients::MutualFundClient only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |clients::MutualFundClient.all()
        ->project(~[
            clientId:x|$x.clientId,
            clientType:x|$x.clientType,
            tenureDays:x|$x.tenureDays,
            classification:x|$x.classification,
            aumUsd:x|$x.aumUsd,
            lei:x|$x.lei
        ])
        ->sort(~clientId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CLIX_MutualFundClient_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 0 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

