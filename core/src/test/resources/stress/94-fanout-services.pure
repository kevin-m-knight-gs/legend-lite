Service stress::AA_SalesPersonCounts
{
    pattern: '/stress/aa_salesperson';
    documentation: 'Generated aggregate on sales::SalesPerson: 1 count(s) over to-many associations, every parent of which HAS children. This is the non-empty half of the property the F-series pins on the empty half -- F6 makes count() over an empty to-many return 1, so an end with any childless parent is excluded here rather than quarantined. Several counts on one root so the outer joins interact; a single-aggregate probe cannot show that. Generated by scripts/corpus/aggregates.py.';
    execution: Single
    {
    query: |sales::SalesPerson.all()
        ->project(~[
            salesPersonId:x|$x.salesPersonId,
            salesCreditsCount:x|$x.salesCredits->count()
        ])
        ->sort(~salesPersonId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    AA_SalesPersonCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"salesPersonId":"SLS-001","salesCreditsCount":4},{"salesPersonId":"SLS-002","salesCreditsCount":4},{"salesPersonId":"SLS-003","salesCreditsCount":4}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

