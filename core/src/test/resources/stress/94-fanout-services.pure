Service stress::MO4_BreaksBySeverity
{
    pattern: '/stress/mo4';
    documentation: 'Breaks by severity and status: the daily ops call\'s first slide.';
    execution: Single
    {
    query: |middleoffice::TradeBreak.all()
        ->project(~[
            severity:x|$x.severity,
            status:x|$x.status,
            ageDays:x|$x.ageDays
        ])
        ->groupBy(~[severity, status], ~[
            breakCount: x|$x.ageDays : agg|$agg->count(),
            oldestDays: x|$x.ageDays : agg|$agg->max(),
            totalDays: x|$x.ageDays : agg|$agg->sum()
        ])
        ->sort(~severity->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
