    {
    query: |counterparty::RatingVersion.all(%2019-01-01)
        ->project(~[
            counterpartyId:x|$x.counterpartyId,
            rating:x|$x.rating,
            agency:x|$x.agency,
            outlook:x|$x.outlook,
            isInvestmentGrade:x|$x.isInvestmentGrade
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F10_RatingsAsOf2019_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
