Service stress::D_CouponPeriodDense
{
    pattern: '/stress/d_couponperiod';
    documentation: 'Dense stack on fixedincome::CouponPeriod: several distinct navigation chains plus whatever the model offers along them, with a filter, a sort and a limit. Generated from the model by scripts/corpus/stacks.py, so it deepens as the model does rather than needing a new hand-written service per domain.';
    execution: Single
    {
    query: |fixedincome::CouponPeriod.all()
        ->filter({x|($x.periodId > ' ')})
        ->project(~[
            periodId:x|$x.periodId,
            paymentPeriodSecurityCurrency:x|$x.payment.period.security.currency,
            paymentPeriodPaymentCurrency:x|$x.payment.period.payment.currency,
            paymentPeriodPeriodId:x|$x.payment.period.periodId,
            dailyAccrual:x|$x.dailyAccrual,
            paymentPeriodSecurityAnnualCouponInQ:x|$x.payment.period.security.annualCouponIn(0.5)
        ])
        ->sort(~periodId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    D_CouponPeriodDense_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 25 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
