Service stress::SP_ComboC9Group
{
    pattern: '/stress/sp_comboc9group';
    documentation: 'Coverage-directed stack on combo::C9 (Group), reusing the reach of CB_C9 and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |combo::C9.all()
        ->filter({x|($x.rootId > ' ')})
        ->project(~[
            rootId:x|$x.rootId,
            col_int_plus_nullable_embedded:x|$x.nested.col_int_plus_nullable_embedded,
            col_float_abs_nullable_top:x|$x.col_float_abs_nullable_top,
            col_decimal_abs_nullable_top:x|$x.col_decimal_abs_nullable_top,
            chain1_string_trim_notnull_embedded:x|$x.nested.chain1_string_trim_notnull_embedded,
            chain1_string_coal_nullable_top:x|$x.chain1_string_coal_nullable_top,
            chain1_char_none_nullable_top:x|$x.chain1_char_none_nullable_top,
            chain1_int_none_notnull_top:x|$x.chain1_int_none_notnull_top,
            chain1_int_sign_nullable_top:x|$x.chain1_int_sign_nullable_top,
            chain1_int_times_notnull_top:x|$x.chain1_int_times_notnull_top,
            chain1_bigint_none_notnull_top:x|$x.chain1_bigint_none_notnull_top,
            chain1_bigint_abs_nullable_top:x|$x.chain1_bigint_abs_nullable_top,
            chain1_smallint_abs_nullable_top:x|$x.chain1_smallint_abs_nullable_top,
            chain1_float_abs_notnull_top:x|$x.chain1_float_abs_notnull_top,
            chain1_float_plus_notnull_top:x|$x.chain1_float_plus_notnull_top,
            chain1_float_log_nullable_top:x|$x.chain1_float_log_nullable_top,
            chain1_decimal_abs_notnull_top:x|$x.chain1_decimal_abs_notnull_top,
            chain1_bool_none_notnull_top:x|$x.chain1_bool_none_notnull_top,
            chain1_bool_not_nullable_embedded:x|$x.nested.chain1_bool_not_nullable_embedded,
            chain1_date_none_notnull_embedded:x|$x.nested.chain1_date_none_notnull_embedded,
            chain1_date_fdquarter_nullable_top:x|$x.chain1_date_fdquarter_nullable_top,
            chain1_timestamp_fminhour_nullable_embedded:x|$x.nested.chain1_timestamp_fminhour_nullable_embedded,
            chain2_string_trim_notnull_embedded:x|$x.nested.chain2_string_trim_notnull_embedded,
            chain2_string_cat_nullable_embedded:x|$x.nested.chain2_string_cat_nullable_embedded,
            chain2_string_lpad_notnull_embedded:x|$x.nested.chain2_string_lpad_notnull_embedded,
            chain2_string_split_nullable_embedded:x|$x.nested.chain2_string_split_nullable_embedded,
            chain2_char_up_notnull_embedded:x|$x.nested.chain2_char_up_notnull_embedded,
            chain2_int_none_nullable_embedded:x|$x.nested.chain2_int_none_nullable_embedded,
            chain2_int_plus_notnull_embedded:x|$x.nested.chain2_int_plus_notnull_embedded,
            chain2_int_times_nullable_embedded:x|$x.nested.chain2_int_times_nullable_embedded,
