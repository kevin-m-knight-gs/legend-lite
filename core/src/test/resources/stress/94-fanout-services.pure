Service stress::GG_TradeTree
{
    pattern: '/stress/gg_trade';
    documentation: 'Generated graph fetch on trading::Trade: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->graphFetch(#{
  trading::Trade
  {
    tradeId,
    commission,
    createdTime,
    currency,
    avgPriceTrade
    {
      avgTradeId,
      arrivalPrice,
      closePrice
    },
    block
    {
      blockId,
      broker,
      completedTime
    }
  }
}#)
        ->serialize(#{
  trading::Trade
  {
    tradeId,
    commission,
    createdTime,
    currency,
    avgPriceTrade
    {
      avgTradeId,
      arrivalPrice,
      closePrice
    },
    block
    {
      blockId,
      broker,
      completedTime
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_TradeTree_suite:
