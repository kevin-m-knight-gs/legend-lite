Service stress::GG_TradeTree
{
    pattern: '/stress/gg_trade';
    documentation: 'Generated graph fetch on trading::Trade: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->graphFetch(#{
  trading::Trade
  {
    tradeId,
    commission,
    createdTime,
    currency,
    avgPriceTrade
    {
      avgTradeId,
      arrivalPrice,
      closePrice
    },
    block
    {
      blockId,
      broker,
      completedTime
    }
  }
}#)
        ->serialize(#{
  trading::Trade
  {
    tradeId,
    commission,
    createdTime,
    currency,
    avgPriceTrade
    {
      avgTradeId,
      arrivalPrice,
      closePrice
    },
    block
    {
      blockId,
      broker,
      completedTime
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_TradeTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"tradeId":"TRD-0001","commission":95.25,"createdTime":"2024-06-03T09:07:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0002","commission":238.75,"createdTime":"2024-06-03T09:14:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0003","commission":null,"createdTime":"2024-06-03T09:21:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0004","commission":125.0,"createdTime":"2024-06-03T09:28:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0005","commission":100.0,"createdTime":"2024-06-03T09:35:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0006","commission":80.0,"createdTime":"2024-06-03T09:42:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0007","commission":142.5,"createdTime":"2024-06-03T09:49:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0008","commission":null,"createdTime":"2024-06-04T09:56:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0009","commission":285.0,"createdTime":"2024-06-04T09:03:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0010","commission":249.0,"createdTime":"2024-06-04T09:10:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0011","commission":41.8,"createdTime":"2024-06-04T09:17:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0012","commission":90.0,"createdTime":"2024-06-05T09:24:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0013","commission":171.25,"createdTime":"2024-06-05T09:31:00.000000000+0000","currency":"USD","avgPriceTrade":null,"block":null},{"tradeId":"TRD-0014","commission":69.0,"createdTime":"2024-06-05T