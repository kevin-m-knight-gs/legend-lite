Service stress::SP_ComboScopedGraph
{
    pattern: '/stress/sp_comboscopedgraph';
    documentation: 'Coverage-directed stack on combo::Scoped (Graph), reusing the reach of CB_Scoped and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |combo::Scoped.all()
        ->graphFetch(#{
  combo::Scoped
  {
    r_b_nl1,
    r_b_nn1,
    r_bi_nl1,
    r_bi_nn1,
    r_c_nl1,
    r_c_nn1,
    r_de_nl1,
    r_de_nn1,
    r_dt_nl1,
    r_dt_nn1,
    r_f_nl1,
    r_f_nn1,
    r_i_nl1,
    r_i_nn1,
    r_s_nl1,
    r_s_nn1,
    r_si_nl1,
    r_si_nn1,
    rootId
  }
}#)
        ->serialize(#{
  combo::Scoped
  {
    r_b_nl1,
    r_b_nn1,
    r_bi_nl1,
    r_bi_nn1,
    r_c_nl1,
    r_c_nn1,
    r_de_nl1,
    r_de_nn1,
    r_dt_nl1,
    r_dt_nn1,
    r_f_nl1,
    r_f_nn1,
    r_i_nl1,
    r_i_nn1,
    r_s_nl1,
    r_s_nn1,
    r_si_nl1,
    r_si_nn1,
    rootId
  }
}#);
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    SP_ComboScopedGraph_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"r_b_nl1":false,"r_b_nn1":false,"r_bi_nl1":31,"r_bi_nn1":31,"r_c_nl1":"R-C-NL1-001","r_c_nn1":"R-C-NN1-001","r_de_nl1":212.5,"r_de_nn1":212.5,"r_dt_nl1":"2024-04-04","r_dt_nn1":"2024-04-04","r_f_nl1":212.5,"r_f_nn1":212.5,"r_i_nl1":31,"r_i_nn1":31,"r_s_nl1":"R-S-NL1-001","r_s_nn1":"R-S-NN1-001","r_si_nl1":null,"r_si_nn1":31,"rootId":"CR-0001"},{"r_b_nl1":null,"r_b_nn1":true,"r_bi_nl1":38,"r_bi_nn1":38,"r_c_nl1":"R-C-NL1-002","r_c_nn1":"R-C-NN1-002","r_de_nl1":250.0,"r_de_nn1":250.0,"r_dt_nl1":"2024-05-05","r_dt_nn1":"2024-05-05","r_f_nl1":250.0,"r_f_nn1":250.0,"r_i_nl1":null,"r_i_nn1":38,"r_s_nl1":"R-S-NL1-002","r_s_nn1":"R-S-NN1-002","r_si_nl1":38,"r_si_nn1":38,"rootId":"CR-0002"},{"r_b_nl1":true,"r_b_nn1":true,"r_bi_nl1":45,"r_bi_nn1":45,"r_c_nl1":"R-C-NL1-003","r_c_nn1":"R-C-NN1-003","r_de_nl1":287.5,"r_de_nn1":287.5,"r_dt_nl1":"2024-06-06","r_dt_nn1":"2024-06-06","r_f_nl1":null,"r_f_nn1":287.5,"r_i_nl1":45,"r_i_nn1":45,"r_s_nl1":null,"r_s_nn1":"R-S-NN1-003","r_si_nl1":45,"r_si_nn1":45,"rootId":"CR-0003"},{"r_b_nl1":false,"r_b_nn1":false,"r_bi_nl1":null,"r_bi_nn1":52,"r_c_nl1":"R-C-NL1-004","r_c_nn1":"R-C-NN1-004","r_de_nl1":325.0,"r_de_nn1":325.0,"r_dt_nl1":null,"r_dt_nn1":"2024-07-07","r_f_nl1":325.0,"r_f_nn1":325.0,"r_i_nl1":52,"r_i_nn1":52,"r_s_nl1":"R-S-NL1-004","r_s_nn1":"R-S-NN1-004","r_si_nl1":52,"r_si_nn1":52,"rootId":"CR-0004"},{"r_b_nl1":true,"r_b_nn1":true,"r_bi_nl1":59,"r_bi_nn1":59,"r_c_nl1":null,"r_c_nn1":"R-C-NN1-005","r_de_nl1":null,"r_de_nn1":362.5,"r_dt_nl1":"2024-08-08","r_dt_nn1":"2024-08-08","r_f_nl1":362.5,"r_f_nn1":362.5,"r_i_nl1":59,"r_i_nn1":59,"r_s_nl1":"R-S-NL1-005","r_s_nn1":"R-S-NN1-005","r_si_nl1":59,"r_si_nn1":59,"rootId":"CR-0005"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::SP_IssuerProdIssuerGraph
{
    pattern: '/stress/sp_issuerprodissuergraph';
    documentation: 'Coverage-directed stack on hier::Issuer (Graph), reusing the reach of H_IssuerProd and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |hier::Issuer.all()
        ->graphFetch(#{
  hier::Issuer
  {
    issuerId,
    legalName
  }
}#)
        ->serialize(#{
  hier::Issuer
  {
    issuerId,
    legalName
  }
}#);
        mapping: hier::IssuerMappingProd;
        runtime: hier::IssuerProdRT;
    }
  testSuites:
  [
    SP_IssuerProdIssuerGraph_suite:
    {
      data:
      [
        connections:
        [
          issuerProdEnv:
            Reference
            #{
              hier::IssuerProdData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"issuerId":"HI-0001","legalName":"Northbridge"},{"issuerId":"HI-0002","legalName":"Kestrel"},{"issuerId":"HI-0003","legalName":"Aldgate"},{"issuerId":"HI-0004","legalName":"Fenwick"},{"issuerId":"HI-0005","legalName":"Thameside"}]}';
