Service stress::SP_InlineFlatTradeGroup
{
    pattern: '/stress/sp_inlineflattradegroup';
    documentation: 'Coverage-directed stack on trading::Trade (Group), reusing the reach of N3_TradeInlineFlat and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->filter({x|($x.tradeId > ' ')})
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            side:x|$x.side,
            status:x|$x.status,
            currency:x|$x.currency,
            grossAmount:x|$x.grossAmount,
            instrName:x|$x.instrument.name,
            instrTicker:x|$x.instrument.ticker,
            instrIsin:x|$x.instrument.isin,
            bookName:x|$x.book.name,
            cptyName:x|$x.counterparty.legalName,
            cptyLei:x|$x.counterparty.lei,
            traderLast:x|$x.trader.lastName
        ])
        ->groupBy(~[tradeId], ~[
            n: x|$x.quantity : agg|$agg->count(),
            tot: x|$x.quantity : agg|$agg->sum()
