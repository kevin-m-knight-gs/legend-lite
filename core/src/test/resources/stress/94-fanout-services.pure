Service stress::SP_ComboSummaryGroup
{
    pattern: '/stress/sp_combosummarygroup';
    documentation: 'Coverage-directed stack on combo::Summary (Group), reusing the reach of CB_SchemaQualified and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |combo::Summary.all()
        ->filter({x|($x.rootId > ' ')})
        ->project(~[
            rootId:x|$x.rootId,
            sm_b_nl1:x|$x.sm_b_nl1,
            sm_b_nn1:x|$x.sm_b_nn1,
            sm_bi_nl1:x|$x.sm_bi_nl1,
            sm_bi_nn1:x|$x.sm_bi_nn1,
            sm_c_nl1:x|$x.sm_c_nl1,
            sm_c_nn1:x|$x.sm_c_nn1,
            sm_de_nl1:x|$x.sm_de_nl1,
            sm_de_nn1:x|$x.sm_de_nn1,
            sm_dt_nl1:x|$x.sm_dt_nl1,
            sm_dt_nn1:x|$x.sm_dt_nn1,
            sm_f_nl1:x|$x.sm_f_nl1,
            sm_f_nn1:x|$x.sm_f_nn1,
            sm_i_nl1:x|$x.sm_i_nl1,
            sm_i_nn1:x|$x.sm_i_nn1,
            sm_s_nl1:x|$x.sm_s_nl1,
            sm_s_nn1:x|$x.sm_s_nn1,
            sm_si_nl1:x|$x.sm_si_nl1,
            sm_si_nn1:x|$x.sm_si_nn1,
            sm_ts_nl1:x|$x.sm_ts_nl1,
            sm_ts_nn1:x|$x.sm_ts_nn1,
            summaryId:x|$x.summaryId
        ])
        ->groupBy(~[rootId], ~[
            n: x|$x.sm_bi_nl1 : agg|$agg->count(),
            tot: x|$x.sm_bi_nl1 : agg|$agg->sum()
        ]);
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    SP_ComboSummaryGroup_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0001-GONE","n":1,"tot":59},{"rootId":"CR-0001","n":1,"tot":66},{"rootId":"CR-0002","n":0,"tot":null},{"rootId":"CR-0003","n":1,"tot":80}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

