Service stress::F30_TradeEverything
{
    pattern: '/stress/f30';
    documentation: 'The deep stack: enum-mapped side, a derived property, a QUALIFIED property with two different arguments, three independent 3-hop navigation chains, a two-condition filter, a sort and a limit -- one query. Each of these passes alone elsewhere in the corpus; this asserts they still hold together.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->filter({x|($x.status == 'EXECUTED') && ($x.quantity > 500.0)})
        ->project(~[
            tradeId:x|$x.tradeId,
            side:x|$x.side,
            status:x|$x.status,
            quantity:x|$x.quantity,
            price:x|$x.price,
            sectorName:x|$x.instrument.sector.name,
            sectorGics:x|$x.instrument.sector.gicsCode,
            deskName:x|$x.book.desk.name,
            deskRegion:x|$x.book.desk.region,
            cptyCountry:x|$x.counterparty.country.name,
            cptyRegion:x|$x.counterparty.country.region,
            traderDesk:x|$x.trader.desk.name,
            grossAmount:x|$x.grossAmount,
            grossGbp:x|$x.grossAmountIn(0.79),
            grossEur:x|$x.grossAmountIn(0.92),
            isLarge:x|$x->stress::rules::isLargeTrade()
        ])
        ->sort(~tradeId->ascending())
        ->limit(12);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F30_TradeEverything_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
