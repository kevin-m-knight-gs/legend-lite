Service stress::G0_TradeTree
{
    pattern: '/stress/g0';
    documentation: 'Nested to-one navigation. TRD-0007\'s counterparty does not exist, so the whole counterparty sub-object must be null -- the tree-shaped version of a distinction a flat projection cannot make.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->graphFetch(#{
  trading::Trade
  {
    tradeId,
    status,
    notional,
    instrument
    {
      instrumentId,
      name,
      ticker
    },
    counterparty
    {
      counterpartyId,
      legalName,
      lei
    }
  }
}#)
        ->serialize(#{
  trading::Trade
  {
    tradeId,
    status,
    notional,
    instrument
    {
      instrumentId,
      name,
      ticker
    },
    counterparty
    {
      counterpartyId,
      legalName,
      lei
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
