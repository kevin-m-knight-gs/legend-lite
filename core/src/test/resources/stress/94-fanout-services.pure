Service stress::FI0_SecurityTerms
{
    pattern: '/stress/fi0';
    documentation: 'Debt securities with their terms, the derived annual coupon, and that coupon converted at a caller-supplied FX rate. One security is perpetual, so maturityDate is null for it.';
    execution: Single
    {
    query: |fixedincome::DebtSecurity.all()
        ->project(~[
            securityId:x|$x.securityId,
            description:x|$x.description,
            issuerName:x|$x.issuerName,
            currency:x|$x.currency,
            couponRate:x|$x.couponRate,
            maturityDate:x|$x.maturityDate,
            annualCoupon:x|$x.annualCoupon,
            annualCouponGbp:x|$x.annualCouponIn(0.79)
        ])
        ->sort(~securityId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    FI0_SecurityTerms_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"securityId":"DE000A289N78","description":"Siemens 0.375% 2027","issuerName":"Siemens AG","currency":"EUR","couponRate":0.375,"maturityDate":"2027-06-05","annualCoupon":3.75,"annualCouponGbp":2.9625000000000004},{"securityId":"US037833DX90","description":"Apple Inc 2.05% 2026","issuerName":"Apple Inc","currency":"USD","couponRate":2.05,"maturityDate":"2026-09-11","annualCoupon":20.5,"annualCouponGbp":16.195},{"securityId":"US912810TM08","description":"US Treasury Bond 2.375% 2049","issuerName":"United States Treasury","currency":"USD","couponRate":2.375,"maturityDate":"2049-05-31","annualCoupon":23.75,"annualCouponGbp":18.7625},{"securityId":"US912828YY08","description":"US Treasury Note 1.75% 2029","issuerName":"United States Treasury","currency":"USD","couponRate":1.75,"maturityDate":"2029-11-30","annualCoupon":17.5,"annualCouponGbp":13.825000000000001},{"securityId":"XS1002801758","description":"Barclays 8.0% Perpetual AT1","issuerName":"Barclays plc","currency":"USD","couponRate":8.0,"maturityDate":null,"annualCoupon":80.0,"annualCouponGbp":63.2},{"securityId":"XS2056430215","description":"HSBC Holdings 3.0% 2030","issuerName":"HSBC Holdings plc","currency":"GBP","couponRate":3.0,"maturityDate":"2030-09-20","annualCoupon":30.0,"annualCouponGbp":23.700000000000003}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::FI1_CouponSchedule
{
    pattern: '/stress/fi1';
    documentation: 'The accrual schedule: every coupon period with its accrual window, day count and amount, and the payment against it where one exists. 130 rows over 6 securities -- the deepest fan-out in the corpus -- and 87 of them have no payment because the coupon is not due yet.';
    execution: Single
    {
    query: |fixedincome::CouponPeriod.all()
        ->project(~[
            periodId:x|$x.periodId,
            securityId:x|$x.securityId,
            periodNumber:x|$x.periodNumber,
            accrualStart:x|$x.accrualStartDate,
            accrualEnd:x|$x.accrualEndDate,
            accrualDays:x|$x.accrualDays,
            couponAmount:x|$x.couponAmount,
            dailyAccrual:x|$x.dailyAccrual,
            netPaid:x|$x.payment.netAmount
        ])
        ->sort(~periodId->ascending());
