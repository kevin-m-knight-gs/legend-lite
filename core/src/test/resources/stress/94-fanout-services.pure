Service stress::FI3_ScheduleTotals
{
    pattern: '/stress/fi3';
    documentation: 'Scheduled coupon totals per security: how many periods, how much is scheduled in total. Aggregated over a fan-out sixty deep at its widest, which is where an aggregate that double-counts its join stops hiding.';
    execution: Single
    {
    query: |fixedincome::CouponPeriod.all()
        ->project(~[
            securityId:x|$x.securityId,
            couponAmount:x|$x.couponAmount
        ])
        ->groupBy(~[securityId], ~[
            periodCount: x|$x.couponAmount : agg|$agg->count(),
            totalScheduled: x|$x.couponAmount : agg|$agg->sum(),
            largestCoupon: x|$x.couponAmount : agg|$agg->max()
        ])
        ->sort(~securityId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    FI3_ScheduleTotals_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"securityId":"DE000A289N78","periodCount":7,"totalScheduled":26.25,"largestCoupon":3.75},{"securityId":"US037833DX90","periodCount":12,"totalScheduled":123.0,"largestCoupon":10.25},{"securityId":"US912810TM08","periodCount":60,"totalScheduled":712.8,"largestCoupon":11.88},{"securityId":"US912828YY08","periodCount":20,"totalScheduled":175.0,"largestCoupon":8.75},{"securityId":"XS1002801758","periodCount":20,"totalScheduled":800.0,"largestCoupon":40.0},{"securityId":"XS2056430215","periodCount":11,"totalScheduled":330.0,"largestCoupon":30.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::FI4_UnpaidPeriods
{
    pattern: '/stress/fi4';
    documentation: 'Coupon periods with no payment against them. The empty half of this association is 87 of 130 rows, so emptiness is the common case here rather than the exception it is everywhere else in the corpus.';
    execution: Single
    {
    query: |fixedincome::CouponPeriod.all()
        ->project(~[
            periodId:x|$x.periodId,
            paymentDate:x|$x.paymentDate,
            isPaid:x|$x.isPaid,
            awaitingPayment:x|$x.payment->isEmpty()
        ])
        ->sort(~periodId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    FI4_UnpaidPeriods_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 130 rows; 43 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"periodId":"DE000A289N78-001","paymentDate":"2021-06-05","isPaid":true,"awaitingPayment":false},{"periodId":"DE000A289N78-002","paymentDate":"2022-06-05","isPaid":true,"awaitingPayment":false},{"periodId":"DE000A289N78-003","paymentDate":"2023-06-05","isPaid":true,"awaitingPayment":false},{"periodId":"DE000A289N78-004","paymentDate":"2024-06-05","isPaid":true,"awaitingPayment":false},{"periodId":"DE000A289N78-005","paymentDate":"2025-06-05","isPaid":false,"awaitingPayment":true},{"periodId":"DE000A289N78-006","paymentDate":"2026-06-05","isPaid":false,"awaitingPayment":true},{"periodId":"DE000A289N78-007","paymentDate":"2027-06-05","isPaid":false,"awaitingPayment":true},{"periodId":"US037833DX90-001","paymentDate":"2021-02-20","isPaid":true,"awaitingPayment":false},{"periodId":"US037833DX90-002","paymentDate":"2021-08-20","isPaid":true,"awaitingPayment":false},{"periodId":"US037833DX90-003","paymentDate":"2022-02-20","isPaid":true,"awaitingPayment":false},{"periodId":"US037833DX90-004","paymentDate":"2022-08-20","isPaid":true,"awaitingPayment":false},{"periodId":"US037833DX90-005","paymentDate":"2023-02-20","isPaid":true,"awaitingPayment":false},{"periodId":"US037833DX90-006","paymentDate":"2023-08-20","isPaid":true,"awaitingPayment":false},{"periodId":"US037833DX90-007","paymentDate":"2024-02-20","isPaid":true,"awaitingPayment":false},{"periodId":"US037833DX90-008","paymentDate":"2024-08-20","isPaid":false,"awaitingPayment":true},{"periodId":"US037833DX90-009","paymentDate":"2025-02-20","isPaid":false,"awaitingPayment":true},{"periodId":"US037833DX90-010","paymentDate":"2025-08-20","isPaid":false,"awaitingPayment":true},{"periodId":"US037833DX90-011","paymentDate":"2026-02-20","isPaid":false,"awaitingPayment":true},{"periodId":"US037833DX90-012","paymentDate":"2026-08-20","isPaid":false,"awaitingPayment":true},{"periodId":"US912810TM08-001","paymentDate":"2019-11-30","isPaid":true,"awaitingPayment":false},{"periodId":"US912810TM08-002","