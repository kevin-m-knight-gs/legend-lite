          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"memberId":"CM-0001","ccpMarginCallsEmpty":false,"ccpMarginCallsAny":true,"clearedTradesEmpty":false,"clearedTradesAny":true,"clearingFeesEmpty":false,"clearingFeesAny":true},{"memberId":"CM-0002","ccpMarginCallsEmpty":false,"ccpMarginCallsAny":true,"clearedTradesEmpty":false,"clearedTradesAny":true,"clearingFeesEmpty":false,"clearingFeesAny":true},{"memberId":"CM-0003","ccpMarginCallsEmpty":false,"ccpMarginCallsAny":true,"clearedTradesEmpty":false,"clearedTradesAny":true,"clearingFeesEmpty":false,"clearingFeesAny":true},{"memberId":"CM-0004","ccpMarginCallsEmpty":true,"ccpMarginCallsAny":false,"clearedTradesEmpty":true,"clearedTradesAny":false,"clearingFeesEmpty":true,"clearingFeesAny":false},{"memberId":"CM-0005","ccpMarginCallsEmpty":true,"ccpMarginCallsAny":false,"clearedTradesEmpty":true,"clearedTradesAny":false,"clearingFeesEmpty":true,"clearingFeesAny":false}]';
