                    data: '{"builder":{"_type":"json"},"values":[{"counterpartyId":"CP-0001","rating":"AA-","outlook":"STABLE"},{"counterpartyId":"CP-0002","rating":"A+","outlook":"STABLE"},{"counterpartyId":"CP-0003","rating":"BB+","outlook":"NEGATIVE"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F20_NotionalByBook
{
    pattern: '/stress/f20';
    documentation: 'The rollup View: notional by book, grouped by the engine. Its rows are GROUPS, so BK-LEGACY -- which has no trades -- produces no group and is ABSENT. Contrast F2_BookChildCounts, which outer-joins from BOOK and returns a row for it. Two defensible answers to one question, differing on exactly the empty case, both asserted here.';
    execution: Single
    {
    query: |reporting::BookRollup.all()
        ->project(~[
            bookId:x|$x.bookId,
            tradeCount:x|$x.tradeCount,
            totalNotional:x|$x.totalNotional,
            maxNotional:x|$x.maxNotional
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F20_NotionalByBook_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bookId":"BK-CASH-US","tradeCount":10,"totalNotional":2961025.0,"maxNotional":576750.0},{"bookId":"BK-VOL-01","tradeCount":5,"totalNotional":8466500.0,"maxNotional":4912500.0},{"bookId":"BK-CASH-EU","tradeCount":5,"totalNotional":924850.0,"maxNotional":385000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F21_TraderManagerChain
{
    pattern: '/stress/f21';
    documentation: 'A {target} self-join walked two levels. TRD-001 and TRD-003 report to nobody (absent key), TRD-004 reports to a trader who has left (dangling key), and the two-level hop reaches a manager\'s manager. All three must come back as rows with NULLs where the chain stops -- never a dropped row and never a loop.';
    execution: Single
    {
    query: |org::Trader.all()
        ->project(~[
            traderId:x|$x.traderId,
            lastName:x|$x.lastName,
            mgrId:x|$x.manager.traderId,
            mgrLast:x|$x.manager.lastName,
            mgrDesk:x|$x.manager.desk.name,
            grandMgrId:x|$x.manager.manager.traderId,
            grandMgrLast:x|$x.manager.manager.lastName
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F21_TraderManagerChain_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"traderId":"TRD-001","lastName":"Alvarez","mgrId":null,"mgrLast":null,"mgrDesk":null,"grandMgrId":null,"grandMgrLast":null},{"traderId":"TRD-002","lastName":"Watanabe","mgrId":"TRD-001","mgrLast":"Alvarez","mgrDesk":"Cash Equities","grandMgrId":null,"grandMgrLast":null},{"traderId":"TRD-003","lastName":"O\'Brien","mgrId":"TRD-001","mgrLast":"Alvarez","mgrDesk":"Cash Equities","grandMgrId":null,"grandMgrLast":null},{"traderId":"TRD-004","lastName":"Nowak","mgrId":null,"mgrLast":null,"mgrDesk":null,"grandMgrId":null,"grandMgrLast":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F7_TradeDerivedProperties
{
    pattern: '/stress/f7';
    documentation: 'Derived properties alongside the columns they are computed from, so a wrong value cannot hide: grossAmount is total arithmetic over two [1] measures.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            quantity:x|$x.quantity,
            price:x|$x.price,
            commission:x|$x.commission,
            fees:x|$x.fees,
            settlementDate:x|$x.settlementDate,
            side:x|$x.side,
            grossAmount:x|$x.grossAmount,
            grossInGbp:x|$x.grossAmountIn(0.79),
            grossInEur:x|$x.grossAmountIn(0.92)
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F7_TradeDerivedProperties_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
