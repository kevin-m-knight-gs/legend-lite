Service stress::N3_TradeInlineFlat
{
    pattern: '/stress/n3';
    documentation: 'Mapping invariance, inline side: identical query to N0 and N2, resolved by a mapping whose embedded counterparty is `Inline[cptyInline]` -- an empty property block delegating to a root set implementation over the same table.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            side:x|$x.side,
            status:x|$x.status,
            currency:x|$x.currency,
            grossAmount:x|$x.grossAmount,
            instrName:x|$x.instrument.name,
            instrTicker:x|$x.instrument.ticker,
            instrIsin:x|$x.instrument.isin,
            bookName:x|$x.book.name,
            cptyName:x|$x.counterparty.legalName,
            cptyLei:x|$x.counterparty.lei,
            traderLast:x|$x.trader.lastName
        ]);
        mapping: reporting::InlineFlatMapping;
        runtime: stress::InlineFlatRT;
    }
  testSuites:
  [
    N3_TradeInlineFlat_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
