Service stress::AA_SettlementNettingCounts
{
    pattern: '/stress/aa_settlementnetting';
    documentation: 'Generated aggregate on settlement::SettlementNetting: 1 count(s) over to-many associations, every parent of which HAS children. This is the non-empty half of the property the F-series pins on the empty half -- F6 makes count() over an empty to-many return 1, so an end with any childless parent is excluded here rather than quarantined. Several counts on one root so the outer joins interact; a single-aggregate probe cannot show that. Generated by scripts/corpus/aggregates.py.';
    execution: Single
    {
    query: |settlement::SettlementNetting.all()
        ->project(~[
            nettingId:x|$x.nettingId,
            settlementsCount:x|$x.settlements->count()
        ])
        ->sort(~nettingId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    AA_SettlementNettingCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"nettingId":"NET-003","settlementsCount":1},{"nettingId":"NET-006","settlementsCount":1},{"nettingId":"NET-009","settlementsCount":1},{"nettingId":"NET-012","settlementsCount":1},{"nettingId":"NET-015","settlementsCount":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

