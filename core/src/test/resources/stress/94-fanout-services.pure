              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"tradeId":"TRD-0001","notional":190500.0,"status":"EXECUTED"},{"tradeId":"TRD-0002","notional":477500.0,"status":"EXECUTED"},{"tradeId":"TRD-0003","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0004","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0005","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0006","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0007","notional":282000.0,"status":"EXECUTED"},{"tradeId":"TRD-0008","notional":18975.0,"status":"CANCELLED"},{"tradeId":"TRD-0009","notional":576750.0,"status":"EXECUTE"},{"tradeId":"TRD-0010","notional":498000.0,"status":"EXECUTED"},{"tradeId":"TRD-0011","notional":167300.0,"status":"EXECUTED"},{"tradeId":"TRD-0012","notional":369000.0,"status":"PENDING"},{"tradeId":"TRD-0013","notional":171250.0,"status":"EXECUTED"},{"tradeId":"TRD-0014","notional":69000.0,"status":"EXECUTED"},{"tradeId":"TRD-0015","notional":35000.0,"status":"SETTLED"},{"tradeId":"TRD-0016","notional":264600.0,"status":"EXECUTED"},{"tradeId":"TRD-0017","notional":385000.0,"status":"EXECUTED"},{"tradeId":"TRD-0018","notional":4912500.0,"status":"EXECUTED"},{"tradeId":"TRD-0019","notional":1960000.0,"status":"EXECUTED"},{"tradeId":"TRD-0020","notional":975000.0,"status":"REJECTED"}]}';
