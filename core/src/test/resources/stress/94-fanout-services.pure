Service stress::N1_TradeFlat
{
    pattern: '/stress/n1';
    documentation: 'Mapping invariance, reporting side: the identical question answered from one denormalized table through reporting::FlatMapping. Must return exactly the rows N0 returns.';
    execution: Single
    {
    query: |reporting::FlatTrade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            side:x|$x.side,
            status:x|$x.status,
            currency:x|$x.currency,
            grossAmount:x|$x.grossAmount,
            instrName:x|$x.instrName,
            instrTicker:x|$x.instrTicker,
            instrIsin:x|$x.instrIsin,
            bookName:x|$x.bookName,
            cptyName:x|$x.cptyName,
            cptyLei:x|$x.cptyLei,
            traderLast:x|$x.traderLast
        ]);
        mapping: reporting::FlatMapping;
        runtime: stress::FlatRT;
    }
  testSuites:
  [
    N1_TradeFlat_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
