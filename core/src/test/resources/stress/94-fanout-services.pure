    pattern: '/stress/txm_globaldepositaryreceipt';
    documentation: 'securities::GlobalDepositaryReceipt only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |securities::GlobalDepositaryReceipt.all()
        ->project(~[
            securityKey:x|$x.securityKey,
            securityType:x|$x.securityType,
            daysToMaturity:x|$x.daysToMaturity,
            issuerName:x|$x.issuerName,
            faceValue:x|$x.faceValue,
            isListed:x|$x.isListed
        ])
        ->sort(~securityKey->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TXM_GlobalDepositaryReceipt_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"securityKey":"SM-00004","securityType":"GDR","daysToMaturity":null,"issuerName":"Northbridge Capital","faceValue":null,"isListed":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

