    pattern: '/stress/colx_germanbundcollateral';
    documentation: 'collateraltypes::GermanBundCollateral only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |collateraltypes::GermanBundCollateral.all()
        ->project(~[
            holdingId:x|$x.holdingId,
            collateralType:x|$x.collateralType,
            collateralValue:x|$x.collateralValue,
            haircutPct:x|$x.haircutPct,
            custodian:x|$x.custodian,
            isEligible:x|$x.isEligible
        ])
        ->sort(~holdingId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    COLX_GermanBundCollateral_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"holdingId":"COL-00005","collateralType":"GOVT_BOND_DE","collateralValue":3377500.0,"haircutPct":3.5,"custodian":null,"isEligible":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

