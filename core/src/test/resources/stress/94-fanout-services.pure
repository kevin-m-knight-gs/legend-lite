Service stress::OT0_TradeBook
{
    pattern: '/stress/ot0';
    documentation: 'The OTC book: every trade with its tenor and its notional converted at a supplied rate. clearingHouse and masterAgreement are null for the bilateral trades, which is most of them.';
    execution: Single
    {
    query: |derivatives::OtcTrade.all()
        ->project(~[
            otcId:x|$x.otcId,
            productType:x|$x.productType,
            assetClass:x|$x.assetClass,
            notional:x|$x.notional,
            currency:x|$x.currency,
            clearingHouse:x|$x.clearingHouse,
            masterAgreement:x|$x.masterAgreement,
            tenorYears:x|$x.tenorYears,
            notionalGbp:x|$x.notionalIn(0.79)
        ])
        ->sort(~otcId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT0_TradeBook_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 13 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"otcId":"OTC-000001","productType":"IRS","assetClass":"RATES","notional":50000000.0,"currency":"USD","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":5.002739726027397,"notionalGbp":39500000.0},{"otcId":"OTC-000002","productType":"OIS","assetClass":"RATES","notional":25000000.0,"currency":"USD","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":2.0,"notionalGbp":19750000.0},{"otcId":"OTC-000003","productType":"BASIS_SWAP","assetClass":"RATES","notional":75000000.0,"currency":"EUR","clearingHouse":"EUREX","masterAgreement":"ISDA_2002","tenorYears":3.0027397260273974,"notionalGbp":59250000.0},{"otcId":"OTC-000004","productType":"FRA","assetClass":"RATES","notional":100000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":0.25205479452054796,"notionalGbp":79000000.0},{"otcId":"OTC-000005","productType":"SWAPTION","assetClass":"RATES","notional":40000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":5.002739726027397,"notionalGbp":31600000.0},{"otcId":"OTC-000006","productType":"CAP","assetClass":"RATES","notional":30000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":3.0,"notionalGbp":23700000.0},{"otcId":"OTC-000007","productType":"CDS","assetClass":"CREDIT","notional":10000000.0,"currency":"USD","clearingHouse":"ICE","masterAgreement":"ISDA_2014","tenorYears":5.252054794520548,"notionalGbp":7900000.0},{"otcId":"OTC-000008","productType":"CDS_INDEX","assetClass":"CREDIT","notional":250000000.0,"currency":"EUR","clearingHouse":"ICE","masterAgreement":"ISDA_2014","tenorYears":5.252054794520548,"notionalGbp":197500000.0},{"otcId":"OTC-000009","productType":"NDF","assetClass":"FX","notional":20000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":0.5013698630136987,"notionalGbp":15800000.0},{"otcId":"OTC-000010","productType":"FX_OPTION","assetClass":"FX","notional":15000000.0,"currency":"EUR","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":1.0,"notionalGbp":11850000.0},{"otcId":"OTC-000011","productType":"EQUITY_SWAP","assetClass":"EQUITY","notional":35000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":1.0027397260273974,"notionalGbp":27650000.0},{"otcId":"OTC-000012","productType":"VARIANCE_SWAP","assetClass":"EQUITY","notional":5000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":0.5013698630136987,"notionalGbp":3950000.0},{"otcId":"OTC-000013","productType":"COMMODITY_SWAP","assetClass":"COMMODITY","notional":8000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":null,"tenorYears":1.0,"notionalGbp":6320000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::OT1_SwapLegs
{
    pattern: '/stress/ot1';
    documentation: 'Swap legs with their parent\'s product type. Fixed legs carry a rate and no index; floating legs the reverse; a basis swap has floating on BOTH sides, so neither of its legs has a fixed rate.';
    execution: Single
    {
    query: |derivatives::SwapLeg.all()
        ->project(~[
            legId:x|$x.legId,
            legNumber:x|$x.legNumber,
            legType:x|$x.legType,
            payReceive:x|$x.payReceive,
            fixedRate:x|$x.fixedRate,
            floatingIndex:x|$x.floatingIndex,
            spreadBp:x|$x.spreadBp,
            dayCount:x|$x.dayCount,
            productType:x|$x.trade.productType,
            counterpartyId:x|$x.trade.counterpartyId
        ])
        ->sort(~legId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT1_SwapLegs_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 10 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"legId":"OTC-000001-1","legNumber":1,"legType":"FIXED","payReceive":"PAY","fixedRate":3.85,"floatingIndex":null,"spreadBp":null,"dayCount":"30/360","productType":"IRS","counterpartyId":"CP-0001"},{"legId":"OTC-000001-2","legNumber":2,"legType":"FLOATING","payReceive":"RECEIVE","fixedRate":null,"floatingIndex":"USD-SOFR","spreadBp":0.0,"dayCount":"ACT/360","productType":"IRS","counterpartyId":"CP-0001"},{"legId":"OTC-000002-1","legNumber":1,"legType":"FIXED","payReceive":"RECEIVE","fixedRate":4.1,"floatingIndex":null,"spreadBp":null,"dayCount":"ACT/360","productType":"OIS","counterpartyId":"CP-0002"},{"legId":"OTC-000002-2","legNumber":2,"legType":"FLOATING","payReceive":"PAY","fixedRate":null,"floatingIndex":"USD-SOFR-OIS","spreadBp":0.0,"dayCount":"ACT/360","productType":"OIS","counterpartyId":"CP-0002"},{"legId":"OTC-000003-1","legNumber":1,"legType":"FLOATING","payReceive":"PAY","fixedRate":null,"floatingIndex":"EUR-EURIBOR-3M","spreadBp":0.0,"dayCount":"ACT/360","productType":"BASIS_SWAP","counterpartyId":"CP-0001"},{"legId":"OTC-000003-2","legNumber":2,"legType":"FLOATING","payReceive":"RECEIVE","fixedRate":null,"floatingIndex":"EUR-EURIBOR-6M","spreadBp":-4.5,"dayCount":"ACT/360","productType":"BASIS_SWAP","counterpartyId":"CP-0001"},{"legId":"OTC-000011-1","legNumber":1,"legType":"EQUITY","payReceive":"RECEIVE","fixedRate":null,"floatingIndex":"SPX-TOTAL-RETURN","spreadBp":null,"dayCount":"ACT/365","productType":"EQUITY_SWAP","counterpartyId":"CP-0001"},{"legId":"OTC-000011-2","legNumber":2,"legType":"FLOATING","payReceive":"PAY","fixedRate":null,"floatingIndex":"USD-SOFR","spreadBp":35.0,"dayCount":"ACT/360","productType":"EQUITY_SWAP","counterpartyId":"CP-0001"},{"legId":"OTC-000013-1","legNumber":1,"legType":"FIXED","payReceive":"PAY","fixedRate":78.5,"floatingIndex":null,"spreadBp":null,"dayCount":"ACT/365","productType":"COMMODITY_SWAP","counterpartyId":"CP-0005"},{"legId":"OTC-000013-2","legNumber":2,"legType":"COMMODITY","payReceive":"RECEIVE","fixedRate":null,"floatingIndex":"WTI-NYMEX-FRONT","spreadBp":null,"dayCount":"ACT/365","productType":"COMMODITY_SWAP","counterpartyId":"CP-0005"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::OT2_NotionalByAssetClass
{
    pattern: '/stress/ot2';
    documentation: 'Notional by asset class and clearing status: the roll-up a derivatives risk pack opens with.';
    execution: Single
    {
    query: |derivatives::OtcTrade.all()
        ->project(~[
            assetClass:x|$x.assetClass,
            clearingStatus:x|$x.clearingStatus,
            notional:x|$x.notional
        ])
        ->groupBy(~[assetClass, clearingStatus], ~[
            tradeCount: x|$x.notional : agg|$agg->count(),
            totalNotional: x|$x.notional : agg|$agg->sum(),
            largestTrade: x|$x.notional : agg|$agg->max()
        ])
        ->sort(~assetClass->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT2_NotionalByAssetClass_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"assetClass":"COMMODITY","clearingStatus":"BILATERAL","tradeCount":1,"totalNotional":8000000.0,"largestTrade":8000000.0},{"assetClass":"CREDIT","clearingStatus":"CLEARED","tradeCount":2,"totalNotional":260000000.0,"largestTrade":250000000.0},{"assetClass":"EQUITY","clearingStatus":"BILATERAL","tradeCount":2,"totalNotional":40000000.0,"largestTrade":35000000.0},{"assetClass":"FX","clearingStatus":"BILATERAL","tradeCount":2,"totalNotional":35000000.0,"largestTrade":20000000.0},{"assetClass":"RATES","clearingStatus":"CLEARED","tradeCount":3,"totalNotional":150000000.0,"largestTrade":75000000.0},{"assetClass":"RATES","clearingStatus":"BILATERAL","tradeCount":3,"totalNotional":170000000.0,"largestTrade":100000000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::OT3_InterestRateSwaps
{
    pattern: '/stress/ot3';
    documentation: 'Interest rate swaps only, with the DV01 a rates desk sizes them by. The discriminator is the point: if the ~filter were wrong this would return all thirteen OTC trades rather than the one that is an IRS.';
    execution: Single
    {
    query: |derivatives::InterestRateSwap.all()
        ->project(~[
            otcId:x|$x.otcId,
            productType:x|$x.productType,
            notional:x|$x.notional,
            tenorYears:x|$x.tenorYears,
            dv01:x|$x.dv01
        ])
        ->sort(~otcId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT3_InterestRateSwaps_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"otcId":"OTC-000001","productType":"IRS","notional":50000000.0,"tenorYears":5.002739726027397,"dv01":25013.698630136987}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::OT4_CreditProtection
{
    pattern: '/stress/ot4';
