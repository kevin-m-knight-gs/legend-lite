Service stress::A1_FactRollup
{
    pattern: '/stress/a1';
    documentation: 'A groupBy matching the declared view exactly. Legacy TDS form on purpose: the AggregationAware rewrite dispatches only on that signature, so the same query written with ~[...] would silently read the detail table instead.';
    execution: Single
    {
    query: |reporting::TradeFact.all()
        ->groupBy(
            [x|$x.bookId],
            [agg(x|$x.notional, y|$y->sum())],
            ['bookId', 'totalNotional']
        );
        mapping: reporting::AggregationAwareMapping;
        runtime: stress::AggregationRT;
    }
  testSuites:
  [
    A1_FactRollup_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bookId":"BK-CASH-US","totalNotional":2961025.0},{"bookId":"BK-VOL-01","totalNotional":8466500.0},{"bookId":"BK-CASH-EU","totalNotional":924850.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

