              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MO3_BreakAgeing
{
    pattern: '/stress/mo3';
    documentation: 'Break ageing with the disputed field and both sides\' values. A confirmation break has no single field in dispute, so those columns are null for it.';
