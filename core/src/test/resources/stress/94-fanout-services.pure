Service stress::F5_TraderChildCounts
{
    pattern: '/stress/f5';
    documentation: 'Fan-out with a NULL foreign key on the child side: two trades carry no trader, so they must be counted under no trader rather than under all of them.';
    execution: Single
    {
    query: |org::Trader.all()
        ->project(~[
            traderId:x|$x.traderId,
            firstName:x|$x.firstName,
            lastName:x|$x.lastName,
            seniority:x|$x.seniority,
            isActive:x|$x.isActive,
            deskName:x|$x.desk.name,
            tradeCount:x|$x.trades->count(),
            pnlCount:x|$x.dailyPnLs->count()
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F5_TraderChildCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"traderId":"TRD-001","firstName":"Maria","lastName":"Alvarez","seniority":"MD","isActive":true,"deskName":"Cash Equities","tradeCount":4,"pnlCount":1},{"traderId":"TRD-002","firstName":"Kenji","lastName":"Watanabe","seniority":"VP","isActive":true,"deskName":"Cash Equities","tradeCount":4,"pnlCount":1},{"traderId":"TRD-003","firstName":"Aoife","lastName":"O\'Brien","seniority":"ED","isActive":true,"deskName":"Equity Derivatives","tradeCount":7,"pnlCount":3},{"traderId":"TRD-004","firstName":"Peter","lastName":"Nowak","seniority":"Analyst","isActive":false,"deskName":"Equity Derivatives","tradeCount":3,"pnlCount":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F6_PositionGreeksCounts
{
    pattern: '/stress/f6';
    documentation: 'Fan-out on the shallowest possible association, so a failure here cannot be blamed on join depth. Three of six positions have no greeks row.';
    execution: Single
    {
    query: |positions::Position.all()
        ->project(~[
            positionId:x|$x.positionId,
            direction:x|$x.direction,
            currency:x|$x.currency,
            isOpen:x|$x.isOpen,
            instrumentName:x|$x.instrument.name,
            greeksCount:x|$x.greeks->count()
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F6_PositionGreeksCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 3 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"positionId":"POS-0001","direction":"LONG","currency":"USD","isOpen":true,"instrumentName":"Apple Inc","greeksCount":1},{"positionId":"POS-0002","direction":"LONG","currency":"USD","isOpen":true,"instrumentName":"Microsoft Corp","greeksCount":1},{"positionId":"POS-0003","direction":"SHORT","currency":"GBP","isOpen":true,"instrumentName":"HSBC Holdings plc","greeksCount":0},{"positionId":"POS-0004","direction":"LONG","currency":"GBP","isOpen":true,"instrumentName":"SAP SE","greeksCount":0},{"positionId":"POS-0005","direction":"LONG","currency":"GBP","isOpen":true,"instrumentName":"UK Gilt 4.25% 2055","greeksCount":1},{"positionId":"POS-0006","direction":"FLAT","currency":"GBP","isOpen":false,"instrumentName":"Nestle SA","greeksCount":0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::D_SalesCreditDense
{
    pattern: '/stress/d_salescredit';
    documentation: 'Dense stack on sales::SalesCredit: several distinct navigation chains plus whatever the model offers along them, with a filter, a sort and a limit. Generated from the model by scripts/corpus/stacks.py, so it deepens as the model does rather than needing a new hand-written service per domain.';
    execution: Single
    {
    query: |sales::SalesCredit.all()
        ->filter({x|($x.currency > ' ')})
        ->project(~[
            creditId:x|$x.creditId,
            salesPersonDeskBusinessUnitName:x|$x.salesPerson.desk.businessUnit.name,
            tradeOrderInstrumentCurrency:x|$x.trade.order.instrument.currency,
            tradeInstrumentSectorName:x|$x.trade.instrument.sector.name,
            tradeSide:x|$x.trade.side,
            tradeGrossAmount:x|$x.trade.grossAmount,
            tradeGrossAmountInQ:x|$x.trade.grossAmountIn(0.5)
        ])
        ->sort(~creditId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    D_SalesCreditDense_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 12 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"creditId":"SC-0001","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeGrossAmount":190500.0,"tradeGrossAmountInQ":95250.0},{"creditId":"SC-0002","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeGrossAmount":477500.0,"tradeGrossAmountInQ":238750.0},{"creditId":"SC-0003","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeGrossAmount":250000.0,"tradeGrossAmountInQ":125000.0},{"creditId":"SC-0004","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"SELL","tradeGrossAmount":250000.0,"tradeGrossAmountInQ":125000.0},{"creditId":"SC-0005","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeGrossAmount":250000.0,"tradeGrossAmountInQ":125000.0},{"creditId":"SC-0006","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeGrossAmount":250000.0,"tradeGrossAmountInQ":125000.0},{"creditId":"SC-0007","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeGrossAmount":282000.0,"tradeGrossAmountInQ":141000.0},{"creditId":"SC-0008","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","tradeSide":"BUY","tradeGrossAmount":18975.0,"tradeGrossAmountInQ":9487.5},{"creditId":"SC-0009","salesPersonDeskBusinessUnitName":null,"tradeOrderInstrumentCurrency":null,"tradeInstrumentSectorName":"Information Technology","