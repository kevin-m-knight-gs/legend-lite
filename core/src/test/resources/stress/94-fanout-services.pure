Service stress::N4_TradeMultiExecution
{
    pattern: '/stress/n4';
    documentation: 'MultiExecution: ONE query, run against the canonical mapping and the embedded flat mapping under two keys. Both must return the same rows -- the L2 invariance, asserted without a second query to keep in sync.';
    execution: Multi
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            side:x|$x.side,
            status:x|$x.status,
            currency:x|$x.currency,
            grossAmount:x|$x.grossAmount,
            instrName:x|$x.instrument.name,
            instrTicker:x|$x.instrument.ticker,
            instrIsin:x|$x.instrument.isin,
            bookName:x|$x.book.name,
            cptyName:x|$x.counterparty.legalName,
            cptyLei:x|$x.counterparty.lei,
            traderLast:x|$x.trader.lastName
        ]);
        key: 'shape';
        executions['canonical']:
        {
            mapping: stress::AllMapping;
            runtime: stress::RT;
        }
        executions['flat']:
        {
            mapping: reporting::EmbeddedFlatMapping;
            runtime: stress::EmbeddedFlatRT;
        }
    }
  testSuites:
  [
    N4_TradeMultiExecution_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows_canonical:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys:
          [
            'canonical'
          ];
