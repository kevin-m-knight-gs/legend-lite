    pattern: '/stress/mktx_volatilityindexmark';
    documentation: 'marks::VolatilityIndexMark only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |marks::VolatilityIndexMark.all()
        ->project(~[
            pointId:x|$x.pointId,
            dataType:x|$x.dataType,
            dailyChange:x|$x.dailyChange,
            source:x|$x.source,
            tenor:x|$x.tenor,
            isStale:x|$x.isStale
        ])
        ->sort(~pointId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MKTX_VolatilityIndexMark_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"pointId":"MKT-00020","dataType":"VOLATILITY_INDEX","dailyChange":0.85,"source":"ICE","tenor":"5Y","isStale":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

