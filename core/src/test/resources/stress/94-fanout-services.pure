    execution: Single
    {
    query: |counterparty::RatingVersion.all(%2021-01-01)
        ->project(~[
            counterpartyId:x|$x.counterpartyId,
            rating:x|$x.rating,
            agency:x|$x.agency,
            outlook:x|$x.outlook,
            isInvestmentGrade:x|$x.isInvestmentGrade
        ]);
