Service stress::MR2_HistoricalVar
{
    pattern: '/stress/mr2';
    documentation: 'Historical VaR only, across runs. The discriminator is the point: eleven measures in the table, three of them this type.';
    execution: Single
    {
    query: |risk::HistoricalVar.all()
        ->project(~[
            measureId:x|$x.measureId,
            scope:x|$x.scope,
            measureValue:x|$x.measureValue,
            lookbackDays:x|$x.lookbackDays
        ])
        ->sort(~measureId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MR2_HistoricalVar_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"measureId":"MEAS-00001","scope":"FIRM","measureValue":4185000.0,"lookbackDays":520},{"measureId":"MEAS-00010","scope":"RATES_DESK","measureValue":1320000.0,"lookbackDays":520},{"measureId":"MEAS-00011","scope":"FIRM","measureValue":4092000.0,"lookbackDays":520}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MR3_SensitivityLadder
{
    pattern: '/stress/mr3';
    documentation: 'The sensitivity ladder: every exposure with the factor it loads on and the trade it came from. A spot factor has no tenor, so those rows carry a null where the curve rows carry a bucket.';
    execution: Single
    {
    query: |risk::Sensitivity.all()
        ->project(~[
            sensitivityId:x|$x.sensitivityId,
            measureType:x|$x.measureType,
            measureValue:x|$x.measureValue,
            curveName:x|$x.factor.curveName,
            tenor:x|$x.factor.tenor,
            assetClass:x|$x.factor.assetClass,
            productType:x|$x.sensitivityTrade.productType,
            notional:x|$x.sensitivityTrade.notional
        ])
        ->sort(~sensitivityId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MR3_SensitivityLadder_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
