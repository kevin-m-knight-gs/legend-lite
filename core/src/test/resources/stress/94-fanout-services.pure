Service stress::SP_defYieldCurveCount
{
    pattern: '/stress/sp_defyieldcurvecount';
    documentation: 'Coverage-directed stack on curves::YieldCurve (Count), reusing the reach of AA_CurvesYieldCurveCounts and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |curves::YieldCurve.all()
        ->filter({x|($x.curveId > ' ')})
        ->project(~[
            curveId:x|$x.curveId,
            benchmarkSeriesCurrency:x|$x.benchmarkSeries.currency,
            benchmarkSeriesIsDaily:x|$x.benchmarkSeries.isDaily,
            pointsCount:x|$x.points->count()
        ])
        ->sort(~curveId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    SP_defYieldCurveCount_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 8 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","benchmarkSeriesCurrency":"EUR","benchmarkSeriesIsDaily":true,"pointsCount":24},{"curveId":"EUR.ESTR.OIS","benchmarkSeriesCurrency":"EUR","benchmarkSeriesIsDaily":true,"pointsCount":24},{"curveId":"EUR.EURIBOR.6M","benchmarkSeriesCurrency":"EUR","benchmarkSeriesIsDaily":true,"pointsCount":24},{"curveId":"GBP.SONIA.OIS","benchmarkSeriesCurrency":null,"benchmarkSeriesIsDaily":null,"pointsCount":24},{"curveId":"JPY.TONA.OIS","benchmarkSeriesCurrency":null,"benchmarkSeriesIsDaily":null,"pointsCount":24},{"curveId":"USD.LIBOR.3M","benchmarkSeriesCurrency":null,"benchmarkSeriesIsDaily":null,"pointsCount":24},{"curveId":"USD.SOFR.OIS","benchmarkSeriesCurrency":"USD","benchmarkSeriesIsDaily":true,"pointsCount":24},{"curveId":"USD.UST.GOVT","benchmarkSeriesCurrency":"USD","benchmarkSeriesIsDaily":true,"pointsCount":24}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

