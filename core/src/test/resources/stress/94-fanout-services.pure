Service stress::D0_SettlementDense
{
    pattern: '/stress/d0';
    documentation: 'Dense stack on settlement::Settlement: several distinct navigation chains plus whatever the model offers along them, with a filter, a sort and a limit. Generated from the model by scripts/corpus/stacks.py, so it deepens as the model does rather than needing a new hand-written service per domain.';
    execution: Single
    {
    query: |settlement::Settlement.all()
        ->filter({x|($x.currency != ' none')})
        ->project(~[
            settlementId:x|$x.settlementId,
            tradeInstrumentSectorName:x|$x.trade.instrument.sector.name,
            tradeInstrumentInstrumentCurrencyName:x|$x.trade.instrument.instrumentCurrency.name,
            tradeInstrumentExchangeName:x|$x.trade.instrument.exchange.name,
            tradeSide:x|$x.trade.side,
            tradeGrossAmount:x|$x.trade.grossAmount
        ])
        ->sort(~settlementId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    D0_SettlementDense_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 18 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
