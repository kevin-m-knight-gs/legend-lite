    pattern: '/stress/liqx_wholesalefundingmetric';
    documentation: 'liquidity::WholesaleFundingMetric only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |liquidity::WholesaleFundingMetric.all()
        ->project(~[
            metricId:x|$x.metricId,
            metricType:x|$x.metricType,
            bufferOverMinimum:x|$x.bufferOverMinimum,
            regulatoryMinimum:x|$x.regulatoryMinimum,
            isBreached:x|$x.isBreached,
            horizonDays:x|$x.horizonDays
        ])
        ->sort(~metricId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    LIQX_WholesaleFundingMetric_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"metricId":"LIQ-00010","metricType":"WHOLESALE_FUNDING","bufferOverMinimum":58.75,"regulatoryMinimum":80.0,"isBreached":false,"horizonDays":30}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

