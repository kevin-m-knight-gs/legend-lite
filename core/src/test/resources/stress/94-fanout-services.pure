Service stress::MD3_UnrevisedPrints
{
    pattern: '/stress/md3';
    documentation: 'Observations that are not final: the three monthly series\' latest prints are flash estimates and the earliest are restatements. Filtering on status is what separates a measurement from a forecast, and the corpus should not be able to average them together by accident.';
    execution: Single
    {
    query: |timeseries::Observation.all()
        ->filter({x|!$x.isFinal})
        ->project(~[
            obsId:x|$x.obsId,
            obsDate:x|$x.obsDate,
            obsValue:x|$x.obsValue,
            status:x|$x.status,
            isFinal:x|$x.isFinal,
            frequency:x|$x.series.frequency
        ])
        ->sort(~obsId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MD3_UnrevisedPrints_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"obsId":"OBS-CPI.US.YOY-01","obsDate":"2024-04-30","obsValue":3.4,"status":"REVISED","isFinal":false,"frequency":"MONTHLY"},{"obsId":"OBS-CPI.US.YOY-03","obsDate":"2024-06-28","obsValue":3.0,"status":"PRELIM","isFinal":false,"frequency":"MONTHLY"},{"obsId":"OBS-HICP.EA.YOY-01","obsDate":"2024-04-30","obsValue":2.4,"status":"REVISED","isFinal":false,"frequency":"MONTHLY"},{"obsId":"OBS-HICP.EA.YOY-03","obsDate":"2024-06-28","obsValue":2.5,"status":"PRELIM","isFinal":false,"frequency":"MONTHLY"},{"obsId":"OBS-UNRATE.US-01","obsDate":"2024-04-30","obsValue":3.9,"status":"REVISED","isFinal":false,"frequency":"MONTHLY"},{"obsId":"OBS-UNRATE.US-03","obsDate":"2024-06-28","obsValue":4.1,"status":"PRELIM","isFinal":false,"frequency":"MONTHLY"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MD7_UnrevisedPrintsEq
{
    pattern: '/stress/md7';
    documentation: 'MD3 with the filter written `isFinal == false` instead of `!isFinal`. The two mean the same thing and one of them reaches DuckDB as SQL it rejects with a parser error. Quarantined under F50; the probe at scripts/corpus/probe_derived_filter.py separates this from the four derived-property filter forms that work.';
    execution: Single
    {
    query: |timeseries::Observation.all()
        ->filter({x|($x.isFinal == false)})
        ->project(~[
            obsId:x|$x.obsId,
            obsDate:x|$x.obsDate,
            obsValue:x|$x.obsValue,
            status:x|$x.status,
            isFinal:x|$x.isFinal,
            frequency:x|$x.series.frequency
        ])
        ->sort(~obsId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MD7_UnrevisedPrintsEq_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"obsId":"OBS-CPI.US.YOY-01","obsDate":"2024-04-30","obsValue":3.4,"status":"REVISED","isFinal":false,"frequency":"MONTHLY"},{"obsId":"OBS-CPI.US.YOY-03","obsDate":"2024-06-28","obsValue":3.0,"status":"PRELIM","isFinal":false,"frequency":"MONTHLY"},{"obsId":"OBS-HICP.EA.YOY-01","obsDate":"2024-04-30","obsValue":2.4,"status":"REVISED","isFinal":false,"frequency":"MONTHLY"},{"obsId":"OBS-HICP.EA.YOY-03","obsDate":"2024-06-28","obsValue":2.5,"status":"PRELIM","isFinal":false,"frequency":"MONTHLY"},{"obsId":"OBS-UNRATE.US-01","obsDate":"2024-04-30","obsValue":3.9,"status":"REVISED","isFinal":false,"frequency":"MONTHLY"},{"obsId":"OBS-UNRATE.US-03","obsDate":"2024-06-28","obsValue":4.1,"status":"PRELIM","isFinal":false,"frequency":"MONTHLY"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MD4_RevisionAsOf
{
    pattern: '/stress/md4';
    documentation: 'April as believed on 20 May: CPI reads 3.4 and unemployment 3.9, the first prints. This is what a report run that week would have said, and it is not what the current data says.';
    execution: Single
    {
    query: |timeseries::ObservationRevision.all(%2024-05-20, %2024-04-30)
        ->project(~[
            seriesId:x|$x.seriesId,
            revisedValue:x|$x.revisedValue,
            revisionReason:x|$x.revisionReason
        ])
        ->sort(~seriesId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MD4_RevisionAsOf_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"seriesId":"CPI.US.YOY","revisedValue":3.4,"revisionReason":"FIRST_PRINT"},{"seriesId":"HICP.EA.YOY","revisedValue":2.4,"revisionReason":"FIRST_PRINT"},{"seriesId":"UNRATE.US","revisedValue":3.9,"revisionReason":"FIRST_PRINT"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MD5_RevisionAsOf
{
    pattern: '/stress/md5';
    documentation: 'The SAME business date after both restatements landed: CPI 3.5, unemployment 4.0. The business axis has not moved at all; only what we believe about it has.';
    execution: Single
    {
    query: |timeseries::ObservationRevision.all(%2024-06-20, %2024-04-30)
        ->project(~[
            seriesId:x|$x.seriesId,
            revisedValue:x|$x.revisedValue,
            revisionReason:x|$x.revisionReason
        ])
        ->sort(~seriesId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MD5_RevisionAsOf_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"seriesId":"CPI.US.YOY","revisedValue":3.5,"revisionReason":"SEASONAL_FACTOR_UPDATE"},{"seriesId":"HICP.EA.YOY","revisedValue":2.4,"revisionReason":"FIRST_PRINT"},{"seriesId":"UNRATE.US","revisedValue":4.0,"revisionReason":"BENCHMARK_REVISION"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MD6_RevisionAsOf
{
    pattern: '/stress/md6';
    documentation: 'The same business date asked BEFORE the April numbers were published. Unemployment exists -- it printed on 3 May, which is still after this -- so the processing filter removes CPI entirely and leaves nothing. Absent, not null.';
    execution: Single
    {
    query: |timeseries::ObservationRevision.all(%2024-05-01, %2024-04-30)
        ->project(~[
            seriesId:x|$x.seriesId,
            revisedValue:x|$x.revisedValue,
            revisionReason:x|$x.revisionReason
        ])
        ->sort(~seriesId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MD6_RevisionAsOf_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 0 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CV0_CurvePillars
{
    pattern: '/stress/cv0';
    documentation: 'Every curve pillar: the three-column key, the rate, the stored discount factor, the rate in basis points, the tenor in years, the long-end flag, the present value of a million at that factor, and the curve itself read through an EMBEDDED mapping -- so the curve\'s name, currency and enum-mapped type come off the pillar\'s own row with no join emitted.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            tenorLabel:x|$x.tenorLabel,
            tenorDays:x|$x.tenorDays,
            zeroRate:x|$x.zeroRate,
            discountFactor:x|$x.discountFactor,
            zeroRateBps:x|$x.zeroRateBps,
            tenorYears:x|$x.tenorYears,
            isLongEnd:x|$x.isLongEnd,
            pvOfMillion:x|$x.presentValueOf(1000000.0),
            curveName:x|$x.curveRef.curveName,
            curveCurrency:x|$x.curveRef.currency,
            curveType:x|$x.curveRef.curveType,
            joinedName:x|$x.curve.curveName,
            joinedCurrency:x|$x.curve.currency,
            joinedType:x|$x.curve.curveType
        ])
        ->sort([~curveId->ascending(), ~cobDate->ascending(), ~tenorLabel->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV0_CurvePillars_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
