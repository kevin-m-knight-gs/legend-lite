Service stress::E0_ExecutedByQuery
{
    pattern: '/stress/e0';
    documentation: 'Filter invariance, query side: every trade, narrowed by a predicate in the query.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->filter({x|($x.status == 'EXECUTED')})
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            side:x|$x.side,
            status:x|$x.status,
            currency:x|$x.currency
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    E0_ExecutedByQuery_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
