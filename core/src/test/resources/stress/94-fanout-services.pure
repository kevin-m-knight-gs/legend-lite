    documentation: 'Generated aggregate on research::SectorOutlook: 1 count(s) over to-many associations, every parent of which HAS children. This is the non-empty half of the property the F-series pins on the empty half -- F6 makes count() over an empty to-many return 1, so an end with any childless parent is excluded here rather than quarantined. Several counts on one root so the outer joins interact; a single-aggregate probe cannot show that. Generated by scripts/corpus/aggregates.py.';
    execution: Single
    {
    query: |research::SectorOutlook.all()
        ->project(~[
            outlookId:x|$x.outlookId,
            companiesCount:x|$x.companies->count()
        ])
        ->sort(~outlookId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    AA16_SectorOutlookCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"outlookId":"SECTOR-OUTLOOK-001","companiesCount":1},{"outlookId":"SECTOR-OUTLOOK-002","companiesCount":1},{"outlookId":"SECTOR-OUTLOOK-003","companiesCount":1},{"outlookId":"SECTOR-OUTLOOK-004","companiesCount":1},{"outlookId":"SECTOR-OUTLOOK-005","companiesCount":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

