    {
    query: |securities::Warrant.all()
        ->project(~[
            securityKey:x|$x.securityKey,
            securityType:x|$x.securityType,
            daysToMaturity:x|$x.daysToMaturity,
            issuerName:x|$x.issuerName,
            faceValue:x|$x.faceValue,
            isListed:x|$x.isListed
        ])
        ->sort(~securityKey->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TXM_Warrant_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"securityKey":"SM-00010","securityType":"WARRANT","daysToMaturity":null,"issuerName":"Northbridge Capital","faceValue":null,"isListed":true}]';
                  }#;
              }#
          ]
        }
      ]
