Service stress::AA_TradeCounts
{
    pattern: '/stress/aa_trade';
    documentation: 'Generated aggregate on trading::Trade: 1 count(s) over to-many associations, every parent of which HAS children. This is the non-empty half of the property the F-series pins on the empty half -- F6 makes count() over an empty to-many return 1, so an end with any childless parent is excluded here rather than quarantined. Several counts on one root so the outer joins interact; a single-aggregate probe cannot show that. Generated by scripts/corpus/aggregates.py.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            clearingRoutesCount:x|$x.clearingRoutes->count()
        ])
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    AA_TradeCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","clearingRoutesCount":2},{"tradeId":"TRD-0002","clearingRoutesCount":2},{"tradeId":"TRD-0003","clearingRoutesCount":2},{"tradeId":"TRD-0004","clearingRoutesCount":2},{"tradeId":"TRD-0005","clearingRoutesCount":2},{"tradeId":"TRD-0006","clearingRoutesCount":2},{"tradeId":"TRD-0007","clearingRoutesCount":2},{"tradeId":"TRD-0008","clearingRoutesCount":2},{"tradeId":"TRD-0009","clearingRoutesCount":2},{"tradeId":"TRD-0010","clearingRoutesCount":2},{"tradeId":"TRD-0011","clearingRoutesCount":2},{"tradeId":"TRD-0012","clearingRoutesCount":2},{"tradeId":"TRD-0013","clearingRoutesCount":2},{"tradeId":"TRD-0014","clearingRoutesCount":1},{"tradeId":"TRD-0015","clearingRoutesCount":2},{"tradeId":"TRD-0016","clearingRoutesCount":2},{"tradeId":"TRD-0017","clearingRoutesCount":2},{"tradeId":"TRD-0018","clearingRoutesCount":2},{"tradeId":"TRD-0019","clearingRoutesCount":2},{"tradeId":"TRD-0020","clearingRoutesCount":2}]';
                  }#;
