Service stress::CV1_QuotedPillars
{
    pattern: '/stress/cv1';
    documentation: 'Only the pillars the market actually quotes, through the subtype\'s ~filter. The 15Y and 20Y are interpolated on all eight curves, so this is 160 rows of 192 -- and if the filter were wrong it would be 192 with no error and no type mismatch.';
    execution: Single
    {
    query: |curves::QuotedPillar.all()
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            tenorLabel:x|$x.tenorLabel,
            tenorDays:x|$x.tenorDays,
            zeroRate:x|$x.zeroRate,
            isInterpolated:x|$x.isInterpolated,
            curveName:x|$x.curveRef.curveName,
            curveType:x|$x.curveRef.curveType
        ])
        ->sort([~curveId->ascending(), ~cobDate->ascending(), ~tenorLabel->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV1_QuotedPillars_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 160 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"10Y","tenorDays":3653,"zeroRate":2.51,"isInterpolated":false,"curveName":"German Bund Zero Curve","curveType":"GOVERNMENT"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"1M","tenorDays":30,"zeroRate":3.61,"isInterpolated":false,"curveName":"German Bund Zero Curve","curveType":"GOVERNMENT"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"1Y","tenorDays":365,"zeroRate":3.24,"isInterpolated":false,"curveName":"German Bund Zero Curve","curveType":"GOVERNMENT"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"2Y","tenorDays":730,"zeroRate":2.94,"isInterpolated":false,"curveName":"German Bund Zero Curve","curveType":"GOVERNMENT"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"30Y","tenorDays":10958,"zeroRate":2.68,"isInterpolated":false,"curveName":"German Bund Zero Curve","curveType":"GOVERNMENT"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"3M","tenorDays":91,"zeroRate":3.55,"isInterpolated":false,"curveName":"German Bund Zero Curve","curveType":"GOVERNMENT"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"3Y","tenorDays":1095,"zeroRate":2.75,"isInterpolated":false,"curveName":"German Bund Zero Curve","curveType":"GOVERNMENT"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"5Y","tenorDays":1826,"zeroRate":2.55,"isInterpolated":false,"curveName":"German Bund Zero Curve","curveType":"GOVERNMENT"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"6M","tenorDays":182,"zeroRate":3.44,"isInterpolated":false,"curveName":"German Bund Zero Curve","curveType":"GOVERNMENT"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"7Y","tenorDays":2556,"zeroRate":2.53,"isInterpolated":false,"curveName":"German Bund Zero Curve","curveType":"GOVERNMENT"},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"10Y","tenorDays":3653,"zeroRate":2.46,"isInterpolated