Service stress::MR4_Dv01ByTenor
{
    pattern: '/stress/mr4';
    documentation: 'DV01 aggregated by curve and tenor bucket. The subtype restricts to rates sensitivities, so credit and equity exposures do not contaminate the ladder.';
    execution: Single
    {
    query: |risk::Dv01Sensitivity.all()
        ->project(~[
            factorId:x|$x.factorId,
            measureValue:x|$x.measureValue
        ])
        ->groupBy(~[factorId], ~[
            points: x|$x.measureValue : agg|$agg->count(),
            totalDv01: x|$x.measureValue : agg|$agg->sum(),
            largest: x|$x.measureValue : agg|$agg->max()
        ])
        ->sort(~factorId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MR4_Dv01ByTenor_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"factorId":"IR.EUR.ESTR.3Y","points":3,"totalDv01":6750.0,"largest":2250.0},{"factorId":"IR.USD.SOFR.10Y","points":3,"totalDv01":15000.0,"largest":5000.0},{"factorId":"IR.USD.SOFR.2Y","points":15,"totalDv01":14400.0,"largest":2000.0},{"factorId":"IR.USD.SOFR.5Y","points":9,"totalDv01":18000.0,"largest":2500.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MR5_StressResults
{
    pattern: '/stress/mr5';
    documentation: 'Stress results with the scenario behind each. The hypothetical scenarios have no historical event date; the severe ones breach the limit.';
    execution: Single
    {
    query: |risk::ScenarioResult.all()
        ->project(~[
            resultId:x|$x.resultId,
            stressedPnl:x|$x.stressedPnl,
            breachedLimit:x|$x.breachedLimit,
            scenarioName:x|$x.scenario.scenarioName,
            scenarioType:x|$x.scenario.scenarioType,
            severity:x|$x.scenario.severity,
            asOfEvent:x|$x.scenario.asOfEvent,
            isRegulatory:x|$x.scenario.isRegulatory
        ])
        ->sort(~resultId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MR5_StressResults_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 10 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"resultId":"SCNR-00001","stressedPnl":-14647500.0,"breachedLimit":true,"scenarioName":"Lehman default Sep 2008","scenarioType":"HISTORICAL","severity":"SEVERE","asOfEvent":"2008-09-15","isRegulatory":true},{"resultId":"SCNR-00002","stressedPnl":-14647500.0,"breachedLimit":true,"scenarioName":"Covid crash Mar 2020","scenarioType":"HISTORICAL","severity":"SEVERE","asOfEvent":"2020-03-16","isRegulatory":true},{"resultId":"SCNR-00003","stressedPnl":-3766500.0,"breachedLimit":false,"scenarioName":"UK gilt crisis Sep 2022","scenarioType":"HISTORICAL","severity":"MODERATE","asOfEvent":"2022-09-23","isRegulatory":false},{"resultId":"SCNR-00004","stressedPnl":-753300.0,"breachedLimit":false,"scenarioName":"Parallel +200bp","scenarioType":"HYPOTHETICAL","severity":"MODERATE","asOfEvent":null,"isRegulatory":true},{"resultId":"SCNR-00005","stressedPnl":-292950.0,"breachedLimit":false,"scenarioName":"Curve steepener 100bp","scenarioType":"HYPOTHETICAL","severity":"MILD","asOfEvent":null,"isRegulatory":false},{"resultId":"SCNR-00006","stressedPnl":-14647500.0,"breachedLimit":true,"scenarioName":"Lehman default Sep 2008","scenarioType":"HISTORICAL","severity":"SEVERE","asOfEvent":"2008-09-15","isRegulatory":true},{"resultId":"SCNR-00007","stressedPnl":-14647500.0,"breachedLimit":true,"scenarioName":"Covid crash Mar 2020","scenarioType":"HISTORICAL","severity":"SEVERE","asOfEvent":"2020-03-16","isRegulatory":true},{"resultId":"SCNR-00008","stressedPnl":-3766500.0,"breachedLimit":false,"scenarioName":"UK gilt crisis Sep 2022","scenarioType":"HISTORICAL","severity":"MODERATE","asOfEvent":"2022-09-23","isRegulatory":false},{"resultId":"SCNR-00009","stressedPnl":-753300.0,"breachedLimit":false,"scenarioName":"Parallel +200bp","scenarioType":"HYPOTHETICAL","severity":"MODERATE","asOfEvent":null,"isRegulatory":true},{"resultId":"SCNR-00010","stressedPnl":-292950.0,"breachedLimit":false,"scenarioName":"Curve steepener 100bp","scenarioType":"HYPOTHETICAL","severity":"MILD","asOfEvent":null,"isRegulatory":false}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MO0_LifecycleBlotter
{
    pattern: '/stress/mo0';
    documentation: 'Every lifecycle event with its settlement lag and the trade it belongs to. Which columns are populated depends on the event type: a reset has a fixing and no notional change, a compression the reverse.';
    execution: Single
    {
    query: |middleoffice::LifecycleEvent.all()
        ->project(~[
            eventId:x|$x.eventId,
            eventType:x|$x.eventType,
            status:x|$x.status,
            notionalDelta:x|$x.notionalDelta,
            fixingRate:x|$x.fixingRate,
            cashFlow:x|$x.cashFlow,
            settlementLagDays:x|$x.settlementLagDays,
            productType:x|$x.eventTrade.productType
        ])
        ->sort(~eventId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MO0_LifecycleBlotter_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 12 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"eventId":"EVT-000001","eventType":"NEW_TRADE","status":"COMPLETE","notionalDelta":null,"fixingRate":null,"cashFlow":null,"settlementLagDays":4,"productType":"IRS"},{"eventId":"EVT-000002","eventType":"RATE_RESET","status":"COMPLETE","notionalDelta":null,"fixingRate":5.3312,"cashFlow":666400.0,"settlementLagDays":0,"productType":"IRS"},{"eventId":"EVT-000003","eventType":"PARTIAL_TERMINATION","status":"COMPLETE","notionalDelta":-10000000.0,"fixingRate":null,"cashFlow":-84500.0,"settlementLagDays":4,"productType":"IRS"},{"eventId":"EVT-000004","eventType":"AMENDMENT","status":"COMPLETE","notionalDelta":null,"fixingRate":null,"cashFlow":null,"settlementLagDays":0,"productType":"BASIS_SWAP"},{"eventId":"EVT-000005","eventType":"CREDIT_EVENT","status":"PENDING","notionalDelta":null,"fixingRate":null,"cashFlow":null,"settlementLagDays":0,"productType":"CDS"},{"eventId":"EVT-000006","eventType":"NOVATION","status":"COMPLETE","notionalDelta":null,"fixingRate":null,"cashFlow":null,"settlementLagDays":2,"productType":"EQUITY_SWAP"},{"eventId":"EVT-000007","eventType":"COMPRESSION","status":"COMPLETE","notionalDelta":-5000000.0,"fixingRate":null,"cashFlow":null,"settlementLagDays":3,"productType":"OIS"},{"eventId":"EVT-000008","eventType":"EXERCISE","status":"PENDING","notionalDelta":null,"fixingRate":null,"cashFlow":null,"settlementLagDays":2,"productType":"SWAPTION"},{"eventId":"EVT-000009","eventType":"FULL_TERMINATION","status":"CANCELLED","notionalDelta":-8000000.0,"fixingRate":null,"cashFlow":112000.0,"settlementLagDays":4,"productType":"COMMODITY_SWAP"},{"eventId":"EVT-000010","eventType":"INCREASE","status":"COMPLETE","notionalDelta":50000000.0,"fixingRate":null,"cashFlow":null,"settlementLagDays":2,"productType":"CDS_INDEX"},{"eventId":"EVT-000011","eventType":"RATE_RESET","status":"COMPLETE","notionalDelta":null,"fixingRate":3.871,"cashFlow":725812.5,"settlementLagDays":0,"productType":"BASIS_SWAP"},{"eventId":"EVT-000012","eventType":"FIXING","status":"COMPLETE","notionalDelta":null,"fixingRate":1372.45,"cashFlow":null,"settlementLagDays":2,"productType":"NDF"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MO1_RateResets
{
    pattern: '/stress/mo1';
    documentation: 'Rate resets only: the events that produce a cash flow from a fixing without changing the notional. Two of twelve events.';
    execution: Single
    {
    query: |middleoffice::RateResetEvent.all()
        ->project(~[
            eventId:x|$x.eventId,
            effectiveDate:x|$x.effectiveDate,
            fixingRate:x|$x.fixingRate,
            cashFlow:x|$x.cashFlow
        ])
        ->sort(~eventId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MO1_RateResets_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
