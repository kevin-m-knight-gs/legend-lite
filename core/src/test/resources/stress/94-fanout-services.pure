Service stress::SP_defDailyPnLEmpty
{
    pattern: '/stress/sp_defdailypnlempty';
    documentation: 'Coverage-directed stack on pnl::DailyPnL (Empty), reusing the reach of D_DailyPnLDense and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
