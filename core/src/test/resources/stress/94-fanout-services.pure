Service stress::FI2_CouponPayments
{
    pattern: '/stress/fi2';
    documentation: 'Coupons actually paid, with withholding. Withholding is a function of the issuer\'s domicile, so gross and net differ for the German and British issuers and agree for the US ones.';
    execution: Single
    {
    query: |fixedincome::CouponPayment.all()
        ->project(~[
            paymentId:x|$x.paymentId,
            paymentDate:x|$x.paymentDate,
            grossAmount:x|$x.grossAmount,
            withholdingTax:x|$x.withholdingTax,
            netAmount:x|$x.netAmount,
            currency:x|$x.currency,
            issuer:x|$x.period.security.issuerName
        ])
        ->sort(~paymentId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    FI2_CouponPayments_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 43 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
