Service stress::G0_TradeTree
{
    pattern: '/stress/g0';
    documentation: 'Nested to-one navigation. TRD-0007\'s counterparty does not exist, so the whole counterparty sub-object must be null -- the tree-shaped version of a distinction a flat projection cannot make.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->graphFetch(#{
  trading::Trade
  {
    tradeId,
    status,
    notional,
    instrument
    {
      instrumentId,
      name,
      ticker
    },
    counterparty
    {
      counterpartyId,
      legalName,
      lei
    }
  }
}#)
        ->serialize(#{
  trading::Trade
  {
    tradeId,
    status,
    notional,
    instrument
    {
      instrumentId,
      name,
      ticker
    },
    counterparty
    {
      counterpartyId,
      legalName,
      lei
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    G0_TradeTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"tradeId":"TRD-0001","status":"EXECUTED","notional":190500.0,"instrument":{"instrumentId":"INST-AAPL","name":"Apple Inc","ticker":"AAPL"},"counterparty":{"counterpartyId":"CP-0001","legalName":"Meridian Asset Management","lei":"5493001KJTIIGC8Y1R12"}},{"tradeId":"TRD-0002","status":"EXECUTED","notional":477500.0,"instrument":{"instrumentId":"INST-AAPL","name":"Apple Inc","ticker":"AAPL"},"counterparty":{"counterpartyId":"CP-0001","legalName":"Meridian Asset Management","lei":"5493001KJTIIGC8Y1R12"}},{"tradeId":"TRD-0003","status":"EXECUTED","notional":250000.0,"instrument":{"instrumentId":"INST-AAPL","name":"Apple Inc","ticker":"AAPL"},"counterparty":{"counterpartyId":"CP-0002","legalName":"Halberd Securities","lei":"213800WAVVOPS85N2205"}},{"tradeId":"TRD-0004","status":"EXECUTED","notional":250000.0,"instrument":{"instrumentId":"INST-AAPL","name":"Apple Inc","ticker":"AAPL"},"counterparty":{"counterpartyId":"CP-0002","legalName":"Halberd Securities","lei":"213800WAVVOPS85N2205"}},{"tradeId":"TRD-0005","status":"EXECUTED","notional":250000.0,"instrument":{"instrumentId":"INST-AAPL","name":"Apple Inc","ticker":"AAPL"},"counterparty":{"counterpartyId":"CP-0003","legalName":"O\'Neill Capital Partners","lei":"529900T8BM49AURSDO55"}},{"tradeId":"TRD-0006","status":"EXECUTED","notional":250000.0,"instrument":{"instrumentId":"INST-AAPL","name":"Apple Inc","ticker":"AAPL"},"counterparty":{"counterpartyId":"CP-0001","legalName":"Meridian Asset Management","lei":"5493001KJTIIGC8Y1R12"}},{"tradeId":"TRD-0007","status":"EXECUTED","notional":282000.0,"instrument":{"instrumentId":"INST-AAPL","name":"Apple Inc","ticker":"AAPL"},"counterparty":null},{"tradeId":"TRD-0008","status":"CANCELLED","notional":18975.0,"instrument":{"instrumentId":"INST-AAPL","name":"Apple Inc","ticker":"AAPL"},"counterparty":{"counterpartyId":"CP-0001","legalName":"Meridian Asset Management","lei":"5493001KJTIIGC8Y1R12"}},{"tradeId":"TRD-00