Service stress::AA0_MarketDataSnapshotCounts
{
    pattern: '/stress/aa0';
    documentation: 'Generated aggregate on marketdata::MarketDataSnapshot: 2 count(s) over to-many associations, every parent of which HAS children. This is the non-empty half of the property the F-series pins on the empty half -- F6 makes count() over an empty to-many return 1, so an end with any childless parent is excluded here rather than quarantined. Several counts on one root so the outer joins interact; a single-aggregate probe cannot show that. Generated by scripts/corpus/aggregates.py.';
    execution: Single
    {
    query: |marketdata::MarketDataSnapshot.all()
        ->project(~[
            snapshotId:x|$x.snapshotId,
            fxRatesCount:x|$x.fxRates->count(),
            quotesCount:x|$x.quotes->count()
        ])
        ->sort(~snapshotId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    AA0_MarketDataSnapshotCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"snapshotId":"SNAPSHOT-ID-001","fxRatesCount":1,"quotesCount":1},{"snapshotId":"SNAPSHOT-ID-002","fxRatesCount":1,"quotesCount":1},{"snapshotId":"SNAPSHOT-ID-003","fxRatesCount":1,"quotesCount":1},{"snapshotId":"SNAPSHOT-ID-004","fxRatesCount":1,"quotesCount":1},{"snapshotId":"SNAPSHOT-ID-005","fxRatesCount":1,"quotesCount":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

