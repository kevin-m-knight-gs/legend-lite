Service stress::F10_RatingsAsOf2019
{
    pattern: '/stress/t10';
    documentation: 'Before CP-0003 and CP-0004 were onboarded: only the two oldest counterparties have a rating in force.';
    execution: Single
    {
    query: |counterparty::RatingVersion.all(%2019-01-01)
        ->project(~[
            counterpartyId:x|$x.counterpartyId,
            rating:x|$x.rating,
            agency:x|$x.agency,
            outlook:x|$x.outlook,
            isInvestmentGrade:x|$x.isInvestmentGrade
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F10_RatingsAsOf2019_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 2 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"counterpartyId":"CP-0001","rating":"AA","agency":"S&P","outlook":"STABLE","isInvestmentGrade":true},{"counterpartyId":"CP-0002","rating":"A+","agency":"Moody\'s","outlook":"STABLE","isInvestmentGrade":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

