Service stress::GG_FxRateTree
{
    pattern: '/stress/gg_fxrate';
    documentation: 'Generated graph fetch on marketdata::FxRate: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |marketdata::FxRate.all()
        ->graphFetch(#{
  marketdata::FxRate
  {
    rateId,
    askRate,
    bidRate,
    dailyChange,
    baseCurrency
    {
      code,
      centralBank,
      fixingSource,
      country
      {
        countryCode,
        capitalCity
      }
    },
    snapshot
    {
      snapshotId,
      description,
      processingTimeMs
    }
  }
}#)
        ->serialize(#{
  marketdata::FxRate
  {
    rateId,
    askRate,
    bidRate,
    dailyChange,
    baseCurrency
    {
      code,
      centralBank,
      fixingSource,
      country
      {
        countryCode,
        capitalCity
      }
    },
    snapshot
    {
      snapshotId,
      description,
      processingTimeMs
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_FxRateTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"rateId":"FR-0001","askRate":null,"bidRate":1112.5,"dailyChange":1112.5,"baseCurrency":null,"snapshot":null},{"rateId":"FR-0002","askRate":1150.0,"bidRate":1150.0,"dailyChange":1150.0,"baseCurrency":null,"snapshot":null},{"rateId":"FR-0003","askRate":1187.5,"bidRate":1187.5,"dailyChange":1187.5,"baseCurrency":{"code":"USD","centralBank":"Federal Reserve","fixingSource":"WMR","country":{"countryCode":"US","capitalCity":"Washington"}},"snapshot":{"snapshotId":"MDS-0001","description":"primary record","processingTimeMs":318}},{"rateId":"FR-0004","askRate":1225.0,"bidRate":1225.0,"dailyChange":1225.0,"baseCurrency":{"code":"GBP","centralBank":"Bank of England","fixingSource":"WMR","country":{"countryCode":"GB","capitalCity":"London"}},"snapshot":{"snapshotId":"MDS-0002","description":null,"processingTimeMs":325}},{"rateId":"FR-0005","askRate":1262.5,"bidRate":null,"dailyChange":null,"baseCurrency":{"code":"EUR","centralBank":"European Central Bank","fixingSource":"ECB","country":{"countryCode":"DE","capitalCity":"Berlin"}},"snapshot":{"snapshotId":"MDS-0003","description":"archived record","processingTimeMs":332}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

