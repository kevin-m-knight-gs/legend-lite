}

Service stress::F11_RatingsAsOf2021
{
    pattern: '/stress/t11';
    documentation: 'CP-0004 still rated (its rating is withdrawn in 2022) and CP-0001 is in its middle version — a date where the answer differs from BOTH the earliest and the current state.';
    execution: Single
    {
    query: |counterparty::RatingVersion.all(%2021-01-01)
        ->project(~[
            counterpartyId:x|$x.counterpartyId,
            rating:x|$x.rating,
            agency:x|$x.agency,
            outlook:x|$x.outlook,
            isInvestmentGrade:x|$x.isInvestmentGrade
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F11_RatingsAsOf2021_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"counterpartyId":"CP-0001","rating":"A+","agency":"S&P","outlook":"NEGATIVE","isInvestmentGrade":true},{"counterpartyId":"CP-0002","rating":"A+","agency":"Moody\'s","outlook":"STABLE","isInvestmentGrade":true},{"counterpartyId":"CP-0003","rating":"BBB","agency":"Fitch","outlook":"NEGATIVE","isInvestmentGrade":true},{"counterpartyId":"CP-0004","rating":"BBB-","agency":"Fitch","outlook":"NEGATIVE","isInvestmentGrade":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

