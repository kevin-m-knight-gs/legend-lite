Service stress::SP_InlineFlatTradeGroup
{
    pattern: '/stress/sp_inlineflattradegroup';
    documentation: 'Coverage-directed stack on trading::Trade (Group), reusing the reach of N3_TradeInlineFlat and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->filter({x|($x.tradeId > ' ')})
        ->project(~[
            tradeId:x|$x.tradeId,
            tradeDate:x|$x.tradeDate,
            quantity:x|$x.quantity,
            price:x|$x.price,
            notional:x|$x.notional,
            side:x|$x.side,
            status:x|$x.status,
            currency:x|$x.currency,
            grossAmount:x|$x.grossAmount,
            instrName:x|$x.instrument.name,
            instrTicker:x|$x.instrument.ticker,
            instrIsin:x|$x.instrument.isin,
            bookName:x|$x.book.name,
            cptyName:x|$x.counterparty.legalName,
            cptyLei:x|$x.counterparty.lei,
            traderLast:x|$x.trader.lastName
        ])
        ->groupBy(~[tradeId], ~[
            n: x|$x.quantity : agg|$agg->count(),
            tot: x|$x.quantity : agg|$agg->sum()
        ]);
        mapping: reporting::InlineFlatMapping;
        runtime: stress::InlineFlatRT;
    }
  testSuites:
  [
    SP_InlineFlatTradeGroup_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","n":1,"tot":1000.0},{"tradeId":"TRD-0002","n":1,"tot":2500.0},{"tradeId":"TRD-0003","n":1,"tot":500.0},{"tradeId":"TRD-0004","n":1,"tot":1250.0},{"tradeId":"TRD-0005","n":1,"tot":2000.0},{"tradeId":"TRD-0006","n":1,"tot":800.0},{"tradeId":"TRD-0007","n":1,"tot":1500.0},{"tradeId":"TRD-0008","n":1,"tot":100.0},{"tradeId":"TRD-0009","n":1,"tot":3000.0},{"tradeId":"TRD-0010","n":1,"tot":1200.0},{"tradeId":"TRD-0011","n":1,"tot":400.0},{"tradeId":"TRD-0012","n":1,"tot":900.0},{"tradeId":"TRD-0013","n":1,"tot":25000.0},{"tradeId":"TRD-0014","n":1,"tot":10000.0},{"tradeId":"TRD-0015","n":1,"tot":5000.0},{"tradeId":"TRD-0016","n":1,"tot":1500.0},{"tradeId":"TRD-0017","n":1,"tot":2200.0},{"tradeId":"TRD-0018","n":1,"tot":5000000.0},{"tradeId":"TRD-0019","n":1,"tot":2000000.0},{"tradeId":"TRD-0020","n":1,"tot":1000000.0}]';
