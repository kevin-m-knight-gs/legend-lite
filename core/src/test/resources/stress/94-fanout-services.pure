    query: |derivatives::CreditDefaultSwap.all()
        ->project(~[
            otcId:x|$x.otcId,
            counterpartyId:x|$x.counterpartyId,
            notional:x|$x.notional,
            lossGivenDefault:x|$x.lossGivenDefault
        ])
        ->sort(~otcId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
