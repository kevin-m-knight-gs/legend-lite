Service stress::OT0_TradeBook
{
    pattern: '/stress/ot0';
    documentation: 'The OTC book: every trade with its tenor and its notional converted at a supplied rate. clearingHouse and masterAgreement are null for the bilateral trades, which is most of them.';
    execution: Single
    {
    query: |derivatives::OtcTrade.all()
        ->project(~[
            otcId:x|$x.otcId,
            productType:x|$x.productType,
            assetClass:x|$x.assetClass,
            notional:x|$x.notional,
            currency:x|$x.currency,
            clearingHouse:x|$x.clearingHouse,
            masterAgreement:x|$x.masterAgreement,
            tenorYears:x|$x.tenorYears,
            notionalGbp:x|$x.notionalIn(0.79)
        ])
        ->sort(~otcId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    OT0_TradeBook_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 42 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"otcId":"OTC-000001","productType":"IRS","assetClass":"RATES","notional":50000000.0,"currency":"USD","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":5.002739726027397,"notionalGbp":39500000.0},{"otcId":"OTC-000002","productType":"OIS","assetClass":"RATES","notional":25000000.0,"currency":"USD","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":2.0,"notionalGbp":19750000.0},{"otcId":"OTC-000003","productType":"BASIS_SWAP","assetClass":"RATES","notional":75000000.0,"currency":"EUR","clearingHouse":"EUREX","masterAgreement":"ISDA_2002","tenorYears":3.0027397260273974,"notionalGbp":59250000.0},{"otcId":"OTC-000004","productType":"FRA","assetClass":"RATES","notional":100000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":0.25205479452054796,"notionalGbp":79000000.0},{"otcId":"OTC-000005","productType":"SWAPTION","assetClass":"RATES","notional":40000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":5.002739726027397,"notionalGbp":31600000.0},{"otcId":"OTC-000006","productType":"CAP","assetClass":"RATES","notional":30000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":3.0,"notionalGbp":23700000.0},{"otcId":"OTC-000007","productType":"CDS","assetClass":"CREDIT","notional":10000000.0,"currency":"USD","clearingHouse":"ICE","masterAgreement":"ISDA_2014","tenorYears":5.252054794520548,"notionalGbp":7900000.0},{"otcId":"OTC-000008","productType":"CDS_INDEX","assetClass":"CREDIT","notional":250000000.0,"currency":"EUR","clearingHouse":"ICE","masterAgreement":"ISDA_2014","tenorYears":5.252054794520548,"notionalGbp":197500000.0},{"otcId":"OTC-000009","productType":"NDF","assetClass":"FX","notional":20000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":0.5013698630136987,"notionalGbp":15800000.0},{"otcId":"OTC-000010","productType":"FX_OPTION","assetClass":"FX","notional":15000000.0,"currency":"EUR","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":1.0,"notionalGbp":11850000.0},{"otcId":"OTC-000011","productType":"EQUITY_SWAP","assetClass":"EQUITY","notional":35000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":1.0027397260273974,"notionalGbp":27650000.0},{"otcId":"OTC-000012","productType":"VARIANCE_SWAP","assetClass":"EQUITY","notional":5000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":0.5013698630136987,"notionalGbp":3950000.0},{"otcId":"OTC-000013","productType":"COMMODITY_SWAP","assetClass":"COMMODITY","notional":8000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":null,"tenorYears":1.0,"notionalGbp":6320000.0},{"otcId":"OTC-000014","productType":"CONSTANT_MATURITY_SWAP","assetClass":"RATES","notional":5000000.0,"currency":"USD","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":1.0383561643835617,"notionalGbp":3950000.0},{"otcId":"OTC-000015","productType":"CROSS_CURRENCY_SWAP","assetClass":"RATES","notional":7000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":3.03013698630137,"notionalGbp":5530000.0},{"otcId":"OTC-000016","productType":"ACCRETING_SWAP","assetClass":"RATES","notional":9000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":5.027397260273973,"notionalGbp":7110000.0},{"otcId":"OTC-000017","productType":"ZERO_COUPON_SWAP","assetClass":"RATES","notional":11000000.0,"currency":"USD","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":2.5178082191780824,"notionalGbp":8690000.0},{"otcId":"OTC-000018","productType":"CALLABLE_SWAP","assetClass":"RATES","notional":13000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":4.52054794520548,"notionalGbp":10270000.0},{"otcId":"OTC-000019","productType":"CMS_SPREAD_OPTION","assetClass":"RATES","notional":15000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":1.5123287671232877,"notionalGbp":11850000.0},{"otcId":"OTC-000020","productType":"MIDCURVE_SWAPTION","assetClass":"RATES","notional":17000000.0,"currency":"USD","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":3.0054794520547947,"notionalGbp":13430000.0},{"otcId":"OTC-000021","productType":"COLLAR","assetClass":"RATES","notional":19000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":5.0,"notionalGbp":15010000.0},{"otcId":"OTC-000022","productType":"CDS_TRANCHE","assetClass":"CREDIT","notional":21000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":1.9917808219178081,"notionalGbp":16590000.0},{"otcId":"OTC-000023","productType":"NTH_TO_DEFAULT","assetClass":"CREDIT","notional":23000000.0,"currency":"USD","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":4.487671232876712,"notionalGbp":18170000.0},{"otcId":"OTC-000024","productType":"CREDIT_LINKED_NOTE","assetClass":"CREDIT","notional":25000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":1.484931506849315,"notionalGbp":19750000.0},{"otcId":"OTC-000025","productType":"LOAN_CDS","assetClass":"CREDIT","notional":27000000.0,"currency":"USD","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":3.4794520547945207,"notionalGbp":21330000.0},{"otcId":"OTC-000026","productType":"FX_SWAP","assetClass":"FX","notional":29000000.0,"currency":"EUR","clearingHouse":"LCH","masterAgreement":"ISDA_2002","tenorYears":4.975342465753425,"notionalGbp":22910000.0},{"otcId":"OTC-000027","productType":"FX_DIGITAL","assetClass":"FX","notional":31000000.0,"currency":"EUR","clearingHouse":null,"masterAgreement":"ISDA_2002","tenorYears":1.9643835616438357,"notionalGbp":24490000.0},{"otcId":"OTC-000028","productType":"FX_ACCUMULATOR","assetClass":"FX","notional":33000000.0,"currency":"EUR","clearingHouse":null,"masterAgreement":"ISDA_2002","