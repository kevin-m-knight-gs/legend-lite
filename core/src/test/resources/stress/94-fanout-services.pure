            ormix_date_none_nullable_top:x|$x.ormix_date_none_nullable_top
        ])
        ->groupBy(~[rootId], ~[
            n: x|$x.col_float_abs_nullable_top : agg|$agg->count(),
            tot: x|$x.col_float_abs_nullable_top : agg|$agg->sum()
        ]);
        mapping: combo::ComboMapping;
        runtime: combo::ComboRT;
    }
  testSuites:
  [
    SP_ComboC9Group_suite:
    {
      data:
      [
        connections:
        [
          comboEnv:
            Reference
            #{
              combo::ComboData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"rootId":"CR-0005","n":1,"tot":362.5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::SP_defCurveSummaryGroup
{
    pattern: '/stress/sp_defcurvesummarygroup';
    documentation: 'Coverage-directed stack on curves::CurveSummary (Group), reusing the reach of CV9_CurveSummaries and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |curves::CurveSummary.all()
        ->filter({x|($x.curveId > ' ')})
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            pillarCount:x|$x.pillarCount,
            highestRate:x|$x.highestRate,
            lowestRate:x|$x.lowestRate,
            curveName:x|$x.summarised.curveName,
            interpolation:x|$x.summarised.interpolation,
            summarisedBenchmarkSeriesIsDaily:x|$x.summarised.benchmarkSeries.isDaily
        ])
        ->groupBy(~[curveId], ~[
            n: x|$x.pillarCount : agg|$agg->count(),
