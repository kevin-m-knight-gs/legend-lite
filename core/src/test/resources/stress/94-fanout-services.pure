Service stress::BK0_TieredBrokerage
{
    pattern: '/stress/bk0';
    documentation: 'Each trade with the brokerage tier its notional falls into, reached by a RANGE join -- `notional >= min and notional < max`, with no key to join on and none possible, because the band is a property of the amount. All four bands are occupied and the largest holds one trade, which is the band an open upper edge gets wrong first.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            notional:x|$x.notional,
            side:x|$x.side,
            tierId:x|$x.brokerageTier.tierId,
            tierName:x|$x.brokerageTier.tierName,
            bpsRate:x|$x.brokerageTier.bpsRate,
            minimumFee:x|$x.brokerageTier.minimumFee
        ])
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BK0_TieredBrokerage_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","notional":190500.0,"side":"BUY","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0002","notional":477500.0,"side":"BUY","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0003","notional":250000.0,"side":"BUY","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0004","notional":250000.0,"side":"SELL","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0005","notional":250000.0,"side":"BUY","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0006","notional":250000.0,"side":"BUY","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0007","notional":282000.0,"side":"BUY","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0008","notional":18975.0,"side":"BUY","tierId":"TIER-RETAIL","tierName":"Retail","bpsRate":12.5,"minimumFee":25.0},{"tradeId":"TRD-0009","notional":576750.0,"side":"BUY","tierId":"TIER-MID","tierName":"Mid Institutional","bpsRate":5.5,"minimumFee":150.0},{"tradeId":"TRD-0010","notional":498000.0,"side":"BUY","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0011","notional":167300.0,"side":"BUY","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0012","notional":369000.0,"side":null,"tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0013","notional":171250.0,"side":"SELL","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0014","notional":69000.0,"side":"BUY","tierId":"TIER-RETAIL","tierName":"Retail","bpsRate":12.5,"minimumFee":25.0},{"tradeId":"TRD-0015","notional":35000.0,"side":"BUY","tierId":"TIER-RETAIL","tierName":"Retail","bpsRate":12.5,"minimumFee":25.0},{"tradeId":"TRD-0016","notional":264600.0,"side":"BUY","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0017","notional":385000.0,"side":"SELL","tierId":"TIER-SMALL","tierName":"Small Institutional","bpsRate":8.0,"minimumFee":40.0},{"tradeId":"TRD-0018","notional":4912500.0,"side":"BUY","tierId":"TIER-LARGE","tierName":"Large Block","bpsRate":3.25,"minimumFee":500.0},{"tradeId":"TRD-0019","notional":1960000.0,"side":"BUY","tierId":"TIER-MID","tierName":"Mid Institutional","bpsRate":5.5,"minimumFee":150.0},{"tradeId":"TRD-0020","notional":975000.0,"side":"BUY","tierId":"TIER-MID","tierName":"Mid Institutional","bpsRate":5.5,"minimumFee":150.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::BK1_BrokerageBands
{
    pattern: '/stress/bk1';
    documentation: 'Each brokerage band, how many trades fall in it, the rate as a fraction rather than in basis points, and what the band would charge on a million. The count is over a RANGE join, so a band with no trades in it would be the F6 case -- all four are occupied, deliberately.';
    execution: Single
    {
    query: |brokerage::BrokerageTier.all()
        ->project(~[
            tierId:x|$x.tierId,
            tierName:x|$x.tierName,
            minNotional:x|$x.minNotional,
            maxNotional:x|$x.maxNotional,
            rateFraction:x|$x.rateFraction,
            feeOnMillion:x|$x.feeOn(1000000.0),
            tradesInBand:x|$x.tieredTrades->count()
        ])
        ->sort(~tierId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BK1_BrokerageBands_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tierId":"TIER-LARGE","tierName":"Large Block","minNotional":2000000.0,"maxNotional":100000000.0,"rateFraction":0.000325,"feeOnMillion":325.0,"tradesInBand":1},{"tierId":"TIER-MID","tierName":"Mid Institutional","minNotional":500000.0,"maxNotional":2000000.0,"rateFraction":0.00055,"feeOnMillion":550.0,"tradesInBand":3},{"tierId":"TIER-RETAIL","tierName":"Retail","minNotional":0.0,"maxNotional":100000.0,"rateFraction":0.00125,"feeOnMillion":1250.0,"tradesInBand":3},{"tierId":"TIER-SMALL","tierName":"Small Institutional","minNotional":100000.0,"maxNotional":500000.0,"rateFraction":0.0008,"feeOnMillion":800.0,"tradesInBand":13}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::BK2_ClearingRoutes
{
    pattern: '/stress/bk2';
    documentation: 'How many clearing rules each trade matches, over a join that matches on venue OR on product. Most trades match two -- their venue\'s rule and their product\'s -- and the one executed on a lower-case venue code matches only its product\'s, the comparison being case sensitive. A routing table really does return every applicable rule; choosing between them is a precedence the join cannot express.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            venue:x|$x.executionVenue,
            tradeType:x|$x.tradeType,
            notional:x|$x.notional,
            matchingRules:x|$x.clearingRoutes->count()
        ])
        ->sort(~tradeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BK2_ClearingRoutes_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","venue":"XNAS","tradeType":"AGENCY","notional":190500.0,"matchingRules":2},{"tradeId":"TRD-0002","venue":"BATS","tradeType":"AGENCY","notional":477500.0,"matchingRules":2},{"tradeId":"TRD-0003","venue":"IEXG","tradeType":"AGENCY","notional":250000.0,"matchingRules":2},{"tradeId":"TRD-0004","venue":"XLON","tradeType":"PRINCIPAL","notional":250000.0,"matchingRules":2},{"tradeId":"TRD-0005","venue":"XNYS","tradeType":"AGENCY","notional":250000.0,"matchingRules":2},{"tradeId":"TRD-0006","venue":"XNAS","tradeType":"AGENCY","notional":250000.0,"matchingRules":2},{"tradeId":"TRD-0007","venue":"BATS","tradeType":"AGENCY","notional":282000.0,"matchingRules":2},{"tradeId":"TRD-0008","venue":"IEXG","tradeType":"AGENCY","notional":18975.0,"matchingRules":2},{"tradeId":"TRD-0009","venue":"XLON","tradeType":"AGENCY","notional":576750.0,"matchingRules":2},{"tradeId":"TRD-0010","venue":"XNYS","tradeType":"AGENCY","notional":498000.0,"matchingRules":2},{"tradeId":"TRD-0011","venue":"XNAS","tradeType":"AGENCY","notional":167300.0,"matchingRules":2},{"tradeId":"TRD-0012","venue":"BATS","tradeType":"AGENCY","notional":369000.0,"matchingRules":2},{"tradeId":"TRD-0013","venue":"IEXG","tradeType":"PRINCIPAL","notional":171250.0,"matchingRules":2},{"tradeId":"TRD-0014","venue":"xnas","tradeType":"AGENCY","notional":69000.0,"matchingRules":1},{"tradeId":"TRD-0015","venue":"XNYS","tradeType":"AGENCY","notional":35000.0,"matchingRules":2},{"tradeId":"TRD-0016","venue":"XNAS","tradeType":"AGENCY","notional":264600.0,"matchingRules":2},{"tradeId":"TRD-0017","venue":"BATS","tradeType":"PRINCIPAL","notional":385000.0,"matchingRules":2},{"tradeId":"TRD-0018","venue":"IEXG","tradeType":"AGENCY","notional":4912500.0,"matchingRules":2},{"tradeId":"TRD-0019","venue":"XLON","tradeType":"AGENCY","notional":1960000.0,"matchingRules":2},{"tradeId":"TRD-0020","venue":"XNYS","tradeType":"AGENCY","notional":975000.0,"matchingRules":2}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::BK3_RoutingRules
{
    pattern: '/stress/bk3';
    documentation: 'The routing table itself. A venue rule carries no product and a product rule carries no venue, so exactly one of the two columns is null on every row -- which is what makes the `or` behind BK2 a real disjunction rather than two conditions that happen to agree.';
    execution: Single
    {
    query: |brokerage::ClearingRoute.all()
        ->project(~[
            routeId:x|$x.routeId,
            venueCode:x|$x.venueCode,
            productCode:x|$x.productCode,
            clearingHouse:x|$x.clearingHouse,
            settlementCycle:x|$x.settlementCycle,
            isNetted:x|$x.isNetted,
            tradesRouted:x|$x.routedTrades->count()
        ])
        ->sort(~routeId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    BK3_RoutingRules_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 7 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"routeId":"RTE-AGENCY","venueCode":null,"productCode":"AGENCY","clearingHouse":"DTCC","settlementCycle":"T+1","isNetted":true,"tradesRouted":17},{"routeId":"RTE-BATS","venueCode":"BATS","productCode":null,"clearingHouse":"DTCC","settlementCycle":"T+1","isNetted":false,"tradesRouted":4},{"routeId":"RTE-IEXG","venueCode":"IEXG","productCode":null,"clearingHouse":"DTCC","settlementCycle":"T+1","isNetted":true,"tradesRouted":4},{"routeId":"RTE-PRINCIPAL","venueCode":null,"productCode":"PRINCIPAL","clearingHouse":"OCC","settlementCycle":"T+2","isNetted":false,"tradesRouted":3},{"routeId":"RTE-XLON","venueCode":"XLON","productCode":null,"clearingHouse":"CREST","settlementCycle":"T+2","isNetted":true,"tradesRouted":3},{"routeId":"RTE-XNAS","venueCode":"XNAS","productCode":null,"clearingHouse":"DTCC","settlementCycle":"T+1","isNetted":true,"tradesRouted":4},{"routeId":"RTE-XNYS","venueCode":"XNYS","productCode":null,"clearingHouse":"DTCC","settlementCycle":"T+1","isNetted":true,"tradesRouted":4}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F10_RatingsAsOf2019
{
    pattern: '/stress/t10';
    documentation: 'Before CP-0003 and CP-0004 were onboarded: only the two oldest counterparties have a rating in force.';
