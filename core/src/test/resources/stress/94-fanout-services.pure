Service stress::CV6_PillarEmptiness
{
    pattern: '/stress/cv6';
    documentation: 'CV3 asked as emptiness instead of as a count, over every pillar. The booleans are correct and the ROWS are not: a pillar with three longer pillars is returned three times. Quarantined under F51, which scripts/corpus/probe_ineq_aggregate.py narrows to self-joins -- the same isEmpty over a to-many to a DIFFERENT table returns one row per parent.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            tenorLabel:x|$x.tenorLabel,
            tenorDays:x|$x.tenorDays,
            isLastPillar:x|$x.longerPillars->isEmpty()
        ])
        ->sort([~curveId->ascending(), ~cobDate->ascending(), ~tenorLabel->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV6_PillarEmptiness_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 192 rows; 176 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
