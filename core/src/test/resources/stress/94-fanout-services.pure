Service stress::CV7_PillarsShorter
{
    pattern: '/stress/cv7';
    documentation: 'How many pillars sit SHORTER than each one -- the other end of the same association, over the same {target} self-join. The 1M pillar is filtered out for the F6 reason CV3 filters out the 30Y. Quarantined under F52: the engine returns the FORWARD set for both ends, so every count here is the number of pillars further out rather than nearer in.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->filter({x|($x.tenorLabel != '1M')})
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            tenorLabel:x|$x.tenorLabel,
            tenorDays:x|$x.tenorDays,
            pillarsNearerIn:x|$x.shorterPillars->count()
        ])
        ->sort([~curveId->ascending(), ~cobDate->ascending(), ~tenorLabel->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV7_PillarsShorter_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 176 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"10Y","tenorDays":3653,"pillarsNearerIn":8},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"15Y","tenorDays":5479,"pillarsNearerIn":9},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"1Y","tenorDays":365,"pillarsNearerIn":3},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"20Y","tenorDays":7305,"pillarsNearerIn":10},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"2Y","tenorDays":730,"pillarsNearerIn":4},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"30Y","tenorDays":10958,"pillarsNearerIn":11},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"3M","tenorDays":91,"pillarsNearerIn":1},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"3Y","tenorDays":1095,"pillarsNearerIn":5},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"5Y","tenorDays":1826,"pillarsNearerIn":6},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"6M","tenorDays":182,"pillarsNearerIn":2},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-19","tenorLabel":"7Y","tenorDays":2556,"pillarsNearerIn":7},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"10Y","tenorDays":3653,"pillarsNearerIn":8},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"15Y","tenorDays":5479,"pillarsNearerIn":9},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"1Y","tenorDays":365,"pillarsNearerIn":3},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"20Y","tenorDays":7305,"pillarsNearerIn":10},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"2Y","tenorDays":730,"pillarsNearerIn":4},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"30Y","tenorDays":10958,"pillarsNearerIn":11},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"3M","tenorDays":91,"pillarsNearerIn":1},{"curveId":"EUR.DBR.GOVT","cobDate":"2024-06-20","tenorLabel":"3Y","tenorDays