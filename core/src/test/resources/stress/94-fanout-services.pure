Service stress::F8_SettlementTradeDerived
{
    pattern: '/stress/f8';
    documentation: 'A derived property reached ACROSS an association, so it is evaluated on a joined row rather than the root. STL-9999 points at a trade that does not exist: grossAmount must be NULL there, which it is in both engines because NULL arithmetic propagates. The case that does NOT survive this shape -- a derived property that INSPECTS nullness -- is F8, in repro/derived-on-absent/.';
    execution: Single
    {
    query: |settlement::Settlement.all()
        ->project(~[
            settlementId:x|$x.settlementId,
            status:x|$x.status,
            tradeId:x|$x.trade.tradeId,
            tradeGross:x|$x.trade.grossAmount
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F8_SettlementTradeDerived_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 18 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"settlementId":"STL-0001","status":"SETTLED","tradeId":"TRD-0001","tradeGross":190500.0},{"settlementId":"STL-0002","status":"SETTLED","tradeId":"TRD-0002","tradeGross":477500.0},{"settlementId":"STL-0003","status":"SETTLED","tradeId":"TRD-0003","tradeGross":250000.0},{"settlementId":"STL-0004","status":"FAILED","tradeId":"TRD-0004","tradeGross":250000.0},{"settlementId":"STL-0005","status":"SETTLED","tradeId":"TRD-0005","tradeGross":250000.0},{"settlementId":"STL-0006","status":"SETTLED","tradeId":"TRD-0006","tradeGross":250000.0},{"settlementId":"STL-0007","status":"SETTLED","tradeId":"TRD-0007","tradeGross":282000.0},{"settlementId":"STL-0008","status":"FAILED","tradeId":"TRD-0009","tradeGross":576750.0},{"settlementId":"STL-0009","status":"SETTLED","tradeId":"TRD-0010","tradeGross":498000.0},{"settlementId":"STL-0010","status":"SETTLED","tradeId":"TRD-0011","tradeGross":167300.0},{"settlementId":"STL-0011","status":"SETTLED","tradeId":"TRD-0013","tradeGross":171250.0},{"settlementId":"STL-0012","status":"FAILED","tradeId":"TRD-0014","tradeGross":69000.0},{"settlementId":"STL-0013","status":"SETTLED","tradeId":"TRD-0015","tradeGross":35000.0},{"settlementId":"STL-0014","status":"SETTLED","tradeId":"TRD-0016","tradeGross":264600.0},{"settlementId":"STL-0015","status":"SETTLED","tradeId":"TRD-0017","tradeGross":385000.0},{"settlementId":"STL-0016","status":"FAILED","tradeId":"TRD-0018","tradeGross":4912500.0},{"settlementId":"STL-0017","status":"SETTLED","tradeId":"TRD-0019","tradeGross":1960000.0},{"settlementId":"STL-9999","status":"SETTLED","tradeId":null,"tradeGross":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F0_InstrumentChildCounts
{
    pattern: '/stress/f0';
    documentation: 'Fan-out: per-instrument child counts. INST-NESN is childless on every end, which is the count-over-outer-join case.';
    execution: Single
    {
    query: |products::Instrument.all()
        ->project(~[
            instrumentId:x|$x.instrumentId,
            name:x|$x.name,
            ticker:x|$x.ticker,
            assetClass:x|$x.assetClass,
            isActive:x|$x.isActive,
            tradeCount:x|$x.trades->count(),
            positionCount:x|$x.positions->count(),
            greeksCount:x|$x.instrumentGreeks->count()
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F0_InstrumentChildCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 4 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"instrumentId":"INST-AAPL","name":"Apple Inc","ticker":"AAPL","assetClass":"EQUITY","isActive":true,"tradeCount":9,"positionCount":1,"greeksCount":1},{"instrumentId":"INST-MSFT","name":"Microsoft Corp","ticker":"MSFT","assetClass":"EQUITY","isActive":true,"tradeCount":3,"positionCount":1,"greeksCount":1},{"instrumentId":"INST-HSBA","name":"HSBC Holdings plc","ticker":"HSBA","assetClass":"EQUITY","isActive":true,"tradeCount":3,"positionCount":1,"greeksCount":0},{"instrumentId":"INST-SAP","name":"SAP SE","ticker":"SAP","assetClass":"EQUITY","isActive":true,"tradeCount":2,"positionCount":1,"greeksCount":0},{"instrumentId":"INST-GILT30","name":"UK Gilt 4.25% 2055","ticker":"UKT30","assetClass":"RATES","isActive":true,"tradeCount":3,"positionCount":1,"greeksCount":1},{"instrumentId":"INST-NESN","name":"Nestle SA","ticker":"NESN","assetClass":"EQUITY","isActive":false,"tradeCount":0,"positionCount":1,"greeksCount":0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F1_CounterpartyChildCounts
{
    pattern: '/stress/f1';
    documentation: 'Fan-out: per-counterparty exposure. CP-0005 has no trades, settlements or collateral agreements; CP-0004 has trades but no CSA.';
    execution: Single
    {
    query: |counterparty::Counterparty.all()
        ->project(~[
            counterpartyId:x|$x.counterpartyId,
            legalName:x|$x.legalName,
            tier:x|$x.tier,
            isActive:x|$x.isActive,
            countryName:x|$x.country.name,
            tradeCount:x|$x.trades->count(),
            settlementCount:x|$x.settlementsWithCpty->count(),
            csaCount:x|$x.collateralAgreements->count()
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F1_CounterpartyChildCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 4 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"counterpartyId":"CP-0001","legalName":"Meridian Asset Management","tier":"1","isActive":true,"countryName":"United States","tradeCount":6,"settlementCount":5,"csaCount":1},{"counterpartyId":"CP-0002","legalName":"Halberd Securities","tier":"1","isActive":true,"countryName":"United Kingdom","tradeCount":7,"settlementCount":5,"csaCount":1},{"counterpartyId":"CP-0003","legalName":"O\'Neill Capital Partners","tier":"2","isActive":true,"countryName":"Germany","tradeCount":4,"settlementCount":4,"csaCount":1},{"counterpartyId":"CP-0004","legalName":"Halberd Securities","tier":"3","isActive":false,"countryName":"Japan","tradeCount":2,"settlementCount":2,"csaCount":0},{"counterpartyId":"CP-0005","legalName":"Kestrel Pension Trust","tier":"2","isActive":true,"countryName":"United Kingdom","tradeCount":0,"settlementCount":0,"csaCount":0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F2_BookChildCounts
{
    pattern: '/stress/f2';
    documentation: 'Fan-out: per-book activity. BK-LEGACY is closed and has neither trades nor PnL rows, while still holding one position.';
    execution: Single
    {
    query: |positions::Book.all()
        ->project(~[
            bookId:x|$x.bookId,
            name:x|$x.name,
            currency:x|$x.currency,
            isActive:x|$x.isActive,
            deskName:x|$x.desk.name,
            deskRegion:x|$x.desk.region,
            tradeCount:x|$x.trades->count(),
            positionCount:x|$x.positions->count(),
            pnlCount:x|$x.dailyPnLs->count()
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F2_BookChildCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 2 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bookId":"BK-CASH-US","name":"US Cash Equity","currency":"USD","isActive":true,"deskName":"Cash Equities","deskRegion":"Americas","tradeCount":10,"positionCount":2,"pnlCount":2},{"bookId":"BK-CASH-EU","name":"EMEA Cash Equity","currency":"EUR","isActive":true,"deskName":"Cash Equities","deskRegion":"Americas","tradeCount":5,"positionCount":2,"pnlCount":2},{"bookId":"BK-VOL-01","name":"Volatility Arb","currency":"USD","isActive":true,"deskName":"Equity Derivatives","deskRegion":"EMEA","tradeCount":5,"positionCount":1,"pnlCount":2},{"bookId":"BK-LEGACY","name":"Legacy Wind-down","currency":"GBP","isActive":false,"deskName":"Equity Derivatives","deskRegion":"EMEA","tradeCount":0,"positionCount":1,"pnlCount":0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F3_DeskChildCounts
{
    pattern: '/stress/f3';
    documentation: 'Fan-out: desk rollup. DSK-CREDIT has no books, no traders and no PnL — three independent zeroes on one row.';
    execution: Single
    {
    query: |org::Desk.all()
        ->project(~[
            deskId:x|$x.deskId,
            name:x|$x.name,
            region:x|$x.region,
            assetClass:x|$x.assetClass,
            isActive:x|$x.isActive,
            bookCount:x|$x.books->count(),
            traderCount:x|$x.traders->count(),
            pnlCount:x|$x.dailyPnLs->count()
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
