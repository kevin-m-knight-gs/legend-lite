    query: |products::Instrument.all()
        ->graphFetch(#{
  products::Instrument
  {
    instrumentId,
    assetClass,
    currency,
    cusip,
    exchange
    {
      mic,
      city,
      closeTime,
      country
      {
        countryCode,
        capitalCity
      }
    },
    instrumentCurrency
    {
      code,
      centralBank,
      fixingSource,
      country
      {
