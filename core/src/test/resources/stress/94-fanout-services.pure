Service stress::GG_CounterpartyContactTree
{
    pattern: '/stress/gg_counterpartycontact';
    documentation: 'Generated graph fetch on counterparty::Contact: 5 keys, 1 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |counterparty::Contact.all()
        ->graphFetch(#{
  counterparty::Contact
  {
    contactId,
    department,
    lastContactDate,
    phone,
    counterparty
    {
      counterpartyId,
      counterpartyType,
      creditRating,
      country
      {
        countryCode,
        capitalCity
      }
    }
  }
}#)
        ->serialize(#{
  counterparty::Contact
  {
    contactId,
    department,
    lastContactDate,
    phone,
    counterparty
    {
      counterpartyId,
      counterpartyType,
      creditRating,
      country
      {
        countryCode,
        capitalCity
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_CounterpartyContactTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"contactId":"C-0001","department":"DEPARTMENT-001","lastContactDate":null,"phone":null,"counterparty":null},{"contactId":"C-0002","department":"DEPARTMENT-002","lastContactDate":"2024-07-19","phone":"PHONE-002","counterparty":null},{"contactId":"C-0003","department":null,"lastContactDate":"2024-08-20","phone":"PHONE-003","counterparty":{"counterpartyId":"CP-0001","counterpartyType":"ASSET_MANAGER","creditRating":"AA-","country":{"countryCode":"US","capitalCity":"Washington"}}},{"contactId":"C-0004","department":"DEPARTMENT-004","lastContactDate":"2024-09-21","phone":"PHONE-004","counterparty":{"counterpartyId":"CP-0002","counterpartyType":"BROKER_DEALER","creditRating":"A+","country":{"countryCode":"GB","capitalCity":"London"}}},{"contactId":"C-0005","department":"DEPARTMENT-005","lastContactDate":"2024-10-22","phone":"PHONE-005","counterparty":{"counterpartyId":"CP-0003","counterpartyType":"HEDGE_FUND","creditRating":"BBB","country":{"countryCode":"DE","capitalCity":"Berlin"}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::AA_TraderCounts
{
    pattern: '/stress/aa_trader';
    documentation: 'Generated aggregate on org::Trader: 2 count(s) over to-many associations, every parent of which HAS children. This is the non-empty half of the property the F-series pins on the empty half -- F6 makes count() over an empty to-many return 1, so an end with any childless parent is excluded here rather than quarantined. Several counts on one root so the outer joins interact; a single-aggregate probe cannot show that. Generated by scripts/corpus/aggregates.py.';
    execution: Single
    {
    query: |org::Trader.all()
        ->project(~[
            traderId:x|$x.traderId,
            dailyPnLsCount:x|$x.dailyPnLs->count(),
            tradesCount:x|$x.trades->count()
        ])
        ->sort(~traderId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    AA_TraderCounts_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"traderId":"TRD-001","dailyPnLsCount":1,"tradesCount":4},{"traderId":"TRD-002","dailyPnLsCount":1,"tradesCount":4},{"traderId":"TRD-003","dailyPnLsCount":3,"tradesCount":7},{"traderId":"TRD-004","dailyPnLsCount":1,"tradesCount":3}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

