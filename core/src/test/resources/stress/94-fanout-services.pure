Service stress::CV4_CurveShape
{
    pattern: '/stress/cv4';
    documentation: 'Per-curve statistics over the pillar grid: how many pillars, the highest and lowest rate on the curve, and the mean. 24 rows per curve over two cob dates; a group-by that has quietly become a scan returns 192 in every row.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->project(~[
            curveId:x|$x.curveId,
            zeroRate:x|$x.zeroRate
        ])
        ->groupBy(~[curveId], ~[
            pillars: x|$x.zeroRate : agg|$agg->count(),
            highest: x|$x.zeroRate : agg|$agg->max(),
            lowest: x|$x.zeroRate : agg|$agg->min(),
            mean: x|$x.zeroRate : agg|$agg->average()
        ])
        ->sort(~curveId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV4_CurveShape_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 8 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","pillars":24,"highest":3.61,"lowest":2.46,"mean":2.9045833333333335},{"curveId":"EUR.ESTR.OIS","pillars":24,"highest":3.66,"lowest":2.47,"mean":2.9033333333333333},{"curveId":"EUR.EURIBOR.6M","pillars":24,"highest":3.79,"lowest":2.7,"mean":3.1225},{"curveId":"GBP.SONIA.OIS","pillars":24,"highest":5.19,"lowest":3.55,"mean":4.275833333333333},{"curveId":"JPY.TONA.OIS","pillars":24,"highest":1.96,"lowest":0.08,"mean":0.7458333333333333},{"curveId":"USD.LIBOR.3M","pillars":24,"highest":5.6,"lowest":4.21,"mean":4.796666666666667},{"curveId":"USD.SOFR.OIS","pillars":24,"highest":5.34,"lowest":3.96,"mean":4.5441666666666665},{"curveId":"USD.UST.GOVT","pillars":24,"highest":5.43,"lowest":4.26,"mean":4.702916666666667}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CV5_CurveCatalogue
{
    pattern: '/stress/cv5';
    documentation: 'The curve master: eight curves with their interpolation, day count and enum-mapped type. The legacy IBOR curve is the inactive one. CV0 reads the same enum through an EMBEDDED mapping of a denormalized column; this reads it from the curve\'s own table, and the two must agree.';
    execution: Single
    {
    query: |curves::YieldCurve.all()
        ->project(~[
            curveId:x|$x.curveId,
            curveName:x|$x.curveName,
            currency:x|$x.currency,
            curveType:x|$x.curveType,
            interpolation:x|$x.interpolation,
            dayCountBasis:x|$x.dayCountBasis,
            isActive:x|$x.isActive
        ])
        ->sort(~curveId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV5_CurveCatalogue_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 8 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"curveId":"EUR.DBR.GOVT","curveName":"German Bund Zero Curve","currency":"EUR","curveType":"GOVERNMENT","interpolation":"BOOTSTRAP","dayCountBasis":"ACT/ACT","isActive":true},{"curveId":"EUR.ESTR.OIS","curveName":"EUR Euro Short Term Rate OIS","currency":"EUR","curveType":"OIS","interpolation":"LINEAR_ZERO","dayCountBasis":"ACT/360","isActive":true},{"curveId":"EUR.EURIBOR.6M","curveName":"EUR 6M Euribor Swap","currency":"EUR","curveType":"SWAP","interpolation":"CUBIC_SPLINE","dayCountBasis":"30/360","isActive":false},{"curveId":"GBP.SONIA.OIS","curveName":"GBP SONIA Overnight Index Swap","currency":"GBP","curveType":"OIS","interpolation":"LINEAR_ZERO","dayCountBasis":"ACT/365","isActive":true},{"curveId":"JPY.TONA.OIS","curveName":"JPY TONA Overnight Index Swap","currency":"JPY","curveType":"OIS","interpolation":"LINEAR_ZERO","dayCountBasis":"ACT/365","isActive":true},{"curveId":"USD.LIBOR.3M","curveName":"USD 3M LIBOR Swap (legacy)","currency":"USD","curveType":"SWAP","interpolation":"CUBIC_SPLINE","dayCountBasis":"ACT/360","isActive":false},{"curveId":"USD.SOFR.OIS","curveName":"USD SOFR Overnight Index Swap","currency":"USD","curveType":"OIS","interpolation":"LINEAR_ZERO","dayCountBasis":"ACT/360","isActive":true},{"curveId":"USD.UST.GOVT","curveName":"US Treasury Zero Curve","currency":"USD","curveType":"GOVERNMENT","interpolation":"BOOTSTRAP","dayCountBasis":"ACT/ACT","isActive":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::CV8_CurveDates
{
    pattern: '/stress/cv8';
    documentation: 'The (curve, date) pairs a curve exists for, read ~distinct off the pillar table. Twelve pillars collapse to one row, so 192 become 16 -- and the label beside them is built by a dynafunction in the mapping rather than stored, which is the transform ~distinct has to collapse ACROSS.';
    execution: Single
    {
    query: |curves::CurveDate.all()
        ->project(~[
            curveId:x|$x.curveId,
            cobDate:x|$x.cobDate,
            curveLabel:x|$x.curveLabel
        ])
        ->sort([~curveId->ascending(), ~cobDate->ascending()]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    CV8_CurveDates_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 16 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
