Service stress::G1_UnionTree
{
    pattern: '/stress/g1';
    documentation: 'Graph fetch over a class mapped by an Operation UNION, including an empty leg. Deliberately projects NO enum -- see G3, which does, and fails for an unrelated reason that would otherwise mask this one.';
    execution: Single
    {
    query: |trading::HistTrade.all()
        ->graphFetch(#{
  trading::HistTrade
  {
    tradeId,
    notional,
    status
  }
}#)
        ->serialize(#{
  trading::HistTrade
  {
    tradeId,
    notional,
    status
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    G1_UnionTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"tradeId":"TRD-0001","notional":190500.0,"status":"EXECUTED"},{"tradeId":"TRD-0002","notional":477500.0,"status":"EXECUTED"},{"tradeId":"TRD-0003","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0004","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0005","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0006","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0007","notional":282000.0,"status":"EXECUTED"},{"tradeId":"TRD-0008","notional":18975.0,"status":"CANCELLED"},{"tradeId":"TRD-0009","notional":576750.0,"status":"EXECUTE"},{"tradeId":"TRD-0010","notional":498000.0,"status":"EXECUTED"},{"tradeId":"TRD-0011","notional":167300.0,"status":"EXECUTED"},{"tradeId":"TRD-0012","notional":369000.0,"status":"PENDING"},{"tradeId":"TRD-0013","notional":171250.0,"status":"EXECUTED"},{"tradeId":"TRD-0014","notional":69000.0,"status":"EXECUTED"},{"tradeId":"TRD-0015","notional":35000.0,"status":"SETTLED"},{"tradeId":"TRD-0016","notional":264600.0,"status":"EXECUTED"},{"tradeId":"TRD-0017","notional":385000.0,"status":"EXECUTED"},{"tradeId":"TRD-0018","notional":4912500.0,"status":"EXECUTED"},{"tradeId":"TRD-0019","notional":1960000.0,"status":"EXECUTED"},{"tradeId":"TRD-0020","notional":975000.0,"status":"REJECTED"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::G3_UnionTreeWithEnum
{
    pattern: '/stress/g3';
    documentation: 'The same tree plus the enum-mapped `side`. TRD-0012 carries source code \'ZZ\', which has no EnumerationMapping entry. A TDS projection returns NULL for it (F-A14); graph fetch RAISES. Same data, same mapping, two execution paths, two semantics -- see F10.';
    execution: Single
    {
    query: |trading::HistTrade.all()
        ->graphFetch(#{
  trading::HistTrade
  {
    tradeId,
    side,
    notional,
    status
  }
}#)
        ->serialize(#{
  trading::HistTrade
  {
    tradeId,
    side,
    notional,
    status
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    G3_UnionTreeWithEnum_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"tradeId":"TRD-0001","side":"BUY","notional":190500.0,"status":"EXECUTED"},{"tradeId":"TRD-0002","side":"BUY","notional":477500.0,"status":"EXECUTED"},{"tradeId":"TRD-0003","side":"BUY","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0004","side":"SELL","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0005","side":"BUY","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0006","side":"BUY","notional":250000.0,"status":"EXECUTED"},{"tradeId":"TRD-0007","side":"BUY","notional":282000.0,"status":"EXECUTED"},{"tradeId":"TRD-0008","side":"BUY","notional":18975.0,"status":"CANCELLED"},{"tradeId":"TRD-0009","side":"BUY","notional":576750.0,"status":"EXECUTE"},{"tradeId":"TRD-0010","side":"BUY","notional":498000.0,"status":"EXECUTED"},{"tradeId":"TRD-0011","side":"BUY","notional":167300.0,"status":"EXECUTED"},{"tradeId":"TRD-0012","side":null,"notional":369000.0,"status":"PENDING"},{"tradeId":"TRD-0013","side":"SELL","notional":171250.0,"status":"EXECUTED"},{"tradeId":"TRD-0014","side":"BUY","notional":69000.0,"status":"EXECUTED"},{"tradeId":"TRD-0015","side":"BUY","notional":35000.0,"status":"SETTLED"},{"tradeId":"TRD-0016","side":"BUY","notional":264600.0,"status":"EXECUTED"},{"tradeId":"TRD-0017","side":"SELL","notional":385000.0,"status":"EXECUTED"},{"tradeId":"TRD-0018","side":"BUY","notional":4912500.0,"status":"EXECUTED"},{"tradeId":"TRD-0019","side":"BUY","notional":1960000.0,"status":"EXECUTED"},{"tradeId":"TRD-0020","side":"BUY","notional":975000.0,"status":"REJECTED"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::G2_MilestonedTree
{
    pattern: '/stress/g2';
    documentation: 'Graph fetch over a business-temporal class at %latest. An earlier audit reported a parser NPE on %latest in a graph-fetch tree.';
    execution: Single
    {
    query: |counterparty::RatingVersion.all(%latest)
        ->graphFetch(#{
  counterparty::RatingVersion
  {
    counterpartyId,
    rating,
    outlook
  }
}#)
        ->serialize(#{
  counterparty::RatingVersion
  {
    counterpartyId,
    rating,
    outlook
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    G2_MilestonedTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"counterpartyId":"CP-0001","rating":"AA-","outlook":"STABLE"},{"counterpartyId":"CP-0002","rating":"A+","outlook":"STABLE"},{"counterpartyId":"CP-0003","rating":"BB+","outlook":"NEGATIVE"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F20_NotionalByBook
{
    pattern: '/stress/f20';
    documentation: 'The rollup View: notional by book, grouped by the engine. Its rows are GROUPS, so BK-LEGACY -- which has no trades -- produces no group and is ABSENT. Contrast F2_BookChildCounts, which outer-joins from BOOK and returns a row for it. Two defensible answers to one question, differing on exactly the empty case, both asserted here.';
    execution: Single
    {
    query: |reporting::BookRollup.all()
        ->project(~[
            bookId:x|$x.bookId,
            tradeCount:x|$x.tradeCount,
            totalNotional:x|$x.totalNotional,
            maxNotional:x|$x.maxNotional
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F20_NotionalByBook_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 3 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"bookId":"BK-CASH-US","tradeCount":10,"totalNotional":2961025.0,"maxNotional":576750.0},{"bookId":"BK-VOL-01","tradeCount":5,"totalNotional":8466500.0,"maxNotional":4912500.0},{"bookId":"BK-CASH-EU","tradeCount":5,"totalNotional":924850.0,"maxNotional":385000.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F21_TraderManagerChain
{
    pattern: '/stress/f21';
    documentation: 'A {target} self-join walked two levels. TRD-001 and TRD-003 report to nobody (absent key), TRD-004 reports to a trader who has left (dangling key), and the two-level hop reaches a manager\'s manager. All three must come back as rows with NULLs where the chain stops -- never a dropped row and never a loop.';
    execution: Single
    {
    query: |org::Trader.all()
        ->project(~[
            traderId:x|$x.traderId,
            lastName:x|$x.lastName,
            mgrId:x|$x.manager.traderId,
            mgrLast:x|$x.manager.lastName,
            mgrDesk:x|$x.manager.desk.name,
            grandMgrId:x|$x.manager.manager.traderId,
            grandMgrLast:x|$x.manager.manager.lastName
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F21_TraderManagerChain_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"traderId":"TRD-001","lastName":"Alvarez","mgrId":null,"mgrLast":null,"mgrDesk":null,"grandMgrId":null,"grandMgrLast":null},{"traderId":"TRD-002","lastName":"Watanabe","mgrId":"TRD-001","mgrLast":"Alvarez","mgrDesk":"Cash Equities","grandMgrId":null,"grandMgrLast":null},{"traderId":"TRD-003","lastName":"O\'Brien","mgrId":"TRD-001","mgrLast":"Alvarez","mgrDesk":"Cash Equities","grandMgrId":null,"grandMgrLast":null},{"traderId":"TRD-004","lastName":"Nowak","mgrId":null,"mgrLast":null,"mgrDesk":null,"grandMgrId":null,"grandMgrLast":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::F7_TradeDerivedProperties
{
    pattern: '/stress/f7';
    documentation: 'Derived properties alongside the columns they are computed from, so a wrong value cannot hide: grossAmount is total arithmetic over two [1] measures.';
    execution: Single
    {
    query: |trading::Trade.all()
        ->project(~[
            tradeId:x|$x.tradeId,
            quantity:x|$x.quantity,
            price:x|$x.price,
            commission:x|$x.commission,
            fees:x|$x.fees,
            settlementDate:x|$x.settlementDate,
            side:x|$x.side,
            grossAmount:x|$x.grossAmount,
            grossInGbp:x|$x.grossAmountIn(0.79),
            grossInEur:x|$x.grossAmountIn(0.92)
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F7_TradeDerivedProperties_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 20 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"tradeId":"TRD-0001","quantity":1000.0,"price":190.5,"commission":95.25,"fees":12.1,"settlementDate":"2024-06-05","side":"BUY","grossAmount":190500.0,"grossInGbp":150495.0,"grossInEur":175260.0},{"tradeId":"TRD-0002","quantity":2500.0,"price":191.0,"commission":238.75,"fees":30.25,"settlementDate":"2024-06-05","side":"BUY","grossAmount":477500.0,"grossInGbp":377225.0,"grossInEur":439300.0},{"tradeId":"TRD-0003","quantity":500.0,"price":500.0,"commission":null,"fees":null,"settlementDate":"2024-06-05","side":"BUY","grossAmount":250000.0,"grossInGbp":197500.0,"grossInEur":230000.0},{"tradeId":"TRD-0004","quantity":1250.0,"price":200.0,"commission":125.0,"fees":15.0,"settlementDate":"2024-06-06","side":"SELL","grossAmount":250000.0,"grossInGbp":197500.0,"grossInEur":230000.0},{"tradeId":"TRD-0005","quantity":2000.0,"price":125.0,"commission":100.0,"fees":11.5,"settlementDate":"2024-06-06","side":"BUY","grossAmount":250000.0,"grossInGbp":197500.0,"grossInEur":230000.0},{"tradeId":"TRD-0006","quantity":800.0,"price":312.5,"commission":80.0,"fees":9.0,"settlementDate":"2024-06-06","side":"BUY","grossAmount":250000.0,"grossInGbp":197500.0,"grossInEur":230000.0},{"tradeId":"TRD-0007","quantity":1500.0,"price":188.0,"commission":142.5,"fees":18.0,"settlementDate":"2024-06-07","side":"BUY","grossAmount":282000.0,"grossInGbp":222780.0,"grossInEur":259440.0},{"tradeId":"TRD-0008","quantity":100.0,"price":189.75,"commission":null,"fees":1.0,"settlementDate":null,"side":"BUY","grossAmount":18975.0,"grossInGbp":14990.25,"grossInEur":17457.0},{"tradeId":"TRD-0009","quantity":3000.0,"price":192.25,"commission":285.0,"fees":36.0,"settlementDate":"2024-06-07","side":"BUY","grossAmount":576750.0,"grossInGbp":455632.5,"grossInEur":530610.0},{"tradeId":"TRD-0010","quantity":1200.0,"price":415.0,"commission":249.0,"fees":31.5,"settlementDate":"2024-06-07","side":"BUY","grossAmount":498000.0,"grossInGbp":393420.0,"grossInEur":458160.0},{"tradeId":"TRD-0011","qu