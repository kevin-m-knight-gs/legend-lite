Service stress::MO2_Confirmations
{
    pattern: '/stress/mo2';
    documentation: 'Confirmations with hours to match. The outstanding and disputed ones have no match time, so the duration is null rather than large -- which is the distinction an ageing report has to keep.';
    execution: Single
    {
    query: |middleoffice::Confirmation.all()
        ->project(~[
            confirmationId:x|$x.confirmationId,
            method:x|$x.method,
            platform:x|$x.platform,
            status:x|$x.status,
            chaseCount:x|$x.chaseCount,
            hoursToMatch:x|$x.hoursToMatch,
            counterpartyId:x|$x.confirmedTrade.counterpartyId
        ])
        ->sort(~confirmationId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MO2_Confirmations_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 5 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"confirmationId":"CNF-00001","method":"ELECTRONIC","platform":"MarkitWire","status":"MATCHED","chaseCount":0,"hoursToMatch":0,"counterpartyId":"CP-0001"},{"confirmationId":"CNF-00002","method":"ELECTRONIC","platform":"MarkitWire","status":"MATCHED","chaseCount":0,"hoursToMatch":0,"counterpartyId":"CP-0001"},{"confirmationId":"CNF-00003","method":"PAPER","platform":null,"status":"OUTSTANDING","chaseCount":3,"hoursToMatch":null,"counterpartyId":"CP-0002"},{"confirmationId":"CNF-00004","method":"ELECTRONIC","platform":"DTCC","status":"DISPUTED","chaseCount":2,"hoursToMatch":null,"counterpartyId":"CP-0004"},{"confirmationId":"CNF-00005","method":"EMAIL","platform":null,"status":"MATCHED","chaseCount":5,"hoursToMatch":164,"counterpartyId":"CP-0005"}]';
