Service stress::F6_PositionGreeksCounts
{
    pattern: '/stress/f6';
    documentation: 'Fan-out on the shallowest possible association, so a failure here cannot be blamed on join depth. Three of six positions have no greeks row.';
    execution: Single
    {
    query: |positions::Position.all()
        ->project(~[
            positionId:x|$x.positionId,
            direction:x|$x.direction,
            currency:x|$x.currency,
            isOpen:x|$x.isOpen,
            instrumentName:x|$x.instrument.name,
            greeksCount:x|$x.greeks->count()
        ]);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    F6_PositionGreeksCounts_suite:
