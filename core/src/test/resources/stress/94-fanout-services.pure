Service stress::GG_DailyPnLTree
{
    pattern: '/stress/gg_dailypnl';
    documentation: 'Generated graph fetch on pnl::DailyPnL: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |pnl::DailyPnL.all()
        ->graphFetch(#{
  pnl::DailyPnL
  {
    pnlId,
    carryPnL,
    commissions,
    currency,
    book
    {
      bookId,
      bookType,
      closeDate,
      desk
      {
        deskId,
        assetClass
      }
    },
    desk
    {
      deskId,
      assetClass,
      building,
      businessUnit
      {
        buId,
        budget
      }
    }
  }
}#)
        ->serialize(#{
  pnl::DailyPnL
  {
    pnlId,
    carryPnL,
    commissions,
    currency,
    book
    {
      bookId,
      bookType,
      closeDate,
      desk
      {
        deskId,
        assetClass
      }
    },
    desk
    {
      deskId,
      assetClass,
      building,
      businessUnit
      {
        buId,
        budget
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_DailyPnLTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 7 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"pnlId":"PNL-0001","carryPnL":6420.01,"commissions":1284.0,"currency":"USD","book":{"bookId":"BK-CASH-US","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY"}},"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY","building":"200 West","businessUnit":{"buId":"BU-EQ","budget":400.0}}},{"pnlId":"PNL-0002","carryPnL":-2060.03,"commissions":412.0,"currency":"USD","book":{"bookId":"BK-CASH-US","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY"}},"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY","building":"200 West","businessUnit":{"buId":"BU-EQ","budget":400.0}}},{"pnlId":"PNL-0003","carryPnL":937.5,"commissions":187.5,"currency":"USD","book":{"bookId":"BK-CASH-EU","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY"}},"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY","building":"200 West","businessUnit":{"buId":"BU-EQ","budget":400.0}}},{"pnlId":"PNL-0004","carryPnL":0.0,"commissions":0.0,"currency":"USD","book":{"bookId":"BK-CASH-EU","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY"}},"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY","building":"200 West","businessUnit":{"buId":"BU-EQ","budget":400.0}}},{"pnlId":"PNL-0005","carryPnL":20105.04,"commissions":4021.01,"currency":"USD","book":{"bookId":"BK-VOL-01","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-DERIV","assetClass":"EQUITY"}},"desk":{"deskId":"DSK-DERIV","assetClass":"EQUITY","building":"200 West","businessUnit":{"buId":"BU-EQ","budget":400.0}}},{"pnlId":"PNL-0006","carryPnL":795.0,"commissions":159.0,"currency":"USD","book":{"bookId":"BK-VOL-01","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-DERIV","assetClass":"EQUITY"}},"desk":{"deskId":"DSK-DERIV","assetClass":"EQUITY","building":"200 West","businessUnit":{"buId":"BU-EQ","budget":400.0}}},{"pnlId":"PNL-0007","carryPnL":-125.0,"commissions":25.0,"currency":"USD","book":null,"desk":{"deskId":"DSK-DERIV","assetClass":"EQUITY","building":"200 West","businessUnit":{"buId":"BU-EQ","budget":400.0}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::GG_CurvePointTree
{
    pattern: '/stress/gg_curvepoint';
    documentation: 'Generated graph fetch on curves::CurvePoint: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |curves::CurvePoint.all()
        ->graphFetch(#{
  curves::CurvePoint
  {
    curveId,
    cobDate,
    discountFactor,
    isInterpolated,
    curve
    {
      curveId,
      currency,
      curveName,
      benchmarkSeries
      {
        seriesId,
        assetClass
      }
    },
    effectiveSeries
    {
      seriesId,
      assetClass,
      currency
    }
  }
}#)
        ->serialize(#{
  curves::CurvePoint
  {
    curveId,
    cobDate,
    discountFactor,
    isInterpolated,
    curve
    {
      curveId,
      currency,
      curveName,
      benchmarkSeries
      {
        seriesId,
        assetClass
      }
    },
    effectiveSeries
    {
      seriesId,
      assetClass,
      currency
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
