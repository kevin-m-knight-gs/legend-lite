                    data: '[{"counterpartyId":"CP-0001","rating":"A+","agency":"S&P","outlook":"NEGATIVE","isInvestmentGrade":true},{"counterpartyId":"CP-0002","rating":"A+","agency":"Moody\'s","outlook":"STABLE","isInvestmentGrade":true},{"counterpartyId":"CP-0003","rating":"BBB","agency":"Fitch","outlook":"NEGATIVE","isInvestmentGrade":true},{"counterpartyId":"CP-0004","rating":"BBB-","agency":"Fitch","outlook":"NEGATIVE","isInvestmentGrade":true}]';
