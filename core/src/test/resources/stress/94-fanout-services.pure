        }
      ]
    }
  ]
}

Service stress::SP_defCurveSummaryGraph
{
    pattern: '/stress/sp_defcurvesummarygraph';
    documentation: 'Coverage-directed stack on curves::CurveSummary (Graph), reusing the reach of CV9_CurveSummaries and changing the query SHAPE. Generated by scripts/corpus/spread.py, which picks services by the feature combinations they close rather than by walking the model.';
    execution: Single
    {
    query: |curves::CurveSummary.all()
        ->graphFetch(#{
  curves::CurveSummary
  {
    curveId,
    cobDate,
    pillarCount,
    highestRate,
    lowestRate,
    summarised
    {
      curveName,
      interpolation
    }
  }
}#)
        ->serialize(#{
  curves::CurveSummary
  {
    curveId,
    cobDate,
    pillarCount,
    highestRate,
    lowestRate,
    summarised
    {
      curveName,
      interpolation
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    SP_defCurveSummaryGraph_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 16 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"curveId":"USD.SOFR.OIS","cobDate":"2024-06-19","pillarCount":12,"highestRate":5.34,"lowestRate":3.96,"summarised":{"curveName":"USD SOFR Overnight Index Swap","interpolation":"LINEAR_ZERO"}},{"curveId":"USD.SOFR.OIS","cobDate":"2024-06-20","pillarCount":12,"highestRate":5.34,"lowestRate":3.98,"summarised":{"curveName":"USD SOFR Overnight Index Swap","interpolation":"LINEAR_ZERO"}},{"curveId":"USD.LIBOR.3M","cobDate":"2024-06-19","pillarCount":12,"highestRate":5.6,"lowestRate":4.21,"summarised":{"curveName":"USD 3M LIBOR Swap (legacy)","interpolation":"CUBIC_SPLINE"}},{"curveId":"USD.LIBOR.3M","cobDate":"2024-06-20","pillarCount":12,"highestRate":5.59,"lowestRate":4.23,"summarised":{"curveName":"USD 3M LIBOR Swap (legacy)","interpolation":"CUBIC_SPLINE"}},{"curveId":"EUR.ESTR.OIS","cobDate":"2024-06-19","pillarCount":12,"highestRate":3.66,"lowestRate":2.5,"summarised":{"curveName":"EUR Euro Short Term Rate OIS","interpolation":"LINEAR_ZERO"}},{"curveId":"EUR.ESTR.OIS","cobDate":"2024-06-20","pillarCount":12,"highestRate":3.65,"lowestRate":2.47,"summarised":{"curveName":"EUR Euro Short Term Rate OIS","interpolation":"LINEAR_ZERO"}},{"curveId":"EUR.EURIBOR.6M","cobDate":"2024-06-19","pillarCount":12,"highestRate":3.79,"lowestRate":2.73,"summarised":{"curveName":"EUR 6M Euribor Swap","interpolation":"CUBIC_SPLINE"}},{"curveId":"EUR.EURIBOR.6M","cobDate":"2024-06-20","pillarCount":12,"highestRate":3.78,"lowestRate":2.7,"summarised":{"curveName":"EUR 6M Euribor Swap","interpolation":"CUBIC_SPLINE"}},{"curveId":"GBP.SONIA.OIS","cobDate":"2024-06-19","pillarCount":12,"highestRate":5.19,"lowestRate":3.55,"summarised":{"curveName":"GBP SONIA Overnight Index Swap","interpolation":"LINEAR_ZERO"}},{"curveId":"GBP.SONIA.OIS","cobDate":"2024-06-20","pillarCount":12,"highestRate":5.19,"lowestRate":3.58,"summarised":{"curveName":"GBP SONIA Overnight Index Swap","interpolation":"LINEAR_ZERO"}},{"curveId":"JPY.TONA.OIS