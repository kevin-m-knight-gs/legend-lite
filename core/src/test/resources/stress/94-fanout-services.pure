Service stress::D0_SalesCreditDense
{
    pattern: '/stress/d0';
    documentation: 'Dense stack on sales::SalesCredit: several distinct navigation chains plus whatever the model offers along them, with a filter, a sort and a limit. Generated from the model by scripts/corpus/stacks.py, so it deepens as the model does rather than needing a new hand-written service per domain.';
    execution: Single
    {
    query: |sales::SalesCredit.all()
        ->filter({x|($x.currency != ' none')})
        ->project(~[
            creditId:x|$x.creditId,
            salesPersonDeskBusinessUnitName:x|$x.salesPerson.desk.businessUnit.name,
            tradeOrderInstrumentCurrency:x|$x.trade.order.instrument.currency,
            tradeInstrumentSectorName:x|$x.trade.instrument.sector.name,
            tradeSide:x|$x.trade.side,
            tradeGrossAmount:x|$x.trade.grossAmount
        ])
        ->sort(~creditId->ascending())
        ->limit(25);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    D0_SalesCreditDense_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 12 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
