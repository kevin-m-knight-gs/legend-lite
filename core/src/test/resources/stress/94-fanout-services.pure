Service stress::G1_UnionTree
{
    pattern: '/stress/g1';
    documentation: 'Graph fetch over a class mapped by an Operation UNION, including an empty leg. Deliberately projects NO enum -- see G3, which does, and fails for an unrelated reason that would otherwise mask this one.';
    execution: Single
    {
    query: |trading::HistTrade.all()
        ->graphFetch(#{
  trading::HistTrade
  {
    tradeId,
    notional,
    status
  }
}#)
        ->serialize(#{
  trading::HistTrade
  {
    tradeId,
    notional,
    status
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
