Service stress::MO4_BreaksBySeverity
{
    pattern: '/stress/mo4';
    documentation: 'Breaks by severity and status: the daily ops call\'s first slide.';
    execution: Single
    {
    query: |middleoffice::TradeBreak.all()
        ->project(~[
            severity:x|$x.severity,
            status:x|$x.status,
            ageDays:x|$x.ageDays
        ])
        ->groupBy(~[severity, status], ~[
            breakCount: x|$x.ageDays : agg|$agg->count(),
            oldestDays: x|$x.ageDays : agg|$agg->max(),
            totalDays: x|$x.ageDays : agg|$agg->sum()
        ])
        ->sort(~severity->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    MO4_BreaksBySeverity_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 4 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"severity":"HIGH","status":"OPEN","breakCount":1,"oldestDays":51,"totalDays":51},{"severity":"HIGH","status":"ESCALATED","breakCount":1,"oldestDays":2,"totalDays":2},{"severity":"LOW","status":"RESOLVED","breakCount":2,"oldestDays":4,"totalDays":7},{"severity":"MEDIUM","status":"OPEN","breakCount":2,"oldestDays":144,"totalDays":145}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::MO5_CleanTrades
{
    pattern: '/stress/mo5';
    documentation: 'Trades with no break against them. Emptiness over a to-many where the empty side is the good outcome and the common one.';
    execution: Single
    {
    query: |derivatives::OtcTrade.all()
        ->project(~[
            otcId:x|$x.otcId,
            productType:x|$x.productType,
            noBreaks:x|$x.breaks->isEmpty(),
            noEvents:x|$x.lifecycleEvents->isEmpty()
        ])
        ->sort(~otcId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
