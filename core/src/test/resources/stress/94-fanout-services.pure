    pattern: '/stress/txr_fundingvaluationadjustment';
    documentation: 'risk::FundingValuationAdjustment only. The subtype\'s ~filter is the whole test: if it were wrong this would return every row of the base table instead of its own, with no error and no type mismatch. Generated by scripts/corpus/taxonomy.py.';
    execution: Single
    {
    query: |risk::FundingValuationAdjustment.all()
        ->project(~[
            measureId:x|$x.measureId,
            measureType:x|$x.measureType,
            valueEur:x|$x.valueIn(0.92),
            cobDate:x|$x.measureRun.cobDate,
            runStatus:x|$x.measureRun.status
        ])
        ->sort(~measureId->ascending());
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    TXR_FundingValuationAdjustment_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 1 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"measureId":"MEAS-00008","measureType":"FVA","valueEur":209760.0,"cobDate":"2024-06-28","runStatus":"COMPLETE"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

