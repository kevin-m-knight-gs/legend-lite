Service stress::GG_PositionTree
{
    pattern: '/stress/gg_position';
    documentation: 'Generated graph fetch on positions::Position: 6 keys, 2 sub-object(s). Tree-shaped read of the same rows the projection corpus reads flat -- the two must agree with the oracle independently, because a sub-object that is wholly absent and one whose every field is null are the same row in a projection and different objects in a tree. Generated by scripts/corpus/graphs.py; the PROPERTIES it is instantiating are the hand-written G0-G3 in battery.py.';
    execution: Single
    {
    query: |positions::Position.all()
        ->graphFetch(#{
  positions::Position
  {
    positionId,
    accruedInterest,
    averageCost,
    costBasis,
    book
    {
      bookId,
      bookType,
      closeDate,
      desk
      {
        deskId,
        assetClass
      }
    },
    instrument
    {
      instrumentId,
      assetClass,
      currency,
      exchange
      {
        mic,
        city
      }
    }
  }
}#)
        ->serialize(#{
  positions::Position
  {
    positionId,
    accruedInterest,
    averageCost,
    costBasis,
    book
    {
      bookId,
      bookType,
      closeDate,
      desk
      {
        deskId,
        assetClass
      }
    },
    instrument
    {
      instrumentId,
      assetClass,
      currency,
      exchange
      {
        mic,
        city
      }
    }
  }
}#);
        mapping: stress::AllMapping;
        runtime: stress::RT;
    }
  testSuites:
  [
    GG_PositionTree_suite:
    {
      data:
      [
        connections:
        [
          environment:
            Reference
            #{
              stress::TestData
            }#
        ]
      ]
      tests:
      [
        // 6 rows; 0 of the aggregate cells are ZERO -- an entity with no children. COUNT(*) over the outer join would return 1.
        expected_rows:
        {
          asserts:
          [
            matchesOracle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"positionId":"POS-0001","accruedInterest":null,"averageCost":190.42,"costBasis":1742343.0,"book":{"bookId":"BK-CASH-US","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY"}},"instrument":{"instrumentId":"INST-AAPL","assetClass":"EQUITY","currency":"USD","exchange":{"mic":"XNAS","city":"New York"}}},{"positionId":"POS-0002","accruedInterest":null,"averageCost":415.81,"costBasis":665296.0,"book":{"bookId":"BK-CASH-US","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY"}},"instrument":{"instrumentId":"INST-MSFT","assetClass":"EQUITY","currency":"USD","exchange":{"mic":"XNAS","city":"New York"}}},{"positionId":"POS-0003","accruedInterest":null,"averageCost":6.88,"costBasis":68800.0,"book":{"bookId":"BK-CASH-EU","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY"}},"instrument":{"instrumentId":"INST-HSBA","assetClass":"EQUITY","currency":"GBP","exchange":{"mic":"XLON","city":"London"}}},{"positionId":"POS-0004","accruedInterest":null,"averageCost":175.83,"costBasis":650571.0,"book":{"bookId":"BK-CASH-EU","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-CASH","assetClass":"EQUITY"}},"instrument":{"instrumentId":"INST-SAP","assetClass":"EQUITY","currency":"EUR","exchange":{"mic":"XETR","city":"Frankfurt"}}},{"positionId":"POS-0005","accruedInterest":18402.75,"averageCost":0.9818,"costBasis":6872600.0,"book":{"bookId":"BK-VOL-01","bookType":"TRADING","closeDate":null,"desk":{"deskId":"DSK-DERIV","assetClass":"EQUITY"}},"instrument":{"instrumentId":"INST-GILT30","assetClass":"RATES","currency":"GBP","exchange":{"mic":"XLON","city":"London"}}},{"positionId":"POS-0006","accruedInterest":null,"averageCost":0.0,"costBasis":0.0,"book":{"bookId":"BK-LEGACY","bookType":"BANKING","closeDate":"2023-12-29","desk":{"deskId":"DSK-DERIV","assetClass":"EQUITY"}},"instrument":{"instrumentId":"INST-NESN","assetClass":"EQUITY","currency":"EUR","exchange":{"mic":"XETR","city":"Frankfurt"}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service stress::GG_ProductsInstrumentTree
{
    pattern: '/stress/gg_productsinstrument';
