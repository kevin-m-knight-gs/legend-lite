            chain2_bool_none_nullable_embedded:x|$x.nested.chain2_bool_none_nullable_embedded,
            chain2_bool_not_notnull_embedded:x|$x.nested.chain2_bool_not_notnull_embedded,
            chain2_bool_ends_nullable_embedded:x|$x.nested.chain2_bool_ends_nullable_embedded,
            chain2_date_none_notnull_embedded:x|$x.nested.chain2_date_none_notnull_embedded,
            chain2_date_fdmonth_nullable_embedded:x|$x.nested.chain2_date_fdmonth_nullable_embedded,
            chain2_timestamp_none_notnull_embedded:x|$x.nested.chain2_timestamp_none_notnull_embedded,
            chain2_timestamp_fsecmin_notnull_top:x|$x.chain2_timestamp_fsecmin_notnull_top,
            dyna1_char_up_nullable_top:x|$x.dyna1_char_up_nullable_top,
            dyna1_smallint_abs_notnull_top:x|$x.dyna1_smallint_abs_notnull_top,
            dyna1_bool_isnull_notnull_top:x|$x.dyna1_bool_isnull_notnull_top,
            dyna2_string_up_nullable_top:x|$x.dyna2_string_up_nullable_top,
            dyna2_smallint_none_notnull_top:x|$x.dyna2_smallint_none_notnull_top,
            dyna2_bool_none_nullable_top:x|$x.dyna2_bool_none_nullable_top,
            ineq_string_up_notnull_top:x|$x.ineq_string_up_notnull_top,
            ineq_smallint_none_nullable_top:x|$x.ineq_smallint_none_nullable_top,
            ineq_date_none_nullable_top:x|$x.ineq_date_none_nullable_top,
            multicol_int_none_nullable_top:x|$x.multicol_int_none_nullable_top,
            multicol_decimal_none_nullable_top:x|$x.multicol_decimal_none_nullable_top,
            ormix_string_none_nullable_top:x|$x.ormix_string_none_nullable_top,
