(
   *collateraltypes::CollateralHolding[collateraltypesBase]: Relational
   {
      ~primaryKey ( [store::DB]COLLATERAL_TYPE_HOLDING.HOLDING_ID )
      ~mainTable [store::DB]COLLATERAL_TYPE_HOLDING
      holdingId: [store::DB]COLLATERAL_TYPE_HOLDING.HOLDING_ID,
      collateralType: [store::DB]COLLATERAL_TYPE_HOLDING.COLLATERAL_TYPE,
      counterpartyId: [store::DB]COLLATERAL_TYPE_HOLDING.COUNTERPARTY_ID,
      marketValue: [store::DB]COLLATERAL_TYPE_HOLDING.MARKET_VALUE,
      haircutPct: [store::DB]COLLATERAL_TYPE_HOLDING.HAIRCUT_PCT,
      currency: [store::DB]COLLATERAL_TYPE_HOLDING.CURRENCY,
      valuationDate: [store::DB]COLLATERAL_TYPE_HOLDING.VALUATION_DATE,
      isEligible: [store::DB]COLLATERAL_TYPE_HOLDING.IS_ELIGIBLE,
