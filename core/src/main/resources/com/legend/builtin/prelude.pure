// legend-engine/legend-engine-core/legend-engine-core-pure/legend-engine-pure-code-compiled-core/src/main/resources/core/pure/corefunctions/testExtension.pure
Class meta::pure::functions::test::TestedByResult
{
   results: PackageableFunction<Any>[*];
   visited: String[*];
   depth: Integer[1];
   maxDepth: Integer[1];
   maxVisited: Integer[1];

   maxDepthExceeded(){
      $this.depth > $this.maxDepth;
   }:Boolean[1];

   maxVisitedExceeded(){
      $this.visited->size() > $this.maxVisited;
   }:Boolean[1];

   failed(){
      $this.maxDepthExceeded() || $this.maxVisitedExceeded();
   }:Boolean[1];
}


