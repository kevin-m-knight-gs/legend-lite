   DB2, H2, MemSQL, Sybase, SybaseIQ, Composite, Postgres, SqlServer, Hive, Snowflake, Presto, Trino, BigQuery, Redshift, Databricks, Spanner, Athena, Aurora, SparkSQL, DuckDB, Oracle, ClickHouse, DebugPrint
}

Class meta::external::store::relational::runtime::DatabaseConnection extends Connection
{
   type : meta::relational::runtime::DatabaseType[1];
