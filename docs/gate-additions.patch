diff --git a/.github/workflows/gate.yml b/.github/workflows/gate.yml
index b51d32f4..2e074ecf 100644
--- a/.github/workflows/gate.yml
+++ b/.github/workflows/gate.yml
@@ -26,3 +26,36 @@ jobs:
         run: mvn -B -pl core install -DskipTests
       - name: corpus sweep (self-checks vs committed scoreboard)
         run: mvn -B -pl core test -Dtest=RelationalCorpusRunner
+
+      # The asserted stress corpus. Its generated files are COMMITTED so a reviewer can read
+      # the expectation in the diff, and everything below exists because "committed" and
+      # "current" are different claims. All of it is stdlib Python over sources already in
+      # the tree -- no pip, no network.
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+
+      - name: corpus is current (expectations recomputed and compared)
+        run: python3 scripts/corpus/build.py --check
+
+      - name: feature ratchets (present, executed, non-vacuous)
+        run: |
+          python3 scripts/corpus/density.py --gate
+          python3 scripts/corpus/executed.py --gate
+          python3 scripts/corpus/scoreboard.py --gate
+
+      - name: parser mutants have not drifted
+        run: python3 scripts/parser/mutants.py --check
+
+      # The ENGINE side. Until now this ran only when someone remembered, which meant the
+      # 253-test result quoted in every commit message was not gated by anything. legend.version
+      # is a released engine and both databases are embedded, so this needs Maven and nothing else.
+      - name: build the engine runner
+        run: |
+          # -f, not -pl: engine-runner is deliberately OUTSIDE the reactor, so it
+          # cannot be reached by module selection.
+          mvn -B -f tools/engine-runner/pom.xml compile
+          mvn -B -f tools/engine-runner/pom.xml dependency:build-classpath -Dmdep.outputFile=cp.txt
+
+      - name: stress corpus against legend-engine
+        run: python3 scripts/corpus/run.py
