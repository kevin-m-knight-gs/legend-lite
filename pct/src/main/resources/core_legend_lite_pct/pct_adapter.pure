import meta::pure::test::pct::*;
import meta::legend::lite::pct::*;
import meta::pure::metamodel::serialization::grammar::*;
import meta::pure::metamodel::relation::*;

// Marker class for captured class instances that need ^Class(...) serialization
// This allows us to target only captured variables, not all objects
Class meta::legend::lite::pct::CapturedInstance
{
  value: Any[1];
}

// Custom grammar extension for TDS and captured class instance serialization
function meta::legend::lite::pct::legendLiteGrammarExtension():GrammarExtension[1]
{
    ^GrammarExtension(
        extraInstanceValueHandlers = 
          [
            // Serialize TDS to #TDS\n...\n# format
            t:TDS<Any>[1]|'#TDS\n'+$t.csv+'\n#',
            // Serialize captured class instances to ^Class(prop=val) format
            c:CapturedInstance[1]|$c.value->objectToGrammar()
          ]
    );
}

// Convert any value to Pure grammar string representation
// For class instances, produces ^ClassName(prop1=val1, prop2=val2) syntax.
// B10 (truthfulness burn): the instance walk carries the classes seen
// ON THIS CHAIN (the collector's own cycle mechanism) — a cyclic
// captured-instance graph has NO correct grammar text, so a chain
// repeat FAILS LOUDLY instead of overflowing the stack. (A non-cyclic
// chain that legitimately repeats a class would trip the same wall —
// loud and nameable, never wrong text.)
function meta::legend::lite::pct::objectToGrammar(a:Any[1]):String[1]
{
  $a->objectToGrammarAcc([])
}

function <<access.private>> meta::legend::lite::pct::objectToGrammarAcc(a:Any[1], seen:String[*]):String[1]
{
  $a->match(
    [
       i:Integer[1] | $i->toRepresentation(),
       x:String[1] | $x->toRepresentation(),
       b:Boolean[1] | $b->toRepresentation(),
       f:Float[1] | $f->toRepresentation(),
       d:Date[1] | $d->toRepresentation(),
       e:Enum[1] | $e->type()->elementToPath()+'.'+$e.name,
       d:Decimal[1] | $d->toRepresentation(),
       a:Any[1] |
         let _type = $a->type()->cast(@Class<Any>);
         let path = $a->type()->elementToPath();
         if($seen->contains($path),
           | meta::pure::functions::asserts::fail('cyclic instance graph has no grammar print form: ' + $path);
             '';,
           | let deeper = $seen->concatenate($path);
             let properties = $_type->meta::pure::functions::meta::hierarchicalProperties();
             '^'+$path+'('+
              $properties->map(p| let value = $p->eval($a);
                                  if ($value->isEmpty(),
                                    |'',
                                    |let vals = $value->map(w|$w->objectToGrammarAcc($deeper))->joinStrings(',');
                                     if($value->size() > 1, |$p.name->toOne() + '=[' + $vals + ']', |$p.name->toOne() + '=' + $vals);
                                  );
                           )->filter(v|$v != '')->joinStrings(',')+
            ')';
         );
    ]
  );
}

// Legend-Lite configuration with TDS grammar extension
function meta::legend::lite::pct::legendLiteGrammarConfiguration():Configuration[1]
{
  ^Configuration
  (
    fullPath = true,
    extensions = legendLiteGrammarExtension()  
  );
}

// (getSimpleTypeName DELETED — slice-4 census P2: its one consumer,
// buildTypedHeader, died at F5.3 Stage B; zero callers remained.)

// ===== R1 — semantic dependency DISCOVERY (census §5b) =====
// The referenced user elements are read off the M3 tree the reference
// interpreter already holds — never pattern-guessed from printed text.
// ROOTS ONLY: the Java side's M3-recursive extraction expands supers,
// property types and nested classes from these. The walk mirrors
// substituteInExpression's vocabulary (the same closed AST set) plus
// upstream pct_relational's reprocess arms (the existence proof:
// ^X(...) carries X at genericType.rawType; cast(@X) carries the
// Class AS A VALUE; enum values carry their Enumeration as classifier;
// captured instances carry their class — including runtime subtypes
// the declared property type cannot name).

function <<access.private>> meta::legend::lite::pct::userTypeRoot(t:meta::pure::metamodel::type::Type[1]):String[*]
{
  if($t->instanceOf(Class) || $t->instanceOf(Enumeration),
    | let p = $t->elementToPath();
      // metamodel types and the adapter's OWN namespace (the
      // CapturedInstance marker) are never model dependencies
      if($p->startsWith('meta::pure::metamodel')
         || $p->startsWith('meta::legend::lite::pct')
         || !$p->contains('::'), |[], |$p);,
    | []
  );
}

function <<access.private>> meta::legend::lite::pct::typeRoots(gt:GenericType[*]):String[*]
{
  $gt->map(g |
    $g.rawType->map(rt | $rt->userTypeRoot())
      ->concatenate($g.typeArguments->map(t | $t->typeRoots()));
  );
}

// An instance VALUE's classes: its own classifier plus every class
// reachable through its property values (objectToGrammar's own walk —
// nested instances may be runtime SUBTYPES no declared type names).
// CYCLE GUARD (differential run 1's 23 stack overflows: captured
// instance graphs cycle — Firm<->Person back-references): the walk
// threads the classes seen ON THIS CHAIN and stops at a repeat —
// discovery needs each class once, so chain-level breaking is exact.
// Duplicate roots across sibling branches are fine: the Java consumer
// dedups by construction (maps + visited sets).
function <<access.private>> meta::legend::lite::pct::instanceRoots(a:Any[1]):String[*]
{
  $a->instanceRootsAcc([])
}

function <<access.private>> meta::legend::lite::pct::instanceRootsAcc(a:Any[1], seen:String[*]):String[*]
{
  $a->match([
    i:Integer[1] | [],
    x:String[1]  | [],
    b:Boolean[1] | [],
    f:Float[1]   | [],
    d:Date[1]    | [],
    dc:Decimal[1]| [],
    e:Enum[1]    | $e->type()->userTypeRoot(),
    v:Any[1] |
      if(!$v->type()->instanceOf(Class), | [],
        | let cls = $v->type()->cast(@Class<Any>);
          let root = $cls->userTypeRoot();
          if($root->isEmpty() || $seen->contains($root->toOne()),
            | $root,
            | let deeper = $seen->concatenate($root);
              $root->concatenate(
                $cls->meta::pure::functions::meta::hierarchicalProperties()
                    ->map(p | $p->eval($v)->map(w | $w->instanceRootsAcc($deeper))));
          );
      );
  ]);
}

function <<access.private>> meta::legend::lite::pct::lambdaRoots(fd:FunctionDefinition<Any>[1]):String[*]
{
  // match-clause / typed-lambda PARAMETER types ride the FunctionType
  let paramRoots = $fd.classifierGenericType.typeArguments
      ->map(ta | $ta.rawType)
      ->filter(rt | $rt->instanceOf(meta::pure::metamodel::type::FunctionType))
      ->cast(@meta::pure::metamodel::type::FunctionType)
      ->map(ft | $ft.parameters->evaluateAndDeactivate()->map(p | $p.genericType->typeRoots()));
  $paramRoots->concatenate(
      $fd.expressionSequence->evaluateAndDeactivate()->map(e | $e->collectRoots()));
}

function <<access.private>> meta::legend::lite::pct::collectRoots(a:Any[1]):String[*]
{
  $a->match([
    fe:FunctionExpression[1] |
      let callee = $fe.func;
      // B4: '::tests::' is UPSTREAM'S OWN fixture-package convention —
      // in the pct corpus layout, test-SUPPORT functions live under
      // tests packages and platform-surface functions never do. The
      // filter selects by that published taxonomy (not a guess), and
      // the Java packer refuses LOUDLY if a fixture name would shadow
      // a platform-native function.
      let calleeRoot = if($callee->instanceOf(ConcreteFunctionDefinition)
                          && $callee->elementToPath()->contains('::tests::'),
                          | $callee->elementToPath(), | []);
      $calleeRoot
        ->concatenate($fe.genericType->typeRoots())
        ->concatenate($fe.parametersValues->evaluateAndDeactivate()->map(p | $p->collectRoots()));,
    iv:InstanceValue[1] |
      $iv.genericType->typeRoots()
        ->concatenate($iv.values->map(v | $v->match([
            vs:ValueSpecification[1]      | $vs->collectRoots(),
            fd:FunctionDefinition<Any>[1] | $fd->lambdaRoots(),
            c:Class<Any>[1]               | $c->userTypeRoot(),
            en:Enumeration<Any>[1]        | $en->userTypeRoot(),
            ci:CapturedInstance[1]        | $ci.value->instanceRoots(),
            other:Any[1]                  | $other->instanceRoots();
          ])));,
    lf:LambdaFunction<Any>[1]   | $lf->lambdaRoots(),
    ve:VariableExpression[1]    | $ve.genericType->typeRoots(),
    other:Any[1]                | []
  ]);
}

// Substitute open (captured) variables in the function's expression sequence
// This replaces VariableExpression nodes with their captured values from outer scope
//
// CAPTURE-SAFETY (B9 — the audit's C21 "not capture-safe" note dies by
// PROOF, not code): variable capture requires substituting a term that
// contains FREE variables under a binder of the same name. This
// substitution only ever inserts VALUES — evaluated, closed terms: a
// captured primitive has no variables at all, and a captured lambda is
// a CLOSURE (its parameters bind its body; its own free variables were
// closed at ITS capture). Substituting closed terms under any binder
// cannot capture, so no alpha-renaming is needed. If a witness ever
// falsifies the closedness premise (a captured value carrying a live
// free VariableExpression), the loud interpreter unbound-variable
// error IS the tripwire, and alpha-freshening is the fallback.
function meta::legend::lite::pct::substituteOpenVariables(f:FunctionDefinition<Any>[1]):FunctionDefinition<Any>[1]
{
  // Get captured variables from closure (variables from outer scope)
  let openVars = $f->openVariableValues();
  
  if ($openVars->isEmpty(),
    | $f,
    | // Substitute variables in expression sequence
      let substitutedExprs = $f.expressionSequence->evaluateAndDeactivate()->map(e |
        substituteInExpression($e, $openVars->toOne())
      );
      ^$f(expressionSequence = $substitutedExprs->cast(@ValueSpecification)->toOneMany());
  );
}

// Recursively substitute variables in an expression
function meta::legend::lite::pct::substituteInExpression(expr:Any[1], openVars:Map<String, Any>[1]):Any[1]
{
  $expr->match([
    // Variable reference - check if it's in openVars and substitute
    v:VariableExpression[1] | 
      let value = $openVars->get($v.name);
      if ($value->isEmpty(),
        | $v,  // Not a captured variable, keep as-is
        | // Create InstanceValue with the captured value
          let capturedVal = $value->toOne()->cast(@List<Any>).values;
          if ($capturedVal->isEmpty(),
            | // Empty captured list — use the variable's declared type
              ^InstanceValue(
                genericType = $v.genericType,
                multiplicity = ZeroMany,
                values = []
              );,
            | let valType = $capturedVal->genericType()->toOne().rawType->toOne();
              // For class instances (non-primitive, non-enum), wrap in CapturedInstance marker
              // This allows targeted serialization to ^Class(...) format
              let wrappedVal = if ($valType->instanceOf(Class) && 
                                  !$valType->instanceOf(PrimitiveType) &&
                                  !$valType->subTypeOf(Function) &&
                                  !$valType->elementToPath()->startsWith('meta::pure::metamodel'),
                                | $capturedVal->map(v | ^CapturedInstance(value = $v)),
                                | $capturedVal
                               );
              ^InstanceValue(
                genericType = if($wrappedVal->at(0)->instanceOf(CapturedInstance),
                               | ^GenericType(rawType = CapturedInstance),
                               | $capturedVal->genericType()->toOne()),
                multiplicity = if($capturedVal->size() == 1, |PureOne, |ZeroMany),
                values = $wrappedVal
              );
          );
      );,
      
    // Function expression - recursively substitute in parameters
    sfe:SimpleFunctionExpression[1] |
      let substitutedParams = $sfe.parametersValues->evaluateAndDeactivate()->map(p |
        substituteInExpression($p, $openVars)->cast(@ValueSpecification)
      );
      ^$sfe(parametersValues = $substitutedParams);,
      
    // Instance value - recursively substitute in nested values
    iv:InstanceValue[1] |
      let substitutedValues = $iv.values->map(v |
        $v->match([
          vs:ValueSpecification[1] | substituteInExpression($vs, $openVars),
          cfd:ConcreteFunctionDefinition<Any>[1] |
            // A NAMED function passed by reference: lite's model does not
            // host the PCT support functions, so the reference must be
            // inlined. Print it as a REAL typed lambda — the old path let
            // printFunctionDefinition emit `name(a:T[1],...):R[1] {body}`,
            // a PRINT-ONLY form no real parser accepts (invention census
            // D2; the lite parse arm for it is deleted).
            let substExprs = $cfd.expressionSequence->evaluateAndDeactivate()->map(e |
              substituteInExpression($e, $openVars)
            );
            ^GenericType(
              rawType = LambdaFunction,
              typeArguments = $cfd.classifierGenericType.typeArguments
            )->meta::pure::functions::lang::dynamicNew([
              ^KeyValue(key = 'expressionSequence',
                        value = $substExprs->cast(@ValueSpecification))
            ])->cast(@LambdaFunction<Any>);,
          fd:FunctionDefinition<Any>[1] |
            // Handle nested lambdas
            let substExprs = $fd.expressionSequence->evaluateAndDeactivate()->map(e |
              substituteInExpression($e, $openVars)
            );
            ^$fd(expressionSequence = $substExprs->cast(@ValueSpecification)->toOneMany());,
          a:Any[1] | $a
        ])
      );
      ^$iv(values = $substitutedValues);,
      
    // Lambda function - recursively substitute in body
    lf:LambdaFunction<Any>[1] |
      let substExprs = $lf.expressionSequence->evaluateAndDeactivate()->map(e |
        substituteInExpression($e, $openVars)
      );
      ^$lf(expressionSequence = $substExprs->cast(@ValueSpecification)->toOneMany());,
    
    // Pass through anything else
    a:Any[1] | $a
  ]);
}

// PCT Adapter for Legend-Lite
// This adapter serializes Pure functions to grammar text, executes through
// legend-lite's QueryService, and converts results back to Pure values.
function <<PCT.adapter>> {PCT.adapterName='LegendLite'} 
    meta::legend::lite::pct::testAdapterForLegendLiteExecution<X|o>(f:Function<{->X[o]}>[1]):X[o]
{
    // Substitute captured closure variables before serialization
    // This replaces VariableExpression nodes with their actual values
    let funcDef = $f->cast(@FunctionDefinition<Any>);
    let substituted = substituteOpenVariables($funcDef);
    
    // Serialize the substituted function definition to Pure grammar text
    let config = legendLiteGrammarConfiguration();
    let pureText = $substituted->printFunctionDefinition($config, ^GContext(space=''));
    
    // Debug: print the serialized Pure text
    print('[LegendLite PCT] Executing Pure expression: ' + $pureText + '\n');
    
    // R1: semantic dependency roots — read off the substituted M3 tree
    // (collectRoots), handed to the native so the model hand-off never
    // depends on pattern-matching the printed text
    // (duplicates fine — the Java consumer dedups by construction)
    let roots = $substituted.expressionSequence->evaluateAndDeactivate()
        ->map(e | $e->collectRoots());

    // Execute through Legend-Lite's QueryService via native bridge
    // Java dispatch returns properly typed values:
    //   - TDSResult wrapper containing TDS string (for TabularResult)
    //   - Typed scalar values directly (Integer, Float, Boolean, String, Date, etc.)
    //   - Multi-value collection (for CollectionResult)
    let result = executeLegendLiteQuery($pureText, $roots);
    
    // Handle result based on size and type. R2 (the derived minimum,
    // ADAPTER_NECESSITY_CENSUS §5b, measured on the full lane): the
    // empty-Map consult, the scalar-List wrap, the String->parseDate
    // arm (temporals cross as real Date values via PureDateLiteral)
    // and the scalar enum arm (Java's declared-EnumType resolution
    // owns it) all measured ZERO and are DELETED. What remains reads
    // the declared type at exactly three places: the Map/List
    // COLLECTION rebuild (the interpreter's own constructors are the
    // sanctioned crossing) and the ONE-witness Decimal relabel.
    if($result->isEmpty(),
        | []->cast(@X)->toMultiplicity(@[o]),
        | if($result->size() > 1,
            | // Multi-value result — B2: List/Map results never explode
              // anymore (Java builds the typed instances from the
              // PLATFORM's own generic type), so a multi-value crossing
              // IS a plain collection
              $result->cast(@X)->toMultiplicity(@[o]),
            | // Single-value result: TDS text or a scalar (Map and List
              // results arrive as REAL typed instances Java built from
              // the platform's own generic returnType — B2)
              let single = $result->toOne();
              if($single->instanceOf(TDSResult),
                | // F5.3 STAGE B: the WIRE header IS the header. The
                  // declared-header overlay (405 results overlaid, 322
                  // multiplicities rewritten — audit §4.1) is DELETED:
                  // PCT now sees the platform's own column types,
                  // multiplicities, and names. Stage A's differential
                  // (docs/PCT_HEADER_DIFFERENTIAL.md) adjudicated the
                  // classes; the producers were fixed, never the overlay.
                  let tdsString = $single->cast(@TDSResult).tdsString;
                  $tdsString->stringToTDS()->cast(@X)->toMultiplicity(@[o]);,
                | // audit 2026-08-18 finding G, adjudicated; ONE witness
                  // (testBigFloatAbs): the platform keeps Float literals
                  // decimal-exact by contract, so only the TYPE LABEL
                  // moves to the declared Float — no value is produced
                  // or changed here. Burns at the T4 builder leg.
                  let rawT = $f->functionReturnType().rawType;
                  if(!$rawT->isEmpty() && $rawT->toOne() == Float && $single->instanceOf(Decimal),
                    | $single->cast(@Decimal)->toFloat()->cast(@X)->toMultiplicity(@[o]);,
                    | $single->cast(@X)->toMultiplicity(@[o]);
                  );
              );
          );
    );
}


// (wrapPctList and wrapPctMap DELETED — truthfulness burn B2: the
// combo-enumeration tables read the TEST's declared type arguments.
// Java now builds the ^List<E> instance and the MapResult's Pair<K,V>
// values from the PLATFORM's own generic returnType; newMap in the
// adapter body is the only constructor left, fed fully-stamped pairs.)
